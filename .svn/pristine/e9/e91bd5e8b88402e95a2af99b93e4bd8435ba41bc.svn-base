<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>WMS</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<%@ page import="project.common.airfw.*"%>
<link rel="stylesheet" type="text/css" href="/common/theme/webdek/css/demo_layout.css">
<style>
	input[type="checkbox"]{height:unset;}
</style> 
<script type="text/javascript">
	var dblIdx = 0;
	var menuky = configData.MENU_ID;
	
	$(document).ready(function(){
	    //setTopSize(250);
	    gridList.setGrid({
	        id : "gridList",
	        module : "WmsTask",
	        command : "DL061HEAD",
	        itemGrid : "gridListSub",
	        itemSearch : true
	    });
	    
	    gridList.setGrid({
	        id : "gridListSub",
	        module : "WmsTask",
	        command : "DL061DETAIL",
	        colorType : true
	    });
	    
	    //메뉴별(DL06/WDL06) 그룹오더 채크 여부
	    var value = (menuky == "DL061") ? "" : "V";
	    $("#GRORDYN").val(value);
	    if(value == "V"){
	        $("#GRORDYN").prop('checked', true);
	    }
	    
	    $("#TASOTY").val("210"); //작업타입
	    gridList.setReadOnly("gridListSub", true, ['LOTA06']);
	    
	      <%if(plant.equals("")){%>
           $('select[name="SHPDI.LOTA02"]').multipleSelect('checkAll');
	      <%}else{%>
	        $('select[name="SHPDI.LOTA02"]').multipleSelect('setSelects', ['<%=plant%>']);
	      <%}%>
	    
	      /* 출고유형 전체선택 */
	      var $selRCPTTY = $('select[id="TASDH.TASOTY"]');
	      $selRCPTTY.multipleSelect('checkAll');
	});
	
	 function gridListEventItemGridSearch(gridId, rowNum, itemGridList){
	    if(gridId == "gridList"){
	        var param = getItemSearchParam(rowNum);
	        
	        gridList.gridList({
	            id : "gridListSub",
	            param : param
	        });
	    }
	} 

	function getItemSearchParam(rowNum){
	    var rowData = gridList.getRowData("gridList", rowNum);
	    var param = inputList.setRangeParam("searchArea");
	    param.putAll(rowData);
	    
	    return param;
	}
	
	function gridListEventInputColFocus(gridId, rowNum, colName){
		
		if(gridId == "gridList"){
			var param = getItemSearchParam(rowNum);
	        gridList.gridList({
	            id : "gridListSub",
	            param : param
            });
    	} 
	}

	function commonBtnClick(btnName){
	    if(btnName == "Search"){
	        searchList();
	    }else if(btnName == "Work"){
	        pkComplete();
	    }else if(btnName == "pkCompleteItem"){
	        pkCompleteItem();
	    }else if(btnName == "Print"){
	        Print();
	    }else if(btnName == "PickingCancel" || btnName == "PartPickingCancel" || btnName == "PickingWaiting"){
	        pkCancel(btnName);
	    }else if(btnName == "PickingChange"){
	    	pkChange();
	    }else if(btnName == "UserLockCancel"){
	    	//UserLocakReset();
	    }	    	    
	}
	
	function searchList(){		
		if(validate.check("searchArea")){
	        var param = inputList.setRangeParam("searchArea");
	        param.put("PROGID", menuky);
	        
	        gridList.resetGrid("gridList");
			gridList.resetGrid("gridListSub");
			
	        gridList.gridList({
	            id : "gridList",
	            param : param
	        });
	    }
	}
	
	function gridExcelDownloadEventBefore(gridId){
	    if(gridId == "gridList"){
	        //var param = inputList.setRangeParam("searchArea");
	        var param = new DataMap();
	        param.put("PROGID", "<%= menuId%>");
	        param.put("LGTYPE", "EXCEL");
	        var json = netUtil.sendData({
	            url: "/wms/system/json/saveLog.data",
	            param : param
	        });
	        param.clear();
	        
	        param = inputList.setRangeParam("searchArea");
	        param.put("PROGID", menuky);
	        return param;
	    }else if(gridId == "gridListSub"){
	        var param = new DataMap();
	        param.put("PROGID", "<%= menuId%>");
	        param.put("LGTYPE", "EXCEL");
	        var json = netUtil.sendData({
	            url: "/wms/system/json/saveLog.data",
	            param : param
	        });
	        param.clear();
	        
	        var rowNum = gridList.getSearchRowNum("gridList");
	        if(rowNum == -1){
	            return false;
	        }else{
	            param = getItemSearchParam(rowNum);
	            return param;
	        }
	    }
	}
	
	/* 피킹완료 */
	function pkComplete(){
	    var head = gridList.getSelectData("gridList");
	    var itemList = gridList.getSelectData("gridListSub");
	    if(head.length == 0){
	        commonUtil.msgBox("VALID_M0006"); // 선택된 데이터가 없습니다.
	        return;
	    }
	    if(itemList.length == 0){
	        commonUtil.msgBox("OUT_M0045"); //처리를 위한 아이템이 존재하지 않습니다.
	        return;
	    }
	    
	    if(!commonUtil.msgConfirm("OUT_M0151")){ // 피킹 완료하시겠습니까?
	        return;
	    }

	 	// KYH 작업지시 900개 체크 > 선적번호기준 작업지시갯수 조회변경 필요 (DB조회 로직 추가)
	    if(head.length > 900) {			// 900개 이상 선택되었을 경우 갯수 체크
	    	checkBoxCountCheck("gridList");
	    	return;
	    }

	    var chkRowCnt = gridList.getSelectData("gridListSub").length;
	    var chkRowIdx = gridList.getSelectData("gridListSub");
	    var qtableMap = new DataMap();
	    var qtcompMap = new DataMap();
	    var skukeyMap = new DataMap();
	    
	    var headSelectList = gridList.getSelectRowNumList("gridList");
	    var headNoneStknumRow = 0;
	    
	    for(var j = 0; j < headSelectList.length; j++){
	    	
            var statit = gridList.getColData("gridList", headSelectList[j], "TASKSTATDONM");  // HEAD 작업문서상태
            var statit2 = gridList.getColData("gridList", headSelectList[j], "STATDONM");  // HEAD 상태
            var stknum = gridList.getColData("gridList", headSelectList[j], "STKNUM");  // STKNUM 선적번호
			
            // 작업문서 상태코드 > 상태값으로 변경 처리 (선적단위 변경)
            if(statit == "피킹완료"){	// 피킹완료
            	commonUtil.msgBox("OUT_M0309", new Number(headSelectList[j])+1); //선적번호[{0}]는 피킹완료 된 문서입니다.   
                gridList.setColFocus("gridList", headSelectList[j], "TASKSTATDONM");
                return;
            }
            
            // gridListSub 이동으로인해 유효성검증 위치 변경 필요
            if(statit2 != "할당완료" && statit2 != "부분할당" && statit2 != "부분피킹"){	// 할당완료, 부분할당, 부분피킹
            	commonUtil.msgBox("OUT_M0308", stknum); //선적번호[{0}]는 피킹상태의 데이터입니다.
                gridList.setColFocus("gridList", headSelectList[j], "STATDONM");
                return;
            }
            
            // 선적번호 없는경우 개별처리 되어야함 (단일 로직만 구현)
            if(stknum.indexOf("*") > -1){
            	headNoneStknumRow = j;
            }
	    }
	    
	    if(headNoneStknumRow > 0 && headSelectList.length > 1){
	    	gridList.setColFocus("gridList", headSelectList[headNoneStknumRow], "STKNUM");
	    	alert('선적번호가 없는 항목은 개별 처리만 가능합니다.')
	    	return;
	    }

	    // 화면 작업수량 가능수량 비교
		for(var i = 0; i < chkRowCnt; i++){
			var qtable  = gridList.getColData("gridListSub", chkRowIdx[i].get("GRowNum"),"QTABLE");
	        var qtcomp  = gridList.getColData("gridListSub", chkRowIdx[i].get("GRowNum"),"QTCOMP");
	        var SHPOIT  = gridList.getColData("gridListSub", chkRowIdx[i].get("GRowNum"),"SHPOIT");
	        
	        var taskit  = gridList.getColData("gridListSub", chkRowIdx[i].get("GRowNum"),"TASKIT");
	        var skukey  = gridList.getColData("gridListSub", chkRowIdx[i].get("GRowNum"),"SKUKEY");
	        
	        var statit = gridList.getColData("gridListSub", chkRowIdx[i].get("GRowNum"),"STATIT");
	        
	        /*
	        if(statit != "NEW" && statit != "FIN"){	// 미작업, 피킹진행중
	        	commonUtil.msgBox("OUT_M0221"); 
	        	gridList.setRowFocus("gridListSub", chkRowIdx[i].get("GRowNum"));
	        	return;
	        }else 
	        */
	        
        	if(statit == "FIN"){
	        	commonUtil.msgBox("OUT_M0237"); 
	        	gridList.setRowFocus("gridListSub", chkRowIdx[i].get("GRowNum"));
	        	return;
	        }
	        
	        if(qtableMap.containsKey(SHPOIT)){
	            var sumQtcomp = (Number)(qtcompMap.get(SHPOIT)) + (Number)(qtcomp);
	            qtcompMap.put(SHPOIT, sumQtcomp);
	        }else{
	            qtableMap.put(SHPOIT, qtable);
	            qtcompMap.put(SHPOIT, qtcomp);
	            skukeyMap.put(SHPOIT, skukey);
	        }
	    }
	    
	    var keys = qtableMap.keys();
	    var head = gridList.getSelectData("gridList");
	    var list = gridList.getSelectData("gridListSub");
	    var param = new DataMap();
	    param.put("head", head);
	    param.put("list", list);

	    netUtil.send({
	    	url : "/wms/task/json/DL061SaveEnd.data",
	    	param : param,
	    	successFunction : "pkCompleteSuccess"
    	});
	}
	
	function pkCompleteSuccess(json){
		if(!json.data.CNT && json.data.SHPOKY){
    		if(!json.data.PAIDSR){
    		 	commonUtil.msgBox("OUT_M0195", json.data.SHPOKY);
    		}else{	    	
    			if(json.data.STKNUM && json.data.STKNUM != '' && json.data.STKNUM != ' '){
    				commonUtil.msgBox("OUT_M0243", [json.data.PAIDSR, json.data.TASKKY, json.data.TASKIT, json.data.STKNUM]);
    			}else{
    				commonUtil.msgBox("OUT_M0249", [json.data.PAIDSR, json.data.TASKKY, json.data.TASKIT]);
    			}	
    		}
    		return;
    	}else if(!json.data.CNT && json.data.SHPOKYCOUNT){
    		gridList.checkAll('gridList', false);
    		return;
    	}else{
    		if(json.data["MSG"] && json.data["MSG"] != "SUCCESS"){
    			commonUtil.msgBox(json.data["MSG"]);
    			searchList();
    			return;
    		}
    		
    		gridList.resetGrid("gridList");
	        gridList.resetGrid("gridListSub");
	        commonUtil.msgBox("OUT_M0196"); //피킹이 완료되었습니다.
	        searchList();
    	}
	}

	//피킹취소
	function pkCancel(btnName){
	    var headList = gridList.getSelectData("gridList");
	    var itemList = gridList.getSelectData("gridListSub");
	    
	    if(headList.length == 0){
	        commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
	        return;
	    }
	    
	    if(itemList.length == 0){
	        commonUtil.msgBox("OUT_M0045");  //처리를 위한 아이템이 존재하지 않습니다.
	        return;
	    }
	    
	    if(!commonUtil.msgConfirm("OUT_M0164")){ //피킹 취소 하시겠습니까?
	        return;
	    }	    
	    
	    var param = new DataMap();
	    
	    var headSelectList = gridList.getSelectRowNumList("gridList", true);
	    for (var i = 0; i < headSelectList.length; i++) {

	    	var statit = gridList.getColData("gridList", headSelectList[i], "TASKSTATDONM");  //HEAD 작업문서상태
	    	var statit2 = gridList.getColData("gridList", headSelectList[i], "STATDONM");  //HEAD 상태
	    	var stknum = gridList.getColData("gridList", headSelectList[i], "STKNUM");  //HEAD 상태


	    	if(btnName == "PickingCancel"){
	    		if(statit != "피킹완료" && statit != "부분피킹"){	// FPC: 피킹완료, PPC:부분피킹
	    			commonUtil.msgBox("OUT_M0309", stknum);   // 선적번호[{0}]는 피킹취소할 수 없는 문서상태입니다.
	                gridList.setColFocus("gridList", headSelectList[i], "TASKSTATDONM");
	                return;
	            }

	            if(statit2 != "부분피킹" && statit2 != "피킹완료" && statit2 != "피킹진행중"){	// PPC: 부분피킹, FPC:피킹완료, FIN: 피킹진행중
	            	commonUtil.msgBox("OUT_M0309", stknum);   // 선적번호[{0}]는 피킹취소할 수 없는 문서상태입니다.
	                gridList.setColFocus("gridList", headSelectList[i], "STATDONM");
	                return;
	            }
            }else if(btnName == "PartPickingCancel"){            	

            	var itemSelectList = gridList.getSelectRowNumList("gridListSub", true);
    	    	
    	    	for(var j=0; j < itemList.length; j++){

    	    		if("피킹완료" != gridList.getColData("gridListSub", itemSelectList[j], "STATDONM")){
    	    			commonUtil.msgBox("OUT_M0225", stknum);   
    	                gridList.setColFocus("gridListSub", j, "STATDONM");
    	                return;
    	    		}
    	  	    }
            }
	    	
	        if(dblIdx == headSelectList[i]){
	            param.put("headModifyIndex", i);
	        }
	    }		  
	    
	    if(btnName == "PickingWaiting"){	    	
	    	param.put("OLDLOC", "X");
	    	btnName = "PickingCancel";
	    }else{
	    	param.put("OLDLOC", "V");
	    }

	    param.put("head",headList);
	    param.put("list",itemList);
	    param.put("cancel_Type", btnName);
	    
	    //VALID TASDI_LOCK_INFO
	    var vjson = netUtil.sendData({
	        url : "/wms/outbound/json/ValidPickingCancelDL061.data",
	        param : param
	    });
	    
	    if(vjson && vjson.data){
	    	if(vjson.data != "OK"){
	    		var msgList = vjson.data.split("†");
                commonUtil.msgBox(msgList[0], msgList[1]);

                return
	    	}
	    }

	    var sendUrl="/wms/outbound/json/PickingCancelDL061.data"

	    if(btnName == "PartPickingCancel"){
	    	var itemSelectList = gridList.getSelectRowNumList("gridListSub", true);
	    	
	    	for(var j=0; j < itemList.length; j++){
	    		if("FIN" == gridList.getColData("gridListSub", itemSelectList[j], "STATIT")){
	    			if(!commonUtil.msgConfirm("OUT_M0239")){ //피킹진행중인 상태입니다. 계속 진행 하시겠습니까?
	    				return;		
	    			}
	    		}
	  	    }
	    	sendUrl="/wms/outbound/json/PickingCancelDL061Sub.data"
	    }
	    
	    netUtil.send({
	        url : sendUrl,
	        param : param,
	        successFunction : "pkCancelSuccess"
	    });
	}
	
	function pkCancelSuccess(json) {
		if(json.data != "OK"){
    		var msgList = json.data.split("†");
            var msgTxt = commonUtil.getMsg(msgList[0],(msgList.length > 1 ? msgList[1].split("/") : null));
            commonUtil.msg(msgTxt);
    		return false;
    	}
    	
        gridList.resetGrid("gridList");
        gridList.resetGrid("gridListSub");
        commonUtil.msgBox("OUT_M0207"); //피킹 취소가 성공하였습니다.
        searchList();
	}

	function pkChange() {
		var itemList = gridList.getSelectData("gridListSub");	    
	    
	    if(itemList.length == 0){
	        commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
	        return;
	    }else if(itemList.length > 1){
	        commonUtil.msgBox("OUT_M0208");  //하나의 행만 선택해주세요.
	        return;
        }else if(!(itemList[0].get("STATIT") == "FPC" || itemList[0].get("STATIT") == "PPC")){
        	commonUtil.msgBox("OUT_M0209"); //부분피킹 또는 피킹완료상태만 피킹변경이 가능합니다.
			return;	        
        }	

	    var checkRowNum = gridList.getFocusRowNum("gridList");
	    var statit = gridList.getColData("gridList", checkRowNum, "STATDONM");  //Head상태

	    if(statit != "부분피킹" && statit != "피킹완료"){ // FPC: 피킹완료, PPC:부분피킹
	    	commonUtil.msgBox("OUT_M0226", checkRowNum+1); //[{0}]번째 행의 작업문서는 피킹변경할 수 없는 문서상태입니다. 
	    	gridList.setColFocus("gridList", checkRowNum, "STATDONM");
	    	return;
	    }	            

        var itemSelectList = gridList.getSelectRowNumList("gridListSub", true);
        var clkRowData = gridList.getRowData("gridListSub", itemSelectList);
		        
		page.linkPopOpen("/wms/outbound/DL06POP.page", clkRowData, "height=1050,width=1100,resizable=yes");	
	}

	/* 피킹취소(대기) */
	function pkCancelWaiting(){
	}
	
	function UserLocakReset() {
		var itemList = gridList.getSelectData("gridListSub");	    
	    
	    if(itemList.length == 0){
	        commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
	        return;
	    }
	    
	    if(!commonUtil.msgConfirm("OUT_M0245")){ //작업자를 초기화 하시겠습니까?
	        return;
	    }	 
	    
	    var param = new DataMap();	    
	    param.put("list", itemList);

	    var json = netUtil.sendData({
	        url : "/wms/outbound/json/TaskLockReset.data",
	        param : param
	    });

	    if(json && json.data){
	    	if(json.data["MSG"] != "OK"){
	    	}

	    	commonUtil.msgBox("OUT_M0246"); //작업자초기화가 완료되었습니다.
	    }
	}
	
	function inputListEventRangeDataChange(rangeName, singleData, rangeData){
	    if(rangeName == "TASDI.SHPOKY" || rangeName == "TASDI.SVBELN" || rangeName == "TASDI.SEBELN" || rangeName == "TASDI.SKUKEY"){
	        var dataCount = inputList.getDataCount("TASDI.SHPOKY") 
	                        + inputList.getDataCount("TASDI.SVBELN") 
	                        + inputList.getDataCount("TASDI.SEBELN") 
	                        + inputList.getDataCount("TASDI.SKUKEY");
	        
	        if(dataCount == 0){
	            var now = new Date();
	            now.setDate(now.getDate());
	            var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
	            $("#searchArea").find("[name=REFDAT]").val(tmpValue);
	            inputList.addValidation("REFDAT", "required");
	        }else{
	            $("#searchArea").find("[name=REFDAT]").val("");
	            inputList.removeValidation("REFDAT", "required");
	        }
	    }
	}
	
	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
	    if (gridId == "gridListSub"){
	        if(colName == "QTSPUT"){
	            if(colValue < 0){
	                var taskit = gridList.getColData(gridId,rowNum,"TASKIT");
	                var skukey = gridList.getColData(gridId,rowNum,"SKUKEY");
	                commonUtil.msgBox("TASK_M0065",taskit, skukey); //* 작업오더아이템:상품의 완료수량은 0보다 작을수 없습니다.
	                gridList.setColValue(gridId, rowNum, "QTSPUT", 0);
	            }
	        }
	    }
	}
		
	function gridListEventRowDblclick(gridId, rowNum, colName, colValue){
	    if(gridId == "gridListSub"){
	         
	    	if(!(gridList.getColData(gridId,rowNum,"STATIT") == "FPC" || gridList.getColData(gridId,rowNum,"STATIT") == "PPC")){
		        commonUtil.msgBox("OUT_M0209"); //부분피킹 또는 피킹완료상태만 피킹변경이 가능합니다. 
		        return;
	        }	

	    	var checkRowNum = gridList.getFocusRowNum("gridList");
	    	var statit = gridList.getColData("gridList", checkRowNum, "STATDONM");  //Head상태

	    	if(statit != "부분피킹" && statit != "피킹완료"){ // FPC: 피킹완료, PPC:부분피킹

	    		commonUtil.msgBox("OUT_M0226", checkRowNum+1); //[{0}]번째 행의 작업문서는 피킹변경할 수 없는 문서상태입니다. 
	    		gridList.setColFocus("gridList", checkRowNum, "STATDO");
	    		return;
	    	}	      
	          
	        var clkRowData = gridList.getRowData(gridId, rowNum);
	        page.linkPopOpen("/wms/outbound/DL06POP.page", clkRowData, "height=1050,width=1100,resizable=yes");	
	        
	    }else if(gridId == "gridList"){
	    	
	    }
	}		

	function gridListEventDataBindEnd(gridId, dataLength){
	     if(gridId == "gridList" && dataLength > 0){
	    	 gridList.checkAll('gridList',true);
	     }else if(gridId == "gridListSub" && dataLength > 0){
	    	 
	    	 var count = gridList.getGridDataCount(gridId);

	    	 for(var i=0;i<count;i++){
	    		 var statit = gridList.getColData(gridId, i, "STATIT");

	    		 if(statit == "FCN"){
	    			 gridList.setRowCheck(gridId, i, false);
	    			 gridList.setRowReadOnly(gridId, i, true, ["rowCheck", "OLDLOC"]);
	    		 } 
	    	 }
	     }  
	}
	
	// 20240115 마스터 상태값과 아이템상태 불일치 (이전상태 아이템존재) 색깔 변경
	function gridListRowBgColorChange(gridId, rowNum, rowData){
		if(gridId == "gridList"){

		}else if(gridId == "gridListSub" ){
            if(gridList.getColData('gridList',dblIdx,"STATDONO") > gridList.getColData(gridId,rowNum,"STATDONO")) {
            	return configData.GRID_COLOR_BG_YELLOW_CLASS;
            }
	    }
	}

	function checkBoxCountCheck(gridId){
		var head = gridList.getGridData(gridId);
		var maxHead = head.length;		
		var stknum = gridList.getColData(gridId, gridList.getFocusRowNum(gridId), "STKNUM");
																									
		if(maxHead > 900){	
			maxHead = 900; 	// 갯수를 900개까지로 제한
			alert('최대 피킹 개수는 900건 입니다.');
			gridList.checkAll('gridList', false);		// 1. 전체 해제
			for (var i = 0; i < maxHead; i++) {			// 2. 0 ~ 899 체크함
				if (stknum == gridList.getColData('gridList', i, "STKNUM") && stknum != " "){
					gridList.setRowCheck(gridId, i, true);
				}
			}
			if(!((gridList.getFocusRowNum(gridId)>= 0) && (gridList.getFocusRowNum(gridId) < 900))){ 	// 0 < rownum < 900 이외의 체크박스 해제해줌
				gridList.setRowCheck(gridId, gridList.getFocusRowNum(gridId), false);	
			}
			return;
		} else {
			for (var i = 0; i < maxHead; i++) {
				if (stknum == gridList.getColData('gridList', i, "STKNUM") && stknum != " "){
					gridList.setRowCheck('gridList', i, true);
				}
			}
			return;
		}
	}

	function linkPopCloseEvent(){
	    //searchList();
	    dblIdx = gridList.getFocusRowNum("gridList");
	    searchSubItemList(dblIdx);
	}
	
	function searchSubItemList(rowNum){
		gridList.resetGrid("gridListSub");
	    
	    var STKNUM = gridList.getColData("gridList", rowNum, "STKNUM");
	    var param = inputList.setRangeParam("searchArea");
	    param.put("STKNUM", STKNUM);
	
	    gridList.gridList({
	        id : "gridListSub",
	        module : "WmsTask",
	        command : "DL06DETAIL",
	        param : param
	    });
	    
	    dblIdx = rowNum;
	}   
	
	function Print(){
	    var taskky;
	    var head = gridList.getSelectData("gridList");
	    
	    if(head.length > 0) {
	        var where =  "AND TH.WAREKY = '"+ head[0].get("WAREKY") + "' ";
	        	where += "AND TH.TASKKY IN (" ;
	        	
	        for(var i = 0; i < head.length; i++){
	            taskky = head[i].get("TASKKY");
	            if(i > 0){
	                where += ", "
	            }
	            where += "'" + taskky +"'";
	        }
	        
	        where += ")";
	        	
	        var url = "/ezgen/picking_list_test.ezg";
	        var map = new DataMap();
	        WriteEZgenElement(url, where, "", '<%= langky%>', map, 600, 750);
	        
	    } else {
	        commonUtil.msgBox("VALID_M0006");   //선택된 데이터가 없습니다.
	        return;
	    }
	}
	
	function comboEventDataBindeBefore(comboAtt){
        if(comboAtt == "Wms,PLNTKYCOMBO"){
            var param = new DataMap();
	        param.put("WAREKYS", "'<%= wareky%>'");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("LANGKY", "<%=langky%>");
            return param;
            
        }else if(comboAtt == "WmsOrder,RCPTTYCOMBO"){

        	var param = new DataMap();
        		param.put("PROGID", configData.MENU_ID);
             
        	return param;
            
        }else if(comboAtt == "Wms,DEPTID"){
			var param = new DataMap();
				param.put("WAREKY", "<%=wareky%>");
				
			return param;
		}else if(comboAtt == "Wms,VTXTK"){
			var param = new DataMap();
				param.put("WAREKY", "<%=wareky%>");
			
			return param;
		}else if(comboAtt == "Wms,KVGR"){
			var param = new DataMap();
				param.put("WAREKY", "<%=wareky%>");
				
			return param;
		}
    }
	
	function searchHelpEventOpenBefore(searchCode, gridType, $inputObj){
	    var param = new DataMap();
	   
	    if(searchCode == "SHSTLMAP"){
	    	var PLNTKY = $('select[name="SHPDI.LOTA02"]').val();
			
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			
			param.put("PLNTKY", PLNTKY);
	    	
	    	return param;
	    } else if(searchCode == "SHBZPTN"){
			param.put("PTNRTY", "CT");
			param.put("OWNRKY", "<%=ownrky%>");			
			return param;
		} 
	}
	
	
	// 팝업 callback
	function DocPopCallback () {
		searchList();
	}

	//search 전체 체크박스 클릭
	function searchCheckBoxAll(obj) {
		if($(obj).prop("checked") == true){
			$(obj).parent('dd').children('input').prop("checked", true);
		}else{
			$(obj).parent('dd').children('input').prop("checked", false);
		}
	}
	
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
	<div class="content_inner">
		<%@ include file="/common/include/webdek/title.jsp" %>
		<div class="content_serch" id="searchArea">
			<div class="btn_wrap">
				<div class="fl_l">
				</div>
				<div class="fl_r">
			        <input type="button" CB="Search SEARCH BTN_DISPLAY" />
			        <input type="button" CB="Work WORK BTN_FPC" />			        
			        <input type="button" CB="PickingCancel PKCANCEL_CANCEL BTN_PKCANCEL"/>			        
			        <input type="button" CB="PickingChange PKCANCEL_CHANGE BTN_PKCHANGE"/>  
			        <input type="button" CB="PickingWaiting PKCANCEL_WAITING BTN_PKWAITING"/>
