		        , NVL(#{PAIDTG}, ' ')
		        , NVL(#{TRNUTG}, ' ')
		        , NVL(#{TTRUTY}, ' ')
		        , NVL(#{TMEAKY}, ' ')
		        , NVL(#{TUOMKY}, ' ')
		        , TO_NUMBER(NVL(TRIM(#{QTTPUM}), 0))
		        , NVL(#{TDUOKY}, ' ')
		        , TO_NUMBER(NVL(TRIM(#{QTTDUM}), 0))
		        , NVL(#{LOCAAC}, ' ')
		        , NVL(#{SECTAC}, ' ')
		        , NVL(#{PAIDAC}, ' ')
		        , NVL(#{TRNUAC}, ' ')
		        , NVL(#{ATRUTY}, ' ')
		        , NVL(#{AMEAKY}, ' ')
		        , NVL(#{AUOMKY}, ' ')
		        , TO_NUMBER(NVL(TRIM(#{QTAPUM}), 0))
		        , NVL(#{ADUOKY}, ' ')
		        , TO_NUMBER(NVL(TRIM(#{QTADUM}), 0))
		        , NVL(#{REFDKY}, ' ')
		        , NVL(#{REFDIT}, ' ')
		        , NVL(#{REFCAT}, ' ')
		        , NVL(#{REFDAT}, ' ')
		        , NVL(#{PURCKY}, ' ')
