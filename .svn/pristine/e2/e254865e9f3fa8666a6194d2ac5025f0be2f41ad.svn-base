	<!-- ================================================================================================== -->
	<!-- PDMV01 재고이동 : BEGIN-->
	<!-- ================================================================================================== -->
	<select id="PDMV03CHKLOC_MAP" parameterType="Map" resultType="DataMap">
		 SELECT COUNT(1) AS CNT
		   FROM LOCMA 
		  WHERE WAREKY = #{SES_WAREKY}
		    AND LOCAKY = #{LOCAKY}
	</select>
	
	<select id="PDMV04_LIST" parameterType="Map" resultType="DataMap">
		 SELECT '' AS TASKKY
		      , '320' AS TASOTY
		      , ST.WAREKY
		      , ST.OWNRKY
		      , ST.LOCAKY AS LOCASR
		      , '' AS LOCATG
		      , TRIM(ST.TRNUID) AS TRNUID
		      , ST.SKUKEY
		      , ST.EANCOD
		      , ST.DESC01
		      , ST.SKUG05
		      , ST.LOTA09
		      , ST.LOTA13
		      , ST.ASKU01
		      , (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'LOTA10' AND X.CMCDVL = ST.LOTA10) AS LOTA10
		      , ST.UOMKEY AS SUOMKY
		      , (SELECT X.QTPUOM 
		           FROM MEASI X
		          WHERE X.WAREKY = ST.WAREKY
		            AND X.MEASKY = ST.SKUKEY
		            AND X.UOMKEY = 'BOX') AS QTPUOM
		      , SUM(ST.QTSIWH) AS QTSIWH
		      , SUM(ST.QTSPMO) AS QTSPMO
		      , SUM(ST.QTSIWH-GREATEST(ST.QTSALO, ST.QTSPMO) - ST.QTSBLK) AS QTTAOR
		      , SUM(ST.QTSIWH-GREATEST(ST.QTSALO, ST.QTSPMO) - ST.QTSBLK) AS AVAILABLEQTY
		   FROM STKKY ST
		        INNER JOIN ZONMA ZM ON ZM.WAREKY = ST.WAREKY AND ZM.ZONEKY = ST.ZONEKY
		  WHERE 1=1
		    AND ST.WAREKY = #{SES_WAREKY}
		    AND ST.OWNRKY = #{SES_OWNER}
		    <if test="LOCAKY != null and LOCAKY != ''">
		        AND (ST.LOCAKY = #{LOCAKY} OR ST.TRNUID = #{LOCAKY})
		    </if>
		    <if test="TRNUID != null and TRNUID != ''">
		        AND (ST.TRNUID = #{TRNUID})
		    </if>
		    <if test="SKUKEY != null and SKUKEY != ''">
		        AND (ST.SKUKEY = #{SKUKEY} OR ST.EANCOD = #{SKUKEY})
		    </if>
--		    AND NOT EXISTS(SELECT 'X' 
--		                     FROM FREZH FH 
--		                          INNER JOIN PHYDI PI ON PI.PHYIKY = FH.PHYIKY
--		                    WHERE FH.CLSCHK != 'V' 
--		                      AND FH.LOCAKY = ST.LOCAKY
--		                      AND PI.SKUKEY = ST.SKUKEY)
		    AND ST.QTSIWH &gt; 0
		  GROUP BY ST.LOCAKY
		      , ST.WAREKY
		      , ST.OWNRKY
		      , TRIM(ST.TRNUID)
		      , ST.SKUKEY
		      , ST.EANCOD
		      , ST.DESC01
		      , ST.SKUG05
		      , ST.LOTA09
		      , ST.LOTA10
		      , ST.LOTA13
		      , ST.UOMKEY
	--	      , ZM.ZONGRP
		      , ST.ASKU01
		  ORDER BY ST.LOCAKY, TRIM(ST.TRNUID), ST.SKUKEY
	</select>
	
	<select id="PDMV01HEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT
		       #{TASKKY} AS TASKKY
		     , WH.WAREKY AS WAREKY
		     , WH.NAME01 AS WAREKYNM
		     , DT.DOCUTY AS TASOTY
		     , DT.SHORTX AS TASOTYNM
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT
		     , DC.DOCCAT AS DOCCAT
		     , DC.SHORTX AS DOCCATNM
		     , ' ' AS DRELIN
		     , ST.CMCDVL AS STATDO
		     , ST.CDESC1 AS STATDONM
		     , #{QTTAOR} AS QTTAOR
		     , 0 AS QTCOMP
		     , ' ' AS TSPKEY
		     , ' ' AS DOORKY
		     , ' ' AS KEEPTS
		     , WT.WAREKY AS WARETG
		     , WT.NAME01 AS WARETGNM
		     , 'PDA' AS DOCTXT
		     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT
		     , TO_CHAR(SYSDATE, 'HHMISS') AS CRETIM
		     , ' ' AS CREUSR
		     , ' ' AS CUSRNM
		     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT
		     , TO_CHAR(SYSDATE, 'HHMISS') AS LMOTIM
		     , ' ' AS LMOUSR
		     , ' ' AS LUSRNM
		  FROM (SELECT 1 FROM DUAL) D
		       LEFT OUTER JOIN WAHMA WH
		                    ON WH.WAREKY = #{SES_WAREKY}
		       LEFT OUTER JOIN WAHMA WT
		                    ON WT.WAREKY = #{SES_WAREKY}
		       LEFT OUTER JOIN DOCCM DC
		                    ON DC.DOCCAT = '300'
		       LEFT OUTER JOIN DOCTM DT
		                    ON DT.DOCUTY = #{TASOTY} 
		       LEFT OUTER JOIN CMCDV ST
		                    ON ST.CMCDKY = 'STATDO'
		                   AND ST.CMCDVL = 'NEW'
	</select>
	
	<insert id="TASDH_PDMV01_INSERT" parameterType="Map">
		INSERT INTO TASDH
		(
		    TASKKY
		  , WAREKY
		  , TASOTY
		  , DOCDAT
		  , DOCCAT
		  , DRELIN
		  , STATDO
		  , QTTAOR
		  , QTCOMP
		  , TSPKEY
		  , DOORKY
		  , WARETG
		  , PTNRKY
		  , PTNRTY
		  , PTNRNM
		  , USRID1
		  , UNAME1
		  , DEPTID1
		  , DNAME1
		  , USRID2
		  , UNAME2
		  , DEPTID2
		  , DNAME2
		  , USRID3
		  , UNAME3
		  , DEPTID3
		  , DNAME3
		  , USRID4
		  , UNAME4
		  , DEPTID4
		  , DNAME4
		  , DOCTXT
		  , CREDAT
		  , CRETIM
		  , CREUSR
		  , LMODAT
		  , LMOTIM
		  , LMOUSR
		  , INDBZL
		  , INDARC
		  , UPDCHK
		  , KEEPTS
		)
		VALUES(
		          #{TASKKY}
		        , NVL(#{WAREKY}, ' ')
		        , NVL(#{TASOTY}, ' ')
		        , NVL(REPLACE(#{DOCDAT},'-',''), TO_CHAR(SYSDATE, 'YYYYMMDD'))
		        , NVL(#{DOCCAT}, '300')
		        , ' '
		        , NVL(#{STATDO}, ' ')
		        , TO_NUMBER(NVL(TRIM(#{QTTAOR}), 0))
		        , TO_NUMBER(NVL(TRIM(#{QTCOMP}), 0))
		        , NVL(#{TSPKEY}, ' ')
		        , NVL(#{AREATG}, ' ')
		        , NVL(#{WARETG}, ' ')
		        , NVL(#{PTNRKY}, ' ')
		        , NVL(#{PTNRTY}, ' ')
		        , NVL(#{PTNRNM}, ' ')
		        , NVL(#{USRID1}, ' ')
		        , NVL(#{UNAME1}, ' ')
		        , NVL(#{DEPTID1}, ' ')
		        , NVL(#{DNAME1}, ' ')
		        , NVL(#{USRID2}, ' ')
		        , NVL(#{UNAME2}, ' ')
		        , NVL(#{DEPTID2}, ' ')
		        , NVL(#{DNAME2}, ' ')
		        , NVL(#{USRID3}, ' ')
		        , NVL(#{UNAME3}, ' ')
		        , NVL(#{DEPTID3}, ' ')
		        , NVL(#{DNAME3}, ' ')
		        , NVL(#{USRID4}, ' ')
		        , NVL(#{UNAME4}, ' ')
		        , NVL(#{DEPTID4}, ' ')
		        , NVL(#{DNAME4}, ' ')
		        , NVL(#{DOCTXT}, ' ')
		        , TO_CHAR(SYSDATE, 'YYYYMMDD')
		        , TO_CHAR(SYSDATE, 'HH24MISS')
		        , #{SES_USER_ID}
		        , TO_CHAR(SYSDATE, 'YYYYMMDD')
		        , TO_CHAR(SYSDATE, 'HH24MISS')
		        , #{SES_USER_ID}
		        , NVL(#{INDBZL}, ' ')
		        , NVL(#{INDARC}, ' ')
		        , TO_NUMBER(NVL(TRIM(#{UPDCHK}), 0))
		        , NVL(#{KEEPTS}, ' ')
		      )
	</insert>
	
	<select id="PDMV01BODY_LIST" parameterType="Map" resultType="DataMap">
		SELECT #{TASKKY} AS TASKKY
		     , ' ' AS TASKIT
		     , SY.STOKKY AS STOKKY
		     , 'MV' AS TASKTY
		     , ' ' AS RSNCOD
		     , 'NEW' AS STATIT
		     , SY.WAREKY AS WAREKY
		     , (SY.QTSIWH-GREATEST(SY.QTSALO, SY.QTSPMO) - SY.QTSBLK) AS AVAILABLEQTY
		     , SY.QTSIWH AS QTSIWH
		     , SY.QTSIWH AS QTTAOR
		     , SY.QTSALO AS QTSALO
		     , SY.QTSPMO AS QTSPMO
		     , SY.QTSPMI AS QTSPMI
		     , SY.QTSBLK AS QTSBLK
		     , 0 AS QTCOMP
		     , SY.OWNRKY AS OWNRKY
		     , SY.SKUKEY AS SKUKEY
		     , SY.LOTNUM AS LOTNUM
		     , '00000000' AS ACTCDT
		     , '000000' AS ACTCTI
		     , SY.QTYUOM AS QTYUOM
		     , ' ' AS TKFLKY
		     , ' ' AS STEPNO
		     , ' ' AS LSTTFL
		     , NVL((SELECT DISTINCT NAME01 FROM WAHMA WA WHERE WA.WAREKY = SY.WAREKY),' ') AS WAREKYNM
		     , SY.LOCAKY AS LOCASR
		     , SY.LOCAKY AS LOCAKY
		     , SY.SECTID AS SECTSR
		     , SY.PACKID AS PAIDSR
		     , TRIM(SY.TRNUID) AS TRNUSR
		     , ' ' AS STRUTY
		     , SY.MEASKY AS SMEAKY
		     , SY.UOMKEY AS SUOMKY
		     , SY.QTPUOM AS QTSPUM
		     , SY.DUOMKY AS SDUOKY
		     , SY.QTDUOM AS QTSDUM
		     , DM.SYSLOC AS LOCATG
		     , SY.SECTID AS SECTTG
		     , SY.PACKID AS PAIDTG
		     , ' ' AS TRNUTG
		     , SY.AREAKY AS AREATG
		     , ' ' AS TTRUTY
		     , SY.MEASKY AS TMEAKY
		     , SY.UOMKEY AS TUOMKY
		     , SY.QTPUOM AS QTTPUM
		     , SY.DUOMKY AS TDUOKY
		     , SY.QTDUOM AS QTTDUM
		     , ' ' AS LOCAAC
		     , ' ' AS SECTAC
		     , ' ' AS PAIDAC
		     , ' ' AS TRNUAC
		     , ' ' AS ATRUTY
		     , ' ' AS AMEAKY
		     , ' ' AS AUOMKY
		     , 0 AS QTAPUM
		     , ' ' AS ADUOKY
		     , 0 AS QTADUM
		     , ' ' AS REFDKY
		     , ' ' AS REFDIT
		     , ' ' AS REFCAT
		     , ' ' AS REFDAT
		     , SY.PURCKY AS PURCKY
		     , SY.PURCIT AS PURCIT
		     , SY.ASNDKY AS ASNDKY
		     , SY.ASNDIT AS ASNDIT
		     , SY.RECVKY AS RECVKY
		     , SY.RECVIT AS RECVIT
		     , SY.SHPOKY AS SHPOKY
		     , SY.SHPOIT AS SHPOIT
		     , SY.GRPOKY AS GRPOKY
		     , SY.GRPOIT AS GRPOIT
		     , SY.SADJKY AS SADJKY
		     , SY.SADJIT AS SADJIT
		     , SY.SDIFKY AS SDIFKY
		     , SY.SDIFIT AS SDIFIT
		     , SY.PHYIKY AS PHYIKY
		     , SY.PHYIIT AS PHYIIT
		     , ' ' AS DROPID
		     , SY.DESC01 AS DESC01
		     , SY.DESC02 AS DESC02
		     , SY.ASKU01 AS ASKU01
		     , SY.ASKU02 AS ASKU02
		     , SY.ASKU03 AS ASKU03
		     , SY.ASKU04 AS ASKU04
		     , SY.ASKU05 AS ASKU05
		     , SY.EANCOD AS EANCOD
		     , SY.GTINCD AS GTINCD
		     , SY.SKUG01 AS SKUG01
		     , SY.SKUG02 AS SKUG02
		     , SY.SKUG03 AS SKUG03
		     , SY.SKUG04 AS SKUG04
		     , SY.SKUG05 AS SKUG05
		     , SY.GRSWGT AS GRSWGT
		     , SY.NETWGT AS NETWGT
		     , SY.WGTUNT AS WGTUNT
		     , SY.LENGTH AS LENGTH
		     , SY.WIDTHW AS WIDTHW
		     , SY.HEIGHT AS HEIGHT
		     , SY.CUBICM AS CUBICM
		     , SY.CAPACT AS CAPACT
		     , ' ' AS WORKID
		     , ' ' AS WORKNM
		     , ' ' AS HHTTID
		     , SY.AREAKY AS AREAKY
		     , SY.LOTA01 AS LOTA01
		     , SY.LOTA02 AS LOTA02
		     , NVL((SELECT NAME01 FROM BZPTN PN WHERE PN.PTNRTY = 'DP' AND PN.PTNRKY = SY.LOTA02), ' ') AS LOTA02NM
		     , SY.LOTA03 AS LOTA03
		     , SY.LOTA04 AS LOTA04
		     , SY.LOTA05 AS LOTA05
		     , SY.LOTA06 AS LOTA06
		     , SY.LOTA07 AS LOTA07
		     , SY.LOTA08 AS LOTA08
		     , SY.LOTA09 AS LOTA09
		     , SY.LOTA10 AS LOTA10
		     , SY.LOTA11 AS LOTA11
		     , SY.LOTA12 AS LOTA12
		     , SY.LOTA13 AS LOTA13
		     , SY.LOTA14 AS LOTA14
		     , SY.LOTA15 AS LOTA15
		     , SY.LOTA16 AS LOTA16
		     , SY.LOTA17 AS LOTA17
		     , SY.LOTA18 AS LOTA18
		     , SY.LOTA19 AS LOTA19
		     , SY.LOTA20 AS LOTA20
		     , SY.AWMSNO AS AWMSNO
		     , ' ' AS AWMSTS
		     , SY.SMANDT AS SMANDT
		     , SY.SEBELN AS SEBELN
		     , SY.SEBELP AS SEBELP
		     , SY.SZMBLNO AS SZMBLNO
		     , SY.SZMIPNO AS SZMIPNO
		     , SY.STRAID AS STRAID
		     , SY.SPOSNR AS SPOSNR
		     , SY.STKNUM AS STKNUM
		     , SY.STPNUM AS STPNUM
		     , SY.SWERKS AS SWERKS
		     , SY.SLGORT AS SLGORT
		     , SY.SDATBG AS SDATBG
		     , SY.STDLNR AS STDLNR
		     , SY.SSORNU AS SSORNU
		     , SY.SSORIT AS SSORIT
		     , SY.SMBLNR AS SMBLNR
		     , SY.SZEILE AS SZEILE
		     , SY.SMJAHR AS SMJAHR
		     , SY.SXBLNR AS SXBLNR
		     , SY.SAPSTS AS SAPSTS
		     , ' ' AS DOORKY
		     , SY.LOTA01 AS PTLT01
		     , SY.LOTA02 AS PTLT02
		     , SY.LOTA03 AS PTLT03
		     , SY.LOTA04 AS PTLT04
		     , SY.LOTA05 AS PTLT05
		     , SY.LOTA06 AS PTLT06
		     , SY.LOTA07 AS PTLT07
		     , SY.LOTA08 AS PTLT08
		     , SY.LOTA09 AS PTLT09
		     , SY.LOTA10 AS PTLT10
		     , SY.LOTA11 AS PTLT11
		     , SY.LOTA12 AS PTLT12
		     , SY.LOTA13 AS PTLT13
		     , SY.LOTA14 AS PTLT14
		     , SY.LOTA15 AS PTLT15
		     , SY.LOTA16 AS PTLT16
		     , SY.LOTA17 AS PTLT17
		     , SY.LOTA18 AS PTLT18
		     , SY.LOTA19 AS PTLT19
		     , SY.LOTA20 AS PTLT20
		     , DM.DOCGRP AS PASTKY
		     , ' ' AS ALSTKY
		     , ' ' AS SBKTXT
		     , ' ' AS TASRSN
		     , SM.INDBZL
		     , VD.NAME01 AS SKUG05NM
		  FROM STKKY SY
		       INNER JOIN AREMA AA
		               ON AA.WAREKY = SY.WAREKY
		              AND AA.AREAKY = SY.AREAKY
		       INNER JOIN LOCMA LA
		               ON LA.WAREKY = SY.WAREKY
		              AND LA.LOCAKY = SY.LOCAKY
		              AND LA.STATUS = '00'
		       INNER JOIN DOCTM DM
		               ON DM.DOCUTY = #{DOCUTY}
		       INNER JOIN SKUMA SM
		               ON SY.SKUKEY = SM.SKUKEY
		              AND SY.OWNRKY = SM.OWNRKY
		       LEFT OUTER JOIN BZPTN VD 
		               ON VD.OWNRKY = SY.OWNRKY 
		              AND VD.PTNRKY = SY.SKUG05 
		              AND VD.PTNRTY = 'VD'
		 WHERE SY.WAREKY = #{SES_WAREKY}
		   AND SY.OWNRKY = #{SES_OWNER}
		   AND SY.SKUG05 = #{SKUG05}
		   AND SY.LOCAKY = #{LOCASR}
		   AND SY.TRNUID = NVL(#{TRNUID},' ')
		   AND SY.SKUKEY = #{SKUKEY}
		   AND SY.LOTA13 = #{LOTA13}
		   AND SY.LOCAKY != 'SHPLOC'
		   AND SY.AREAKY NOT IN ('SYS','SHP')
		   AND SY.QTSIWH &gt; 0
		   AND SY.QTSALO = 0
		   AND SY.QTSPMO = 0
		   AND SY.QTSPMI = 0
		   AND SY.QTSBLK = 0
	</select>
	
