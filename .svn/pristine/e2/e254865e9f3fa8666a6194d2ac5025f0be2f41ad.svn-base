				 B.PTLT18 AS PTLT18,
				 B.PTLT19 AS PTLT19,
				 B.PTLT20 AS PTLT20,
				 C.AUTLOC AS AUTLOC,
				 B.CREDAT AS CREDAT,
				 B.CRETIM AS CRETIM,
				 B.CREUSR AS CREUSR,
				 (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
				 B.LMODAT AS LMODAT,
				 B.LMOTIM AS LMOTIM,
				 B.LMOUSR AS LMOUSR,
				 (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
				 B.INDBZL AS INDBZL,
				 B.INDARC AS INDARC,
				 B.UPDCHK AS UPDCHK,
<!-- 				 SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA02', B.LOTA02) AS LOTA02NM, -->
				 ( SELECT X.CDESC1 FROM LOTA02_T X WHERE X.CMCDVL=B.LOTA02 ) AS LOTA02NM,
				 SLM.STLNM AS LOTA01NM,
				 B.QTTAOR AS QTSAVB,
				 '' AS STOKKY,
				 
				 L.STLKY,
		         L.STLKY AS STLKY_ORG,
		         L.PLNTKY,
		         L.PLNTKY AS PLNTKY_ORG,
		         SRC_T.SRCSKY,
		         
		         0 AS BOX
		  FROM   TASDH A
		         INNER JOIN TASDI B
		                 ON B.TASKKY = A.TASKKY
		                AND B.OWNRKY = #{OWNRKY}
					    AND B.STATIT = 'NEW'
					    AND B.SKUKEY = #{SKUKEY}
					    AND EXISTS ( SELECT 1 FROM MTPLNT X WHERE X.WAREKY = #{WAREKY} AND X.PLNTKY = B.LOTA02 AND X.MTYPE LIKE #{MTYPE} )
		         INNER JOIN LOCMA C 
		         		 ON C.WAREKY = A.WAREKY 
		         		AND C.LOCAKY = B.LOCASR
		         INNER JOIN SKUMA D 
		         		 ON D.OWNRKY = B.OWNRKY
		                AND D.SKUKEY = B.SKUKEY
		         LEFT OUTER JOIN STLMA SLM 
		                      ON SLM.OWNRKY = B.OWNRKY 
		                     AND SLM.PLNTKY = B.LOTA02 
		                     AND SLM.STLKY  = B.LOTA01
		         LEFT OUTER JOIN LOCMA K
		                      ON K.WAREKY = A.WAREKY
 		                     AND K.LOCAKY = B.LOCATG
 		         LEFT OUTER JOIN ZONMA L
 		                      ON L.WAREKY = K.WAREKY
		                     AND L.ZONEKY = K.ZONEKY
 		         LEFT OUTER JOIN STLMA M
 		                      ON M.OWNRKY = #{OWNRKY}
             				 AND M.PLNTKY = L.PLNTKY
		                     AND M.WAREKY = L.WAREKY
		                     AND M.STLKY = L.STLKY
		         LEFT OUTER JOIN SK_T SRC_T 
                              ON SRC_T.TASKKY = B.TASKKY
   	                         AND SRC_T.TASKIT = B.TASKIT
		WHERE A.WAREKY = #{WAREKY}
		  AND A.TASOTY = '310'	   
		  AND A.TASKKY = #{TASKKY}
	  	ORDER BY A.TASKKY, B.TASKIT
	</select>
	
	<select id="PDPT01_POP_NEW_MAP" parameterType="Map" resultType="DataMap">
	    SELECT T1.*
		     , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA02', T1.LOTA02) AS LOTA02NM
		     , SLM.STLNM AS LOTA01NM
		     , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, T1.SKUKEY, T1.QTTAOR, T1.SUOMKY, 'BOX')),'0.000') AS BOX
		FROM (
		    SELECT A.LOTA14
			     , (SUM(A.QTSIWH) - SUM(A.QTSPMO) - SUM(A.QTSBLK)) AS QTTAOR
			     , (SUM(A.QTSIWH) - SUM(A.QTSPMO) - SUM(A.QTSBLK)) AS QTSAVB
			     , MAX(A.LOTA01) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS LOTA01
			     , MAX(A.LOTA02) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS LOTA02
			     , MAX(A.LOTA03) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS LOTA03     
			     , MAX(A.LOTA09) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS LOTA09
			     , MAX(A.LOTA11) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS LOTA11
			     , MAX(A.LOTA12) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS LOTA12
			     , MAX(A.LOTA13) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS LOTA13
			     , MAX(A.LOCAKY) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS LOCATG
			     , MAX(A.LOCAKY) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS LOCAAC
			     , MAX(A.UOMKEY) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS SUOMKY
			     , MAX(A.SKUKEY) AS SKUKEY
			     , MAX(A.WAREKY) AS WAREKY
			     , MAX(A.RECVKY) KEEP(DENSE_RANK FIRST ORDER BY A.QTSIWH DESC,A.RECVKY DESC,A.RECVIT,A.STOKKY) AS RECVKY
			     , LISTAGG(A.STOKKY, ',') WITHIN GROUP (ORDER BY (A.QTSIWH - A.QTSPMO - A.QTSBLK) DESC,A.RECVKY DESC) AS STOKKY
			FROM STKKY A
			   , AREMA D
			   , SKUWC E
			   , SKUMA F
			WHERE A.WAREKY = D.WAREKY
			  AND A.AREAKY = D.AREAKY
			  AND A.OWNRKY = E.OWNRKY
			  AND A.SKUKEY = E.SKUKEY
			  AND A.WAREKY = E.WAREKY
			  AND A.OWNRKY = F.OWNRKY
			  AND A.SKUKEY = F.SKUKEY
			  AND (A.QTSIWH - A.QTSPMO - A.QTSBLK) > 0
			  AND A.AREAKY NOT IN ('SHP','SYS','CRT','RTS')
			  AND A.LOCAKY NOT IN ('SYSSHP')
			  AND A.LOCAKY = 'RCVLOC'
			  AND A.OWNRKY = #{OWNRKY}
			  AND A.WAREKY = #{WAREKY}
			  AND A.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{MTYPE})
			  AND A.LOTA06 IN ('00','05')
			  AND A.SKUKEY = #{SKUKEY}
			  AND A.LOTA14 = #{LOTA14}
			GROUP BY A.LOTA14
		) T1
		  LEFT OUTER JOIN STLMA SLM 
				       ON SLM.OWNRKY = #{OWNRKY} 
				      AND SLM.PLNTKY = T1.LOTA02
				      AND SLM.STLKY  = T1.LOTA01
	</select>
	
	<select id="PDPT01_POP_LOC_LIST" parameterType="Map" resultType="DataMap">
		SELECT LM.WAREKY
		     , LM.AREAKY
		     , LM.ZONEKY
		     , LM.LOCAKY
		     , LM.SHORTX
		     , ZM.PLNTKY
		     , SLM.STLKY
		     , SLM.STLNM
		FROM LOCMA LM
		  INNER JOIN ZONMA ZM
		          ON ZM.WAREKY = LM.WAREKY 
		         AND ZM.ZONEKY = LM.ZONEKY
		  INNER JOIN STLMA SLM
		               ON SLM.PLNTKY = ZM.PLNTKY
		              AND SLM.WAREKY = ZM.WAREKY
		              AND SLM.STLKY = ZM.STLKY
		WHERE LM.STATUS = '00'
		  AND LM.WAREKY = #{WAREKY}
		  AND ZM.PLNTKY IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{MTYPE})
		  <if test="AREAKY != null and AREAKY != ''">AND LM.AREAKY = #{AREAKY}</if>
		  <if test="ZONEKY != null and ZONEKY != ''">AND LM.ZONEKY = #{ZONEKY}</if>
		  <if test="INPLNTKY != null and INPLNTKY != ''">AND ZM.PLNTKY IN ( ${INPLNTKY} )</if>
		ORDER BY ZM.PLNTKY, LM.AREAKY, LM.ZONEKY, LM.LOCAKY
	</select>
	
	<select id="PDPT01_POP_STKKY_MAP" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY AS WAREKY,
		       NVL((SELECT NAME01 FROM WAHMA X WHERE X.WAREKY = A.WAREKY ), ' ') AS WAREKYNM,
		       A.STOKKY AS STOKKY,
		       'PT' AS TASKTY,
		       'NEW' AS STATIT,
		       A.QTSIWH - A.QTSPMO - A.QTSBLK AS AVAILABLEQTY,
		       DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) AS QTSAVLB,
		       A.QTSIWH - A.QTSPMO - A.QTSBLK AS QTTAOR,
		       DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) AS QTYUOM,
		       '0' AS QTCOMP,
		       '' AS LOCAAC,
		       '' AS TRNUAC,
		       '' AS ALSTKY,
		      '00000000' AS ACTCDT,
		      '000000' AS ACTCTI,
			  NVL(
			  		(
			  		  SELECT QTPUOM 
			  		  FROM MEASI 
					  WHERE  WAREKY = #{SES_WAREKY}
						AND MEASKY = G.MEASKY
						AND UOMKEY = 'PL'
					),9999999999
			   ) AS QTPUOM,
		       A.LOCAKY AS LOCASR,
		       A.SECTID AS SECTSR,
		       A.PACKID AS PAIDSR,
		       A.TRNUID AS TRNUSR,
		       A.TRUNTY AS STRUTY,
		       E.MEASKY AS SMEAKY,
		       A.UOMKEY AS SUOMKY,
		       A.QTPUOM AS QTSPUM,
		       A.DUOMKY AS SDUOKY,
		       A.QTDUOM AS QTSDUM,
		       '' AS LOCATG,
		       A.SECTID AS SECTTG,
		       A.PACKID AS PAIDTG,
		       A.TRNUID AS TRNUTG,
		       A.TRUNTY AS TTRUTY,
		       E.MEASKY AS TMEAKY,
		       E.UOMDTA AS TUOMKY,
		       A.QTPUOM AS QTTPUM,
		       A.DUOMKY AS TDUOKY,
		       A.QTDUOM AS QTTDUM,
		       A.OWNRKY AS OWNRKY,
		       A.SKUKEY AS SKUKEY,
		       A.LOTNUM AS LOTNUM,
		       A.REFDKY AS REFDKY,
		       A.REFDIT AS REFDIT,
		       A.REFCAT AS REFCAT,
		       A.REFDAT AS REFDAT,
		       A.PURCKY AS PURCKY,
		       A.PURCIT AS PURCIT,
		       A.ASNDKY AS ASNDKY,
		       A.ASNDIT AS ASNDIT,
		       A.RECVKY AS RECVKY,
		       A.RECVIT AS RECVIT,
		       A.SHPOKY AS SHPOKY,
		       A.SHPOIT AS SHPOIT,
		       A.GRPOKY AS GRPOKY,
		       A.GRPOIT AS GRPOIT,
		       A.SADJKY AS SADJKY,
		       A.SADJIT AS SADJIT,
		       A.SDIFKY AS SDIFKY,
		       A.SDIFIT AS SDIFIT,
		       A.PHYIKY AS PHYIKY,
		       A.PHYIIT AS PHYIIT,
		       A.DESC01 AS DESC01,
		       A.DESC02 AS DESC02,
		       A.ASKU01 AS ASKU01,
		       A.ASKU02 AS ASKU02,
		       A.ASKU03 AS ASKU03,
		       A.ASKU04 AS ASKU04,
		       A.ASKU05 AS ASKU05,
		       A.EANCOD AS EANCOD,
		       A.GTINCD AS GTINCD,
		       A.SKUG01 AS SKUG01,
		       A.SKUG02 AS SKUG02,
		       A.SKUG03 AS SKUG03,
		       A.SKUG04 AS SKUG04,
		       A.SKUG05 AS SKUG05,
		       A.GRSWGT AS GRSWGT,
		       A.NETWGT AS NETWGT,
		       A.WGTUNT AS WGTUNT,
		       A.LENGTH AS LENGTH,
		       A.WIDTHW AS WIDTHW,
		       A.HEIGHT AS HEIGHT,
		       A.CUBICM AS CUBICM,
		       A.CAPACT AS CAPACT,
		       A.AREAKY AS AREAKY,
		       A.LOTA01 AS LOTA01,
		       A.LOTA02 AS LOTA02,
		       A.LOTA03 AS LOTA03,
		       A.LOTA04 AS LOTA04,
		       A.LOTA05 AS LOTA05,
		       A.LOTA06 AS LOTA06,
		       A.LOTA07 AS LOTA07,
		       A.LOTA08 AS LOTA08,
		       A.LOTA09 AS LOTA09,
		       A.LOTA10 AS LOTA10,
		       A.LOTA11 AS LOTA11,
		       A.LOTA12 AS LOTA12,
		       A.LOTA13 AS LOTA13,
		       A.LOTA14 AS LOTA14,
		       A.LOTA15 AS LOTA15,
		       A.LOTA16 AS LOTA16,
		       A.LOTA17 AS LOTA17,
		       A.LOTA18 AS LOTA18,
		       A.LOTA19 AS LOTA19,
		       A.LOTA20 AS LOTA20,
		       
		       A.LOTA01 AS ALOTA01,
		       A.LOTA02 AS ALOTA02,
		       A.LOTA03 AS ALOTA03,
		       A.LOTA04 AS ALOTA04,
		       A.LOTA05 AS ALOTA05,
		       A.LOTA06 AS ALOTA06,
		       A.LOTA07 AS ALOTA07,
		       A.LOTA08 AS ALOTA08,
		       A.LOTA09 AS ALOTA09,
		       A.LOTA10 AS ALOTA10,
		       A.LOTA11 AS ALOTA11,
		       A.LOTA12 AS ALOTA12,
		       A.LOTA13 AS ALOTA13,
		       A.LOTA14 AS ALOTA14,
		       A.LOTA15 AS ALOTA15,
		       A.LOTA16 AS ALOTA16,
		       A.LOTA17 AS ALOTA17,
		       A.LOTA18 AS ALOTA18,
		       A.LOTA19 AS ALOTA19,
		       A.LOTA20 AS ALOTA20,
		       
		       A.AWMSNO AS AWMSNO,
		       A.SMANDT AS SMANDT,
		       A.SEBELN AS SEBELN,
		       A.SEBELP AS SEBELP,
		       A.SVBELN AS SVBELN,
		       A.SMBLNR AS SMBLNR,
		       A.SMJAHR AS SMJAHR,
		       A.SZEILE AS SZEILE,
		       A.SZMIPNO AS SZMIPNO,
		       A.SPOSNR AS SPOSNR,
		       A.STKNUM AS STKNUM,
		       A.STPNUM AS STPNUM,
		       A.SLGORT AS SLGORT,
		       A.SWERKS AS SWERKS,
		       A.STDLNR AS STDLNR,
		       A.STRAID AS STRAID,
		       A.SSORNU AS SSORNU,
		       A.SSORIT AS SSORIT,
		       A.SXBLNR AS SXBLNR,
		       A.LOTA01 AS PTLT01,
		       A.LOTA02 AS PTLT02,
		       A.LOTA03 AS PTLT03,
		       A.LOTA04 AS PTLT04,
		       A.LOTA05 AS PTLT05,
		       A.LOTA06 AS PTLT06,
		       A.LOTA07 AS PTLT07,
		       A.LOTA08 AS PTLT08,
		       A.LOTA09 AS PTLT09,
		       A.LOTA10 AS PTLT10,
		       A.LOTA11 AS PTLT11,
		       A.LOTA12 AS PTLT12,
		       A.LOTA13 AS PTLT13,
		       A.LOTA14 AS PTLT14,
		       A.LOTA15 AS PTLT15,
		       A.LOTA16 AS PTLT16,
		       A.LOTA17 AS PTLT17,
		       A.LOTA18 AS PTLT18,
		       A.LOTA19 AS PTLT19,
		       A.LOTA20 AS PTLT20,
		       E.PASTKY AS PASTKY,
		       A.SZMBLNO AS SZMBLNO,
		       A.SDATBG AS SDATBG,
		       A.QTSIWH,
		       '' AS TASKIT,
		       '' AS TASKKY,
		       F.SKUL01
	 FROM STKKY A, AREMA D, SKUWC E, SKUMA F, SKUWC G
	 WHERE A.WAREKY = D.WAREKY
	   AND A.AREAKY = D.AREAKY
	   AND A.OWNRKY = E.OWNRKY
	   AND A.SKUKEY = E.SKUKEY
	   AND A.WAREKY = E.WAREKY
	   
	   AND A.OWNRKY = F.OWNRKY
	   AND A.SKUKEY = F.SKUKEY
	   
	   AND A.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{MTYPE})
	   
	   AND A.QTSIWH - A.QTSPMO - A.QTSBLK &gt; 0
	   AND A.AREAKY NOT IN ('SHP','SYS','CRT','RTS')
	   AND A.LOCAKY NOT IN ('SYSSHP')
	   AND A.LOCAKY = 'RCVLOC'
	   AND A.WAREKY = #{WAREKY}
	   
	   AND G.WAREKY(+) = A.WAREKY
   	   AND G.OWNRKY(+) = A.OWNRKY
       AND G.SKUKEY(+) = A.SKUKEY
	   
	   AND A.STOKKY = #{STOKKY}
	   
	</select>
	
	<select id="PDPT01_POP_TASKIT_KY_MAP" parameterType="Map" resultType="DataMap">
		SELECT LPAD( (MAX(TO_NUMBER(TASKIT))+10) , 6, '0') AS TASKIT
		FROM TASDI
		WHERE TASKKY = #{TASKKY}
	</select>
	
	<select id="PDPT01POP_MAP" parameterType="Map" resultType="DataMap">
		 { call P_AIRWMS_PICKING_COMPLETE( #{TASKKY}, #{TASKIT}, 'SHPLOC', #{TRNUAC}, #{QTCOMP}, #{SES_USER_ID} ) }
	</select>
	
	<select id="TASDINEW_MAP" parameterType="Map" resultType="DataMap">
		SELECT  COUNT(*) AS CNT
		  FROM  TASDI
		 WHERE  TASKKY = #{TASKKY}
		 AND    SKUKEY = #{SKUKEY}
		 AND    STATIT = 'NEW'
		 AND    LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{MTYPE})
	</select>
	
	<select id="PDPT01_DOC_LIST" parameterType="Map" resultType="DataMap">
	    SELECT TH.TASKKY
		     , TH.WAREKY
		     , TH.TASOTY
		     , TH.DOCDAT
		     , TH.DOCCAT
		     , TH.STATDO
		     , TH.QTTAOR
		     , TH.QTCOMP
		     , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', TH.STATDO) AS STATDONM
		FROM TASDH TH
		WHERE TH.WAREKY = #{WAREKY}
		  AND TH.TASOTY = '310'
		  AND EXISTS (
		               SELECT 'X'
		               FROM TASDI X
		               WHERE X.TASKKY = TH.TASKKY
		                 AND X.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{MTYPE})
		                 AND X.STATIT = 'NEW'
		             )
		  <if test="DOCDAT != null and DOCDAT != ''">
			AND TH.DOCDAT = #{DOCDAT}
		  </if>
		ORDER BY TASKKY DESC
	</select>
	
	<delete id="TASDIDEL_DELETE" parameterType="Map">
		DELETE FROM TASDI
		 WHERE TASKKY = #{TASKKY}
		   AND SKUKEY = #{SKUKEY}
	</delete>
	
	
	
	<!-- ================================================================================================== -->
	<!-- PDPT01 적치완료 : END-->
	<!-- ================================================================================================== -->
</mapper>