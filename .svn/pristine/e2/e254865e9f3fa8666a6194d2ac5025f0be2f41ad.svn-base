	<insert id="TASDREND_PDMV01_INSERT" parameterType="Map">
		INSERT INTO TASDR 
		(      
		    TASKKY
		  , TASKIT
		  , TASKIR
		  , STOKKY
		  , QTSTKM
		  , QTSTKC
		  , CREDAT
		  , CRETIM
		  , CREUSR
		  , LMODAT
		  , LMOTIM
		  , LMOUSR    
		) 
		VALUES(
		          #{TASKKY}
		        , LPAD(#{TASKIT},6,'0')
		        , NVL(#{TASKIR},'0001')
		        , #{STOKKY}
		        , TO_NUMBER(#{QTSTKM})
		        , TO_NUMBER(#{QTSTKC})
		        , TO_CHAR(SYSDATE, 'YYYYMMDD')
		        , TO_CHAR(SYSDATE, 'HH24MISS')
		        , #{SES_USER_ID}
		        , TO_CHAR(SYSDATE, 'YYYYMMDD')
		        , TO_CHAR(SYSDATE, 'HH24MISS')
		        , #{SES_USER_ID}   
		      )
	</insert>
	
	<select id="PDMV03_AIRWMS_DOCUMENT_PROCESS_MAP" parameterType="Map" resultType="DataMap">
		{ call P_AIRWMS_DOCUMENT_PROCESS(#{DOCCAT}, #{DOCUKY}, ' ', #{DOFLAG}, #{SES_USER_ID}) }
	</select>
	
	<select id="MV01_VALIDATION" parameterType="Map" resultType="DataMap"> 
		SELECT CASE WHEN L.LOCAKY IS NULL 
		                 THEN 'VALID_M0204' || ' ' || P.LOCATG
		            WHEN P.LOCATG = P.LOCASR
                         THEN 'VALID_M1594' || ' ' || P.LOCASR
                    WHEN TO_NUMBER(P.QTTAOR) &gt; TO_NUMBER(P.AVAILABLEQTY)
                         THEN 'VALID_M0923' || ' ' || P.QTTAOR
                    WHEN TO_NUMBER(P.QTTAOR) &lt;= 0
                         THEN 'VALID_M1596' || ' ' || P.QTTAOR
                    WHEN P.TASOTY IN ('310','311','320','321','340') AND L.MIXSKU != 'V' AND A.AREATY = 'STOR'
                                                               AND NVL((
		                                                                 SELECT COUNT(1)
		                                                                   FROM STKKY
		                                                                  WHERE WAREKY = P.WAREKY
		                                                                    AND OWNRKY = P.OWNRKY
		                                                                    AND LOCAKY = P.LOCATG
		                                                                    AND (QTSIWH &gt; 0 OR QTSPMI &gt; 0)
		                                                                    AND SKUKEY != P.SKUKEY
                                                                       ),0) &gt; 0
                         THEN 'VALID_M1608' || ' ' || P.LOCATG
                    WHEN P.TASOTY IN ('310','311','320','321','340') AND L.MIXLOT != 'V' AND A.AREATY = 'STOR'
                                                               AND NVL((
		                                                                 SELECT COUNT(1)
		                                                                   FROM STKKY
		                                                                  WHERE WAREKY = P.WAREKY
		                                                                    AND OWNRKY = P.OWNRKY
		                                                                    AND LOCAKY = P.LOCATG
		                                                                    AND (QTSIWH &gt; 0 OR QTSPMI &gt; 0)
		                                                                    AND (SKUKEY != P.SKUKEY OR LOTA13 != P.LOTA13)
                                                                       ),0) &gt; 0
                         THEN 'VALID_M1609' || ' ' || P.LOCATG
                    WHEN P.TASOTY IN ('310','311','320','321','340') AND L.MIXSKU != 'V' AND A.AREATY = 'STOR'
                                                               AND EXISTS (SELECT 1 FROM SKUWC WHERE WAREKY = P.WAREKY AND OWNRKY = P.OWNRKY AND SKUKEY != P.SKUKEY AND PLOCOV = P.LOCATG)
                         THEN 'VALID_M1732' || ' ' || P.LOCATG
		            ELSE 'OK'
		         END AS MSG
		  FROM (
		         ${VALIDATION_SQL}
		       ) P 
		       LEFT OUTER JOIN LOCMA L 
		                    ON L.WAREKY = P.WAREKY 
		                   AND L.LOCAKY = P.LOCATG
		       LEFT OUTER JOIN AREMA A
		                    ON A.WAREKY = L.WAREKY
		                   AND A.AREAKY = L.AREAKY
		 WHERE 1 = 1
		    OR L.LOCAKY IS NULL		
	</select>
	<!-- ================================================================================================== -->
	<!-- PDMV01 재고이동 : END-->
	<!-- ================================================================================================== -->

	
	<!-- ================================================================================================== -->
	<!-- PDPT01 적치완료 : BEGIN-->
	<!-- ================================================================================================== -->
	<select id="PDPT01SKUCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT NVL(SUM(CNT),0) AS CNT
             , NVL(SUM(COM_CNT),0) AS COM_CNT
             , MAX((CASE WHEN RN=0 THEN SKUKEY ELSE '' END)) AS SKUKEY
		FROM (
			SELECT TH.TASKKY
			     , TI.SKUKEY
			     , TI.DESC01
			     , COUNT(1) AS CNT
			     , SUM( DECODE((TI.QTCOMP-TI.QTTAOR),0,1,0) ) AS COM_CNT
			     , ( CASE WHEN (COUNT(1)- SUM( DECODE((TI.QTCOMP-TI.QTTAOR),0,1,0) ))<![CDATA[<=0]]> THEN 1 ELSE 0 END) AS RN
		  	FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{MTYPE})
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = TH.WAREKY AND SW.OWNRKY = TI.OWNRKY AND SW.SKUKEY = TI.SKUKEY
		 	WHERE 1 = 1
		   	  AND TH.WAREKY = #{WAREKY}
		   	  AND TH.TASOTY = '310'
		   	  AND TH.TASKKY = #{TASKKY}
		   GROUP BY TH.TASKKY, TI.SKUKEY, TI.DESC01
		)
	</select>
	
	<select id="PDPT01CNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS CNT
		     , SUM(TI.QTTAOR) AS QTTAOR
		     , SUM(TI.QTCOMP) AS QTCOMP
		     , MAX(TI.SUOMKY) AS UOMKEY
		     , MAX(SM.DESC01) AS DESC01
		FROM TASDH TH
		  INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{MTYPE})
		  INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		  INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		WHERE 1 = 1
		  AND TH.WAREKY = #{WAREKY}
		  AND TH.TASOTY = '310'
		  AND TI.STATIT = 'NEW'
		  AND TH.TASKKY = #{TASKKY}
		  AND TI.SKUKEY = #{SKUKEY}
	</select>
	
	<select id="PDPT01SUBCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) CNT
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '310'
		   AND TI.STATIT = 'NEW'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
	</select>

	<select id="PDPT01SKU_LIST" parameterType="Map" resultType="DataMap">
		SELECT ROW_NUMBER() OVER(ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT) AS RNUM
		     , CASE WHEN TI.STATIT = 'NEW' THEN 'O'
		            ELSE 'X'
		       END AS SAVE_ENABLE
		     , TH.TASKKY, TI.TASKIT
		     , TI.STATIT, NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),0) AS STATITNM
		     , TI.LOCASR AS LOCAKY
		     , LM.OBROUT
		     , TI.OWNRKY, TI.SKUKEY, SM.DESC01, SM.EANCOD
		     , TI.QTTAOR
		     , SM.DUOMKY AS UOMKEY
		     , TI.QTCOMP AS QTCOMP
		     , SM.DUOMKY AS UOMKEY2
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = TH.WAREKY AND SW.OWNRKY = TI.OWNRKY AND SW.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '310'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		 ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT
	</select>
	
	<select id="PDPT01_LIST" parameterType="Map" resultType="DataMap">
	    SELECT A.TASKKY
		     , A.SKUKEY
		     , A.DESC01
		     , A.STATIT
		     , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', A.STATIT) AS STATITNM
		FROM (
		    SELECT TH.TASKKY
			     , TI.SKUKEY
			     , TI.DESC01
			     , (CASE WHEN SUM(TI.QTCOMP)=0 THEN 'NEW' WHEN SUM(TI.QTTAOR)=SUM(TI.QTCOMP) THEN 'FPA' ELSE 'PPA' END ) AS STATIT
			FROM TASDH TH
			  INNER JOIN TASDI TI
			          ON TI.TASKKY = TH.TASKKY
			         AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{MTYPE})
			WHERE 1 = 1
			  AND TH.WAREKY = #{WAREKY}
			  AND TH.TASOTY = '310'
			  AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
			GROUP BY TH.TASKKY, TI.SKUKEY, TI.DESC01
		) A
		WHERE A.STATIT IN ('NEW','PPA')
		ORDER BY A.TASKKY DESC
	</select>
	
	<select id="PDPT01_POP_LIST" parameterType="Map" resultType="DataMap">
		WITH SK_T AS (
		    SELECT TR.TASKKY
		         , TR.TASKIT
		         , MIN(SK.SRCSKY) AS SRCSKY
		    FROM TASDR TR
		      INNER JOIN STKKY SK
		              ON SK.TASKKY = TR.TASKKY
		             AND SK.TASKIT = TR.TASKIT
		             AND SK.WAREKY = #{WAREKY}
		    WHERE TR.TASKKY = #{TASKKY}
		    GROUP BY TR.TASKKY, TR.TASKIT
		),
		STATIT_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'STATIT'
		),
		LOTA02_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'LOTA02'
		)
		SELECT   ROW_NUMBER() OVER(ORDER BY C.OBROUT, C.LOCAKY, A.TASKKY, B.TASKIT) AS RNUM,
	    		 A.WAREKY AS WAREKY,
				 B.TASKKY AS TASKKY,
				 B.TASKIT AS TASKIT,
				 B.TASKTY AS TASKTY,
				 B.RSNCOD AS RSNCOD,
				 B.TASRSN AS TASRSN,
				 B.STATIT AS STATIT,
<!-- 		         '['||B.STATIT||'] '|| NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = B.STATIT),' ') AS STATITNM, -->
		         '['||B.STATIT||'] '|| ( SELECT X.CDESC1 FROM STATIT_T X WHERE X.CMCDVL=B.STATIT ) AS STATITNM,
				 B.QTTAOR AS QTTAOR,
<!-- 				 B.QTTAOR AS QTCOMP, -->
				 0 AS QTCOMP,
				 B.QTCOMP AS QTYTOT,
				 B.OWNRKY AS OWNRKY,
				 B.SKUKEY AS SKUKEY,
				 B.LOTNUM AS LOTNUM,
				 B.ACTCDT AS ACTCDT,
				 B.ACTCTI AS ACTCTI,
				 B.QTYUOM AS QTYUOM,
				 B.TKFLKY AS TKFLKY,
				 B.STEPNO AS STEPNO,
