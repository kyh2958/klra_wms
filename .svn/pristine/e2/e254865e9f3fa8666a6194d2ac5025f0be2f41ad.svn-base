				 B.TTRUTY AS TTRUTY,
				 B.TMEAKY AS TMEAKY,
				 B.TUOMKY AS TUOMKY,
				 B.QTTPUM AS QTTPUM,
				 B.TDUOKY AS TDUOKY,
				 B.QTTDUM AS QTTDUM,
<!-- 				 B.LOCATG AS LOCAAC, -->
				 B.LOCAAC AS LOCAAC,
				 B.SECTTG AS SECTAC,
				 B.PAIDTG AS PAIDAC,
				 B.TRNUTG AS TRNUAC,
