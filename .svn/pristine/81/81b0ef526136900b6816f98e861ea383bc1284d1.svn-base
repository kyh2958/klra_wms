<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%
	String BARCOD = request.getParameter("BARCOD");
%>
<!doctype html>
<head>
<style type="text/css">
button{ vertical-align: bottom; height: 37px; }
input:read-only{ background-color: #e2e2e2; }
select:DISABLED{ background-color: #e2e2e2; }
.tem5_content .tableWrap_search{ overflow: hidden; }
</style>
<meta charset="utf-8">
<meta name="viewport" content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width, target-densitydpi=medium-dpi" />
<meta name="format-detection" content="telephone=no" />
<title>WMS</title>
<%@ include file="/mobile/include/head.jsp" %>
<script>

var data;
var ymd = new Date();
	ymd.setDate(ymd.getDate() - 0)
var year = ymd.getFullYear();
var month = ("0"+(ymd.getMonth()+1)).slice(-2);
var date = ("0"+ymd.getDate()).slice(-2);


	$(document).ready(function () {
		init();
		
		$("#BEDAT").val(year + "." + month + "." + date);
		
		gridList.setGrid({
			id             : "gridList",
			module         : "WmsMobileInboundGoodsReceipt",
			command		   : "PDGR01_EBELN",
			gridMobileType : true,
			editable       : false
		});
		
		searchList();
	})
	
	var selectedRowNum = 0;
	
	function init() {
		selectedRowNum = 0;
	}
	
	function searchList() {

		var BEDAT = $("#BEDAT").val().replace(/\./gi, "");
		
		var param = new DataMap();
		param.put("LANGKY", "<%=langky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("WAREKY", "<%=wareky%>");
		param.put("MTYPE", "<%=mtype%>");
		param.put("PROGID", 'GR02');
		param.put("BEDAT", BEDAT);
		param.put("BWART", "122");
		
		gridList.resetGrid("gridList");
		
		gridList.gridList({
			id : "gridList",
			param : param
		});
	}
	
	// 더블클릭 이벤트
	function gridListEventRowDblclick(gridId, rowNum) {
		var data = gridList.getRowData("gridList", rowNum);
		callback(data);
	}
	
	// 선택버튼 클릭 이벤트
	function onClickChooseBtn() {
		var data = gridList.getRowData("gridList", selectedRowNum);
		callback(data);
	}
	
	// 그리드 클릭 시 rowNum 변수 저장
	function gridListEventRowClick(gridId, rowNum) {
		selectedRowNum = rowNum;
	}
	
	function callback (data) {
		data.put('param', mobile.getLinkPopData());
		window.opener.ebelnPopCallback(data);
		self.close();
	}
	
	function fn_onfocus(objId){
		$("#"+objId).select();
	}
	
	function selectData(){
		var rowNum = gridList.getFocusRowNum("gridList")
		var data = gridList.getRowData("gridList", rowNum);
		callback(data);
 	}
</script>
</head>
<body>
	<div class="main_wrap">
		<div class="tem4_content">
			<div class="select_box" id="bindArea">
				<div class="searchArea" id="searchArea">
					<table>
						<colgroup>
							<col width="80px"  />
							<col />
						</colgroup>
						<tbody id="paramArea">
							
							<tr>
								<th CL="STD_BEDAT" width="100">전기일자</th>
								<td >
									<input type="text" class="text" inputmode="none" name="BEDAT" id="BEDAT" UIFormat="C" onchange="searchList()" onkeydown="eventKeydown(event,this.id)" style="width:80%;text-align:center;float:left;"/>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			
			<div class="tableWrap_search section">
					<div class="tableHeader">
					<table style="width: 100%">
						<colgroup>
								<col width="30px" />
								<col width="100px" />
								<col width="150px" />
						</colgroup>
						<thead>
							<tr>
								<th CL="STD_NO">No.</th>
								<th CL='STD_SEBELN'>오더번호</th>
								<th CL='STD_DPTNNM'>공급업체</th>
							</tr>
						</thead>
					</table>
				</div>
				
				<div class="tableBody">
<!-- 					<table style="width: 100%; overflow:hidden;word-wrap:break-word;"> -->
					<table style="width: 100%;">
						<colgroup>
								<col width="30px" />
								<col width="100px" />
								<col width="150px" />
						</colgroup>
						<tbody id="gridList">
							<tr CGRow="true">
								<td GCol="rownum">1</td>
								<td GCol="text,EBELN">오더번호</td>
								<td GCol="text,DPTNNM">공급업체</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			
			<!-- end table_body -->
			<div class="footer_5" style="position:fixed;">
<!-- 			<div class="footer_5" "> -->
				<table>
					<tr>
						<td class=f_1 onclick="closePop()" style="width: 50%;"><label CL='BTN_CLOSE'></label></td>
						<td class=f_1 onclick="selectData()" width="50%"><label CL='STD_SPOSIT'></label></td>
					</tr>
				</table>
			</div><!-- end footer_5 -->	
		</div>
	</div>
</body>