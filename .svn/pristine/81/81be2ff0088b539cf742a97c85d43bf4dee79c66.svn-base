                            <input type="text" class="input" name="CT.NAME01" UIInput="SR" />
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_SKUKEY">품목코드</dt>
                        <dd>
                            <input type="text" class="input" name="SI.SKUKEY" UIInput="R,SHSKUMA" UIFormat="U"/>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_DESC01">품목명</dt>
                        <dd>
                            <input type="text" class="input" name="SI.DESC01" UIInput="SR"/>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_SKUG01">품목유형</dt>
                        <dd>
                            <select class="input" name="SKUG01" Combo="WmsInventory,SKUG01COMBO"><option value=""/></select>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_SKUL01">품목구분</dt>
                        <dd>
                            <select type="text" class="input" CommonCombo="SKUL01" name="SKUL01" id="SKUL01" style="width: 160px;">
                              <option value=""></option>
                            </select>
                        </dd>
                    </dl>
                                          
  
                    <dl>
                        <dt CL="STD_BNAME">영업사원명</dt>
                        <dd>
                            <input type="text" class="input" name="SH.UNAME1" UIInput="SR"/>
