                            <input type="text" class="input" Combo="Wms,KVGR" name="SH.KVGR1" id="KVGR1" ComboType="MS">
                        </dd>
                    </dl>
                </div>
                <div class="btn_tab">
                    <input type="button" class="btn_more" value="more" onclick="searchMore()"/>
                </div>
            </div>
        </div>
        <div class="search_next_wrap">
            <div class="content_layout tabs top_layout">
                <ul class="tab tab_style02">
                    <li><a href="#tab1-1"><span CL="STD_LIST">리스트</span></a></li>
                    <li class="btn_zoom_wrap">
                        <ul>
                            <!-- 2022.09.14 그리드 사이즈조정 추가
                            <li><button class="btn btn_re_size"><span>초기화</span></button></li>
                            <li><button class="btn btn_add_size"><span>증가</span></button></li>
                             -->
                            <li><button class="btn btn_bigger"><span>확대</span></button></li>
                        </ul>
                    </li>
                </ul>
                <div class="table_box section" id="tab1-1">
                    <div class="table_list01">
                        <div class="scroll">
                            <table class="table_c">
                                <tbody id="gridList">
                                    <tr CGRow="true">
                                        <td GH="40" GCol="rownum">1</td>
                                        <td GH="40" GCol="rowCheck"></td>
                                        <td GH="100 STD_IFSTAT"     GCol="text,IFSTAT">I/F 상태</td>
                                        <td GH="100 STD_IFTRGT"     GCol="text,IFTRGT">I/F 목표시스템</td>
                                        <td GH="100 STD_IFRMK"     GCol="text,IFRMK">I/F 비고</td>
                                        <td GH="100 STD_SVBELN"     GCol="text,SVBELN"></td>                                        
                                        <td GH="100 STD_DOCDAT"     GCol="input,DOCDAT" validate="required" GF="C"></td>
                                        <td GH="100 STD_SHPOKY"     GCol="text,SHPOKY">출고문서번호</td>
                                        <td GH="100 STD_STKNUM"     GCol="text,STKNUM">선적번호</td>
                                        <td GH="100 STD_STLNUM"     GCol="text,STLNUM">변경 선적번호</td>
                                        <td GH="100 STD_TOTPICKNUM" GCol="text,TOTPICKNUM"> TOTAL 피킹번호</td>
                                        <td GH="100 STD_STATDONM"   GCol="text,STATNM">상태명</td>
                                        <td GH="100 STD_DPTNKY2"     GCol="text,DPTNKY">납품처</td>
                                        <td GH="100 STD_DPTNNM3"     GCol="text,DPTNNM">납품처명</td>                                        
                                        <td GH="100 STD_VEHINO"     GCol="text,CARNO">차량번호</td>
