    //231103 자체출고처리(WMS만)
    function SendEcmsWms(){
    	
		if(gridList.validationCheck("gridListSub", "modify")){
    	
	        var head = gridList.getSelectData("gridList");
	        var headSelectIdx = gridList.getSelectRowNumList("gridList");
	        
	        if(head.length == 0){
	            commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
	            return;
	        }
	        
			for(var k=0; k < gridList.getGridData("gridListSub").length; k++){
		       	if(gridList.getRowState("gridListSub",k) == "C"){
		       		commonUtil.msgBox("MASTER_M2007")//추가된 row를 저장 후 행추가 하십시오.
		       		return;
		       	}
	        }
            /*
            if(!commonUtil.msgConfirm("OUT_M0191")){ //출고완료 하시겠습니까?
                return;
            }
            */
            
            if(!commonUtil.msgConfirm("WMS 자체출고처리하시겠습니까?")){
                return;
            }
  
            var noCount=0;
            var goYn="Y";
            
            //NEW,PSH,FSH 일 때는 출고완료 불가능
            for(var i=0;i<head.length;i++){
            	
                var INDDCL = gridList.getColData("gridList", headSelectIdx[i], "INDDCL");
                var INDCHK = gridList.getColData("gridList", headSelectIdx[i], "INDCHK");
                var headStus = gridList.getColData("gridList", headSelectIdx[i], "STATDO");
                
                var rsntxt = gridList.getColData("gridList", headSelectIdx[i], "RSNTXT");
                var qtyorg = new Number(gridList.getColData("gridList", headSelectIdx[i], "QTYORG"));
                var qtjcmp = new Number(gridList.getColData("gridList", headSelectIdx[i], "QTJCMP"));
                
                var PLTYN  = gridList.getColData("gridList", headSelectIdx[i], "PLTYN");
                var SHPOKY = gridList.getColData("gridList", headSelectIdx[i], "SHPOKY");
                
                var SHPMTY = gridList.getColData("gridList", headSelectIdx[i], "SHPMTY");
                var SIGNI = gridList.getColData("gridList", headSelectIdx[i], "SIGNI");
                var EXTI2 = gridList.getColData("gridList", headSelectIdx[i], "EXTI2");
                var ZLGORT = gridList.getColData("gridList", headSelectIdx[i], "ZLGORT");
                var VTWEG = gridList.getColData("gridList", headSelectIdx[i], "VTWEG");
                
                if(headStus =="NEW" || headStus =="REF"){
                    var shpoky = gridList.getColData("gridList", headSelectIdx[i], "SHPOKY");
                    commonUtil.msgBox("OUT_M0200", shpoky); //출하문서번호[{0}]는 아직 미작업상태의 데이터입니다.
                    gridList.setRowCheck("gridList",headSelectIdx[i],false);
                    return;
                }else if(headStus =="FAL" || headStus == "PAL"){ //할당완료,부분할당
                    var shpoky = gridList.getColData("gridList", headSelectIdx[i], "SHPOKY");
                    commonUtil.msgBox("OUT_M0201", SHPOKY); //출하문서번호[{0}]는 아직 할당상태의 데이터입니다.
                    gridList.setRowCheck("gridList",headSelectIdx[i],false);
                    return;  
                }else if(headStus =="FPC" || headStus =="PPC"){ //피킹완료
                    if(INDCHK == "V"){ //상차여부
                        var shpoky = gridList.getColData("gridList", headSelectIdx[i], "SHPOKY");
                        commonUtil.msgBox("OUT_M0202", shpoky); //출하문서번호[{0}]는 상차완료되지 않은 데이터입니다.
                        gridList.setRowCheck("gridList",headSelectIdx[i],false);
                        return;
                    }
                }else if(headStus =="PCK"){ //부분상차
                	var shpoky = gridList.getColData("gridList", headSelectIdx[i], "SHPOKY");
                        commonUtil.msgBox("OUT_M0202", shpoky); //출하문서번호[{0}]는 상차완료되지 않은 데이터입니다.
                        gridList.setRowCheck("gridList",headSelectIdx[i],false);
                        return;                    
                }else if(headStus == "FSH" || headStus == "PSH"){ //출고완료 또는 부분출고
                    var shpoky = gridList.getColData("gridList", headSelectIdx[i], "SHPOKY");
                    commonUtil.msgBox("OUT_M0203", shpoky); //출하문서번호[{0}]는 이미 출고완료된 데이터입니다.
                    gridList.setRowCheck("gridList",headSelectIdx[i],false);
                    return;
                }
                
                if(SHPMTY == "208" && ZLGORT == " " && VTWEG != "20"){
                	var shpoky = gridList.getColData("gridList", headSelectIdx[i], "SHPOKY");
                	
                	if(!commonUtil.msgConfirm("OUT_M0231", new Number(headSelectIdx[i])+1)){ //[{0}]번째 출하문서의 수출정보가 입력 완료되지 않았습니다. 지금 입력하시겠습니까?                	
                		return;	                		
                	}
                	
					var rowList = new Array();
				  	var rowData = gridList.getRowData("gridList", headSelectIdx[i]);
					rowList.push(rowData);
					page.linkPopOpen("/wms/outbound/DL08POP.page", rowList, "height=10,width=654,resizable=yes");      
					goYn = "N"
                }
                                				                
				if(PLTYN == "N" && goYn == "Y"){
						 
					if(noCount > 0){
					   	continue;
					}
						
					if(!commonUtil.msgConfirm("OUT_M0198")){  //해당 팔레트
						gridList.setRowFocus("gridList", headSelectIdx[i]);                	 	 
						return;
					}else{
						noCount++;
					}
	 
				} 
			}
                        
            if(goYn == "N"){return;}
            
			var param = saveCheck();
			
			if(param != null){
				param.put("messageOption", {
				total_count : 1,
				current_count : 1,
				message   : commonUtil.getMsg("OUT_M0251") //validate 진행중입니다.    
				})

				if(param.map.messageOption){
					netUtil.processMessage(param);
				}
    
				var vjson = netUtil.sendData({
					url : "/wms/outbound/json/validateSendEcms.data",
					param : param,
					async : true,
					loading : true,
					callBackFunction : function(returnData){
						netUtil.processMessageOff();

						if(!returnData.data.CNT && !returnData.data.result && returnData.data.SHPOKY){
							commonUtil.msgBox("OUT_M0195", returnData.data.SHPOKY); 
						}else{
							if(returnData.data.result != "OK"){
								var msgList = returnData.data.result.split(" ");
								var msgTxt = commonUtil.getMsg(msgList[0],(msgList.length > 1 ? msgList[1].split("/") : null));
								commonUtil.msg(msgTxt);
								return false;
							}
      
							param.put("messageOption", {
							//total_count : param.map.headList.length,
							total_count : 1,
							current_count : 1,
							message   : commonUtil.getMsg("OUT_M0247")//"출고완료 진행중입니다."    
							})
        
      						var json = saveNoSap(param);			            	
						}
					}
				});
			}
		}    
	}
    
	//231103 자체출고취소(WMS만)
	function CancelEcmsWms(){
		var head = gridList.getSelectData("gridList");
		var headChkRowNum = gridList.getSelectRowNumList("gridList");
		var headChkLen = gridList.getSelectRowNumList("gridList").length;
	
		if(head.length == 0){
			commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
			return;
		}
	
		if(!commonUtil.msgConfirm("WMS 자체출고취소 하시겠습니까?")){
			return;
		}
		
		var param = new DataMap();
		var shpokyList = "";
		
		for(var i=0; i < headChkLen; i++){        	
			var headStatdo = gridList.getColData("gridList", headChkRowNum[i], "STATDO");
			var headShpoky = gridList.getColData("gridList", headChkRowNum[i], "SHPOKY");
			
			if(!(headStatdo == "FSH" || headStatdo == "PSH")){
				commonUtil.msgBox("OUT_M0197", headShpoky); //선택된 데이터가 없습니다.
				return;
			}
		
			//OMH 추가 : 출고취소하기전에 DB에있는 상태랑 jsp상태랑 비교하는 로직 추가 2023.06.29 
			if (headChkLen == 1) {
				shpokyList = headShpoky
			}else if(i == headChkLen-1){
				shpokyList += "'"+headShpoky
			}else if(i != 0){
				shpokyList += "'"+headShpoky+"'" +',' 
			}else{
				shpokyList += headShpoky+"'" +','
			}
		}
	
		param.put("SHPOKY", shpokyList);
		var json = netUtil.sendData({
					module : "WmsOutboundDL082",
					command : "DL08_HEAD_STATUS_CHECK",
					sendType : "map",
					param : param
		});
		
		if(Number(json.data.CNT) != 0){
			alert("화면과 DB의 출고 유형이 차이가 납니다. 새로고침 후 진행해 주세요.");
			return;	
		}   
		
		var param = new DataMap();	 
		param.put("listData", head);
		
		param.put("messageOption", {
					//                         total_count : param.map.listData.length,
					total_count : 1,
					current_count : 1,
					message   : commonUtil.getMsg("OUT_M0248")//"출고취소 진행중입니다."    
		});
		
		var json = cancelNoSap(param);
	}
    
    //231103 자체출고용 함수 추가    
    function saveNoSap(param, recall){
    	
    	if(param.map.messageOption.current_count == 1){
    		sucCount = 0; 
    	    errCount = 0;
    	    msgHtml = "";
    	}
    	
    	if(param.map.messageOption){
            netUtil.processMessage(param);
        }
    	
    	var loopHeadList = new Array();
    		loopHeadList.push(param.map.headList[param.map.messageOption.current_count-2]);
    	
//     	param.put("loopHeadList", loopHeadList);
    	
    	param.put("loopHeadList", param.map.headList);
    	
        var json;		
		
        setTimeout(function(){
        	
        	json = netUtil.sendData({
	            url : "/wms/outbound/json/sendEcmsWms.data",
	            param : param,
	            async : true,
	            loading : true,
	            recall : recall,
                callBackFunction : function(returnData){
      					
                	var returnMsg = returnData.data.MSG;
                	
                	if(returnData.data.MSG == " "){
                		returnMsg = "";
                	}
               	
                	msgHtml = returnMsg;                		
               		errCount = returnData.data.errorCnt;
               		sucCount = returnData.data.sucessCnt;                	
                	
                    if(param.map.messageOption.total_count >= param.map.messageOption.current_count){
                    	saveNoSap(param, true);
                    }else{
                        netUtil.processMessageOff();       
                        
                        commonUtil.msgBox("실패:"+errCount +", 성공:"+sucCount+"\n"+msgHtml); //관리자에게 문의 바랍니다.
                    	searchList();
                    }
                }
	        });	        	       
	        
        }, 100);
    }
    
    // 231103 자체출고취소용 함수 추가
    function cancelNoSap(param, recall){
 	   
		if(param.map.messageOption.current_count == 1){
			sucCount = 0; 
			errCount = 0;
			msgHtml = "";
		}
 	   
		if(param.map.messageOption){
            netUtil.processMessage(param);
        }
 	   
		var loopHeadList = new Array();
 		loopHeadList.push(param.map.listData[param.map.messageOption.current_count-2]);
 		
		param.put("headList", param.map.listData);
 		
		var json;
      	
		setTimeout(function(){
      	
     	 json = netUtil.sendData({
 	            url : "/wms/outbound/json/cancelWms.data",
 	            param : param,
 	            async : true,
 	            loading : true,
 	            recall : recall,
             	callBackFunction : function(returnData){
    					
              	var returnMsg = returnData.data.MSG;
              	
              	if(returnData.data.MSG == " "){
              		returnMsg = "";
              	}
           	
           		msgHtml = returnMsg;                		
           		errCount = returnData.data.errorCnt;
           		sucCount = returnData.data.sucessCnt;                	
            	
                if(param.map.messageOption.total_count >= param.map.messageOption.current_count){
                	cancelNoSap(param, true);
                }else{
                    netUtil.processMessageOff();       
                    
                    commonUtil.msgBox("실패:"+errCount +", 성공:"+sucCount+msgHtml); //관리자에게 문의 바랍니다.
                	searchList();
                }
              }
        });	        	       
      }, 100); 	              
    }

	//231104 MES 재처리용
	function ResendEcmsMes(){
		//해당 그리드의 대상시스템이 MES이고, 상태가 실패인 항목에 대해 재전송	
		var head = gridList.getSelectData("gridList");
    	var headChkRowNum = gridList.getSelectRowNumList("gridList");
    	var headChkLen = gridList.getSelectRowNumList("gridList").length;
    	
    	if(head.length == 0){
            commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
            return;
        }
    	
        var param = new DataMap();
		var shpokyList = "";
		
        for(var i=0; i < headChkLen; i++){        	
        	var headStatdo = gridList.getColData("gridList", headChkRowNum[i], "STATDO");
        	var headShpoky = gridList.getColData("gridList", headChkRowNum[i], "SHPOKY");
        	var sysType = gridList.getColData("gridList", headChkRowNum[i], "IFTRGT");	//최종 시스템
        	var sysStat = gridList.getColData("gridList", headChkRowNum[i], "IFSTAT");	//현재 상태
            /*
        	if(!(headStatdo == "FSH" || headStatdo == "PSH")){
				commonUtil.msgBox("", headShpoky); //선택된 데이터가 없습니다.
				return;
			}
        	*/
        	if(!(sysType == "MES" && sysStat == "E")){
        		commonUtil.msgBox("MES 전송대상이 아닙니다.", headShpoky);
        		return;
        	}
        	

//         	OMH 추가 : 출고취소하기전에 DB에있는 상태랑 jsp상태랑 비교하는 로직 추가 2023.06.29 
        	if (headChkLen == 1) {
				shpokyList = headShpoky
			}else if(i == headChkLen-1){
	       		shpokyList += "'"+headShpoky
        	}else if(i != 0){
	       		shpokyList += "'"+headShpoky+"'" +',' 
        	}else{
	       		shpokyList += headShpoky+"'" +','
        	}
		}
	
		param.put("SHPOKY", shpokyList);
		var json = netUtil.sendData({
					module : "WmsOutboundDL082",
					command : "DL08_HEAD_STATUS_CHECK",
					sendType : "map",
					param : param
		});
		
		if(Number(json.data.CNT) != 0){
			alert("화면과 DB의 출고 유형이 차이가 납니다. 새로고침 후 진행해 주세요.");
			return;	
		}   
		
		if(!commonUtil.msgConfirm("MES 재처리하시겠습니까?")){
            return;
        }
		
		var param = new DataMap();	 
		param.put("listData", head);
		
		param.put("messageOption", {
					//                         total_count : param.map.listData.length,
					total_count : 1,
					current_count : 1,
					message   : commonUtil.getMsg("MES 재처리 진행중입니다.")//"출고재처리 진행중입니다."    
		});
		
        
		//해당 메뉴는 이미 SAP 전송은 끝난 상태의 데이터를 활용하므로, 별도로 validation 체크는 제외해도 될 것으로 보임
		//따라서 파라미터map 생성하여 직접 전송 처리
		var json = sendNoSap(param);
	}
    
function sendNoSap(param, recall){
    	
    	if(param.map.messageOption.current_count == 1){
    		sucCount = 0; 
    	    errCount = 0;
    	    msgHtml = "";
    	}
    	
    	if(param.map.messageOption){
            netUtil.processMessage(param);
        }
    	
    	var loopHeadList = new Array();
 		loopHeadList.push(param.map.listData[param.map.messageOption.current_count-2]);
 		
		param.put("loopHeadList", param.map.listData);
		
//     	param.put("loopHeadList", loopHeadList);
        var json;		
		
        setTimeout(function(){
        	
        	json = netUtil.sendData({
	            url : "/wms/outbound/json/ResendEcms.data",
	            param : param,
	            async : true,
	            loading : true,
	            recall : recall,
                callBackFunction : function(returnData){
      					
                	var returnMsg = returnData.data.MSG;
                	
                	if(returnData.data.MSG == " "){
                		returnMsg = "";
                	}
               	
                	msgHtml = returnMsg;                		
               		errCount = returnData.data.errorCnt;
               		sucCount = returnData.data.sucessCnt;                	
                	
                    if(param.map.messageOption.total_count >= param.map.messageOption.current_count){
                    	sendNoSap(param, true);
                    }else{
                        netUtil.processMessageOff();       
                        
                        commonUtil.msgBox("실패:"+errCount +", 성공:"+sucCount+"\n"+msgHtml); //관리자에게 문의 바랍니다.
                    	searchList();
                    }
                }
	        });	        	       
	        
        }, 100);
    }
	
    function searchHelpEventOpenBefore(searchCode, gridType, $inputObj){
        var param = new DataMap();
        if(searchCode == "SHDOCTM"){
            param.put("DOCCAT", "200");
            return param;
        }else if(searchCode == "SHCMCDV"){
            param.put("CMCDKY", "STATDO");
            return param;
        }else if(searchCode == "SHBZPTN"){
			param.put("PTNRTY", "CT");
			param.put("OWNRKY", "<%=ownrky%>");			
			return param;
		}else if(searchCode == "SHSKUMA"){
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("SKUG01", "VERP");

            return param;
        }else if(searchCode == "SHSTLMAP"){
	    	
	    	var PLNTKY = $('select[name="SI.LOTA02"]').val();
			
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("PLNTKY", PLNTKY);
	    	
	    	return param;
	    }
    }
    
    var btnVal = null;
    
    function commonBtnClick(btnName){
        if(btnName == "Search"){
            searchList();
        }else if(btnName == "Save"){  //저장
        	Save();
        }else if(btnName == "Send"){    //출고완료
            sendEcms();
        }else if(btnName == "CANCEL"){    //출고취소
            cancelEcms();
        }else if(btnName == "PePrint"){
            PePrintList();
        }else if(btnName == "RePrint"){
            RePrintList();
        }else if(btnName == "Reflect"){
            setVehiCombo();
        }else if(btnName == "ExportUpdate"){
        	exportUpdatePop();
        }else if(btnName == "SendWms") {		// 231103 WMS 자체출고
        	SendEcmsWms();
        }else if(btnName == "CancelWms"){		// 231103 WMS 자체출고취소
        	CancelEcmsWms();
        }else if(btnName == "RecallEcms"){		//231103 재전송(해당 값 중 MANDT에 따라 구분 처리. 대부분은 MES 기준으로 설정
        	ResendEcmsMes();
        }        
        
    }
    
    //거래명세서
    function PePrintList(){
		var list = gridList.getSelectData("gridList");
		
		if (list.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		} 
		
		/* 납품처코드, 선적번호 기준으로 SAP에서 데이터 호출. */
		var param = new DataMap();
		param.put("list", list);
		
		
		for(var j=0; j<list.length; j++){
			if(list[j].get("STATDO") != "FSH" && list[j].get("STATDO") != "PSH"){				
				commonUtil.msgBox("OUT_M0222"); //부분출고 또는 출고완료 상태인 문서만 출력 가능합니다.
				gridList.setRowFocus("gridList", list[j].get("GRowNum"));
				return;
			} 
			
			if(list[j].get("SHPMTY") != "201" && list[j].get("SHPMTY") != "206" && list[j].get("SHPMTY") != "208" && list[j].get("SHPMTY") != "231"){
				commonUtil.msgBox("OUT_M0227"); //거래가 있는 문서를 출력할 수 있습니다.
				gridList.setRowFocus("gridList", list[j].get("GRowNum"));
				return;
			}
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		}
		
		var json = netUtil.sendData({
			url : "/wms/outbound/json/DL08PrintTS.data",
			param : param
		});
		var dealky = json.data['DEALKY'];
		
		var param = new DataMap();
		param.put("list",list);
		param.put("columnList", "WAREKY,SHPOKY,STKNUM");
		param.put("PRTTYP","PK_LIST");
		param.put("OWNRKY", "<%=ownrky%>");
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		
		var url = "거래명세서.ezg?ver=0.24";
		var wareky  = "<%=wareky%>";
		var ownrky  = "<%=ownrky%>";
		var where = "AND SH.WAREKY='"+wareky+"' AND SH.OWNRKY='"+ownrky+"' AND (";
		for(var i=0; i<list.length; i++){
			var row = list[i];
			var key = row.get("SHPOKY");
			
			where += "SI.SHPOKY='"+key+"'";
			if(i==list.length-1) break;
			where += " OR ";	
		}
		where += ")"; 
		
		var map = new DataMap();
		
		map.put("DEALKY", dealky);
		WriteEZgenElement(url, where, "", '<%=langky%>', map, 1000, 900);
		
    }
    
    //이송명세서
    function RePrintList(){
		var list = gridList.getSelectData("gridList");
		
		if (list.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		}
		
		for(var j=0; j<list.length; j++){
			
			if(list[j].get("STATDO") != "FSH" && list[j].get("STATDO") != "PSH"){				
				commonUtil.msgBox("OUT_M0222"); //부분출고 또는 출고완료 상태인 문서만 출력 가능합니다.
				gridList.setRowFocus("gridList", list[j].get("GRowNum"));
				return;
			}
			
			if(list[j].get("SHPMTY") != "221"){
				commonUtil.msgBox("OUT_M0223"); //이송출고 상태인 문서만 출력 가능합니다.
				gridList.setRowFocus("gridList", list[j].get("GRowNum"));
				return;
			}
			
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		} 
		
		var param = new DataMap();
		param.put("list",list);
		param.put("columnList", "WAREKY,SHPOKY");
		param.put("PRTTYP","PK_LIST");
		
		param.put("OWNRKY", "<%=ownrky%>");
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		var url = "이송명세서.ezg?ver=0.10";
		var wareky  = "<%=wareky%>";
		var where = "AND SH.WAREKY='"+wareky+"' AND (";
		for(var i=0; i<list.length; i++){
			var row = list[i];
			var dptnky = row.get("DPTNKY");
			var stknum = row.get("STKNUM");
			
			where += "SI.STKNUM='"+stknum+"' AND SH.DPTNKY='"+dptnky+"'";
			if(i==list.length-1) break;
			where += " OR ";	
		}
		where += ")"; 
		
		var map = new DataMap();
		
		WriteEZgenElement(url, where, "", '<%=langky%>', map, 1000, 1000);
    }
    
    
    //저장
    function Save(){
    	var headList = gridList.getSelectData("gridList");
        var itemList = gridList.getGridData("gridListSub");
        var param = new DataMap();

        if(headList.length == 0){
            commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
            return;
        }        
        
        if(itemList.length == 0){
            commonUtil.msgBox("OUT_M0045"); //처리를 위한 아이템이 존재하지 않습니다.
            return;
        }
        
        if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){ //저장하시겠습니까?
            return;
        }
        
        if(gridList.validationCheck("gridListSub", "modify")){
        	        
        
	        var headSelectList = gridList.getSelectRowNumList("gridList");
	        
	        for(var i=0;i<headSelectList.length;i++){
	            var statdo = gridList.getColData("gridList", headSelectList[i], "STATDO");  //Head상태
	            var shpoky = gridList.getColData("gridList", headSelectList[i], "SHPOKY");  //Head 출하요청번호
	                  
	            //Head 출하완료 상태이면 밸리데이션 check
	            if(statdo == "PSH" || statdo == "FSH"){
	                commonUtil.msgBox("OUT_M0189", shpoky);   //출고문서번호 [{0}]는 출고상태이므로 수정이 불가능합니다.
	                gridList.setRowFocus("gridList", headSelectList[i], false);
	                gridListEventItemGridSearch("gridList", headSelectList[i], "gridListSub");
	                
	                return;
	            }
	        }
	        
	        param.put("headList", headList);
	        param.put("itemList", itemList);
	       
	        var json = netUtil.sendData({
	            url : "/wms/outbound/json/saveDL08.data",
	            param : param
	        });
	        
	        if(json && json.data){
	        	
				var sendMsg = json.data["MSG"];
	            
	            if(sendMsg){
	            	commonUtil.msgBox(sendMsg); //관리자에게 문의 바랍니다.
	            	return;
	            }
	        	
	        	commonUtil.msgBox("COOMON_M0463");
	        	searchList();
	        }
        }
    }
    
    
    function gridListEventRowAddBefore(gridId, rowNum, beforeData){

    	if(gridId == "gridListSub"){
    		
            var headRowNum =  gridList.getFocusRowNum("gridList")
    		var LFART = gridList.getColData("gridList", headRowNum, "LFART");  

    		if(LFART == "ZEOR"){
    			commonUtil.msgBox("OUT_M0234");//수출출고(납품문서유형 : ZEOR)은 팔레트 추가가 불가능합니다. 
    			return false;
    		}
    		
    		
			var param = dataBind.paramData("searchArea");
			var newData = new DataMap();
			
			newData.put("QTSHPD", 0); 			
			
			return newData;
		}
	}
    
    function gridListEventRowRemove(gridId, rowNum){
		
    	//기존데이터 삭제 불가능
    	if(gridId == "gridListSub"){
    		var SHPOIT = gridList.getColData(gridId, rowNum, "SHPOIT").substring(0, 1);
    		
    		
    		if(SHPOIT != 1){    			
    			return false;
    		}
    		
    	}
		
	}
    
    function comboEventDataBindeBefore(comboAtt){
        if(comboAtt == "Wms,PLNTKYCOMBO"){
            var param = new DataMap();
	        param.put("WAREKYS", "'<%= wareky%>'");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("LANGKY", "<%=langky%>");
            
            return param;
        }else if(comboAtt == "WmsOrder,RCPTTYCOMBO"){
        	
        	
            var param = new DataMap();

	 			param.put("PROGID", configData.MENU_ID);
            
            return param;
           
       }else if(comboAtt == "Wms,DEPTID"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,VTXTK"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,KVGR"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}
    }
    
    
  //수출판매에 대한 데이터 수정
   function exportUpdatePop(){
    	
	    
	    	var selectData = gridList.getSelectData("gridList");
	    	
	    	 if(selectData.length == 0){
	 	        commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 업습니다.
	 	        return;
	 	    }
	    	
	    	 
		    var SelectRowNumList = gridList.getSelectRowNumList("gridList");
	    	 
			    for(var i=0; i< selectData.length; i++){
			        var SHPMTY = gridList.getColData("gridList", SelectRowNumList[i], "SHPMTY"); //문서유형
			      
			        if(SHPMTY != "208"){
			            commonUtil.msgBox("VALID_M2100", new Number(SelectRowNumList[i])+1); //[{0}]번째 문서유형은 해당 작업가 맞지 않습니다.
			            return;
			        }
			    } 

    
	        page.linkPopOpen("/wms/outbound/DL08POP.page", selectData, "height=170,width=654,resizable=yes");
	    	    
    }
  
	// 팝업 callback
	function DocPopCallback () {
		searchList();
	}
	
	//search 전체 체크박스 클릭
	function searchCheckBoxAll(obj) {
		
		if($(obj).prop("checked") == true){
			$(obj).parent('dd').children('input').prop("checked", true);
		}else{
			$(obj).parent('dd').children('input').prop("checked", false);
		}
	}
		
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
    <div class="content_inner">
        <%@ include file="/common/include/webdek/title.jsp" %>
        <div class="content_serch" id="searchArea">
            <div class="btn_wrap">
                <div class="fl_l">
                </div>
                <div class="fl_r">
                    <input type="button" CB="Search SEARCH BTN_DISPLAY"/><!-- 조회 -->                    
                    <input type="button" CB="Save SAVE BTN_SAVE"/><!-- 저장 -->
                    <input type="button" CB="Send SEND BTN_ERPSEND"/><!-- 출고완료 -->
                    <input type="button" CB="CANCEL CANCEL BTN_CANSHP"/><!-- 출고취소 -->
                    <input type="button" CB="SendWms SEND BTN_SENDWMS"/><!-- 자체출고(WMS) -->
                    <input type="button" CB="CancelWms SEND BTN_CANCELWMS"/><!-- 자체출고취소(WMS) -->
                    <input type="button" CB="RecallEcms SEND BTN_RECALLECMS"/><!-- I/F 재전송(MES) -->
                    <input type="button" CB="PePrint PRINT BTN_PEPRINT"/><!-- 거래명세서 -->
                    <input type="button" CB="RePrint PRINT BTN_REPRINT"/><!-- 이송명세서 -->
                    <input type="button" CB="ExportUpdate EXPORTUPDATE BTN_EXPORTUPDATE"/><!-- 이송명세서 -->
                </div>
            </div>
            <div class="search_inner">
                <div class="search_wrap ">
                    <input type="hidden" class="input" name="OWNRKY" value="<%=ownrky%>" />
                    <dl>
                        <dt CL="STD_WAREKY">거점</dt>
                        <dd>
                            <input type="text" class="input" name="WAREKY" name="WAREKY"  value="<%=wareky%>" readonly="readonly" validate="required" />
                        </dd>
                    </dl>
                    <dl>
                        <dt CL="STD_LOTA02">플랜트</dt>
                        <dd>
                            <select type="text" class="input" Combo="Wms,PLNTKYCOMBO" name="SI.LOTA02" id="PLNTKY" ComboType="MS" style="width: 160px;" validate="required">
                            </select>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_LOTA01">저장위치</dt>
                        <dd>
                            <input type="text" class="input" name="SI.LOTA01" UIInput="R,SHSTLMAP" />
                        </dd>
                    </dl>                                                            
                                        
                    <dl>
                        <dt CL="STD_RQSHPD">출고요청일자</dt>
                        <dd>
                            <input type="text" class="input" name="RQSHPD" UIFormat="C -7 7" UIInput="R" validate="required"/>
                        </dd>
                    </dl>
                    <dl>
                        <dt CL="STD_STATDO">문서상태</dt>
                        <dd style="width: 640px;">
                            <input type="checkbox" class="input" id="STAT00" name="STAT00" value="V" onclick="searchCheckBoxAll(this)"/>
                            <label CL="STD_ALL" for="STAT00">전체</label>
                            <input type="checkbox" class="input" id="STAT01" name="STAT01" value="V" checked="checked"/>
                            <label CL="STD_PPICKYN" for="STAT01">부분피킹</label>
                            <input type="checkbox" class="input" id="STAT02" name="STAT02" value="V" checked="checked"/>
                            <label CL="STD_PICKED" for="STAT02">피킹완료</label>                                                        
                            <input type="checkbox" class="input" id="STAT03" name="STAT03" value="V" checked="checked"/>
                            <label CL="STD_PCK" for="STAT03">부분상차</label>
                            <input type="checkbox" class="input" id="STAT04" name="STAT04" value="V" checked="checked"/>
                            <label CL="STD_FCKCOM" for="STAT04">상차완료</label>
                            <input type="checkbox" class="input" id="STAT05" name="STAT05" value="V" checked="checked"/>
                            <label CL="STD_PSHPCOM" for="STAT05">부분출고</label>
                            <input type="checkbox" class="input" id="STAT06" name="STAT06" value="V"/>
                            <label CL="STD_SHPCOM" for="STAT06">출고완료</label>                            
                        </dd>
                    </dl>    
                    
                     <dl>
                        <dt CL="STD_STKNUM">선적번호</dt>
                        <dd>
                            <input type="text" class="input" name="SI.STKNUM" UIInput="SR"/>
                        </dd>
                    </dl>
                      
                    <dl>
                        <dt CL="STD_SSHTYP">출고유형</dt>
                        <dd>
                            <!-- <input type="text" class="input" name="SH.SHPMTY" UIInput="R,SHDOCTM"/> -->
                            <select type="text" class="input" Combo="WmsOrder,RCPTTYCOMBO" name="SH.SHPMTY" id="SH.SHPMTY" ComboType="MS" validate="required">
                            </select>
                        </dd>
                    </dl>
                    <dl>
                        <dt CL="STD_SHPOKY">출하문서번호</dt>
                        <dd>
                            <input type="text" class="input" name="SH.SHPOKY" UIInput="SR"/>
                        </dd>
                    </dl>                    
                    <dl>
                        <dt CL="STD_SVBELN">출고오더번호</dt>
                        <dd>
                            <input type="text" class="input" name="SI.SVBELN" UIInput="SR" UIFormat="U"/>
                        </dd>
                    </dl>                   
                    
                    <dl>
                        <dt CL="STD_TOTPICKNUM">TOTAL 피킹번호</dt>
                        <dd>
                            <input type="text" class="input" name="TP.STKNUM" UIInput="SR"/>
