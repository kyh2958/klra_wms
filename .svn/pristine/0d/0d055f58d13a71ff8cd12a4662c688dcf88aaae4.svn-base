<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Grid default</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<style>
@page {
    size: A4;
    margin: 5mm;
    size: landscape;
}

body #moveSheet {
    margin: 0;
    font-family: "Malgun Gothic", Arial, sans-serif;
    font-size: 12px;
}

#moveSheet.sheet {
    display: flex;
    width: 100%;
    background-color: white;
}

#moveSheet .slip {
    width: 25%;
    box-sizing: border-box;
    border-right: 1px dashed #000;
    padding: 6px;
}

#moveSheet .slip:last-child {
    border-right: none;
}

#moveSheet .header {
    text-align: center;
    margin-bottom: 4px;
}

#moveSheet .logo {
    font-weight: bold;
    font-size: 16px;
}

#moveSheet .barcode {
    border: 0px solid #000;
    margin: auto;
    text-align: center;
    font-size: 10px;
}

#moveSheet .title {
    font-weight: bold;
    margin-bottom: 4px;
}

#moveSheet table {
    width: 100%;
    border-collapse: collapse;
}

#moveSheet  th, td {
    border: 1px solid #000;
    padding: 2px;
    height: 20px;
    text-align: center;
}

#moveSheet th {
    background: #f5f5f5;
    font-weight: normal;
    text-align: left;
    width: 30%;
}

#moveSheet .section-title {
    text-align: center;
    font-weight: bold;
    background: #eee;
}

#moveSheet .qty-table th, #moveSheet .qty-table td {
    text-align: center;
}

#moveSheet .footer {
    margin-top: 4px;
    text-align: center;
    font-size: 10px;
}
</style>
<script type="text/javascript">

var contents;
var retBody;

$(function(){
	
	$(document).ready(function(){
		
		
		
	})
	
	// DB조회된 이동전표값으로 반복문 처리하여 
	$("#print").on('click', function(){
		var $div = $("#moveSheet .slip");
		
		//$("#bcTarget").barcode("1234567890128", "ean13");  
		$div.find(".barcode").barcode('01099992958', 'code128', {barWidth:1.5, barHeight:35})
		$div.find(".logo").text('KPP 팔레트')
		$div.find(".sendDate").text('2026.01.26')
		$div.find(".companyFrom").text('발송회사')
		$div.find(".nameFrom").text('이삭 (인)')
		$div.find(".phoneFrom").text('010-1234-1234')
		
		$div.find(".companyTo").text('도착')
		$div.find(".nameTo").text('일삭 (인)')
		$div.find(".phoneTo").text('010-5555-6666')
		
		$div.find(".company").text('아윤이네')
		$div.find(".carNo").text('02가 1234')
		$div.find(".name").text('김윤호')
		
		setTimeout(function(){
			
			printWindow('moveSheet');
			
		}, 200)
		
	})
	
})


function printWindow(div) {
    prtContent = document.getElementById(div);
    window.onbeforeprint = beforePrint;
    window.onafterprint = afterPrint;
    window.print();
}

function beforePrint(){
	$("#print").hide()
    initBody = document.body.innerHTML;
    document.body.innerHTML = contents.innerHTML;
}

function afterPrint(){
	$("#print").show()
    //document.body.innerHTML = retBody;
}


</script>
</head>
