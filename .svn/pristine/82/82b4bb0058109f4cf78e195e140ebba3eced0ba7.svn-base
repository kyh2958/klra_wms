	@RequestMapping("/rfc/json/rfcCall.*")
	public String rfcCall(HttpServletRequest request, Map<String, Object> model) throws Exception {
		DataMap map = (DataMap)request.getAttribute(CommonConfig.PARAM_ATT_KEY);
		
		DataMap result = new DataMap();
		result = service.receive_START(map);

		model.put("data", result.get("data"));
		model.put("row_count", result.get("row_count"));
		
		return JSON_VIEW;
	}
	
	@RequestMapping(value = "/common/omsApi/json/{ifid}/{type}.*", method=RequestMethod.POST)
	public String recieveOmsRESTFUL(@PathVariable String ifid, @PathVariable String type, HttpServletRequest request, Map<String, Object> model) throws SQLException {
		
		DataMap map = (DataMap) request.getAttribute(CommonConfig.PARAM_ATT_KEY);
	    DataMap resultMap = new DataMap();
	    model.put("IFID", ifid);
	    model.put("MSG", "요청이 실패 하였습니다.");
	    model.put("result", "FAIL");

	    // 1. IFID 유효성 검증
	    List<String> validIfids = Arrays.asList("OMS_IF_308", "OMS_IF_216", "OMS_IF_2041");
	    if (!validIfids.contains(ifid)) {
	    	model.put("MSG", "유효하지 않은 IFID 요청");
	        return JSON_VIEW;
	    }

	    // 2. 기본값 세팅 (삭제여부 검토)
	    map.put("I_GUBUN", type);
	    map.put("ifid", ifid);
	    map.put(CommonConfig.SES_USER_ID_KEY, "OMSAPI");
		
	    System.out.println("=== [OMS API 수신 요청] ======================================");
	    System.out.println("IFID : " + ifid + " / TYPE : " + type);
	    System.out.println("요청 파라미터 : " + map.toString());
	    log.debug("요청 파라미터 : " + map.toString());
	    System.out.println("============================================================");

	    // 3. IFID별 처리
	    if ("OMS_IF_216".equals(ifid)) { // 입고 (판매, 이송)
	    	resultMap = service.getWmsGRList(map);
	    	
	    } else if ("OMS_IF_308".equals(ifid)) { // 출고 (판매, 이송)
	    	resultMap = service.getWmsGIList(map);
	        
	    } else if ("OMS_IF_2041".equals(ifid)) { // 임가공 입고
	    	resultMap = service.getWmsGRTollPList(map);
	    }
	    
	    // resultMap의 내용을 model에 병합
	    if (resultMap != null && !resultMap.isEmpty()) {
	        model.putAll(resultMap);
	    }

	    // 4. 결과 반환
	    System.out.println("=== [OMS API 응답 결과] ======================================");
	    System.out.println(model.toString());
	    System.out.println(resultMap.toString());
	    System.out.println("============================================================");

	    return JSON_VIEW;
	}
}