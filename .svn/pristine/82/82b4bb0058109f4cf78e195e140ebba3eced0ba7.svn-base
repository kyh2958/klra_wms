	@RequestMapping("/IF/{module}/excel/{command}.*")
	public String excel(HttpServletRequest request, @PathVariable String module, @PathVariable String command, Map<String, Object> model) throws SQLException{		
		DataMap map = (DataMap)request.getAttribute(CommonConfig.PARAM_ATT_KEY);
		map.setModuleCommand(module, command);

		String data = service.getListString(map);
		
		return excelView(map, model, data);
	}

	@RequestMapping(value = "/common/api/json/{module}/{id}.*", method=RequestMethod.GET)
	public String selectIF(@PathVariable String module, @PathVariable String id, Map<String, Object> model) throws SQLException {
		Map<String, String> list = new HashMap<>();
		
		list.put("module", module);
		list.put("id", id);
		model.putAll(list);
		
		return JSON_VIEW;
	}

	@RequestMapping(value = "/common/api/json/{ifid}/{comm}.*", method=RequestMethod.POST)
	public String recieveRESTFUL(@PathVariable String ifid, @PathVariable String comm, HttpServletRequest request, Map<String, Object> model) throws SQLException {
		// RESTFUL 데이터 수신
		DataMap map = (DataMap)request.getAttribute(CommonConfig.PARAM_ATT_KEY);
		Map<String, String> list = new HashMap<>();
		String data = null;
		
		// 임시 품질대상->결과 변경
		if(       ifid.equals("WMS_IF_208")) { ifid = "WMS_IF_209";
		} else if(ifid.equals("WMS_IF_212")) { ifid = "WMS_IF_213";
		}
		// 임시 품질대상->결과 변경
		
		DataMap logMap = new DataMap();
		logMap.setModuleCommand("Erpif", "IFWMSLOG");
		logMap.put("IFID", ifid);
		logMap.put("COMSTAT", "C");
		logMap.put(CommonConfig.SES_USER_ID_KEY, ifid);
		commonDao.insert(logMap);
		
		String logseqno = logMap.get("SEQNO").toString();
		map.put("IFID", ifid);
		map.put("LOGSEQNO", logseqno);

		try {
			data = service.receiveRESTFUL(request, map);
		} catch (Exception e) {
		}
		
		list.put("IFID", ifid);
		list.put("result", data); // 성공 : SUCCESS, 그외 오류내용
		
		model.putAll(list);
		
		// 수신결과 리턴 (처리결과 전송)
		return JSON_VIEW;
	}
	
	@RequestMapping("/wms/erpif/json/receiveIF.*")
	public String receiveIF(HttpServletRequest request, Map<String, Object> model) throws SQLException{
		// 엑셀 업로드
		DataMap map = (DataMap)request.getAttribute(CommonConfig.PARAM_ATT_KEY);

		String data = null;
		String ifid   = map.get("IFID").toString();

		DataMap logMap = new DataMap();
		logMap.setModuleCommand("Erpif", "IFWMSLOG");
		logMap.put("IFID", ifid);
		logMap.put("COMSTAT", "C");
		logMap.put("REMARK", "EXCEL");
		logMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		commonDao.insert(logMap);
		
		String logseqno = logMap.get("SEQNO").toString();
		map.put("LOGSEQNO", logseqno);
		map.put("REMARK", "EXCEL");
		
		try {
			data = service.receive_IF(map);
			
//			if(!data.equals("SUCCESS")) {
//				logMap.put("COMSTAT", "E");
//				logMap.put("ERRTXT", data);
//				commonDao.update(logMap);
//			}
		} catch (Exception e) {
//			logMap.put("COMSTAT", "E");
//			logMap.put("ERRTXT", e);
//			commonDao.update(logMap);
		}
		
		model.put("data", data);
		
		return JSON_VIEW;
	}
	
