	/**
	 * RFC CALL INBOUND FUNCTION
	 * @param IF_NAME
	 * @param IF_RETBL
	 * @param I_FLAG
	 * @param list
	 * @return returnList
	 */
	public List<DataMap> ReRfcCallTable(String IF_NAME, String IF_RETBL, String IF_RESTR, String I_FLAG, String I_RESEND,  List<DataMap> list) {
		
		RfcCallClient rfcCallClient = new RfcCallClient();
		List<DataMap> returnList = new ArrayList();
		DataMap baseMap = new DataMap();
		DataMap map = new DataMap();
		
		baseMap = RfcCallConnSet(); 				// RFC CALL CONNECTION SET             
		
		baseMap.put("IF_NAME", IF_NAME);			// FUNCTION NAME
		baseMap.put("IF_RETBL", IF_RETBL);		// TABLE NAME
		baseMap.put("IF_RESTR", IF_RESTR);		// STRUCTURE NAME
		map.put("I_FLAG", I_FLAG);				// D : 수신 , R : 송신
		map.put("I_RESEND", I_RESEND);				// D : 수신 , R : 송신
		
		try {
			if (list.size() > 0 ) {
				// 결과 송신
				returnList = rfcCallClient.flagToTableInboundResult(list, baseMap, map);
			} else {
				// 수신
				returnList = rfcCallClient.flagToTableInbound(baseMap, map);
			}
			
		} catch (JCoException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
			
			throw new RuntimeException(e);
		}
		return returnList;
	}	
	
	
	/**
	 * RFC CALL INBOUND FUNCTION
	 * @param IF_NAME
	 * @param IF_RETBL
	 * @param I_FLAG
	 * @param list
	 * @return returnList
	 */
	public List<DataMap> StockRfcCallTable(String IF_NAME, String IF_RETBL, String IF_RESTR, String IV_BUKRS, String IV_YYYYMM, String IV_DATE, List<DataMap> list) {
		
		RfcCallClient rfcCallClient = new RfcCallClient();
		List<DataMap> returnList = new ArrayList();
		DataMap baseMap = new DataMap();
		DataMap map = new DataMap();
		
		baseMap = RfcCallConnSet(); 				// RFC CALL CONNECTION SET             
		
		baseMap.put("IF_NAME", IF_NAME);			// FUNCTION NAME
		baseMap.put("IF_RETBL", IF_RETBL);		// TABLE NAME
		baseMap.put("IF_RESTR", IF_RESTR);		// STRUCTURE NAME
		map.put("IV_BUKRS", IV_BUKRS);				// D : 수신 , R : 송신
		map.put("IV_YYYYMM", IV_YYYYMM);				// D : 수신 , R : 송신
		map.put("IV_DATE", IV_DATE);				// D : 수신 , R : 송신
		
		try {
			if (list.size() > 0 ) {
				// 결과 송신
				returnList = rfcCallClient.flagToTableInboundResult(list, baseMap, map);
			} else {
				// 수신
				returnList = rfcCallClient.flagToTableInbound(baseMap, map);
			}
			
		} catch (JCoException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		return returnList;
	}		
	
	/**
	 * RFC CALL SimpleImportTableRfc
	 * @param IF_NAME,          // RFC NAME
	 * @param INPUT_TABLE,      // 입력 TABLE (ex. T_INPUT)
	 * @param OUTPUT_TABLE,     // 출력 TABLE (ex. T_OUTPUT)
	 * @param importMap,       // IMPORT 파라미터 (ex. I_MODE)
	 * @param inputList // 입력 TABLE 데이터
	 * @return returnList
	 */
	public List<DataMap> SimpleImportTableRfc(String IF_NAME, String INPUT_TABLE, String OUTPUT_TABLE, DataMap importMap, List<DataMap> inputList) {

	    RfcCallClient rfcCallClient = new RfcCallClient();
	    List<DataMap> returnList = new ArrayList<>();

	    // RFC 접속 정보 + 함수명
	    DataMap baseMap = RfcCallConnSet();
	    baseMap.put("IF_NAME", IF_NAME);

	    try {
	        returnList = rfcCallClient.callSimpleImportTableRfc(
	                baseMap,        // 접속정보 + RFC명
	                importMap,      // IMPORT
	                INPUT_TABLE,    // INPUT TABLE
	                inputList,      // INPUT DATA
	                OUTPUT_TABLE    // OUTPUT TABLE
	        );

	    } catch (JCoException e) {
	        e.printStackTrace();
	        throw new RuntimeException(e);
	    }

	    return returnList;
	}

	/**
	 * 고지자원 입고 RFC 호출
	 * RFC : Z_MM_ROH2_GR_FROM_PDA
	 */
	public DataMap RfcCallZ_MM_ROH2_GR_FROM_PDA(DataMap importMap) {

	    RfcCallClient rfcCallClient = new RfcCallClient();
	    DataMap baseMap = new DataMap();
	    DataMap result;

	    System.out.println("importMap >>" + importMap.toString());
	    
	    try {
	        // 1. RFC 접속 정보 세팅
	        baseMap = RfcCallConnSet();

	        // 2. RFC 이름 설정
	        baseMap.put("IF_NAME", "Z_MM_ROH2_GR_FROM_PDA");

	        // 3. RFC 호출
	        result = rfcCallClient.callZ_MM_ROH2_GR_FROM_PDA(
	                baseMap,      // 접속정보 + RFC명
	                importMap     // IMPORT 파라미터
	        );

	    } catch (Exception e) {
	        log.error("Z_MM_ROH2_GR_FROM_PDA RFC ERROR", e);
	        result = new DataMap();
	        result.put("EV_RCODE", "E");
	        result.put("EV_RMSG", e.getMessage());
	    }

	    return result;
	}
	
	/**
	 * 고지자원 입고취소 RFC 호출
	 * RFC : Z_MM_ROH2_CANCEL_FROM_PDA
	 */
	public DataMap RfcCallZ_MM_ROH2_CANCEL_FROM_PDA(DataMap map) {

	    DataMap result = new DataMap();
	    DataMap baseMap = new DataMap();

	    try {
	        // 1. SAP 접속 정보
	        baseMap = RfcCallConnSet();
	        baseMap.put("IF_NAME", "Z_MM_ROH2_CANCEL_FROM_PDA");

	        // 2. RFC 실행 
	        RfcCallClient client = new RfcCallClient();
	        result = client.callZ_MM_ROH2_GR_FROM_PDA(baseMap, map);

	    } catch (Exception e) {
	        log.error("Z_MM_ROH2_CANCEL_FROM_PDA RFC ERROR", e);
	        result.put("EV_RCODE", "E");
	        result.put("EV_RMSG", e.getMessage());
	    }

	    return result;
	}
	
