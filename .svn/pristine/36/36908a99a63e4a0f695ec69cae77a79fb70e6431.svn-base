<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!doctype html>

<head>
<meta charset="utf-8">
<meta name="viewport" content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width, target-densitydpi=medium-dpi" />
<meta name="format-detection" content="telephone=no" />
<title>Smile Mobile WMS</title>
<%@ include file="/mobile/include/head.jsp" %>

<style type="text/css">
button{ vertical-align: bottom; height: 37px; }
input:read-only{ background-color: #e2e2e2; }
select:disabled{ background-color: #e2e2e2; }

#kioskq {
    font-family: "Pretendard","Noto Sans KR","Malgun Gothic",sans-serif;
    color: #1f1f29;
    background: linear-gradient(135deg,#f6f8ff,#fdf6f2);
    min-height: 100vh;
    margin: 0;
}

#kioskq .kiosk-wrapper {
    max-width: 1600px;
    margin: 0 auto;
    padding: 28px 32px 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100vh;
    box-sizing: border-box;
}

#kioskq .kiosk-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    background: #fff;
    border-radius: 24px;
    padding: 22px 28px;
    border: 1px solid rgba(37,61,126,0.12);
    box-shadow: 0 18px 28px rgba(27,46,106,0.12);
}

#kioskq .header-left {
    display:flex;
    align-items:center;
    gap:24px;
    flex:1;
    min-width:0;
}

#kioskq .brand-text {
    min-width: 0;
}

#kioskq .tagline {
    white-space: nowrap;
}

#kioskq .brand-logo {
    width:158px;
    height:auto;
}

#kioskq .brand {
    margin:0;
    font-size: clamp(28px,3vw,38px);
    font-weight:700;
}

#kioskq .tagline {
    margin:6px 0 0;
    font-size: clamp(17px,1.8vw,22px);
    color:#5d647a;
}

#kioskq .header-right {
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:12px;
    margin-left:auto;
    width:auto;
}

#kioskq .time-box {
    min-width: 220px;
    background: #f7f9ff;
    border: 1px solid #d8def2;
    border-radius: 18px;
    padding: 14px 18px;
    text-align: center;
}

#kioskq .time-box span {
    display:block;
    white-space:nowrap;
    line-height:1.25;
}

#kioskq #currentDate {
    font-size: clamp(16px, 1.7vw, 20px);
    color:#5d647a;
}

#kioskq #currentTime {
    font-size: clamp(26px, 2.8vw, 34px);
    letter-spacing: 0.03em;
    font-weight: 700;
    color:#1f1f29;
}

#kioskq .total-box {
    min-width: 150px;
    background: linear-gradient(135deg,#3f59d8,#2742c3);
    color:#fff;
    border-radius: 18px;
    padding: 14px 18px;
    text-align:center;
    box-shadow:0 16px 26px rgba(39,66,195,0.24);
}

#kioskq .total-box .label {
    display:block;
    font-size:16px;
    opacity:.9;
}

#kioskq .total-box .value {
    display:block;
    margin-top:2px;
    font-size:38px;
    font-weight:800;
    line-height:1.1;
}

#kioskq .total-box .unit {
    display:block;
    margin-top:2px;
    font-size:18px;
}

#kioskq .summary-panel {
    display:grid;
    grid-template-columns:repeat(3, minmax(0,1fr));
    gap:18px;
}

#kioskq .summary-card {
    background:#fff;
    border-radius:22px;
    padding:22px 24px;
    border:1px solid rgba(37,61,126,0.1);
    box-shadow:0 16px 26px rgba(27,46,106,0.1);
}

#kioskq .summary-card .summary-title {
    font-size:22px;
    font-weight:700;
    color:#32436d;
}

#kioskq .summary-card .summary-value {
    margin-top:12px;
    font-size:34px;
    font-weight:800;
    color:#1f1f29;
}

#kioskq .board-panel {
    display:grid;
    grid-template-columns:repeat(3, minmax(0,1fr));
    gap:18px;
    flex:1;
    min-height:0;
}

#kioskq .board-column {
    background:#fff;
    border-radius:24px;
    border:1px solid rgba(37,61,126,0.1);
    box-shadow:0 16px 26px rgba(27,46,106,0.1);
    overflow:hidden;
    display:flex;
    flex-direction:column;
    min-height:0;
}

#kioskq .board-column-head {
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:28px 28px;
    color:#fff;
}

#kioskq .board-column.arrival .board-column-head {
    background:#4661dc;
}
#kioskq .board-column.preparing .board-column-head {
    background:#5a6f9b;
}
#kioskq .board-column.ready .board-column-head {
    background:#2f8f63;
}

#kioskq .board-column-head h2 {
    margin:0;
    font-size:28px;
    font-weight:800;
}

#kioskq .board-column-head .count {
    font-size:22px;
    font-weight:700;
}

#kioskq .board-list {
    flex:1;
    min-height:0;
    padding:18px;
    display:flex;
    flex-direction:column;
    gap:14px;
    overflow:auto;
    background:#fbfcff;
    -ms-overflow-style: none;
    scrollbar-width: none;
}

#kioskq .board-list::-webkit-scrollbar {
    display: none;
}

#kioskq .board-item {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:18px 18px;
    border-radius:18px;
    background:#fff;
    border:1px solid #dde2f3;
    box-shadow:0 4px 10px rgba(27,46,106,0.05);
    transition: transform .2s ease, background-color .2s ease, box-shadow .2s ease;
}

#kioskq .board-item .left {
    display:flex;
    flex-direction:column;
    gap:6px;
    min-width:0;
}

#kioskq .board-item .carno {
    font-size:32px;
    font-weight:800;
    letter-spacing:0.08em;
    color:#1f1f29;
    line-height:1.1;
}

#kioskq .board-item .stknum {
    font-size:16px;
    color:#68708a;
    word-break:break-all;
}

#kioskq .board-item .seq {
    min-width:64px;
    height:64px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#eef2ff;
    color:#2742c3;
    font-size:22px;
    font-weight:800;
}
#kioskq .board-item.urgent {
    border: 2px solid #ff7a00;
    box-shadow: 0 8px 18px rgba(255,122,0,0.16);
}

#kioskq .board-item .left-top {
    display:flex;
    align-items:center;
    gap:10px;
    min-width:0;
}

#kioskq .board-item .urgent-badge {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:58px;
    height:28px;
    padding:0 12px;
    border-radius:999px;
    background:linear-gradient(135deg,#ff8a00,#ff5a00);
    color:#fff;
    font-size:15px;
    font-weight:800;
    line-height:1;
    flex:0 0 auto;
}


#kioskq .board-item .seq.urgent-text {
    min-width:84px;
    padding:0 12px;
    border-radius:32px;
    background:linear-gradient(135deg,#ff8a00,#ff5a00);
    color:#fff;
    font-size:20px;
    font-weight:800;
}
#kioskq .board-item.empty {
    justify-content:center;
    min-height:100px;
    color:#8b93ad;
    font-size:22px;
    background:#fafbff;
}

#kioskq .footer-bar {
    display:flex;
    justify-content:flex-end;
    gap:12px;
}

#kioskq .btn-kiosk {
    height: 62px;
    min-width: 170px;
    border-radius: 18px;
    border: none;
    font-weight: 700;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: filter .2s ease, transform .15s ease;
}

#kioskq .btn-kiosk.primary {
    background: linear-gradient(135deg,#3f59d8,#2742c3);
    color:#fff;
    box-shadow:0 16px 26px rgba(39,66,195,0.24);
}

#kioskq .btn-kiosk.neutral {
    background:#f4f6ff;
    color:#2742c3;
    border:1px solid #c7cce7;
}

#kioskq .btn-kiosk:hover { filter:brightness(1.05); }
#kioskq .btn-kiosk:active { transform:translateY(2px); }

.blink-item {
       animation: itemBlinkAnim 1s ease-in-out 6 !important;
       position: relative;
       z-index: 2;
}


@keyframes itemBlinkAnim {
    0%   { background-color: #ffffff; transform: scale(1); box-shadow:0 4px 10px rgba(27,46,106,0.05); }
    50%  { background-color: #ffeb3b; transform: scale(1.04); box-shadow:0 0 0 4px rgba(255,213,79,0.55); }
    100% { background-color: #ffffff; transform: scale(1); box-shadow:0 4px 10px rgba(27,46,106,0.05); }
}



@media (max-width: 1400px) {
    #kioskq .board-panel,
    #kioskq .summary-panel {
        grid-template-columns:1fr;
    }

    #kioskq .kiosk-header {
        flex-direction:column;
        align-items:flex-start;
    }
}


#kioskq .total-box {
    width:96px;
    height:96px;
    border-radius:20px;
    box-shadow:0 10px 18px rgba(27,46,106,0.18);
}

#kioskq .total-box .value {
    font-size:34px;
}

#kioskq .time-box {
    padding:16px 26px;
    border-radius:18px;
    background:#f1f3f9;
    border:1px solid #d6dceb;
}

#kioskq #currentTime {
    font-size:32px;
}
</style>

<script>

var BOARD_REFRESH_MS = 10000;
var BOARD_SCROLL_STEP = 1;
var BOARD_SCROLL_INTERVAL = 60;
var BOARD_SCROLL_EDGE_PAUSE_MS = 3000;
var BOARD_BLINK_RESUME_MS = 8000;
var BOARD_TIMER = null;
var FIRST_LOAD = true;
var boardEventSource = null;

var prevSnapshot = {
	    arrival: {},
	    preparing: {},
	    ready: {}
	};

var blinkTargetMap = {};
var autoScrollTimers = {};
var autoScrollPauseMap = {};
var autoScrollResumeTimerMap = {};
var latestBlinkKeyMap = {};
var latestBlinkTargetId = null;
var blinkFocusTargetMap = {};
var BOARD_HOLD_REFRESH = false;
var BOARD_PENDING_REFRESH = false;
var autoScrollDirectionMap = {};
var autoScrollEdgePauseTimerMap = {};
var autoScrollPositionMap = {};
var autoScrollTickCountMap = {};

$(document).ready(function(){
    updateClock();
    setInterval(updateClock, 1000);

    loadBoard();
    connectSse();

    BOARD_TIMER = setInterval(function(){
        loadBoard();
    }, BOARD_REFRESH_MS);
});

function connectSse() {
    var topic = "BOARDSTEP_<%=wareky%>_<%=ownrky%>";

    if (boardEventSource) {
        try {
            boardEventSource.close();
        } catch (e) {}
    }

    boardEventSource = new EventSource("/api/sse/subscribe?topic=" + topic);

    boardEventSource.onopen = function () {
    };

    boardEventSource.addEventListener("BoardStep.refresh", function (event) {
        if (event && event.data) {
        }

        latestBlinkTargetId = null;
        loadBoard();
    });

    boardEventSource.onerror = function (e) {

        try {
            boardEventSource.close();
        } catch (ex) {}

        setTimeout(function(){
            connectSse();
        }, 3000);
    };
}


function updateClock() {
    var now = new Date();

    var yyyy = now.getFullYear();
    var mm   = ("0" + (now.getMonth() + 1)).slice(-2);
    var dd   = ("0" + now.getDate()).slice(-2);

    var hh   = ("0" + now.getHours()).slice(-2);
    var mi   = ("0" + now.getMinutes()).slice(-2);
    var ss   = ("0" + now.getSeconds()).slice(-2);

    $("#currentDate").text(yyyy + "." + mm + "." + dd);
    $("#currentTime").text(hh + ":" + mi + ":" + ss);
}


function logScrollState(targetId, phase, extra) {
    var el = document.getElementById(targetId);
    if (!el) {
        return;
    }

    var maxScrollTop = Math.max(0, el.scrollHeight - el.clientHeight);
}

function stopAutoScroll(targetId) {
    if (autoScrollTimers[targetId]) {
        clearInterval(autoScrollTimers[targetId]);
        autoScrollTimers[targetId] = null;
    }

    clearAutoScrollEdgePauseTimer(targetId);
}

function pauseAutoScroll(targetId) {
    autoScrollPauseMap[targetId] = true;
}

function resumeAutoScroll(targetId) {
    autoScrollPauseMap[targetId] = false;
}

function clearAutoScrollResumeTimer(targetId) {
    if (autoScrollResumeTimerMap[targetId]) {
        clearTimeout(autoScrollResumeTimerMap[targetId]);
        autoScrollResumeTimerMap[targetId] = null;
    }
}

function pauseScrollForBlink(targetId, vehicleKey) {
    var el = document.getElementById(targetId);
    if (!el) {
        return;
    }

    pauseAutoScroll(targetId);
    clearAutoScrollResumeTimer(targetId);

    var target = el.querySelector('.board-item[data-vehicle-key="' + vehicleKey + '"]');

    if (!target) {
        return;
    }

    var elRect = el.getBoundingClientRect();
    var targetRect = target.getBoundingClientRect();

    var absoluteTargetTop = el.scrollTop + (targetRect.top - elRect.top);

    var moveTop = absoluteTargetTop - 10;

    if (moveTop < 0) {
        moveTop = 0;
    }

    var maxScrollTop = el.scrollHeight - el.clientHeight;
    if (moveTop > maxScrollTop) {
        moveTop = maxScrollTop;
    }

    el.scrollTop = moveTop;

    requestAnimationFrame(function () {
        el.scrollTop = moveTop;

        setTimeout(function () {
            el.scrollTop = moveTop;

            var afterRect = target.getBoundingClientRect();
        }, 80);
    });

    autoScrollResumeTimerMap[targetId] = setTimeout(function () {
        resumeAutoScroll(targetId);
    }, BOARD_BLINK_RESUME_MS);
}

function captureScrollPosition(targetId) {
    var el = document.getElementById(targetId);
    if (!el) return;

    autoScrollPositionMap[targetId] = {
        scrollTop: el.scrollTop,
        maxScrollTop: Math.max(0, el.scrollHeight - el.clientHeight)
    };
}



function restoreScrollPosition(targetId) {
    var el = document.getElementById(targetId);
    var saved = autoScrollPositionMap[targetId];

    if (!el || !saved) return;

    var newMaxScrollTop = Math.max(0, el.scrollHeight - el.clientHeight);
    var moveTop = saved.scrollTop;

    if (moveTop > newMaxScrollTop) {
        moveTop = newMaxScrollTop;
    }
    if (moveTop < 0) {
        moveTop = 0;
    }

    el.scrollTop = moveTop;

    if (moveTop >= newMaxScrollTop) {
        autoScrollDirectionMap[targetId] = -1;
    } else if (moveTop <= 0) {
        autoScrollDirectionMap[targetId] = 1;
    }
}


function startAutoScroll(targetId) {
    var el = document.getElementById(targetId);

    if (!el) {
        return;
    }

    var savedScrollInfo = autoScrollPositionMap[targetId];
    var prevScrollTop = (savedScrollInfo && typeof savedScrollInfo.scrollTop !== "undefined")
        ? savedScrollInfo.scrollTop
        : el.scrollTop;

    stopAutoScroll(targetId);

    if (el.scrollHeight <= el.clientHeight) {
        el.scrollTop = 0;
        autoScrollPauseMap[targetId] = false;
        autoScrollDirectionMap[targetId] = 1;
        return;
    }

    if (autoScrollPauseMap[targetId] !== true) {
        autoScrollPauseMap[targetId] = false;
    }

    if (autoScrollPauseMap[targetId] === true) {
    } else {
        el.scrollTop = prevScrollTop;
    }

    var maxScrollTop = el.scrollHeight - el.clientHeight;

    if (typeof autoScrollDirectionMap[targetId] === "undefined" || autoScrollDirectionMap[targetId] === null) {
        autoScrollDirectionMap[targetId] = 1;
    }

    if (el.scrollTop >= maxScrollTop) {
        autoScrollDirectionMap[targetId] = -1;
    } else if (el.scrollTop <= 0) {
        autoScrollDirectionMap[targetId] = 1;
    }

    var pause = false;
    autoScrollTickCountMap[targetId] = 0;

    autoScrollTimers[targetId] = setInterval(function () {
        autoScrollTickCountMap[targetId]++;

        if (!el || pause || autoScrollPauseMap[targetId]) return;

        el.scrollTop += (autoScrollDirectionMap[targetId] * BOARD_SCROLL_STEP);

        if (el.scrollTop >= (maxScrollTop - BOARD_SCROLL_STEP)) {
            el.scrollTop = maxScrollTop;
            pause = true;

            clearAutoScrollEdgePauseTimer(targetId);
            autoScrollEdgePauseTimerMap[targetId] = setTimeout(function () {
                autoScrollDirectionMap[targetId] = -1;
                pause = false;
            }, BOARD_SCROLL_EDGE_PAUSE_MS);

        } else if (el.scrollTop <= 0) {
            el.scrollTop = 0;
            pause = true;

            clearAutoScrollEdgePauseTimer(targetId);
            autoScrollEdgePauseTimerMap[targetId] = setTimeout(function () {
                autoScrollDirectionMap[targetId] = 1;
                pause = false;
            }, BOARD_SCROLL_EDGE_PAUSE_MS);
        }
    }, BOARD_SCROLL_INTERVAL);
}


function refreshAutoScroll() {
    
    startAutoScroll("arrivalList");
    startAutoScroll("preparingList");
    startAutoScroll("readyList");
}

function loadBoard() {
    if (BOARD_HOLD_REFRESH) {
        BOARD_PENDING_REFRESH = true;
        return;
    }

    var param = new DataMap();
    param.put("WAREKY", "<%=wareky%>");
    param.put("OWNRKY", "<%=ownrky%>");
    param.put("KIOSK_MTYPE", "<%=mtype%>");

    var json = netUtil.sendData({
        module : "WmsMobileOutboundPicking_COPY",
        command : "KIOSK_CAR_STATUS",
        param : param
    });

    var list = [];
    if (json && json.data) {
        if ($.isArray(json.data)) {
            list = json.data;
        } else {
            list = [json.data];
        }
    }

    renderBoard(list);
}


function renderBoard(list) {
    var arrivalRawList = [];
    var preparingRawList = [];
    var readyRawList = [];

    for (var i = 0; i < list.length; i++) {
        var row = list[i];
        var step = $.trim(nvl(row.BOARD_STEP, ""));

        if (step === "ARRIVAL") {
            arrivalRawList.push(row);
        } else if (step === "PREPARING") {
            preparingRawList.push(row);
        } else if (step === "READY") {
            readyRawList.push(row);
        }
    }

    var arrivalList   = buildGroupedVehicleList(arrivalRawList, "ARRIVAL");
    var preparingList = buildGroupedVehicleList(preparingRawList, "PREPARING");
    var readyList     = buildGroupedVehicleList(readyRawList, "READY");

  

    blinkTargetMap = {};
    latestBlinkKeyMap = {};
    latestBlinkTargetId = null;
    blinkFocusTargetMap = {};

    markBlinkTargets(arrivalList, prevSnapshot.arrival, "arrivalList");
    markBlinkTargets(preparingList, prevSnapshot.preparing, "preparingList");
    markBlinkTargets(readyList, prevSnapshot.ready, "readyList");

    
    
    captureScrollPosition("arrivalList");
    captureScrollPosition("preparingList");
    captureScrollPosition("readyList");
    
    renderBoardList("arrivalList", arrivalList);
    renderBoardList("preparingList", preparingList);
    renderBoardList("readyList", readyList);
    
    restoreScrollPosition("arrivalList");
    restoreScrollPosition("preparingList");
    restoreScrollPosition("readyList");

    $("#arrivalCnt").text(arrivalList.length);
    $("#preparingCnt").text(preparingList.length);
    $("#readyCnt").text(readyList.length);

    $("#arrivalCnt2").text(arrivalList.length);
    $("#preparingCnt2").text(preparingList.length);
    $("#readyCnt2").text(readyList.length);

    $("#totalCnt").text(arrivalList.length + preparingList.length + readyList.length);
    var wasFirstLoad = FIRST_LOAD;
    var changed = hasBoardChanged(arrivalList, preparingList, readyList);

    if (!FIRST_LOAD && changed) {
        playBoardAlert();
    }

    prevSnapshot.arrival   = toGroupedSnapshot(arrivalList);
    prevSnapshot.preparing = toGroupedSnapshot(preparingList);
    prevSnapshot.ready     = toGroupedSnapshot(readyList);

    FIRST_LOAD = false;

    var hasBlinkTarget = false;
    for (var key in blinkFocusTargetMap) {
        if (blinkFocusTargetMap.hasOwnProperty(key) && blinkFocusTargetMap[key]) {
            hasBlinkTarget = true;
            break;
        }
    }

    if (hasBlinkTarget) {
        BOARD_HOLD_REFRESH = true;
        BOARD_PENDING_REFRESH = false;

        setTimeout(function () {
            focusBlinkTargets();

            setTimeout(function () {
                applyBlinkEffect();
            }, 250);

            setTimeout(function () {
                refreshAutoScroll();

                BOARD_HOLD_REFRESH = false;
                

                if (BOARD_PENDING_REFRESH) {
                   
                    BOARD_PENDING_REFRESH = false;
                    loadBoard();
                }
            }, 7200);
        }, 200);
    } else {
        if (wasFirstLoad || changed) {
            refreshAutoScroll();
        }
    }
}

function buildGroupedVehicleList(rawList, boardStep) {
    var map = {};
    var result = [];

    for (var i = 0; i < rawList.length; i++) {
        var row = rawList[i];

        var carno = $.trim(nvl(row.CARNO, ""));
        var stknum = $.trim(nvl(row.STKNUM, ""));
        var shpoky = $.trim(nvl(row.SHPOKY, ""));
        var printSeq = $.trim(nvl(row.PRINT_SEQ, ""));
        var displayNo = $.trim(nvl(row.DISPLAY_NO, ""));
        var urgentYn = $.trim(nvl(row.URGENT_YN, "N"));
        var location = $.trim(nvl(row.LOCATION, ""));
        var groupKey = makeGroupKey(boardStep, carno);

        if (!map[groupKey]) {
            map[groupKey] = {
                BOARD_STEP: boardStep,
                CARNO: carno,
                STKNUM_LIST: [],
                PRINT_SEQ: printSeq,
                PRINT_SEQ_NUM: toNumberOrMax(printSeq),
                DISPLAY_NO: displayNo,
                URGENT_YN: urgentYn,
                LOCATION: location,
                SHPOKY: shpoky,
                GROUP_KEY: groupKey
            };
            result.push(map[groupKey]);
        }

        var group = map[groupKey];

        if (stknum && $.inArray(stknum, group.STKNUM_LIST) === -1) {
            group.STKNUM_LIST.push(stknum);
        }

        var rowPrintSeqNum = toNumberOrMax(printSeq);
        if (rowPrintSeqNum < group.PRINT_SEQ_NUM) {
            group.PRINT_SEQ_NUM = rowPrintSeqNum;
            group.PRINT_SEQ = printSeq;
            group.DISPLAY_NO = displayNo;
            group.URGENT_YN = urgentYn;
            group.SHPOKY = shpoky;
        }
    }
    result.sort(function(a, b) {
        var aUrgent = $.trim(nvl(a.URGENT_YN, "N")) === "Y" ? 0 : 1;
        var bUrgent = $.trim(nvl(b.URGENT_YN, "N")) === "Y" ? 0 : 1;

        if (aUrgent !== bUrgent) {
            return aUrgent - bUrgent;
        }

        if (a.PRINT_SEQ_NUM !== b.PRINT_SEQ_NUM) {
            return a.PRINT_SEQ_NUM - b.PRINT_SEQ_NUM;
        }

        if (a.CARNO < b.CARNO) return -1;
        if (a.CARNO > b.CARNO) return 1;
        return 0;
    });
    
    return result;
}

function markBlinkTargets(groupedList, prevStageSnapshot, targetId) {
    for (var i = 0; i < groupedList.length; i++) {
        var row = groupedList[i];
        var groupKey = row.GROUP_KEY;
        var currentSnapshot = makeGroupedFullKey(row);
        var prevSnapshotValue = prevStageSnapshot[groupKey];

        if (!FIRST_LOAD && prevSnapshotValue !== currentSnapshot) {

            blinkTargetMap[groupKey] = true;
            latestBlinkKeyMap[groupKey] = targetId;

            if (!latestBlinkTargetId) {
                latestBlinkTargetId = targetId;
            }

            if (!blinkFocusTargetMap[targetId]) {
                blinkFocusTargetMap[targetId] = groupKey;
            }
        }
    }
}

function focusBlinkTargets() {
    for (var targetId in blinkFocusTargetMap) {
        if (!blinkFocusTargetMap.hasOwnProperty(targetId)) continue;

        var vehicleKey = blinkFocusTargetMap[targetId];
        if (!vehicleKey) continue;

        pauseScrollForBlink(targetId, vehicleKey);
    }
}

function toGroupedSnapshot(groupedList) {
    var map = {};

    for (var i = 0; i < groupedList.length; i++) {
        var row = groupedList[i];
        map[row.GROUP_KEY] = makeGroupedFullKey(row);
    }

    return map;
}




function makeGroupKey(boardStep, carno) {
    return $.trim(nvl(boardStep, "")) + "|" + $.trim(nvl(carno, ""));
}

function makeGroupedFullKey(row) {
    var stkList = row.STKNUM_LIST || [];
    var sortedList = stkList.slice(0).sort();
    return row.GROUP_KEY + "|" + sortedList.join(",");
}

function toNumberOrMax(v) {
    var n = parseInt(v, 10);
    if (isNaN(n)) {
        return 999999999;
    }
    return n;
}

function applyBlinkEffect() {
    var played = false;

    for (var key in blinkTargetMap) {
        if (!blinkTargetMap.hasOwnProperty(key)) continue;

        var targetId = latestBlinkKeyMap[key];
        var $target = $('.board-item[data-vehicle-key="' + key + '"]');

        if (!targetId || $target.length === 0) continue;

        $target.removeClass("blink-item");

        (function($el){
            setTimeout(function(){
                $el.addClass("blink-item");

                // 🔥 딱 1번만
                if (!played) {
                    playBoardAlert();
                    played = true;
                }
            }, 80);
        })($target);
    }
}

function clearAutoScrollEdgePauseTimer(targetId) {
    if (autoScrollEdgePauseTimerMap[targetId]) {
        clearTimeout(autoScrollEdgePauseTimerMap[targetId]);
        autoScrollEdgePauseTimerMap[targetId] = null;
    }
}
function renderBoardList(targetId, list) {
    var html = [];
    var currentTargetId = targetId;
    var normalSeq = 0;

    if (!list || list.length === 0) {
        html.push('<div class="board-item empty">표시 중인 차량이 없습니다.</div>');
    } else {
        for (var i = 0; i < list.length; i++) {
            var row = list[i];
            var carno = htmlEscape(nvl(row.CARNO, "-"));
            var stknumText = htmlEscape((row.STKNUM_LIST || []).join(", "));
            var vehicleKey = htmlEscape(row.GROUP_KEY);
            var urgentYn = $.trim(nvl(row.URGENT_YN, "N"));
            var isUrgent = (urgentYn === "Y");
            var displayNo = "";
            var location = $.trim(nvl(row.LOCATION, ""));
            if (isUrgent) {
                displayNo = "긴급";
            } else {
                normalSeq++;
                displayNo = String(normalSeq);
            }

            html.push('<div class="board-item' + (isUrgent ? ' urgent' : '') + '" data-vehicle-key="' + vehicleKey + '" data-target-id="' + currentTargetId + '">');
            html.push('  <div class="left">');
            html.push('      <div class="left-top">');
            html.push('          <div class="carno">' + carno + '</div>');
            html.push('      </div>');
            html.push('      <div class="stknum">선적번호 : ' + stknumText + '</div>');
            if(location != ""){
                html.push('      <div class="stknum">로케이션 ' + htmlEscape(location) + ' 이동해주세요</div>');
            }
            html.push('  </div>');
            html.push('  <div class="seq' + (isUrgent ? ' urgent-text' : '') + '">' + htmlEscape(displayNo) + '</div>');
            html.push('</div>');
        }
    }

    $("#" + targetId).html(html.join(""));
}


function hasBoardChanged(arrivalList, preparingList, readyList) {
    var nextArrival   = JSON.stringify(toGroupedSnapshot(arrivalList));
    var nextPreparing = JSON.stringify(toGroupedSnapshot(preparingList));
    var nextReady     = JSON.stringify(toGroupedSnapshot(readyList));

    var prevArrival   = JSON.stringify(prevSnapshot.arrival);
    var prevPreparing = JSON.stringify(prevSnapshot.preparing);
    var prevReady     = JSON.stringify(prevSnapshot.ready);

    return (nextArrival !== prevArrival)
        || (nextPreparing !== prevPreparing)
        || (nextReady !== prevReady);
}


function playBoardAlert() {
    var audio = document.getElementById("boardAlertAudio");
    if (!audio) return;

    try {
        audio.currentTime = 0;
        var playPromise = audio.play();
        if (playPromise && typeof playPromise.catch === "function") {
            playPromise.catch(function(){});
        }
    } catch (e) {
    }
}

function nvl(v, d) {
    if (v === undefined || v === null || v === "") {
        return d;
    }
    return v;
}

function htmlEscape(str) {
    return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}
</script>
</head>

<body id="kioskq">
<div class="kiosk-wrapper">

    <div class="kiosk-header">
        <div class="header-left">
            <img src="/common/theme/webdek/images/kleannara_logo.png" alt="깨끗한나라 로고" class="brand-logo">
            <div class="brand-text">
                <p class="brand">차량 출차 현황판</p>
                <p class="tagline">LOGISTICS VEHICLE DEPARTURE MANAGEMENT</p>
            </div>
        </div>

        <div class="header-right">
            <div class="total-box">
                <span class="label">전체</span>
                <span class="value" id="totalCnt">0</span>
                <span class="unit">대</span>
            </div>

            <div class="time-box">
                <span id="currentDate"></span>
                <span id="currentTime"></span>
            </div>
        </div>
    </div>

    <section class="board-panel">
        <div class="board-column arrival">
            <div class="board-column-head">
                <h2>입차</h2>
                <span class="count"><strong id="arrivalCnt2">0</strong>대</span>
            </div>
            <div class="board-list" id="arrivalList"></div>
        </div>

        <div class="board-column preparing">
            <div class="board-column-head">
                <h2>상품 준비중</h2>
                <span class="count"><strong id="preparingCnt2">0</strong>대</span>
            </div>
            <div class="board-list" id="preparingList"></div>
        </div>

        <div class="board-column ready">
            <div class="board-column-head">
                <h2>출고 준비 완료</h2>
                <span class="count"><strong id="readyCnt2">0</strong>대</span>
                 
            </div>
            <div class="board-list" id="readyList"></div>
        </div>
    </section>

</div>

<audio id="boardAlertAudio" preload="auto">
   <source src="/beepsound/beep_success.mp3" type="audio/mpeg">
</audio>
</body>