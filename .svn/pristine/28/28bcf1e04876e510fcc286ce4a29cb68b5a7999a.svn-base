	public boolean checkExecTime(Map batchInfo, Date startTime) {
		boolean resultFlag = false;
		String currentTime = "";
		String remark = (String) batchInfo.get("REMARK");
		String execTime = (String) batchInfo.get("POLLTM");
		String formatType = (String) batchInfo.get("POLLTY");
		String formatTime = "";

		if (formatType.equals("MI")) {
			// 분 "MI" MI : 05 (5분마다 실행)
			formatTime = "mm";
		} else if (formatType.equals("HM")) {
			// 특정시간 "HM" HH24MI : 1730 (매일 17시 30분에 실행)
			formatTime = "HHmm";
		} else if (formatType.equals("DHM")) {
			// 매월 00일00시00분 "DHM" ddHH24MI : 010700 (매월 01일 07시 00분에 실행)
			formatTime = "ddHHmm";
		}

//		log.debug(formatTime);
		if (StringUtils.isEmpty(execTime.trim()) == false) {
			SimpleDateFormat sdf = new SimpleDateFormat(formatTime);
			currentTime = sdf.format(startTime);

			if (formatType.equals("MI")) {
//				log.debug(Integer.valueOf(currentTime) + " : "+ Integer.valueOf(execTime));
				if ((Integer.valueOf(currentTime) % Integer.valueOf(execTime)) == 0) {
					resultFlag = true;
				} else {
					resultFlag = false;
				}
			} else if (formatType.equals("HM")) {
//				log.debug(currentTime + " : "+ Integer.valueOf(execTime));
				if (execTime.indexOf(currentTime) >= 0) {
					resultFlag = true;
				} else {
					resultFlag = false;
				}
			} else if (formatType.equals("DHM")) {
				log.debug(Integer.valueOf(currentTime) + " : " + Integer.valueOf(execTime));
				if ((Integer.valueOf(currentTime) % Integer.valueOf(execTime)) == 0) {
					resultFlag = true;
				} else {
					resultFlag = false;
				}
			}
		}

		return resultFlag;
	}
	
