    private static final int SECOND= 1000;
    
    private String SERVER_TYPE =  "prod";	//dev, prod
	
	@Scheduled(cron="0/60 * * * * *")
	public void batchStart() throws Exception{

		String serverType = PropertyUtil.getProperty("commonconfig.properties", "server.type");
		if( serverType.equals(SERVER_TYPE)) {
			
			JdbcLockService.startCrontabTask("WMS_SCHEDULE",59*SECOND,59*SECOND,()-> {
			
				// I/F 송수신 설정마스터정보를 조회한다.
				log.debug("batchStart");
				try {
					List batchList = batchInterfaceService.listIF();
					
					if(batchList != null){
						// 배치실행 시점의 시간을 기록한다.
						Calendar cal = Calendar.getInstance();
						Date currentTime = cal.getTime();
						
						DataMap masterInfo = null;
						DataMap rtn = null;
						for(int i=0; i<batchList.size(); i++){
							masterInfo = (DataMap)batchList.get(i);
							
							if(   !masterInfo.get("IFID").equals("WMS_IF_301") //출고예정-주문
							   && !masterInfo.get("IFID").equals("WMS_IFC301")
							   && !masterInfo.get("IFID").equals("WMS_IFB301")
							   && !masterInfo.get("IFID").equals("WMS_IFS301")
							   && !masterInfo.get("IFID").equals("WMS_IF_302") //출고예정-이송
							   && !masterInfo.get("IFID").equals("WMS_IFC302")
							   && !masterInfo.get("IFID").equals("WMS_IFB302")
							   && !masterInfo.get("IFID").equals("WMS_IFS302")
							   && !masterInfo.get("IFID").equals("WMS_IF_206") // 반품입고
							   && !masterInfo.get("IFID").equals("WMS_IFC206")
							   && !masterInfo.get("IFID").equals("WMS_IFB206")
							   && !masterInfo.get("IFID").equals("WMS_IFS206")
							   && !masterInfo.get("IFID").equals("WMS_IFC3012")	// TMS 납품문서 신규
							   && !masterInfo.get("IFID").equals("WMS_IFB3012") // TMS 납품문서 수정
							   ) {
								if(masterInfo != null && masterInfo.get("IFSTAT").equals("ON")){
									// 배치설정 주기와 동일시간인지 체크한다.
									if(checkExecTime(masterInfo, currentTime) == false){
										continue;
									}
									
									log.debug("Start Job!!" + masterInfo.get("IFID"));
	
									batchInterfaceService.run(session, masterInfo);
									
									log.debug("End Job!! ##### "+rtn);
								}
							}
						}
					}
				} catch (SQLException e) {
					log.debug("WMS_SCHEDULE : EXCEPTION " + e.getMessage());
				}
			});
		}
	}
	
