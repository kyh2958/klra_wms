	}
	
</script>
</head>
<body>
	<div class="main_wrap">
		<div class="tem4_content">
			<div class="select_box" id="bindArea">
				<div id="searchArea">
					<table>
						<colgroup>
							<col width="25%" />
							<col width="25%" />
							<col width="35%" />
							<col width="15%" />
							<col />
						</colgroup>
						<tbody>
							<tr style="display:none">
								<th CL="STD_OWNRKY" width="100">화주</th>
								<td>
									<input type="hidden" id="selectSKU">
									<!-- <select Combo="WmsMaster_ComboBoxDatas,OWNER" name="OWNRKY" id="OWNRKY"">
									</select> -->
								</td>
							</tr>
							
						</tbody>
					</table>
				</div>
			</div>
			<div class="tableWrap_search section" >
				<div class="tableHeader">						 
					<table style="width: 100%">
						<colgroup>
							<col width="25px" />
							<col width="120px" />
							<col width="160px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="60px" />					
							<col width="80px" />
						</colgroup> 
						<thead>
							<tr>
								<th CL="STD_NO">NO</td>		
								<th CL="STD_MATNR">품목코드</th>
								<th CL="STD_DESC01">품목명</th>
								<th CL="STD_UOMKEY">단위</th>
								<th CL="STD_QTYORG">오더수량</th>
								<th CL="STD_QTYRCV1">지시수량</th>
								<th CL="STD_QTJCMP">피킹수량</th>
								<th CL="STD_SDUOKY">기본단위</th>
								<th CL="STD_STATIT">아이템상태</th>
								<th CL="STD_LOTA07">MTO</th>
								<th CL="STD_QTYORGBOX">오더수량BOX</th>
								<th CL="STD_QTSHPOBOX">지시수량BOX</th>
								<th CL="STD_QTJCMPBOX">피킹수량BOX</th>
							</tr>
						</thead>
					</table>
				</div>
				<div class="tableBody">
					<table style="width: 100%">
						<colgroup>
							<col width="25px" />
							<col width="120px" />
							<col width="160px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="55px" />
							<col width="60px" />					
							<col width="80px" />
						</colgroup>
						<tbody id="gridList">
							<tr CGRow="true">
								<td GCol="rownum">NO</td>
								<td GCol="text,SKUKEY">품목코드</td>
								<td GCol="text,DESC01">품목명</td>
								<td GCol="text,UOMKEY">오더단위</td>
								<td GCol="text,QTYORG" GF="N 20,2">오더수량</td>
								<td GCol="text,QTSHPO" GF="N 20,2">지시수량</td>
								<td GCol="text,QTJCMP" GF="N 20,2">피킹수량</td>
								<td GCol="text,DUOMKY">기본단위</td>
								<td GCol="text,STATIT">아이템상태</td>								
								<td GCol="text,LOTA07">MTO</td>
								<td GCol="text,QTYORGBOX" GF="N 20,2">오더수량BOX</td>
								<td GCol="text,QTSHPOBOX" GF="N 20,2">지시수량BOX</td>
								<td GCol="text,QTJCMPBOX" GF="N 20,2">피킹수량BOX</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			<!-- gridListHidden 데이터만 가지고오기 -->
				<div style="margin-bottom: 0px;display:none;">
					<div class="tableHeader">
						<table> 
							<thead>
								<tr class="thead">
									<th CL="STD_TASKKY">작업지시번호</th>
									<th CL="STD_LOCAKY3">로케이션</th>
									<th CL="STD_MATNR">품목코드</th>
									<th CL="STD_STKNUM">선적번호</th>
									<th CL="STD_DESC01">품목명</th>
									<th CL="STD_EANCOD">바코드1</th>
									<th CL="STD_GTINCD">바코드2</th>
									<th CL="STD_LOTA01">LOTA01</th>
									<th CL="STD_LOTA02">LOTA02</th>
									<th CL="STD_LOTA07">LOTA07</th>
									<th CL="STD_LOTA14">LOTA14</th>
									<th CL="STD_TASKKY">작업지시번호</th>
									<th CL="STD_STATIT">문서상태값</th>
								</tr>
							</thead>
						</table>
					</div>
					<div class="tableBody">
						<table style="width: 900px">
							<tbody id="gridListHidden">
								<tr CGRow="true">
									<td GCol="text,LOCAKY">로케이션</td>
									<td GCol="text,SKUKEY">품목코드</td>
									<td GCol="text,STKNUM">선적번호</td>
									<td GCol="text,DESC01">품목명</td>								
									<td GCol="text,EANCOD">바코드1</td>
									<td GCol="text,GTINCD">바코드2</td>
									<td GCol="text,LOTA01">LOTA01</td>
									<td GCol="text,LOTA02">LOTA02</td>
									<td GCol="text,LOTA07">LOTA07</td>	
									<td GCol="text,LOTA14">LOTA14</td>
									<td GCol="text,STATIT">문서상태값</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
				
			<!-- gridListHidden2 바코드 스캔 후 넘길 데이터만 가지고오기 -->
					<div style="margin-bottom: 0px;display:none;">
						<div class="tableBody">
							<table style="width: 900px">
								<tbody id="gridListSub">
									<tr CGRow="true">
										<td GCol="text,TASKKY">작업문서번호</td>
										<td GCol="text,TASKIT">작업문서아이템</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>		
			<div class="select_box">
				<table>
					<colgroup>
						<col width="80px"/>
						<col width="50px"/>
						<col width="60px"/>
						<col width="50px"/>
						<col width="30px"/>
						<col width="50px"/>
						<col width="60px"/>
					</colgroup>
					<tbody>
						<tr>
							<th  CL='STD_COMPCNT'>완료건수</th>
							<td CL='STD_ALL'>전체</td>
							<td>
								<input type="text" class="text gridColInputNumber" name="COMPCNT" id="COMPCNT" readonly/>
							</td>
							<td CL='STD_CNT'>count</td>
							<td CL='STD_INCLU'>중</td>
							<td>
								<input type="text" class="text gridColInputNumber" name="COMPCNT2" id="COMPCNT2" readonly/>
							</td>
							<td CL='STD_CNT'>count</td>
						</tr>
						<!-- <tr>
							<th CL='STD_QTCOMP_L7141'>완료수량</th>
							<td CL='STD_ALL'>전체</td>
							<td>
								<input type="text" class="text gridColInputNumber" name="QTCOMP_L7141" id="QTCOMP_L7141" readonly/>
							</td>
							<td>
								<input type="text" class="text" name="UOMKEY2" id="UOMKEY2" style="text-align:center" readonly/>
							</td>
							<td CL='STD_INCLU'>중</td>
							<td>
								<input type="text" class="text gridColInputNumber" name="QTCOMP_L7141_2" id="QTCOMP_L7141_2" readonly/>
							</td>
							<td>
								<input type="text" class="text" name="UOMKEY3" id="UOMKEY3" style="text-align:center" readonly/>
							</td>
						</tr> -->
					</tbody>
				</table>
			</div>
			<!-- end table_body -->
			<div class="footer_5" style="margin-top: 5px; position:fixed;" >
				<table>
					<tr>
						<td class=f_1 width="30%" onclick="window.top.closePage()">
							<label CL='BTN_CLOSE'></label>
						</td>						
						<td class=f_1 width="30%" onclick ="searchList()" >
							<label CL='BTN_REFRESH'></label>
						</td>
						<td class=f_1 width="30%" onclick="previtem()">
							<label CL='BTN_PREVITEM'></label>
						</td>						
					</tr>
				</table>
			</div><!-- end footer_5 -->	
		</div>
	</div>
</body>