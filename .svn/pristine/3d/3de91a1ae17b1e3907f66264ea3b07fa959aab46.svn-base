<script>
	
	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",
			editable : false,
			module : "WmsMobileOutboundPicking_COPY",					  
			command : "PDPK05_DETAIL",
			gridMobileType : true,
			emptyMsgType:false
		});
		
		 gridList.setGrid({
				id : "gridListHidden",
				module : "WmsMobileOutboundPicking_COPY",					  
				command : "PDPK05_DETAIL_SUB",
				gridMobileType : true,
				emptyMsgType : false
			});  
		 
		if("<%=BARCOD%>" != "") {
			$("#BARCOD").val("<%=BARCOD%>");
		}				
				
		searchList();
	});
	
	// 작업지시번호로 문서정보검색
	function searchList(){		
				
		
		var BARCOD = $("#BARCOD").val();
		
		var param = new DataMap();
		
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("LANGKY", "<%=langky%>");
<%-- 		param.put("PLNTKY", '<%=plntky%>'); --%>
		
		param.put("BARCOD", BARCOD);
		param.put("DPTNKY", '<%=DPTNKY%>');
		param.put("STKNUM", '<%=STKNUM%>');
		param.put("TASKKY", '<%=TASKKY%>');
		param.put("LOTA07", '<%=LOTA07%>');
		
		param.put("PROGID", "PK05_DETAIL");
		
		
		gridList.resetGrid("gridList");
		
		gridList.gridList({
			id : "gridList",
			param : param
		});		
		
		
		param.put("INOUTCHK", 'RESET');
	}
	
	function gridListEventRowDblclick(gridBox, rowNum){
				
		var SKUKEY = gridList.getColData("gridList", rowNum, "SKUKEY");	
		var DESC01 = gridList.getColData("gridList", rowNum, "DESC01");
		var STKNUM = gridList.getColData("gridList", rowNum, "STKNUM");
		var LOTA07 = gridList.getColData("gridList", rowNum, "LOTA07");
		

	    var rowData = gridList.getRowData("gridList", rowNum);
		
	    var param = new DataMap();
    	param.put("data", rowData);
		
		
		location.href="/mobile/PDPK05_DETAIL02_COPY.page?SKUKEY="+SKUKEY+"&DESC01="+DESC01+"&STKNUM="+STKNUM+'&DPTNKY='+'<%=DPTNKY%>'+'&LOTA07='+LOTA07;
		
		+'<%=SEARCHCOUNT%>'
					  
	}

	function gridListEventDataBindEnd(gridId, dataLength){
		
		if(gridId == "gridList" && dataLength == 0){
			PlaySound('e');
			gridList.resetGrid("gridList");
		
		}else if(gridId == "gridList" && dataLength > 0){
									
			var param = new DataMap();
			
			param.put("WAREKY", '<%=wareky%>');						
			param.put("DPTNKY", '<%=DPTNKY%>');
			param.put("STKNUM", '<%=STKNUM%>');
			param.put("TASKKY", '<%=TASKKY%>');
<%-- 			param.put("PLNTKY", '<%=plntky%>'); --%>
			
			var json = netUtil.sendData({
				url : "/mobile/Mobile_COPY/json/PDPK05DETAILCNT.data",			
				param : param
			});
			
			if(json && json.data["CNT"] > 0){
				
				var CNT = Number(json.data["CNT"]);
				
				$("#COMPCNT").val(CNT);        //전체 건수
				$("#COMPCNT2").val(Number(json.data["COMPCNT2"]));   //현재까지 완료된 건수
				/* 
				$("#QTCOMP_L7141").val(Number(json.data["QTTAOR"]));   //전체 수량
				$("#QTCOMP_L7141_2").val(Number(json.data["QTCOMP"]));   //현재까지 완료된 수량
				$("#UOMKEY2").val(json.data["UOMKEY"]);        //단위
				$("#UOMKEY3").val(json.data["UOMKEY"]);        //단위
				 */				
				
				if(CNT == 0){
					resetGrid();
					PlaySound("e");					
					commonUtil.msgBox("MOBILE_M0001", null, null, function () { //작업지시번호가 존재하지 않습니다.
						$('#BARCOD').focus();            			
					}); 
					
				}else{
					PlaySound("s");
					$('#BARCOD').focus();
				}
				
				
			}
			
			// 품목명칭 index
			var tdDesc01Index = $("#gridList").closest("div.tableWrap_search").find(".tableHeader th").filter(function(i){
				if($(this).attr('CL') == 'STD_DESC01'){
					return i;
				}
			}).index();
			
			for(var i=0; i < dataLength; i++){
				
				$("#gridList tr:eq("+i+") td:eq("+tdDesc01Index+")").text(gridList.getColData(gridId,i,"DESC01").replace(/깨끗한나라|보솜이|프레미뇽|디어스킨|메디프렌즈/g, ""));

	 			if(gridList.getColData(gridId, i, "STATIT") == "FPC"){
	 				gridList.setRowCss(gridId, i, {'color':'blue'});
	 			} 
	 		}
		
		}else if(gridId == "gridListHidden" && dataLength > 0){
			
			var key = $.trim($("#BARCOD").val());
			
			for(var i=0; i < gridList.getGridData("gridListHidden").length; i++){
				
				var checkItem1 = gridList.getColData("gridListHidden", i, "SKUKEY");
				var checkItem2 = gridList.getColData("gridListHidden", i, "EANCOD");
				var checkItem3 = gridList.getColData("gridListHidden", i, "GTINCD");
				var checkItem4 = gridList.getColData("gridListHidden", i, "LOTA14");
				var checkItem5 = gridList.getColData("gridListHidden", i, "STATIT");
				
				if((key == checkItem1 || key ==checkItem2 || key == checkItem3 || key == checkItem4) && (checkItem5 == "NEW")){
						
					var BARCOD = key;	
					var DPTNKY = '<%=DPTNKY%>';		
					var LOCAKY = gridList.getColData("gridListHidden", i, "LOCAKY");	
					var SKUKEY = gridList.getColData("gridListHidden", i, "SKUKEY");	
					var DESC01 = gridList.getColData("gridListHidden", i, "DESC01");
					var LOTA01 = gridList.getColData("gridListHidden", i, "LOTA01");
					var LOTA02 = gridList.getColData("gridListHidden", i, "LOTA02");
					var LOTA07 = gridList.getColData("gridListHidden", i, "LOTA07");
					var LOTA14 = gridList.getColData("gridListHidden", i, "LOTA14");
					var STKNUM = gridList.getColData("gridListHidden", i, "STKNUM");
					var SHPOKY = gridList.getColData("gridListHidden", i, "SHPOKY");
					
					
					var param = new DataMap();
					
					var rowData = gridList.getRowData("gridListHidden", i);
					
			    	param.put("data", rowData);
			    	param.put("DPTNKY", '<%=DPTNKY%>');
			    	
// 					var json = netUtil.sendData({
// 						url : "/mobile/Mobile_COPY/json/taskLockCheck.data",			
// 						param : param
// 					});
					
// 					if(json && json.data){
						
// 						if(json.data["PAIDSR"]){
							
// 							PlaySound("e");					
// 							commonUtil.msgBox("OUT_M0241", json.data["PAIDSR"], null, function () { //해당 지시건은 현재 다른 사용자 [{0}]가 처리중입니다.
// 								$('#BARCOD').focus();            			
// 							}); 
// 							return;
// 						}
						
// 					}
					
					location.href="/mobile/PDPK05_DETAIL02_COPY.page?DPTNKY="+DPTNKY+"&LOCAKY="+LOCAKY+"&BARCOD="+BARCOD+
								  "&SKUKEY="+SKUKEY+"&DESC01="+DESC01+"&STKNUM="+STKNUM+
								  "&LOTA01="+LOTA01+"&LOTA02="+LOTA02+"&LOTA07="+LOTA07+'&SEARCHCOUNT='+'<%=SEARCHCOUNT%>'+
								  "&SHPOKY="+SHPOKY;
					
					return;
				}
			}

			
		}else if(gridId == "gridListHidden" && dataLength == 0){
							
			PlaySound("e");					
			commonUtil.msgBox("MOBILE_M0046", null, null, function () { //할당정보와 다른 바코드입니다.
				$('#BARCOD').focus();            			
			}); 
			
			
		} 
		
		
	}
	
	function showMain() {
		window.top.closePage();
	}
	
	function eventKeydown(event,objId){
// 		if(event.keyCode == "13"){
				
