										<td GH="100 STD_DESC01" GCol="text,DESC01">품목명</td>
										<td GH="100 STD_UOMKEY" GCol="text,UOMKEY">단위</td>
										<td GH="100 STD_QTSIWH" GCol="text,QTSIWH" GF="N 20,3">재고수량</td>
										<td GH="100 STD_STKAMT" GCol="text,STKAMT" GF="N 20,3">재고금액</td>
										<td GH="100 STD_UNITAMT" GCol="text,STKUNITAMT" GF="N 20,3">재고단가</td>
										<td GH="100 STD_USEQTY" GCol="text,USEQTY" GF="N 20,3">가용수량</td>
										<td GH="100 STD_QTSCNU" GCol="text,QTSCNU" GF="N 20,3">불용수량</td> <!-- Can Not Use -->
										<td GH="100 STD_QTSIQT" GCol="text,QTSIQT" GF="N 20,3">품질수량</td> <!-- Inspection QuanTity -->
										<td GH="100 STD_QTSWQT" GCol="text,QTSWQT" GF="N 20,3">폐기수량</td> <!-- Wasted     QuanTity -->
										<td GH='100 STD_QTSHQT' GCol="text,QTSHQT" GF="N 20,3">보류수량</td> <!-- Hold       QuanTity -->
										<td GH="100 STD_QTSALO" GCol="text,QTSALO" GF="N 20,3">할당수량</td>
										<td GH="100 STD_QTSPMO" GCol="text,QTSPMO" GF="N 20,3">이동OUT</td>
										<td GH="100 STD_QTSPMI" GCol="text,QTSPMI" GF="N 20,3">이동IN</td>
										<td GH="100 STD_TOTWG"  Gcol="text,TOTWG"  GF="N 20,3">총중량</td>
										<td GH="100 STD_BAGQT"  Gcol="text,BAGQT"  GF="N 20,3">EA/BAG</td>
										<td GH="100 STD_BOXQT"  Gcol="text,BOXQT"  GF="N 20,3">BAG/BOX</td>
										<td GH="100 STD_PLTQT"  Gcol="text,PLTQT"  GF="N 20,3">BOX/Pallet</td>
										<td GH="100 STD_SOKQT"  Gcol="text,SOKQT"  GF="N 20,3">속(개/BALE)</td>
										<td GH="100 STD_USETOTWG" Gcol="text,USETOTWG" GF="N 20,3">가용 총중량</td>
										<td GH="100 STD_USEBAGQT" Gcol="text,USEBAGQT" GF="N 20,3">가용 EA/BAG</td>
										<td GH="100 STD_USEBOXQT" Gcol="text,USEBOXQT" GF="N 20,3">가용 BAG/BOX</td>
										<td GH="100 STD_USEPLTQT" Gcol="text,USEPLTQT" GF="N 20,3">가용 BOX/Pallet</td>
										<td GH="100 STD_USESOKQT" Gcol="text,USESOKQT" GF="N 20,3">가용 속(개/BALE)</td>										<td GH="100 STD_EAQTY"  Gcol="text,EAQTY"  GF="N 20,3">매(sheet/속)</td>
										<td GH="100 STD_BOXEA"	Gcol="text,BOXEA"  GF="N 20,3">BOXEA</td>
										<td GH="100 STD_BOXBAG"	Gcol="text,BOXBAG" GF="N 20,3">BOXBAG</td>
										<td GH="100 STD_BOXPAL"	Gcol="text,BOXPAL" GF="N 20,3">BOXPAL</td>
										<td GH="100 STD_WAREKY" Gcol="text,WAREKY">거점</td>
										<td GH="100 STD_WARENM" Gcol="text,WARENM">거점명</td>
