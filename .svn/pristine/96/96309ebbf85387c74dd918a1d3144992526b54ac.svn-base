	var goFlag = "Y"; 
	function gridListEventRowCheck(gridId, rowNum, checkType){
		if(gridId == "gridList" && checkType == true && goFlag == "Y"){
			var stknum = gridList.getColData(gridId, rowNum, "STKNUM");
			
			goFlag = "N";
			
			var head = gridList.getGridData(gridId);
			for (var i = 0; i < head.length; i++) {
				if (stknum == gridList.getColData(gridId, i, "STKNUM") && stknum != " "){
					gridList.setRowCheck(gridId, i, true);
				}
			}
			goFlag = "Y";
		}
	}
	
	function UnStknum(){	//선적제한해제
		var head = gridList.getSelectData("gridList");
        
        if(head.length == 0){
            commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
            return;
        }

        if(!commonUtil.msgConfirm("OUT_M0259")){ //선적제한해제 하시겠습니까??
            return;
        }

        var headSelectList = gridList.getSelectRowNumList("gridList");
        for(var i=0;i<headSelectList.length;i++){
        	//jhj : 마스터 출하문서번호 기준을 -> 선적번호 기준으로 변경
        	var statdo = gridList.getColData("gridList", headSelectList[i], "STATDO");  //Head상태
            var stknum = gridList.getColData("gridList", headSelectList[i], "STKNUM");  //Head상태
            //Head 미작업 상태이면 밸리데이션 check
            if(statdo != "NEW"){
			    commonUtil.msgBox("OUT_M0260", stknum);   //선적번호 [{0}]는 미작업 상태가 아닙니다.
                gridList.setColFocus("gridList", headSelectList[i], "STATDO");
                return;
            }
        }

        var param = new DataMap(); 
        param.put("head", head);
        getRangeDataParam(param);
        
        var vjson = netUtil.sendData({
			url : "/wms/outbound/json/sendStknumInfoDL041.data",
			param : param
		});
		
		if(vjson && vjson.data){
			
			if(vjson.data["MSG"] && vjson.data["MSG"] != "SUCCESS"){
				commonUtil.msgBox(vjson.data["MSG"], null, null, function () { 
				}); 
				
			}else{
				//선적제한해제가 완료 되었습니다.
				commonUtil.msgBox("OUT_M0261", null, null, function () { 
					reSearchList();
				}); 
			}
		}
	}
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
	<div class="content_inner">
		<%@ include file="/common/include/webdek/title.jsp" %>
