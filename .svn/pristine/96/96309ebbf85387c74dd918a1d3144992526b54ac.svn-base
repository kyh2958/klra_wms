			        <input type="button" CB="Allocate ALLOCATE BTN_ALLOCATE" />
			        <input type="button" CB="Wcancle WCANCLE BTN_UNALLO" />
			        <input type="button" CB="printPlShpping PRINT BTN_PRINT27" />
