<script type="text/javascript">
	var dblIdx = 0;
	var subIdx = 0;
	var searchType = 0;
	var paramH = new DataMap();
	var menuky = configData.MENU_ID;
	
	$(document).ready(function(){
	    //setTopSize(300);
	    
	    gridList.setGrid({
	        id : "gridList",
	        module : "DL041",
	        editable : true,
	        command : "DL041_HEAD",
	        itemGrid : "gridListSub",
	        itemSearch : true
	    });
	    gridList.setGrid({
	        id : "gridListSub",
	        module : "DL041",
	        command : "DL041_SUB"
	    });
	    
	    var headList = page.getLinkPageData("DL041");
	    if(headList){
	        linkSetParam(headList);
	        searchList(headList);
	    }
	     
      <%if(plant.equals("")){%>
        $('select[name="SI.LOTA02"]').multipleSelect('checkAll');
      <%}else{%>
        $('select[name="SI.LOTA02"]').multipleSelect('setSelects', ['<%=plant%>']);
      <%}%>
	     	  
      /* 출고유형 전체선택 */
      var $selRCPTTY = $('select[id="RCPTTY"]');
      $selRCPTTY.multipleSelect('checkAll');
      
      gridList.setReadOnly("gridList", true, ["DYNAMIC"]);
      gridList.setReadOnly("gridListSub", true, ["CHGFLG", "STATUS_NEW", "STATUS_ALO", "STATUS_PCK", "STATUS_SHP", "APPOINTPICKING", "PRTCHK"/*, "SKUG05"*/]);
      
	});
	
	function linkSetParam(headList){
	    var param = inputList.setRangeParam("searchArea");
	    if(headList && headList.length>0){
	        var mangeMap = new DataMap();
	        var rangeList = new Array();
	
	        var rowMap;
	        for(var i=0; i<headList.length; i++){
	            rowMap = headList[i];
	            mangeMap = new DataMap();
	            mangeMap.put("OPER", "E");
	            mangeMap.put("DATA", rowMap.get("SHPOKY")); 
	            rangeList.push(mangeMap);
	        }
	        inputList.setRangeData("SH.SHPOKY", configData.INPUT_RANGE_TYPE_SINGLE, rangeList);
	    }
	}
	
	function linkPageOpenEvent(headList){
	    linkSetParam(headList);
	    searchList(headList);
	}
	
	
	function gridListEventRowDblclick(gridId, rowNum, colName, colValue){
	}

	function gridListEventRowClick(gridId, rowNum, colName){
	}
	
	function gridListEventItemGridSearch(gridId, rowNum){//), itemGridList){
	    if(gridId == "gridList"){
	        var param = getItemSearchParam(rowNum);
	        
	        gridList.gridList({
	            id : "gridListSub",
	            url : "/wms/outbound/json/detailDL041.data",        // RANGE_SQL 생성
	            param : param
	        });
	        dblIdx = rowNum;
	        subIdx = rowNum;
	    }
	}
	
	function getItemSearchParam(rowNum){
		var param = inputList.setRangeParam("searchArea");
		var rowData = gridList.getRowData("gridList",rowNum);
		
		if(param.map.RANGE_DATA_PARAM){    // datail 조회 시 searchArea 조회조건 선적번호(범위) 삭제 = (detail은 master 선적번호 기준으로 조회)
			rageDataMap = param.map.RANGE_DATA_PARAM;
			if(rageDataMap){
				if(rageDataMap.containsKey("SI.STKNUM_Single")){
					rageDataMap.remove("SI.STKNUM_Single");
				}
				if(rageDataMap.containsKey("CT.NAME01_Single")){
				}
			}
		}
		param.put("STKNUM", rowData.get("STKNUM"));	// Head row 선적번호
		return param;
	}
	
	function mkWhereSql(str, field){	//문자열 LIKE 검색으로 변경 예정
		//debugger;
		var result = "";
		if(str!=undefined && str!=""){
			var arr = str.split("↑");
			
			for(var i=0; i<arr.length; i++){
				var rStr = arr[i];
				var rArr = rStr.split("↓")
				
				if(rArr.length==3){
					var oper = rArr[0];
					var searVal = rArr[1];
					var logi = rArr[2];
					
					if(result!=""){
						
						if(logi=="OR"){
							result = result + " " + "OR";
						}else if(logi=="AND"){
							result = result + " " + "AND";
						}
					}
					result = result + " " + field; 
					
					if(oper=="E"){
						result = result + " " + "=";
					}else if(oper=="N"){
						result = result + " " + "!=";
					}else if(oper=="LT"){
						result = result + " " + "<";
					}else if(oper=="GT"){
						result = result + " " + ">";
					}else if(oper=="LE"){
						result = result + " " + "<=";
					}else if(oper=="GE"){
						result = result + " " + ">=";
					}
					
					result = result + " '" + searVal + "' ";
				}
			}
		}
		if(result!=""){
			result = "AND ( " + result + " ) ";
		}
		return result;
	}
	
	function gridListEventDataBindEnd(gridId, dataLength){
	    if(gridId == "gridList" && dataLength > 0){
	        headFocusNum = 0;
	        
	        if(searchType == 1){
	            getItemSearchParam(0);
	            gridList.checkAll('gridList',true);
	        }else if(searchType == 2){
	            searchSubItemList(0);
	        }
	    }else if(gridId == "gridListSub" && dataLength > 0){
	        for (var i = 0; i < dataLength; i++) {
	            var statit =  gridList.getColData(gridId,i,"STATIT");
	            if(statit == 'FPC' || statit == 'PCK'){	//피킹완료 || 부분상차
	                //gridList.setRowReadOnly(gridId, i, "rowCheck");
	            }
	        }
	    }
	}
	
	function searchSubItemList(rowNum){
	    gridList.resetGrid("gridListSub");

	    var param = getItemSearchParam();
	
	    gridList.gridList({
	        id : "gridListSub",
	        url : "/wms/outbound/json/detailDL041.data",        // RANGE_SQL 생성
	        param : param
	    });
	
	    headFocusNum = rowNum;
	    dblIdx = rowNum;
	    subIdx = rowNum;
	}
	
	function searchList(){

		if(validate.check("searchArea")){
	        var param = inputList.setRangeParam("searchArea");
	        searchType = 1;
	        param.put("PROGID", menuky);
	        
	        gridList.resetGrid("gridList");
	        gridList.resetGrid("gridListSub");

	        gridList.gridList({
	            id : "gridList",
	            url : "/wms/outbound/json/headRangeSqlDL041.data", //RANGE_SQL 생성
	            param : param
	        });
	        
	        gridList.setReadOnly("gridList", false);
	        gridList.setReadOnly("gridList", true, ["PRTCHK", "DYNAMIC"]);
	    }
	}
	
	function gridExcelDownloadEventBefore(gridId){
	    if(gridId == "gridList"){
	        var param = inputList.setRangeParam("searchArea");
	        param.put("PROGID", menuky);
	        return param;
	    }else if(gridId == "gridListSub"){
	        var rowNum = gridList.getSearchRowNum("gridList");
	        if(rowNum == -1){
	            return false;
	        }else{
	            var param = getItemSearchParam(rowNum);
	            return param;
	        }
	    }
	}
	
	function getRangeDataParam(param){
		// 조회 -> 마스터 선적번호 체크 -> 출하요청일자 변경 후 -> 할당 누르면...?
		var inputListParam = inputList.setRangeParam("searchArea");

		if(inputListParam.containsKey("SI.LOTA02")){
			param.put("LOTA02", "("+inputListParam.get("SI.LOTA02")+")");
			inputListParam.remove("SI.LOTA02");
		}
		param.putAll(inputListParam);
	    if(inputListParam.map.RANGE_DATA_PARAM){    // datail 조회 시 searchArea 조회조건 출하요청일자 범위 필요
            rageDataMap = inputListParam.map.RANGE_DATA_PARAM;
            if(rageDataMap){
                if(rageDataMap.containsKey("SH.RQSHPD_Range")){
                    param.put("RQSHPD_FR", rageDataMap.get("SH.RQSHPD_Range").substr(2,8));		//출하요청일자 FROM
                    param.put("RQSHPD_TO", rageDataMap.get("SH.RQSHPD_Range").substr(11,8));	//출하요청일자 TO
                }else if(rageDataMap.containsKey("SH.RQSHPD_Single")){
                	param.put("RQSHPD", rageDataMap.get("SH.RQSHPD_Single").substr(2,8));		//출하요청일자
                }
            }
	    }
	    param.remove("RANGE_DATA_PARAM");
	}
	
	//할당
	function allocate(){
	    if(gridList.validationCheck("gridList", "select") && gridList.validationCheck("gridListSub", "data")){
	        var head = gridList.getSelectData("gridList");
	        var sublist = gridList.getGridData("gridListSub");
	        var param = new DataMap();
	        if(head.length == 0){
	            commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
	            return;
	        }
	        
	        if(sublist.length == 0){
	            commonUtil.msgBox("OUT_M0045"); //처리를 위한 아이템이 존재하지 않습니다.
	            return;
	        }
	        
	        if(!commonUtil.msgConfirm("OUT_M0081")){ //할당 작업을 하시겠습니까?
	            return;
	        }
	        var headSelectList = gridList.getSelectRowNumList("gridList");
	        for(var i=0;i<headSelectList.length;i++){
	            var statdo = gridList.getColData("gridList", headSelectList[i], "STATDO");  //Head상태
	            
	            if(dblIdx == headSelectList[i]){
	                param.put("headModifyIndex", i);
	            }
	            //Head 할당완료 상태이면 밸리데이션 check
	            if(statdo == "FAL"){
	            	var list = gridList.getGridData("gridList");
	            	
	    			for(var j=0; j < list.length; j++) {
	    				
	    				var STATDO = list[j].get("STATDO");
	    				
	    				if(STATDO=="FAL" && gridList.getColData("gridList", j, "INDCHK") == "V"){
	    					    commonUtil.msgBox("OUT_M0204", j+1);   //[{0}]번째 행은 이미 할당완료 상태입니다.
	    		                gridList.setColFocus("gridList", j, "STATDO");
	    		                return;
	    				}
	    			}
	    			
	            }else if(statdo == "FSH" || statdo == "PSH"){ //Head 부분출고 또는 출고완료 상태이면 밸리데이션 
	            	commonUtil.msgBox("OUT_M0205");   //부분출고 또는 출고완료 상태이면 할당이 불가능합니다.
	                gridList.setColFocus("gridList", j, "STATDO");
	                return;
	            }
	        }
	        var headChkLen = gridList.getSelectRowNumList("gridList").length;
	        if(headChkLen > 0 && dblIdx == subIdx){
	        	//jhj : 마스터 출하문서번호 기준을 -> 선적번호 기준으로 변경
	        	var HeadGridSTKNUM = gridList.getColData("gridList", dblIdx, "STKNUM");	//선적번호
	        }
	        
	        param.put("head", head);	//head list
	        param.put("sublist", sublist);	//detail list
	        param.put("HeadGridSTKNUM", HeadGridSTKNUM);
	        getRangeDataParam(param);

	        var json = netUtil.send({
	            url : "/wms/outbound/json/assignDL041.data",
	            param : param,
	            successFunction : "allocateSuccess"
	        });
	    }
	}
	
	function allocateSuccess(json){
	    if(json && json.data){
	    	
	    	if(!json.data.CNT && json.data.SHPOKY){
	    		commonUtil.msgBox("OUT_M0195", json.data.SHPOKY); 
	    	}else{
	    		
	    		var resultCnt = new Number(json.data.RESULT);
	   			//debugger;
	    		if(resultCnt > 0){
		    		//commonUtil.msgBox("OUT_M0150"); // 할당 완료되었습니다.
		    		commonUtil.msgBox("OUT_M0228",resultCnt); // 할당이 [{0}]건 처리되었습니다.
			        paramH =  inputList.setRangeParam("searchArea");
			        paramH.put("SHPOKY", json.data["SHPOKY"]);
			        
			        gridList.resetGrid("gridList");
			        gridList.resetGrid("gridListSub");
			        
			        searchType = 2;
			        reSearchList();
	    		}else{
	    			commonUtil.msgBox("OUT_M0229"); //할당처리가 되지 않았습니다.
	    		}
	    	}
	    }
	}
	
	//할당취소
 	function unallocate(unalType){
	    var head = gridList.getSelectData("gridList");
	    var sublist;
	    if(unalType == "PCN"){ //부분할당취소
	    	sublist = gridList.getSelectData("gridListSub");
	    }else{ //할당취소
	    	sublist = gridList.getGridData("gridListSub");
	    }
		
	    if(head.length == 0){
	        commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 업습니다.
	    }
	
	    if(sublist.length == 0){
	        commonUtil.msgBox("OUT_M0045");  //처리를 위한 아이템이 존재하지 않습니다.
	        return;
	    }
		
	    if(unalType != "PCN"){	//할당취소(전체)
		   //할당완료된 데이터만 할당취소 가능(HEAD기준)
		    var SelectList = gridList.getSelectRowNumList("gridList");
		    for(var i=0; i< SelectList.length; i++){
		        var statdo = gridList.getColData("gridList", SelectList[i], "STATDO"); //HEAD상태
		        
		        if(statdo != "FAL" && statdo != "PAL"){
		            commonUtil.msgBox("OUT_M0184"); //출고문서 상태가 할당완료or부분할당일 경우에만 취소 가능합니다.
		            return;
		        }
		    } 
	    }else{	//부분할당취소
			    //할당완료된 데이터만 할당취소 가능(item기준)
			    var itemSelectList = gridList.getSelectRowNumList("gridListSub");
			    for(var i=0; i<sublist.length; i++){
			        var statit = gridList.getColData("gridListSub", itemSelectList[i], "STATIT"); //item상태
			        var statnm = gridList.getColData("gridListSub", itemSelectList[i], "STATNM"); //item상태명
			        var shpoky = gridList.getColData("gridListSub", itemSelectList[i], "SHPOKY"); //출하문서번호	//jhj : 선적번호 기준으로 변경 후 부분할당취소
			        var shpoit = gridList.getColData("gridListSub", itemSelectList[i], "SHPOIT"); //아이템번호		//jhj : 선적번호 기준으로 변경 후 부분할당취소
			        var qttaor = gridList.getColData("gridListSub", itemSelectList[i], "QTTAOR"); //출하문서순번
			        
			        if((statit == "NEW" && qttaor < 0) || statit == "PPC" || statit == "PCK"){
			            commonUtil.msgBox("VALID_M0024",[shpoky,shpoit,statnm]); //[출하문서번호:{0}, 출하문서순번: {1}]는 {2}상태로 할당취소 대상이 아닙니다.
			            return;
			        }
			    } 
	    }
	    
	    if(!commonUtil.msgConfirm("OUT_M0153")){ //할당 취소하시겠습니까?
	        return;
	    }

	    var headChkLen = gridList.getSelectRowNumList("gridList").length;
	    if(headChkLen > 0 && dblIdx == subIdx){
	        var HeadGridSTKNUM = gridList.getColData("gridList", dblIdx, "STKNUM");
	    }
	    
	    var param = new DataMap();
		    param.put("head", head);
		    param.put("sublist", sublist);
		    param.put("HeadGridSTKNUM", HeadGridSTKNUM);
		    param.put("unalType", unalType);
		    
	    getRangeDataParam(param);
	    
	    var json = netUtil.sendData({
	        url : "/wms/outbound/json/unallocateDL041.data",
	        async : true,       // 응답없는 메시지 제거를위해 비동기 처리
            loading : true,     // 전체완료될때까지 로딩 유지
            recall : false,     // 로딩이미지 적용을위해 재귀호출시 필요
	        param : param,
	        callBackFunction : function(returnData){
	        	netUtil.processMessageOff();
	        	if(returnData.data.ERRMSG != "OK"){
	        		commonUtil.msgBox("OUT_M0184"); //출고문서 상태가 할당완료or부분할당일 경우에만 취소 가능합니다.
	        	}
	        	if(returnData.data.MSG && returnData.data.MSG != "SUCCESS"){
		            commonUtil.msgBox(returnData.data.MSG);	            
		        }else{	        
		        	commonUtil.msgBox("OUT_M0154"); //할당 취소되었습니다.
		        }
		        gridList.resetGrid("gridList");
		        gridList.resetGrid("gridListSub");
		        
		        dblIdx = 0;
		        searchType = 2;
		
		        paramH =  inputList.setRangeParam("searchArea");
		        paramH.put("SHPOKY", returnData.data.SHPOKY);
		        reSearchList();
            }
	    });
	}
	
	//할당전략키 validation
	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
	    if(gridId == "gridListSub" && colName == "ALSTKY"){
	    	
	        if(colValue != ""){
	            var param = new DataMap();
	            
	            param.put("ALSTKY", colValue);
	            param.put("WAREKY", "<%=wareky%>");
	            
	            var json = netUtil.sendData({
	                module : "DL041",
	                command : "DL041_ALSTKYval",
	                sendType : "map",
	                param : param
	            });
	            
	            if (json.data["CNT"] < 1) {
	                commonUtil.msgBox("VALID_M0211", colValue);
	                
	                gridList.setColValue("gridListSub", rowNum, "ALSTKY", "");
	                gridList.setColFocus(gridId, rowNum, colName);
	            }
	        } 
	    }
	}
	
	function inputListEventRangeDataChange(rangeName, singleData, rangeData){
	    if(rangeName == "SH.SHPOKY" || rangeName == "SI.SVBELN" || rangeName == "SI.SEBELN" || rangeName == "SI.SKUKEY"){
	        var dataCount = inputList.getDataCount("SH.SHPOKY")
	                      + inputList.getDataCount("SI.SVBELN")
	                      + inputList.getDataCount("SI.SEBELN")
	                      + inputList.getDataCount("SI.SKUKEY");
	        if(dataCount == 0){
	            var now = new Date();
	            now.setDate(now.getDate());
	            var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
	            $("#searchArea").find("[name=RQSHPD]").val(tmpValue);
	            inputList.addValidation("RQSHPD", "required");
	        }else{
	            $("#searchArea").find("[name=RQSHPD]").val("");
	            inputList.removeValidation("RQSHPD", "required");
	        }
	    }
	}
	
	function linkPopCloseEvent(){
	    //searchList();
	    searchType = 3;
	    headFocusNum = gridList.getFocusRowNum("gridList"); 
	    
	    searchSubItemList(headFocusNum);
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType, $inputObj){
	    var param = new DataMap();
	    if(searchCode == "SHCMCDV"){
	        param.put("CMCDKY", "STATDO");
	        return param;
	    }else if(searchCode == "SHSTLMAP"){
	    	
	    	var PLNTKY = $('select[name="SI.LOTA02"]').val();
			
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("PLNTKY", PLNTKY);
	    	
	    	return param;
	    }else if(searchCode == "SHBZPTN"){
			param.put("PTNRTY", "CT");
			param.put("OWNRKY", "<%=ownrky%>");			
			return param;
		}
	    
	}
	/* 버튼 기능 분기처리 */
	function commonBtnClick(btnName){
		
	    if(btnName == "Search"){					//조회
	        searchList();
	    }else if(btnName == "SubSave"){				//할당전략키 저장
			subsaveData();
		}else if(btnName == "Allocate"){			//할당
	        allocate();
	    }else if(btnName == "Wcancle"){				//할당취소
	        unallocate("FCN");
	    }else if(btnName == "SubWcancle"){			//부분할당취소
	    	unallocate("PCN");
	    }else if(btnName == "printPlShpping"){		//할당피킹지시서
	    	printPlShpping();
		}else if(btnName == "printAlShpping"){		//미할당출고지시서
	    	printAlShpping();
	    }else if(btnName == "printShpping"){		//출고지시서
	    	printShpping();
	    }else if(btnName == "printUnShpping"){		//미작업출고지시서
	    	printUnShpping();
	    }else if(btnName == "ReflectAlstky"){		//할당전략키 반영
			setAlstky();
        }else if(btnName == "PePrint"){				//거래명세서
            PePrintList();
		}else if(btnName == "RcvSap") {				//SAP변경수신
			callSapFunc();
		}else if(btnName == "UnStknum"){			//선적제한해제
			UnStknum();
		}else if(btnName == "RcvStk"){
			callStkFunc();
		}
	}
	
	function LocPopCallback(data) {
		
		var STKNUM = data.get("STKNUM");
		var type = data.get("SSHTYP");
		
		var sCnt = 0;
		var fCnt = 0;
		var fArr = new Array();
		var ifid = "";
		
		if(type == "221"){ //이송출고
 			ifid = "WMS_IFS302";
		}else{ // 판매출고
			ifid = "WMS_IFS301";
		}
		
		var param = new DataMap();
			param.put("IFID", ifid );
			param.put("IFTBL", "IFWMS113");
			param.put("BWART", "");
			param.put("RFCFN", "Z_WMS_DELIVERY_TYPE_INFO_2");
			param.put("RFCTBL", "T_DELINFO");
			param.put("RFCP1", "");
			param.put("RFCP2", "");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("WERKS", ""); // SAP재고 수신 : 플랜트 셋팅
			param.put("GUBUN", "T");	
			param.put("TKNUM", STKNUM);	

		var json = netUtil.sendData({
			url : "/rfc/json/rfcCall.data",
			param : param,
		});	
			
		if (json.row_count > 0) { 
			sCnt++;
		} else {
			fArr.push(STKNUM);
			fCnt++;
		}
		
        if (sCnt + fCnt > 0) { 	
        	commonUtil.msgBox("수신 ["+sCnt+"]건, 미수신 ["+fCnt+"]건" + (fCnt > 0 ? " ("+fArr.toString()+")": "" ));
        } else {
        	commonUtil.msgBox("ITF_M0036");
        }
	}
	
	function callStkFunc() {
		page.linkPopOpen("/wms/outbound/DL041STKPOP.page",'', "height=200,width=500,resizable=yes");
	}
	
	function callSapFunc() {

		var head = gridList.getSelectData("gridList");
		var headLength = head.length;
		
	 	if( headLength <= 0 ){
        	commonUtil.msgBox("VALID_M0006"); // 선택된 아이템이 없습니다.
            return;
        } else {
			//출고완료 건 return 처리
			var param = new DataMap();
			getRangeDataParam(param);
			var sendDataSAP = new DataMap();
			
			for ( var i = 0 ; i < headLength ; i++) {
				param.put("STKNUM", head[i].get("STKNUM"));		//선적번호
				
				var json = netUtil.sendData({
					module : "DL041",
					command : "DL041_WMS_IFS301_STATDO",
					sendType : "list",
					param : param
				});

				if (json && json.data) { // 할당하고 NEW
					for ( var j = 0 ; j < json.data.length ; j++) {
						var stknum = json.data[j]["STKNUM"];
						var statdo = json.data[j]["STATDO"];
						var shpoky = json.data[j]["SHPOKY"];
						var docuty = json.data[j]["DOCUTY"];
						var svbeln = json.data[j]["SVBELN"];
						
						var dataSAP = new DataMap();
							dataSAP.put("STKNUM", stknum);
							dataSAP.put("STATDO", statdo);
							dataSAP.put("SHPOKY", shpoky);
							dataSAP.put("DOCUTY", docuty);
							dataSAP.put("SVBELN", svbeln);
						
						sendDataSAP.put(sendDataSAP.size(), json.data[j]);
						
						//미작업이나 할당완료가 아니면 RETURN
						if ( statdo != "NEW" ) {
							alert("출하문서번호 [" + shpoky + "]는 출고진행중입니다. \n미작업 상태에서 변경 수신이 가능합니다.");
							sendDataSAP.clear();
							return;
						}
					}
				}
		 	}

    		// 데이터 수신요청
   			// LOOP START
			var sCnt = 0;
			var fCnt = 0;
			var fArr = new Array();
			var ifid = "";
			
   	        for ( var i = 0 ; i < sendDataSAP.size() ; i++) {
       			var param = new DataMap();///이송은 221(302)판매출고 201()
   				var sendGetData = sendDataSAP.get(i);

       			if(sendGetData.DOCUTY == "221" ) {
       				ifid = "WMS_IFS302";
       			} else if (sendGetData.DOCUTY == "201") {
       				ifid = "WMS_IFS301";
       			} else {
       				ifid = " ";
       				break;
       			}
       				
       			param.put("IFID", ifid );
       			param.put("IFTBL", "IFWMS113");
       			param.put("BWART", "");
       			param.put("RFCFN", "Z_WMS_DELIVERY_TYPE_INFO_2");
       			param.put("RFCTBL", "T_DELINFO");
       			param.put("RFCP1", "");
       			param.put("RFCP2", "");
       			param.put("OWNRKY", "<%=ownrky%>");
       			param.put("WERKS", ""); // SAP재고 수신 : 플랜트 셋팅
   	    		param.put("VBELN", sendGetData.SVBELN); // 출고예정정보 실시간 수신 : 납품문서 셋팅
       			param.put("GUBUN", "S");	
	   			
	    		var json = netUtil.sendData({
	    			url : "/rfc/json/rfcCall.data",
	    			param : param,
	    		});	
       			
				if (json.row_count > 0) { 
					sCnt++;
				} else {
// 					fArr.push(sendDataSAPmap.get("SHPOKY"));
					fArr.push(sendDataSAPmap.get("STKNUM"));
					fCnt++;
				}
	        } //LOOP END 
	        
   	        if (sCnt + fCnt > 0) { 	
   	        	commonUtil.msgBox("선적번호 : 수신 ["+sCnt+"]건, 미수신 ["+fCnt+"]건" + (fCnt > 0 ? " ("+fArr.toString()+")": "" ));
   	        } else {
   	        	commonUtil.msgBox("ITF_M0036");
   	        }
		}
	}

