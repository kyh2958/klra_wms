	//부분합계
	function subTotalConfirmORG(){
//		alert("부분합계");
		var gridId = "gridList"
		var subGridId = "gridListSub";
		var headSelectRowNum = gridList.getSearchRowNum(gridId);

		if(validate.check("searchArea")){
			if(gridList.getGridDataCount(subGridId) > 0) {

				var subItemDataList = gridList.getGridData(subGridId);	//DataMap 형식

				/*	리턴 값 < 0, a가 b보다 앞
					리턴 값 > 0, b가 a보다 앞
					리턴 값 = 0, 순서변경 X		*/
				subItemDataList.sort(function(previous, next) {	//품목코드 기준으로 재정렬
					var upperPrevious = previous.get("SKUKEY").toUpperCase();
					const upperNext = next.get("SKUKEY").toUpperCase();
					if(upperPrevious > upperNext) return 1;
					if(upperPrevious < upperNext) return -1;
					if(upperPrevious === upperNext) return 0;
				});
				//debugger;
				gridList.resetGrid(subGridId);			//정렬 된 데이터로 재 바인딩 하기 위함
				for(var i=0; i<subItemDataList.length; i++){

					gridList.setRowState(subGridId, configData.GRID_ROW_STATE_READ, i);	//그리드 상태 Read로 초기화
					gridList.setRowState(subGridId, configData.GRID_ROW_STATE_READ, i+1);	//그리드 상태 Read로 초기화
					gridList.setReadOnly(subGridId, true, ["CHGFLG", "STATUS_NEW", "STATUS_ALO", "STATUS_PCK", "STATUS_SHP", "APPOINTPICKING", "PRTCHK"]);
					gridList.reloadAll(subGridId);	//그리드 초기화 상태 적용 위함
					gridList.setRowFocus(subGridId, 0);

					var qtshpo = gridList.getColData(subGridId, i, "QTSHPO"); //출고오더수량

				}//END OF for(var i=0; i<subItemDataList.length; i++){
			}// END OF if(gridList.getGridDataCount(subGridId) > 0)
			return;
		}// END OF if(validate.check("searchArea")){
		return;
	}
	
