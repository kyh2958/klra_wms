			        <input type="button" CB="RcvSap PRINT BTN_RCVSAP"/><!-- SAP FUNC 호출 -->
<!--   			        <input type="button"  CB="RcvStk PRINT BTN_RCVSTK" />SAP 선적수신 호출 -->
			        <input type="button" CB="UnStknum UNSTKNUM BTN_UNSTKNUM" /> <!-- 선적제한해제 -->
				</div>
			</div>
			
			<div class="search_inner">
