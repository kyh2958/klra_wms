<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!doctype html>
<head>
<style type="text/css">
/* ✅ MV02_POP 기본 레이아웃 유지 + 키오스크용 최소 조절만 */
button { float: right; }
input:read-only { background-color: #e2e2e2; }
select:DISABLED { background-color: #e2e2e2; }

/* 팝업에서 너무 길게 안 보이게 그리드 높이만 제한 */
.tableWrap_search .tableBody{
  max-height: 220px;
  overflow-y: auto;
}

/* 팝업 상단 여백/폭 정리 */
.tem4_content{
  max-width: 520px;
  margin: 0 auto;
}
</style>

<meta charset="utf-8">
<meta name="viewport" content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width, target-densitydpi=medium-dpi" />
<meta name="format-detection" content="telephone=no" />
<title>Mobile WMS</title>

<%@ include file="/mobile/include/head.jsp" %>
<script type="text/javascript" src="/wms/js/wms.js"></script>

<script>
  $(document).ready(function(){

    gridList.setGrid({
      id : "gridList",
      editable : false,
      module : "WmsMobileOutboundPicking_COPY",
      command : "KIOSK_CARNO",      // Mapper: KIOSK_CARNO_LIST
      gridMobileType : true
    });

    // ✅ linkPopOpen으로 넘어온 값 세팅
    var popParam = getPopParamDataMap();
	  if (popParam) {
	  if (popParam.get("VEHINO")) $("#VEHINO").val(popParam.get("VEHINO"));
	  if (popParam.get("SCHMODE")) $("#SCHMODE").val(popParam.get("SCHMODE"));
}

    searchList();
    $("#VEHINO").focus();

    // ✅ (선택) 팝업 창 사이즈 조절 시도 - 막히면 무시됨
    try { window.resizeTo(520, 420); } catch(e) {}
  });

  var selectedRowNum = 0;

  function initGrid() {
    gridList.resetGrid("gridList");
  }

  
  function getQueryParam(name) {
	  name = name.replace(/[\\[\\]]/g, "\\$&");
	  var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)");
	  var results = regex.exec(window.location.href);
	  if (!results || !results[2]) return null;
	  return decodeURIComponent(results[2].replace(/\+/g, " "));
	}

	function getPopParamDataMap() {
	  // 1) URL ?POP_PARAM=... 우선
	  var qp = getQueryParam("POP_PARAM");
	  if (qp) {
	    try {
	      var obj = JSON.parse(qp);
	      var dm = new DataMap();
	      dm.putObject(obj);
	      return dm;
	    } catch (e) {
	      // JSON이 아니거나 깨졌으면 무시
	    }
	  }
	  // 2) 기존 linkPopOpen 방식
	  try {
	    return mobile.getLinkPopData();
	  } catch (e2) {
	    return null;
	  }
	}

  
  function searchList(){
    initGrid();

    var param = inputList.setRangeParam("searchArea");
    param.put("WAREKY", "<%=wareky%>");
    param.put("OWNRKY", "<%=ownrky%>");
    param.put("LANGKY", "<%=langky%>");

    gridList.gridList({
      id : "gridList",
      param : param
    });
  }

  function gridListEventDataBindEnd(gridId, dataLength){
    if(gridId == "gridList"){
      $("#VEHINO").focus();
    }
  }

  function gridListEventRowDblclick(gridId, rowNum) {
    var data = gridList.getRowData("gridList", rowNum);
    callback(data);
  }

  function gridListEventRowClick(gridId, rowNum) {
    selectedRowNum = rowNum;
  }

  function onClickChooseBtn() {
    var data = gridList.getRowData("gridList", selectedRowNum);
    callback(data);
  }

  function callback (data) {
    if(!data.isEmpty()) {
      data.put('param', mobile.getLinkPopData());
      window.opener.vehinoPopCallback(data);
      self.close();
    }
  }

  function fn_onfocus(objId){
    $("#"+objId).select();
  }
</script>
</head>

<body>
  <div class="main_wrap">
    <div class="tem4_content">

      <div class="select_box" id="searchArea">
        <table>
          <colgroup>
            <col width="20%" />
            <col width="60%" />
            <col width="20%" />
          </colgroup>
          <tbody id="searchArea">
            <tr>
              <th>차량번호</th>
              <td>
                <input type="text" class="text" name="VEHINO" id="VEHINO"
                       onfocus="fn_onfocus(this.id)"
                       onkeypress="commonUtil.enterKeyCheck(event, 'searchList()')"
                       style="text-align:center; width:95%;" />
              </td>
              <td onclick="searchList()">
                <button class="bt" style="height: 32px;">
                  <p>조회</p>
                </button>
              </td>
            </tr>

            <!-- ✅ 메인에서 1111(4자리) 입력 시 LAST4로 넘어옴 -->
            <input type="hidden" name="SCHMODE" id="SCHMODE" />
          </tbody>
        </table>
      </div>

      <div class="tableWrap_search section" style="margin-bottom: 0px;">
        <div class="tableHeader">
          <table style="width: inherit">
            <colgroup>
              <col width="15%" />
              <col width="85%" />
            </colgroup>
            <thead>
              <tr class="thead">
                <th>No.</th>
                <th>차량번호</th>
              </tr>
            </thead>
          </table>
        </div>

        <div class="tableBody">
          <table style="width: inherit">
            <colgroup>
              <col width="15%" />
              <col width="85%" />
            </colgroup>
            <tbody id="gridList">
              <tr CGRow="true">
                <td GCol="rownum">No.</td>
                <td GCol="text,VEHINO">차량번호</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="footer_5" style="position:fixed;">
        <table>
          <tr>
            <td class=f_1 width="50%" onclick="self.close()">
              <label>닫기</label>
            </td>
            <td class=f_1 width="50%" onclick ="onClickChooseBtn()">
              <label>선택</label>
            </td>
          </tr>
        </table>
      </div>

    </div>
  </div>
</body>
</html>
