<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@page import="project.common.airfw.User"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Grid default</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<%@ include file="/common/include/webdek/layout.jsp" %>
<%
	User user = (User)request.getSession().getAttribute(CommonConfig.SES_USER_OBJECT_KEY);
	String str = "";
%>
<script type="text/javascript">
	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",
			editable : true,
			pkcol : "STOKKY",
			module : "WmsInventory",
			command : "SD02",
			dataRequest : true
		});
		
		gridList.setReadOnly("gridList", true, ['LOTA06']);
		
		initSearchArea();
		initTime();
	});
	
	function initSearchArea() {
		<%if(plant.equals("")){%>
			$('select[name="WH.LOTA02"]').multipleSelect('checkAll');
		<%}else{%>
			$('select[name="WH.LOTA02"]').multipleSelect('setSelects', ['<%=plant%>']);
		<%}%>
		$('select[name="SM.SKUL01"]').val("");
	}
	
	function initTime() {
		$("#frTime").val('00:00');
		$("#toTime").val('23:59');
	}
	
	function searchList(){
		if(validate.check("searchArea")){
			var param = inputList.setRangeParam("searchArea");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
			var frCretim = $("#frTime").val().replace(":", "") + "00";
			var toCretim = $("#toTime").val().replace(":", "") + "59";
			param.put("FRCRETIM", frCretim);
			param.put("TOCRETIM", toCretim);
 			inputList.copyRangeParam(param, "AREAKY", "SLGORT");
 			
 			// *_BACKUP 테이블 조회를 위한 조건 설정
			var rageDataMap = new DataMap();
			if(param.map.RANGE_DATA_PARAM){
				rageDataMap = param.map.RANGE_DATA_PARAM;
				if(rageDataMap){
					if(rageDataMap.containsKey("WH.LOTA14_Single")){
						param.put("USEBACKUP", true);
					}
				}
			}
			
			if("<%=userid%>" == 'kyh' || "<%=userid%>" == 'lyh6507' || "<%=userid%>" == 'slee') {
				param.put("USEBACKUP", true);
			}

			gridList.gridList({
				id : "gridList",
				param : param
			});
		}
		gridList.setReadOnly("gridList", true, ['LOTA06']);
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType){
		if(searchCode == "SHSKUMA"){ // 품목코드
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			return param;
		}else if(searchCode == "SHZONMA"){ // 구역
			return dataBind.paramData("searchArea");
		}else if(searchCode == "SHSTLMAP"){ // 저장위치
			var param = new DataMap();
			var PLNTKY = $('select[name="WH.LOTA02"]').val();
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("PLNTKY", PLNTKY);
			return param;
		}else if(searchCode == "SHCMCDV"){ // 재고상태
			var param = new DataMap();
			param.put("CMCDKY", "LOTA06");
			return param;
		}else if(searchCode == "SHLOCMA_PT"){ // 로케이션
			var param = dataBind.paramData("searchArea");
			var plntkyArr = $('select[name="WH.LOTA02"]').val();
			plntkyArr = plntkyArr ? plntkyArr : [];
			plntkyArr.push(' ');
			
			param.put("PLNTKY", plntkyArr);
			return param;
		}
	}
	
	function commonBtnClick(btnName){
		if(btnName == "Search"){
			searchList();
		}
	}
	
	function comboEventDataBindeBefore(comboAtt){
		var param = new DataMap();
		if(comboAtt == "Wms,PLNTKYCOMBO"){
			param.put("WAREKYS", "'<%=wareky%>'");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
		} else if(comboAtt == "airfw,COMCOMBO"){
			param.put("CODE", "TRNHTY");
		}
		return param;
	}
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
	<div class="content_inner">
		<%@ include file="/common/include/webdek/title.jsp" %>
		<div class="content_serch" id="searchArea">
			<div class="btn_wrap">
				<div class="fl_l"></div>
				<div class="fl_r">
					<input type="button" CB="Search SEARCH BTN_SEARCH" />
				</div>
			</div>
			<div class="search_inner">
				<div class="search_wrap ">
					<dl>
						<dt CL="STD_LOTA02">플랜트</dt>
						<dd>
							<select name="WH.LOTA02" class="input" Combo="Wms,PLNTKYCOMBO" ComboType="MS" validate="required">
							</select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA01">저장위치</dt>
						<dd>
							<input type="text" class="input" name="WH.LOTA01" UIInput="R,SHSTLMAP" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOCAKY">지번</dt>
						<dd>
							<input type="text" class="input" name="WH.LOCAKY" UIInput="R,SHLOCMA_PT" UIFormat="U"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_CREDAT">생성일자</dt>
						<dd>
							<input type="text" class="input" name="WH.CREDAT" UIInput="R" UIFormat="C 0 N" validate="required"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SKUKEY">품목코드</dt>
						<dd>
							<input type="text" class="input" name="WH.SKUKEY" UIInput="SR" UIFormat="U"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_DESC01">품목명</dt>
						<dd>
							<input type="text" class="input" name="DESC01"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA14">개별바코드</dt>
						<dd>
							<input type="text" class="input" name="WH.LOTA14" UIInput="SR" UIFormat="U"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_DOCDAT">전기일자</dt>
						<dd>
							<input type="text" class="input" name="WH.REFDAT" UIInput="R" UIFormat="C"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA06">재고상태</dt>
						<dd>
							<select name="WH.LOTA06" class="input" CommonCombo="LOTA06" ComboType="MS"></select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA11">제조일자</dt>
						<dd>
							<input type="text" class="input" name="WH.LOTA11" UIInput="R" UIFormat="C" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_AREAKY">영역</dt>
						<dd>
							<input type="text" class="input" name="WH.AREAKY" UIInput="R,SHAREMA" UIFormat="U"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_ZONEKY">구역</dt>
						<dd>
							<input type="text" class="input" name="WH.ZONEKY" UIInput="R,SHZONMA" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_CRETIM">생성시간</dt>
						<dd>
							<input type="text" class="input" id="frTime" UIFormat="THM" style="width: 80px;"/>
							<span>~</span>
							<input type="text" class="input" id="toTime" UIFormat="THM" style="width: 80px;"/>
							<br>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_CREUSR">생성자ID</dt>
						<dd>
							<input type="text" class="input" name="WH.CREUSR" UIInput="R" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_CREUSRNM">생성자명</dt>
						<dd>
							<input type="text" class="input" name="CUM.NMLAST" UIInput="R" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_RECVKY">입고문서번호</dt>
						<dd>
							<input type="text" class="input" name="WH.RECVKY" UIInput="R" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SHPOKY">출고문서번호</dt>
						<dd>
							<input type="text" class="input" name="WH.SHPOKY" UIInput="R" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_TASKKY">작업문서번호</dt>
						<dd>
							<input type="text" class="input" name="WH.TASKKY" UIInput="R" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SADJKY">재고조정문서번호</dt>
						<dd>
							<input type="text" class="input" name="WH.SADJKY" UIInput="R" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_SKUG01">품목유형</dt>
						<dd>
							<select class="input" name="SM.SKUG01" ComboType="MS" Combo="WmsInventory,SKUG01COMBO"></select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SKUL01">품목구분</dt>
						<dd>
							<select class="input" name="SKUL01" Combo="WmsInventory,SKUL01COMBO">
								<option></option>
							</select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA15">LOT 번호</dt>
						<dd>
							<input type="text" class="input" name="WH.LOTA15" UIInput="SR" IAname="Search" UIFormat="U"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_TRNHTY">물동타입</dt>
						<dd>
							<select class="input" name="TRNHTY" Combo="airfw,COMCOMBO"><option value=""/></select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA12">입고일자</dt>
						<dd>
							<input type="text" class="input" name="WH.LOTA12" UIInput="R" UIFormat="C" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA13">유통기한</dt>
						<dd>
							<input type="text" class="input" name="WH.LOTA13" UIInput="R" UIFormat="C" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_WAREKY">거점</dt>
						<dd>
							<input type="text" class="input" name="WAREKY" value="<%=wareky%>" readonly="readonly" validate="required" />
						</dd>
					</dl>
					
				</div>
				<div class="btn_tab">
					<input type="button" class="btn_more" value="more" onclick="searchMore()"/>
				</div>
			</div>
		</div>
		<div class="search_next_wrap">
			<div class="content_layout tabs top_layout">
				<ul class="tab tab_style02">
					<li><a href="#tab1-1"><span CL="STD_LIST">리스트</span></a></li>
					<li class="btn_zoom_wrap">
						<ul>
							<li><button class="btn btn_bigger"><span>확대</span></button></li>
						</ul>
					</li>
				</ul>
				<div class="table_box section" id="tab1-1">
					<div class="table_list01">
						<div class="scroll">
							<table class="table_c">
								<tbody id="gridList">
									<tr CGRow="true">
										<td GH='40 STD_NUMBER'		GCol="rownum">1</td>
										<td GH="100 STD_TRNHKY"		GCol="text,TRNHKY"				>재고트랜잭션	</td>
										<td GH="100 STD_ITEMNO"		GCol="text,ITEMNO"				>LineNo.	</td>
										<td GH="100 STD_TRNHTY"		GCol="text,TRNHTY"				>물동타입		</td>
										<td GH="100 STD_TRNHTYNM"	GCol="text,TRNHTYNM"			>물동타입명	</td>
										<td GH="100 STD_REFDAT"		GCol="text,REFDAT" GF="D"		>전기일자		</td>
										<td GH="100 STD_STOKKY"		GCol="text,STOKKY"				>재고키		</td>
										<td GH="100 STD_AREAKY"		GCol="text,AREAKY"				>영역			</td>
										<td GH="100 STD_ZONEKY"		GCol="text,ZONEKY"				>구역			</td>
										<td GH="100 STD_LOCAKY"		GCol="text,LOCAKY"				>로케이션		</td>
										<td GH="100 STD_SKUL01"		GCol="text,SKUL01NM"			>품목구분		</td>
										<td GH="100 STD_SKUKEY"		GCol="text,SKUKEY"				>품목코드		</td>
										<td GH="100 STD_DESC01"		GCol="text,DESC01"				>품명			</td>
										<td GH="100 STD_LOTA06"		GCol="text,LOTA06NM"			>재고상태		</td>
										<td GH="100 STD_QTPROC"		GCol="text,QTPROC" GF="N 30,3"	>처리수량		</td>
										<td GH="100 STD_UOMKEY"		GCol="text,UOMKEY"				>단위			</td>
										<td GH="100 STD_TOTWG" 		Gcol="text,TOTWG"  GF="N 20,3"	>총중량		</td>
										<td GH="100 STD_BAGQT" 		Gcol="text,BAGQT"  GF="N 20,3"	>EA/BAG		</td>
										<td GH="100 STD_BOXQT" 		Gcol="text,BOXQT"  GF="N 20,3"	>BAG/BOX	</td>
										<td GH="100 STD_PLTQT" 		Gcol="text,PLTQT"  GF="N 20,3"	>BOX/Pallet	</td>
										<td GH="100 STD_SOKQT" 		Gcol="text,SOKQT"  GF="N 20,3"	>속(개/BALE)	</td>
										<td GH="100 STD_EAQTY" 		Gcol="text,EAQTY"  GF="N 20,3"	>매(sheet/속)	</td>
										<td GH="100 STD_RBALE"		Gcol="text,RBALE"  GF="N 20,3"	>R_BALE		</td>
										<td GH="100 STD_BALE"		Gcol="text,BALE"   GF="N 20,3"	>BALE		</td>
										<td GH="100 STD_BOXEA"		Gcol="text,BOXEA"  GF="N 20,3"	>BOXEA		</td>
										<td GH="100 STD_BOXBAG"		Gcol="text,BOXBAG" GF="N 20,3"	>BOXBAG		</td>
										<td GH="100 STD_BOXPAL"		Gcol="text,BOXPAL" GF="N 20,3"	>BOXPAL		</td>
										<td GH="100 STD_LOTA02"		GCol="text,LOTA02"				>플랜트		</td>
										<td GH="100 STD_LOTA01"		GCol="text,LOTA01"				>저장위치		</td>
										<td GH="100 STD_LOTA04"		GCol="text,LOTA04"				>호기			</td>
										<td GH="100 STD_LOTA08"		GCol="text,LOTA08"				>국가코드		</td>
										<td GH="100 STD_LOTA07"		Gcol="text,LOTA07"				>주문번호		</td>
										<td GH="100 STD_LOTA09"		GCol="text,LOTA09"				>거래처코드MTO	</td>
										<td GH="100 STD_LOTA09NM"	GCol="text,LOTA09NM"			>거래처명MTO	</td>
										<td GH="100 STD_LOTA10"		Gcol="text,LOTA10"				>보류사유명	</td>
										<td GH="100 STD_LOTA11"		GCol="text,LOTA11" GF="D"		>제조일자		</td>
										<td GH="100 STD_LOTA12"		GCol="text,LOTA12" GF="D"		>입고일자		</td>
										<td GH="100 STD_LOTA13"		GCol="text,LOTA13" GF="D"		>유통기한		</td>
										<td GH="100 STD_LOTA14"		GCol="text,LOTA14"				>개별바코드	</td>
										<td GH="100 STD_LOTA15"		GCol="text,LOTA15"				>SAP배치번호	</td>
										<td GH="100 STD_LOTA03"		Gcol="text,LOTA03"				>포장타입		</td>
										<td GH="100 STD_LOTA16"		Gcol="text,LOTA16"	GF="N 20,3"	>평량			</td>
										<td GH="100 STD_LOTA17"		Gcol="text,LOTA17"				>컨테이너유형	</td>
										<td GH="100 STD_WAREKY"		GCol="text,WAREKY"				>거점			</td>
										<td GH="100 STD_WARENM"		GCol="text,WARENM"				>거점명		</td>
										<td GH="100 STD_RECVKY"		GCol="text,RECVKY"				>입고문서번호	</td>
										<td GH="100 STD_RECVIT"		GCol="text,RECVIT"				>입고문서순번	</td>
										<td GH="100 STD_SHPOKY"		GCol="text,SHPOKY"				>출고문서번호	</td>
										<td GH="100 STD_SHPOIT"		GCol="text,SHPOIT"				>출고문서아이템	</td>
										<td GH="100 STD_TASKKY"		GCol="text,TASKKY"				>작업문서번호	</td>
										<td GH="100 STD_TASKIT"		GCol="text,TASKIT"				>작업문서순번	</td>
										<td GH="100 STD_SADJKY"		GCol="text,SADJKY"				>재고조정문서번호</td>
										<td GH="100 STD_SADJIT"		GCol="text,SADJIT"				>재고조정아이템번호</td>
										<td GH="100 STD_CREDAT"		GCol="text,CREDAT" GF="D"		>생성일자		</td>
										<td GH="100 STD_CRETIM"		GCol="text,CRETIM" GF="T"		>생성시간		</td>
										<td GH="100 STD_CREUSR"		GCol="text,CREUSR"				>생성자ID		</td>
										<td GH="100 STD_CUSRNM"		GCol="text,CUSRNM"				>생성자명		</td>
										<td GH="100 STD_TASCAT"		GCol="text,TASCAT"				>작업유형		</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="btn_lit tableUtil">
						<button type="button" GBtn="find"></button>
						<button type="button" GBtn="sortReset"></button>
						<button type="button" GBtn="layout"></button>
						<button type="button" GBtn="total"></button>
						<button type="button" GBtn="excel"></button>
						<button type='button' GBtn="subTotal"></button>
						<span class='txt_total' >총 건수 : <span GInfoArea='true'>0</span></span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- // content -->
<%@ include file="/common/include/webdek/bottom.jsp" %>
</body>
</html>