<script type="text/javascript">

	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",
			editable : true,
			module : "WmsTask",
			command : "TK36"
		});
		
		gridList.setGrid({
			id : "gridListSub",
			editable : true,
			module : "WmsTask",
			command : "TK36Sub"
		});
		
