	function commonBtnClick(btnName){
		if(btnName == "Search"){
			searchList();
		}else if(btnName == "Save"){
			saveData();
		}
		
	}
		
function createList(){				
		
		var param = inputList.setRangeParam("searchArea");
		param.put("LANGKY", "<%=langky%>");
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		
		param.put("PROGID", configData.MENU_ID);
		
		gridList.gridList({
			id : "gridList",
			param : param
		});
		
	}
		
	function searchList(){
		if(validate.check("searchArea")){
			// 데이터변경여부 체크
			var isChg = false;
			if("R" != gridList.getRowState("gridList", 0)) {
				isChg = true;
			}
			
			for(var i=0; i < gridList.getGridDataCount("gridListSub"); i++) {
				if("R" != gridList.getRowState("gridListSub", i)) {
					isChg = true;
					break;
				}
			}
		
			// 데이터 초기화됩니다. 계속 하시겠습니까?
			if(isChg && !commonUtil.msgConfirm("VALID_M0011")) { 
				return;
			}
			
			var param = inputList.setRangeParam("searchArea");
			param.put("LANGKY", "<%=langky%>");
			param.put("WAREKY", "<%=wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LOTA02", param.get("ST.LOTA02"));
			param.put("PROGID", configData.MENU_ID);
			
			gridList.resetGrid("gridListSub");
			
				gridList.gridList({
					id : "gridListSub",
					param : param
				}); 
		}
		
	}
	function saveData(){
		if(gridList.validationCheck("gridList", "data")){
			if(gridList.validationCheck("gridListSub", "select")){
				var chkRowCnt = gridList.getSelectRowNumList("gridListSub").length;
				var chkRowIdx = gridList.getSelectRowNumList("gridListSub");
				
				if(chkRowCnt > 0){
					
					if(!commonUtil.msgConfirm("OUT_M0191")){
			        	return;
			        }
	
					var docdat = gridList.getColData("gridList", 0, "DOCDAT");
					if(docdat == ""){
						//commonUtil.msgBox("VALID_M1590"); //전기일자가 입력되지 않았습니다.
						if(!commonUtil.msgConfirm("VALID_M2083")){ //전기일자가 입력되지 않으면 오늘일로 처리 됩니다. 진행하시겠습니까?
							return;
						}
					}
										
					
					var HeadLota01 = gridList.getColData("gridList", 0, "LOTA01");
					var sapSendYn = "Y";
					
					
					 for(var i=0; i < chkRowCnt; i++){
						
						var ListLota01 = gridList.getColData("gridListSub", chkRowIdx[i], "LOTA01");						
						var ListLota02 = gridList.getColData("gridListSub", chkRowIdx[i], "LOTA02"); 
						var FirstSkukey = gridList.getColData("gridListSub", chkRowIdx[i], "SKUKEY").substr(0, 2);

						//2400 3000 p100 1   
						//2400 2400 p100 s
						
						var j = i+1;
						
						if(i+1 >= chkRowCnt){
							j = chkRowCnt-1;							
						}
						
						var NextListLota01 = gridList.getColData("gridListSub", chkRowIdx[j], "LOTA01");
						var NextListLota02 = gridList.getColData("gridListSub", chkRowIdx[j], "LOTA02");
						var NextFirstSkukey = gridList.getColData("gridListSub", chkRowIdx[j], "SKUKEY").substr(0, 2);
						
						
						if(((ListLota01 == "2400" && ListLota02 == "P100" && (FirstSkukey == "S0" || FirstSkukey == "S9")) || (NextListLota01 == "2400" && NextListLota02 == "P100" && (NextFirstSkukey == "S0" || NextFirstSkukey == "S9"))) && ListLota01 != NextListLota01) {
							commonUtil.msgBox("VALID_M2101"); //밀롤외 품목이존재합니다. 
							return;
						}
						
						
						
						if(ListLota01 == "2400" && ListLota02 == "P100" && (FirstSkukey == "S0" || FirstSkukey == "S9") && HeadLota01 != ListLota01){
							commonUtil.msgBox("VALID_M2102"); //해당 품목은 밀롤품목 입니다. 저장위치를 확인해주세요. 							
							gridList.setColFocus("gridList", 0, "LOTA01");
							return;
						}
	
						
					}
									
					
					var head = gridList.getRowData("gridList", 0);
					var list = gridList.getSelectData("gridListSub");
					
					var param = new DataMap();
					param.put("head", head);
					param.put("list", list);
					param.put("PROGID", "<%=menuId%>");					
					
					
					param.put("messageOption", {
		                    total_count : param.map.list.length,
		                    current_count : 1,
		                    message   : commonUtil.getMsg("OUT_M0247")//"출고완료 진행중입니다."    
		                })
	               
	                var json = save(param);	

// 					var json = netUtil.sendData({
// 						url : "/wms/task/json/saveTK.data",
// 						param : param
// 					});
					
// 					var paramH = new DataMap();
					
// 					if(json && json.data){
						
// 						var sendMsg = json.data["MSG"];
// 	                	var sendMsg_Type = json.data["MSG_TYPE"];
// 	                	var sendMsg_Doc_No = json.data["MSG_DOC_NO"];
	                    
// 	                    if(sendMsg && sendMsg_Type == "MES"){
// 	                    	commonUtil.msgBox("OUT_M0233", [sendMsg_Doc_No, sendMsg_Type, sendMsg]); //관리자에게 문의 바랍니다.
// 	                    	return;
// 	                    }else if(sendMsg && !sendMsg_Type){
// 	                    	commonUtil.msgBox(sendMsg); //관리자에게 문의 바랍니다.
// 	                    	return;
// 	                    }
			            
// 						commonUtil.msgBox("OUT_M0192"); //출고완료 되었습니다.
// 						searchList();
// 						return;
// 					}
					
				}else{
					commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
					return false;
				}
			}
	  	}
	}
	
	var sucCount = 0;
    var errCount = 0;
    var msgHtml = "";
    
    function save(param, recall){
    	if(param.map.messageOption.current_count == 1){
    		sucCount = 0; 
    	    errCount = 0;
    	    msgHtml = "";
    	}
    	
    	if(param.map.messageOption){
            netUtil.processMessage(param);
        }
    	
    	var loopHeadList = new Array();
    		loopHeadList.push(param.map.list[param.map.messageOption.current_count-2]);
    	//param.map.headList = param.map.headList[param.map.messageOption.current_count];
    	
    	param.put("loopHeadList", loopHeadList);
    	
    	var json; 
		
        setTimeout(function(){
        	
        	json = netUtil.sendData({
    			url : "/wms/task/json/saveTK.data",
    			param : param,
	            async : true,
	            loading : true,
	            recall : recall,
                callBackFunction : function(returnData){
      
                	if(returnData.data.MSG){
                		msgHtml += "\n"+returnData.data.MSG;                		
                		errCount++;
                	}else{
                		sucCount++;
                	}
                	
                    if(param.map.messageOption.total_count >= param.map.messageOption.current_count){
                    	save(param, true);
                    }else{
                        netUtil.processMessageOff();       
                        
                        commonUtil.msgBox("실패:"+errCount +", 성공:"+sucCount+msgHtml); //관리자에게 문의 바랍니다.
                    	searchList();
                    }
                }
	        });	        	       
	        
        }, 100);
        
    }
	
	function gridListEventDataBindEnd(gridId, dataCount){
		if(gridId == "gridHeadList"){
		}else if(gridId == "gridListSub" && dataCount > 0){
		}
	}
	
	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
		
		var param = new DataMap();
		
		
		if(gridId == "gridList"){
			
			if(colName == "DOCDAT") {
				// 전기일자 체크	
				var rowData = gridList.getRowData(gridId, rowNum);
				var asndat = rowData.get("ASNDAT");
				var docdat = rowData.get("DOCDAT");
				var asndate = asndat;
				var now = new Date();
				now.setDate(now.getDate());
				var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
				
				if(docdat < asndate){
					//alert("과거일자로 출고하실 수 없습니다.");
// 					commonUtil.msgBox("OUT_M0190")
// 					gridList.setColValue(gridId, rowNum, "DOCDAT", tmpValue);
				}
			}else if(gridId == "gridList" && colName == "LOTA01") {
				
				if(colValue.length > 0 && colValue != " " && validate.check("searchArea")) {
					param.clear();
					param.put("LANGKY", "<%=langky%>");
		            param.put("OWNRKY", "<%=ownrky%>");
		            param.put("WAREKY", "<%=wareky%>");		            
		            param.put("PTNRKY", $('select[id="ST.LOTA02"]').val() + colValue);		            
		            param.put("PTNRTY", "CT");
							            
		            
					var json = netUtil.sendData({
						module: "WmsTask",
						command: "TK36_PTNRKY",
						sendType: "map",
						param: param
					});
					if(json && json.data) {
						gridList.setColValue("gridList", rowNum, "LOTA01NM", json.data["NAME01"]);
						gridList.setColValue("gridList", rowNum, "DPTNKY", json.data["PTNRKY"]);
						gridList.setColValue("gridList", rowNum, "DPTNKYNM", json.data["NAME01"]);
					} else {
						commonUtil.msgBox("OUT_M0214", colValue)//{0}: 저장위치가 존재하지 않습니다.

						setTimeout(function(){
							gridList.setColValue("gridList", rowNum, "LOTA01NM", "");
							gridList.setColFocus("gridList", rowNum, "LOTA01NM");
						}, 1);
					}
				} else {
					gridList.setColValue("gridList", rowNum, "LOTA01NM", "");
				}
				
			}else if(gridId == "gridList" && colName == "PTNRTY") {
				
				gridList.setColValue(gridId, rowNum, "DPTNKY", "");
				gridList.setColValue(gridId, rowNum, "DPTNKYNM", "");
				
			}
			
		}else if(gridId == "gridListSub" && colName == "QTTAOR"){
			
			var qtsiwh = new Number(gridList.getColData(gridId, rowNum, "QTSIWH"));
			
			if(qtsiwh < colValue){
				commonUtil.msgBox("OUT_M0213")//작업수량이 재고수량보다 클수 없습니다.
				gridList.setColValue(gridId, rowNum, colName, qtsiwh);
			} 
			
			
			
		}
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType){
		var param = new DataMap();
		
		if(searchCode == "SHSKUMA"){
            param.put("OWNRKY", "<%=ownrky%>");
			return param;
		}else if(searchCode == "SHSTLMAP"){
	    	
	    	var PLNTKY = $('select[name="ST.LOTA02"]').val();
			
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("PLNTKY", PLNTKY);
	    	
	    	return param;
	    }else if(searchCode == "SHSTLMAP2"){
	    	
			var PLNTKY = $('select[name="ST.LOTA02"]').val();
			
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			
            param.put("LANGKY", "<%=langky%>");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("WAREKY", "<%=wareky%>");
            param.put("PLNTKY", $('select[id="ST.LOTA02"]').val());
            //param.put("WMSMAK", " ");
            return param; 
        }
		
	}
		
	
	function comboEventDataBindeBefore(comboAtt){
		if(comboAtt == "Wms,PLNTKYCOMBO"){
            var param = new DataMap();
	        param.put("WAREKYS", "'<%= wareky%>'");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("LANGKY", "<%=langky%>");
            
            return param;
        }else if(comboAtt == "WmsOrder,RCPTTYCOMBO"){
        	
        	
            var param = new DataMap();

	 			param.put("PROGID", configData.MENU_ID);
            
            return param;
           
       }else if(comboAtt == "WmsTask,TK01_RSNCD_SET"){
			var param = new DataMap();
			param.put("LANGKY", "<%=langky%>");
			param.put("DOCUTY", "356");
			return param;
		}else if(comboAtt == "airfw,COMCOMBO"){			
			 var param = new DataMap();
	         param.put("CODE", 'SKUL01');
	         return param;
		}
	}
	
	function gridListEventRowCheck(gridId, rowNum, checkType){
	    if(gridId == "gridListSub"){

	    	var Lota01 = gridList.getColData(gridId, rowNum, "LOTA01");						
			var Lota02 = gridList.getColData(gridId, rowNum, "LOTA02"); 
			var fSkukey = gridList.getColData(gridId, rowNum, "SKUKEY").substr(0, 2);
			
			if(Lota01 == "2400" && Lota02 == "P100" && (fSkukey == "S0" || fSkukey == "S9")){			
				gridList.setColValue("gridList", 0, "LOTA01", "2400");
				gridListEventColValueChange("gridList", 0, "LOTA01", "2400");				
			} 
	    }
	    
	}		
	
	</script>
	</head>
