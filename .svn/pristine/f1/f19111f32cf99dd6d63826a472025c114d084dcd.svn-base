				NVL(#{TASKIT}, ' '),
				#{TASKTY},
				NVL(#{RSNCOD}, ' '),
				CASE WHEN TO_NUMBER(NVL(TRIM(#{QTCOMP}), 0)) = 0 THEN 'NEW'
				     WHEN TO_NUMBER(NVL(TRIM(#{QTTAOR}), 0)) = 0 THEN 'FIN'
				     ELSE CASE WHEN #{QTTAOR} = #{QTCOMP} THEN 'FPC' ELSE 'PPC' END
