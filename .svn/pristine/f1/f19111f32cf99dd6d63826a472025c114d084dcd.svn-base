	<select id="DL04_SELECT_TASKKY_LIST" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT TASKKY FROM TASDI WHERE SHPOKY = #{SHPOKY} AND TASKTY IN ('PK')
	</select>
	
	<select id="DL04REMOVE_CHECK_LIST" parameterType="Map" resultType="DataMap">
		SELECT * FROM TASDI WHERE TASKKY = #{TASKKY} AND STATIT NOT IN('NEW','FCN', 'FIN') AND TASKTY IN ('PK')
	</select>
	
	<delete id="DL04REMOVE1_DELETE" parameterType="Map">
		DELETE FROM TASDI
		WHERE SHPOKY = #{SHPOKY}
		  AND TASKTY = 'PK'
		  AND SHPOIT = #{SHPOIT}
		  AND STATIT IN('NEW', 'FCN', 'FIN')
	</delete>
	
	<delete id="DL04REMOVE2_DELETE" parameterType="Map">
		DELETE FROM TASDI
		WHERE SHPOKY = #{SHPOKY}
		AND TASKTY = 'PK'
		AND STATIT IN('NEW', 'FCN', 'FIN')
	</delete>
	
	<delete id="DL04REMOVE3_DELETE" parameterType="Map">
		DELETE FROM TASDH
		WHERE TASKKY = #{TASKKY}
		AND STATDO = 'NEW'
	</delete>
	
	<select id="DL04POPBAK_LIST" parameterType="Map" resultType="DataMap">
		SELECT SH.WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = SH.WAREKY),' ') AS WARENM
		     , SH.OWNRKY
		     , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = SH.OWNRKY),' ') AS OWNRNM
		     , SH.PGRC04 AS AREAKY
		     , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = SH.WAREKY AND AREAKY = SH.PGRC04),' ') AS AREANM
		     , SI.SKUKEY
		     , NVL(SM.DESC01, 'None existent SKU.') AS DESC01
		     , SH.DPTNKY
		     , NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = SH.OWNRKY AND PTNRTY = SH.DPTNKY AND PTNRTY = 'CT'),' ') AS DPTNNM
		     , SH.PTRCVR
		     , NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = SH.OWNRKY AND PTNRTY = SH.PTRCVR AND PTNRTY = 'CT'),' ') AS PTRCNM
		     , SH.SHPOKY
		     , SI.SHPOIT
		     , SI.SVBELN
		     , SI.SPOSNR
		     , SI.ALSTKY
		     , NVL(TRIM(SI.LOTA13),'10000101') AS LOTA13
		     , SI.QTSHPO
		     , SI.QTJCMP
		     , SI.QTSHPO - SI.QTJCMP AS QTABLE
		     , SI.QTALOC - SI.QTJCMP AS QTALOC
		     , SI.QTSHPO - SI.QTJCMP - SI.QTALOC AS QTUALO
		     , SI.UOMKEY
		  FROM SHPDH SH
		       INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
		       LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY
		  WHERE SH.SHPOKY = #{SHPOKY}
		    AND SI.SHPOIT = #{SHPOIT}
	</select>
	
	
	<delete id="DL04POPREMOVE_DELETE" parameterType="Map">
		DELETE FROM TASDI 
		WHERE STATIT = 'NEW'
		  AND TASKKY = #{TASKKY}
		  AND TASKIT = #{TASKIT}
	</delete>
	
	<select id="DL04_STOCK_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT * 
		FROM (
		    SELECT CASE WHEN NOT EXISTS ( SELECT  	NVL(SUM(QTSIWH),0)
	                                      FROM    	STKKY
	                                      WHERE   	WAREKY = STD.WAREKY
	                                      AND     	LOTNUM = STD.LOTNUM
	                                      AND     	LOCAKY = STD.LOCAKY
	                                      AND     	TRNUID = STD.TRNUID
	                                      AND     	PACKID = STD.PACKID
	                                      AND     	((QTSIWH&gt;0 AND QTSPMO=0) or (QTSIWH&gt;0 AND TASKKY =STD.TASKKY AND TASKIT=STD.TASKIT))   
	                                      HAVING NVL(SUM(QTSIWH),0) &gt;= STD.QTTAOR
	                                     )
		                THEN 'IN_M0138†' || STD.LOTNUM || '/' || STD.LOCAKY|| '/' || STD.TRNUID || '/' || TO_CHAR(STD.QTTAOR) || '/'
		                				 || ( SELECT  	TO_CHAR(NVL(SUM(QTSIWH),0))
		                                      FROM    	STKKY
		                                      WHERE   	WAREKY = STD.WAREKY
		                                      AND     	LOTNUM = STD.LOTNUM
		                                      AND     	LOCAKY = STD.LOCAKY
		                                      AND     	TRNUID = STD.TRNUID
		                                      AND     	PACKID = STD.PACKID
		                                      AND     	((QTSIWH&gt;0 AND QTSPMO=0) or (QTSIWH&gt;0 AND TASKKY =STD.TASKKY AND TASKIT=STD.TASKIT)) ) 
		                ELSE 'OK'
				        END AS RESULTMSG                                      
		    FROM (  ${APPEND_QUERY}   ) STD
		)
		WHERE	RESULTMSG != 'OK'
		AND		ROWNUM = 1
	</select>
	
	<!-- ================================================================================================== -->
	<!-- [DL05] 출고검수 start -->
	<!-- ================================================================================================== -->
	
	<!-- 출고검수 헤더 조회 -->
	<select id="DL05_LIST" parameterType="Map" resultType="DataMap">
		SELECT SH.WAREKY
			 , WH.NAME01 AS WAREKYNM
			 , SH.OWNRKY
			 , (SELECT NAME01 FROM OWNER WHERE OWNER.OWNRKY = SH.OWNRKY) AS OWNRKYNM
			 , SH.SHPOKY AS SHPOKY
			 , MAX(SI.SVBELN) AS SVBELN
			 , SH.DOCDAT
			 , SH.DOCCAT
			 , DC.SHORTX AS DOCCATNM
			 , SH.SHPMTY
			 , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.SHPMTY) AS SHPMTYNM
			 , SH.DOCUTY
			 , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.DOCUTY) AS DOCUTYNM
			 , CASE WHEN SUM(DECODE(SI.STATIT, 'FCK', 0, 1)) > 0 THEN ' ' ELSE 'V' END INDCHK
			 --, DT.INDCHK
			 , SH.QTSHPO AS QTSHPO
			 , SH.QTSHPD AS QTSHPD
			 , SH.STATDO
			 , ST.CDESC1 AS STATDONM
			 , SH.DPTNKY
			 , CT.NAME01
			 , (SELECT NAME01 FROM BZPTN BZ WHERE PTNRTY = 'CT' AND BZ.PTNRKY = SH.DPTNKY AND BZ.OWNRKY = SH.OWNRKY AND ROWNUM = 1) AS DPTNKYNM
			 , SH.PTRCVR
			 , (SELECT NAME01 FROM BZPTN BZ WHERE PTNRTY = 'CT' AND BZ.PTNRKY = SH.PTRCVR AND BZ.OWNRKY = SH.OWNRKY AND ROWNUM = 1) AS PTRCVRNM
			 , SH.VEHINO
			 , SH.DRIVER
			 , SH.PGRC01
			 , SH.PGRC02
			 , SH.PGRC03
			 , SH.PGRC04
			 , SH.PGRC05
			 , SH.RQSHPD
			 , SH.RQARRD
			 , SH.RQARRT
			 , SH.OPURKY
			 , SH.DOCTXT
			 , SH.USRID1
			 , SH.UNAME1
			 , SH.DEPTID1
			 , SH.DNAME1
			 , SH.USRID2
			 , SH.UNAME2
			 , SH.DEPTID2
			 , SH.USRID3
			 , SH.UNAME3
			 , SH.DEPTID3
			 , SH.USRID4
			 , SH.UNAME4
			 , SH.DEPTID4
			 , SH.CREDAT
			 , SH.CRETIM
			 , SH.CREUSR
			 , (SELECT NMLAST FROM USRMA WHERE USERID = 'DEV' AND ROWNUM =1 ) AS CUSRNM
			 , SH.LMODAT
			 , SH.LMOTIM
			 , SH.LMOUSR
			 , (SELECT NMLAST FROM USRMA WHERE USERID = 'DEV' AND ROWNUM =1 ) AS LUSRNM
		  FROM SHPDH SH INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
						LEFT OUTER JOIN DOCCM DC ON DC.DOCCAT = '200'
						LEFT OUTER JOIN DOCTM DT ON DT.DOCCAT = DC.DOCCAT 
												AND DT.DOCUTY = SH.SHPMTY
												--AND DT.DOCGRP = ' ' 2022.02.25 KKJ
						LEFT OUTER JOIN CMCDV ST ON ST.CMCDKY = 'STATDO'
												 AND ST.CMCDVL = SH.STATDO
						LEFT OUTER JOIN WAHMA WH ON WH.WAREKY = SH.WAREKY
						LEFT OUTER JOIN BZPTN CT ON CT.PTNRKY = SH.DPTNKY
												 AND CT.PTNRTY = 'CT'
												 AND CT.OWNRKY = SH.OWNRKY
		 WHERE SH.WAREKY = #{WAREKY}
		   AND DT.INDCHK ='V'
		<if test="RANGE_SQL_1 != null and RANGE_SQL_1 != ''">
		   AND ${RANGE_SQL_1}
		</if>
		   AND SH.STATDO IN ( 'DUMMY'
		   					<if test="STAT03 == &quot;V&quot;">, 'PPC', 'FPC'</if>
							<if test="STAT05 == &quot;V&quot;">, 'PCK'</if>
							<if test="STAT06 == &quot;V&quot;">, 'FCK'</if> 
							)
		   AND SH.SHPMTY IN (SELECT DOCUTY FROM DOCTM WHERE DOCCAT = '200' AND DOCGRP != 'V')
	  GROUP BY SH.SHPOKY, SH.QTSHPO, SH.QTSHPD, SH.WAREKY, WH.NAME01,
			   SH.STATDO, ST.CDESC1, SH.DPTNKY, SH.PTRCVR, SH.VEHINO,
			   SH.DRIVER, SH.PGRC01, SH.PGRC02, SH.PGRC03, SH.PGRC04,
			   SH.PGRC05, SH.OWNRKY, SH.DOCDAT, SH.DOCCAT, DC.SHORTX,
			   SH.SHPMTY, SH.DOCUTY, SH.RQSHPD, SH.RQARRD, SH.RQARRT,
			   SH.OPURKY, SH.DOCTXT, SH.DNAME1, CT.NAME01, DT.INDCHK,
			   SH.CREDAT, SH.CRETIM, SH.CREUSR, SH.LMODAT, SH.LMOTIM, SH.LMOUSR, 
			   SH.USRID1, SH.UNAME1, SH.DEPTID1, SH.USRID2, SH.UNAME2, SH.DEPTID2,
			   SH.USRID3, SH.UNAME3, SH.DEPTID3, SH.USRID4, SH.UNAME4, SH.DEPTID4
	  ORDER BY SH.SHPOKY DESC
	</select>
	
	<!-- 출고검수 아이템 조회 -->
	<select id="DL05Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT I.SHPOKY AS SHPOKY
			 , I.SHPOIT AS SHPOIT
			 , I.SMANDT AS SMANDT
			 , I.SVBELN AS SVBELN
			 , I.SPOSNR AS SPOSNR
			 , H.SHPMTY AS SHPMTY
			 , I.STATIT AS STATIT
			 , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = I.STATIT),' ') AS STATNM
			 , I.ALSTKY AS ALSTKY
			 , H.WAREKY AS WAREKY
			 , H.OWNRKY AS OWNRKY
			 , I.STKNUM AS STKNUM
			 , I.QTYORG AS QTYORG
			 , I.QTSHPO AS QTSHPO
			 , (I.QTSHPO-I.QTALOC) AS QTUALO
			 , I.QTALOC AS QTALOC
			 , I.QTJCMP AS QTJCMP
			 , I.QTSHPC AS QTSHPC
			 --, I.QTJCMP AS QTSHPC
			 , I.QTSHPC AS DBQTSHPC
			 , I.QTSHPD AS QTSHPD
			 , I.MEASKY AS MEASKY
			 , I.SKUKEY AS SKUKEY
			 , I.DESC01 AS DESC01
			 , I.DESC02 AS DESC02
			 , I.UOMKEY AS UOMKEY
			 , I.QTPUOM AS QTPUOM
			 , I.DUOMKY AS DUOMKY
			 , I.QTDUOM AS QTDUOM
			 , I.REFDKY AS REFDKY
			 , I.REFDIT AS REFDIT
			 , I.REFCAT AS REFCAT
			 , I.REFDAT AS REFDAT
			 , I.ASKU01 AS ASKU01
			 , I.ASKU02 AS ASKU02
			 , I.ASKU03 AS ASKU03
			 , I.ASKU04 AS ASKU04
			 , I.ASKU05 AS ASKU05
			 , I.EANCOD AS EANCOD
			 , I.GTINCD AS GTINCD
			 , I.SKUG01 AS SKUG01
			 , I.SKUG02 AS SKUG02
			 , I.SKUG03 AS SKUG03
			 , I.SKUG04 AS SKUG04
			 , I.SKUG05 AS SKUG05
			 , I.GRSWGT AS GRSWGT
			 , I.NETWGT AS NETWGT
			 , I.WGTUNT AS WGTUNT
			 , I.LENGTH AS LENGTH
			 , I.WIDTHW AS WIDTHW
			 , I.HEIGHT AS HEIGHT
			 , I.CUBICM AS CUBICM
			 , I.CAPACT AS CAPACT
			 , I.LOTA01 AS LOTA01
			 , I.LOTA02 AS LOTA02
			 , I.LOTA03 AS LOTA03
			 , I.LOTA04 AS LOTA04
			 , I.LOTA05 AS LOTA05
			 , I.LOTA06 AS LOTA06
			 , I.LOTA07 AS LOTA07
			 , I.LOTA08 AS LOTA08
			 , I.LOTA09 AS LOTA09
			 , I.LOTA10 AS LOTA10
			 , I.LOTA11 AS LOTA11
			 , I.LOTA12 AS LOTA12
			 , I.LOTA13 AS LOTA13
			 , I.LOTA14 AS LOTA14
			 , I.LOTA15 AS LOTA15
			 , I.LOTA16 AS LOTA16
			 , I.LOTA17 AS LOTA17
			 , I.LOTA18 AS LOTA18
			 , I.LOTA19 AS LOTA19
			 , I.LOTA20 AS LOTA20
			 , I.CREDAT AS CREDAT
			 , I.CRETIM AS CRETIM
			 , I.CREUSR AS CREUSR
			 , I.LMODAT AS LMODAT
			 , I.LMOTIM AS LMOTIM
			 , I.LMOUSR AS LMOUSR
		  FROM SHPDI I 
		  	   INNER JOIN SHPDH H ON H.SHPOKY = I.SHPOKY
		  	   LEFT OUTER JOIN DOCCM DC ON DC.DOCCAT = '200'
			   LEFT OUTER JOIN DOCTM DT ON DT.DOCCAT = DC.DOCCAT 
									   AND DT.DOCUTY = H.SHPMTY
									   AND DT.DOCGRP = ' '
		 WHERE I.SHPOKY = H.SHPOKY
		   AND H.SHPMTY IN (SELECT DOCUTY FROM DOCTM WHERE DOCCAT = '200' AND DOCGRP != 'V')
		   AND I.SHPOKY = #{SHPOKY}
		   AND I.STATIT IN ('FPC', 'PPC')
	  ORDER BY I.SHPOKY, I.SHPOIT
	</select>
	
	<!-- 출고검수 헤더 재조회 -->
	<select id="DL21RH_LIST" parameterType="Map" resultType="DataMap">
		SELECT SH.WAREKY
			 , WH.NAME01 AS WAREKYNM
			 , SH.OWNRKY
			 , (SELECT NAME01 FROM OWNER WHERE OWNER.OWNRKY = SH.OWNRKY) AS OWNRKYNM
			 , SH.SHPOKY AS SHPOKY
			 , MAX(SI.SVBELN) AS SVBELN
			 , SH.DOCDAT
			 , SH.DOCCAT
			 , DC.SHORTX AS DOCCATNM
			 , SH.SHPMTY
			 , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.SHPMTY) AS SHPMTYNM
			 , SH.DOCUTY
			 , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.DOCUTY) AS DOCUTYNM
			 , CASE WHEN SUM(DECODE(SI.STATIT, 'FCK', 0, 1)) > 0 THEN ' ' ELSE 'V' END INDCHK
             , SUM(SI.QTSHPO) AS QTSHPO
             , SUM(SI.QTJCMP) AS QTCOMP
			 , SH.STATDO
			 , ST.CDESC1 AS STATDONM			 			 
			 , NVL(DECODE(SH.SHPMTY, '231', SH.PTRCVR, SH.DPTNKY), ' ') AS DPTNKY              
			 , NVL(DECODE(SH.SHPMTY, '231', VD.NAME01, CT.NAME01), ' ') AS DPTNKYNM
			 , SH.PTRCVR
			 , (SELECT NAME01 FROM BZPTN BZ WHERE PTNRTY = 'CT' AND BZ.PTNRKY = SH.PTRCVR AND BZ.OWNRKY = SH.OWNRKY AND ROWNUM = 1) AS PTRCVRNM
			 , SH.VEHINO
			 , SH.CARNO
			 , SH.DRIVERCEL
			 , SH.DRIVER
			 , SH.PGRC01
			 , SH.PGRC02
			 , SH.PGRC03
			 , SH.PGRC04
			 , SH.PGRC05
			 , SH.RQSHPD
			 , SH.RQARRD
			 , SH.RQARRT
			 , SH.OPURKY
			 , SH.DOCTXT
			 , SH.USRID1
			 , SH.UNAME1
			 , SH.DEPTID1
			 , SH.DNAME1
			 , SH.USRID2
			 , SH.UNAME2
			 , SH.DEPTID2
			 , SH.USRID3
			 , SH.UNAME3
			 , SH.DEPTID3
			 , SH.USRID4
			 , SH.UNAME4
			 , SH.DEPTID4
			 , SH.CREDAT
			 , SH.CRETIM
			 , SH.CREUSR
			 , (SELECT NMLAST FROM USRMA WHERE USERID = 'DEV' AND ROWNUM =1 ) AS CUSRNM
			 , SH.LMODAT
			 , SH.LMOTIM
			 , SH.LMOUSR
			 , (SELECT NMLAST FROM USRMA WHERE USERID = 'DEV' AND ROWNUM =1 ) AS LUSRNM
			 , CASE WHEN SH.QTALOC = SH.QTSHPC THEN 'Y'
                ELSE 'N' END AS LOADYN	
             , SI.STKNUM 
             , SI.STLNUM  		
             , CASE WHEN (SELECT COUNT(*) FROM SHPDI SPI WHERE SPI.SHPOKY = SH.SHPOKY AND SI.STKNUM = SPI.STKNUM 
               AND NVL(TRIM(SPI.STKNUM), ' ') != ' '  AND NVL(TRIM(SPI.STLNUM), ' ') != ' '  AND NVL(TRIM(SPI.STLNUM), ' ') != ' ' AND SPI.STKNUM != SPI.STLNUM) > 0 THEN 'V'
               ELSE ' '
               END STLCHK
             , NVL(TP.STKNUM, ' ') AS TOTPICKNUM
             , NVL(SH.SAP2, ' ') AS SAP2 		  		
		  FROM SHPDH SH INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
						LEFT OUTER JOIN DOCCM DC ON DC.DOCCAT = '200'
						LEFT OUTER JOIN DOCTM DT ON DT.DOCCAT = DC.DOCCAT 
												AND DT.DOCUTY = SH.SHPMTY
												--AND DT.DOCGRP = ' ' 2022.02.25 KKJ
						LEFT OUTER JOIN CMCDV ST ON ST.CMCDKY = 'STATDO'
												 AND ST.CMCDVL = SH.STATDO
						LEFT OUTER JOIN WAHMA WH ON WH.WAREKY = SH.WAREKY
						LEFT OUTER JOIN BZPTN CT ON CT.OWNRKY = SH.OWNRKY 
												AND CT.PTNRTY  = 'CT' 
												AND CT.PTNRKY  = SH.DPTNKY
					    LEFT OUTER JOIN BZPTN VD ON VD.OWNRKY = SH.OWNRKY 
												AND VD.PTNRTY  = 'VD' 
												AND VD.PTNRKY  = SH.PTRCVR
						LEFT OUTER JOIN SKUMA SM ON SM.SKUKEY = SI.SKUKEY												 
												 AND SM.OWNRKY = SH.OWNRKY
						LEFT OUTER JOIN TASTP TP
                               ON  TP.SHPOKY =  SH.SHPOKY
                               AND TP.OWNRKY = SH.OWNRKY   
                               AND TP.WAREKY = SH.WAREKY						
		 WHERE SH.WAREKY = #{WAREKY}
		   AND SH.SHPOKY IN (${SHPOKY})
		   AND SH.STATDO IN ( 
		  							 'DUMMY'
									, 'PPC'
									, 'FPC'
									, 'PCK'
									, 'FCK'
									, 'CCN')
		   AND SI.STATIT NOT IN('FCO')		
		   AND SUBSTR(SI.SHPOIT,0,1) != 1		
		   AND SH.SHPMTY IN (SELECT DOCUTY FROM DOCTM WHERE DOCCAT = '200' AND DOCGRP != 'V')
	  GROUP BY SH.SHPOKY, SH.WAREKY, WH.NAME01,
			   SH.STATDO, ST.CDESC1, SH.DPTNKY, SH.PTRCVR, SH.VEHINO,
			   SH.DRIVER, SH.PGRC01, SH.PGRC02, SH.PGRC03, SH.PGRC04,
			   SH.PGRC05, SH.OWNRKY, SH.DOCDAT, SH.DOCCAT, DC.SHORTX,
			   SH.SHPMTY, SH.DOCUTY, SH.RQSHPD, SH.RQARRD, SH.RQARRT,
			   SH.OPURKY, SH.DOCTXT, SH.DNAME1, CT.NAME01, DT.INDCHK,
			   SH.CREDAT, SH.CRETIM, SH.CREUSR, SH.LMODAT, SH.LMOTIM, SH.LMOUSR, 
			   SH.USRID1, SH.UNAME1, SH.DEPTID1, SH.USRID2, SH.UNAME2, SH.DEPTID2,
			   SH.USRID3, SH.UNAME3, SH.DEPTID3, SH.USRID4, SH.UNAME4, SH.DEPTID4, 
			   SH.QTALOC, SH.QTSHPC, SH.CARNO, SH.DRIVERCEL, SI.STKNUM, SI.STLNUM,
			   TP.STKNUM, VD.NAME01, SH.SAP2
	  ORDER BY SH.SHPOKY DESC
	</select>
	
	<!-- 출고검수 아이템 재조회 -->
	<select id="DL05I_LIST" parameterType="Map" resultType="DataMap">
		SELECT I.SHPOKY AS SHPOKY
			 , I.SHPOIT AS SHPOIT
			 , I.SMANDT AS SMANDT
			 , I.SVBELN AS SVBELN
			 , I.SPOSNR AS SPOSNR
			 , H.SHPMTY AS SHPMTY
			 , I.STATIT AS STATIT
			 , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = I.STATIT),' ') AS STATNM
			 , I.ALSTKY AS ALSTKY
			 , H.WAREKY AS WAREKY
			 , H.OWNRKY AS OWNRKY
			 , I.STKNUM AS STKNUM
			 , I.QTYORG AS QTYORG
			 , I.QTSHPO AS QTSHPO
			 , (I.QTSHPO-I.QTALOC) AS QTUALO
			 , I.QTALOC AS QTALOC
			 , I.QTJCMP AS QTJCMP
			 , I.QTSHPD AS QTSHPD
			 , I.QTSHPC AS QTSHPC
			 , I.QTSHPC AS DBQTSHPC
			 , I.MEASKY AS MEASKY
			 , I.SKUKEY AS SKUKEY
			 , I.DESC01 AS DESC01
			 , I.DESC02 AS DESC02
			 , I.UOMKEY AS UOMKEY
			 , I.QTPUOM AS QTPUOM
			 , I.DUOMKY AS DUOMKY
			 , I.QTDUOM AS QTDUOM
			 , I.REFDKY AS REFDKY
			 , I.REFDIT AS REFDIT
			 , I.REFCAT AS REFCAT
			 , I.REFDAT AS REFDAT
			 , I.ASKU01 AS ASKU01
			 , I.ASKU02 AS ASKU02
			 , I.ASKU03 AS ASKU03
			 , I.ASKU04 AS ASKU04
			 , I.ASKU05 AS ASKU05
			 , I.EANCOD AS EANCOD
			 , I.GTINCD AS GTINCD
			 , I.SKUG01 AS SKUG01
			 , I.SKUG02 AS SKUG02
			 , I.SKUG03 AS SKUG03
			 , I.SKUG04 AS SKUG04
			 , I.SKUG05 AS SKUG05
			 , I.GRSWGT AS GRSWGT
			 , I.NETWGT AS NETWGT
			 , I.WGTUNT AS WGTUNT
			 , I.LENGTH AS LENGTH
			 , I.WIDTHW AS WIDTHW
			 , I.HEIGHT AS HEIGHT
			 , I.CUBICM AS CUBICM
			 , I.CAPACT AS CAPACT
			 , I.LOTA01 AS LOTA01
			 , I.LOTA02 AS LOTA02
			 , I.LOTA03 AS LOTA03
			 , I.LOTA04 AS LOTA04
			 , I.LOTA05 AS LOTA05
			 , I.LOTA06 AS LOTA06
			 , I.LOTA07 AS LOTA07
			 , I.LOTA08 AS LOTA08
			 , I.LOTA09 AS LOTA09
			 , I.LOTA10 AS LOTA10
			 , I.LOTA11 AS LOTA11
			 , I.LOTA12 AS LOTA12
			 , I.LOTA13 AS LOTA13
			 , I.LOTA14 AS LOTA14
			 , I.LOTA15 AS LOTA15
			 , I.LOTA16 AS LOTA16
			 , I.LOTA17 AS LOTA17
			 , I.LOTA18 AS LOTA18
			 , I.LOTA19 AS LOTA19
			 , I.LOTA20 AS LOTA20
			 , I.CREDAT AS CREDAT
			 , I.CRETIM AS CRETIM
			 , I.CREUSR AS CREUSR
			 , I.LMODAT AS LMODAT
			 , I.LMOTIM AS LMOTIM
			 , I.LMOUSR AS LMOUSR
			 , NVL((SELECT SKUL01 FROM SKUMA WHERE SKUKEY = I.SKUKEY AND OWNRKY = H.OWNRKY),' ') AS SKUL01
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTYORG, I.UOMKEY, 'KG')),'0') AS TOT
             , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTYORG, I.UOMKEY, 'BAG')),'0') AS BAG
             , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTYORG, I.UOMKEY, 'BOX')),'0') AS BOX
             , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTYORG, I.UOMKEY, 'PAL')),'0') AS PLT
             , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTYORG, I.UOMKEY, 'SOK')),'0') AS SOK
             , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTYORG, I.UOMKEY, 'EA')),'0') AS EA
             , H.DOCTXT AS DOCTXT
		  FROM SHPDI I 
		  	   INNER JOIN SHPDH H ON H.SHPOKY = I.SHPOKY
		  	   LEFT OUTER JOIN DOCCM DC ON DC.DOCCAT = '200'
			   LEFT OUTER JOIN DOCTM DT ON DT.DOCCAT = DC.DOCCAT 
									   AND DT.DOCUTY = H.SHPMTY
									   AND DT.DOCGRP = ' '
		 WHERE H.WAREKY = #{WAREKY}
		   AND I.SHPOKY = #{SHPOKY}
		   AND H.SHPMTY IN (SELECT DOCUTY FROM DOCTM WHERE DOCCAT = '200' AND DOCGRP != 'V')
	  ORDER BY I.SHPOKY, I.SHPOIT
	</select>
	
	<select id="WDL55GroupKey_MAP" parameterType="Map" resultType="DataMap">
		SELECT SI.REFDKY
		     , SI.REFDIT
		     , SI.SKUKEY
		     , SI.QTYORG
		     , SI.QTSHPO
		     , SI.QTALOC
		     , SI.QTJCMP
		     , SI.QTSHPC
		  FROM SHPDI SI
			   INNER JOIN SHPDH SH
					   ON SH.SHPOKY = SI.SHPOKY
		 WHERE 1=1
		   AND SH.WAREKY = #{WAREKY}
		   AND SI.SHPOKY = #{SHPOKY}
		   AND SI.SHPOIT = #{SHPOIT}
	</select>
	
	<select id="WDL55GroupQtshpc_MAP" parameterType="Map" resultType="DataMap">
		SELECT SI.SHPOKY AS GSHPOKY
			 , SI.SHPOIT AS GSHPOIT
			 , SI.SKUKEY
		     , SI.QTSHPC
		  FROM SHPDI SI
			   INNER JOIN SHPDH SH
					   ON SH.SHPOKY = SI.SHPOKY
		 WHERE 1=1
		   AND SH.WAREKY = #{WAREKY}
		   AND SI.SHPOKY = #{GSHPOKY}
		   AND SI.SKUKEY = #{SKUKEY}
	</select>
	
	<!-- 저장시 검수수량 update -->
	<update id="DL05Sub_UPDATE" parameterType="Map">
		UPDATE SHPDI
		   SET QTSHPC = QTSHPC + #{QTSHPC}
			 , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		 WHERE SHPOKY = #{SHPOKY}
		   AND SHPOIT = #{SHPOIT}
	</update>
	
	<!-- 저장시 검수수량 0 update -->
	<update id="DL05ZERO_UPDATE" parameterType="Map">
		UPDATE SHPDI
		   SET QTSHPC = 0			 
		 WHERE SHPOKY = #{SHPOKY}		   
	</update>
	
	<!-- 팔레트 추가시 -->
	<insert id="DL08Sub_INSERT" parameterType="Map">
				
		INSERT INTO SHPDI 
		(
		  SHPOKY, 
		  SHPOIT,
		  SVBELN,
		  SKUKEY,
		  DESC01,
		  DUOMKY,
		  QTSHPD,
		  INDARC,
		  CREDAT,
		  CRETIM,
		  CREUSR,
		  LMODAT,
		  LMOTIM,
		  LMOUSR
		) VALUES
		(
   	      #{SHPOKY},
		  #{SHPOIT},
		  #{SVBELN},	
		  #{SKUKEY},
		  #{DESC01}, 
		  #{DUOMKY}, 		
		  TO_NUMBER(NVL(TRIM( #{QTSHPD} ), 0)),    		  
  		  'V',
  		  TO_CHAR(SYSDATE,'YYYYMMDD'), 
		  TO_CHAR(SYSDATE,'HH24MISS'),
		  #{SES_USER_ID},
		  TO_CHAR(SYSDATE,'YYYYMMDD'), 
		  TO_CHAR(SYSDATE,'HH24MISS'),
		  #{SES_USER_ID}					              
		)
				
	</insert>
	
	<!-- 저장시 검수수량 update -->
	<update id="WDL55GroupSub_UPDATE" parameterType="Map">
		UPDATE SHPDI
		   SET QTSHPC = #{GRQTSHPC}
			 , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		 WHERE SHPOKY = #{GSHPOKY}
		   AND SHPOIT = #{GSHPOIT}
	</update>
		
	<!-- ================================================================================================== -->
	<!-- [DL05] 출고검수 end -->
	<!-- ================================================================================================== -->
	
	<select id="GEN_TASKKY_MAP" parameterType="Map" resultType="DataMap">
		SELECT SZF_GETDOCNUMBER(#{TASOTY}) AS TASKKY FROM DUAL
	</select>
	
	<select id="MANUALALLOCATE_AVAILABLE_STOCK_LIST" parameterType="Map" resultType="DataMap">
		SELECT S.STOKKY  AS "STOKKY",
		       S.WAREKY  AS "WAREKY",
		       S.LOTNUM  AS "LOTNUM",
		       S.LOCAKY  AS "LOCAKY",
		       S.TRNUID  AS "TRNUID",
		       S.SECTID  AS "SECTID",
		       S.PACKID  AS "PACKID",
		       S.QTSIWH  AS "QTSIWH",
		       S.QTSALO  AS "QTSALO",
		       S.QTSPMO  AS "QTSPMO",
		       S.QTSPMI  AS "QTSPMI",
		       S.QTSBLK  AS "QTSBLK",
		       S.QTYUOM  AS "QTYUOM",
		       S.TRUNTY  AS "TRUNTY",
		       S.MEASKY  AS "MEASKY",
		       S.UOMKEY  AS "UOMKEY",
		       S.QTPUOM  AS "QTPUOM",
		       S.DUOMKY  AS "DUOMKY",
		       S.QTDUOM  AS "QTDUOM",
		       S.TKFLKY  AS "TKFLKY",
		       S.STEPNO  AS "STEPNO",
		       S.LSTTFL  AS "LSTTFL",
		       S.SRCSKY  AS "SRCSKY",
		       S.UOMDOC  AS "UOMDOC",
		       S.CNTBSK  AS "CNTBSK",
		       S.NUPDPS  AS "NUPDPS",
		       S.REFDKY  AS "REFDKY",
		       S.REFDIT  AS "REFDIT",
		       S.REFCAT  AS "REFCAT",
		       S.REFDAT  AS "REFDAT",
		       S.PURCKY  AS "PURCKY",
		       S.PURCIT  AS "PURCIT",
		       S.ASNDKY  AS "ASNDKY",
		       S.ASNDIT  AS "ASNDIT",
		       S.RECVKY  AS "RECVKY",
		       S.RECVIT  AS "RECVIT",
		       S.SHPOKY  AS "SHPOKY",
		       S.SHPOIT  AS "SHPOIT",
		       S.GRPOKY  AS "GRPOKY",
		       S.GRPOIT  AS "GRPOIT",
		       S.TASKKY  AS "TASKKY",
		       S.TASKIT  AS "TASKIT",
		       S.SADJKY  AS "SADJKY",
		       S.SADJIT  AS "SADJIT",
		       S.SDIFKY  AS "SDIFKY",
		       S.SDIFIT  AS "SDIFIT",
		       S.PHYIKY  AS "PHYIKY",
		       S.PHYIIT  AS "PHYIIT",
		       S.OWNRKY  AS "OWNRKY",
		       S.SKUKEY  AS "SKUKEY",
		       S.LOTA01  AS "LOTA01",
		       S.LOTA02  AS "LOTA02",
		       S.LOTA03  AS "LOTA03",
		       S.LOTA04  AS "LOTA04",
		       S.LOTA05  AS "LOTA05",
		       S.LOTA06  AS "LOTA06",
		       S.LOTA07  AS "LOTA07",
		       S.LOTA08  AS "LOTA08",
		       S.LOTA09  AS "LOTA09",
		       S.LOTA10  AS "LOTA10",
		       S.LOTA11  AS "LOTA11",
		       S.LOTA12  AS "LOTA12",
		       S.LOTA13  AS "LOTA13",
		       S.LOTA14  AS "LOTA14",
		       S.LOTA15  AS "LOTA15",
		       S.LOTA16  AS "LOTA16",
		       S.LOTA17  AS "LOTA17",
		       S.LOTA18  AS "LOTA18",
		       S.LOTA19  AS "LOTA19",
		       S.LOTA20  AS "LOTA20",
		       S.AWMSNO  AS "AWMSNO",
		       S.DESC01  AS "DESC01",
		       S.DESC02  AS "DESC02",
		       S.ASKU01  AS "ASKU01",
		       S.ASKU02  AS "ASKU02",
		       S.ASKU03  AS "ASKU03",
		       S.ASKU04  AS "ASKU04",
		       S.ASKU05  AS "ASKU05",
		       S.EANCOD  AS "EANCOD",
		       S.GTINCD  AS "GTINCD",
		       S.SKUG01  AS "SKUG01",
		       S.SKUG02  AS "SKUG02",
		       S.SKUG03  AS "SKUG03",
		       S.SKUG04  AS "SKUG04",
		       S.SKUG05  AS "SKUG05",
		       S.GRSWGT  AS "GRSWGT",
		       S.NETWGT  AS "NETWGT",
		       S.WGTUNT  AS "WGTUNT",
		       S.LENGTH  AS "LENGTH",
		       S.WIDTHW  AS "WIDTHW",
		       S.HEIGHT  AS "HEIGHT",
		       S.CUBICM  AS "CUBICM",
		       S.CAPACT  AS "CAPACT",
		       S.ZONEKY  AS "ZONEKY",
		       S.TKZONE  AS "TKZONE",
		       S.AREAKY  AS "AREAKY",
		       S.SMANDT  AS "SMANDT",
		       S.SEBELN  AS "SEBELN",
		       S.SEBELP  AS "SEBELP",
		       S.SZMBLNO AS "SZMBLNO",
		       S.SZMIPNO AS "SZMIPNO",
		       S.STRAID  AS "STRAID",
		       S.SVBELN  AS "SVBELN",
		       S.SPOSNR  AS "SPOSNR",
		       S.STKNUM  AS "STKNUM",
		       S.STPNUM  AS "STPNUM",
		       S.SWERKS  AS "SWERKS",
		       S.SLGORT  AS "SLGORT",
		       S.SDATBG  AS "SDATBG",
		       S.STDLNR  AS "STDLNR",
		       S.SSORNU  AS "SSORNU",
		       S.SSORIT  AS "SSORIT",
		       S.SMBLNR  AS "SMBLNR",
		       S.SZEILE  AS "SZEILE",
		       S.SMJAHR  AS "SMJAHR",
		       S.SXBLNR  AS "SXBLNR",
		       S.SAPSTS  AS "SAPSTS",
		       S.SBKTXT  AS "SBKTXT",
		       S.CREDAT  AS "CREDAT",
		       S.CRETIM  AS "CRETIM",
		       S.CREUSR  AS "CREUSR",
		       S.LMODAT  AS "LMODAT",
		       S.LMOTIM  AS "LMOTIM",
		       S.LMOUSR  AS "LMOUSR",
		       NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = #{SHPMTY}), ' ') AS "LOCATG"
		  FROM STKKY S
		       INNER JOIN LOCMA L
		               ON L.WAREKY = S.WAREKY
		              AND L.LOCAKY = S.LOCAKY
		 WHERE S.OWNRKY = #{OWNRKY}
		   AND S.WAREKY = #{WAREKY}
		   AND S.LOCAKY = NVL(TRIM(#{LOCAKY}), ' ')
		   AND S.SKUKEY = NVL(TRIM(#{SKUKEY}), ' ')
		   AND S.TRNUID = NVL(TRIM(#{TRNUID}), ' ') 		   		  
		   AND S.PACKID = NVL(TRIM(#{PACKID}), ' ')
		   AND S.QTSIWH &gt; 0
		   AND S.QTSALO = 0
		   AND S.QTSPMO = 0
		   AND S.QTSPMI = 0
		   AND S.QTSBLK = 0
		   AND S.LOTA06 = '00'
		   AND L.INDUPK = 'V'
		   AND L.STATUS = '00'
		   
		   <if test="LOTNUM != null and LOTNUM != ''">		   
			AND S.LOTNUM = NVL(TRIM(#{LOTNUM}), ' ')
		   </if>
		   
		   <if test="STOKKY != null and STOKKY != ''">		   
			AND S.STOKKY = #{STOKKY}
		   </if>
		   <if test="BARCOD != null and BARCOD != ''">		   
			AND S.LOTA14 = #{BARCOD}
		   </if>
		   
		   AND ROWNUM =1
		 ORDER BY S.STOKKY
	</select>
	
