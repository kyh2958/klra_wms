		       TB.LOTA05  AS "LOTA05",
		       TB.LOTA06  AS "LOTA06",
		       TB.LOTA07  AS "LOTA07",
		       TB.LOTA08  AS "LOTA08",
		       TB.LOTA09  AS "LOTA09",
		       TB.LOTA10  AS "LOTA10",
		       TB.LOTA11  AS "LOTA11",
