		       S.SZEILE  AS "SZEILE",
		       S.SMJAHR  AS "SMJAHR",
		       S.SXBLNR  AS "SXBLNR",
		       S.SAPSTS  AS "SAPSTS",
		       S.SBKTXT  AS "SBKTXT",
		       S.CREDAT  AS "CREDAT",
		       S.CRETIM  AS "CRETIM",
		       S.CREUSR  AS "CREUSR",
		       S.LMODAT  AS "LMODAT",
		       S.LMOTIM  AS "LMOTIM",
		       S.LMOUSR  AS "LMOUSR",
		       NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = #{SHPMTY}), ' ') AS "LOCATG"
		  FROM STKKY S
		       INNER JOIN LOCMA L
		               ON L.WAREKY = S.WAREKY
		              AND L.LOCAKY = S.LOCAKY
		       INNER JOIN TASDR TR 
                       ON TR.STOKKY = S.STOKKY        
		 WHERE S.OWNRKY = #{OWNRKY}
		   AND S.WAREKY = #{WAREKY}
		   AND S.LOCAKY = NVL(TRIM(#{LOCAKY}), ' ')
		   AND S.SKUKEY = NVL(TRIM(#{SKUKEY}), ' ')
		   AND S.TRNUID = NVL(TRIM(#{TRNUID}), ' ') 		   		  
		   AND S.PACKID = NVL(TRIM(#{PACKID}), ' ')
		   AND S.QTSIWH &gt; 0
		   AND S.QTSALO > 0

		   <if test="LOTNUM != null and LOTNUM != ''">		   
			AND S.LOTNUM = NVL(TRIM(#{LOTNUM}), ' ')
		   </if>
		   
		   <if test="STOKKY != null and STOKKY != ''">		   
			AND S.STOKKY = #{STOKKY}
		   </if>
		   <if test="TASKKY != null and TASKKY != ''">		   
			AND S.TASKKY = #{TASKKY}
		   </if>
		   <if test="TASKIT != null and TASKIT != ''">		   
			AND S.TASKIT = #{TASKIT}
		   </if>
		   <if test="BARCOD != null and BARCOD != ''">		   
			AND S.LOTA14 = #{BARCOD}
		   </if>
		
		 ORDER BY S.STOKKY
		 ) TB
         
         GROUP BY TB.WAREKY 
