		    ,  S.NAME01 AS  NAME01 
		    ,  S.SLAND1 AS  SLAND1 
		    ,  S.SBKTXT AS  SBKTXT 
		    ,  S.CREDAT AS  CREDAT 
		    ,  S.CRETIM AS  CRETIM 
		    ,  S.CREUSR AS  CREUSR 
		    ,  S.LMODAT AS  LMODAT 
		    ,  S.LMOTIM AS  LMOTIM 
		    ,  S.LMOUSR AS  LMOUSR 
		    ,  S.INDBZL AS  INDBZL 
		    ,  S.INDARC AS  INDARC 
		    ,  S.UPDCHK AS  UPDCHK 
		FROM   SHPDI S
		WHERE  S.SHPOKY= #{SHPOKY}
		AND    1=1
		<choose>
		<when test='SAMETYPE == "N"'> 
			AND   S.SKUKEY= #{SKUKEY}
			AND   ROWNUM = 1
		</when>
		<otherwise>
			AND   S.SHPOIT= #{SHPOIT}
		</otherwise> 	
		</choose>	
	</select>
	
<!-- 	<select id="SEARCHTASDH_LIST" parameterClass="Map" resultClass="DataMap"> -->
<!-- 		SELECT MAX(TH.TASKKY) AS TASKKY				 -->
<!-- 		     , TH.PTNRKY AS AREAKY				 -->
<!-- 		     , TH.STATDO AS STATDO				 -->
<!-- 		     , NVL((SELECT MAX(TASKIT) FROM TASDI TT WHERE TT.TASKKY = TH.TASKKY),0) AS QTTAOR			 -->
<!-- 		  FROM TASDH TH				 -->
<!-- 		       INNER JOIN TASDI TI				 -->
<!-- 		               ON TI.TASKKY = TH.TASKKY				 -->
<!-- 		 WHERE TI.SHPOKY = #{SHPOKY}			 -->
<!-- 		 GROUP BY TH.TASKKY, TH.STATDO, TH.PTNRKY				 -->
<!-- 	</select> -->

	<select id="SEARCHMAXTASDH_LIST" parameterType="Map" resultType="DataMap">
		SELECT  MAX(TASDI.TASKKY) AS TASKKY
	       	   ,MAX(TASDI.TASKIT) AS TASKIT
		FROM	TASDI
		    INNER JOIN TASDH ON TASDH.TASKKY = TASDI.TASKKY
		WHERE	1 = 1
		AND		TASDI.SHPOKY = #{SHPOKY}
<!-- 		AND		TASDI.SHPOIT = #{SHPOIT} -->
		AND		TASDH.WAREKY = #{WAREKY}
		AND		TASDI.TASKKY= #{TASKKY}				
	</select>
	
	<delete id="DELTASKBYSHIP_DELETE" parameterType="Map">
		DELETE FROM TASDI
		 WHERE SHPOKY = #{SHPOKY}
		   AND SHPOIT = #{SHPOIT}
		   AND STATIT = 'NEW'
	</delete>
	
	<parameterMap id="ProcMap" type="java.util.Map">
		<parameter property="TASKKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="TASKIT" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="ERRNUM" javaType="java.lang.Long" jdbcType="DECIMAL" mode="OUT"/>
		<parameter property="ERRMSG" javaType="java.lang.String" jdbcType="VARCHAR" mode="OUT"/>
	</parameterMap>
	
	
	<update id="SZPINSTASDR_UPDATE" parameterType="Map" statementType="CALLABLE">
		 { call SZP_INS_TASDR( #{TASKKY}, #{TASKIT}, '%', #{QTTAOR}, #{QTCOMP}) }
	</update>
	
	<select id="DL80_LIST" parameterType="Map" resultType="DataMap">
		SELECT SH.SHPOKY AS SHPOKY,										
		       SI.SVBELN AS SVBELN,										
		       SI.STKNUM AS STKNUM,										
		       SH.DOCDAT AS DOCDAT,										
		       SH.SHPMTY AS SHPMTY,										
		       NVL(DT.SHORTX,' ') AS SHPMTYNM,										
		       SH.STATDO AS STATDO,										
		       NVL(ST.CDESC1,' ') AS STATDONM,										
		       SH.DPTNKY AS DPTNKY,										
		       NVL(DECODE(SH.DOCUTY,'266',BW.NAME01,BZ.NAME01),' ') AS DPTNKYNM,										
		       SH.QTSHPO AS QTSHPO,										
		       CASE WHEN SH.STATDO IN ('PSH','FSH')										
		                 THEN 'LED01'										
		            WHEN SH.STATDO IN ('PPC','FPC')										
		                 THEN 'LED02'										
		            WHEN SH.STATDO IN ('PAL','FAL')										
		                 THEN 'LED03'										
		            ELSE 'LED04'										
		         END AS ICSTAT,										
		       SH.QTALOC AS QTALOC,										
		       CASE WHEN SH.STATDO IN ('PAL','FAL','PPC','FPC','PSH','FSH')										
		                 THEN 'APN12'										
		            ELSE ' '										
		         END AS ICALOC,										
		       SH.QTJCMP AS QTJCMP,										
		       CASE WHEN SH.STATDO IN ('PPC','FPC','PSH','FSH')										
		                 THEN 'TAN19'										
		            ELSE ' '										
		         END AS ICJCMP,										
		       SH.QTSHPD AS QTSHPD,										
		       CASE WHEN SH.STATDO IN ('PSH','FSH')										
		                 THEN 'DAP01'										
		            ELSE ' '										
		         END AS ICSHPD,										
		       CASE WHEN SH.DOCUTY != '266' OR (SH.DOCUTY = '266' AND SUBSTR(SH.SHPOKY,1,3) != 'WMS')										
		                 THEN NVL((SELECT MAX(ESHPKY) FROM IFWMS213 WHERE ZDOC_NO = SH.SHPOKY),' ')										
		            ELSE NVL((SELECT MAX(EDOCKY) FROM IFWMS301 WHERE ZDOC_NO = SH.SHPOKY),' ')										
		         END AS ESHPKY										
		  FROM SHPDH SH										
		       INNER JOIN SHPDI SI										
		               ON SI.SHPOKY = SH.SHPOKY										
		       LEFT OUTER JOIN DOCTM DT										
		               ON DT.DOCUTY = SH.DOCUTY										
		       LEFT OUTER JOIN CMCDV ST										
		               ON ST.CMCDKY = 'STATDO'										
		              AND ST.CMCDVL = SH.STATDO										
		       LEFT OUTER JOIN BZPTN BZ										
		               ON BZ.PTNRKY = SH.DPTNKY										
		              AND BZ.PTNRTY = 'CT'										
		              AND BZ.OWNRKY = SH.OWNRKY										
		       LEFT OUTER JOIN WAHMA BW										
		               ON BW.WAREKY = SH.DPTNKY										
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND SH.WAREKY = #{WAREKY}
		</if>									
		<if test="OWNRKY != null and OWNRKY != ''">
		   AND SH.OWNRKY = #{OWNRKY}										
		</if>									
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>	
		 GROUP BY SH.SHPOKY, SI.SVBELN, SI.STKNUM, SH.DOCDAT,										
		          SH.SHPMTY, NVL(DT.SHORTX,' '),										
		          SH.STATDO, NVL(ST.CDESC1,' '),										
		          SH.DPTNKY, NVL(DECODE(SH.SHPMTY,'266',BW.NAME01,BZ.NAME01),' '),										
		          SH.QTSHPO, SH.QTALOC, SH.QTJCMP, SH.QTSHPD										
		 ORDER BY SI.STKNUM, SH.SHPOKY										
	</select>
	
	<select id="BARCD_LIST" parameterType="Map" resultType="DataMap">
		SELECT B.REFDKY AS REFDKY,
		       B.BARCOD AS BARCOD,
		       B.WAREKY AS WAREKY,
		       B.SKUKEY AS SKUKEY,
		       B.DESC01 AS DESC01,
		       B.DESC02 AS DESC02,
		       B.PRTDAT AS PRTDAT,
		       B.QTDUOM AS QTDUOM,
		       B.QTYRCV AS QTYRCV,
		       B.QTDBOX AS QTDBOX,
		       B.QTDREM AS QTDREM,
		       B.QTDPRT AS QTDPRT,
		       B.LOTA05 AS LOTA05,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       CU.NMLAST AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       LU.NMLAST AS LUSRNM,
		       B.TASKKY AS TASKKY,
		       B.SHPOKY AS SHPOKY,
		       B.LOTA02 AS LOTA02
		  FROM BARCD B 
		       LEFT OUTER JOIN USRMA CU
		               ON CU.USERID = B.CREUSR
		       LEFT OUTER JOIN USRMA LU
		               ON LU.USERID = B.CREUSR
		 WHERE B.WAREKY = #{WAREKY} 
		 <if test="REFDKY != null and REFDKY != ''">
		 	AND REFDKY = #{REFDKY}
		 </if>
		 <if test="BARCOD != null and BARCOD != ''">
		 	AND BARCOD = #{BARCOD}
		 </if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	</select>
	
	<select id="BARCODREFDKY_OBJECT" parameterType="Map" resultType="Integer">
		SELECT SEQ_IMF_BARCD.NEXTVAL FROM DUAL
	</select>
	
	<insert id="BARCOD_INSERT" parameterType="Map">
		<selectKey keyProperty="BARCOD" resultType="String">
          SELECT 'VP'||SUBSTR(TO_CHAR(SYSDATE,'YYYYMMDD'),3,7)||LPAD(SEQ_IMF_VP_BARCODE.NEXTVAL,7,0) FROM DUAL 
       </selectKey>
	      INSERT INTO BARCD
	           (
	        	REFDKY
	           ,BARCOD
	           ,WAREKY
	           ,SKUKEY
	           ,DESC01
	           ,DESC02
	           ,PRTDAT
	           ,QTDUOM
	           ,QTYRCV
	           ,QTDBOX
	           ,QTDREM
	           ,QTDPRT
	           ,CREDAT
	           ,CRETIM
	           ,CREUSR
	           ,LMODAT
	           ,LMOTIM
	           ,LMOUSR
	           ,LOTA05
	           ,LOTA02
	           ,RECVKY
               ,SHPOKY
               ,TASKKY
               ,SADJKY
               ,UPDCHK
	     	 )
	        VALUES
	           (
	           #{REFDKY}
	           ,#{BARCOD}
	           ,#{WAREKY}
	           ,#{SKUKEY} 
	           ,#{DESC01}
	           ,NVL(#{DESC02}, ' ')
	           ,TO_CHAR(SYSDATE,'YYYYMMDD')
	           ,#{QTDUOM}
	           ,#{QTSHPO}
	           ,1
	           ,0
	           ,1
	           ,TO_CHAR(SYSDATE,'YYYYMMDD')
	           ,TO_CHAR(SYSDATE,'HH24MISS')
	           ,#{SES_USER_ID}
	           ,TO_CHAR(SYSDATE,'YYYYMMDD')
	           ,TO_CHAR(SYSDATE,'HH24MISS')
	           ,#{SES_USER_ID}
	           ,' '
	           ,' '
	           ,' '
	           ,#{SHPOKY}
	           ,#{TASKKY}
	           ,' '
	           ,0
	      )
	</insert>

	<select id="DL04_LIST" parameterType="Map" resultType="DataMap">
		SELECT   /*+  use_nl(SHPDH  ct vd )  */ 
				 MAX(SI.SVBELN) AS SVBELN
			    ,SH.SHPOKY AS SHPOKY
			    ,SH.QTSHPO AS QTSHPO			    
			    ,SH.QTSHPD AS QTSHPD
			    ,SH.WAREKY
			    ,WH.NAME01 AS WAREKYNM
			    ,SH.STATDO
			    ,ST.CDESC1 AS STATDONM
			  --,' 'ALSTKY
			    ,NVL(DECODE(SH.SHPMTY, '231', SH.PTRCVR, SH.DPTNKY), ' ') AS DPTNKY              
			    ,NVL(DECODE(SH.SHPMTY, '231', VD.NAME01, CT.NAME01), ' ') AS DPTNKYNM										
			    ,NVL(CT.TELN01, '') AS TELNO1			    
			  --,(SELECT NAME01 FROM BZPTN BZ WHERE PTNRTY = 'CT' AND BZ.PTNRKY = SH.DPTNKY AND BZ.OWNRKY = SH.OWNRKY AND ROWNUM = 1) AS DPTNKYNM
			    ,SH.PTRCVR
			    ,(SELECT NAME01 FROM BZPTN BZ WHERE PTNRTY = 'CT' AND BZ.PTNRKY = SH.PTRCVR AND BZ.OWNRKY = SH.OWNRKY AND ROWNUM = 1) AS PTRCVRNM
			    ,SH.VEHINO
			    ,SH.CARNO
			    ,SH.DRIVER
			    ,SH.DRIVERCEL
			    ,SH.PGRC01
			    ,SH.PGRC02
			    ,SH.PGRC03
			    ,SH.PGRC04
			    ,SH.PGRC05
			    ,' ' AS PTNBLK
			    ,SH.OWNRKY
			    ,(SELECT NAME01 FROM OWNER WHERE OWNER.OWNRKY = SH.OWNRKY) AS OWNRKYNM 
			    ,SH.DOCDAT
			    ,SH.DOCCAT
			    ,DC.SHORTX AS DOCCATNM
			    ,SH.SHPMTY
			    , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.SHPMTY) AS SHPMTYNM
			    ,SH.DOCUTY
			    , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.DOCUTY) AS DOCUTYNM
			    ,SH.RQSHPD
			    ,SH.RQARRD
			    ,SH.RQARRT
			    ,SH.OPURKY
			    ,SH.DOCTXT
			    ,SH.CREDAT
			    ,SH.CRETIM
			    ,SH.CREUSR
			    ,(SELECT NMLAST FROM USRMA WHERE USERID = 'DEV' AND ROWNUM =1 ) AS CUSRNM
			    ,SH.LMODAT
			    ,SH.LMOTIM
			    ,SH.LMOUSR
			    ,(SELECT NMLAST FROM USRMA WHERE USERID = 'DEV' AND ROWNUM =1 ) AS LUSRNM
			    ,SH.USRID1
			    ,SH.UNAME1
			    ,SH.DEPTID1
			    ,SH.DNAME1
			    ,SH.USRID2
			    ,SH.UNAME2
			    ,SH.DEPTID2
			    ,SH.USRID3
			    ,SH.UNAME3
			    ,SH.DEPTID3
			    ,SH.USRID4
			    ,SH.UNAME4
			    ,SH.DEPTID4
			    ,DT.DOCGRP AS DOCGRP
			    ,DT.INDCHK AS INDCHK
			    ,SI.STKNUM
			    ,NVL(SI.STKNUM, ' ') AS TOTPICKNUM
			    ,SI.SAPSTS
			    , SI.TLOTA01
			    , NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = SI.TLOTA01 AND PLNTKY = SI.TLOTA02)), ' ') AS TLOTA01NM
		        , SI.TLOTA02
		        , SZF_GET_CMCDV_CDESC1_TEXT(SH.OWNRKY, 'LOTA02', SI.TLOTA02) AS TLOTA02NM
		        , NVL(TRIM(SH.SAP2), ' ') AS SAP2
		        , NVL(TRIM(SH.SIGNI), ' ') AS SIGNI
		        , SH.PRTCHK
		  FROM SHPDH SH
				INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
				LEFT OUTER JOIN DOCCM DC ON DC.DOCCAT = '200'
				LEFT OUTER JOIN DOCTM DT ON DT.DOCCAT = DC.DOCCAT 
										AND DT.DOCUTY = SH.SHPMTY
				LEFT OUTER JOIN CMCDV ST ON ST.CMCDKY = 'STATDO' AND ST.CMCDVL = SH.STATDO
				LEFT OUTER JOIN WAHMA WH ON WH.WAREKY = SH.WAREKY 
				LEFT OUTER JOIN BZPTN CT ON CT.OWNRKY = SH.OWNRKY 
										AND CT.PTNRTY  = 'CT' 
										AND CT.PTNRKY  = SH.DPTNKY
			    LEFT OUTER JOIN BZPTN VD ON VD.OWNRKY = SH.OWNRKY 
										AND VD.PTNRTY  = 'VD' 
										AND VD.PTNRKY  = SH.PTRCVR	
		 WHERE	SH.WAREKY = #{WAREKY}
		   AND  SH.OWNRKY = #{OWNRKY}
		   AND  SI.STATIT NOT IN('FCO')
		<if test="PROGID == &quot;DL04&quot;">	
		   AND   DT.DOCGRP != 'V'
		</if>
		
		<if test="SKUG01 != null and SKUG01 != ''">
            AND SI.SKUG01 = #{SKUG01}
        </if>
         
        <if test="SKUL01 != null and SKUL01 != ''">
            AND SM.SKUL01 = #{SKUL01}
       	</if>
       			
		<if test="RANGE_SQL_1 != null and RANGE_SQL_1 != ''">
		   AND	${RANGE_SQL_1}
		</if>
		
		   AND	SH.STATDO IN ( 'DUMMY'
				<if test="STAT01 == &quot;V&quot;">, 'NEW'</if>
				<if test="STAT02 == &quot;V&quot;">, 'PAL'</if>
				<if test="STAT03 == &quot;V&quot;">, 'FAL'</if>
				<if test="STAT04 == &quot;V&quot;">, 'PPC'</if>
				<if test="STAT05 == &quot;V&quot;">, 'FPC'</if>
				<if test="STAT06 == &quot;V&quot;">, 'PCK'</if>
				<if test="STAT07 == &quot;V&quot;">, 'FCK'</if>
				<if test="STAT08 == &quot;V&quot;">, 'PSH'</if>
				<if test="STAT09 == &quot;V&quot;">, 'FSH'</if>
			  )
		GROUP BY SH.SHPOKY,  SH.QTSHPO,  SH.QTSHPD,  SH.WAREKY,  WH.NAME01,
		         SH.STATDO,  ST.CDESC1,  SH.DPTNKY,  SH.PTRCVR,  SH.VEHINO,
		         SH.DRIVER,  SH.PGRC01,  SH.PGRC02,  SH.PGRC03,  SH.PGRC04,
		         SH.PGRC05,  SH.OWNRKY,  SH.DOCDAT,  SH.DOCCAT,  DC.SHORTX,
		         SH.SHPMTY,  SH.DOCUTY,  SH.RQSHPD,  SH.RQARRD,  SH.RQARRT,
		         SH.OPURKY,  SH.DOCTXT,  SH.CREDAT,  SH.CRETIM,  SH.CREUSR,
		         SH.LMODAT,  SH.LMOTIM,  SH.LMOUSR,  SH.USRID1,  SH.UNAME1,
		         SH.DEPTID1, SH.DNAME1,  SH.USRID2,  SH.UNAME2,  SH.DEPTID2,
		         SH.USRID3,  SH.UNAME3,  SH.DEPTID3, SH.USRID4,  SH.UNAME4,
		         SH.DEPTID4, CT.NAME01,  CT.TELN01,  DT.DOCGRP,  DT.INDCHK,
		         SH.CARNO, SH.DRIVERCEL, SI.STKNUM,	 SI.SAPSTS, 
		         SI.TLOTA01, SI.TLOTA02 , VD.NAME01, SH.SAP2, SH.SIGNI, SH.PRTCHK
		ORDER BY SHPOKY DESC	
	</select>
	
	<select id="DL04Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT	  I.SHPOKY AS SHPOKY
				, I.SHPOIT AS SHPOIT
				, I.SMANDT AS SMANDT
				, I.SVBELN AS SVBELN
				, I.SPOSNR AS SPOSNR
				, H.SHPMTY AS SHPMTY
				, I.STATIT AS STATIT
				, NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = I.STATIT),' ') AS STATNM
				, I.ALSTKY AS ALSTKY
				, H.WAREKY AS WAREKY
				, H.OWNRKY AS OWNRKY
				, I.STKNUM AS STKNUM
				, I.QTYORG AS QTYORG
				, I.QTSHPO AS QTSHPO
				, NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTYORG, I.UOMKEY, I.DUOMKY)),0) AS QTYSHPO
				, (I.QTSHPO-I.QTALOC) AS QTUALO
				, I.QTALOC AS QTALOC
				, I.QTSHPD AS QTSHPD
				, I.QTSHPC AS QTSHPC
				, I.QTJCMP AS QTJCMP
				, I.MEASKY AS MEASKY
				, I.SKUKEY AS SKUKEY
				, I.DESC01 AS DESC01
				, I.DESC02 AS DESC02
				, I.UOMKEY AS UOMKEY
				, I.QTPUOM AS QTPUOM
				, I.DUOMKY AS DUOMKY
				, I.QTDUOM AS QTDUOM
				, I.REFDKY AS REFDKY
				, I.REFDIT AS REFDIT
				, I.REFCAT AS REFCAT
				, I.REFDAT AS REFDAT
				, I.ASKU01 AS ASKU01
				, I.ASKU02 AS ASKU02
				, I.ASKU03 AS ASKU03
				, I.ASKU04 AS ASKU04
				, I.ASKU05 AS ASKU05
				, I.EANCOD AS EANCOD
				, I.GTINCD AS GTINCD
				, I.SKUG01 AS SKUG01
				, I.SKUG02 AS SKUG02
				, I.SKUG03 AS SKUG03
				, I.SKUG04 AS SKUG04
				, I.SKUG05 AS SKUG05
				, I.GRSWGT AS GRSWGT
				, I.NETWGT AS NETWGT
				, I.WGTUNT AS WGTUNT
				, I.LENGTH AS LENGTH
				, I.WIDTHW AS WIDTHW
				, I.HEIGHT AS HEIGHT
				, I.CUBICM AS CUBICM
				, I.CAPACT AS CAPACT
				, I.LOTA01 AS LOTA01
				, NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = I.LOTA01 AND PLNTKY = I.LOTA02 AND WAREKY = H.WAREKY)), ' ') AS LOTA01NM
				, I.LOTA02 AS LOTA02
				, SZF_GET_CMCDV_CDESC1_TEXT(H.OWNRKY, 'LOTA02',I.LOTA02) AS LOTA02NM
				, I.LOTA03 AS LOTA03
				, I.LOTA04 AS LOTA04
				, I.LOTA05 AS LOTA05
				, I.LOTA06 AS LOTA06
				, I.LOTA07 AS LOTA07
				, I.LOTA08 AS LOTA08
				, SZF_GET_CMCDV_CDESC1_TEXT(H.OWNRKY, 'NATNKY',I.LOTA08) AS LOTA08NM
				, I.LOTA09 AS LOTA09
				, NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = H.OWNRKY AND PTNRTY = 'CT' AND PTNRKY= I.LOTA09), ' ') AS LOTA09NM
				, I.LOTA10 AS LOTA10
				, I.LOTA11 AS LOTA11
				, I.LOTA12 AS LOTA12
				, I.LOTA13 AS LOTA13
				, I.LOTA14 AS LOTA14
				, I.LOTA15 AS LOTA15
				, I.LOTA16 AS LOTA16
				, I.LOTA17 AS LOTA17
				, I.LOTA18 AS LOTA18
				, I.LOTA19 AS LOTA19
				, I.LOTA20 AS LOTA20
				, I.ESHPKY AS ESHPKY
				, I.ESHPIT AS ESHPIT
				, I.REFDKY AS GRPOKY
				, I.REFDIT AS GRPOIT
				, I.CHGFLG AS CHGFLG
				, I.NAME01 AS NAME01
				, CASE WHEN I.STATIT='NEW' THEN 'V'
					ELSE ''
					END AS STATUS_NEW
				, CASE WHEN I.STATIT='FAL' OR I.STATIT='PAL' THEN 'V'
					ELSE ''
					END AS STATUS_ALO
				, CASE WHEN I.STATIT='FPC' OR I.STATIT='PPC' THEN 'V'
					ELSE ''
					END AS STATUS_PCK
				, CASE WHEN I.STATIT='FSH' OR I.STATIT='PSH' THEN 'V'
					ELSE ''
					END AS STATUS_SHP								 
				, M.SKUL01 AS SKUL01
				, H.DOCTXT AS DOCTXT							
                , CASE WHEN (I.QTSHPO-I.QTALOC) = I.QTSHPO AND I.STATIT = 'NEW' THEN NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, (I.QTSHPO-I.QTALOC), I.DUOMKY, 'KG')),'0')
                	   ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'KG')),'0') 
                  END AS TOT	   
                , CASE WHEN (I.QTSHPO-I.QTALOC) = I.QTSHPO AND I.STATIT = 'NEW' THEN NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, (I.QTSHPO-I.QTALOC), I.DUOMKY, 'BAG')),'0')
                	   ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'BAG')),'0') 
                  END AS BAG
                , CASE WHEN (I.QTSHPO-I.QTALOC) = I.QTSHPO AND I.STATIT = 'NEW' THEN NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, (I.QTSHPO-I.QTALOC), I.DUOMKY, 'BOX')),'0')
                	   ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'BOX')),'0') 
                  END AS BOX
                , CASE WHEN (I.QTSHPO-I.QTALOC) = I.QTSHPO AND I.STATIT = 'NEW' THEN NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, (I.QTSHPO-I.QTALOC), I.DUOMKY, 'PAL')),'0')
                	   ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'PAL')),'0') 
                  END AS PLT
                , CASE WHEN (I.QTSHPO-I.QTALOC) = I.QTSHPO AND I.STATIT = 'NEW' THEN NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, (I.QTSHPO-I.QTALOC), I.DUOMKY, 'SOK')),'0')
                	   ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'SOK')),'0') 
                  END AS SOK
                , CASE WHEN (I.QTSHPO-I.QTALOC) = I.QTSHPO AND I.STATIT = 'NEW' THEN NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, (I.QTSHPO-I.QTALOC), I.DUOMKY, 'EA')),'0')
                	   ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'EA')),'0') 
                  END AS EA 
                , CASE WHEN (I.QTSHPO-I.QTALOC) = 0 THEN 0 
              		   WHEN I.QTALOC = 0 THEN 0 
                	   WHEN (I.QTSHPO-I.QTALOC) = I.QTSHPO AND I.STATIT = 'NEW' THEN NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, (I.QTSHPO-I.QTALOC), I.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, (I.QTSHPO-I.QTALOC), I.DUOMKY, 'BOX')),'0')
                	   ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'BOX')),'0') 
               	   END AS BOXBAG
                , I.CREDAT AS CREDAT
		        , I.CRETIM AS CRETIM
		        , I.CREUSR AS CREUSR
		        , (SELECT NMLAST FROM USRMA WHERE USERID = I.CREUSR) AS CUSRNM
		        , I.LMODAT AS LMODAT
		        , I.LMOTIM AS LMOTIM
		        , I.LMOUSR AS LMOUSR
		        , (SELECT NMLAST FROM USRMA WHERE USERID = I.LMOUSR) AS LUSRNM
		        , NVL(TRIM(I.APPOINTPICKING), ' ') AS APPOINTPICKING 
		FROM SHPDI I
			INNER JOIN SHPDH H 
					ON H.SHPOKY = I.SHPOKY
			INNER JOIN SKUMA M
                    ON I.SKUKEY = M.SKUKEY
                    AND H.OWNRKY = M.OWNRKY
		WHERE I.SHPOKY = #{SHPOKY}
		AND (SUBSTR(I.SHPOIT, 0, 1) != 1)
	</select>
	
	<select id="DL04POP_LIST" parameterType="Map" resultType="DataMap">
		SELECT      A.STKNUM
          , A.ORDCNT
          , A.SKUCNT          
          , A.CREDAT
          , A.CRETIM
          , A.CREUSR
          , A.CUSRNM
          , (SELECT CDESC1         
                FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = 
           CASE 
           		WHEN A.STATDO LIKE '%NEW%'                 
                    THEN 'NEW'
           		WHEN A.STATDO LIKE '%PPC%' AND A.STATDO LIKE '%FPC%' 
                    THEN 'PPC'
                WHEN A.STATDO LIKE '%PPC%'
                    THEN 'PPC'
                WHEN A.STATDO LIKE '%FPC%'
                    THEN 'FPC'
           		WHEN A.STATDO LIKE '%PSH%' AND A.STATDO LIKE '%FSH%' 
                    THEN 'PSH'                            
                WHEN A.STATDO LIKE '%PSH%' 
                    THEN 'PSH'
                WHEN A.STATDO LIKE '%FSH%' 
                    THEN 'FSH'
           		WHEN A.STATDO LIKE '%PAL%' AND A.STATDO LIKE '%FAL%' 
                    THEN 'PAL'
                WHEN A.STATDO LIKE '%PAL%' 
                    THEN 'PAL'
                WHEN A.STATDO LIKE '%FAL%' 
                    THEN 'FAL'       
                ELSE A.STATDO    
            END) AS STATNM
         ,    CASE 
           		WHEN A.STATDO LIKE '%NEW%'                 
                    THEN 'NEW'
           		WHEN A.STATDO LIKE '%PPC%' AND A.STATDO LIKE '%FPC%' 
                    THEN 'PPC'
                WHEN A.STATDO LIKE '%PPC%'
                    THEN 'PPC'
                WHEN A.STATDO LIKE '%FPC%'
                    THEN 'FPC'
           		WHEN A.STATDO LIKE '%PSH%' AND A.STATDO LIKE '%FSH%' 
                    THEN 'PSH'                            
                WHEN A.STATDO LIKE '%PSH%' 
                    THEN 'PSH'
                WHEN A.STATDO LIKE '%FSH%' 
                    THEN 'FSH'
           		WHEN A.STATDO LIKE '%PAL%' AND A.STATDO LIKE '%FAL%' 
                    THEN 'PAL'
                WHEN A.STATDO LIKE '%PAL%' 
                    THEN 'PAL'
                WHEN A.STATDO LIKE '%FAL%' 
                    THEN 'FAL'       
                ELSE A.STATDO
            END AS STATDO   
          
    FROM(
            SELECT      TP.STKNUM                                            
                      , COUNT(DISTINCT SI.SHPOKY) OVER(PARTITION BY TP.STKNUM) AS ORDCNT
					  , COUNT(DISTINCT SI.SKUKEY) OVER(PARTITION BY TP.STKNUM) AS SKUCNT                      , TP.CREDAT
                      , TP.CRETIM
                      , TP.CREUSR
                      , (SELECT NMLAST FROM USRMA WHERE USERID =TP.CREUSR) AS CUSRNM  
                      , LISTAGG(SH.STATDO,',') WITHIN GROUP (ORDER BY NULL) OVER (PARTITION BY  TP.STKNUM) AS STATDO
             FROM  TASTP TP                        
                        INNER JOIN SHPDH SH
                        ON TP.SHPOKY = SH.SHPOKY
                        INNER JOIN SHPDI SI
                        ON SI.SHPOKY = TP.SHPOKY
             WHERE 1=1           
             	  AND SH.WAREKY = #{WAREKY}
              <if test="SHPOKY != null and SHPOKY != ''">
				  AND TP.SHPOKY IN (${SHPOKY})
			  </if>
			  
			  <if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			  </if>
			                                  
            ) A
    
    	        
    GROUP BY    A.STKNUM
              , A.ORDCNT
              , A.SKUCNT
              , A.STATDO
              , A.CREDAT
              , A.CRETIM
              , A.CREUSR
              , A.CUSRNM
              , A.STATDO
                
     ORDER BY STKNUM ASC
	</select>
	
	<select id="DL04H_LIST" parameterType="Map" resultType="DataMap">
		SELECT MAX(SI.SVBELN) AS SVBELN
			    ,SH.SHPOKY AS SHPOKY
			    ,SH.QTSHPO AS QTSHPO
			    ,SH.QTSHPD AS QTSHPD
			    ,SH.WAREKY
			    ,WH.NAME01 AS WAREKYNM
			    ,SH.STATDO
			    ,ST.CDESC1 AS STATDONM
			  --,' 'ALSTKY
			    , NVL(DECODE(SH.SHPMTY, '231', SH.PTRCVR, SH.DPTNKY), ' ') AS DPTNKY              
			    , NVL(DECODE(SH.SHPMTY, '231', VD.NAME01, CT.NAME01), ' ') AS DPTNKYNM
			    , SH.PTRCVR AS PTRCVR
			    , NVL(CT.TELN01, '') AS TELNO1			    
			  --,(SELECT NAME01 FROM BZPTN BZ WHERE PTNRTY = 'CT' AND BZ.PTNRKY = SH.DPTNKY AND BZ.OWNRKY = SH.OWNRKY AND ROWNUM = 1) AS DPTNKYNM
			    ,SH.PTRCVR
			    ,(SELECT NAME01 FROM BZPTN BZ WHERE PTNRTY = 'CT' AND BZ.PTNRKY = SH.PTRCVR AND BZ.OWNRKY = SH.OWNRKY AND ROWNUM = 1) AS PTRCVRNM
			    ,SH.VEHINO
			    ,SH.CARNO
			    ,SH.DRIVER
			    ,SH.DRIVERCEL
			    ,SH.PGRC01
			    ,SH.PGRC02
			    ,SH.PGRC03
			    ,SH.PGRC04
			    ,SH.PGRC05
			    ,' ' AS PTNBLK
			    ,SH.OWNRKY
			    ,(SELECT NAME01 FROM OWNER WHERE OWNER.OWNRKY = SH.OWNRKY) AS OWNRKYNM 
			    ,SH.DOCDAT
			    ,SH.DOCCAT
			    ,DC.SHORTX AS DOCCATNM
			    ,SH.SHPMTY
			    , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.SHPMTY) AS SHPMTYNM
			    ,SH.DOCUTY
			    , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.DOCUTY) AS DOCUTYNM
			    ,SH.RQSHPD
			    ,SH.RQARRD
			    ,SH.RQARRT
			    ,SH.OPURKY
			    ,SH.DOCTXT
			    ,SH.CREDAT
			    ,SH.CRETIM
			    ,SH.CREUSR
			    ,(SELECT NMLAST FROM USRMA WHERE USERID = 'DEV' AND ROWNUM =1 ) AS CUSRNM
			    ,SH.LMODAT
			    ,SH.LMOTIM
			    ,SH.LMOUSR
			    ,(SELECT NMLAST FROM USRMA WHERE USERID = 'DEV' AND ROWNUM =1 ) AS LUSRNM
			    ,SH.USRID1
			    ,SH.UNAME1
			    ,SH.DEPTID1
			    ,SH.DNAME1
			    ,SH.USRID2
			    ,SH.UNAME2
			    ,SH.DEPTID2
			    ,SH.USRID3
			    ,SH.UNAME3
			    ,SH.DEPTID3
			    ,SH.USRID4
			    ,SH.UNAME4
			    ,SH.DEPTID4
			    ,DT.DOCGRP AS DOCGRP
			    ,DT.INDCHK AS INDCHK
			    ,SI.STKNUM
			    , NVL(TP.STKNUM, ' ') AS TOTPICKNUM
			    ,SI.SAPSTS
			    ,SI.TLOTA01
			    ,NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = SI.TLOTA01 AND PLNTKY = SI.TLOTA02 )), ' ') AS TLOTA01NM
		        ,SI.TLOTA02
		        ,SZF_GET_CMCDV_CDESC1_TEXT(SH.OWNRKY, 'LOTA02', SI.TLOTA02) AS TLOTA02NM
			    , NVL(TRIM(SH.SAP2), ' ') AS SAP2
		        , NVL(TRIM(SH.SIGNI), ' ') AS SIGNI
		  FROM SHPDH SH
				INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
				INNER JOIN SKUMA SM ON SI.SKUKEY = SM.SKUKEY AND SH.OWNRKY = SM.OWNRKY		
				LEFT OUTER JOIN DOCCM DC ON DC.DOCCAT = '200'
				LEFT OUTER JOIN DOCTM DT ON DT.DOCCAT = DC.DOCCAT 
										AND DT.DOCUTY = SH.SHPMTY
				LEFT OUTER JOIN CMCDV ST ON ST.CMCDKY = 'STATDO' AND ST.CMCDVL = SH.STATDO
				LEFT OUTER JOIN WAHMA WH ON WH.WAREKY = SH.WAREKY 
				LEFT OUTER JOIN BZPTN CT ON CT.OWNRKY = SH.OWNRKY 
										AND CT.PTNRTY  = 'CT' 
										AND CT.PTNRKY  = SH.DPTNKY
			   LEFT OUTER JOIN BZPTN VD ON VD.OWNRKY = SH.OWNRKY 
										AND VD.PTNRTY  = 'VD' 
										AND VD.PTNRKY  = SH.PTRCVR											
				LEFT OUTER JOIN TASTP TP
                               ON  TP.SHPOKY =  SH.SHPOKY
                               AND TP.OWNRKY = SH.OWNRKY   
                               AND TP.WAREKY = SH.WAREKY
		 WHERE	SH.WAREKY = #{WAREKY}
		   AND  SH.OWNRKY = #{OWNRKY}
		   AND  SI.STATIT NOT IN('FCO')
		<if test="SHPOKY != null and SHPOKY != ''">
		   AND SH.SHPOKY IN (${SHPOKY})
		</if>
		
		<if test="PROGID == &quot;DL04&quot;">	
		   AND   DT.DOCGRP != 'V'
		</if>
		
		<if test="SKUG01 != null and SKUG01 != ''">
            AND SM.SKUG01 = #{SKUG01}
        </if>
         				          
        <if test="SKUL01 != null and SKUL01 != ''">
            AND SM.SKUL01 = #{SKUL01}
       	</if>	
       	
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		
		   AND	SH.STATDO IN ( 'DUMMY'
				<if test="STAT01 == &quot;V&quot;">, 'NEW'</if>
				<if test="STAT02 == &quot;V&quot;">, 'PAL'</if>
				<if test="STAT03 == &quot;V&quot;">, 'FAL'</if>
				<if test="STAT04 == &quot;V&quot;">, 'PPC'</if>
				<if test="STAT05 == &quot;V&quot;">, 'FPC'</if>
				<if test="STAT06 == &quot;V&quot;">, 'PCK'</if>
				<if test="STAT07 == &quot;V&quot;">, 'FCK'</if>
				<if test="STAT08 == &quot;V&quot;">, 'PSH'</if>
				<if test="STAT09 == &quot;V&quot;">, 'FSH'</if>
			  )
		GROUP BY SH.SHPOKY,  SH.QTSHPO,  SH.QTSHPD,  SH.WAREKY,  WH.NAME01,
		         SH.STATDO,  ST.CDESC1,  SH.DPTNKY,  SH.PTRCVR,  SH.VEHINO,
		         SH.DRIVER,  SH.PGRC01,  SH.PGRC02,  SH.PGRC03,  SH.PGRC04,
		         SH.PGRC05,  SH.OWNRKY,  SH.DOCDAT,  SH.DOCCAT,  DC.SHORTX,
		         SH.SHPMTY,  SH.DOCUTY,  SH.RQSHPD,  SH.RQARRD,  SH.RQARRT,
		         SH.OPURKY,  SH.DOCTXT,  SH.CREDAT,  SH.CRETIM,  SH.CREUSR,
		         SH.LMODAT,  SH.LMOTIM,  SH.LMOUSR,  SH.USRID1,  SH.UNAME1,
		         SH.DEPTID1, SH.DNAME1,  SH.USRID2,  SH.UNAME2,  SH.DEPTID2,
		         SH.USRID3,  SH.UNAME3,  SH.DEPTID3, SH.USRID4,  SH.UNAME4,
		         SH.DEPTID4, CT.NAME01,  VD.NAME01,  CT.TELN01,  DT.DOCGRP,
		         DT.INDCHK,  SH.CARNO, SH.DRIVERCEL, SI.STKNUM,  TP.STKNUM, 
		         SI.TLOTA01, SI.TLOTA02,  SI.SAPSTS, SH.PTRCVR, SH.SAP2, SH.SIGNI
		ORDER BY SHPOKY DESC			
	</select>
	
	<select id="DL04I_LIST" parameterType="Map" resultType="DataMap">
		SELECT	  I.SHPOKY AS SHPOKY
				, I.SHPOIT AS SHPOIT
				, I.SMANDT AS SMANDT
				, I.SVBELN AS SVBELN
				, I.SPOSNR AS SPOSNR
				, H.SHPMTY AS SHPMTY
				, I.STATIT AS STATIT
				, NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = I.STATIT),' ') AS STATNM
				, I.ALSTKY AS ALSTKY
				, H.WAREKY AS WAREKY
				, H.OWNRKY AS OWNRKY
				, I.STKNUM AS STKNUM
				, I.QTYORG AS QTYORG
				, I.QTSHPO AS QTSHPO
				, (I.QTSHPO-I.QTALOC) AS QTUALO
				, I.QTALOC AS QTALOC
				, I.QTSHPD AS QTSHPD
				, I.QTSHPC AS QTSHPC
				, I.QTJCMP AS QTJCMP
				, I.MEASKY AS MEASKY
				, I.SKUKEY AS SKUKEY
				, I.DESC01 AS DESC01
				, I.DESC02 AS DESC02
				, I.UOMKEY AS UOMKEY
				, I.QTPUOM AS QTPUOM
				, I.DUOMKY AS DUOMKY
				, I.QTDUOM AS QTDUOM
				, I.REFDKY AS REFDKY
				, I.REFDIT AS REFDIT
				, I.REFCAT AS REFCAT
				, I.REFDAT AS REFDAT
				, I.ASKU01 AS ASKU01
				, I.ASKU02 AS ASKU02
				, I.ASKU03 AS ASKU03
				, I.ASKU04 AS ASKU04
				, I.ASKU05 AS ASKU05
				, I.EANCOD AS EANCOD
				, I.GTINCD AS GTINCD
				, I.SKUG01 AS SKUG01
				, I.SKUG02 AS SKUG02
				, I.SKUG03 AS SKUG03
				, I.SKUG04 AS SKUG04
				, I.SKUG05 AS SKUG05
				, I.GRSWGT AS GRSWGT
				, I.NETWGT AS NETWGT
				, I.WGTUNT AS WGTUNT
				, I.LENGTH AS LENGTH
				, I.WIDTHW AS WIDTHW
				, I.HEIGHT AS HEIGHT
				, I.CUBICM AS CUBICM
				, I.CAPACT AS CAPACT
				, I.LOTA01 AS LOTA01
				, NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = I.LOTA01 AND PLNTKY = I.LOTA02 AND WAREKY = H.WAREKY)), ' ') AS LOTA01NM				
				, I.LOTA02 AS LOTA02
				, SZF_GET_CMCDV_CDESC1_TEXT(H.OWNRKY, 'LOTA02',I.LOTA02) AS LOTA02NM				
				, I.LOTA03 AS LOTA03
				, I.LOTA04 AS LOTA04
				, I.LOTA05 AS LOTA05
				, I.LOTA06 AS LOTA06
				, I.LOTA07 AS LOTA07
				, I.LOTA08 AS LOTA08
				, SZF_GET_CMCDV_CDESC1_TEXT(H.OWNRKY, 'NATNKY',I.LOTA08) AS LOTA08NM								
				, I.LOTA09 AS LOTA09
				, NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = H.OWNRKY AND PTNRTY = 'CT' AND PTNRKY= I.LOTA09), ' ') AS LOTA09NM
				, I.LOTA10 AS LOTA10
				, I.LOTA11 AS LOTA11
				, I.LOTA12 AS LOTA12
				, I.LOTA13 AS LOTA13
				, I.LOTA14 AS LOTA14
				, I.LOTA15 AS LOTA15
				, I.LOTA16 AS LOTA16
				, I.LOTA17 AS LOTA17
				, I.LOTA18 AS LOTA18
				, I.LOTA19 AS LOTA19
				, I.LOTA20 AS LOTA20
				, I.ESHPKY AS ESHPKY
				, I.ESHPIT AS ESHPIT
				, I.REFDKY AS GRPOKY
				, I.REFDIT AS GRPOIT
				, CASE WHEN I.STATIT='NEW' THEN 'V'
					ELSE ''
					END AS STATUS_NEW
				, CASE WHEN I.STATIT='FAL' OR I.STATIT='PAL' THEN 'V'
					ELSE ''
					END AS STATUS_ALO
				, CASE WHEN I.STATIT='FPC' OR I.STATIT='PPC' THEN 'V'
					ELSE ''
					END AS STATUS_PCK
				, CASE WHEN I.STATIT='FSH' OR I.STATIT='PSH' THEN 'V'
					ELSE ''
					END AS STATUS_SHP								 
				, M.SKUL01 AS SKUL01
				, H.DOCTXT AS DOCTXT							
                , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'KG')),'0') AS TOT
                , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'BAG')),'0') AS BAG
                , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'BOX')),'0') AS BOX
                , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'PAL')),'0') AS PLT
                , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'SOK')),'0') AS SOK
                , NVL(TRIM(SZF_GET_CONVERT_QTY(H.WAREKY, I.SKUKEY, I.QTALOC, I.DUOMKY, 'EA')),'0') AS EA
                , I.CREDAT AS CREDAT
		        , I.CRETIM AS CRETIM
		        , I.CREUSR AS CREUSR
		        , (SELECT NMLAST FROM USRMA WHERE USERID = I.CREUSR) AS CUSRNM
		        , I.LMODAT AS LMODAT
		        , I.LMOTIM AS LMOTIM
		        , I.LMOUSR AS LMOUSR
		        , (SELECT NMLAST FROM USRMA WHERE USERID = I.LMOUSR) AS LUSRNM
		FROM SHPDI I
			INNER JOIN SHPDH H 
					ON H.SHPOKY = I.SHPOKY
			INNER JOIN SKUMA M
                    ON I.SKUKEY = M.SKUKEY
                    AND H.OWNRKY = M.OWNRKY
		WHERE I.SHPOKY = #{SHPOKY}
		AND (SUBSTR(I.SHPOIT, 0, 1) != 1)
	</select>
	
	<select id="DL04_LIST_old" parameterType="Map" resultType="DataMap">
		SELECT SH.SHPOKY
		     , SI.SVBELN
		     , SH.WAREKY
		     , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = SH.WAREKY),' ') AS WARENM
		     , SH.OWNRKY
		     , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = SH.OWNRKY),' ') AS OWNRNM
		     , SH.DOCDAT
		     , SH.RQSHPD
		     , SH.INDDCL
		     , SH.PGRC04 AS AREAKY
		     , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = SH.WAREKY AND AREAKY = SH.PGRC04),' ') AS AREANM
		     , SH.PGRC05 AS AREATO
		     , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = SH.PTRCVR AND AREAKY = SH.PGRC05),' ') AS ARETNM
		     , SH.SHPMTY
		     , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.SHPMTY),' ') AS SHPMNM
		     , SH.STATDO
		     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = SH.STATDO),' ') AS STATNM
		     , SH.ALSTKY
		     , SH.PGRC01 AS DLTRRT
		     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'DLTRRT' AND CMCDVL = SH.PGRC01),' ') AS DLTRRTNM
		     , SH.PTRCVR
		     , NVL((CT.NAME01),' ') AS PTRCNM
		     , NVL((CT.PROCHA),'V') AS OBPROTCT
		     , NVL(DECODE(SH.SHPMTY, '231', SH.PTRCVR, SH.DPTNKY), ' ') AS DPTNKY              
		     , NVL(DECODE(SH.SHPMTY, '231', VD.NAME01, CT.NAME01), ' ') AS DPTNKYNM
		     , SH.PTRCVR AS PTRCVR
		     , NVL((PT.PROCHA),'V') AS OBPROTPT
		     , COUNT(*) AS ITMCNT
		     , SH.CREDAT
		     , MAX(SI.SEBELN) AS SEBELN
		     , SH.DOCTXT
		     , SI.LOTA04
		     , DECODE(TRIM(TI.DOORKY),NULL,' ','V') AS DOORKY
		  FROM SHPDH SH
		       INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
		       LEFT OUTER JOIN TASDI TI ON TI.SHPOKY = SH.SHPOKY
		                                  AND TI.SHPOIT  = SI.SHPOIT
		       LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY
		       LEFT OUTER JOIN SKUWC SW ON SW.WAREKY = SH.WAREKY AND SW.OWNRKY = SH.OWNRKY AND SW.SKUKEY = SI.SKUKEY
		       LEFT OUTER JOIN BZPTN CT ON CT.OWNRKY = SH.OWNRKY AND CT.PTNRTY = 'CT' AND CT.PTNRKY  = SH.DPTNKY
		       LEFT OUTER JOIN BZPTN PT ON PT.OWNRKY = SH.OWNRKY AND PT.PTNRTY = 'CT' AND PT.PTNRKY  = SH.DPTNKY
		 WHERE SH.WAREKY = #{WAREKY}
		   <if test="RQSHPD1 != null and RQSHPD1 != ''">
		   	 AND SH.RQSHPD &gt;= #{RQSHPD1} AND SH.RQSHPD &lt;= #{RQSHPD2}
		   </if>
		   AND SH.STATDO IN ('DUMMY'
		                       <if test="STAT01 == &quot;V&quot;">, 'NEW'</if>
		                       <if test="STAT02 == &quot;V&quot;">, 'PAL', 'FAL'</if>
		                       <if test="STAT03 == &quot;V&quot;">, 'PPC', 'FPC'</if>
		                       <if test="STAT04 == &quot;V&quot;">, 'PSH', 'FSH'</if>
		                       <if test="STAT05 == &quot;V&quot;">, 'CLS'</if>
		                    )
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">
		   	${RANGE_SQL}
		   </if>
		 GROUP BY SH.SHPOKY
		     , SI.SVBELN
		     , SH.WAREKY
		     , SH.OWNRKY
		     , SH.DOCDAT
		     , SH.RQSHPD
		     , SH.INDDCL
		     , SH.PGRC04
		     , SH.PGRC05
		     , SH.SHPMTY
		     , SH.STATDO
		     , SH.ALSTKY
		     , SH.PGRC01
		     , SH.PTRCVR
		     , NVL((CT.NAME01),' ')
		     , NVL((CT.PROCHA),'V')
		     , SH.DPTNKY
		     , NVL((PT.NAME01),' ')
		     , NVL((PT.PROCHA),'V')
		     , SH.CREDAT
		     , SI.SEBELN
		     , SH.DOCTXT
		     , SI.LOTA04
		     , TI.DOORKY
	     ORDER BY SH.SHPOKY DESC 	     
	</select>

	<select id="DL04Sub_LIST_old" parameterType="Map" resultType="DataMap">
		SELECT SH.SHPOKY
		     , SI.SHPOIT
		     , SI.SVBELN
		     , SI.SPOSNR
		     , SI.STATIT
		     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = SI.STATIT),' ') AS STATNM
		     , SI.ALSTKY
		     , SI.SKUKEY
		     , NVL(SM.DESC01, 'None existent SKU') AS DESC01
		     , NVL(SM.DESC02, 'None existent SKU') AS DESC02
		     , NVL(SW.OBPROT,'V') AS OBPROT
		     , SI.QTYORG
		     , SI.QTSHPO
		     , SI.QTALOC
		     , SI.QTSHPO - SI.QTALOC AS QTUALO
		     , SI.QTSHPO - SI.QTJCMP AS QTABLE
		     , SI.QTJCMP
		     , SI.QTSHPD
		     , SI.UOMKEY
		     , SI.MEASKY
		     , NVL(TRIM(SI.LOTA13),'10000101') AS LOTA13
		     , SI.SEBELN
		     , SI.LOTA02
		     , SI.LOTA04
		     , SI.LOTA05
		     , SI.NAME01
		  FROM SHPDH SH
		       INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
		       LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY
		       LEFT OUTER JOIN SKUWC SW ON SW.WAREKY = SH.WAREKY AND SW.OWNRKY = SH.OWNRKY AND SW.SKUKEY = SI.SKUKEY
		       LEFT OUTER JOIN BZPTN CT ON CT.OWNRKY = SH.OWNRKY AND CT.PTNRTY = 'CT' AND CT.PTNRKY = SH.DPTNKY
		       LEFT OUTER JOIN BZPTN PT ON PT.OWNRKY = SH.OWNRKY AND PT.PTNRTY = 'CT' AND PT.PTNRKY = SH.DPTNKY
		 WHERE SH.WAREKY = #{WAREKY} 
		   AND SH.RQSHPD = #{RQSHPD}
		   <!-- AND SH.PGRC04 = #{AREAKY} -->
<!-- 		   AND SH.PGRC01 IN ('DUMMY', 'DLV', 'TRN', 'RTN') -->
		   AND SH.SHPOKY = #{SHPOKY}
	</select>
	
	<update id="DL04_UPDATE" parameterType="Map">
		UPDATE SHPDH SET 
			DOCDAT = #{DOCDAT} 
 		WHERE 
			SHPOKY = #{SHPOKY}
	</update>
	
	<update id="DL04Sub_UPDATE" parameterType="Map">
		UPDATE SHPDI SET 
	 		ALSTKY = #{ALSTKY} 
		WHERE 
			SHPOKY = #{SHPOKY} 
		AND SHPOIT = #{SHPOIT} 
	</update>
	
	
	<update id="DL04HEAD_UPDATE" parameterType="Map">
		UPDATE SHPDI
		   SET STKNUM = #{STKNUM}
		 WHERE SHPOKY = #{SHPOKY} 
	</update>
	
	<select id="DL06PROC_MAP" parameterType="Map" resultType="DataMap">
		{ call  P_PKLIST_BCD( #{STKNUM}, #{PRTSEQ}, #{PRTTYP}) }
	</select>
	
	<select id="SEQPRTSEQ_OBJECT" parameterType="Map" resultType="Integer">
		SELECT SEQ_PRTSEQ.NEXTVAL FROM DUAL
	</select>
	
	<select id="SEQSTKNUM_OBJECT" parameterType="Map" resultType="Integer">
		SELECT SEQ_STKNUM.NEXTVAL FROM DUAL
	</select>
	
	<select id="SHPDPROCALL_MAP" parameterType="Map" resultType="DataMap">
		{ call P_TASK_COMPLETE_BY_SHPD(#{SHPOKY}, #{SES_USER_ID}) }
	</select>
	
	<resultMap id="DL082_ALLOC_PROCALL_RESULT" type="hashmap"></resultMap>
	<select id="ALLOC_PROCALL_MAP" parameterType="Map" statementType="CALLABLE">
		{ call SZP_BATCH_ALLOCATION(#{SHPOKY}, #{SES_USER_ID}, #{result, mode=OUT, jdbcType=VARCHAR, javaType=String, resultMap=DL082_ALLOC_PROCALL_RESULT}) }
	</select>
	
	<resultMap id="DL082_CALL_ALLO_RESULT" type="hashmap"></resultMap>
	<select id="DL08_CALL_ALLO_MAP" parameterType="Map" statementType="CALLABLE">
		{ call SZP_CALL_ALLOCATION(#{SHPOKY}, #{SES_USER_ID}, #{result, mode=OUT, jdbcType=VARCHAR, javaType=String, resultMap=DL082_CALL_ALLO_RESULT}) }
	</select>
	
