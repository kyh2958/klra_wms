			 , B.LENGTH AS LENGTH
			 , B.WIDTHW AS WIDTHW
			 , B.HEIGHT AS HEIGHT
			 , B.CUBICM AS CUBICM
			 , B.CAPACT AS CAPACT
			 , B.WORKID AS WORKID
