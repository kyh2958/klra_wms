		       B.SMJAHR AS SMJAHR,
		       B.SXBLNR AS SXBLNR,
		       B.SAPSTS AS SAPSTS,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       C.AUTLOC AS AUTLOC,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK
		  FROM TASDH A,
		       TASDI B,
		       LOCMA C
		 WHERE A.TASKKY = B.TASKKY
		   AND A.WAREKY = C.WAREKY
		   AND B.LOCASR = C.LOCAKY
		   AND A.TASKKY = #{TASKKY}
		   AND B.STATIT = 'NEW'
		 ORDER BY B.TASKKY, B.TASKIT
	</select>	

	<select id="MV01LOCATION_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT *
		 FROM (
		        SELECT CASE WHEN (SELECT AREAKY FROM LOCMA WHERE WAREKY = STD.WAREKY AND LOCAKY = STD.LOCAKY) != (SELECT AREAKY FROM LOCMA WHERE WAREKY = STD.WAREKY AND LOCAKY = STD.LOCATG)
		                         THEN 'TASK_M0061†' || STD.SKUKEY ||'/' || STD.DESC01 || '/' || STD.LOCAKY || '/' || STD.LOCATG
		                    ELSE 'OK'
		                 END AS MSG
		        FROM ( ${APPEND_QUERY} ) STD
		      )
		WHERE MSG != 'OK'
	</select>
	
	<select id="PT02PROCALL_MAP" parameterType="Map" resultType="DataMap">
		 { call P_TASK_COMPLETE_BY_PT( #{TASKKY}, #{TASKIT}, #{QTCOMP}, #{LOCAAC}, #{TRNUAC}, #{SES_USER_ID} )}
	</select>
	
	<select id="TK31PROCALL_MAP" parameterType="Map" resultType="DataMap">
		 { call P_TASK_PROCESS(#{TASKKY}, #{SES_USER_ID})}
	</select>
	
	<select id="TK32REHEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT	 TH.TASKKY AS TASKKY
				,TH.WAREKY AS WAREKY
				,NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY),' ') AS WARENM
				,TH.WARETG AS WARETG
				,TH.DOCDAT AS DOCDAT
				,TH.TASOTY AS TASOTY
				,NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = TH.TASOTY),' ') AS DOCTNM
				,TH.STATDO AS STATDO
				,NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = TH.STATDO),' ') AS STATNM
				,TH.DOCTXT AS DOCTXT
				,TH.PTNRKY AS PTNRKY
                ,TH.PTNRNM AS PTNRNM
		  FROM	TASDI TI
            		INNER JOIN TASDH TH ON TI.TASKKY = TH.TASKKY
         WHERE 	TH.TASKKY = #{TASKKY}
	</select>
	
