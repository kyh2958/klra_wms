					NVL(#{DNAME2}, ' '),
					NVL(#{USRID3}, ' '),
					NVL(#{UNAME3}, ' '),
					NVL(#{DEPTID3}, ' '),
					NVL(#{DNAME3}, ' '),
					NVL(#{USRID4}, ' '),
					NVL(#{UNAME4}, ' '),
					NVL(#{DEPTID4}, ' '),
					NVL(#{DNAME4}, ' '),
					NVL(#{DOCTXT}, ' '),
					TO_CHAR(SYSDATE, 'YYYYMMDD'),
					TO_CHAR(SYSDATE, 'HH24MISS'),
					#{SES_USER_ID},
					TO_CHAR(SYSDATE, 'YYYYMMDD'),
					TO_CHAR(SYSDATE, 'HH24MISS'),
					#{SES_USER_ID},
					NVL(#{INDBZL}, ' '),
					NVL(#{INDARC}, ' '),
					TO_NUMBER(NVL(TRIM(#{UPDCHK}), 0)),
					NVL(#{KEEPTS}, ' ')
				)
	</insert>
	
