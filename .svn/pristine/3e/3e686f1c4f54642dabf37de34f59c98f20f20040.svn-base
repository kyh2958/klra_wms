<?xml version="1.0" encoding="UTF-8"?><!--Converted at: Wed Feb 23 09:49:03 KST 2022-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="WmsTask">
	
	<select id="STKKYHEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT
			'' AS TASKKY,
			#{SES_WAREKY} AS WAREKY,
			(SELECT NAME01 FROM WAHMA WHERE WAREKY = #{SES_WAREKY}) AS WARENM,
			<if test="AREA != null and AREA != ''">
			#{AREA} AS AREAKY,
			(SELECT SHORTX FROM AREMA WHERE WAREKY = #{SES_WAREKY} AND AREAKY =  #{AREA}) AS AREAKYNM,
			</if>
			'310' AS TASOTY,
			(SELECT SHORTX FROM DOCTM WHERE DOCUTY = '310' AND DOCCAT = '300') AS TASOTYNM,
			TO_CHAR(SYSDATE, 'YYYY-MM-DD') AS DOCDAT,
			'300' AS DOCCAT,
			'' AS DRELIN,
			'NEW' AS STATDO,
			'' AS QTTAOR,
			'' AS QTCOMP,
			'' AS TSPKEY,
			'' AS KEEPTS,
			#{SES_WAREKY} AS WARETG,
			'' AS USRID1,
			'' AS UNAME1,
			'' AS DEPTID1,
			'' AS DNAME1,
			'' AS USRID2,
			'' AS UNAME2,
			'' AS DEPTID2,
			'' AS DNAME2,
			'' AS USRID3,
			'' AS UNAME3,
			'' AS DEPTID3,
			'' AS DNAME3,
			'' AS USRID4,
			'' AS UNAME4,
			'' AS DEPTID4,
			'' AS DNAME4,
			'' AS DOCTXT,
			TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT,
			TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM,
			#{SES_USER_ID} AS CREUSR,
			(SELECT NMLAST FROM USRMA WHERE USERID = #{SES_USER_ID}) AS CUSRNM,
			TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT,
			TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM,
			#{SES_USER_ID} AS LMOUSR,
			(SELECT NMLAST FROM USRMA WHERE USERID = #{SES_USER_ID}) AS LUSRNM
		FROM DUAL
	</select>
	
	<select id="STKKY_LIST" parameterType="Map" resultType="DataMap">
		WITH STATIT_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'STATIT'
              AND CD.CMCDVL = 'NEW'
		),
		WM_T AS (
		    SELECT NVL(WM.NAME01,' ') AS WARENM  
		    FROM WAHMA WM
		    WHERE WM.WAREKY = #{WAREKY}
		),
		AREA_T AS (
		    SELECT X.AREAKY
                 , X.SHORTX 
            FROM AREMA X 
            WHERE X.WAREKY = #{WAREKY}
		),
		D_UOMQTY_T AS (
		  	SELECT A.MEASKY
                 , A.D_UOMKEY
			     , ( CASE WHEN A.QTAUOM_KG=0 THEN 0 ELSE (A.QTPUOM_KG / A.QTAUOM_KG) END ) AS DSN_KG
			     , ( CASE WHEN A.QTAUOM_BAG=0 THEN 0 ELSE (A.QTPUOM_BAG / A.QTAUOM_BAG) END ) AS DSN_BAG
			     , ( CASE WHEN A.QTAUOM_BOX=0 THEN 0 ELSE (A.QTPUOM_BOX / A.QTAUOM_BOX) END ) AS DSN_BOX
			     , ( CASE WHEN A.QTAUOM_PAL=0 THEN 0 ELSE (A.QTPUOM_PAL / A.QTAUOM_PAL) END ) AS DSN_PAL
			     , ( CASE WHEN A.QTAUOM_SOK=0 THEN 0 ELSE (A.QTPUOM_SOK / A.QTAUOM_SOK) END ) AS DSN_SOK
			     , ( CASE WHEN A.QTAUOM_EA=0 THEN 0 ELSE (A.QTPUOM_EA / A.QTAUOM_EA) END ) AS DSN_EA
			FROM (
			    SELECT MI.MEASKY
			         , MAX( CASE WHEN MI.INDDFU='V' THEN MI.UOMKEY ELSE ' ' END ) AS D_UOMKEY
			         , SUM( CASE WHEN MI.UOMKEY='KG' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_KG
			         , SUM( CASE WHEN MI.UOMKEY='KG' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_KG
			         , SUM( CASE WHEN MI.UOMKEY='BAG' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_BAG
			         , SUM( CASE WHEN MI.UOMKEY='BAG' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_BAG     
			         , SUM( CASE WHEN MI.UOMKEY='BOX' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_BOX
			         , SUM( CASE WHEN MI.UOMKEY='BOX' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_BOX     
			         , SUM( CASE WHEN MI.UOMKEY='PAL' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_PAL
			         , SUM( CASE WHEN MI.UOMKEY='PAL' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_PAL     
			         , SUM( CASE WHEN MI.UOMKEY='SOK' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_SOK
			         , SUM( CASE WHEN MI.UOMKEY='SOK' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_SOK     
			         , SUM( CASE WHEN MI.UOMKEY='EA' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_EA
			         , SUM( CASE WHEN MI.UOMKEY='EA' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_EA     
			    FROM MEASI MI
			    WHERE MI.WAREKY = #{WAREKY}
			       AND EXISTS (
			                     SELECT 'X'
			                     FROM STKKY A
								    , SKUWC E
								    , SKUMA F
								    , STLMA I
								 WHERE A.WAREKY = #{WAREKY}
								   AND A.OWNRKY = #{OWNRKY}
								   AND A.OWNRKY = E.OWNRKY
								   AND A.SKUKEY = E.SKUKEY
								   AND A.WAREKY = E.WAREKY
								   AND A.OWNRKY = F.OWNRKY
								   AND A.SKUKEY = F.SKUKEY
								   AND A.QTSIWH - A.QTSPMO - A.QTSBLK &gt; 0
								   AND A.AREAKY NOT IN ('SHP','SYS','CRT','RTS')
								   AND A.LOCAKY NOT IN ('SYSSHP')
								   AND A.LOTA06 IN ('00','05')
								   AND A.LOCAKY = 'RCVLOC'
								   AND I.OWNRKY(+) = A.OWNRKY 
								   AND I.PLNTKY(+) = A.LOTA02 
								   AND I.STLKY(+)  = A.LOTA01
								   AND A.SKUKEY = MI.MEASKY
								   <if test="SKUL01 != null and SKUL01 != ''">
								   AND F.SKUL01 = #{SKUL01}
								   </if>
								   <if test="SKUG01 != null and SKUG01 != ''">
								   AND F.SKUG01 = #{SKUG01}
								   </if>
								   <if test="LOTA06 != null and LOTA06 != ''">
									AND A.LOTA06 = #{LOTA06}
									</if>
									<if test="RANGE_SQL != null and RANGE_SQL != ''">
										${RANGE_SQL}
									</if> 
			                  )
			    GROUP BY MI.MEASKY
			) A
		)
		SELECT A.WAREKY
		     , ( SELECT WARENM FROM WM_T ) AS WARENM
	         , A.STOKKY
	         , 'PT' AS TASKTY
	         , 'NEW' AS STATIT
	         , ( SELECT X.CDESC1 FROM STATIT_T X ) AS STATITNM	
	         , (A.QTSIWH - A.QTSPMO - A.QTSBLK) AS AVAILABLEQTY
	         , DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) AS QTSAVLB
<!-- 	         , TO_CHAR((A.QTSIWH - A.QTSPMO - A.QTSBLK), 'FM99999999999999999990.000') AS QTTAOR -->
	         , DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) AS QTTAOR
	         , DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) AS QTYUOM
	         , '0' AS QTCOMP
	         , '' AS LOCAAC
	         , '' AS TRNUAC
	         , '' AS ALSTKY
	         , '00000000' AS ACTCDT
	         , '000000' AS ACTCTI	      
	         , A.LOCAKY AS LOCASR
	         , A.SECTID AS SECTSR
	         , A.PACKID AS PAIDSR
	         , A.TRNUID AS TRNUSR
	         , A.TRUNTY AS STRUTY
	         , E.MEASKY AS SMEAKY
	         , A.UOMKEY AS SUOMKY
	         , A.QTPUOM AS QTSPUM
	         , A.DUOMKY AS SDUOKY
	         , A.QTDUOM AS QTSDUM
	         , '' AS LOCATG
	         , A.SECTID AS SECTTG
	         , A.PACKID AS PAIDTG
	         , A.TRNUID AS TRNUTG
	         , A.TRUNTY AS TTRUTY
	         , E.MEASKY AS TMEAKY
	         , E.UOMDTA AS TUOMKY
	         , A.QTPUOM AS QTTPUM
	         , A.DUOMKY AS TDUOKY
	         , A.QTDUOM AS QTTDUM
	         , A.OWNRKY AS OWNRKY
	         , A.SKUKEY AS SKUKEY
	         , A.LOTNUM AS LOTNUM
	         , A.REFDKY AS REFDKY
	         , A.REFDIT AS REFDIT
	         , A.REFCAT AS REFCAT
	         , A.REFDAT AS REFDAT
	         , A.PURCKY AS PURCKY
	         , A.PURCIT AS PURCIT
	         , A.ASNDKY AS ASNDKY
	         , A.ASNDIT AS ASNDIT
	         , A.RECVKY AS RECVKY
	         , A.RECVIT AS RECVIT
	         , A.SHPOKY AS SHPOKY
	         , A.SHPOIT AS SHPOIT
	         , A.GRPOKY AS GRPOKY
	         , A.GRPOIT AS GRPOIT
	         , A.SADJKY AS SADJKY
	         , A.SADJIT AS SADJIT
	         , A.SDIFKY AS SDIFKY
	         , A.SDIFIT AS SDIFIT
	         , A.PHYIKY AS PHYIKY
	         , A.PHYIIT AS PHYIIT
	         , A.DESC01 AS DESC01
	         , A.DESC02 AS DESC02
	         , A.ASKU01 AS ASKU01
	         , A.ASKU02 AS ASKU02
	         , A.ASKU03 AS ASKU03
	         , A.ASKU04 AS ASKU04
	         , A.ASKU05 AS ASKU05
	         , A.EANCOD AS EANCOD
	         , A.GTINCD AS GTINCD
	         , A.SKUG01 AS SKUG01
	         , A.SKUG02 AS SKUG02
	         , A.SKUG03 AS SKUG03
	         , A.SKUG04 AS SKUG04
	         , A.SKUG05 AS SKUG05
	         , A.GRSWGT AS GRSWGT
	         , A.NETWGT AS NETWGT
	         , A.WGTUNT AS WGTUNT
	         , A.LENGTH AS LENGTH
	         , A.WIDTHW AS WIDTHW
	         , A.HEIGHT AS HEIGHT
	         , A.CUBICM AS CUBICM
	         , A.CAPACT AS CAPACT
	         , A.AREAKY AS AREAKY
	         , NVL((SELECT SHORTX FROM AREA_T X WHERE X.AREAKY =  A.AREAKY),' ') AS AREAKYNM
	         , A.LOTA01 AS LOTA01
	         , I.STLNM AS LOTA01NM
	         , A.LOTA02 AS LOTA02
	         , A.LOTA03 AS LOTA03
	         , A.LOTA04 AS LOTA04
	         , A.LOTA05 AS LOTA05
	         , A.LOTA06 AS LOTA06
	         , A.LOTA07 AS LOTA07
	         , A.LOTA08 AS LOTA08
	         , A.LOTA09 AS LOTA09
	         , A.LOTA10 AS LOTA10
	         , A.LOTA11 AS LOTA11
	         , A.LOTA12 AS LOTA12
	         , A.LOTA13 AS LOTA13
	         , A.LOTA14 AS LOTA14
	         , A.LOTA15 AS LOTA15
	         , A.LOTA16 AS LOTA16
	         , A.LOTA17 AS LOTA17
	         , A.LOTA18 AS LOTA18
	         , A.LOTA19 AS LOTA19
	         , A.LOTA20 AS LOTA20
	         , A.AWMSNO AS AWMSNO
	         , A.SMANDT AS SMANDT
	         , A.SEBELN AS SEBELN
	         , A.SEBELP AS SEBELP
	         , A.SVBELN AS SVBELN
	         , A.SMBLNR AS SMBLNR
	         , A.SMJAHR AS SMJAHR
	         , A.SZEILE AS SZEILE
	         , A.SZMIPNO AS SZMIPNO
	         , A.SPOSNR AS SPOSNR
	         , A.STKNUM AS STKNUM
	         , A.STPNUM AS STPNUM
	         , A.SLGORT AS SLGORT
	         , A.SWERKS AS SWERKS
	         , A.STDLNR AS STDLNR
	         , A.STRAID AS STRAID
	         , A.SSORNU AS SSORNU
	         , A.SSORIT AS SSORIT
	         , A.SXBLNR AS SXBLNR
	         , A.LOTA01 AS PTLT01
	         , A.LOTA02 AS PTLT02
	         , A.LOTA03 AS PTLT03
	         , A.LOTA04 AS PTLT04
	         , A.LOTA05 AS PTLT05
	         , A.LOTA06 AS PTLT06
	         , A.LOTA07 AS PTLT07
	         , A.LOTA08 AS PTLT08
	         , A.LOTA09 AS PTLT09
	         , A.LOTA10 AS PTLT10
	         , A.LOTA11 AS PTLT11
	         , A.LOTA12 AS PTLT12
	         , A.LOTA13 AS PTLT13
	         , A.LOTA14 AS PTLT14
	         , A.LOTA15 AS PTLT15
	         , A.LOTA16 AS PTLT16
	         , A.LOTA17 AS PTLT17
	         , A.LOTA18 AS PTLT18
	         , A.LOTA19 AS PTLT19
	         , A.LOTA20 AS PTLT20
	         , E.PASTKY AS PASTKY
	         , A.SZMBLNO AS SZMBLNO
	         , A.SDATBG AS SDATBG
	         , '' AS TASKIT
	         , '' AS TASKKY
	         , F.SKUL01
	         , A.QTSIWH
	               
<!-- 	         , NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY, 'KG')),'0.000') AS TOT -->
<!-- 		     , NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY, 'BAG')),'0.000') AS BAG -->
<!-- 		     , NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY, 'BOX')),'0.000') AS BOX -->
<!-- 		     , NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY, 'PAL')),'0.000') AS PLT -->
<!-- 		     , NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY, 'SOK')),'0.000') AS SOK -->
<!-- 		     , NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY, 'EA')),'0.000') AS EA -->
		     
		     , TO_CHAR((
 					CASE WHEN A.UOMKEY='KG' 
 					       THEN DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM))
                         WHEN A.UOMKEY!='KG' AND DUMO_T.D_UOMKEY=A.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_KG=0 THEN 0 ELSE (DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) / DUMO_T.DSN_KG) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_KG=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY)),0) / DUMO_T.DSN_KG ) END)
                           
                    END 
			   ), 'FM99999999999999999990.000') AS TOT
			 , TO_CHAR((  
 					CASE WHEN A.UOMKEY='BAG'
 			              THEN DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM))
                         WHEN A.UOMKEY!='BAG' AND DUMO_T.D_UOMKEY=A.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_BAG=0 THEN 0 ELSE (DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) / DUMO_T.DSN_BAG) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_BAG=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY)),0) / DUMO_T.DSN_BAG ) END)
                    END 
			   ), 'FM99999999999999999990.000') AS BAG
			 , TO_CHAR((  
 					CASE WHEN A.UOMKEY='BOX' 
 					       THEN DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM))
                         WHEN A.UOMKEY!='BOX' AND DUMO_T.D_UOMKEY=A.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_BOX=0 THEN 0 ELSE (DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) / DUMO_T.DSN_BOX) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_BOX=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY)),0) / DUMO_T.DSN_BOX ) END)
                    END 
			   ), 'FM99999999999999999990.000') AS BOX
			 , TO_CHAR(( 
 					CASE WHEN A.UOMKEY='PAL' 
 					       THEN DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM))
                         WHEN A.UOMKEY!='PAL' AND DUMO_T.D_UOMKEY=A.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_PAL=0 THEN 0 ELSE (DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) / DUMO_T.DSN_PAL) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_PAL=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY)),0) / DUMO_T.DSN_PAL ) END)
                    END 
			   ), 'FM99999999999999999990.000') AS PLT
             , TO_CHAR((
 					CASE WHEN A.UOMKEY='SOK' 
 					       THEN DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM))
                         WHEN A.UOMKEY!='SOK' AND DUMO_T.D_UOMKEY=A.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_SOK=0 THEN 0 ELSE (DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) / DUMO_T.DSN_SOK) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_SOK=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY)),0) / DUMO_T.DSN_SOK ) END)                           
                    END 
			   ), 'FM99999999999999999990.000') AS SOK
			 , TO_CHAR(( 
 					CASE WHEN A.UOMKEY='EA' 
 					       THEN DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM))
                         WHEN A.UOMKEY!='EA' AND DUMO_T.D_UOMKEY=A.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_EA=0 THEN 0 ELSE (DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)) / DUMO_T.DSN_EA) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_EA=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, A.SKUKEY, DECODE(A.QTPUOM,0,0,((A.QTSIWH - A.QTSPMO - A.QTSBLK) / A.QTPUOM)), A.UOMKEY)),0) / DUMO_T.DSN_EA ) END)
                    END 
			   ), 'FM99999999999999999990.000') AS EA
		   
	 FROM STKKY A
	    , SKUWC E
	    , SKUMA F
	    , STLMA I
	    , D_UOMQTY_T DUMO_T
	 WHERE A.WAREKY = #{WAREKY}
	   AND A.OWNRKY = #{OWNRKY}
	   AND A.OWNRKY = E.OWNRKY
	   AND A.SKUKEY = E.SKUKEY
	   AND A.WAREKY = E.WAREKY
	   AND A.OWNRKY = F.OWNRKY
	   AND A.SKUKEY = F.SKUKEY
	   AND A.QTSIWH - A.QTSPMO - A.QTSBLK &gt; 0
	   AND A.AREAKY NOT IN ('SHP','SYS','CRT','RTS')
	   AND A.LOCAKY NOT IN ('SYSSHP')
	   AND A.LOTA06 IN ('00','05')
	   AND A.LOCAKY = 'RCVLOC'
	   AND F.SKUG01 NOT IN ('ROH1','ROH2')
	   AND I.OWNRKY(+) = A.OWNRKY 
	   AND I.PLNTKY(+) = A.LOTA02 
	   AND I.STLKY(+)  = A.LOTA01
	   AND DUMO_T.MEASKY(+) = A.SKUKEY
	   <if test="SKUL01 != null and SKUL01 != ''">
	   AND F.SKUL01 = #{SKUL01}
	   </if>
	   <if test="SKUG01 != null and SKUG01 != ''">
	   AND F.SKUG01 = #{SKUG01}
	   </if>
	   <if test="LOTA06 != null and LOTA06 != ''">
		AND A.LOTA06 = #{LOTA06}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	ORDER BY A.RECVKY, A.SKUKEY DESC
	</select>
	
	
	<select id="TASDH_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.TASKKY AS TASKKY,
		       A.WAREKY AS WAREKY,
		       A.TASOTY AS TASOTY,
		       A.DOCDAT AS DOCDAT,
		       A.DOCCAT AS DOCCAT,
		       (SELECT SHORTX FROM DOCCM WHERE DOCCAT = A.DOCCAT) AS DOCCATNM,
		       A.DRELIN AS DRELIN,
		       A.STATDO AS STATDO,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATDO' AND X.CMCDVL = A.STATDO) AS STATDONM,
		       (SELECT SHORTX FROM DOCTM WHERE DOCUTY = A.TASOTY) AS ADJDSC,
		       A.QTTAOR AS QTTAOR,
		       A.QTCOMP AS QTCOMP,
		       A.TSPKEY AS TSPKEY,
		       A.DOORKY AS DOORKY,
		       DECODE(A.WARETG, ' ', A.WAREKY, A.WARETG) AS WARETG,
		       A.PTNRKY AS PTNRKY,
		       A.CREDAT AS CREDAT,
		       A.CRETIM AS CRETIM,
		       A.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = A.CREUSR) AS CUSRNM,
		       A.LMODAT AS LMODAT,
		       A.LMOTIM AS LMOTIM,
		       A.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = A.LMOUSR) AS LUSRNM,
		       A.INDBZL AS INDBZL,
		       A.INDARC AS INDARC,
		       A.UPDCHK AS UPDCHK,
		       A.KEEPTS AS KEEPTS,
		       MAX(B.RECVKY) AS RECVKY,
		       MAX(B.SHPOKY) AS SHPOKY,
		       MAX(SHPDH.SHPMTY) AS SHPMTY,
		       MAX(DOCTM.SHORTX) AS SHPMTYNM,
		       MAX(SHPDH.STATDO) AS SHSTATDO,
		       MAX(CMCDV.CDESC1) AS SHSTATDONM,
		       MAX(SHPDH.DPTNKY) AS DPTNKY,
		       MAX(BZPTN.NAME01) AS DPTNKYNM,
		
		       MAX(B.SEBELN) AS SEBELN,
		       MAX(B.SZMBLNO) AS SZMBLNO,
		       MAX(B.SZMIPNO) AS SZMIPNO,
		       MAX(B.STRAID) AS STRAID,
		       MAX(B.SVBELN) AS SVBELN,
		       MAX(B.STKNUM) AS STKNUM,
		       MAX(B.STDLNR) AS STDLNR,
		       MAX(B.SSORNU) AS SSORNU,
		       MAX(B.SMBLNR) AS SMBLNR,
		       MAX(B.SXBLNR) AS SXBLNR,
		       NVL(SUM(DECODE(B.ACTCDT, '00000000', 1, ' ', 1, 0)), 0) AS COMPLETECNT,
		       MAX(B.AREAKY) AS AREAKY,
		       B.LOCATG AS LOCAAC,
               B.TRNUTG AS TRNUAC
		  FROM TASDH A
		       INNER JOIN TASDI B
			       ON A.TASKKY = B.TASKKY
		       LEFT OUTER JOIN SHPDI
			       ON SHPDI.SHPOKY = B.SHPOKY 
			       AND SHPDI.SHPOIT = B.SHPOIT
		       LEFT OUTER JOIN SHPDH 
			       ON SHPDH.SHPOKY = B.SHPOKY
		       LEFT OUTER JOIN DOCTM
			       ON SHPDH.SHPMTY = DOCTM.DOCUTY
		       LEFT OUTER JOIN CMCDV
			       ON SHPDH.STATDO = CMCDV.CMCDVL 
			       AND CMCDKY = 'STATDO'
		       LEFT OUTER JOIN BZPTN
			       ON SHPDH.DPTNKY = BZPTN.PTNRKY
			       AND BZPTN.PTNRTY = 'CT'
			      <!--  AND BZPTN.PTNL05 IN (SELECT ADDR05 FROM WAHMA WHERE WAREKY = A.WAREKY)  -->
		 WHERE A.WAREKY = #{SES_WAREKY}
		  <if test="OPT != null and OPT != ''">
			AND A.QTTAOR &gt; 0
		 </if>
		 <if test="AREA != null and AREA != ''">
		   AND B.AREAKY = #{AREA}
		 </if>
		 <if test="ZONE != null and ZONE != ''">
			AND B.SZMIPNO = #{ZONE}
		 </if>
		 <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		 </if>
		 GROUP BY A.TASKKY, A.WAREKY, A.TASOTY, A.DOCDAT, A.DOCCAT,
			  A.DRELIN, A.STATDO, A.QTTAOR, A.QTCOMP, A.TSPKEY,
			  A.DOORKY, A.PTNRKY, A.CREDAT, A.CRETIM, A.CREUSR, A.LMODAT,
			  A.LMOTIM, A.LMOUSR, A.INDBZL, A.INDARC, A.UPDCHK,
			  A.KEEPTS, A.WARETG, B.LOCATG, B.TRNUTG
		 ORDER BY A.DOCDAT DESC
	</select>
	
	<select id="TASDI_LIST" parameterType="Map" resultType="DataMap">
		SELECT TRIM(#{RNUM})||B.TASKIT AS ROWSEQUENCE,
		       (CASE
		          WHEN D.ROWCK IS NULL THEN ' '
		          ELSE D.ROWCK END) AS ROWCK,
		       A.WAREKY AS WAREKY,
		       B.TASKKY AS TASKKY,
		       B.TASKIT AS TASKIT,
		       B.TASKTY AS TASKTY,
		       D.RSNCOD AS RSNCOD,
		       D.TASRSN AS TASRSN,
		       B.STATIT AS STATIT,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = B.STATIT) AS STATITNM,
		       B.QTTAOR AS QTTAOR,
		<if test="QTY_COPY == null or QTY_COPY == ''">
		       B.QTTAOR AS QTCOMP,
		</if>
		<if test="QTY_COPY == &quot;N&quot;">
		       (CASE
		          WHEN D.QTCOMP IS NULL AND B.ACTCDT = '00000000' THEN B.QTCOMP
		          WHEN D.QTCOMP IS NULL THEN B.QTCOMP
		          WHEN B.QTCOMP = D.QTCOMP THEN TO_NUMBER(D.QTCOMP) 
		          ELSE TO_NUMBER(B.QTCOMP)  END) AS QTCOMP,
		</if>
		<if test="QTY_COPY == &quot;Y&quot;">
		       (CASE
		          WHEN D.QTCOMP IS NULL AND B.ACTCDT = '00000000' THEN B.QTTAOR
		          WHEN D.QTCOMP IS NULL THEN B.QTCOMP
		          WHEN B.QTCOMP = D.QTCOMP THEN TO_NUMBER(D.QTCOMP) 
		          ELSE TO_NUMBER(D.QTCOMP)  END) AS QTCOMP,
		</if>
		       B.OWNRKY AS OWNRKY,
		       B.SKUKEY AS SKUKEY,
		       B.LOTNUM AS LOTNUM,
		       B.ACTCDT AS ACTCDT,
		       B.ACTCTI AS ACTCTI,
		       B.QTYUOM AS QTYUOM,
		       B.TKFLKY AS TKFLKY,
		       B.STEPNO AS STEPNO,
		       B.LSTTFL AS LSTTFL,
		       B.LOCASR AS LOCASR,
		       B.SECTSR AS SECTSR,
		       B.PAIDSR AS PAIDSR,
		       B.TRNUSR AS TRNUSR,
		       B.STRUTY AS STRUTY,
		       B.SMEAKY AS SMEAKY,
		       B.SUOMKY AS SUOMKY,
		       B.QTSPUM AS QTSPUM,
		       B.SDUOKY AS SDUOKY,
		       B.QTSDUM AS QTSDUM,
		       B.LOCATG AS LOCATG,
		       B.SECTTG AS SECTTG,
		       B.PAIDTG AS PAIDTG,
		       B.TRNUTG AS TRNUTG,
		       B.TTRUTY AS TTRUTY,
		       B.TMEAKY AS TMEAKY,
		       B.TUOMKY AS TUOMKY,
		       B.QTTPUM AS QTTPUM,
		       B.TDUOKY AS TDUOKY,
		       B.QTTDUM AS QTTDUM,
		       B.LOCATG AS LOCAAC,
		       B.SECTTG AS SECTAC,
		       B.PAIDTG AS PAIDAC,
		       B.TRNUTG AS TRNUAC,
		       B.TTRUTY AS ATRUTY,
		       DECODE(B.ACTCDT, '00000000', B.TMEAKY, B.AMEAKY) AS AMEAKY,
		       DECODE(B.ACTCDT, '00000000', DECODE(B.TASKTY, 'PT', B.SUOMKY, B.TUOMKY), B.AUOMKY) AS AUOMKY,
		       DECODE(B.ACTCDT, '00000000', B.QTTPUM, B.QTAPUM) AS QTAPUM,
		       DECODE(B.ACTCDT, '00000000', B.TDUOKY, B.ADUOKY) AS ADUOKY,
		       DECODE(B.ACTCDT, '00000000', B.QTTDUM, B.QTADUM) AS QTADUM,
		       B.REFDKY AS REFDKY,
		       B.REFDIT AS REFDIT,
		       B.REFCAT AS REFCAT,
		       B.REFDAT AS REFDAT,
		       B.PURCKY AS PURCKY,
		       B.PURCIT AS PURCIT,
		       B.ASNDKY AS ASNDKY,
		       B.ASNDIT AS ASNDIT,
		       B.RECVKY AS RECVKY,
		       B.RECVIT AS RECVIT,
		       B.SHPOKY AS SHPOKY,
		       B.SHPOIT AS SHPOIT,
		       B.GRPOKY AS GRPOKY,
		       B.GRPOIT AS GRPOIT,
		       B.SADJKY AS SADJKY,
		       B.SADJIT AS SADJIT,
		       B.SDIFKY AS SDIFKY,
		       B.SDIFIT AS SDIFIT,
		       B.PHYIKY AS PHYIKY,
		       B.PHYIIT AS PHYIIT,
		       B.DROPID AS DROPID,
		       B.DESC01 AS DESC01,
		       B.DESC02 AS DESC02,
		       B.ASKU01 AS ASKU01,
		       B.ASKU02 AS ASKU02,
		       B.ASKU03 AS ASKU03,
		       B.ASKU04 AS ASKU04,
		       B.ASKU05 AS ASKU05,
		       B.EANCOD AS EANCOD,
		       B.GTINCD AS GTINCD,
		       B.SKUG01 AS SKUG01,
		       B.SKUG02 AS SKUG02,
		       B.SKUG03 AS SKUG03,
		       B.SKUG04 AS SKUG04,
		       B.SKUG05 AS SKUG05,
		       B.GRSWGT AS GRSWGT,
		       B.NETWGT AS NETWGT,
		       B.WGTUNT AS WGTUNT,
		       B.LENGTH AS LENGTH,
		       B.WIDTHW AS WIDTHW,
		       B.HEIGHT AS HEIGHT,
		       B.CUBICM AS CUBICM,
		       B.CAPACT AS CAPACT,
		       B.WORKID AS WORKID,
		       B.WORKNM AS WORKNM,
		       B.HHTTID AS HHTTID,
		       B.AREAKY AS AREAKY,
		       B.LOTA01 AS LOTA01,
		       B.LOTA02 AS LOTA02,
		       (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'DP' AND PTNRKY = B.LOTA02) AS LOTA02NM,
		       B.LOTA03 AS LOTA03,
		       B.LOTA04 AS LOTA04,
		       B.LOTA05 AS LOTA05,
		       B.LOTA06 AS LOTA06,
		       B.LOTA07 AS LOTA07,
		       B.LOTA08 AS LOTA08,
		       B.LOTA09 AS LOTA09,
		       B.LOTA10 AS LOTA10,
		       B.LOTA11 AS LOTA11,
		       B.LOTA12 AS LOTA12,
		       B.LOTA13 AS LOTA13,
		       B.LOTA14 AS LOTA14,
		       B.LOTA15 AS LOTA15,
		       B.LOTA16 AS LOTA16,
		       B.LOTA17 AS LOTA17,
		       B.LOTA18 AS LOTA18,
		       B.LOTA19 AS LOTA19,
		       B.LOTA20 AS LOTA20,
		       B.AWMSNO AS AWMSNO,
		       B.AWMSTS AS AWMSTS,
		       B.SMANDT AS SMANDT,
		       B.SEBELN AS SEBELN,
		       B.SEBELP AS SEBELP,
		       B.SZMBLNO AS SZMBLNO,
		       B.SZMIPNO AS SZMIPNO,
		       B.STRAID AS STRAID,
		       B.SVBELN AS SVBELN,
		       B.SPOSNR AS SPOSNR,
		       B.STKNUM AS STKNUM,
		       B.STPNUM AS STPNUM,
		       B.SWERKS AS SWERKS,
		       B.SLGORT AS SLGORT,
		       B.SDATBG AS SDATBG,
		       B.STDLNR AS STDLNR,
		       B.SSORNU AS SSORNU,
		       B.SSORIT AS SSORIT,
		       B.SMBLNR AS SMBLNR,
		       B.SZEILE AS SZEILE,
		       B.SMJAHR AS SMJAHR,
		       B.SXBLNR AS SXBLNR,
		       B.SAPSTS AS SAPSTS,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       C.AUTLOC AS AUTLOC,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK
		  FROM TASDH A,
		       TASDI B,
		       LOCMA C,
		       (
		       <if test="QTY_COPY == &quot;N&quot;">
					SELECT '' AS ROWSEQ
						, '' AS ROWCK
						, '' AS TASKKY
						, '' AS TASKIT
						, '' AS QTCOMP
						, '' AS LOCAAC
						, '' AS SECTAC
						, '' AS PAIDAC
						, '' AS TRNUAC
						, '' AS RSNCOD
						, '' AS TASRSN
						, '' AS ATRUTY
					FROM DUAL
				</if>
				<if test="QTY_COPY == &quot;Y&quot;">
					SELECT '' AS ROWSEQ
						, '' AS ROWCK
						, '' AS TASKKY
						, '' AS TASKIT
						, '' AS QTCOMP
						, '' AS LOCAAC
						, '' AS SECTAC
						, '' AS PAIDAC
						, '' AS TRNUAC
						, '' AS RSNCOD
						, '' AS TASRSN
						, '' AS ATRUTY
					FROM DUAL
				</if>
		       ) D
		 WHERE A.TASKKY = B.TASKKY
		   AND A.WAREKY = C.WAREKY
		   AND B.LOCASR = C.LOCAKY
		   AND B.TASKKY = D.TASKKY(+)
		   AND B.TASKIT = D.TASKIT(+)
		   AND A.TASKKY = #{TASKKY}
		
		 ORDER BY B.TASKKY, B.TASKIT
	</select>
	
	<select id="PT01STOCKSUB_LIST" parameterType="Map" resultType="DataMap">
		
		WITH WM_T AS (
		    SELECT NVL(WM.NAME01,' ') AS WARENM  
		    FROM WAHMA WM
		    WHERE WM.WAREKY = #{WAREKY}
		),
		OE_T AS (
		    SELECT NVL(OE.NAME01,' ') AS OWNRNM
		    FROM OWNER OE 
		    WHERE OE.OWNRKY = #{OWNRKY}
		),
		STATIT_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'STATIT'
		     AND CD.CMCDVL = 'NEW'
		),
		SK_T AS (
		    SELECT SK.TASKKY
		         , SK.TASKIT
		         , MIN(SK.SRCSKY) AS SRCSKY
		    FROM STKKY SK
		    WHERE SK.WAREKY = #{WAREKY}
		      AND SK.TASKKY = #{TASKKY}
		      AND TRIM(SK.SRCSKY) IS NOT NULL
		      AND EXISTS (
			               SELECT 1
			               FROM TASDR TR
			               WHERE TR.TASKKY = SK.TASKKY
			                 AND TR.TASKIT = SK.TASKIT
			             )
		    GROUP BY SK.TASKKY, SK.TASKIT
		)
		SELECT ROW_NUMBER() OVER(ORDER BY B.TASKIT) AS NUM,
		       '0' AS USED,
		       A.WAREKY AS WAREKY,
		       B.QTTAOR AS AVAILABLEQTY,              
		       B.QTYUOM AS AVAILABLEQTYUOM,       
		       B.TASKKY AS TASKKY,
		       B.TASKIT AS TASKIT,
		       B.TASKTY AS TASKTY,
		       B.RSNCOD AS RSNCOD,
		       B.STATIT AS STATIT,
		       B.QTTAOR AS QTTAOR,
<!-- 		       B.QTTAOR AS QTCOMP, -->
		       TO_CHAR(B.QTTAOR, 'FM99999999999999999990.000') AS QTCOMP,
		       B.OWNRKY AS OWNRKY,
		       B.SKUKEY AS SKUKEY,
		       B.LOTNUM AS LOTNUM,
		       B.ACTCDT AS ACTCDT,
		       B.ACTCTI AS ACTCTI,
		       B.QTYUOM AS QTYUOM,
		       B.TKFLKY AS TKFLKY,
		       B.STEPNO AS STEPNO,
		       B.LSTTFL AS LSTTFL,
		       B.LOCASR AS LOCASR,
		       B.SECTSR AS SECTSR,
		       B.PAIDSR AS PAIDSR,
		       B.TRNUSR AS TRNUSR,
		       B.STRUTY AS STRUTY,
		       B.SMEAKY AS SMEAKY,
		       B.SUOMKY AS SUOMKY,
		       B.QTSPUM AS QTSPUM,
		       B.SDUOKY AS SDUOKY,
		       B.QTSDUM AS QTSDUM,
		       B.LOCATG AS LOCATG,
		       B.SECTTG AS SECTTG,
		       B.PAIDTG AS PAIDTG,
		       B.TRNUTG AS TRNUTG,
		       B.TTRUTY AS TTRUTY,
		       B.TMEAKY AS TMEAKY,
		       B.TUOMKY AS TUOMKY,
		       B.QTTPUM AS QTTPUM,
		       B.TDUOKY AS TDUOKY,
		       B.QTTDUM AS QTTDUM,
		       NVL(TRIM(B.LOCAAC),B.LOCATG) AS LOCAAC,
               B.TRNUTG AS TRNUAC,
               B.SECTTG AS SECTAC,
               B.PAIDTG AS PAIDAC,
               B.TTRUTY AS ATRUTY,
               B.TMEAKY AS AMEAKY,
		       B.AUOMKY AS AUOMKY,
		       B.QTAPUM AS QTAPUM,
		       B.ADUOKY AS ADUOKY,
		       B.QTADUM AS QTADUM,
		       B.REFDKY AS REFDKY,
		       B.REFDIT AS REFDIT,
		       B.REFCAT AS REFCAT,
		       B.REFDAT AS REFDAT,
		       B.PURCKY AS PURCKY,
		       B.PURCIT AS PURCIT,
		       B.ASNDKY AS ASNDKY,
		       B.ASNDIT AS ASNDIT,
		       B.RECVKY AS RECVKY,
		       B.RECVIT AS RECVIT,
		       B.SHPOKY AS SHPOKY,
		       B.SHPOIT AS SHPOIT,
		       B.GRPOKY AS GRPOKY,
		       B.GRPOIT AS GRPOIT,
		       B.SADJKY AS SADJKY,
		       B.SADJIT AS SADJIT,
		       B.SDIFKY AS SDIFKY,
		       B.SDIFIT AS SDIFIT,
		       B.PHYIKY AS PHYIKY,
		       B.PHYIIT AS PHYIIT,
		       B.DROPID AS DROPID,
		       B.DESC01 AS DESC01,
		       B.DESC02 AS DESC02,
		       B.ASKU01 AS ASKU01,
		       B.ASKU02 AS ASKU02,
		       B.ASKU03 AS ASKU03,
		       B.ASKU04 AS ASKU04,
		       B.ASKU05 AS ASKU05,
		       B.EANCOD AS EANCOD,
		       B.GTINCD AS GTINCD,
		       B.SKUG01 AS SKUG01,
		       B.SKUG02 AS SKUG02,
		       B.SKUG03 AS SKUG03,
		       B.SKUG04 AS SKUG04,
		       B.SKUG05 AS SKUG05,
		       B.GRSWGT AS GRSWGT,
		       B.NETWGT AS NETWGT,
		       B.WGTUNT AS WGTUNT,
		       B.LENGTH AS LENGTH,
		       B.WIDTHW AS WIDTHW,
		       B.HEIGHT AS HEIGHT,
		       B.CUBICM AS CUBICM,
		       B.CAPACT AS CAPACT,
		       B.WORKID AS WORKID,
		       B.WORKNM AS WORKNM,
		       B.HHTTID AS HHTTID,
		       B.AREAKY AS AREAKY,
		       B.LOTA01 AS LOTA01,
		       B.LOTA02 AS LOTA02,
		       B.LOTA03 AS LOTA03,
		       B.LOTA04 AS LOTA04,
		       B.LOTA05 AS LOTA05,
		       B.LOTA06 AS LOTA06,
		       B.LOTA07 AS LOTA07,
		       B.LOTA08 AS LOTA08,
		       B.LOTA09 AS LOTA09,
		       B.LOTA10 AS LOTA10,
		       B.LOTA11 AS LOTA11,
		       B.LOTA12 AS LOTA12,
		       B.LOTA13 AS LOTA13,
		       B.LOTA14 AS LOTA14,
		       B.LOTA15 AS LOTA15,
		       B.LOTA16 AS LOTA16,
		       B.LOTA17 AS LOTA17,
		       B.LOTA18 AS LOTA18,
		       B.LOTA19 AS LOTA19,
		       B.LOTA20 AS LOTA20,
		       
		       B.LOTA01 AS ALOTA01,
		       B.LOTA02 AS ALOTA02,
		       B.LOTA03 AS ALOTA03,
		       B.LOTA04 AS ALOTA04,
		       B.LOTA05 AS ALOTA05,
		       B.LOTA06 AS ALOTA06,
		       B.LOTA07 AS ALOTA07,
		       B.LOTA08 AS ALOTA08,
		       B.LOTA09 AS ALOTA09,
		       B.LOTA10 AS ALOTA10,
		       B.LOTA11 AS ALOTA11,
		       B.LOTA12 AS ALOTA12,
		       B.LOTA13 AS ALOTA13,
		       B.LOTA14 AS ALOTA14,
		       B.LOTA15 AS ALOTA15,
		       B.LOTA16 AS ALOTA16,
		       B.LOTA17 AS ALOTA17,
		       B.LOTA18 AS ALOTA18,
		       B.LOTA19 AS ALOTA19,
		       B.LOTA20 AS ALOTA20,
		       
		       B.AWMSNO AS AWMSNO,
		       B.SMANDT AS SMANDT,
		       B.SEBELN AS SEBELN,
		       B.SEBELP AS SEBELP,
		       B.SZMBLNO AS SZMBLNO,
		       B.SZMIPNO AS SZMIPNO,
		       B.SVBELN AS SVBELN,
		       B.SPOSNR AS SPOSNR,
		       B.STKNUM AS STKNUM,
		       B.STPNUM AS STPNUM,
		       B.SWERKS AS SWERKS,
		       B.SLGORT AS SLGORT,
		       B.SDATBG AS SDATBG,
		       B.STDLNR AS STDLNR,
		       B.STRAID AS STRAID,
		       B.SSORNU AS SSORNU,
		       B.SSORIT AS SSORIT,
		       B.SMBLNR AS SMBLNR,
		       B.SMJAHR AS SMJAHR,
		       B.SZEILE AS SZEILE,
		       B.SXBLNR AS SXBLNR,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       B.PASTKY AS PASTKY,
		       B.ALSTKY AS ALSTKY,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK,
			   
			   J.SRCSKY,
								                                      
  			   B.QTTAOR AS QTSTKC,
			   B.QTTAOR AS QTSTKM,
			   B.QTTAOR AS QTSPMO,
			   
			   ( SELECT X.CDESC1 FROM STATIT_T X ) AS STATITNM,
		       ( SELECT WARENM FROM WM_T ) AS WARENM,
		       
		       H.STLNM AS LOTA01NM,
		       I.SKUL01,
		       
		       L.STLKY,
		       L.STLKY AS STLKY_ORG,
		       L.PLNTKY,
		       L.PLNTKY AS PLNTKY_ORG,
		       NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, B.SKUKEY, B.QTTAOR, B.SUOMKY, 'KG')),'0.000') AS TOT,
			   NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, B.SKUKEY, B.QTTAOR, B.SUOMKY, 'BAG')),'0.000') AS BAG,
			   NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, B.SKUKEY, B.QTTAOR, B.SUOMKY, 'BOX')),'0.000') AS BOX,
			   NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, B.SKUKEY, B.QTTAOR, B.SUOMKY, 'PAL')),'0.000') AS PLT,
			   NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, B.SKUKEY, B.QTTAOR, B.SUOMKY, 'SOK')),'0.000') AS SOK,
			   NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, B.SKUKEY, B.QTTAOR, B.SUOMKY, 'EA')),'0.000') AS EA
			   
		FROM   TASDH A,
		       TASDI B, 
		       STLMA H,
		       SKUMA I,
               SK_T J,
               LOCMA K,
               ZONMA L,
               STLMA M
		WHERE  A.TASKKY = B.TASKKY
		  AND  A.TASKKY = #{TASKKY}
		  AND  A.WAREKY = #{WAREKY}
	      AND H.OWNRKY(+) = #{OWNRKY} 
	      AND H.PLNTKY(+) = B.LOTA02 
	      AND H.STLKY(+)  = B.LOTA01
	      AND I.OWNRKY(+) = B.OWNRKY
   	      AND I.SKUKEY(+) = B.SKUKEY
		  AND J.TASKKY(+) = B.TASKKY
   	      AND J.TASKIT(+) = B.TASKIT
   	      AND K.WAREKY(+) = A.WAREKY
          AND K.LOCAKY(+) = B.LOCATG
          AND L.WAREKY(+) = K.WAREKY
          AND L.ZONEKY(+) = K.ZONEKY
          AND M.PLNTKY(+) = L.PLNTKY
          AND M.WAREKY(+) = L.WAREKY
          AND M.STLKY(+) = L.STLKY

	</select>
	
	
	<select id="STKKYPUTFIND_MAP" parameterType="Map" resultType="DataMap">
		SELECT A.TASKKY AS TASKKY,
		       A.TASKIT AS TASKIT,
		       A.TASKIR AS TASKIR,
		       A.STOKKY AS STOKKY,
		       A.QTSTKM AS QTSTKM,
		       A.QTSTKC AS QTSTKC,
		       A.CREDAT AS CREDAT,
		       A.CRETIM AS CRETIM,
		       A.CREUSR AS CREUSR,
		       A.LMODAT AS LMODAT,
		       A.LMOTIM AS LMOTIM,
		       A.LMOUSR AS LMOUSR,
		       A.INDBZL AS INDBZL,
		       A.INDARC AS INDARC,
		       A.UPDCHK AS UPDCHK,
		       B.STOKKY AS STOKKY,
		       B.QTSIWH AS QTSIWH,
		       B.QTSALO AS QTSALO,
		       B.QTSPMO AS QTSPMO,
		       B.QTSPMI AS QTSPMI,
		       B.QTSBLK AS QTSBLK,
		       B.SRCSKY AS SRCSKY
		FROM   TASDR A,
		       STKKY B
		WHERE  A.STOKKY = B.STOKKY
		AND    A.TASKKY = #{TASKKY}
		AND    A.TASKIT = #{TASKIT}
		ORDER BY A.TASKIR
	</select>
	
	<select id="STKKYPUTFIND_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.TASKKY AS TASKKY,
		       A.TASKIT AS TASKIT,
		       A.TASKIR AS TASKIR,
		       A.STOKKY AS STOKKY,
		       A.QTSTKM AS QTSTKM,
		       A.QTSTKC AS QTSTKC,
		       A.CREDAT AS CREDAT,
		       A.CRETIM AS CRETIM,
		       A.CREUSR AS CREUSR,
		       A.LMODAT AS LMODAT,
		       A.LMOTIM AS LMOTIM,
		       A.LMOUSR AS LMOUSR,
		       A.INDBZL AS INDBZL,
		       A.INDARC AS INDARC,
		       A.UPDCHK AS UPDCHK,
		       B.STOKKY AS STOKKY,
		       B.QTSIWH AS QTSIWH,
		       B.QTSALO AS QTSALO,
		       B.QTSPMO AS QTSPMO,
		       B.QTSPMI AS QTSPMI,
		       B.QTSBLK AS QTSBLK,
		       B.SRCSKY AS SRCSKY
		FROM   TASDR A,
		       STKKY B
		WHERE  A.STOKKY = B.STOKKY
		AND    A.TASKKY = #{TASKKY}
		AND    A.TASKIT = #{TASKIT}
		ORDER BY A.TASKIR
	</select>
	
	<select id="PT01HEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY
		     , TH.WAREKY
		     , (SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY AND ROWNUM = 1) AS WARENM
		     , TH.TASOTY
		     , SZF_GET_DOCUTY_TEXT(#{LANGKY}, TH.TASOTY) AS TASOTYNM
		     , TH.DOCDAT
		     , TH.DOCCAT
		     , SZF_GET_DOCCAT_TEXT(#{LANGKY}, TH.DOCCAT) AS DOCCATNM
		     , TH.DOCTXT
		FROM TASDH TH
		WHERE TH.TASKKY = #{TASKKY}
	</select>
	
	<select id="PT01HEAD_LIST_20220401_BK" parameterType="Map" resultType="DataMap">
		SELECT TASDH.TASKKY AS TASKKY,
		       TASDH.WAREKY AS WAREKY,
		       (SELECT NAME01 FROM WAHMA WHERE WAREKY = TASDH.WAREKY AND ROWNUM = 1) AS WARENM,
		       TASDH.TASOTY AS TASOTY,
		       TASDH.DOCDAT AS DOCDAT,
		       TASDH.DOCCAT AS DOCCAT,
		       (SELECT SHORTX FROM DOCCM WHERE DOCCAT = TASDH.DOCCAT) AS DOCCATNM,
		       TASDH.DRELIN AS DRELIN,
		       TASDH.STATDO AS STATDO,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATDO' AND X.CMCDVL = TASDH.STATDO) AS STATDONM,
		       (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.TASOTY) AS ADJDSC,
		       (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.TASOTY) AS TASOTYNM,
		       TASDH.QTTAOR AS QTTAOR,
		       TASDH.QTCOMP AS QTCOMP,
		       TASDH.TSPKEY AS TSPKEY,
		       TASDH.DOORKY AS DOORKY,
		       DECODE(TASDH.WARETG, ' ', TASDH.WAREKY, TASDH.WARETG) AS WARETG,
		       (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.WARETG) AS WARETGNM,
		       ' ' AS PTNRKYNM,
		       TASDH.PTNRKY AS PTNRKY,
		       TASDH.PTNRNM AS PTNRNM,
		       TASDH.CREDAT AS CREDAT,
		       TASDH.CRETIM AS CRETIM,
		       TASDH.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TASDH.CREUSR) AS CUSRNM,
		       TASDH.LMODAT AS LMODAT,
		       TASDH.LMOTIM AS LMOTIM,
		       TASDH.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TASDH.LMOUSR) AS LUSRNM,
		       TASDH.INDBZL AS INDBZL,
		       TASDH.INDARC AS INDARC,
		       TASDH.DOCTXT AS DOCTXT,
		       TASDH.USRID1 AS USRID1,
			   TASDH.UNAME1 AS UNAME1,
			   TASDH.DEPTID1 AS DEPTID1,
			   TASDH.DNAME1 AS DNAME1,
			   TASDH.USRID2 AS USRID2,
			   TASDH.UNAME2 AS UNAME2,
			   TASDH.DEPTID2 AS DEPTID2,
			   TASDH.DNAME2 AS DNAME2,
			   TASDH.USRID3 AS USRID3,
			   TASDH.UNAME3 AS UNAME3,
			   TASDH.DEPTID3 AS DEPTID3,
			   TASDH.DNAME3 AS DNAME3,
			   TASDH.USRID4 AS USRID4,
			   TASDH.UNAME4 AS UNAME4,
			   TASDH.DEPTID4 AS DEPTID4,
			   TASDH.DNAME4 AS DNAME4,
		       TASDH.UPDCHK AS UPDCHK,
		       TASDH.KEEPTS AS KEEPTS,
		       TASDI.RECVKY AS RECVKY,
		       TASDI.SHPOKY AS SHPOKY,
		       SHPDH.SHPMTY AS SHPMTY,
		       DOCTM.SHORTX AS SHPMTYNM,
		       SHPDH.STATDO AS SHSTATDO,
		       CMCDV.CDESC1 AS SHSTATDONM,
		       SHPDH.DPTNKY AS DPTNKY,
		       BZPTN.NAME01 AS DPTNKYNM,
		       TASDI.SEBELN AS SEBELN,
		       TASDI.SZMBLNO AS SZMBLNO,
		       TASDI.SZMIPNO AS SZMIPNO,
		       TASDI.STRAID AS STRAID,
		       TASDI.SVBELN AS SVBELN,
		       TASDI.STKNUM AS STKNUM,
		       TASDI.STDLNR AS STDLNR,
		       TASDI.SSORNU AS SSORNU,
		       TASDI.SMBLNR AS SMBLNR,
		       TASDI.SXBLNR AS SXBLNR,
		       DECODE(TASDI.ACTCDT, '00000000', 1, ' ', 1, 0) AS COMPLETECNT,
		       TASDI.AREAKY AS AREAKY,
		       NVL((SELECT X.SHORTX FROM AREMA X WHERE X.WAREKY = TASDH.WAREKY AND X.AREAKY = TASDI.AREAKY), ' ') AS AREAKYNM,
		       ' ' AS AREATG,
		       ' ' AS AREATGNM
		       , TASDH.TASOTY AS DOCUTY
		       , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.TASOTY) AS DOCUTYNM
		  FROM TASDH
		       INNER JOIN TASDI ON TASDH.TASKKY = TASDI.TASKKY
		       LEFT OUTER JOIN SHPDI ON SHPDI.SHPOKY = TASDI.SHPOKY AND SHPDI.SHPOIT = TASDI.SHPOIT
		       LEFT OUTER JOIN SHPDH ON SHPDH.SHPOKY = TASDI.SHPOKY 
		       LEFT OUTER JOIN DOCTM ON SHPDH.SHPMTY = DOCTM.DOCUTY
		       LEFT OUTER JOIN CMCDV ON SHPDH.STATDO = CMCDV.CMCDVL AND CMCDKY = 'STATDO'
		       LEFT OUTER JOIN BZPTN ON SHPDH.DPTNKY = BZPTN.PTNRKY AND BZPTN.PTNRTY = 'CT' AND BZPTN.PTNL05 IN (SELECT ADDR05 FROM WAHMA WHERE WAREKY = TASDH.WAREKY) 
		 WHERE TASDH.TASKKY = #{TASKKY}
		 ORDER BY TASDH.TASKKY
	</select>
	
	<select id="SHPDHDRELIN_MAP" parameterType="Map" resultType="DataMap">
		SELECT DRELIN
		FROM SHPDH
		WHERE SHPOKY = NVL((SELECT SHPOKY FROM TASDI WHERE TASKKY = #{TASKKY} AND ROWNUM = 1),' ')
	</select>
	
	<select id="PT01SUB_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.*
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01)                 AS SKUL01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TB.LOTA06)                 AS LOTA06NM
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'TOT')), 0) AS TOTWG    /* 총중량          */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BAG')), 0) AS BAGQT    /* EA/BAG        */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BOX')), 0) AS BOXQT    /* BAG/BOX       */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'PAL')), 0) AS PLTQT    /* BOX/Pallet    */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'SOK')), 0) AS SOKQT    /* 속(개/BALE)    */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' )), 0) AS EAQTY    /* 매(sheet/속)   */
		FROM (
		SELECT TRIM(ROWNUM)||B.TASKIT AS ROWSEQUENCE,
		       (CASE
		          WHEN D.ROWCK IS NULL THEN ' '
		          ELSE D.ROWCK END) AS ROWCK,
		      (CASE WHEN A.TASOTY = '320' THEN 'V'
			   		WHEN A.TASOTY = '391' THEN 'V'
			   		WHEN A.TASOTY = '392' THEN 'V'
			   		ELSE ' ' END) AS CONFIRM,
			   (SELECT DISTINCT STOKKY FROM STKKY WHERE TASKKY = B.TASKKY AND TASKIT = B.TASKIT AND ROWNUM = 1) AS STOKKY,
		       A.WAREKY AS WAREKY,
		       ' ' AS AREATG,
		       B.TASKKY AS TASKKY,
		       B.TASKIT AS TASKIT,
		       B.TASKTY AS TASKTY,
		       B.RSNCOD AS RSNCOD,
		       B.TASRSN AS TASRSN,
		       B.STATIT AS STATIT,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = B.STATIT) AS STATITNM,
		       B.QTTAOR AS QTTAOR,
		       (CASE
		          WHEN D.QTCOMP IS NULL AND B.ACTCDT = '00000000' THEN B.QTCOMP
		          WHEN D.QTCOMP IS NULL THEN B.QTCOMP
		          WHEN D.QTCOMP = '' THEN B.QTCOMP
		          WHEN B.QTCOMP = D.QTCOMP THEN TO_NUMBER(D.QTCOMP) 
		          ELSE TO_NUMBER(D.QTCOMP)  END) AS QTCOMP,
		       B.OWNRKY AS OWNRKY,
		       B.SKUKEY AS SKUKEY,
		       B.LOTNUM AS LOTNUM,
		       B.ACTCDT AS ACTCDT,
		       B.ACTCTI AS ACTCTI,
		       B.QTYUOM AS QTYUOM,
		       B.QTYUOM AS AVAILABLEQTY,
		       B.TKFLKY AS TKFLKY,
		       B.STEPNO AS STEPNO,
		       B.LSTTFL AS LSTTFL,
		       B.LOCASR AS LOCASR,
		       B.LOCASR AS LOCAKY,
		       B.SECTSR AS SECTSR,
		       B.PAIDSR AS PAIDSR,
		       B.TRNUSR AS TRNUSR,
		       B.STRUTY AS STRUTY,
		       B.SMEAKY AS SMEAKY,
		       B.SUOMKY AS SUOMKY,
		       B.QTSPUM AS QTSPUM,
		       B.SDUOKY AS SDUOKY,
		       B.QTSDUM AS QTSDUM,
		       B.LOCATG AS LOCATG,
		       B.SECTTG AS SECTTG,
		       B.PAIDTG AS PAIDTG,
		       B.TRNUTG AS TRNUTG,
		       B.TTRUTY AS TTRUTY,
		       B.TMEAKY AS TMEAKY,
		       B.TUOMKY AS TUOMKY,
		       B.QTTPUM AS QTTPUM,
		       B.TDUOKY AS TDUOKY,
		       B.QTTDUM AS QTTDUM,
		       (CASE
		          WHEN D.LOCAAC IS NULL AND B.ACTCDT = '00000000' THEN B.LOCATG
		          WHEN D.LOCAAC IS NULL THEN B.LOCAAC
		          WHEN B.LOCAAC = D.LOCAAC  THEN D.LOCAAC
		          ELSE D.LOCAAC END) AS LOCAAC,
		       (CASE
		          WHEN D.SECTAC IS NULL AND B.ACTCDT = '00000000' THEN B.SECTTG
		          WHEN D.SECTAC IS NULL THEN B.SECTAC
		          WHEN B.SECTAC = D.SECTAC THEN D.SECTAC
		          ELSE D.SECTAC END) AS SECTAC,
		       (CASE
		          WHEN D.PAIDAC IS NULL AND B.ACTCDT = '00000000' THEN B.PAIDTG
		          WHEN D.PAIDAC IS NULL THEN B.PAIDAC
		          WHEN B.PAIDAC = D.PAIDAC THEN D.PAIDAC
		          ELSE D.PAIDAC END) AS PAIDAC,
		       (CASE
		          WHEN D.TRNUAC IS NULL AND B.ACTCDT = '00000000' THEN B.TRNUTG
		          WHEN D.TRNUAC IS NULL THEN B.TRNUAC
		          WHEN B.TRNUAC = D.TRNUAC THEN D.TRNUAC
		          ELSE D.TRNUAC END) AS TRNUAC,
		       (CASE
		          WHEN D.ATRUTY IS NULL AND B.ACTCDT = '00000000' THEN B.TTRUTY
		          WHEN D.ATRUTY IS NULL THEN B.ATRUTY
		          WHEN B.ATRUTY = D.ATRUTY THEN D.ATRUTY
		          ELSE D.ATRUTY END) AS ATRUTY,
		       DECODE(B.ACTCDT, '00000000', B.TMEAKY, B.AMEAKY) AS AMEAKY,
		       DECODE(B.ACTCDT, '00000000', DECODE(B.TASKTY, 'PT', B.SUOMKY, B.TUOMKY), B.AUOMKY) AS AUOMKY,
		       DECODE(B.ACTCDT, '00000000', B.QTTPUM, B.QTAPUM) AS QTAPUM,
		       DECODE(B.ACTCDT, '00000000', B.TDUOKY, B.ADUOKY) AS ADUOKY,
		       DECODE(B.ACTCDT, '00000000', B.QTTDUM, B.QTADUM) AS QTADUM,
		       B.REFDKY AS REFDKY,
		       B.REFDIT AS REFDIT,
		       B.REFCAT AS REFCAT,
		       B.REFDAT AS REFDAT,
		       B.PURCKY AS PURCKY,
		       B.PURCIT AS PURCIT,
		       B.ASNDKY AS ASNDKY,
		       B.ASNDIT AS ASNDIT,
		       B.RECVKY AS RECVKY,
		       B.RECVIT AS RECVIT,
		       B.SHPOKY AS SHPOKY,
		       B.SHPOIT AS SHPOIT,
		       B.GRPOKY AS GRPOKY,
		       B.GRPOIT AS GRPOIT,
		       B.SADJKY AS SADJKY,
		       B.SADJIT AS SADJIT,
		       B.SDIFKY AS SDIFKY,
		       B.SDIFIT AS SDIFIT,
		       B.PHYIKY AS PHYIKY,
		       B.PHYIIT AS PHYIIT,
		       B.DROPID AS DROPID,
		       B.DESC01 AS DESC01,
		       B.DESC02 AS DESC02,
		       B.ASKU01 AS ASKU01,
		       B.ASKU02 AS ASKU02,
		       B.ASKU03 AS ASKU03,
		       B.ASKU04 AS ASKU04,
		       B.ASKU05 AS ASKU05,
		       B.EANCOD AS EANCOD,
		       B.GTINCD AS GTINCD,
		       B.SKUG01 AS SKUG01,
		       B.SKUG02 AS SKUG02,
		       B.SKUG03 AS SKUG03,
		       B.SKUG04 AS SKUG04,
		       B.SKUG05 AS SKUG05,
		       B.GRSWGT AS GRSWGT,
		       B.NETWGT AS NETWGT,
		       B.WGTUNT AS WGTUNT,
		       B.LENGTH AS LENGTH,
		       B.WIDTHW AS WIDTHW,
		       B.HEIGHT AS HEIGHT,
		       B.CUBICM AS CUBICM,
		       B.CAPACT AS CAPACT,
		       B.WORKID AS WORKID,
		       B.WORKNM AS WORKNM,
		       B.HHTTID AS HHTTID,
		       B.AREAKY AS AREAKY,
		       B.LOTA01 AS LOTA01,
		       B.LOTA02 AS LOTA02,
		       B.LOTA03 AS LOTA03,
		       B.LOTA04 AS LOTA04,
		       B.LOTA05 AS LOTA05,
		       B.LOTA06 AS LOTA06,
		       B.LOTA07 AS LOTA07,
		       B.LOTA08 AS LOTA08,
		       B.LOTA09 AS LOTA09,
		       B.LOTA10 AS LOTA10,
		       B.LOTA11 AS LOTA11,
		       B.LOTA12 AS LOTA12,
		       B.LOTA13 AS LOTA13,
		       B.LOTA14 AS LOTA14,
		       B.LOTA15 AS LOTA15,
		       B.LOTA16 AS LOTA16,
		       B.LOTA17 AS LOTA17,
		       B.LOTA18 AS LOTA18,
		       B.LOTA19 AS LOTA19,
		       B.LOTA20 AS LOTA20,
		       B.AWMSNO AS AWMSNO,
		       B.AWMSTS AS AWMSTS,
		       B.SMANDT AS SMANDT,
		       B.SEBELN AS SEBELN,
		       B.SEBELP AS SEBELP,
		       B.SZMBLNO AS SZMBLNO,
		       B.SZMIPNO AS SZMIPNO,
		       B.STRAID AS STRAID,
		       B.SVBELN AS SVBELN,
		       B.SPOSNR AS SPOSNR,
		       B.STKNUM AS STKNUM,
		       B.STPNUM AS STPNUM,
		       B.SWERKS AS SWERKS,
		       B.SLGORT AS SLGORT,
		       B.SDATBG AS SDATBG,
		       B.STDLNR AS STDLNR,
		       B.SSORNU AS SSORNU,
		       B.SSORIT AS SSORIT,
		       B.SMBLNR AS SMBLNR,
		       B.SZEILE AS SZEILE,
		       B.SMJAHR AS SMJAHR,
		       B.SXBLNR AS SXBLNR,
		       B.SAPSTS AS SAPSTS,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       C.AUTLOC AS AUTLOC,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK,
		       B.PASTKY AS PASTKY,
		       B.ALSTKY AS ALSTKY
		       , B.AUOMKY AS UOMKEY
		       , C.ZONEKY
		       , (SELECT SKUL01 FROM SKUMA WHERE SKUKEY = B.SKUKEY AND OWNRKY = B.OWNRKY) AS SKUL01
		       , B.QTYUOM AS USEQTY
		       , B.QTYUOM AS QTSIWH
		       , E.STLNM AS LOTA01NM
		  FROM TASDH A,
		       TASDI B,
		       LOCMA C,
		       (
		     		SELECT '' AS ROWSEQ
						, '' AS ROWCK
						, '' AS TASKKY
						, '' AS TASKIT
						, '' AS QTCOMP
						, '' AS LOCAAC
						, '' AS SECTAC
						, '' AS PAIDAC
						, '' AS TRNUAC
						, '' AS RSNCOD
						, '' AS TASRSN
						, '' AS ATRUTY
					FROM DUAL
			   ) D,
			   STLMA E
		 WHERE A.TASKKY = B.TASKKY
		   AND A.WAREKY = C.WAREKY
		   AND B.LOCASR = C.LOCAKY
		   AND B.TASKKY = D.TASKKY(+)
		   AND B.TASKIT = D.TASKIT(+)
		   AND A.TASKKY = #{TASKKY}
		   
		   AND E.OWNRKY(+) = B.OWNRKY 
		   AND E.PLNTKY(+) = B.LOTA02 
		   AND E.STLKY(+)  = B.LOTA01
		
		 ORDER BY B.TASKKY, B.TASKIT
		 ) TB
	</select>
	
	<select id="LOCAKYval2_MAP" parameterType="Map" resultType="DataMap">
		SELECT LM.LOCAKY
		     , LM.STATUS
		     , LM.SHORTX 
		     , ZM.ZONEKY 
		     , ZM.PLNTKY
		     , SLM.STLKY
		FROM LOCMA LM
		  INNER JOIN ZONMA ZM
		          ON ZM.WAREKY = LM.WAREKY 
		         AND ZM.ZONEKY = LM.ZONEKY
		  LEFT OUTER JOIN STLMA SLM
		               ON SLM.PLNTKY = ZM.PLNTKY
		              AND SLM.WAREKY = ZM.WAREKY
		              AND SLM.STLKY = ZM.STLKY
		WHERE LM.WAREKY = #{WAREKY}
		  AND LM.STATUS = '00'
		  AND LM.LOCAKY = #{ALOCAKY}		
	</select>
	
	<select id="TASDI_VALIDATION" parameterType="Map" resultType="DataMap" timeout="600">
		SELECT A.*,
		       B.LOCAKY,
		       B.AUTLOC,
		       B.STATUS AS LOC_STATUS,
		       C.SKUKEY AS SKUWC_SKUKEY,
		       D.PASTKY AS PASTH_PASTKY,
               ZM.PLNTKY,
               SK.LOTA06 AS STK_STATUS
		  FROM ( ${VALIDATION_SQL} ) A
		       LEFT OUTER JOIN LOCMA B
		               ON B.WAREKY = A.WAREKY
		              AND B.LOCAKY = A.LOCATG
		       LEFT OUTER JOIN SKUWC C
		               ON C.OWNRKY = A.OWNRKY
		              AND C.SKUKEY = A.SKUKEY
		              AND C.WAREKY = A.WAREKY
		       LEFT OUTER JOIN PASTH D
		               ON D.WAREKY = A.WAREKY
		              AND D.PASTKY = A.PASTKY
		       LEFT OUTER JOIN ZONMA ZM
			           ON ZM.WAREKY = B.WAREKY 
			          AND ZM.ZONEKY = B.ZONEKY
			   LEFT OUTER JOIN STKKY SK
                       ON SK.STOKKY = A.STOKKY
		       
	</select>
	
	<select id="TASDI_STOCK_VALIDATION" parameterType="Map" resultType="DataMap" timeout="600">
		SELECT * 
		FROM (
	    SELECT CASE WHEN  NOT EXISTS ( SELECT SUM(QTSIWH-QTSPMO-QTSBLK) 
	    							   FROM STKKY 
	    							   WHERE WAREKY = STD.WAREKY 
	    							   AND LOTNUM = STD.LOTNUM 
	    							   AND LOCAKY = STD.LOCASR   
	    							   AND TRNUID =  STD.TRNUSR
	    							   AND STOKKY LIKE STD.STOKKY      <!--   적치 BY Record:Stock key, By Sum:% -->
	                                   HAVING NVL(SUM(QTSIWH-QTSPMO-QTSBLK),0) &gt;= STD.QTTAOR )
	                THEN 'IN_M0131†' || STD.LOTNUM || '/' || STD.LOCASR|| '/' || STD.TRNUSR || '/' || TO_CHAR(STD.QTTAOR)|| '/' 
	                				 || ( SELECT TO_CHAR(NVL(SUM(QTSIWH-QTSPMO-QTSBLK) ,0))
			    						  FROM STKKY 
			    						  WHERE WAREKY = STD.WAREKY 
			    						  AND LOTNUM = STD.LOTNUM 
			    						  AND LOCAKY = STD.LOCASR   
			    						  AND TRNUID =  STD.TRNUSR
			    						  AND STOKKY LIKE STD.STOKKY  )
	                ELSE 'OK'
			        END AS RESULTMSG                                      
	     FROM ( ${APPEND_QUERY} ) STD
		)
		 WHERE RESULTMSG != 'OK'
		 AND ROWNUM = 1
	</select>
	
	
	<select id="PT01CONF_MASTER_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT *
		 FROM (
		        SELECT CASE 
		        			<!-- 작업아이템번호[{0}]에 입력된 지번[{1}]은 등록되지 않았습니다. -->
		        			WHEN  NOT EXISTS ( SELECT '1' FROM LOCMA 
		        							   WHERE WAREKY = STD.WAREKY 
		        							   AND LOCAKY = STD.LOCAAC
		        							   AND STATUS = '00' 
		        							 )
		                      THEN 'TASK_M0064†' || STD.TASKIT || '/' || STD.LOCAAC
		                    <!-- 동일한 플랜트 내 지번만 변경 가능합니다. -->
		                    WHEN NOT EXISTS (
                                        SELECT '1' 
                                        FROM LOCMA LM
  										  INNER JOIN ZONMA ZM
                                                  ON ZM.WAREKY = LM.WAREKY 
                                                 AND ZM.ZONEKY = LM.ZONEKY
                                                 AND (
                                                 		ZM.PLNTKY = ' '
                                                      	OR
<!--                                                       	ZM.PLNTKY = STD.LOTA02 -->
														<!-- 20220921 P200과 P300 묶어서 처리 되게 동시에 보이게 설정 요청. -->
                                                      	ZM.PLNTKY IN (
		                                              					CASE WHEN STD.PLNTKY IN ('P200','P300')  
		                                              		       			   THEN 
		                                              		       			   	 (SELECT X.PLNTKY
		                                              		       			   	 FROM (
		                                              		       			          SELECT 'P200' AS PLNTKY FROM DUAL
		                                              		       			          UNION ALL
		                                              		       			          SELECT 'P300' AS PLNTKY FROM DUAL
		                                              		       			          ) X
		                                              		       			     WHERE X.PLNTKY = ZM.PLNTKY)
		                                              		       			 ELSE (SELECT STD.PLNTKY FROM DUAL)
		                                              		       		END
		                                              				)
                                                     )
                                        WHERE LM.WAREKY = STD.WAREKY
                                          AND LM.STATUS = '00'
                                          AND LM.LOCAKY = STD.LOCAAC
                                    )
                              THEN 'TASK_M0701†' || STD.TASKIT || '/' || STD.LOCAAC
							<!-- 2022-08-05 청주공장만 적치, 재고이동 처리시 MTO재고는 TO지번에 다른 MTO가 있으면 처리안되게 알림(해당지번['XXXXXX']에 다른 MTO 재고가 존재합니다.) 처리 부탁드립니다. -->
                            WHEN STD.WAREKY = '1100' AND EXISTS ( SELECT 1 FROM STKKY SK WHERE SK.WAREKY = '1100' AND SK.SKUKEY = STD.SKUKEY AND TRIM(SK.LOTA07) IS NOT NULL AND SK.QTSIWH > 0 AND SK.LOCAKY = STD.LOCAAC AND SK.LOTA07 != STD.LOTA07 )
					  		  THEN 'VALID_M2112†'|| STD.LOCAAC
					  		WHEN NVL(TRIM((
					  		        SELECT SUM(SK.QTSIWH)
									FROM TASDR TR
									  LEFT OUTER JOIN STKKY SK ON SK.STOKKY = TR.STOKKY
									WHERE TR.TASKKY = STD.TASKKY
									  AND TR.TASKIT = STD.TASKIT
					  		      )),0) <![CDATA[<=]]> 0
					  		  THEN 'VALID_M2128†'|| STD.TASKKY
					  		WHEN NOT EXISTS (
					  		                   SELECT 1
					  		                   FROM TASDI TI
					  		                   WHERE TI.TASKKY = STD.TASKKY
					  		                     AND TI.TASKIT = STD.TASKIT
					  		                     AND TI.STATIT = 'NEW'
					  		                )
					  		  THEN 'VALID_M2135†'|| STD.TASKKY || '/' || STD.TASKIT  
					  		<!-- 20220923 [{0}][{1}] 품목[{2}]은 플랜트 [{3}]에서 관리중인 품목이 아닙니다. -->  
<!-- 		                    WHEN NOT EXISTS ( -->
<!-- 					  		                   	SELECT 1 -->
<!-- 					  		                   	FROM SKUPLT SLT -->
<!-- 												WHERE SLT.WAREKY = STD.WAREKY -->
<!-- 												  AND SLT.SKUKEY = STD.SKUKEY -->
<!-- 												  AND SLT.PLNTKY = STD.PLNTKY -->
<!-- 					  		                ) -->
<!-- 					  		  THEN 'VALID_M2132†' || STD.TASKKY || '/' || STD.TASKIT || '/' || STD.SKUKEY || '/' || STD.PLNTKY -->
		                    ELSE 'OK'
		                END AS RESULTMSG  
		        FROM ( ${APPEND_QUERY} ) STD
		      )
		 WHERE RESULTMSG != 'OK'
		 AND ROWNUM = 1
	</select>
	
	<select id="PT01DEL_MASTER_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT *
		 FROM (
		        SELECT CASE WHEN NVL(TRIM((
					  		        SELECT SUM(SK.QTSIWH)
									FROM TASDR TR
									  LEFT OUTER JOIN STKKY SK ON SK.STOKKY = TR.STOKKY
									WHERE TR.TASKKY = STD.TASKKY
									  AND TR.TASKIT = STD.TASKIT
					  		      )),0) <![CDATA[<=]]> 0
					  		  THEN 'VALID_M2129†'|| STD.TASKKY
		                    ELSE 'OK'
		                END AS RESULTMSG  
		        FROM ( ${APPEND_QUERY} ) STD
		      )
		 WHERE RESULTMSG != 'OK'
		 AND ROWNUM = 1
	</select>
	
	<insert id="TASDH_INSERT" parameterType="Map">
