	<insert id="TASDR_INSERT" parameterType="Map">
		INSERT INTO TASDR (      
		      TASKKY
		    , TASKIT
		    , TASKIR
		    , STOKKY
		    , QTSTKM
		    , QTSTKC
		    , CREDAT
		    , CRETIM
		    , CREUSR
		    , LMODAT
		    , LMOTIM
		    , LMOUSR    
		) VALUES (
		      #{TASKKY}
		    , #{TASKIT}
		    , '0001'
		    , #{STOKKY}
		    , TO_NUMBER(NVL(TRIM(#{QTTAOR}), 0))
		    , TO_NUMBER(NVL(TRIM(#{QTSTKC}), 0))
		    , TO_CHAR(SYSDATE, 'YYYYMMDD')
		    , TO_CHAR(SYSDATE, 'HH24MISS')
		    , #{SES_USER_ID}
		    , TO_CHAR(SYSDATE, 'YYYYMMDD')
		    , TO_CHAR(SYSDATE, 'HH24MISS')
		    , #{SES_USER_ID}   
		)
	</insert>
	
	<select id="DBMSPROC_SZP_INS_TASDR_MAP" parameterType="Map" resultType="DataMap">
		{ call SZP_INS_TASDR(#{TASKKY}, #{TASKIT}, #{STOKKY}, #{QTTAOR}, #{QTCOMP}) }
	</select>
	
	<select id="SAVETK_SZP_INS_TASDR_MAP" parameterType="Map" resultType="DataMap">
		{ call SZP_INS_TASDR(#{TASKKY}, #{TASKIT}, #{STOKKY}, #{QTTAOR}, #{QTCOMP}) }
	</select>
	
	<insert id="TASDR_INS_INSERT" parameterType="Map">
		INSERT INTO TASDR(
				TASKKY,
				TASKIT,
				TASKIR,
				STOKKY,
				QTSTKM,
				QTSTKC,
				CREDAT, CRETIM, CREUSR,
