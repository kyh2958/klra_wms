	<insert id="TASDI_INSERT" parameterType="Map">
		INSERT INTO TASDI(
				TASKKY,
				TASKIT,
				TASKTY,
				RSNCOD,
				STATIT,
				QTTAOR,
				QTCOMP,
				OWNRKY,
				SKUKEY,
				LOTNUM,
				ACTCDT,
				ACTCTI,
