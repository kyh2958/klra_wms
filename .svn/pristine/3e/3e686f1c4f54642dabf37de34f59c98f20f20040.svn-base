				T.LENGTH,
				T.WIDTHW,
				T.HEIGHT,
				T.CUBICM,
				T.CAPACT,
				T.WORKID,
				T.WORKNM,
				T.HHTTID,
				T.AREAKY,
				T.LOTA01,
				T.LOTA02,
				T.LOTA03,
				T.LOTA04,
				T.LOTA05,
				T.LOTA06,
				(SELECT CDESC1 FROM CMCDV CV WHERE CV.CMCDKY = 'LOTA06' AND CV.CMCDVL = T.LOTA06) AS LOTA06NM,
				T.LOTA07,
				T.LOTA08,
				T.LOTA09,
				T.LOTA10,
				T.LOTA11,
				T.LOTA12,
				T.LOTA13,
				T.LOTA14,
				T.LOTA15,
				T.LOTA16,
				T.LOTA17,
				T.LOTA18,
				T.LOTA19,
				T.LOTA20,
				T.AWMSNO,
				T.AWMSTS,
				T.SMANDT,
				T.SEBELN,
				T.SEBELP,
				T.SZMBLNO,
				T.SZMIPNO,
				T.STRAID,
				T.SVBELN,
				T.SPOSNR,
				T.STKNUM,
				T.STPNUM,
				T.SWERKS,
				T.SLGORT,
				T.SDATBG,
				T.STDLNR,
				T.SSORNU,
				T.SSORIT,
				T.SMBLNR,
				T.SZEILE,
				T.SMJAHR,
				T.SXBLNR,
				T.SAPSTS,
				T.DOORKY,
				T.PTLT01,
				T.PTLT02,
				T.PTLT03,
				T.PTLT04,
				T.PTLT05,
				T.PTLT06,
				T.PTLT07,
				T.PTLT08,
				T.PTLT09,
				T.PTLT10,
				T.PTLT11,
				T.PTLT12,
				T.PTLT13,
				T.PTLT14,
				T.PTLT15,
				T.PTLT16,
				T.PTLT17,
				T.PTLT18,
				T.PTLT19,
				T.PTLT20,
				T.PASTKY,
				T.ALSTKY,
				T.SBKTXT,
				T.TASRSN,
				T.CREDAT,
				T.CRETIM,
				T.CREUSR,
				T.LMODAT,
				T.LMOTIM,
				T.LMOUSR,
				T.INDBZL,
				T.INDARC,
				T.UPDCHK
		FROM TASDI T
		WHERE T.TASKKY = #{TASKKY}
	</select>
	
	<select id="PT05BODY_LIST" parameterType="Map" resultType="DataMap">
		SELECT  TI.TASKKY
		      , TI.TASKIT
		      , TR.STOKKY
		      , TI.TASKTY
		      , TI.RSNCOD
		      , TI.STATIT
		      , TI.QTTAOR
		      , CASE WHEN TI.UPDCHK = 1 
		        THEN TI.QTCOMP ELSE TI.QTTAOR 
		        END QTCOMP
		      , TI.OWNRKY
		      , TH.WAREKY
		      , TI.SKUKEY
		      , TI.LOTNUM
		      , TI.ACTCDT
		      , TI.ACTCTI
		      , TI.QTYUOM
		      , TI.TKFLKY
		      , TI.STEPNO
		      , TI.LSTTFL
		      , TI.LOCASR
		      , TI.SECTSR
		      , TI.STRUTY
		      , TI.SMEAKY
		      , TI.SUOMKY
		      , TI.QTSPUM
		      , TI.SDUOKY
		      , TI.QTSDUM
		      , TI.LOCATG
		      , TI.SECTTG
		      , TI.PAIDTG
		      , TI.TRNUTG
		      , TI.TTRUTY
		      , TI.TMEAKY
		      , TI.TUOMKY
		      , TI.QTTPUM
		      , TI.TDUOKY
		      , TI.QTTDUM
		      , TI.LOCATG AS LOCAAC
		      , TI.SECTAC
		      , TI.PAIDAC
		      , TI.TRNUAC
		      , TI.ATRUTY
		      , TI.AMEAKY
		      , TI.AUOMKY
		      , TI.QTAPUM
		      , TI.ADUOKY
		      , TI.QTADUM
		      , TI.REFDKY
		      , TI.REFDIT
		      , TI.REFCAT
		      , TI.REFDAT
		      , TI.PURCKY
		      , TI.PURCIT
		      , TI.ASNDKY
		      , TI.ASNDIT
		      , TI.RECVKY
		      , TI.RECVIT
		      , TI.SHPOKY
		      , TI.SHPOIT
		      , TI.GRPOKY
		      , TI.GRPOIT
		      , TI.SADJKY
		      , TI.SADJIT
		      , TI.SDIFKY
		      , TI.SDIFIT
		      , TI.PHYIKY
		      , TI.PHYIIT
		      , TI.DROPID
		      , TI.DESC01
		      , TI.DESC02
		      , TI.ASKU01
		      , TI.ASKU02
		      , TI.ASKU03
		      , TI.ASKU04
		      , TI.ASKU05
		      , TI.EANCOD
		      , TI.GTINCD
		      , TI.SKUG01
		      , TI.SKUG02
		      , TI.SKUG03
		      , TI.SKUG04
		      , TI.SKUG05
		      , TI.GRSWGT
		      , TI.NETWGT
		      , TI.WGTUNT
		      , TI.LENGTH
		      , TI.WIDTHW
		      , TI.HEIGHT
		      , TI.CUBICM
		      , TI.CAPACT
		      , TI.WORKID
		      , TI.WORKNM
		      , TI.HHTTID
		      , TI.AREAKY
		      , TI.LOTA01
		      , TI.LOTA02
		      , TI.LOTA03
		      , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'VD' AND PTNRKY = TI.LOTA03) LOTA03NM
		      , LOTA04
		      , LOTA05
		      , RTRIM(TO_CHAR((SELECT CASE WHEN TI.LOTA05 &lt;&gt; ' ' THEN TO_CHAR(ROUND(MONTHS_BETWEEN(TO_DATE(LOTA05, 'yyyymmdd'), SYSDATE), 1)) END  FROM DUAL),'FM9990D99'),'.') AS REMLOTA05
		      , TI.LOTA06
		      , TI.LOTA07
		      , TI.LOTA08
		      , TI.LOTA09
		      , TI.LOTA10
		      , TI.LOTA11
		      , TI.LOTA12
		      , RTRIM(TO_CHAR((SELECT CASE WHEN LOTA12 &lt;&gt; ' ' THEN TO_CHAR(ROUND(MONTHS_BETWEEN(SYSDATE ,TO_DATE(TI.LOTA12, 'yyyymmdd')), 1)) END  FROM DUAL),'FM9990D99'),'.') AS REMLOTA12
		      , RTRIM(TO_CHAR((SELECT CASE WHEN LOTA04 &lt;&gt; ' ' THEN TO_CHAR(ROUND(MONTHS_BETWEEN(SYSDATE ,TO_DATE(TI.LOTA04, 'yyyymmdd')), 1)) END  FROM DUAL),'FM9990D99'),'.') AS REMLOTA04
		      , TI.LOTA13
		      , TI.LOTA14
		      , TI.LOTA15
		      , TI.LOTA16
		      , TI.LOTA17
		      , TI.LOTA18
		      , TI.LOTA19
		      , TI.LOTA20
		      , TI.AWMSNO
		      , TI.AWMSTS
		      , TI.SMANDT
		      , TI.SEBELN
		      , TI.SEBELP
		      , TI.SZMBLNO
		      , TI.SZMIPNO
		      , TI.STRAID
		      , TI.SPOSNR
		      , TI.STKNUM
		      , TI.STPNUM
		      , TI.SWERKS
		      , TI.SLGORT
		      , TI.SDATBG
		      , TI.STDLNR
		      , TI.SSORNU
		      , TI.SSORIT
		      , TI.SMBLNR
		      , TI.SZEILE
		      , TI.SMJAHR
		      , TI.SXBLNR
		      , TI.SAPSTS
		      , TI.DOORKY
		      , TI.PTLT01
		      , TI.PTLT02
		      , TI.PTLT03
		      , TI.PTLT04
		      , TI.PTLT05
		      , TI.PTLT06
		      , TI.PTLT07
		      , TI.PTLT08
		      , TI.PTLT09
		      , TI.PTLT10
		      , TI.PTLT11
		      , TI.PTLT12
		      , TI.PTLT13
		      , TI.PTLT14
		      , TI.PTLT15
		      , TI.PTLT16
		      , TI.PTLT17
		      , TI.PTLT18
		      , TI.PTLT19
		      , TI.PTLT20
		      , TI.PASTKY
		      , TI.ALSTKY
		      , TI.SBKTXT
		      , TI.TASRSN
		FROM    TASDI TI
		      , TASDH TH
		      , TASDR TR
		      , SKUWC SW
		WHERE   1=1
		AND     TH.TASKKY = TI.TASKKY
		AND     TR.TASKKY = TI.TASKKY
		AND     TR.TASKIT = TI.TASKIT
		AND     SW.WAREKY = TH.WAREKY
		AND     SW.OWNRKY = TI.OWNRKY
		AND     SW.SKUKEY = TI.SKUKEY
		AND     TI.TASKKY = #{TASKKY}
		<if test="PROGID == &quot;MPT05&quot;">
			<if test="UPDCHK == 1">
				AND TI.UPDCHK = 1		
			</if>
			<if test="UPDCHK == 0">
				AND TI.UPDCHK = 0		
			</if>
		</if>
   </select> 
   
   <select id="PT05HEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT  TH.TASKKY
		      , TH.DOCCAT
		      , (SELECT SHORTX FROM DOCCM WHERE DOCCAT = TH.DOCCAT) DOCCATNM
		      , TH.TASOTY
		      , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TH.TASOTY) TASOTYNM
		      , TH.WAREKY
		      , (SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY) WAREKYNM
		      , TH.DOCDAT
		      , TH.DOCTXT
		      , TH.CREDAT
		      , TH.CRETIM
		      , TH.CREUSR
		      , (SELECT NMLAST FROM USRMA WHERE USERID = TH.CREUSR) CUSRNM
		      , TH.LMODAT
		      , TH.LMOTIM
		      , TH.LMOUSR
		      , (SELECT NMLAST FROM USRMA WHERE USERID = TH.LMOUSR) LUSRNM
		FROM    TASDH TH
		      , TASDI TI
		WHERE   1=1
		<if test="TASKKYS == null or TASKKYS == ''">
		AND     TH.TASKKY = TI.TASKKY
		AND     TH.STATDO = 'NEW'
		AND     TI.STATIT = 'NEW'
		AND     TH.WAREKY = #{WAREKY}
		AND     TI.AREAKY IN(SELECT  TRIM(REGEXP_SUBSTR(#{AREAKY}, '[^,]+', 1, LEVEL)) 
		                     FROM    DUAL
		                     CONNECT BY REGEXP_COUNT(#{AREAKY}, ',') + 1 &gt;= LEVEL)
		AND     TH.TASOTY = '310'
		</if>
		<if test="TASKKYS != null and TASKKYS != ''">
		<if test="PROGID == &quot;MPT05&quot;">
		AND     TH.TASKKY = TI.TASKKY
		AND     TH.STATDO = 'NEW'
		AND     TI.STATIT = 'NEW'
		AND     TH.WAREKY = #{WAREKY}
		AND     TI.AREAKY IN(SELECT  TRIM(REGEXP_SUBSTR(#{AREAKY}, '[^,]+', 1, LEVEL)) 
		                     FROM    DUAL
		                     CONNECT BY REGEXP_COUNT(#{AREAKY}, ',') + 1 &gt;= LEVEL)
		AND     TH.TASOTY = '310'
		</if>
		AND     TH.TASKKY IN (SELECT  TRIM(REGEXP_SUBSTR(#{TASKKYS}, '[^,]+', 1, LEVEL)) 
		                      FROM    DUAL
		                      CONNECT BY REGEXP_COUNT(#{TASKKYS}, ',') + 1 &gt;= LEVEL)
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
		${RANGE_SQL}
		</if>
		GROUP BY
		        TH.TASKKY
		      , TH.DOCCAT
		      , TH.TASOTY
		      , TH.WAREKY
		      , TH.DOCDAT
		      , TH.DOCTXT
		      , TH.CREDAT
		      , TH.CRETIM
		      , TH.CREUSR
		      , TH.LMODAT
		      , TH.LMOTIM
		      , TH.LMOUSR
	</select>
	
	<select id="MPT05_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY AS WAREKY,
		       B.TASKKY AS TASKKY,
		       B.TASKIT AS TASKIT,
		       B.TASKTY AS TASKTY,
		       B.RSNCOD AS RSNCOD,
		       B.TASRSN AS TASRSN,
		       B.STATIT AS STATIT,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = B.STATIT) AS STATITNM,
		       B.QTTAOR AS QTTAOR,
		       B.QTTAOR AS QTCOMP,
		       B.OWNRKY AS OWNRKY,
		       B.SKUKEY AS SKUKEY,
		       B.LOTNUM AS LOTNUM,
		       B.ACTCDT AS ACTCDT,
		       B.ACTCTI AS ACTCTI,
		       B.QTYUOM AS QTYUOM,
		       B.TKFLKY AS TKFLKY,
		       B.STEPNO AS STEPNO,
		       B.LSTTFL AS LSTTFL,
		       B.LOCASR AS LOCASR,
		       B.SECTSR AS SECTSR,
		       B.PAIDSR AS PAIDSR,
		       B.TRNUSR AS TRNUSR,
		       B.STRUTY AS STRUTY,
		       B.SMEAKY AS SMEAKY,
		       B.SUOMKY AS SUOMKY,
		       B.QTSPUM AS QTSPUM,
		       B.SDUOKY AS SDUOKY,
		       B.QTSDUM AS QTSDUM,
		       B.LOCATG AS LOCATG,
		       B.SECTTG AS SECTTG,
		       B.PAIDTG AS PAIDTG,
		       B.TRNUTG AS TRNUTG,
		       B.TTRUTY AS TTRUTY,
		       B.TMEAKY AS TMEAKY,
		       B.TUOMKY AS TUOMKY,
		       B.QTTPUM AS QTTPUM,
		       B.TDUOKY AS TDUOKY,
		       B.QTTDUM AS QTTDUM,
		       B.LOCATG AS LOCAAC,
		       B.SECTTG AS SECTAC,
		       B.PAIDTG AS PAIDAC,
		       B.TRNUTG AS TRNUAC,
		       B.TTRUTY AS ATRUTY,
		       B.TMEAKY AS AMEAKY,
		       B.TUOMKY AS AUOMKY,
		       B.QTTPUM AS QTAPUM,
		       B.TDUOKY AS ADUOKY,
		       B.QTTDUM AS QTADUM,
		       B.REFDKY AS REFDKY,
		       B.REFDIT AS REFDIT,
		       B.REFCAT AS REFCAT,
		       B.REFDAT AS REFDAT,
		       B.PURCKY AS PURCKY,
		       B.PURCIT AS PURCIT,
		       B.ASNDKY AS ASNDKY,
		       B.ASNDIT AS ASNDIT,
		       B.RECVKY AS RECVKY,
		       B.RECVIT AS RECVIT,
		       B.SHPOKY AS SHPOKY,
		       B.SHPOIT AS SHPOIT,
		       B.GRPOKY AS GRPOKY,
		       B.GRPOIT AS GRPOIT,
		       B.SADJKY AS SADJKY,
		       B.SADJIT AS SADJIT,
		       B.SDIFKY AS SDIFKY,
		       B.SDIFIT AS SDIFIT,
		       B.PHYIKY AS PHYIKY,
		       B.PHYIIT AS PHYIIT,
		       B.DROPID AS DROPID,
		       B.DESC01 AS DESC01,
		       B.DESC02 AS DESC02,
		       B.ASKU01 AS ASKU01,
		       B.ASKU02 AS ASKU02,
		       B.ASKU03 AS ASKU03,
		       B.ASKU04 AS ASKU04,
		       B.ASKU05 AS ASKU05,
		       B.EANCOD AS EANCOD,
		       B.GTINCD AS GTINCD,
		       B.SKUG01 AS SKUG01,
		       B.SKUG02 AS SKUG02,
		       B.SKUG03 AS SKUG03,
		       B.SKUG04 AS SKUG04,
		       B.SKUG05 AS SKUG05,
		       B.GRSWGT AS GRSWGT,
		       B.NETWGT AS NETWGT,
		       B.WGTUNT AS WGTUNT,
		       B.LENGTH AS LENGTH,
		       B.WIDTHW AS WIDTHW,
		       B.HEIGHT AS HEIGHT,
		       B.CUBICM AS CUBICM,
		       B.CAPACT AS CAPACT,
		       B.WORKID AS WORKID,
		       B.WORKNM AS WORKNM,
		       B.HHTTID AS HHTTID,
		       B.AREAKY AS AREAKY,
		       B.LOTA01 AS LOTA01,
		       B.LOTA02 AS LOTA02,
		       B.LOTA03 AS LOTA03,
		       B.LOTA04 AS LOTA04,
		       B.LOTA05 AS LOTA05,
		       B.LOTA06 AS LOTA06,
		       B.LOTA07 AS LOTA07,
		       B.LOTA08 AS LOTA08,
		       B.LOTA09 AS LOTA09,
		       B.LOTA10 AS LOTA10,
		       B.LOTA11 AS LOTA11,
		       B.LOTA12 AS LOTA12,
		       B.LOTA13 AS LOTA13,
		       B.LOTA14 AS LOTA14,
		       B.LOTA15 AS LOTA15,
		       B.LOTA16 AS LOTA16,
		       B.LOTA17 AS LOTA17,
		       B.LOTA18 AS LOTA18,
		       B.LOTA19 AS LOTA19,
		       B.LOTA20 AS LOTA20,
		       B.AWMSNO AS AWMSNO,
		       B.AWMSTS AS AWMSTS,
		       B.SMANDT AS SMANDT,
		       B.SEBELN AS SEBELN,
		       B.SEBELP AS SEBELP,
		       B.SZMBLNO AS SZMBLNO,
		       B.SZMIPNO AS SZMIPNO,
		       B.STRAID AS STRAID,
		       B.SVBELN AS SVBELN,
		       B.SPOSNR AS SPOSNR,
		       B.STKNUM AS STKNUM,
		       B.STPNUM AS STPNUM,
		       B.SWERKS AS SWERKS,
		       B.SLGORT AS SLGORT,
		       B.SDATBG AS SDATBG,
		       B.STDLNR AS STDLNR,
		       B.SSORNU AS SSORNU,
		       B.SSORIT AS SSORIT,
		       B.SMBLNR AS SMBLNR,
		       B.SZEILE AS SZEILE,
		       B.SMJAHR AS SMJAHR,
		       B.SXBLNR AS SXBLNR,
		       B.SAPSTS AS SAPSTS,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       C.AUTLOC AS AUTLOC,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK
		  FROM TASDH A,
		       TASDI B,
		       LOCMA C
		 WHERE A.TASKKY = B.TASKKY
		   AND A.WAREKY = C.WAREKY
		   AND B.LOCASR = C.LOCAKY
		   AND A.TASKKY = #{TASKKY}
		   AND B.STATIT = 'NEW'
		 ORDER BY B.TASKKY, B.TASKIT, B.RECVKY
	 <if test="RANGE_SQL != null and RANGE_SQL != ''">
		 ${RANGE_SQL}
	 </if>
	</select>
	
	<select id="MV05HEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT TASDH.TASKKY AS TASKKY,
		       TASDH.WAREKY AS WAREKY,
		       (SELECT NAME01 FROM WAHMA WHERE WAREKY = TASDH.WAREKY AND ROWNUM = 1) AS WAREKYNM,
		       TASDH.TASOTY AS TASOTY,
		       TASDH.DOCDAT AS DOCDAT,
		       TASDH.DOCCAT AS DOCCAT,
		       (SELECT SHORTX FROM DOCCM WHERE DOCCAT = TASDH.DOCCAT) AS DOCCATNM,
		       TASDH.DRELIN AS DRELIN,
		       TASDH.STATDO AS STATDO,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATDO' AND X.CMCDVL = TASDH.STATDO) AS STATDONM,
		       (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.TASOTY) AS ADJDSC,
		       (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.TASOTY) AS TASOTYNM,
		       TASDH.QTTAOR AS QTTAOR,
		       TASDH.QTCOMP AS QTCOMP,
		       TASDH.TSPKEY AS TSPKEY,
		       TASDH.DOORKY AS DOORKY,
		       DECODE(TASDH.WARETG, ' ', TASDH.WAREKY, TASDH.WARETG) AS WARETG,
		       (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.WARETG) AS WARETGNM,
		       ' ' AS PTNRKYNM,
		       TASDH.PTNRKY AS PTNRKY,
		       TASDH.CREDAT AS CREDAT,
		       TASDH.CRETIM AS CRETIM,
		       TASDH.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TASDH.CREUSR) AS CUSRNM,
		       TASDH.LMODAT AS LMODAT,
		       TASDH.LMOTIM AS LMOTIM,
		       TASDH.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TASDH.LMOUSR) AS LUSRNM,
		       TASDH.INDBZL AS INDBZL,
		       TASDH.INDARC AS INDARC,
		       TASDH.DOCTXT AS DOCTXT,
		       TASDH.USRID1 AS USRID1,
			   TASDH.UNAME1 AS UNAME1,
			   TASDH.DEPTID1 AS DEPTID1,
			   TASDH.DNAME1 AS DNAME1,
			   TASDH.USRID2 AS USRID2,
			   TASDH.UNAME2 AS UNAME2,
			   TASDH.DEPTID2 AS DEPTID2,
			   TASDH.DNAME2 AS DNAME2,
			   TASDH.USRID3 AS USRID3,
			   TASDH.UNAME3 AS UNAME3,
			   TASDH.DEPTID3 AS DEPTID3,
			   TASDH.DNAME3 AS DNAME3,
			   TASDH.USRID4 AS USRID4,
			   TASDH.UNAME4 AS UNAME4,
			   TASDH.DEPTID4 AS DEPTID4,
			   TASDH.DNAME4 AS DNAME4,
		       TASDH.UPDCHK AS UPDCHK,
		       TASDH.KEEPTS AS KEEPTS,
		       MAX(TASDI.RECVKY) AS RECVKY,
		       MAX(TASDI.SHPOKY) AS SHPOKY,
		       MAX(SHPDH.SHPMTY) AS SHPMTY,
		       MAX(DOCTM.SHORTX) AS SHPMTYNM,
		       MAX(SHPDH.STATDO) AS SHSTATDO,
		       MAX(CMCDV.CDESC1) AS SHSTATDONM,
		       MAX(SHPDH.DPTNKY) AS DPTNKY,
		       MAX(BZPTN.NAME01) AS DPTNKYNM,
		
		       MAX(TASDI.SEBELN) AS SEBELN,
		       MAX(TASDI.SZMBLNO) AS SZMBLNO,
		       MAX(TASDI.SZMIPNO) AS SZMIPNO,
		       MAX(TASDI.STRAID) AS STRAID,
		       MAX(TASDI.SVBELN) AS SVBELN,
		       MAX(TASDI.STKNUM) AS STKNUM,
		       MAX(TASDI.STDLNR) AS STDLNR,
		       MAX(TASDI.SSORNU) AS SSORNU,
		       MAX(TASDI.SMBLNR) AS SMBLNR,
		       MAX(TASDI.SXBLNR) AS SXBLNR,
		       NVL(SUM(DECODE(TASDI.ACTCDT, '00000000', 1, ' ', 1, 0)), 0) AS COMPLETECNT,
		       MAX(TASDI.AREAKY) AS AREAKY,
		       ' ' AS AREATG,
		       ' ' AS AREATGNM
		  FROM TASDH
		       INNER JOIN TASDI
			       ON TASDH.TASKKY = TASDI.TASKKY
		       LEFT OUTER JOIN SHPDI
			       ON SHPDI.SHPOKY = TASDI.SHPOKY 
			       AND SHPDI.SHPOIT = TASDI.SHPOIT
		       LEFT OUTER JOIN SHPDH 
			       ON SHPDH.SHPOKY = TASDI.SHPOKY
		       LEFT OUTER JOIN DOCTM
			       ON SHPDH.SHPMTY = DOCTM.DOCUTY
		       LEFT OUTER JOIN CMCDV
			       ON SHPDH.STATDO = CMCDV.CMCDVL 
			       AND CMCDKY = 'STATDO'
		       LEFT OUTER JOIN BZPTN
			       ON SHPDH.DPTNKY = BZPTN.PTNRKY
			       AND BZPTN.PTNRTY = 'VD'
			       AND BZPTN.PTNL05 = #{SES_OWNER} 
		 WHERE TASDH.TASKKY = TASDI.TASKKY
		 <if test="TASKKYS == null or TASKKYS == ''">
		 AND   TASDH.STATDO = 'NEW'
		 AND   TASDI.STATIT = 'NEW'
		 AND   TASDH.TASOTY = #{TASOTY}
		 AND   TASDH.WAREKY = #{WAREKY}
		 AND   TASDI.OWNRKY = #{SES_OWNER}
		 </if>
		 <if test="TASKKYS != null and TASKKYS != ''">
		 <if test="PROGID == &quot;MMV05&quot;">
		 AND   TASDH.STATDO = 'NEW'
		 AND   TASDI.STATIT = 'NEW'
		 AND   TASDH.TASOTY = #{TASOTY}
		 AND   TASDH.WAREKY = #{WAREKY}
		 AND   TASDI.OWNRKY = #{SES_OWNER}
		 </if>
		 AND     TASDH.TASKKY IN (SELECT  TRIM(REGEXP_SUBSTR(#{TASKKYS}, '[^,]+', 1, LEVEL)) 
		                       FROM    DUAL
		                       CONNECT BY REGEXP_COUNT(#{TASKKYS}, ',') + 1 &gt;= LEVEL)
		</if>
		 <if test="RANGE_SQL != null and RANGE_SQL != ''">
		 ${RANGE_SQL}
		 </if>
		 GROUP BY TASDH.TASKKY, TASDH.WAREKY, TASDH.TASOTY, TASDH.DOCDAT, TASDH.DOCCAT,
			  TASDH.DRELIN, TASDH.STATDO, TASDH.QTTAOR, TASDH.QTCOMP, TASDH.TSPKEY,
			  TASDH.DOORKY, TASDH.PTNRKY, TASDH.CREDAT, TASDH.CRETIM, TASDH.CREUSR, TASDH.LMODAT,
			  TASDH.LMOTIM, TASDH.LMOUSR, TASDH.INDBZL, TASDH.INDARC, TASDH.UPDCHK,
			  TASDH.KEEPTS, TASDH.WARETG, TASDH.DOCTXT, TASDH.USRID1, TASDH.UNAME1, TASDH.DEPTID1, TASDH.DNAME1,
			  TASDH.USRID2, TASDH.UNAME2, TASDH.DEPTID2, TASDH.DNAME2, TASDH.USRID3, TASDH.UNAME3, TASDH.DEPTID3,
			  TASDH.DNAME3, TASDH.USRID4, TASDH.UNAME4, TASDH.DEPTID4, TASDH.DNAME4
		 ORDER BY TASDH.TASKKY
	</select>
	
	<select id="MV05BODY_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			TRIM(ROWNUM)||B.TASKIT AS ROWSEQUENCE,
	    	' 'AS ROWCK,
			(
	    	  CASE WHEN A.TASOTY = '320' THEN 'V'
			       WHEN A.TASOTY = '391' THEN 'V'
				   WHEN A.TASOTY = '392' THEN 'V'
				   ELSE ' ' END
	    	) AS CONFIRM,
			(
	    	  SELECT DISTINCT STOKKY 
	      	  FROM STKKY 
	          WHERE TASKKY = B.TASKKY 
	          AND TASKIT = B.TASKIT 
	          AND ROWNUM = 1
	        ) AS STOKKY,
			A.WAREKY AS WAREKY,
			' ' AS AREATG,
	    	B.TASKKY AS TASKKY,
	    	B.TASKIT AS TASKIT,
		    B.TASKTY AS TASKTY,
		    B.RSNCOD AS RSNCOD,
		    B.TASRSN AS TASRSN,
		    B.STATIT AS STATIT,
			(
		      SELECT X.CDESC1 
		      FROM CMCDV X 
		      WHERE X.CMCDKY = 'STATIT' 
		      AND X.CMCDVL = B.STATIT
		    ) AS STATITNM,
			B.QTTAOR AS QTTAOR,
			(
		      CASE WHEN B.UPDCHK = 1 THEN B.QTCOMP 
		      ELSE B.QTTAOR
		      END
		    ) AS QTCOMP,
			B.OWNRKY AS OWNRKY,
			B.SKUKEY AS SKUKEY,
	    	B.LOTNUM AS LOTNUM,
			B.ACTCDT AS ACTCDT,
			B.ACTCTI AS ACTCTI,
			B.QTYUOM AS QTYUOM,
			B.QTYUOM AS AVAILABLEQTY,
			B.TKFLKY AS TKFLKY,
			B.STEPNO AS STEPNO,
	    	B.LSTTFL AS LSTTFL,
			B.LOCASR AS LOCASR,
			B.LOCASR AS LOCAKY,
			B.SECTSR AS SECTSR,
			B.PAIDSR AS PAIDSR,
			B.TRNUSR AS TRNUSR,
			B.STRUTY AS STRUTY,
			B.SMEAKY AS SMEAKY,
			B.SUOMKY AS SUOMKY,
			B.QTSPUM AS QTSPUM,
			B.SDUOKY AS SDUOKY,
			B.QTSDUM AS QTSDUM,
			B.LOCATG AS LOCATG,
			B.SECTTG AS SECTTG,
			B.PAIDTG AS PAIDTG,
			B.TRNUTG AS TRNUTG,
			B.TTRUTY AS TTRUTY,
			B.TMEAKY AS TMEAKY,
			B.TUOMKY AS TUOMKY,
			B.QTTPUM AS QTTPUM,
			B.TDUOKY AS TDUOKY,
			B.QTTDUM AS QTTDUM,
		    B.LOCAAC AS LOCAAC,
			B.SECTAC AS SECTAC,
			B.PAIDAC AS PAIDAC,
			B.TRNUAC AS TRNUAC,
			B.ATRUTY AS ATRUTY,
			DECODE(B.ACTCDT, '00000000', B.TMEAKY, B.AMEAKY) AS AMEAKY,
			DECODE(B.ACTCDT, '00000000', DECODE(B.TASKTY, 'PT', B.SUOMKY, B.TUOMKY), B.AUOMKY) AS AUOMKY,
			DECODE(B.ACTCDT, '00000000', B.QTTPUM, B.QTAPUM) AS QTAPUM,
			DECODE(B.ACTCDT, '00000000', B.TDUOKY, B.ADUOKY) AS ADUOKY,
			DECODE(B.ACTCDT, '00000000', B.QTTDUM, B.QTADUM) AS QTADUM,
			B.REFDKY AS REFDKY,
			B.REFDIT AS REFDIT,
			B.REFCAT AS REFCAT,
			B.REFDAT AS REFDAT,
			B.PURCKY AS PURCKY,
			B.PURCIT AS PURCIT,
			B.ASNDKY AS ASNDKY,
			B.ASNDIT AS ASNDIT,
			B.RECVKY AS RECVKY,
			B.RECVIT AS RECVIT,
			B.SHPOKY AS SHPOKY,
			B.SHPOIT AS SHPOIT,
			B.GRPOKY AS GRPOKY,
			B.GRPOIT AS GRPOIT,
			B.SADJKY AS SADJKY,
			B.SADJIT AS SADJIT,
			B.SDIFKY AS SDIFKY,
			B.SDIFIT AS SDIFIT,
			B.PHYIKY AS PHYIKY,
			B.PHYIIT AS PHYIIT,
			B.DROPID AS DROPID,
			B.DESC01 AS DESC01,
			B.DESC02 AS DESC02,
			D.ASKU01 AS ASKU01,
			D.ASKU02 AS ASKU02,
			D.ASKU03 AS ASKU03,
			D.ASKU04 AS ASKU04,
			D.ASKU05 AS ASKU05,
			B.EANCOD AS EANCOD,
			B.GTINCD AS GTINCD,
			B.SKUG01 AS SKUG01,
			B.SKUG02 AS SKUG02,
	    	B.SKUG03 AS SKUG03,
	    	B.SKUG04 AS SKUG04,
		    B.SKUG05 AS SKUG05,
		    B.GRSWGT AS GRSWGT,
		    B.NETWGT AS NETWGT,
		    B.WGTUNT AS WGTUNT,
		    B.LENGTH AS LENGTH,
		    B.WIDTHW AS WIDTHW,
		    B.HEIGHT AS HEIGHT,
		    B.CUBICM AS CUBICM,
		    B.CAPACT AS CAPACT,
		    B.WORKID AS WORKID,
		    B.WORKNM AS WORKNM,
		    B.HHTTID AS HHTTID,
		    B.AREAKY AS AREAKY,
		    B.LOTA01 AS LOTA01,
		    B.LOTA02 AS LOTA02,
		    B.LOTA03 AS LOTA03,
		    B.LOTA04 AS LOTA04,
		    B.LOTA05 AS LOTA05,
		    B.LOTA06 AS LOTA06,
		    B.LOTA07 AS LOTA07,
		    B.LOTA08 AS LOTA08,
		    B.LOTA09 AS LOTA09,
		    B.LOTA10 AS LOTA10,
		    B.LOTA11 AS LOTA11,
		    B.LOTA12 AS LOTA12,
		    B.LOTA13 AS LOTA13,
		    B.LOTA14 AS LOTA14,
		    B.LOTA15 AS LOTA15,
		    B.LOTA16 AS LOTA16,
		    B.LOTA17 AS LOTA17,
		    B.LOTA18 AS LOTA18,
		    B.LOTA19 AS LOTA19,
		    B.LOTA20 AS LOTA20,
		    B.AWMSNO AS AWMSNO,
		    B.AWMSTS AS AWMSTS,
		    B.SMANDT AS SMANDT,
		    B.SEBELN AS SEBELN,
		    B.SEBELP AS SEBELP,
		    B.SZMBLNO AS SZMBLNO,
		    B.SZMIPNO AS SZMIPNO,
		    B.STRAID AS STRAID,
		    B.SVBELN AS SVBELN,
		    B.SPOSNR AS SPOSNR,
		    B.STKNUM AS STKNUM,
		    B.STPNUM AS STPNUM,
		    B.SWERKS AS SWERKS,
		    B.SLGORT AS SLGORT,
		    B.SDATBG AS SDATBG,
		    B.STDLNR AS STDLNR,
		    B.SSORNU AS SSORNU,
		    B.SSORIT AS SSORIT,
		    B.SMBLNR AS SMBLNR,
		    B.SZEILE AS SZEILE,
		    B.SMJAHR AS SMJAHR,
		    B.SXBLNR AS SXBLNR,
		    B.SAPSTS AS SAPSTS,
		    B.DOORKY AS DOORKY,
		    B.PTLT01 AS PTLT01,
		    B.PTLT02 AS PTLT02,
		    B.PTLT03 AS PTLT03,
		    B.PTLT04 AS PTLT04,
		    B.PTLT05 AS PTLT05,
		    B.PTLT06 AS PTLT06,
		    B.PTLT07 AS PTLT07,
		    B.PTLT08 AS PTLT08,
		    B.PTLT09 AS PTLT09,
		    B.PTLT10 AS PTLT10,
		    B.PTLT11 AS PTLT11,
		    B.PTLT12 AS PTLT12,
		    B.PTLT13 AS PTLT13,
		    B.PTLT14 AS PTLT14,
		    B.PTLT15 AS PTLT15,
		    B.PTLT16 AS PTLT16,
		    B.PTLT17 AS PTLT17,
		    B.PTLT18 AS PTLT18,
		    B.PTLT19 AS PTLT19,
		    B.PTLT20 AS PTLT20,
		    C.AUTLOC AS AUTLOC,
		    B.CREDAT AS CREDAT,
		    B.CRETIM AS CRETIM,
		    B.CREUSR AS CREUSR,
		    (
		      SELECT X.NMLAST 
		      FROM USRMA X 
		      WHERE X.USERID = B.CREUSR
		    ) AS CUSRNM,
		    B.LMODAT AS LMODAT,
		    B.LMOTIM AS LMOTIM,
		    B.LMOUSR AS LMOUSR,
		    (
		    	SELECT X.NMLAST 
		      FROM USRMA X 
		      WHERE X.USERID = B.LMOUSR
		    ) AS LUSRNM,
		    B.INDBZL AS INDBZL,
		    B.INDARC AS INDARC,
		    B.UPDCHK AS UPDCHK,
		    B.PASTKY AS PASTKY,
		    B.ALSTKY AS ALSTKY,
		    RTRIM(TO_CHAR((SELECT CASE WHEN B.LOTA05 &lt;&gt; ' ' THEN TO_CHAR(ROUND(MONTHS_BETWEEN(TO_DATE(B.LOTA05, 'yyyymmdd'), SYSDATE), 1)) END  FROM DUAL),'FM9990D99'),'.') AS REMLOTA05,
  			RTRIM(TO_CHAR((SELECT CASE WHEN B.LOTA12 &lt;&gt; ' ' THEN TO_CHAR(ROUND(MONTHS_BETWEEN(SYSDATE ,TO_DATE(B.LOTA12, 'yyyymmdd')), 1)) END  FROM DUAL),'FM9990D99'),'.') AS REMLOTA12,
  			RTRIM(TO_CHAR((SELECT CASE WHEN B.LOTA04 &lt;&gt; ' ' THEN TO_CHAR(ROUND(MONTHS_BETWEEN(SYSDATE ,TO_DATE(B.LOTA04, 'yyyymmdd')), 1)) END  FROM DUAL),'FM9990D99'),'.') AS REMLOTA04,
            C.SHORTX AS LOCANUM
		FROM TASDH A
		     INNER JOIN TASDI B ON A.TASKKY = B.TASKKY
		     INNER JOIN LOCMA C ON B.LOCASR = C.LOCAKY
		     				    AND A.WAREKY = C.WAREKY
		     INNER JOIN SKUMA D ON B.SKUKEY = D.SKUKEY  
		WHERE 1=1
		AND A.TASKKY = #{TASKKY}
		<if test="PROGID == &quot;MMV05&quot;">
			<if test="UPDCHK == 1">
				AND B.UPDCHK = 1		
			</if>
			<if test="UPDCHK == 0">
				AND B.UPDCHK = 0		
			</if>
		</if>
		ORDER BY B.TASKKY, B.TASKIT
	</select>
	
	<select id="TASDICNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS CNT
		FROM TASDI
		WHERE TASKKY = #{TASKKY}
		  AND UPDCHK = 0  
	</select>
	
	<update id="TASDIUP_UPDATE" parameterType="Map">
		UPDATE TASDI 
		SET 
			QTCOMP = #{QTCOMP},
			LOCAAC = #{LOCATG},
			UPDCHK = #{UPDCHK} 
		WHERE TASKKY = #{TASKKY}
		  AND TASKIT = #{TASKIT} 
	</update>
	
	<select id="MDL16TASDI_LIST" parameterType="Map" resultType="DataMap">
		SELECT TRIM(#{RNUM})||B.TASKIT AS ROWSEQUENCE,
		       (CASE
		          WHEN D.ROWCK IS NULL THEN ' '
		          ELSE D.ROWCK END) AS ROWCK,
		       A.WAREKY AS WAREKY,
		       B.TASKKY AS TASKKY,
		       B.TASKIT AS TASKIT,
		       B.TASKTY AS TASKTY,
		       D.RSNCOD AS RSNCOD,
		       D.TASRSN AS TASRSN,
		       B.STATIT AS STATIT,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = B.STATIT) AS STATITNM,
		       B.QTTAOR AS QTTAOR,
		<if test="QTY_COPY == null or QTY_COPY == ''">
		       B.QTTAOR AS QTCOMP,
		</if>
		<if test="QTY_COPY == &quot;N&quot;">
		       (CASE
		          WHEN D.QTCOMP IS NULL AND B.ACTCDT = '00000000' THEN B.QTCOMP
		          WHEN D.QTCOMP IS NULL THEN B.QTCOMP
		          WHEN B.QTCOMP = D.QTCOMP THEN TO_NUMBER(D.QTCOMP) 
		          ELSE TO_NUMBER(B.QTCOMP)  END) AS QTCOMP,
		</if>
		<if test="QTY_COPY == &quot;Y&quot;">
		       (CASE
		          WHEN D.QTCOMP IS NULL AND B.ACTCDT = '00000000' THEN B.QTTAOR
		          WHEN D.QTCOMP IS NULL THEN B.QTCOMP
		          WHEN B.QTCOMP = D.QTCOMP THEN TO_NUMBER(D.QTCOMP) 
		          ELSE TO_NUMBER(D.QTCOMP)  END) AS QTCOMP,
		</if>
		       B.OWNRKY AS OWNRKY,
		       B.SKUKEY AS SKUKEY,
		       B.LOTNUM AS LOTNUM,
		       B.ACTCDT AS ACTCDT,
		       B.ACTCTI AS ACTCTI,
		       B.QTYUOM AS QTYUOM,
		       B.TKFLKY AS TKFLKY,
		       B.STEPNO AS STEPNO,
		       B.LSTTFL AS LSTTFL,
		       B.LOCASR AS LOCASR,
		       B.SECTSR AS SECTSR,
		       B.PAIDSR AS PAIDSR,
		       B.TRNUSR AS TRNUSR,
		       B.STRUTY AS STRUTY,
		       B.SMEAKY AS SMEAKY,
		       B.SUOMKY AS SUOMKY,
		       B.QTSPUM AS QTSPUM,
		       B.SDUOKY AS SDUOKY,
		       B.QTSDUM AS QTSDUM,
		       B.LOCATG AS LOCATG,
		       B.SECTTG AS SECTTG,
		       B.PAIDTG AS PAIDTG,
		       B.TRNUTG AS TRNUTG,
		       B.TTRUTY AS TTRUTY,
		       B.TMEAKY AS TMEAKY,
		       B.TUOMKY AS TUOMKY,
		       B.QTTPUM AS QTTPUM,
		       B.TDUOKY AS TDUOKY,
		       B.QTTDUM AS QTTDUM,
		       B.LOCATG AS LOCAAC,
		       B.SECTTG AS SECTAC,
		       B.PAIDTG AS PAIDAC,
		       B.TRNUTG AS TRNUAC,
		       B.TTRUTY AS ATRUTY,
		       DECODE(B.ACTCDT, '00000000', B.TMEAKY, B.AMEAKY) AS AMEAKY,
		       DECODE(B.ACTCDT, '00000000', DECODE(B.TASKTY, 'PT', B.SUOMKY, B.TUOMKY), B.AUOMKY) AS AUOMKY,
		       DECODE(B.ACTCDT, '00000000', B.QTTPUM, B.QTAPUM) AS QTAPUM,
		       DECODE(B.ACTCDT, '00000000', B.TDUOKY, B.ADUOKY) AS ADUOKY,
		       DECODE(B.ACTCDT, '00000000', B.QTTDUM, B.QTADUM) AS QTADUM,
		       B.REFDKY AS REFDKY,
		       B.REFDIT AS REFDIT,
		       B.REFCAT AS REFCAT,
		       B.REFDAT AS REFDAT,
		       B.PURCKY AS PURCKY,
		       B.PURCIT AS PURCIT,
		       B.ASNDKY AS ASNDKY,
		       B.ASNDIT AS ASNDIT,
		       B.RECVKY AS RECVKY,
		       B.RECVIT AS RECVIT,
		       B.SHPOKY AS SHPOKY,
		       B.SHPOIT AS SHPOIT,
		       B.GRPOKY AS GRPOKY,
		       B.GRPOIT AS GRPOIT,
		       B.SADJKY AS SADJKY,
		       B.SADJIT AS SADJIT,
		       B.SDIFKY AS SDIFKY,
		       B.SDIFIT AS SDIFIT,
		       B.PHYIKY AS PHYIKY,
		       B.PHYIIT AS PHYIIT,
		       B.DROPID AS DROPID,
		       B.DESC01 AS DESC01,
		       B.DESC02 AS DESC02,
		       B.ASKU01 AS ASKU01,
		       B.ASKU02 AS ASKU02,
		       B.ASKU03 AS ASKU03,
		       B.ASKU04 AS ASKU04,
		       B.ASKU05 AS ASKU05,
		       B.EANCOD AS EANCOD,
		       B.GTINCD AS GTINCD,
		       B.SKUG01 AS SKUG01,
		       B.SKUG02 AS SKUG02,
		       B.SKUG03 AS SKUG03,
		       B.SKUG04 AS SKUG04,
		       B.SKUG05 AS SKUG05,
		       B.GRSWGT AS GRSWGT,
		       B.NETWGT AS NETWGT,
		       B.WGTUNT AS WGTUNT,
		       B.LENGTH AS LENGTH,
		       B.WIDTHW AS WIDTHW,
		       B.HEIGHT AS HEIGHT,
		       B.CUBICM AS CUBICM,
		       B.CAPACT AS CAPACT,
		       B.WORKID AS WORKID,
		       B.WORKNM AS WORKNM,
		       B.HHTTID AS HHTTID,
		       B.AREAKY AS AREAKY,
		       B.LOTA01 AS LOTA01,
		       B.LOTA02 AS LOTA02,
		       (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'DP' AND PTNRKY = B.LOTA02) AS LOTA02NM,
		       B.LOTA03 AS LOTA03,
		       B.LOTA04 AS LOTA04,
		       B.LOTA05 AS LOTA05,
		       B.LOTA06 AS LOTA06,
		       B.LOTA07 AS LOTA07,
		       B.LOTA08 AS LOTA08,
		       B.LOTA09 AS LOTA09,
		       B.LOTA10 AS LOTA10,
		       B.LOTA11 AS LOTA11,
		       B.LOTA12 AS LOTA12,
		       B.LOTA13 AS LOTA13,
		       B.LOTA14 AS LOTA14,
		       B.LOTA15 AS LOTA15,
		       B.LOTA16 AS LOTA16,
		       B.LOTA17 AS LOTA17,
		       B.LOTA18 AS LOTA18,
		       B.LOTA19 AS LOTA19,
		       B.LOTA20 AS LOTA20,
		       B.AWMSNO AS AWMSNO,
		       B.AWMSTS AS AWMSTS,
		       B.SMANDT AS SMANDT,
		       B.SEBELN AS SEBELN,
		       B.SEBELP AS SEBELP,
		       B.SZMBLNO AS SZMBLNO,
		       B.SZMIPNO AS SZMIPNO,
		       B.STRAID AS STRAID,
		       B.SVBELN AS SVBELN,
		       B.SPOSNR AS SPOSNR,
		       B.STKNUM AS STKNUM,
		       B.STPNUM AS STPNUM,
		       B.SWERKS AS SWERKS,
		       B.SLGORT AS SLGORT,
		       B.SDATBG AS SDATBG,
		       B.STDLNR AS STDLNR,
		       B.SSORNU AS SSORNU,
		       B.SSORIT AS SSORIT,
		       B.SMBLNR AS SMBLNR,
		       B.SZEILE AS SZEILE,
		       B.SMJAHR AS SMJAHR,
		       B.SXBLNR AS SXBLNR,
		       B.SAPSTS AS SAPSTS,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       C.AUTLOC AS AUTLOC,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK
		  FROM TASDH A,
		       TASDI B,
		       LOCMA C,
		       (
		       <if test="QTY_COPY == &quot;N&quot;">
					SELECT '' AS ROWSEQ
						, '' AS ROWCK
						, '' AS TASKKY
						, '' AS TASKIT
						, '' AS QTCOMP
						, '' AS LOCAAC
						, '' AS SECTAC
						, '' AS PAIDAC
						, '' AS TRNUAC
						, '' AS RSNCOD
						, '' AS TASRSN
						, '' AS ATRUTY
					FROM DUAL
				</if>
				<if test="QTY_COPY == &quot;Y&quot;">
					SELECT '' AS ROWSEQ
						, '' AS ROWCK
						, '' AS TASKKY
						, '' AS TASKIT
						, '' AS QTCOMP
						, '' AS LOCAAC
						, '' AS SECTAC
						, '' AS PAIDAC
						, '' AS TRNUAC
						, '' AS RSNCOD
						, '' AS TASRSN
						, '' AS ATRUTY
					FROM DUAL
				</if>
		       ) D
		 WHERE A.TASKKY = B.TASKKY
		   AND A.WAREKY = C.WAREKY
		   AND B.LOCASR = C.LOCAKY
		   AND B.TASKKY = D.TASKKY(+)
		   AND B.TASKIT = D.TASKIT(+)
		   AND B.STKNUM = #{STKNUM}
		
		 ORDER BY B.TASKKY, B.TASKIT
	</select>
	
	<select id="MPT05HEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT TASDH.TASKKY AS TASKKY,
		       TASDH.WAREKY AS WAREKY,
		       NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TASDH.WAREKY),' ') AS WARENM,
		       TASDH.TASOTY AS TASOTY,
		       NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.TASOTY),' ') AS TASONM,
		       TASDH.DOCDAT AS DOCDAT,
		       TASDH.DOCCAT AS DOCCAT,
		       (SELECT SHORTX FROM DOCCM WHERE DOCCAT = TASDH.DOCCAT) AS DOCCATNM,
		       TASDH.DRELIN AS DRELIN,
		       TASDH.STATDO AS STATDO,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATDO' AND X.CMCDVL = TASDH.STATDO) AS STATDONM,
		       (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.TASOTY) AS ADJDSC,
		       TASDH.QTTAOR AS QTTAOR,
		       TASDH.QTCOMP AS QTCOMP,
		       TASDH.TSPKEY AS TSPKEY,
		       TASDH.DOORKY AS DOORKY,
		       DECODE(TASDH.WARETG, ' ', TASDH.WAREKY, TASDH.WARETG) AS WARETG,
		       TASDH.PTNRKY AS PTNRKY,
		       TASDH.CREDAT AS CREDAT,
		       TASDH.CRETIM AS CRETIM,
		       TASDH.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TASDH.CREUSR) AS CUSRNM,
		       TASDH.LMODAT AS LMODAT,
		       TASDH.LMOTIM AS LMOTIM,
		       TASDH.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TASDH.LMOUSR) AS LUSRNM,
		       TASDH.INDBZL AS INDBZL,
		       TASDH.INDARC AS INDARC,
		       TASDH.UPDCHK AS UPDCHK,
		       TASDH.KEEPTS AS KEEPTS,
		       MAX(TASDI.RECVKY) AS RECVKY,
		       MAX(TASDI.SHPOKY) AS SHPOKY,
		       MAX(SHPDH.SHPMTY) AS SHPMTY,
		       (SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'SHPMTY' AND CMCDVL = SHPDH.SHPMTY AND ROWNUM = 1) AS SHPMTYNM,
		       MAX(SHPDH.STATDO) AS SHSTATDO,
		       MAX(CMCDV.CDESC1) AS SHSTATDONM,
		       MAX(SHPDH.DPTNKY) AS DPTNKY,
		       MAX(BZPTN.NAME01) AS DPTNKYNM,
		       MAX(TASDI.SEBELN) AS SEBELN,
		       MAX(TASDI.SZMBLNO) AS SZMBLNO,
		       MAX(TASDI.SZMIPNO) AS SZMIPNO,
		       MAX(TASDI.STRAID) AS STRAID,
		       MAX(TASDI.SVBELN) AS SVBELN,
		       MAX(TASDI.STKNUM) AS STKNUM,
		       MAX(TASDI.STDLNR) AS STDLNR,
		       MAX(TASDI.SSORNU) AS SSORNU,
		       MAX(TASDI.SMBLNR) AS SMBLNR,
		       MAX(TASDI.SXBLNR) AS SXBLNR,
		       NVL(SUM(DECODE(TASDI.ACTCDT, '00000000', 1, ' ', 1, 0)), 0) AS COMPLETECNT,
		       MAX(TASDI.AREAKY) AS AREAKY,
		       MAX(TASDI.LOTA01) AS LOTA01,
         	   SHPDH.RQSHPD AS REFDAT
		  FROM TASDH
		       INNER JOIN TASDI
		               ON TASDH.TASKKY = TASDI.TASKKY
		       LEFT OUTER JOIN SHPDI
		               ON SHPDI.SHPOKY = TASDI.SHPOKY 
		               AND SHPDI.SHPOIT = TASDI.SHPOIT
		       LEFT OUTER JOIN SHPDH 
		               ON SHPDH.SHPOKY = TASDI.SHPOKY
		       LEFT OUTER JOIN DOCTM
		               ON SHPDH.DOCUTY = DOCTM.DOCUTY
		       LEFT OUTER JOIN CMCDV
		               ON SHPDH.STATDO = CMCDV.CMCDVL 
		               AND CMCDKY = 'STATDO'
		       LEFT OUTER JOIN BZPTN
		               ON SHPDH.DPTNKY = BZPTN.PTNRKY
		               AND BZPTN.PTNRTY = 'CT'
		 WHERE TASDH.WAREKY = #{WAREKY}
<!-- 		   AND TASDI.OWNRKY = #{OWNRKY} -->
		   AND TASDI.STATIT = 'NEW'
		   AND TASDH.TASKKY = #{TASKKY}
		   <if test="DOCDAT1 != null and DOCDAT1 != ''">
		   	 AND TASDH.DOCDAT &gt;= #{DOCDAT1} AND TASDH.DOCDAT &lt;= #{DOCDAT2}
		   </if>
<!-- 		<isNotEmpty property="REFDAT"> -->
<!-- 		   AND SHPDH.RQSHPD = #{REFDAT} -->
<!-- 		</isNotEmpty> -->
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		 GROUP BY TASDH.TASKKY, TASDH.WAREKY, TASDH.TASOTY, TASDH.DOCDAT, TASDH.DOCCAT,
		          TASDH.DRELIN, TASDH.STATDO, TASDH.QTTAOR, TASDH.QTCOMP, TASDH.TSPKEY,
		          TASDH.DOORKY, TASDH.PTNRKY, TASDH.CREDAT, TASDH.CRETIM, TASDH.CREUSR, TASDH.LMODAT,
		          TASDH.LMOTIM, TASDH.LMOUSR, TASDH.INDBZL, TASDH.INDARC, TASDH.UPDCHK,
		          TASDH.KEEPTS, TASDH.WARETG, SHPDH.SHPMTY, SHPDH.RQSHPD
		 ORDER BY TASDH.TASKKY
	</select>
	
	<select id="CALL_BATCH_PKTOT_MAP" parameterType="Map" resultType="DataMap">
		 { call SZP_BATCH_PICKING_TOTSUB( #{TASKKY}, #{SES_USER_ID} )}
	</select>
	
	<!-- PT10 SQL START -->
	<select id="PT10_LIST" parameterType="Map" resultType="String">
		WITH WM_T AS (
		    SELECT NVL(WM.NAME01,' ') AS WARENM  
		    FROM WAHMA WM
		    WHERE WM.WAREKY = #{WAREKY}
		),
		OE_T AS (
		    SELECT NVL(OE.NAME01,' ') AS OWNRNM
		    FROM OWNER OE 
		    WHERE OE.OWNRKY = #{OWNRKY}
		),
        DOCTM_T AS (
          SELECT DT.DOCUTY
             , DT.SHORTX AS DOCUTYNM
          FROM DOCTM DT
        ),
        DOCCM_T AS (
          SELECT DC.DOCCAT
             , NVL(DL.SHORTX, DC.SHORTX) AS DOCCATNM
          FROM DOCCM DC
            LEFT OUTER JOIN DOCCM_LANG DL ON DL.LANGKY = #{LANGKY} AND DL.DOCCAT = DC.DOCCAT
        ),
		STATDO_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'STATDO'
		),
		STATIT_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'STATIT'
		),
		LOTA02_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'LOTA02'
		),
		LOTA06_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'LOTA06'
		),
		D_UOMQTY_T AS (
		  	SELECT A.MEASKY
                 , A.D_UOMKEY
			     , ( CASE WHEN A.QTAUOM_KG=0 THEN 0 ELSE (A.QTPUOM_KG / A.QTAUOM_KG) END ) AS DSN_KG
			     , ( CASE WHEN A.QTAUOM_BAG=0 THEN 0 ELSE (A.QTPUOM_BAG / A.QTAUOM_BAG) END ) AS DSN_BAG
			     , ( CASE WHEN A.QTAUOM_BOX=0 THEN 0 ELSE (A.QTPUOM_BOX / A.QTAUOM_BOX) END ) AS DSN_BOX
			     , ( CASE WHEN A.QTAUOM_PAL=0 THEN 0 ELSE (A.QTPUOM_PAL / A.QTAUOM_PAL) END ) AS DSN_PAL
			     , ( CASE WHEN A.QTAUOM_SOK=0 THEN 0 ELSE (A.QTPUOM_SOK / A.QTAUOM_SOK) END ) AS DSN_SOK
			     , ( CASE WHEN A.QTAUOM_EA=0 THEN 0 ELSE (A.QTPUOM_EA / A.QTAUOM_EA) END ) AS DSN_EA
			FROM (
			    SELECT MI.MEASKY
			         , MAX( CASE WHEN MI.INDDFU='V' THEN MI.UOMKEY ELSE ' ' END ) AS D_UOMKEY
			         , SUM( CASE WHEN MI.UOMKEY='KG' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_KG
			         , SUM( CASE WHEN MI.UOMKEY='KG' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_KG
			         , SUM( CASE WHEN MI.UOMKEY='BAG' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_BAG
			         , SUM( CASE WHEN MI.UOMKEY='BAG' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_BAG     
			         , SUM( CASE WHEN MI.UOMKEY='BOX' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_BOX
			         , SUM( CASE WHEN MI.UOMKEY='BOX' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_BOX     
			         , SUM( CASE WHEN MI.UOMKEY='PAL' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_PAL
			         , SUM( CASE WHEN MI.UOMKEY='PAL' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_PAL     
			         , SUM( CASE WHEN MI.UOMKEY='SOK' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_SOK
			         , SUM( CASE WHEN MI.UOMKEY='SOK' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_SOK     
			         , SUM( CASE WHEN MI.UOMKEY='EA' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_EA
			         , SUM( CASE WHEN MI.UOMKEY='EA' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_EA     
			    FROM MEASI MI
			    WHERE MI.WAREKY = #{WAREKY}
			       AND EXISTS (
			                     SELECT 'X'
			                     FROM TASDH TH
								       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.SKUKEY = MI.MEASKY
								       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
								       INNER JOIN LOCMA LM ON TI.LOCAAC = LM.LOCAKY AND TH.WAREKY = LM.WAREKY
								       LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = TI.OWNRKY AND SLM.PLNTKY = TI.LOTA02 AND SLM.STLKY  = TI.LOTA01
								       LEFT OUTER JOIN SKUMA_LANG SL ON SL.LANGKY = #{LANGKY} AND SL.OWNRKY = SM.OWNRKY AND SL.SKUKEY = SM.SKUKEY
								 WHERE TH.WAREKY = #{WAREKY}
								   AND TI.OWNRKY = #{OWNRKY}
								   AND EXISTS (
								                SELECT 'X'
								                FROM DOCPG X
								                WHERE X.PROGID = #{PROGID}
								                  AND X.DOCUTY = TH.TASOTY
								                  AND X.DOCCAT = TH.DOCCAT
								              )
								   <if test="LOTA06 != null and LOTA06 != ''">
								    AND TI.LOTA06 = #{LOTA06}
								   </if>
								   <if test="SKUL01 != null and SKUL01 != ''">
								    AND SM.SKUL01 = #{SKUL01}
								   </if>
								   <if test="SKUG01 != null and SKUG01 != ''">
									AND SM.SKUG01 = #{SKUG01}
								  </if>
								  <if test="RANGE_SQL != null and RANGE_SQL != ''">
								    ${RANGE_SQL}
								   </if>
			                  )
			    GROUP BY MI.MEASKY
			) A
		)
		SELECT TH.TASKKY
		     , TI.TASKIT
		     , TI.OWNRKY
		     , ( SELECT OWNRNM FROM OE_T ) AS OWNRNM
		     , TH.WAREKY
             , ( SELECT WARENM FROM WM_T ) AS WARENM
		     , TH.DOCDAT
		     , TH.DOCCAT
		     , ( SELECT X.DOCCATNM FROM DOCCM_T X WHERE X.DOCCAT=TH.DOCCAT ) AS DOCCATNM
		     , TH.TASOTY AS DOCUTY
		     , ( SELECT X.DOCUTYNM FROM DOCTM_T X WHERE X.DOCUTY=TH.TASOTY ) AS DOCUTYNM
		     , TH.STATDO
		     , ( SELECT X.CDESC1 FROM STATDO_T X WHERE X.CMCDVL=TH.STATDO ) AS STATDONM
		     , TH.DOCTXT
		     , TI.STATIT
		     , ( SELECT X.CDESC1 FROM STATIT_T X WHERE X.CMCDVL=TI.STATIT ) AS STATITNM
		     , LM.AREAKY
		     , LM.ZONEKY
		     , TI.LOCASR
		     , TI.TRNUSR
		     , TI.LOCATG
		     , TI.TRNUTG
		     , TI.LOCAAC
		     , TI.TRNUAC
		     , TI.SKUKEY
		     , NVL(SL.DESC01, SM.DESC01) AS DESC01
		     , NVL(SL.DESC02, SM.DESC02) AS DESC02
		     , SM.EANCOD
		     , TI.QTTAOR
		     , TI.QTCOMP
		     , SM.DUOMKY AS UOMKEY
		     
		     , TI.LOTA01
		     , SLM.STLNM AS LOTA01NM
		     , TI.LOTA02
		     , ( SELECT X.CDESC1 FROM LOTA02_T X WHERE X.CMCDVL=TI.LOTA02 ) AS LOTA02NM
		     , TI.LOTA03
		     , TI.LOTA04
		     , TI.LOTA05
		     , TI.LOTA06
		     , TI.LOTA07
		     , TI.LOTA08
		     , TI.LOTA09
		     , TI.LOTA10
		     , TI.LOTA11
		     , TI.LOTA12
		     , TI.LOTA13		     
		     , TI.LOTA14
		     , TI.LOTA15
		     
		     , TI.RECVKY
		     , TI.RECVIT
		     , TI.CREDAT
		     , TI.CRETIM
		     , TI.CREUSR
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = TI.CREUSR),' ') AS CUSRNM
		     , TI.LMODAT
		     , TI.LMOTIM
		     , TI.LMOUSR
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = TI.LMOUSR),' ') AS LUSRNM
		     , SM.SKUL05
		     
		     , TH.TASOTY
		     , ( SELECT X.DOCUTYNM FROM DOCTM_T X WHERE X.DOCUTY=TH.TASOTY ) AS TASONM
		     , TI.AUOMKY
		     
		     , ( SELECT X.DOCUTYNM FROM DOCTM_T X WHERE X.DOCUTY=TH.TASOTY ) AS TASSTX
		     
<!-- 		     , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY, 'KG')),'0') AS TOT -->
<!-- 			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY, 'BAG')),'0') AS BAG -->
<!-- 			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY, 'BOX')),'0') AS BOX -->
<!-- 			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY, 'PAL')),'0') AS PLT -->
<!-- 			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY, 'SOK')),'0') AS SOK -->
<!-- 			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY, 'EA')),'0') AS EA -->
			 
			 , TO_CHAR((
 					CASE WHEN TI.AUOMKY='KG' 
 					       THEN TI.QTTAOR
                         WHEN TI.AUOMKY!='KG' AND DUMO_T.D_UOMKEY=TI.AUOMKY
                           THEN
                           (CASE WHEN DUMO_T.DSN_KG=0 THEN 0 ELSE (TI.QTTAOR / DUMO_T.DSN_KG) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_KG=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY)),0) / DUMO_T.DSN_KG ) END)
                    END 
			   ), 'FM99999999999999999990.000') AS TOT
			 , TO_CHAR((  
 					CASE WHEN TI.AUOMKY='BAG' 
 					       THEN TI.QTTAOR
                         WHEN TI.AUOMKY!='BAG' AND DUMO_T.D_UOMKEY=TI.AUOMKY
                           THEN
                           (CASE WHEN DUMO_T.DSN_BAG=0 THEN 0 ELSE (TI.QTTAOR / DUMO_T.DSN_BAG) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_BAG=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY)),0) / DUMO_T.DSN_BAG ) END)
                    END 
			   ), 'FM99999999999999999990.000') AS BAG
			 , TO_CHAR((  
 					CASE WHEN TI.AUOMKY='BOX' 
 					       THEN TI.QTTAOR
                         WHEN TI.AUOMKY!='BOX' AND DUMO_T.D_UOMKEY=TI.AUOMKY
                           THEN
                           (CASE WHEN DUMO_T.DSN_BOX=0 THEN 0 ELSE (TI.QTTAOR / DUMO_T.DSN_BOX) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_BOX=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY)),0) / DUMO_T.DSN_BOX ) END)
                    END 
			   ), 'FM99999999999999999990.000') AS BOX
			 , TO_CHAR(( 
 					CASE WHEN TI.AUOMKY='PAL' 
 					       THEN TI.QTTAOR
                         WHEN TI.AUOMKY!='PAL' AND DUMO_T.D_UOMKEY=TI.AUOMKY
                           THEN
                           (CASE WHEN DUMO_T.DSN_PAL=0 THEN 0 ELSE (TI.QTTAOR / DUMO_T.DSN_PAL) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_PAL=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY)),0) / DUMO_T.DSN_PAL ) END)
                    END 
			   ), 'FM99999999999999999990.000') AS PLT
			 , TO_CHAR(( 
 					CASE WHEN TI.AUOMKY='SOK' 
 					       THEN TI.QTTAOR
                         WHEN TI.AUOMKY!='SOK' AND DUMO_T.D_UOMKEY=TI.AUOMKY
                           THEN
                           (CASE WHEN DUMO_T.DSN_SOK=0 THEN 0 ELSE (TI.QTTAOR / DUMO_T.DSN_SOK) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_SOK=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY)),0) / DUMO_T.DSN_SOK ) END)
                    END 
			   ), 'FM99999999999999999990.000') AS SOK
			 , TO_CHAR(( 
 					CASE WHEN TI.AUOMKY='EA' 
 					       THEN TI.QTTAOR
                         WHEN TI.AUOMKY!='EA' AND DUMO_T.D_UOMKEY=TI.AUOMKY
                           THEN
                           (CASE WHEN DUMO_T.DSN_EA=0 THEN 0 ELSE (TI.QTTAOR / DUMO_T.DSN_EA) END)
                         ELSE
<!--                            (CASE WHEN MI.QTAUOM=0 OR DUMO_T.DSN_EA=0 THEN 0 ELSE ( ((TI.QTTAOR / MI.QTAUOM ) * MI.QTPUOM) / DUMO_T.DSN_EA ) END) -->
                           (CASE WHEN DUMO_T.DSN_EA=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, TI.SKUKEY, TI.QTTAOR, TI.AUOMKY)),0) / DUMO_T.DSN_EA ) END)
                           
                    END 
			   ), 'FM99999999999999999990.000') AS EA
		     
		  FROM TASDH TH
		    INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		    INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		    INNER JOIN LOCMA LM ON TI.LOCAAC = LM.LOCAKY AND TH.WAREKY = LM.WAREKY
		    LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = TI.OWNRKY AND SLM.PLNTKY = TI.LOTA02 AND SLM.STLKY  = TI.LOTA01
		    LEFT OUTER JOIN SKUMA_LANG SL ON SL.LANGKY = #{LANGKY} AND SL.OWNRKY = SM.OWNRKY AND SL.SKUKEY = SM.SKUKEY
		       
		    LEFT OUTER JOIN D_UOMQTY_T DUMO_T ON DUMO_T.MEASKY = TI.SKUKEY 
		       
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TI.OWNRKY = #{OWNRKY}
		   AND EXISTS (
		                SELECT 'X'
		                FROM DOCPG X
		                WHERE X.PROGID = #{PROGID}
		                  AND X.DOCUTY = TH.TASOTY
		                  AND X.DOCCAT = TH.DOCCAT
		              )
		   <if test="LOTA06 != null and LOTA06 != ''">
		    AND TI.LOTA06 = #{LOTA06}
		   </if>
		   <if test="SKUL01 != null and SKUL01 != ''">
		    AND SM.SKUL01 = #{SKUL01}
		   </if>
		   <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
		    ${RANGE_SQL}
		   </if>
		 ORDER BY TI.TASKKY DESC, TI.TASKIT  
	</select>
	
	<!-- PT10 SQL END -->
	
	<!-- PT01 적치전략 목록 조회 -->
	<select id="COMMON_PASTH_LIST" parameterType="Map" resultType="DataMap">
		SELECT PASTKY AS VALUE_COL
		     , SHORTX AS TEXT_COL
		  FROM PASTH
		 WHERE 1 = 1
		   AND WAREKY = #{WAREKY}
		 ORDER BY PASTKY
	</select>
    
	<!-- PT01 추천 적치전략 조회 -->
	<!-- 
	<select id="PUTAWAY_LOCATION_PROC_CALL1_MAP" parameterClass="Map" resultClass="DataMap">
		{call P_AIRWMS_PUTAWAY_LOCATION (  #{WAREKY}, #{PASTKY}
			                             , #{OWNRKY}, #{SKUKEY}
			                             , #{LOTA01}, #{LOTA02}
			                             , #{LOCASR}, #{LOCAKY}
			                             )}
	</select>
	 -->
	 
	<!-- DL04 할당전략 콤보 목록 조회 -->
	<select id="COMMON_ALSTH_LIST" parameterType="Map" resultType="DataMap">
		SELECT ALSTKY AS VALUE_COL
		     , SHORTX AS TEXT_COL
		 FROM ALSTH
		 WHERE 1 = 1
		   		AND WAREKY = #{WAREKY}
		 ORDER BY ALSTKY
	</select> 
	 
	 <!-- TK01 재고조정출고  -->
	 <select id="TK01_DPTNKYNM_MAP" parameterType="Map" resultType="DataMap">
		SELECT NAME01 AS DPTNKYNM
		  FROM BZPTN
		 WHERE PTNRTY = #{PTNRTY}
		   AND OWNRKY = #{OWNRKY}
		   AND PTNRKY = #{DPTNKY}
	</select>
	
	<!-- TK01 사유코드  -->
	<select id="TK01_RSNCD_SET_LIST" parameterType="Map" resultType="DataMap">
		SELECT RSNCOD AS VALUE_COL
		     , SHORTX AS TEXT_COL
		  FROM RSNCD
		 WHERE DOCUTY = #{DOCUTY}
		 <if test="RSNCOD != null and RSNCOD != ''"> 		 
		 AND RSNCOD =#{RSNCOD}
		 </if>
	</select>
	
	<!-- TK09,TK10 사유코드  -->
	<select id="TK0910_RSNCD_SET_LIST" parameterType="Map" resultType="DataMap">
		SELECT RSNCOD AS VALUE_COL
		     , SHORTX AS TEXT_COL
		  FROM RSNCD
		 WHERE DOCUTY IN ('399', '356', '361')
		 <if test="RSNCOD != null and RSNCOD != ''"> 		 
		 AND RSNCOD =#{RSNCOD}
		 </if>
	</select>
	
	<select id="TK01_LIST" parameterType="Map" resultType="DataMap">
		WITH TK01 AS (
			SELECT T1.PROGID
			     , T1.DOCCAT 
			     , T1.DOCUTY 
			FROM DOCPG T1
			WHERE T1.PROGID=#{PROGID}
			  AND ROWNUM=1
		)
		SELECT ' ' AS SHPOKY
			 , #{WAREKY} AS WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM
			 , NVL(#{OWNRKY},' ') AS OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = NVL(#{OWNRKY},' ')),' ') AS OWNRNM
			 , F_SET_DATE(SYSDATE) AS DOCDAT
			 , (SELECT X.DOCCAT FROM TK01 X) AS DOCCAT
			 , SZF_GET_DOCCAT_TEXT(#{LANGKY}, (SELECT X.DOCCAT FROM TK01 X)) AS DOCCATNM
			 , (SELECT X.DOCUTY FROM TK01 X) AS DOCUTY
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, (SELECT X.DOCUTY FROM TK01 X)) AS DOCUTYNM
			 , 'NEW' AS STATDO
			 , (SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', 'NEW') FROM DUAL) AS STATDONM
			 , ' ' AS DOCTXT
			 , ' ' AS PTNRTY
			 , ' ' AS DPTNKY
		     , ' ' AS DPTNKYNM
		     , 'V' AS SAPIFYN
		     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS ASNDAT
		     , 'WMS_IF_314' AS IFID
		FROM DUAL
	</select>
	
	<select id="TK01Sub_LIST" parameterType="Map" resultType="DataMap">
	 SELECT    A.STOKKY
	 	   	 , A.WAREKY	  		 
	  		 , A.AREAKY  
			 , A.ZONEKY  
			 , A.LOTNUM  
			 , A.LOCASR  
			 , A.TRNUSR  
	  		 , A.LOCATG
	  		 , A.TRNUTG 
	  		 , A.LOCAAC
	  		 , A.TRNUAC	
	  		 , A.OWNRKY 
			 , A.SKUKEY 
	  		 , A.DESC01
	  		 , A.DESC02
	  		 , A.QTSIWH
	  		 , A.QTABLE
	  		 , A.QTTAOR
	  		 , A.UOMKEY
			 , A.SHPOKY
			 , A.SHPOIT
			 , A.DROPID
	  		 , A.LOTA01
	  		 , A.LOTA01NM
			 , A.LOTA02
			 , A.LOTA02NM
			 , A.LOTA03
			 , A.LOTA04
			 , A.LOTA05
			 , A.LOTA06
			 , A.LOTA06NM     
			 , A.LOTA07
			 , A.LOTA08
			 , A.LOTA08NM
			 , A.LOTA09
			 , A.LOTA09NM
			 , A.LOTA10
			 , A.LOTA11
			 , A.LOTA12
			 , A.LOTA13
			 , A.LOTA14
			 , A.LOTA15
			 , A.LOTA16
			 , A.LOTA17
			 , A.LOTA18
			 , A.LOTA19
			 , A.LOTA20
	  		 , A.RSNCOD
	  		 , A.RSNTXT
	  		 , A.SKUL01	
			 , A.TOT   
			 , A.BAG  
			 , A.BOX  
			 , A.PLT  
			 , A.SOK  
			 , A.EA	
			 , A.BOXBAG 
			 , A.USEQTY  
			 , A.DOCDAT
	 FROM(
	 
			WITH TK01 AS (
				SELECT T1.PROGID
				     , T1.DOCCAT 
				     , T1.DOCUTY 
				FROM DOCPG T1
				WHERE T1.DOCUTY = #{TASOTY}
				  AND ROWNUM=1
			)
			
			SELECT ST.STOKKY AS STOKKY
			     , ST.WAREKY AS WAREKY
			     , ST.AREAKY AS AREAKY
			     , ST.ZONEKY AS ZONEKY
			     , ST.LOTNUM AS LOTNUM
			     , ST.LOCAKY AS LOCASR
			     , ST.TRNUID AS TRNUSR
			     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM TK01 X)),' ') AS LOCATG
			     , ' ' AS TRNUTG
			     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM TK01 X)),' ') AS LOCAAC
			     , ' ' AS TRNUAC
			     , ST.OWNRKY AS OWNRKY
			     , ST.SKUKEY AS SKUKEY
			     , SZF_GET_SKU_DESC01_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC01
			     , SZF_GET_SKU_DESC02_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC02
			     , ST.QTSIWH AS QTSIWH
			     , ((ST.QTSIWH) - GREATEST((ST.QTSALO),(ST.QTSPMO)) - (ST.QTSBLK)) AS QTABLE
			     <!-- , 0 AS QTTAOR -->
			     , ST.QTSIWH AS QTTAOR
			     , SM.DUOMKY AS UOMKEY		     
			     , ST.SHPOKY AS SHPOKY
			     , ST.SHPOIT AS SHPOIT
			     , ' ' AS DROPID
			     , ST.LOTA01 AS LOTA01
			 	 , NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = ST.LOTA01 AND PLNTKY = ST.LOTA02 AND WAREKY = ST.WAREKY)), ' ') AS LOTA01NM
			 	 , ST.LOTA02 AS LOTA02
			 	 , SZF_GET_CMCDV_CDESC1_TEXT(ST.OWNRKY, 'LOTA02', ST.LOTA02) AS LOTA02NM
			     , ST.LOTA03 AS LOTA03
			     , ST.LOTA04 AS LOTA04
			     , ST.LOTA05 AS LOTA05
			     , ST.LOTA06
			     , (SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', ST.LOTA06) FROM DUAL) AS LOTA06NM
			     , ST.LOTA07 AS LOTA07
			     , ST.LOTA08 AS LOTA08
			     , SZF_GET_CMCDV_CDESC1_TEXT(ST.OWNRKY, 'NATNKY', ST.LOTA08) AS LOTA08NM
			     , ST.LOTA09 AS LOTA09
			     , NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = ST.OWNRKY AND PTNRTY = 'CT' AND PTNRKY= ST.LOTA09), ' ') AS LOTA09NM
			     , ST.LOTA10 AS LOTA10
			     , ST.LOTA11 AS LOTA11
			     , ST.LOTA12 AS LOTA12
			     , ST.LOTA13 AS LOTA13
			     , ST.LOTA14 AS LOTA14
			     , ST.LOTA15 AS LOTA15
			     , ST.LOTA16 AS LOTA16
			     , ST.LOTA17 AS LOTA17
			     , ST.LOTA18 AS LOTA18
			     , ST.LOTA19 AS LOTA19
			     , ST.LOTA20 AS LOTA20	
			     , ' ' AS RSNCOD
			     , ' ' AS RSNTXT
			     , NVL((SELECT SKUL01 FROM SKUMA WHERE SKUKEY = ST.SKUKEY AND OWNRKY = #{OWNRKY}),' ') AS SKUL01			 
				 , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'KG')),'0') AS TOT
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BAG')),'0') AS BAG
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BOX')),'0') AS BOX
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'PAL')),'0') AS PLT
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'SOK')),'0') AS SOK
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'EA')),'0') AS EA 
	             , CASE WHEN ST.QTSIWH = 0 THEN 0 
						ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BOX'))),'0')
					END AS BOXBAG
	             , CASE WHEN ST.AREAKY = 'SHP' THEN 0
					ELSE ST.QTSIWH - ST.QTSBLK
								  - GREATEST(ST.QTSALO, ST.QTSPMO)
								  - (CASE WHEN ST.LOTA06 IN ('00') OR ST.QTSPMO > 0 THEN 0
										  ELSE ST.QTSIWH
									 END)
			   END AS USEQTY	
			     , RV.DOCDAT    
			  FROM STKKY ST
			       INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY
			                          AND SM.SKUKEY = ST.SKUKEY
			                          
			       LEFT JOIN (SELECT B.DOCDAT
			                       , A.RECVKY
			                       , A.RECVIT
                                FROM RECDI A 
                                     INNER JOIN RECDH B
                                        ON A.RECVKY = B.RECVKY
                               WHERE 1 = 1 
                             <if test="WAREKY != null and WAREKY != ''"> 
			   					 AND B.WAREKY = #{WAREKY}
			   				 </if>
     			   			 <if test="OWNRKY != null and OWNRKY != ''"> 
			   					 AND B.OWNRKY = #{OWNRKY}
			   				 </if>
                             ) RV
                    ON ST.RECVKY = RV.RECVKY
                    AND ST.RECVIT = RV.RECVIT                   
			 WHERE 1 = 1
			   AND ST.QTSIWH > 0
			   AND ST.QTSPMO = 0
			   AND ST.QTSBLK = 0
			   AND ST.AREAKY NOT IN ('SYS', 'SHP','CRT','RTS')
			   <!-- 2023.01.03. PI 요청 수정사항. -->
			   AND ST.LOCAKY NOT IN ('SCRLOC')
			   AND ST.LOTA06 = '00'
<!-- 			   AND ST.LOCAKY NOT IN ('RTNLOC','SCRLOC') -->
			   <if test="WAREKY != null and WAREKY != ''"> 
			   AND ST.WAREKY = #{WAREKY}
			   </if>
			   <if test="OWNRKY != null and OWNRKY != ''"> 
			   AND ST.OWNRKY = #{OWNRKY}
			   </if>
			   
			   <if test="SKUG01 != null and SKUG01 != ''">
				AND SM.SKUG01 = #{SKUG01}
			   </if>
			    
			   <if test="SKUL01 != null and SKUL01 != ''">
			    AND SM.SKUL01 = #{SKUL01}
			   </if>
	
			   <if test="RANGE_SQL != null and RANGE_SQL != ''"> 
			  	 ${RANGE_SQL} 
			   </if>	
			
			) A 
			
			WHERE 1=1
			AND A.USEQTY > 0
		   <if test="DESC01 != null and DESC01 != ''">
		    AND A.DESC01 LIKE '%${DESC01}%'
		   </if>	   
		   <if test="SKUL01 != null and SKUL01 != ''">
		    AND A.SKUL01 LIKE '%${SKUL01}%'
		   </if>
		   
	</select>
	
	<select id="TK01_AVAILABLE_STOCK_LIST" parameterType="Map" resultType="DataMap">
	SELECT     ST.STOKKY  AS "STOKKY",
		       ST.WAREKY  AS "WAREKY",
		       ST.LOTNUM  AS "LOTNUM",
		       ST.LOCAKY  AS "LOCAKY",
		       ST.TRNUID  AS "TRNUID",
		       ST.SECTID  AS "SECTID",
		       ST.PACKID  AS "PACKID",
		       ST.QTSIWH  AS "QTSIWH",
		       ST.QTSALO  AS "QTSALO",
		       ST.QTSPMO  AS "QTSPMO",
		       ST.QTSPMI  AS "QTSPMI",
		       ST.QTSBLK  AS "QTSBLK",
		       ST.QTYUOM  AS "QTYUOM",
		       ST.TRUNTY  AS "TRUNTY",
		       ST.MEASKY  AS "MEASKY",
		       ST.UOMKEY  AS "UOMKEY",
		       ST.QTPUOM  AS "QTPUOM",
		       ST.DUOMKY  AS "DUOMKY",
		       ST.QTDUOM  AS "QTDUOM",
		       ST.TKFLKY  AS "TKFLKY",
		       ST.STEPNO  AS "STEPNO",
		       ST.LSTTFL  AS "LSTTFL",
		       ST.SRCSKY  AS "SRCSKY",
		       ST.UOMDOC  AS "UOMDOC",
		       ST.CNTBSK  AS "CNTBSK",
		       ST.NUPDPS  AS "NUPDPS",
		       ST.REFDKY  AS "REFDKY",
		       ST.REFDIT  AS "REFDIT",
		       ST.REFCAT  AS "REFCAT",
		       ST.REFDAT  AS "REFDAT",
		       ST.PURCKY  AS "PURCKY",
		       ST.PURCIT  AS "PURCIT",
		       ST.ASNDKY  AS "ASNDKY",
		       ST.ASNDIT  AS "ASNDIT",
		       ST.RECVKY  AS "RECVKY",
		       ST.RECVIT  AS "RECVIT",
		       ST.SHPOKY  AS "SHPOKY",
		       ST.SHPOIT  AS "SHPOIT",
		       ST.GRPOKY  AS "GRPOKY",
		       ST.GRPOIT  AS "GRPOIT",
		       ST.TASKKY  AS "TASKKY",
		       ST.TASKIT  AS "TASKIT",
		       ST.SADJKY  AS "SADJKY",
		       ST.SADJIT  AS "SADJIT",
		       ST.SDIFKY  AS "SDIFKY",
		       ST.SDIFIT  AS "SDIFIT",
		       ST.PHYIKY  AS "PHYIKY",
		       ST.PHYIIT  AS "PHYIIT",
		       ST.OWNRKY  AS "OWNRKY",
		       ST.SKUKEY  AS "SKUKEY",
		       ST.LOTA01  AS "LOTA01",
		       ST.LOTA02  AS "LOTA02",
		       ST.LOTA03  AS "LOTA03",
		       ST.LOTA04  AS "LOTA04",
		       ST.LOTA05  AS "LOTA05",
		       ST.LOTA06  AS "LOTA06",
		       ST.LOTA07  AS "LOTA07",
		       ST.LOTA08  AS "LOTA08",
		       ST.LOTA09  AS "LOTA09",
		       ST.LOTA10  AS "LOTA10",
		       ST.LOTA11  AS "LOTA11",
		       ST.LOTA12  AS "LOTA12",
		       ST.LOTA13  AS "LOTA13",
		       ST.LOTA14  AS "LOTA14",
		       ST.LOTA15  AS "LOTA15",
		       ST.LOTA16  AS "LOTA16",
		       ST.LOTA17  AS "LOTA17",
		       ST.LOTA18  AS "LOTA18",
		       ST.LOTA19  AS "LOTA19",
		       ST.LOTA20  AS "LOTA20",
		       ST.AWMSNO  AS "AWMSNO",
		       ST.DESC01  AS "DESC01",
		       ST.DESC02  AS "DESC02",
		       ST.ASKU01  AS "ASKU01",
		       ST.ASKU02  AS "ASKU02",
		       ST.ASKU03  AS "ASKU03",
		       ST.ASKU04  AS "ASKU04",
		       ST.ASKU05  AS "ASKU05",
		       ST.EANCOD  AS "EANCOD",
		       ST.GTINCD  AS "GTINCD",
		       ST.SKUG01  AS "SKUG01",
		       ST.SKUG02  AS "SKUG02",
		       ST.SKUG03  AS "SKUG03",
		       ST.SKUG04  AS "SKUG04",
		       ST.SKUG05  AS "SKUG05",
		       ST.GRSWGT  AS "GRSWGT",
		       ST.NETWGT  AS "NETWGT",
		       ST.WGTUNT  AS "WGTUNT",
		       ST.LENGTH  AS "LENGTH",
		       ST.WIDTHW  AS "WIDTHW",
		       ST.HEIGHT  AS "HEIGHT",
		       ST.CUBICM  AS "CUBICM",
		       ST.CAPACT  AS "CAPACT",
		       ST.ZONEKY  AS "ZONEKY",
		       ST.TKZONE  AS "TKZONE",
		       ST.AREAKY  AS "AREAKY",
		       ST.SMANDT  AS "SMANDT",
		       ST.SEBELN  AS "SEBELN",
		       ST.SEBELP  AS "SEBELP",
		       ST.SZMBLNO AS "SZMBLNO",
		       ST.SZMIPNO AS "SZMIPNO",
		       ST.STRAID  AS "STRAID",
		       ST.SVBELN  AS "SVBELN",
		       ST.SPOSNR  AS "SPOSNR",
		       ST.STKNUM  AS "STKNUM",
		       ST.STPNUM  AS "STPNUM",
		       ST.SWERKS  AS "SWERKS",
		       ST.SLGORT  AS "SLGORT",
		       ST.SDATBG  AS "SDATBG",
		       ST.STDLNR  AS "STDLNR",
		       ST.SSORNU  AS "SSORNU",
		       ST.SSORIT  AS "SSORIT",
		       ST.SMBLNR  AS "SMBLNR",
		       ST.SZEILE  AS "SZEILE",
		       ST.SMJAHR  AS "SMJAHR",
		       ST.SXBLNR  AS "SXBLNR",
		       ST.SAPSTS  AS "SAPSTS",
		       ST.SBKTXT  AS "SBKTXT",
		       ST.CREDAT  AS "CREDAT",
		       ST.CRETIM  AS "CRETIM",
		       ST.CREUSR  AS "CREUSR",
		       ST.LMODAT  AS "LMODAT",
		       ST.LMOTIM  AS "LMOTIM",
		       ST.LMOUSR  AS "LMOUSR",
		       NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = #{TASOTY}), ' ') AS "LOCATG"
		  FROM STKKY ST
		       INNER JOIN LOCMA L
		               ON L.WAREKY = ST.WAREKY
		              AND L.LOCAKY = ST.LOCAKY
		 WHERE 1 = 1
			   AND ST.QTSIWH > 0
			   AND ST.QTSPMO = 0
			   AND ST.QTSBLK = 0
			  
			   <if test="WAREKY != null and WAREKY != ''"> 
			   AND ST.WAREKY = #{WAREKY}
			   </if>
			   <if test="OWNRKY != null and OWNRKY != ''"> 
			   AND ST.OWNRKY = #{OWNRKY}
			   </if>		   
			   <if test="STOKKY != null and STOKKY != ''">		   
				AND ST.STOKKY = #{STOKKY}
			   </if>
			   
		   
		 ORDER BY ST.LOCAKY, ST.AREAKY, ST.ZONEKY
	</select>		
	
	<select id="NUMOBJ_MAP" parameterType="Map" resultType="DataMap">
		SELECT NUMOBJ
		  FROM DOCTM
		 WHERE DOCUTY = #{DOCUTY}
	</select>
	
	<select id="FN_NROBJ_OBJECT" parameterType="Map" resultType="String">
		SELECT SZF_SEQDOCNUMBER(#{NUMOBJ}) AS NUMSEQ FROM DUAL
	</select>	 	
	
	<select id="TK09_LIST" parameterType="Map" resultType="DataMap">
		SELECT TASKKY
	         , WAREKY
	         , WARENM
	         , DOCDAT
	         , DOCUTY
		     , DOCUTYNM
		     , STATDO		     
		     , STATDONM
		     , DOCTXT
		     , PTNRKY
		     , PTNRNM
			 , LOTA02
			 , OWNRKY
			 , CASE WHEN MR_TYPE = 'Y' THEN 'WMS_IF_322' 
               ELSE IFID 
               END  AS IFID 
             , SAPIFYN      
             , SXBLNR
             , SAPSTS    
             , CNLYN   
	      FROM (
				SELECT TH.TASKKY
				     , TH.WAREKY
				     , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY),' ') AS WARENM
				     , TH.DOCDAT
				     , TH.TASOTY AS DOCUTY
				     , SZF_GET_DOCUTY_TEXT('KR', TH.TASOTY) AS DOCUTYNM
				     , TH.STATDO		     
				     ,(SELECT SZF_GET_CMCDV_CDESC1_TEXT('KR', 'STATDO', TH.STATDO) FROM DUAL) AS STATDONM
				     , TH.DOCTXT
				     , TH.PTNRKY
				     , TH.PTNRNM
					 , TI.LOTA02
					 , TI.OWNRKY
					 , CASE WHEN TH.TASOTY IN ('361') THEN 'WMS_IF_313'
			                WHEN TH.TASOTY IN ('356') THEN 'WMS_IF_320,WMS_IF_322'  
			                WHEN TH.TASOTY IN ('354') THEN 'WMS_IF_310'      		     	                                       
			                ELSE ' ' 
		           	   END AS IFID
		           	 , CASE WHEN (SELECT COUNT(*) FROM TASDI WHERE TASKKY = TH.TASKKY AND TH.PTNRKY = 'P1002400' AND TH.TASOTY = '356' AND LOTA01 = '2400' AND LOTA02 = 'P100' AND SUBSTR(SKUKEY,0,1) = 'S') > 0 THEN 'Y'
		              	    ELSE 'N'
		               END AS MR_TYPE
		             , CASE WHEN (SELECT COUNT(*) FROM IFWMS213 WHERE NVL(TRIM(TH.TASKKY), ' ') = VBELN AND TH.TASOTY != '354' ) > 0 THEN 'V'
		              		ELSE ' '
		               END  AS SAPIFYN 
		             , TI.SXBLNR   	
		             , TI.SAPSTS
		             , DECODE(MAX(V_MIH.CNL_YN), 'R', 'V', ' ') AS CNLYN
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
				       INNER JOIN LOCMA LM ON LM.LOCAKY = TI.LOCASR
				        LEFT JOIN V_MES_IN_HIS@MESLINK V_MIH ON TI.TASKKY = V_MIH.WDOC_NO AND TI.TASKIT = V_MIH.WDOC_SEQNO
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.OWNRKY = #{OWNRKY}
				   AND TH.TASOTY IN (SELECT DOCUTY FROM DOCPG DT WHERE DT.PROGID = #{PROGID})		   		  
				   	<if test="RANGE_SQL != null and RANGE_SQL != ''"> 
				  	 	${RANGE_SQL} 
				   	</if>	
				   
			    	<if test="SKUG01 != null and SKUG01 != ''">
			    		AND SM.SKUG01 = #{SKUG01}
			    	</if>
				    
				    <if test="SKUL01 != null and SKUL01 != ''">
				    	AND SM.SKUL01 = #{SKUL01}
				    </if>
					   		  
				 GROUP BY TH.TASKKY
					    , TH.WAREKY
					    , TH.DOCDAT
					    , TH.TASOTY
					    , TH.STATDO
					    , TH.DOCTXT
					    , TH.PTNRKY
					    , TH.PTNRNM
			            , TI.LOTA02
			            , TI.OWNRKY
			            , TI.SXBLNR
			            , TI.SAPSTS
		       )        
         ORDER BY TASKKY DESC     
	</select> 
	
	<select id="TK09Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT  TI.LOCASR
			  , TI.SKUKEY
			  , TI.STATIT
              ,(SELECT SZF_GET_CMCDV_CDESC1_TEXT('KR', 'STATIT', TI.STATIT) FROM DUAL) AS STATITNM
			  , TI.DESC01
			  , TI.QTTAOR
			  , TI.QTCOMP
			  , TI.SUOMKY AS UOMKEY					 	 
              , NVL(SM.SKUL01,' ') AS SKUL01			 
              , TI.LOTA01 AS LOTA01
		 	  , NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = TI.LOTA01 AND PLNTKY = TI.LOTA02 AND WAREKY = TH.WAREKY)), ' ') AS LOTA01NM
		 	  , TI.LOTA02 AS LOTA02
		 	  , SZF_GET_CMCDV_CDESC1_TEXT(TI.OWNRKY, 'LOTA02', TI.LOTA02) AS LOTA02NM
              , TI.LOTA03
              , TI.LOTA04
              , TI.LOTA05
              , TI.LOTA06
              , TI.LOTA07
              , TI.LOTA08
              , SZF_GET_CMCDV_CDESC1_TEXT(TI.OWNRKY, 'NATNKY', TI.LOTA08) AS LOTA08NM
              , TI.LOTA09
              , NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = TI.OWNRKY AND PTNRTY = 'CT' AND PTNRKY= TI.LOTA09), ' ') AS LOTA09NM
              , TI.LOTA10
              , TI.LOTA11
              , TI.LOTA12
              , TI.LOTA13
              , TI.LOTA14
              , TI.LOTA15
              , TI.LOTA16
              , TI.LOTA17
              , TI.LOTA18
              , TI.LOTA19
              , TI.LOTA20
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'KG')),'0') AS TOT
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'BAG')),'0') AS BAG
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'BOX')),'0') AS BOX
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'PAL')),'0') AS PLT
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'SOK')),'0') AS SOK
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'EA')),'0') AS EA
              , CASE WHEN TI.QTTAOR = 0 THEN 0 
					 ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'BOX'))),'0')
				 END AS BOXBAG
              , TI.RSNCOD 
              , TI.TASRSN AS RSNTXT
              , TI.CREDAT AS CREDAT                                            
		      , TI.CRETIM AS CRETIM                                            
		      , TI.CREUSR AS CREUSR                                            
		      , (SELECT NMLAST FROM USRMA WHERE USERID = TI.CREUSR) AS CUSRNM  
		      , TI.LMODAT AS LMODAT                                            
		      , TI.LMOTIM AS LMOTIM                                            
		      , TI.LMOUSR AS LMOUSR                                            
		      , (SELECT NMLAST FROM USRMA WHERE USERID = TI.LMOUSR) AS LUSRNM  
		  FROM TASDH  TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TI.OWNRKY = #{OWNRKY}
		   AND TH.TASKKY = #{TASKKY}		      
                
         ORDER BY TI.TASKIT ASC     
	</select>  	
	
	<select id="TK10_LIST" parameterType="Map" resultType="DataMap">
		SELECT  TH.TASKKY
		      , TH.WAREKY
		      , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY),' ') AS WARENM
		      , TH.DOCDAT
		      , TH.TASOTY AS DOCUTY
		      , SZF_GET_DOCUTY_TEXT('KR', TH.TASOTY) AS DOCUTYNM
		      , TI.STATIT
		      ,(SELECT SZF_GET_CMCDV_CDESC1_TEXT('KR', 'STATIT', TI.STATIT) FROM DUAL) AS STATDONM
			  , TI.QTCOMP * TRUNC(NVL(DECODE(MAX(MV.PEINH), 0, 0, MAX(MV.STPRS) / MAX(MV.PEINH)), 0)) AS STKAMT
		      , TH.DOCTXT
		      , TH.PTNRKY AS DPTNKY
		      , TH.PTNRNM AS DPTNKYNM
			  , TI.LOCASR
			  , TI.SKUKEY
			  , TI.DESC01
			  , TI.QTTAOR
			  , TI.QTCOMP
			  , TI.SUOMKY AS UOMKEY					 	 
              , NVL(SM.SKUL01,' ') AS SKUL01			 
              , TI.LOTA01 AS LOTA01
		 	  , NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = TI.LOTA01 AND PLNTKY = TI.LOTA02 AND WAREKY = TH.WAREKY)), ' ') AS LOTA01NM
		 	  , TI.LOTA02 AS LOTA02
		 	  , SZF_GET_CMCDV_CDESC1_TEXT(TI.OWNRKY, 'LOTA02', TI.LOTA02) AS LOTA02NM
              , TI.LOTA03
              , TI.LOTA04
              , TI.LOTA05
              , TI.LOTA06
              , TI.LOTA07
              , TI.LOTA08
              , SZF_GET_CMCDV_CDESC1_TEXT(TI.OWNRKY, 'NATNKY', TI.LOTA08) AS LOTA08NM
              , TI.LOTA09
              , NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = TI.OWNRKY AND PTNRTY = 'CT' AND PTNRKY= TI.LOTA09), ' ') AS LOTA09NM              
              , TI.LOTA10
              , TI.LOTA11
              , TI.LOTA12
              , TI.LOTA13
              , TI.LOTA14
              , TI.LOTA15
              , TI.LOTA16
              , TI.LOTA17
              , TI.LOTA18
              , TI.LOTA19
              , TI.LOTA20
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'KG')),'0') AS TOT
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'BAG')),'0') AS BAG
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'BOX')),'0') AS BOX
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'PAL')),'0') AS PLT
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'SOK')),'0') AS SOK
              , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'EA')),'0') AS EA 
              , CASE WHEN TI.QTTAOR = 0 THEN 0 
					 ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'BOX'))),'0')
				 END AS BOXBAG
              , TI.RSNCOD 
              , TI.TASRSN AS RSNTXT
              , TI.CREDAT AS CREDAT                                            
		      , TI.CRETIM AS CRETIM                                            
		      , TI.CREUSR AS CREUSR                                            
		      , (SELECT NMLAST FROM USRMA WHERE USERID = TI.CREUSR) AS CUSRNM  
		      , TI.LMODAT AS LMODAT                                            
		      , TI.LMOTIM AS LMOTIM                                            
		      , TI.LMOUSR AS LMOUSR                                            
		      , (SELECT NMLAST FROM USRMA WHERE USERID = TI.LMOUSR) AS LUSRNM
		  FROM TASDH  TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN LOCMA LM ON LM.LOCAKY = TI.LOCASR
               LEFT JOIN MATVAL MV ON MV.MATNR = TI.SKUKEY AND MV.BWKEY = TI.LOTA02 AND MV.MEINS = TI.SUOMKY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TI.OWNRKY = #{OWNRKY}
		   AND TH.TASOTY IN (SELECT DOCUTY FROM DOCPG DT WHERE DT.PROGID = #{PROGID})  
           <if test="RANGE_SQL != null and RANGE_SQL != ''"> 
		  	 ${RANGE_SQL} 
		   </if>
		   	
		    <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		    </if>
		    
		    <if test="SKUL01 != null and SKUL01 != ''">
		    AND SM.SKUL01 = #{SKUL01}
		    </if>     
		   
		  GROUP BY  TH.TASKKY
		      , TH.WAREKY
		      , TI.OWNRKY
		      , TH.DOCDAT
		      , TH.TASOTY
		      , TI.STATIT
		      , TH.DOCTXT
		      , TH.PTNRKY
		      , TH.PTNRNM
			  , TI.LOCASR
			  , TI.SKUKEY
			  , TI.DESC01
			  , TI.QTTAOR
			  , TI.QTCOMP
			  , TI.SUOMKY 			 	 
              , SM.SKUL01			 
              , TI.LOTA01
              , TI.LOTA02
              , TI.LOTA03
              , TI.LOTA04
              , TI.LOTA05
              , TI.LOTA06
              , TI.LOTA07
              , TI.LOTA08
              , TI.LOTA09
              , TI.LOTA10
              , TI.LOTA11
              , TI.LOTA12
              , TI.LOTA13
              , TI.LOTA14
              , TI.LOTA15
              , TI.LOTA16
              , TI.LOTA17
              , TI.LOTA18
              , TI.LOTA19
              , TI.LOTA20
              , TI.RSNCOD 
              , TI.TASRSN
              , TI.TASKKY
              , TI.CREDAT
              , TI.CRETIM
              , TI.CREUSR
              , TI.LMODAT
              , TI.LMOTIM
              , TI.LMOUSR
         ORDER BY TI.TASKKY DESC   
	</select> 
	
	<select id="TK35_LIST" parameterType="Map" resultType="DataMap">
		WITH TK35 AS (
			SELECT T1.PROGID
			     , T1.DOCCAT 
			     , T1.DOCUTY 
			FROM DOCPG T1
			WHERE T1.PROGID=#{PROGID}
			  AND ROWNUM=1
		)
		SELECT ' ' AS SHPOKY
			 , #{WAREKY} AS WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM
			 , NVL(#{OWNRKY},' ') AS OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = NVL(#{OWNRKY},' ')),' ') AS OWNRNM
			 , F_SET_DATE(SYSDATE) AS DOCDAT
			 , (SELECT X.DOCCAT FROM TK35 X) AS DOCCAT
			 , SZF_GET_DOCCAT_TEXT(#{LANGKY}, (SELECT X.DOCCAT FROM TK35 X)) AS DOCCATNM
			 , (SELECT X.DOCUTY FROM TK35 X) AS DOCUTY
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, (SELECT X.DOCUTY FROM TK35 X)) AS DOCUTYNM
			 , 'NEW' AS STATDO
			 ,(SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', 'NEW') FROM DUAL) AS STATDONM			 
			 , ' ' AS DOCTXT
			 , ' ' AS PTNRTY
			 , ' ' AS DPTNKY
		     , ' ' AS DPTNKYNM
		     , 'V' AS SAPIFYN
		     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS ASNDAT
		     , 'WMS_IF_313' AS IFID 
		FROM DUAL
	</select>
	
	<select id="TK35Sub_LIST" parameterType="Map" resultType="DataMap">
	 SELECT    A.STOKKY
	 	   	 , A.WAREKY	  		 
	  		 , A.AREAKY  
			 , A.ZONEKY  
			 , A.LOTNUM  
			 , A.LOCASR  
			 , A.TRNUSR  
	  		 , A.LOCATG
	  		 , A.TRNUTG 
	  		 , A.LOCAAC
	  		 , A.TRNUAC	
	  		 , A.OWNRKY 
			 , A.SKUKEY 
	  		 , A.DESC01
	  		 , A.DESC02
	  		 , A.STKAMT
	  		 , A.QTSIWH
	  		 , A.QTABLE
	  		 , A.QTTAOR
	  		 , A.QTSWQT
	  		 , A.UOMKEY
			 , A.SHPOKY
			 , A.SHPOIT
			 , A.DROPID
	  		 , A.LOTA01
	  		 , A.LOTA01NM
			 , A.LOTA02
			 , A.LOTA02NM
			 , A.LOTA03
			 , A.LOTA04
			 , A.LOTA05
			 , A.LOTA06
			 , A.LOTA06NM     
			 , A.LOTA07
			 , A.LOTA08
			 , A.LOTA08NM
			 , A.LOTA09
			 , A.LOTA09NM
			 , A.LOTA10
			 , A.LOTA11
			 , A.LOTA12
			 , A.LOTA13
			 , A.LOTA14
			 , A.LOTA15
			 , A.LOTA16
			 , A.LOTA17
			 , A.LOTA18
			 , A.LOTA19
			 , A.LOTA20
	  		 , A.RSNCOD
	  		 , A.RSNTXT
	  		 , A.SKUL01	
			 , A.TOT   
			 , A.BAG  
			 , A.BOX  
			 , A.PLT  
			 , A.SOK  
			 , A.EA	
			 , A.BOXBAG 
			 , A.USEQTY  
	 FROM(
	 
			WITH TK35 AS (
				SELECT T1.PROGID
				     , T1.DOCCAT 
				     , T1.DOCUTY 
				FROM DOCPG T1
				WHERE T1.DOCUTY = #{TASOTY}
				  AND ROWNUM=1
			)
			
			SELECT ST.STOKKY AS STOKKY
			     , ST.WAREKY AS WAREKY
			     , ST.AREAKY AS AREAKY
			     , ST.ZONEKY AS ZONEKY
			     , ST.LOTNUM AS LOTNUM
			     , ST.LOCAKY AS LOCASR
			     , ST.TRNUID AS TRNUSR
			     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM TK35 X)),' ') AS LOCATG
			     , ' ' AS TRNUTG
			     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM TK35 X)),' ') AS LOCAAC
			     , ' ' AS TRNUAC
			     , ST.OWNRKY AS OWNRKY
			     , ST.SKUKEY AS SKUKEY
			     , SZF_GET_SKU_DESC01_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC01
			     , SZF_GET_SKU_DESC02_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC02
			     , ST.QTSIWH * TRUNC(NVL(DECODE(MV.PEINH, 0, 0, MV.STPRS / MV.PEINH), 0)) AS STKAMT
			     , ST.QTSIWH AS QTSIWH
			     , ((ST.QTSIWH) - GREATEST((ST.QTSALO),(ST.QTSPMO)) - (ST.QTSBLK)) AS QTABLE
			     , 0 AS QTTAOR
			     , DECODE(ST.LOTA06, '50', ST.QTSIWH, 0) AS QTSWQT /* 폐기 : Wasted     QuanTity */
			     , SM.DUOMKY AS UOMKEY		     
			     , ST.SHPOKY AS SHPOKY
			     , ST.SHPOIT AS SHPOIT
			     , ' ' AS DROPID
			     , ST.LOTA01 AS LOTA01
			 	 , NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = ST.LOTA01 AND PLNTKY = ST.LOTA02 AND WAREKY = ST.WAREKY)), ' ') AS LOTA01NM
			 	 , ST.LOTA02 AS LOTA02
			 	 , SZF_GET_CMCDV_CDESC1_TEXT(ST.OWNRKY, 'LOTA02', ST.LOTA02) AS LOTA02NM
			     , ST.LOTA03 AS LOTA03
			     , ST.LOTA04 AS LOTA04
			     , ST.LOTA05 AS LOTA05
			     , ST.LOTA06
			     , (SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', ST.LOTA06) FROM DUAL) AS LOTA06NM
			     , ST.LOTA07 AS LOTA07
			     , ST.LOTA08 AS LOTA08
			     , SZF_GET_CMCDV_CDESC1_TEXT(ST.OWNRKY, 'NATNKY', ST.LOTA08) AS LOTA08NM
			     , ST.LOTA09 AS LOTA09
			     , NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = ST.OWNRKY AND PTNRTY = 'CT' AND PTNRKY= ST.LOTA09), ' ') AS LOTA09NM
			     , ST.LOTA10 AS LOTA10
			     , ST.LOTA11 AS LOTA11
			     , ST.LOTA12 AS LOTA12
			     , ST.LOTA13 AS LOTA13
			     , ST.LOTA14 AS LOTA14
			     , ST.LOTA15 AS LOTA15
			     , ST.LOTA16 AS LOTA16
			     , ST.LOTA17 AS LOTA17
			     , ST.LOTA18 AS LOTA18
			     , ST.LOTA19 AS LOTA19
			     , ST.LOTA20 AS LOTA20	
			     , ' ' AS RSNCOD
			     , ' ' AS RSNTXT
			     , NVL((SELECT SKUL01 FROM SKUMA WHERE SKUKEY = ST.SKUKEY AND OWNRKY = #{OWNRKY}),' ') AS SKUL01			 
				 , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'KG')),'0') AS TOT
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BAG')),'0') AS BAG
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BOX')),'0') AS BOX
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'PAL')),'0') AS PLT
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'SOK')),'0') AS SOK
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'EA')),'0') AS EA 
	             , CASE WHEN ST.QTSIWH = 0 THEN 0 
						ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BOX'))),'0') 
					END AS BOXBAG
	             , CASE WHEN ST.AREAKY = 'SHP' THEN 0
					ELSE ST.QTSIWH - ST.QTSBLK
								  - GREATEST(ST.QTSALO, ST.QTSPMO)
								  - (CASE WHEN ST.LOTA06 IN ('00') OR ST.QTSPMO > 0 THEN 0
										  ELSE ST.QTSIWH
									 END)
			   END AS USEQTY
			   	    
			  FROM STKKY ST
			       INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY
			                          AND SM.SKUKEY = ST.SKUKEY
			       LEFT JOIN MATVAL MV ON MV.MATNR = ST.SKUKEY AND MV.BWKEY = ST.LOTA02 AND MV.MEINS = ST.UOMKEY
	
			 WHERE 1 = 1
			   AND ST.QTSIWH > 0
			   AND ST.QTSPMO = 0
			   AND ST.QTSBLK = 0			  
			   <if test="WAREKY != null and WAREKY != ''"> 
			   AND ST.WAREKY = #{WAREKY}
			   </if>
			   <if test="OWNRKY != null and OWNRKY != ''"> 
			   AND ST.OWNRKY = #{OWNRKY}
			   </if>
			   
			   <if test="SKUG01 != null and SKUG01 != ''">
				AND SM.SKUG01 = #{SKUG01}
			   </if>
			    
			   <if test="SKUL01 != null and SKUL01 != ''">
			    AND SM.SKUL01 = #{SKUL01}
			   </if>
			   
			   <if test="RANGE_SQL != null and RANGE_SQL != ''"> 
			  	 ${RANGE_SQL} 
			   </if>
			   
			   	
			) A 
						
		    
		   
	</select>
	
	<select id="TK36_LIST" parameterType="Map" resultType="DataMap">
		WITH TK36 AS (
			SELECT T1.PROGID
			     , T1.DOCCAT 
			     , T1.DOCUTY 
			FROM DOCPG T1
			WHERE T1.PROGID=#{PROGID}
			  AND ROWNUM=1
		)
		SELECT ' ' AS SHPOKY
			 , #{WAREKY} AS WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM
			 , NVL(#{OWNRKY},' ') AS OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = NVL(#{OWNRKY},' ')),' ') AS OWNRNM
			 , F_SET_DATE(SYSDATE) AS DOCDAT
			 , (SELECT X.DOCCAT FROM TK36 X) AS DOCCAT
			 , SZF_GET_DOCCAT_TEXT(#{LANGKY}, (SELECT X.DOCCAT FROM TK36 X)) AS DOCCATNM
			 , (SELECT X.DOCUTY FROM TK36 X) AS DOCUTY
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, (SELECT X.DOCUTY FROM TK36 X)) AS DOCUTYNM
			 , 'NEW' AS STATDO
			 ,(SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', 'NEW') FROM DUAL) AS STATDONM
			 , ' ' AS DOCTXT
			 , ' ' AS PTNRTY
			 , ' ' AS DPTNKY
		     , ' ' AS DPTNKYNM
		     , ' ' AS LOTA01
		     , ' ' AS LOTA01NM
		     , 'V' AS SAPIFYN
		     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS ASNDAT
		     , 'WMS_IF_320,WMS_IF_322' AS IFID
		FROM DUAL
	</select>
	
	<select id="TK36Sub_LIST" parameterType="Map" resultType="DataMap">
	 SELECT    A.STOKKY
	 	   	 , A.WAREKY	  		 
	  		 , A.AREAKY  
			 , A.ZONEKY  
			 , A.LOTNUM  
			 , A.LOCASR  
			 , A.TRNUSR  
	  		 , A.LOCATG
	  		 , A.TRNUTG 
	  		 , A.LOCAAC
	  		 , A.TRNUAC	
	  		 , A.OWNRKY 
			 , A.SKUKEY 
	  		 , A.DESC01
	  		 , A.DESC02
	  		 , A.QTSIWH
	  		 , A.QTABLE
	  		 , A.QTTAOR
	  		 , A.QTSWQT
	  		 , A.UOMKEY
			 , A.SHPOKY
			 , A.SHPOIT
			 , A.DROPID
	  		 , A.LOTA01
	  		 , A.LOTA01NM
			 , A.LOTA02
			 , A.LOTA02NM
			 , A.LOTA03
			 , A.LOTA04
			 , A.LOTA05
			 , A.LOTA06
			 , A.LOTA06NM     
			 , A.LOTA07
			 , A.LOTA08
			 , A.LOTA08NM
			 , A.LOTA09
			 , A.LOTA09NM
			 , A.LOTA10
			 , A.LOTA11
			 , A.LOTA12
			 , A.LOTA13
			 , A.LOTA14
			 , A.LOTA15
			 , A.LOTA16
			 , A.LOTA17
			 , A.LOTA18
			 , A.LOTA19
			 , A.LOTA20
	  		 , A.RSNCOD
	  		 , A.RSNTXT
	  		 , A.SKUL01	
			 , A.TOT   
			 , A.BAG  
			 , A.BOX  
			 , A.PLT  
			 , A.SOK  
			 , A.EA	
			 , A.USEQTY  
	 FROM(
	 
			WITH TK36 AS (
				SELECT T1.PROGID
				     , T1.DOCCAT 
				     , T1.DOCUTY 
				FROM DOCPG T1
				WHERE T1.DOCUTY = #{TASOTY}
				  AND ROWNUM=1
			)
			
			SELECT ST.STOKKY AS STOKKY
			     , ST.WAREKY AS WAREKY
			     , ST.AREAKY AS AREAKY
			     , ST.ZONEKY AS ZONEKY
			     , ST.LOTNUM AS LOTNUM
			     , ST.LOCAKY AS LOCASR
			     , ST.TRNUID AS TRNUSR
			     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM TK36 X)),' ') AS LOCATG
			     , ' ' AS TRNUTG
			     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM TK36 X)),' ') AS LOCAAC
			     , ' ' AS TRNUAC
			     , ST.OWNRKY AS OWNRKY
			     , ST.SKUKEY AS SKUKEY
			     , SZF_GET_SKU_DESC01_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC01
			     , SZF_GET_SKU_DESC02_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC02
			     , ST.QTSIWH AS QTSIWH
			     , ((ST.QTSIWH) - GREATEST((ST.QTSALO),(ST.QTSPMO)) - (ST.QTSBLK)) AS QTABLE
			     , ST.QTSIWH AS QTTAOR
			     , DECODE(ST.LOTA06, '50', ST.QTSIWH, 0) AS QTSWQT /* 폐기 : Wasted     QuanTity */
			     , SM.DUOMKY AS UOMKEY		     
			     , ST.SHPOKY AS SHPOKY
			     , ST.SHPOIT AS SHPOIT
			     , ' ' AS DROPID
			     , ST.LOTA01 AS LOTA01
			 	 , NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = ST.LOTA01 AND PLNTKY = ST.LOTA02 AND WAREKY = ST.WAREKY)), ' ') AS LOTA01NM
			 	 , ST.LOTA02 AS LOTA02
			 	 , SZF_GET_CMCDV_CDESC1_TEXT(ST.OWNRKY, 'LOTA02', ST.LOTA02) AS LOTA02NM
			     , ST.LOTA03 AS LOTA03
			     , ST.LOTA04 AS LOTA04
			     , ST.LOTA05 AS LOTA05
			     , ST.LOTA06
			     , (SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', ST.LOTA06) FROM DUAL) AS LOTA06NM
			     , ST.LOTA07 AS LOTA07
			     , ST.LOTA08 AS LOTA08
			     , SZF_GET_CMCDV_CDESC1_TEXT(ST.OWNRKY, 'NATNKY', ST.LOTA08) AS LOTA08NM			     
			     , ST.LOTA09 AS LOTA09
			     , NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = ST.OWNRKY AND PTNRTY = 'CT' AND PTNRKY= ST.LOTA09), ' ') AS LOTA09NM
			     , ST.LOTA10 AS LOTA10
			     , ST.LOTA11 AS LOTA11
			     , ST.LOTA12 AS LOTA12
			     , ST.LOTA13 AS LOTA13
			     , ST.LOTA14 AS LOTA14
			     , ST.LOTA15 AS LOTA15
			     , ST.LOTA16 AS LOTA16
			     , ST.LOTA17 AS LOTA17
			     , ST.LOTA18 AS LOTA18
			     , ST.LOTA19 AS LOTA19
			     , ST.LOTA20 AS LOTA20	
			     , ' ' AS RSNCOD
			     , ' ' AS RSNTXT
			     , NVL((SELECT SKUL01 FROM SKUMA WHERE SKUKEY = ST.SKUKEY AND OWNRKY = #{OWNRKY}),' ') AS SKUL01			 
				 , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'KG')),'0') AS TOT
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BAG')),'0') AS BAG
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BOX')),'0') AS BOX
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'PAL')),'0') AS PLT
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'SOK')),'0') AS SOK
	             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'EA')),'0') AS EA
	             , CASE WHEN ST.AREAKY = 'SHP' THEN 0
					ELSE ST.QTSIWH - ST.QTSBLK
								  - GREATEST(ST.QTSALO, ST.QTSPMO)
								  - (CASE WHEN ST.LOTA06 IN ('00') OR ST.QTSPMO > 0 THEN 0
										  ELSE ST.QTSIWH
									 END)
			   END AS USEQTY
			   	    
			  FROM STKKY ST
			       INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY
			                          AND SM.SKUKEY = ST.SKUKEY
			 WHERE 1 = 1
			   AND ST.QTSIWH > 0
			   AND ST.QTSPMO = 0
			   AND ST.QTSBLK = 0
			   AND ST.AREAKY NOT IN ('SYS', 'SHP','CRT','RTS')
			   AND ST.LOCAKY NOT IN ('RTNLOC','SCRLOC')
			   
			   <if test="WAREKY != null and WAREKY != ''"> 
			   AND ST.WAREKY = #{WAREKY}
			   </if>
			   
			   <if test="OWNRKY != null and OWNRKY != ''"> 
			   AND ST.OWNRKY = #{OWNRKY}
			   </if>
			   
			   <if test="LOTA02 != null and LOTA02 != ''"> 
			   AND ST.LOTA02 = #{LOTA02}
			   </if>
			   
			   <if test="SKUG01 != null and SKUG01 != ''">
				AND SM.SKUG01 = #{SKUG01}
			   </if>
			    
			   <if test="SKUL01 != null and SKUL01 != ''">
			    AND SM.SKUL01 = #{SKUL01}
			   </if>
			   
			   <if test="RANGE_SQL != null and RANGE_SQL != ''"> 
			  	 ${RANGE_SQL} 
			   </if>	
			) A 
			
			WHERE 1=1
		   <if test="DESC01 != null and DESC01 != ''">
		    AND A.DESC01 LIKE '%${DESC01}%'
		   </if>	   
		   <if test="SKUL01 != null and SKUL01 != ''">
		    AND A.SKUL01 LIKE '%${SKUL01}%'
		   </if>
		   
	</select>
	
	
	<!-- TK36 생산직불출 출고  -->
	 <select id="TK36_PTNRKY_MAP" parameterType="Map" resultType="DataMap">
	 SELECT PTNRKY, NAME01
	  
 	 FROM BZPTN
     		 
	 WHERE PTNRKY = #{PTNRKY} 
       AND PTNRTY = #{PTNRTY}
               
	</select>
	
	<!--SHPDH I/F CHECK-->
	<select id="VALIDATION_SHPDH_MAP" parameterType="Map" resultType="DataMap">
	 SELECT NVL(MAX(SI.SHPOKY), ' ') AS SHPOKY
	   FROM SHPDH SH
	  INNER JOIN SHPDI SI ON SH.SHPOKY =SI.SHPOKY
	 WHERE 1=1	 
	 	AND SI.KEEPIT != ' '
	 	AND SI.SHPOKY = #{SHPOKY}
	</select>		
	<!--SHPDI I/F CHECK-->
	<select id="VALIDATION_SHPDI_FPC_MAP" parameterType="Map" resultType="DataMap">
     SELECT NVL(MAX(SI.SHPOKY), ' ') AS SHPOKY
       FROM SHPDI SI
      WHERE 1=1
<!--         AND SI.STATIT IN ('FPC', 'FCK', 'PCK', 'FSH', 'PSH') -->
        <!-- AND SI.STATIT NOT IN ('FAL', 'PAL', 'FCO', 'FPC', ' ') -->
        AND SI.STATIT NOT IN ('FAL', 'PAL', 'FCO', 'FPC', 'PPC', ' ') 	<!-- 240305 피킹완료 validation 추가 -->
   	 	AND SI.SHPOKY = #{SHPOKY}
	</select>		
	<!--SHPDI FCK I/F CHECK-->
	<select id="VALIDATION_SHPDI_FCK_MAP" parameterType="Map" resultType="DataMap">
     SELECT NVL(MAX(SI.SHPOKY), ' ') AS SHPOKY
       FROM SHPDI SI
      WHERE 1=1
<!--         AND SI.STATIT IN ('FCK', 'FSH', 'PSH') -->
        AND SI.STATIT NOT IN ('FPC', 'PPC', 'FCO', 'PCK', 'FCK', ' ')
	 	AND SI.SHPOKY = #{SHPOKY}
	</select>		
	
	<!--SHPDH I/F CHECK-->
	<select id="VALIDATION_SHPDHLIST_MAP" parameterType="Map" resultType="DataMap">
	SELECT SHPOKY FROM (
	
		SELECT SI.SHPOKY AS SHPOKY
		FROM SHPDH SH
		INNER JOIN SHPDI SI ON SH.SHPOKY =SI.SHPOKY
		WHERE 1=1
		AND SI.KEEPIT != ' '
		AND SI.SHPOKY IN (${SHPOKY})
		ORDER BY SI.SHPOKY DESC
		
		)
	WHERE ROWNUM =1 
	</select>
	
	<select id="TASDI_LOCK_INFO_LIST" parameterType="Map" resultType="DataMap">
	SELECT NVL(TRIM(TH.TASKKY), ' ') TASKKY
		 , NVL(TRIM(TI.TASKIT), ' ') TASKIT
		 , NVL(TRIM(TI.PAIDSR), ' ') PAIDSR
		 , NVL(TRIM(TI.STKNUM), ' ') STKNUM
	FROM TASDH TH
	INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
	WHERE 1 = 1
	AND TH.WAREKY = #{WAREKY}
	AND TH.TASOTY = '330'
	AND TI.STATIT IN('NEW', 'PPC', 'FPC')

	<choose>
		<when test="STKNUM != null and STKNUM != '' and STKNUM != &quot; &quot;">
			AND (TI.STKNUM = #{STKNUM} OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ))
		</when>
		<otherwise>
			AND TI.TASKKY = #{TASKKY}
		</otherwise>
	</choose>

	<if test="DPTNKY != null and DPTNKY != ''">
		AND TH.PTNRKY = #{DPTNKY}
	</if>

	ORDER BY TH.TASKKY DESC, TI.TASKIT ASC
	</select>
	
	<select id="TASDI_CANCEL_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT 1 
		  FROM SHPDH
		 WHERE SHPOKY = #{SHPOKY}
		   AND STATDO NOT IN ('FPC', 'PPC', 'OCN')
	</select>
	
	<select id="TASDI_LOCK_INFO_VALIDATION" parameterType="Map" resultType="DataMap">
			SELECT * FROM (
	                   SELECT TH.TASKKY
                            , TI.TASKIT
                            , TI.PAIDSR
                            , TI.STKNUM
                            , CASE WHEN NVL(TRIM(TI.PAIDSR), ' ') != ' ' AND NVL(TRIM(TI.STKNUM), ' ') != ' '
                                   THEN 'OUT_M0244†' || TI.PAIDSR || '/' || TI.TASKKY || '/' || TI.TASKIT || '/' || TI.STKNUM 
                                    WHEN NVL(TRIM(TI.PAIDSR), ' ') != ' ' AND NVL(TRIM(TI.STKNUM), ' ') = ' '
                                   THEN 'OUT_M0250†' || TI.PAIDSR || '/' || TI.TASKKY || '/' || TI.TASKIT  
	                     ELSE 'OK'
	                  END AS RESULTMSG
                         FROM TASDH TH
                              INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
                        WHERE 1 = 1
                          AND TH.WAREKY = #{WAREKY}		           
                          AND TH.TASOTY = '330'	
                          AND TI.STATIT IN('NEW', 'PPC', 'FPC')   
                          AND TI.STKNUM = #{STKNUM}
                          <if test="TASKKY != null and TASKKY != ''">
                          AND TI.TASKKY = #{TASKKY}	
                          </if>
                          <if test="TASKIT != null and TASKIT != ''">
                          AND TI.TASKIT = #{TASKIT}	
                          </if>
                          
                       UNION 
                       
                       SELECT TH.TASKKY
                            , TI.TASKIT
                            , TI.PAIDSR
                            , TI.STKNUM
                            , CASE WHEN NVL(TRIM(TI.PAIDSR), ' ') != ' ' AND NVL(TRIM(TI.STKNUM), ' ') != ' '
                                   THEN 'OUT_M0244†' || TI.PAIDSR || '/' || TI.TASKKY || '/' || TI.TASKIT || '/' || TI.STKNUM 
                                    WHEN NVL(TRIM(TI.PAIDSR), ' ') != ' ' AND NVL(TRIM(TI.STKNUM), ' ') = ' '
                                   THEN 'OUT_M0250†' || TI.PAIDSR || '/' || TI.TASKKY || '/' || TI.TASKIT  
	                     ELSE 'OK'
	                  END AS RESULTMSG
                         FROM TASDH TH
                              INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
                        WHERE 1 = 1
                          AND TH.WAREKY = #{WAREKY}		           
                          AND TH.TASOTY = '330'	
                          AND TI.STATIT IN('NEW', 'PPC', 'FPC')   
                          AND TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} )
                          <if test="TASKKY != null and TASKKY != ''">
                          AND TI.TASKKY = #{TASKKY}	
                          </if>
                          <if test="TASKIT != null and TASKIT != ''">
                          AND TI.TASKIT = #{TASKIT}	
                          </if>                     
			) WHERE RESULTMSG != 'OK'
	</select>
	<!--역출고여부 조회 -->
	<select id="LASTOB_OBJECT" parameterType="Map" resultType="String">
	 SELECT SZF_GET_ORDER_ALSTKY_LASTOB(#{WAREKY}, #{OWNRKY}, #{KVGR1}, #{DPTNKY}, ' ', ' ', #{DOCUTY}, ' ') AS LASTOB FROM DUAL               
	</select>
	
	
	<select id="CALL_ETCSHP_CONFIRM_CANCEL_MAP" parameterType="Map" resultType="DataMap">
		 { call SZP_ETCSHP_CONFIRM_CANCEL( #{WAREKY}, #{OWNRKY}, #{TASKKY}, #{SES_USER_ID} ) }
	</select>	
	
	
	<select id="TK35_LOTA06COMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
			 , CDESC1 AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'LOTA06'
		   AND CMCDVL IN ('10','30','50')
	</select>
	
	<parameterMap id="ProcMap" type="java.util.Map">
		<parameter property="WAREKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="PASTKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="OWNRKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="SKUKEY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOTA01" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOTA02" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOCASR" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOCAKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="OUT"/>
	</parameterMap>
	<update id="PUTAWAY_LOCATION_PROC_CALL_UPDATE" parameterMap="ProcMap" statementType="CALLABLE">
		 { call P_AIRWMS_PUTAWAY_LOCATION(?,?,?,?,?,?,?,?) }
	</update>
	
	
	<select id="PLTSEQ_OBJECT" parameterType="Map" resultType="String">
	 SELECT TO_CHAR(SEQ_PTLSEQ.NEXTVAL) AS PLTSEQ FROM DUAL               
	</select>
	
	<parameterMap id="Proc2Map" type="java.util.Map">
		<parameter property="WAREKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="PASTKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="OWNRKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="SKUKEY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOCASR" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOTA01" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOTA02" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOTA14" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOTA15" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="QTTAOR" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="SUOMKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="PTLSEQ" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="USERID" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOCAKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="OUT"/>
	</parameterMap>
	<update id="PUTAWAY_LOCATION2_PROC_CALL_UPDATE" parameterMap="Proc2Map" statementType="CALLABLE">
		 { call P_AIRWMS_PUTAWAY_LOCATION2(?,?,?,?,?,?,?,?,?,?,?,?,?,?) }
	</update>
	
	<update id="SDREMARK_UPDATE" parameterType="Map">
		 UPDATE IFWMS213
		    SET REMARK = #{REMARK}
		  WHERE VBELN = #{TASKKY}
	</update>
	
	<select id="TASDR_STOKKY_MAP" parameterType="Map" resultType="DataMap">
		SELECT STOKKY
		  FROM TASDR
		 WHERE TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}
	</select>	
	
	<!-- 재고실사출고 -->
	<select id="TK03Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT    MAX(A.STOKKY) AS STOKKY
		     , A.WAREKY
		     , A.AREAKY  
		     , A.ZONEKY  
		     , A.LOTNUM  
		     , A.LOCASR  
		     , A.TRNUSR  
		     , A.LOCATG
		     , A.TRNUTG 
		     , A.LOCAAC
		     , A.TRNUAC	
		     , A.OWNRKY 
		     , A.SKUKEY 
		     , A.DESC01
		     , A.DESC02
		     , A.QTYPDA 
		     , SUM(A.QTSIWH) AS QTSIWH
		     , SUM(A.QTABLE) AS QTABLE
		     , A.QTTAOR
		     , A.UOMKEY
		     , A.DROPID
		     , A.LOTA01
		     , A.LOTA01NM
		     , A.LOTA02
		     , A.LOTA02NM
		     , A.LOTA03
		     , A.LOTA04
		     , A.LOTA05
		     , A.LOTA06
		     , A.LOTA06NM     
		     , A.LOTA07
		     , A.LOTA08
		     , A.LOTA08NM
		     , A.LOTA09
		     , A.LOTA09NM
		     , A.LOTA10
		     , A.LOTA11
		     , A.LOTA12
		     , A.LOTA13
		     , A.LOTA14
		     , A.LOTA15
		     , A.LOTA16
		     , A.LOTA17
		     , A.LOTA18
		     , A.LOTA19
		     , A.LOTA20
		     , A.RSNCOD
		     , A.RSNTXT
		     , A.SKUL01	
		     , SUM(A.TOT) AS TOT   
		     , SUM(A.BAG) AS BAG
		     , SUM(A.BOX) AS BOX
		     , SUM(A.PLT) AS PLT
		     , SUM(A.SOK) AS SOK
		     , SUM(A.EA) AS EA
		     , A.BOXBAG 
		     , SUM(A.USEQTY) AS USEQTY
		     , A.DOCDAT
	 FROM(
	 
		WITH TK01 AS (
			SELECT T1.PROGID
			     , T1.DOCCAT 
			     , T1.DOCUTY 
			FROM DOCPG T1
			WHERE T1.DOCUTY = #{TASOTY}
			  AND ROWNUM=1
		)
		
		SELECT ST.STOKKY AS STOKKY
		     , ST.WAREKY AS WAREKY
		     , ST.AREAKY AS AREAKY
		     , ST.ZONEKY AS ZONEKY
		     , ST.LOTNUM AS LOTNUM
		     , ST.LOCAKY AS LOCASR
		     , ST.TRNUID AS TRNUSR
		     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM TK01 X)),' ') AS LOCATG
		     , ' ' AS TRNUTG
		     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM TK01 X)),' ') AS LOCAAC
		     , ' ' AS TRNUAC
		     , ST.OWNRKY AS OWNRKY
		     , ST.SKUKEY AS SKUKEY
		     , SZF_GET_SKU_DESC01_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC01
		     , SZF_GET_SKU_DESC02_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC02
		     , ST.QTSIWH AS QTSIWH
		     , ((ST.QTSIWH) - GREATEST((ST.QTSALO),(ST.QTSPMO)) - (ST.QTSBLK)) AS QTABLE
		     <!-- , 0 AS QTTAOR -->
		     -- , ST.QTSIWH AS QTTAOR
		     , SM.DUOMKY AS UOMKEY		     
		     , ST.SHPOKY AS SHPOKY
		     , ST.SHPOIT AS SHPOIT
		     , ' ' AS DROPID
		     , ST.LOTA01 AS LOTA01
		 	 , NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = ST.LOTA01 AND PLNTKY = ST.LOTA02 AND WAREKY = ST.WAREKY)), ' ') AS LOTA01NM
		 	 , ST.LOTA02 AS LOTA02
		 	 , SZF_GET_CMCDV_CDESC1_TEXT(ST.OWNRKY, 'LOTA02', ST.LOTA02) AS LOTA02NM
		     , ST.LOTA03 AS LOTA03
		     , ST.LOTA04 AS LOTA04
		     , ST.LOTA05 AS LOTA05
		     , ST.LOTA06
		     , (SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', ST.LOTA06) FROM DUAL) AS LOTA06NM
		     , ST.LOTA07 AS LOTA07
		     , ST.LOTA08 AS LOTA08
		     , SZF_GET_CMCDV_CDESC1_TEXT(ST.OWNRKY, 'NATNKY', ST.LOTA08) AS LOTA08NM
		     , ST.LOTA09 AS LOTA09
		     , NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = ST.OWNRKY AND PTNRTY = 'CT' AND PTNRKY= ST.LOTA09), ' ') AS LOTA09NM
		     , ST.LOTA10 AS LOTA10
		     , ST.LOTA11 AS LOTA11
		     , ST.LOTA12 AS LOTA12
		     , ST.LOTA13 AS LOTA13
		     , ST.LOTA14 AS LOTA14
		     , ST.LOTA15 AS LOTA15
		     , ST.LOTA16 AS LOTA16
		     , ST.LOTA17 AS LOTA17
		     , ST.LOTA18 AS LOTA18
		     , ST.LOTA19 AS LOTA19
		     , ST.LOTA20 AS LOTA20	
		     , '802' AS RSNCOD
		     , '재고실사 전산출고' AS RSNTXT
		     , NVL((SELECT SKUL01 FROM SKUMA WHERE SKUKEY = ST.SKUKEY AND OWNRKY = #{OWNRKY}),' ') AS SKUL01			 
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'KG')),'0') AS TOT
             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BAG')),'0') AS BAG
             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BOX')),'0') AS BOX
             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'PAL')),'0') AS PLT
             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'SOK')),'0') AS SOK
             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'EA')),'0') AS EA 
             , CASE WHEN ST.QTSIWH = 0 THEN 0 
					ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BOX'))),'0')
				END AS BOXBAG
             , CASE WHEN ST.AREAKY = 'SHP' THEN 0
				ELSE ST.QTSIWH - ST.QTSBLK
							  - GREATEST(ST.QTSALO, ST.QTSPMO)
							  - (CASE WHEN ST.LOTA06 IN ('00') OR ST.QTSPMO > 0 THEN 0
									  ELSE ST.QTSIWH
								 END)
		   END AS USEQTY	
		     , RV.DOCDAT 
		     , PI.QTYPDA 
		     , DECODE(PI.QTYPDA, 0, PI.QTSIWH, (PI.QTSIWH - PI.QTYPDA)) AS QTTAOR 
		  FROM STKKY ST
		       INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY AND SM.SKUKEY = ST.SKUKEY 
		       INNER JOIN PHYDI PI ON PI.SKUKEY = ST.SKUKEY AND PI.LOTA14 = ST.LOTA14 AND PI.LOTA01 = ST.LOTA01
		       LEFT JOIN (SELECT B.DOCDAT , A.RECVKY , A.RECVIT
                               FROM RECDI A 
                                    INNER JOIN RECDH B ON A.RECVKY = B.RECVKY
                              WHERE 1 = 1 
                              	 AND B.WAREKY = #{WAREKY}
		   					 AND B.OWNRKY = #{OWNRKY}
                            ) RV ON ST.RECVKY = RV.RECVKY AND ST.RECVIT = RV.RECVIT                
		 WHERE 1 = 1 
		   AND ST.WAREKY = #{WAREKY}
		   AND ST.QTSIWH > 0
		   AND ST.QTSPMO = 0
		   AND ST.QTSBLK = 0
		   AND ST.AREAKY NOT IN ('SYS', 'SHP','CRT','RTS')
		   AND ST.LOCAKY NOT IN ('SCRLOC')
		   AND ST.LOTA06 = '00' 
		   AND PI.PHYIKY = #{PHYIKY}  
		   -- AND (PI.REFCAT != 'V' OR (PI.QTYPDA - PI.QTSIWH) &lt; 0) /* 미조사 OR 실사차이 (재고실사출고 대상) */
		   AND (PI.QTYPDA - PI.QTSIWH) &lt; 0 /* 실사차이 (재고실사출고 대상) */		   
		   <if test="RANGE_SQL != null and RANGE_SQL != ''"> 
		  	 ${RANGE_SQL} 
		   </if>	
		) A 
			
	GROUP BY A.WAREKY, A.AREAKY, A.ZONEKY, A.LOTNUM, A.LOCASR, A.TRNUSR, A.LOCATG, A.TRNUTG, A.LOCAAC, A.TRNUAC
       , A.OWNRKY, A.SKUKEY, A.DESC01, A.DESC02, A.QTYPDA, A.QTTAOR, A.UOMKEY, A.DROPID, A.LOTA01
       , A.LOTA01NM, A.LOTA02, A.LOTA02NM, A.LOTA03, A.LOTA04, A.LOTA05, A.LOTA06, A.LOTA06NM
       , A.LOTA07, A.LOTA08, A.LOTA08NM, A.LOTA09, A.LOTA09NM, A.LOTA10, A.LOTA11, A.LOTA12
       , A.LOTA13, A.LOTA14, A.LOTA15, A.LOTA16, A.LOTA17, A.LOTA18, A.LOTA19, A.LOTA20
       , A.RSNCOD, A.RSNTXT, A.SKUL01, A.BOXBAG, A.DOCDAT
</select>
	<!-- 재고실사출고 END -->
	
	<!-- 출고관리 : 선적번호를 출고문서 번호로 -->
	<select id="DL061_CONVERT_STKNUM_TO_SHPOKY_LIST" parameterType="Map" resultType="DataMap">
		SELECT	 SI.STKNUM			--선적번호
				,SI.SHPOKY			--출고문서번호
				,SI.SVBELN			--출고오더번호/납품문서번호
				,SH.RQSHPD			--출하요청일자
--				,SI.SHPOIT			--아이템번호
				,SI.STATIT			--아이템상태코드
				,NVL(DECODE(SH.SHPMTY, '231', SH.PTRCVR, SH.DPTNKY), ' ') AS DPTNKY	--납품처코드
				,TI.TASKKY 			--작업지시번호
				,TH.STATDO 			--작업지시상태
		FROM SHPDI SI
			INNER JOIN SHPDH SH ON SH.SHPOKY = SI.SHPOKY
			INNER JOIN SKUMA M  ON SI.SKUKEY = M.SKUKEY AND SH.OWNRKY = M.OWNRKY
			INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY 
			INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY 
		WHERE 1=1
		AND SI.STATIT NOT IN('FCO')  --주문취소 제외
		AND SUBSTR(SI.SHPOIT, 0, 1) != 1
		AND SH.WAREKY = #{WAREKY} 
		<choose>
			<when test="STKNUM != null and STKNUM != '' and STKNUM.indexOf('*') > -1">
				AND SI.SHPOKY = REPLACE(${STKNUM}, '*')
			</when>
			<otherwise>
				AND SI.STKNUM IN (${STKNUM})
			</otherwise>
		</choose>
		<if test="LOTA02 != null and LOTA02 != ''">
			AND SI.LOTA02 IN (${LOTA02})
		</if>
        AND TH.STATDO IN ('DUMMY'
			<if test="STAT01 == &quot;V&quot;">, 'NEW'</if>
			<if test="STAT02 == &quot;V&quot;">, 'PPC'</if>
			<if test="STAT03 == &quot;V&quot;">, 'FPC'</if>
			)
		<if test="NOTFPC == &quot;V&quot;">
		AND SI.STATIT != 'FPC' 
		</if>
		
		GROUP BY SI.STKNUM
				,SI.SVBELN
				,SI.SHPOKY
				,SH.RQSHPD
--				,SI.SHPOIT
				,SI.STATIT
				,NVL(DECODE(SH.SHPMTY, '231', SH.PTRCVR, SH.DPTNKY), ' ')
				,TI.TASKKY 
				,TH.STATDO 
		ORDER BY SI.STKNUM, SI.SHPOKY
	</select>
	
	<select id="DL061_TASDI_CANCEL_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT 1 
		  FROM SHPDH SH
	     INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY 
		 WHERE SI.STKNUM = #{STKNUM} 
		   AND SH.STATDO NOT IN ('FPC', 'PPC', 'OCN')
	</select>
	
	<!-- DL061 피킹완료 (선적단위) -->
	<select id="DL061HEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
		 	   /*+ USE_NL(tasdh tasdi)  use_nl(SHPDH  ct vd )  */
			   TASDH.WAREKY AS WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TASDH.WAREKY),' ') AS WARENM
			 , TASDH.TASOTY AS TASOTY
			 , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.TASOTY),' ') AS TASONM
			 , MAX(TASDH.DOCDAT) AS DOCDAT
			 , TASDH.DOCCAT AS DOCCAT
			 , (SELECT SHORTX FROM DOCCM WHERE DOCCAT = TASDH.DOCCAT) AS DOCCATNM
			 , TASDH.DRELIN AS DRELIN
			 , ( CASE 
					WHEN COUNT(DISTINCT(CMCDV.CDESC1)) = 1 THEN MAX(CMCDV.CDESC1)
					ELSE SUBSTR(LISTAGG(DISTINCT(CMCDV.CDESC1), ',') WITHIN GROUP (ORDER BY CMCDV.USARG1), 0, INSTR(LISTAGG(DISTINCT(CMCDV.CDESC1), ',') WITHIN GROUP (ORDER BY CMCDV.USARG1), ',') - 1) 
				END
				) TASKSTATDONM
			 , ( CASE 
					WHEN COUNT(DISTINCT(ST.CDESC1)) = 1 THEN MAX(ST.CDESC1)
					ELSE SUBSTR(LISTAGG(DISTINCT(ST.CDESC1), ',') WITHIN GROUP (ORDER BY ST.USARG1), 0, INSTR(LISTAGG(DISTINCT(ST.CDESC1), ',') WITHIN GROUP (ORDER BY ST.USARG1), ',') - 1) 
				END
				) STATDONM
			 , MAX(ST.USARG1) AS STATDONO 
			 , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = TASDH.TASOTY) AS ADJDSC
			 , TASDH.INDBZL AS INDBZL
			 , TASDH.INDARC AS INDARC
			 , TASDH.UPDCHK AS UPDCHK
			 , TASDH.KEEPTS AS KEEPTS
			 , CASE 
					WHEN SHPDI.STKNUM = ' ' THEN ' ' 
					WHEN COUNT(DISTINCT(CT.NAME01)) = 1 THEN MAX(CT.NAME01) 
					ELSE MAX(CT.NAME01)||' 외 '|| TO_CHAR(COUNT(DISTINCT(SHPDH.DPTNKY))-1, '9,999')||'건' 
			   END AS DPTNKYNM		 
			 , MAX(TASDI.SZMBLNO) AS SZMBLNO
			 , MAX(TASDI.SZMIPNO) AS SZMIPNO
			 , MAX(TASDI.STRAID) AS STRAID
			 , NVL(DECODE(SHPDI.STKNUM, ' ', NULL, SHPDI.STKNUM), '*'||SHPDI.SHPOKY)  AS STKNUM        --선적번호
			 , SHPDI.STLNUM 
			 , MAX(TASDI.STDLNR) AS STDLNR
			 ---?, MAX(TASDI.SSORNU) AS SSORNU
			 ---?, MAX(TASDI.SMBLNR) AS SMBLNR
			 ---?, MAX(TASDI.SXBLNR) AS SXBLNR
			 , NVL(SUM(DECODE(TASDI.ACTCDT, '00000000', 1, ' ', 1, 0)), 0) AS COMPLETECNT
			 ---?, MAX(TASDI.AREAKY) AS AREAKY
			 , MAX(TASDI.LOTA01) AS LOTA01
			 ---?, MAX(TASDI.LOTA04) AS LOTA04
			 , ' ' AS BUNAME
			 , ' ' AS BUPLANT
			 , ' ' AS BUCHRG
			 , ' ' AS TOVCHRG
			 , CASE 
				WHEN COUNT(DISTINCT(SHPDH.DOCUTY)) = 1 THEN MAX(SHPDH.DOCUTY) 
				WHEN COUNT(DISTINCT(SHPDH.DOCUTY)) > 1 THEN MAX(SHPDH.DOCUTY)||' 외 '|| TO_CHAR(COUNT(DISTINCT(SHPDH.DOCUTY))-1, '9,999')||'건'  
				ELSE ' ' 
			   END AS DOCUTY
			 , MAX(SHPDH.CARNO) AS CARNO 
			 , MAX(SHPDH.DRIVERCEL) AS DRIVERCEL
			 , NVL(SHPDI.STKNUM, ' ') AS TOTPICKNUM
		  FROM TASDH
			INNER JOIN TASDI ON TASDH.TASKKY = TASDI.TASKKY
			LEFT OUTER JOIN SHPDI ON SHPDI.SHPOKY = TASDI.SHPOKY AND SHPDI.SHPOIT = TASDI.SHPOIT
			LEFT OUTER JOIN SHPDH ON SHPDH.SHPOKY = TASDI.SHPOKY
			LEFT OUTER JOIN DOCTM ON SHPDH.DOCUTY = DOCTM.DOCUTY
			LEFT OUTER JOIN CMCDV ON TASDH.STATDO = CMCDV.CMCDVL AND CMCDKY = 'STATDO'
			LEFT OUTER JOIN CMCDV ST ON SHPDH.STATDO = ST.CMCDVL AND ST.CMCDKY = 'STATDO'
			LEFT OUTER JOIN BZPTN CT ON CT.OWNRKY = SHPDH.OWNRKY AND CT.PTNRTY  = 'CT' AND CT.PTNRKY  = SHPDH.DPTNKY
			LEFT OUTER JOIN BZPTN VD ON VD.OWNRKY = SHPDH.OWNRKY AND VD.PTNRTY  = 'VD' AND VD.PTNRKY  = SHPDH.PTRCVR	
		 WHERE TASDH.WAREKY = #{WAREKY}
		   AND TASDI.STATIT NOT IN('FCN')	   	   
		   AND TASDH.STATDO IN ('DUMMY' 
		<if test="STAT01 == &quot;V&quot;">, 'NEW'</if>
		<if test="STAT02 == &quot;V&quot;">, 'PPC'</if>
		<if test="STAT03 == &quot;V&quot;">, 'FPC'</if>
			)
		<if test="SKUG01 != null and SKUG01 != ''">
			AND M.SKUG01 = #{SKUG01}
	    </if>
	    <if test="SKUL01 != null and SKUL01 != ''">
	    	AND M.SKUL01 = #{SKUL01}
	    </if> 	    
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	 GROUP BY TASDH.WAREKY, TASDH.TASOTY, 
	 		  ---TASDH.DOCDAT, 
	 		  TASDH.DOCCAT,
			  TASDH.DRELIN, 
			  TASDH.INDBZL, TASDH.INDARC, TASDH.UPDCHK,
			  TASDH.KEEPTS, TASDH.WARETG, 
			  SHPDI.STKNUM, 
			  NVL(DECODE(SHPDI.STKNUM, ' ', NULL, SHPDI.STKNUM), '*'||SHPDI.SHPOKY), 
			  SHPDI.STLNUM  
	 ORDER BY SHPDI.STKNUM DESC
	</select>	
	
	
	<select id="DL061DETAIL_LIST" parameterType="Map" resultType="DataMap">
		SELECT TASDH.WAREKY AS WAREKY
		 	 , TASDH.PTNRKY AS PTNRKY
			 , NVL((SELECT NAME01 FROM WAHMA WH WHERE WH.WAREKY = TASDH.WAREKY),' ') AS WAREKYNM
			 , TASDI.TASKKY AS TASKKY
			 , TASDI.TASKIT AS TASKIT
			 , TASDI.TASKTY AS TASKTY
			 , TASDI.RSNCOD AS RSNCOD
			 , TASDI.TASRSN AS TASRSN
			 , TASDI.STATIT AS STATIT
			 , (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = TASDI.STATIT) AS STATITNM 
			 , (SELECT S.QTSHPO - (SELECT NVL(SUM(T.QTTAOR),0)
									 FROM TASDI T
									 WHERE T.SHPOKY = TASDI.SHPOKY
									   AND T.SHPOIT = TASDI.SHPOIT
									   AND T.TASKKY != TASDI.TASKKY)
				  FROM 	SHPDI S
				  WHERE S.SHPOKY = TASDI.SHPOKY
				  AND 	S.SHPOIT = TASDI.SHPOIT) AS QTABLE			
             ,( SELECT SUM(CASE WHEN S.AREAKY = 'SHP' THEN 0
					ELSE S.QTSIWH - S.QTSBLK
								  - GREATEST(S.QTSALO, S.QTSPMO)
								  - (CASE WHEN S.LOTA06 IN ('00') OR S.QTSPMO > 0 THEN 0
										  ELSE S.QTSIWH
									 END)
			   END) FROM STKKY S
               WHERE WAREKY =  TASDH.WAREKY  
                     AND   LOTNUM =  TASDI.LOTNUM
                     AND   TRNUID =  TASDI.TRNUSR )		 AS USEQTY                 
			 , TASDI.QTTAOR AS QTTAOR
			 , TASDI.QTTAOR AS QTSPUT
			 , SHPDI.QTSHPO AS QTSHPO
			 , SHPDI.QTJCMP AS QTJCMP	
			 , TASDI.QTCOMP AS QTCOMP		       			
			 , TASDI.OWNRKY AS OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = TASDI.OWNRKY),' ') AS OWNRKYNM
			 , TASDI.SKUKEY AS SKUKEY
			 , TASDI.LOTNUM AS LOTNUM
			 , TASDI.ACTCDT AS ACTCDT
			 , TASDI.ACTCTI AS ACTCTI
			 , TASDI.QTYUOM AS QTYUOM
			 , TASDI.TKFLKY AS TKFLKY
			 , TASDI.STEPNO AS STEPNO
			 , TASDI.LSTTFL AS LSTTFL
			 , TASDI.LOCASR AS LOCASR
			 , TASDI.SECTSR AS SECTSR
			 , TASDI.PAIDSR AS PAIDSR
			 , TASDI.TRNUSR AS TRNUSR
			 , TASDI.STRUTY AS STRUTY
			 , TASDI.SMEAKY AS SMEAKY
			 , TASDI.SUOMKY AS SUOMKY
			 , TASDI.QTSPUM AS QTSPUM
			 , TASDI.SDUOKY AS SDUOKY
			 , TASDI.QTSDUM AS QTSDUM
			 , TASDI.LOCATG AS LOCATG
			 , TASDI.SECTTG AS SECTTG
			 , TASDI.PAIDTG AS PAIDTG
			 , TASDI.TRNUTG AS TRNUTG
			 , TASDI.TTRUTY AS TTRUTY
			 , TASDI.TMEAKY AS TMEAKY
			 , TASDI.TUOMKY AS TUOMKY
			 , TASDI.QTTPUM AS QTTPUM
			 , TASDI.TDUOKY AS TDUOKY
			 , TASDI.QTTDUM AS QTTDUM
			 , (CASE	WHEN TASDI.ACTCDT = '00000000' THEN TASDI.LOCATG
			  		ELSE TASDI.LOCAAC END) AS LOCAAC
			 , (CASE	WHEN TASDI.ACTCDT = '00000000' THEN TASDI.SECTTG
			  		ELSE TASDI.SECTAC END) AS SECTAC
			 , (CASE	WHEN TASDI.ACTCDT = '00000000' THEN TASDI.PAIDTG
			  		ELSE TASDI.PAIDAC END) AS PAIDAC
			 , (CASE	WHEN TASDI.ACTCDT = '00000000' THEN TASDI.TRNUTG
			  		ELSE TASDI.TRNUAC END) AS TRNUAC
			 , (CASE	WHEN TASDI.ACTCDT = '00000000' THEN TASDI.TTRUTY
			  		ELSE TASDI.ATRUTY END) AS ATRUTY
			 , DECODE(TASDI.ACTCDT, '00000000', TASDI.TMEAKY, TASDI.AMEAKY) AS AMEAKY
			 , DECODE(TASDI.ACTCDT, '00000000', DECODE(TASDI.TASKTY, 'PT', TASDI.SUOMKY, TASDI.TUOMKY), TASDI.AUOMKY) AS AUOMKY
			 , DECODE(TASDI.ACTCDT, '00000000', TASDI.QTTPUM, TASDI.QTAPUM) AS QTAPUM
			 , DECODE(TASDI.ACTCDT, '00000000', TASDI.TDUOKY, TASDI.ADUOKY) AS ADUOKY
			 , DECODE(TASDI.ACTCDT, '00000000', TASDI.QTTDUM, TASDI.QTADUM) AS QTADUM
			 , TASDI.REFDKY AS REFDKY
			 , TASDI.REFDIT AS REFDIT
			 , TASDI.REFCAT AS REFCAT
			 , TASDI.REFDAT AS REFDAT
			 , TASDI.PURCKY AS PURCKY
			 , TASDI.PURCIT AS PURCIT
			 , TASDI.ASNDKY AS ASNDKY
			 , TASDI.ASNDIT AS ASNDIT
			 , TASDI.RECVKY AS RECVKY
			 , TASDI.RECVIT AS RECVIT
			 , TASDI.SHPOKY AS SHPOKY
			 , TASDI.SHPOIT AS SHPOIT
			 , TASDI.GRPOKY AS GRPOKY
			 , TASDI.GRPOIT AS GRPOIT
			 , TASDI.SADJKY AS SADJKY
			 , TASDI.SADJIT AS SADJIT
			 , TASDI.SDIFKY AS SDIFKY
			 , TASDI.SDIFIT AS SDIFIT
			 , TASDI.PHYIKY AS PHYIKY
			 , TASDI.PHYIIT AS PHYIIT
			 , TASDI.DROPID AS DROPID
			 , TASDI.DESC01 AS DESC01
			 , TASDI.DESC02 AS DESC02
			 , TASDI.ASKU01 AS ASKU01
			 , TASDI.ASKU02 AS ASKU02
			 , TASDI.ASKU03 AS ASKU03
			 , TASDI.ASKU04 AS ASKU04
			 , TASDI.ASKU05 AS ASKU05
			 , TASDI.EANCOD AS EANCOD
			 , TASDI.GTINCD AS GTINCD
			 , TASDI.SKUG01 AS SKUG01
			 , TASDI.SKUG02 AS SKUG02
			 , TASDI.SKUG03 AS SKUG03
			 , TASDI.SKUG04 AS SKUG04
			 , TASDI.SKUG05 AS SKUG05
			 , TASDI.GRSWGT AS GRSWGT
			 , TASDI.NETWGT AS NETWGT
			 , TASDI.WGTUNT AS WGTUNT
			 , TASDI.LENGTH AS LENGTH
			 , TASDI.WIDTHW AS WIDTHW
			 , TASDI.HEIGHT AS HEIGHT
			 , TASDI.CUBICM AS CUBICM
			 , TASDI.CAPACT AS CAPACT
			 , TASDI.WORKID AS WORKID
			 , TASDI.WORKNM AS WORKNM
			 , TASDI.HHTTID AS HHTTID
			 , TASDI.AREAKY AS AREAKY
			 , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = TASDH.WAREKY AND AREAKY =  TASDI.AREAKY),' ') AS AREAKYNM
			 , TASDI.LOTA01 AS LOTA01
			 , NVL(TRIM((SELECT STLNM FROM STLMA WHERE STLKY = TASDI.LOTA01 AND PLNTKY = TASDI.LOTA02 AND WAREKY = TASDH.WAREKY)), ' ') AS LOTA01NM
			 , TASDI.LOTA02 AS LOTA02
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA02', TASDI.LOTA02) AS LOTA02NM
			 , TASDI.LOTA03 AS LOTA03
			 , TASDI.LOTA04 AS LOTA04
			 , TASDI.LOTA05 AS LOTA05
			 , TASDI.LOTA06 AS LOTA06
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TASDI.LOTA06) AS LOTA06NM
			 , TASDI.LOTA07 AS LOTA07
			 , TASDI.LOTA08 AS LOTA08
			 , SZF_GET_CMCDV_CDESC1_TEXT(TASDI.OWNRKY, 'NATNKY', TASDI.LOTA08) AS LOTA08NM								
			 , TASDI.LOTA09 AS LOTA09
			 , NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = TASDI.OWNRKY AND PTNRTY = 'CT' AND PTNRKY= TASDI.LOTA09), ' ') AS LOTA09NM
			 , SHPDI.LOTA10 AS LOTA10
			 , TASDI.LOTA11 AS LOTA11
			 , TASDI.LOTA12 AS LOTA12
			 , TASDI.LOTA13 AS LOTA13
			 , TASDI.LOTA14 AS LOTA14
			 , TASDI.LOTA15 AS LOTA15
			 , TASDI.LOTA16 AS LOTA16
			 , TASDI.LOTA17 AS LOTA17
			 , TASDI.LOTA18 AS LOTA18
			 , TASDI.LOTA19 AS LOTA19
			 , TASDI.LOTA20 AS LOTA20
			 , TASDI.AWMSNO AS AWMSNO
			 , TASDI.AWMSTS AS AWMSTS
			 , TASDI.SMANDT AS SMANDT
			 , TASDI.SEBELN AS SEBELN
			 , TASDI.SEBELP AS SEBELP
			 , TASDI.SZMBLNO AS SZMBLNO
			 , TASDI.SZMIPNO AS SZMIPNO
			 , TASDI.STRAID AS STRAID
			 , TASDI.SVBELN AS SVBELN
			 , TASDI.SPOSNR AS SPOSNR
			 , TASDI.STKNUM AS STKNUM
			 , TASDI.STPNUM AS STPNUM
			 , TASDI.SWERKS AS SWERKS
			 , TASDI.SLGORT AS SLGORT
			 , TASDI.SDATBG AS SDATBG
			 , TASDI.STDLNR AS STDLNR
			 , TASDI.SSORNU AS SSORNU
			 , TASDI.SSORIT AS SSORIT
			 , TASDI.SMBLNR AS SMBLNR
			 , TASDI.SZEILE AS SZEILE
			 , TASDI.SMJAHR AS SMJAHR
			 , TASDI.SXBLNR AS SXBLNR
			 , TASDI.SAPSTS AS SAPSTS
			 , TASDI.DOORKY AS DOORKY
			 , TASDI.PTLT01 AS PTLT01
			 , TASDI.PTLT02 AS PTLT02
			 , TASDI.PTLT03 AS PTLT03
			 , TASDI.PTLT04 AS PTLT04
			 , TASDI.PTLT05 AS PTLT05
			 , TASDI.PTLT06 AS PTLT06
			 , TASDI.PTLT07 AS PTLT07
			 , TASDI.PTLT08 AS PTLT08
			 , TASDI.PTLT09 AS PTLT09
			 , TASDI.PTLT10 AS PTLT10
			 , TASDI.PTLT11 AS PTLT11
			 , TASDI.PTLT12 AS PTLT12
			 , TASDI.PTLT13 AS PTLT13
			 , TASDI.PTLT14 AS PTLT14
			 , TASDI.PTLT15 AS PTLT15
			 , TASDI.PTLT16 AS PTLT16
			 , TASDI.PTLT17 AS PTLT17
			 , TASDI.PTLT18 AS PTLT18
			 , TASDI.PTLT19 AS PTLT19
			 , TASDI.PTLT20 AS PTLT20
			 , C.AUTLOC AS AUTLOC
			 , TASDI.CREDAT AS CREDAT
			 , TASDI.CRETIM AS CRETIM
			 , TASDI.CREUSR AS CREUSR
			 , (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TASDI.CREUSR) AS CUSRNM
			 , TASDI.LMODAT AS LMODAT
			 , TASDI.LMOTIM AS LMOTIM
			 , TASDI.LMOUSR AS LMOUSR
			 , (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TASDI.LMOUSR) AS LUSRNM
			 , TASDI.INDBZL AS INDBZL
			 , TASDI.INDARC AS INDARC
			 , TASDI.UPDCHK AS UPDCHK
			 , SHPDI.ALSTKY AS ALSTKY
			 , SHPDI.UOMKEY AS UOMKEY
			 , SHPDI.DUOMKY AS DUOMKY			 
             , NVL((SELECT SKUL01 FROM SKUMA WHERE SKUKEY = SHPDI.SKUKEY AND OWNRKY = TASDI.OWNRKY),' ') AS SKUL01
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TASDH.WAREKY, TASDI.SKUKEY, DECODE(NVL(TASDI.QTCOMP, 0), 0, TASDI.QTTAOR, TASDI.QTCOMP), TASDI.SUOMKY, 'KG')),'0') AS TOT
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TASDH.WAREKY, TASDI.SKUKEY, DECODE(NVL(TASDI.QTCOMP, 0), 0, TASDI.QTTAOR, TASDI.QTCOMP), TASDI.SUOMKY, 'BAG')),'0') AS BAG
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TASDH.WAREKY, TASDI.SKUKEY, DECODE(NVL(TASDI.QTCOMP, 0), 0, TASDI.QTTAOR, TASDI.QTCOMP), TASDI.SUOMKY, 'BOX')),'0') AS BOX
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TASDH.WAREKY, TASDI.SKUKEY, DECODE(NVL(TASDI.QTCOMP, 0), 0, TASDI.QTTAOR, TASDI.QTCOMP), TASDI.SUOMKY, 'PAL')),'0') AS PLT
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TASDH.WAREKY, TASDI.SKUKEY, DECODE(NVL(TASDI.QTCOMP, 0), 0, TASDI.QTTAOR, TASDI.QTCOMP), TASDI.SUOMKY, 'SOK')),'0') AS SOK
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TASDH.WAREKY, TASDI.SKUKEY, DECODE(NVL(TASDI.QTCOMP, 0), 0, TASDI.QTTAOR, TASDI.QTCOMP), TASDI.SUOMKY, 'EA')),'0') AS EA
             , CASE WHEN DECODE(NVL(TASDI.QTCOMP, 0), 0, TASDI.QTTAOR, TASDI.QTCOMP) = 0 THEN 0 
					ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(TASDH.WAREKY, TASDI.SKUKEY, DECODE(NVL(TASDI.QTCOMP, 0), 0, TASDI.QTTAOR, TASDI.QTCOMP), TASDI.SUOMKY, 'BAG'))) / TRIM(TRIM(SZF_GET_CONVERT_QTY(TASDH.WAREKY, TASDI.SKUKEY, DECODE(NVL(TASDI.QTCOMP, 0), 0, TASDI.QTTAOR, TASDI.QTCOMP), TASDI.SUOMKY, 'BOX'))),'0.000') 
				END AS BOXBAG 
             , TASDH.DOCTXT AS DOCTXT    
             , 'V' AS OLDLOC
             , SHPDI.APPOINTPICKING
             ,TASDH.TASKKY AS TASKKY
			 ,TASDI.SVBELN AS SVBELN 
			 ,TASDI.SHPOKY AS SHPOKY
			 ,NVL(SHPDH.SAP2, ' ') AS SAP2 
			 ,SHPDH.RQSHPD AS RQSHPD
			 ,SHPDH.DOCUTY 
			 ,(SELECT SHORTX FROM DOCTM WHERE DOCUTY = SHPDH.DOCUTY) AS DOCUTYNM 
			 ,(SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATDO' AND X.CMCDVL = SHPDH.STATDO) AS STATDONM
			 ,(SELECT USARG1 FROM CMCDV X WHERE X.CMCDKY = 'STATDO' AND X.CMCDVL = SHPDH.STATDO) AS STATDONO
			 ,NVL(DECODE(SHPDH.SHPMTY, '231', SHPDH.PTRCVR, SHPDH.DPTNKY), ' ') AS DPTNKY              
			 ,NVL(DECODE(SHPDH.SHPMTY, '231', VD.NAME01, CT.NAME01), ' ') AS DPTNKYNM	
		 FROM TASDH TASDH
			INNER JOIN TASDI TASDI ON TASDI.TASKKY = TASDH.TASKKY
			INNER JOIN LOCMA C ON C.WAREKY = TASDH.WAREKY AND C.LOCAKY = TASDI.LOCASR
			INNER JOIN SHPDI SHPDI ON SHPDI.SHPOKY = TASDI.SHPOKY AND SHPDI.SHPOIT = TASDI.SHPOIT 
			INNER JOIN SHPDH SHPDH ON SHPDH.SHPOKY = TASDI.SHPOKY 
			LEFT OUTER JOIN BZPTN CT ON CT.OWNRKY = SHPDH.OWNRKY AND CT.PTNRTY  = 'CT' AND CT.PTNRKY  = SHPDH.DPTNKY
			LEFT OUTER JOIN BZPTN VD ON VD.OWNRKY = SHPDH.OWNRKY AND VD.PTNRTY  = 'VD' AND VD.PTNRKY  = SHPDH.PTRCVR	
		 WHERE 	TASDH.TASKKY = TASDI.TASKKY
		   AND 	TASDH.WAREKY = C.WAREKY
		   AND 	TASDI.LOCASR = C.LOCAKY
		   AND  TASDI.STATIT NOT IN('FCN') 
		   <!-- AND  NVL(DECODE(SHPDI.STKNUM, ' ', NULL, SHPDI.STKNUM), '*'||SHPDI.SHPOKY) = #{STKNUM}  쿼리개선목적 조건절 수정 (choose 문처리) -->
		<choose>
			<when test="STKNUM != null and STKNUM != '' and STKNUM.indexOf('*') > -1">
				AND SHPDI.SHPOKY = REPLACE(#{STKNUM}, '*')
			</when>
			<otherwise>
				AND SHPDI.STKNUM = #{STKNUM}
			</otherwise>
		</choose>
	    <if test="TASKKY != null and TASKKY != ''">
		   AND TASDH.TASKKY = #{TASKKY}
		</if>
		   AND  TASDH.STATDO IN ('DUMMY' 
	    <if test="STAT01 == &quot;V&quot;">, 'NEW'</if>
		<if test="STAT02 == &quot;V&quot;">, 'PPC'</if>
		<if test="STAT03 == &quot;V&quot;">, 'FPC'</if>
				)
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
		   ${RANGE_SQL}
	   </if>
		ORDER BY TASDI.TASKKY, TASDI.TASKIT
	</select>
	
	<select id="DL061_SAVE_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY AS WAREKY,
		       B.TASKKY AS TASKKY,
		       B.TASKIT AS TASKIT,
		       B.TASKTY AS TASKTY,
		       B.RSNCOD AS RSNCOD,
		       B.TASRSN AS TASRSN,
		       B.STATIT AS STATIT,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = B.STATIT) AS STATITNM,
		       B.QTTAOR AS QTTAOR,
		       B.QTTAOR AS QTCOMP,
		       B.OWNRKY AS OWNRKY,
		       B.SKUKEY AS SKUKEY,
		       B.LOTNUM AS LOTNUM,
		       B.ACTCDT AS ACTCDT,
		       B.ACTCTI AS ACTCTI,
		       B.QTYUOM AS QTYUOM,
		       B.TKFLKY AS TKFLKY,
		       B.STEPNO AS STEPNO,
		       B.LSTTFL AS LSTTFL,
		       B.LOCASR AS LOCASR,
		       B.SECTSR AS SECTSR,
		       B.PAIDSR AS PAIDSR,
		       B.TRNUSR AS TRNUSR,
		       B.STRUTY AS STRUTY,
		       B.SMEAKY AS SMEAKY,
		       B.SUOMKY AS SUOMKY,
		       B.QTSPUM AS QTSPUM,
		       B.SDUOKY AS SDUOKY,
		       B.QTSDUM AS QTSDUM,
		       B.LOCATG AS LOCATG,
		       B.SECTTG AS SECTTG,
		       B.PAIDTG AS PAIDTG,
		       B.TRNUTG AS TRNUTG,
		       B.TTRUTY AS TTRUTY,
		       B.TMEAKY AS TMEAKY,
		       B.TUOMKY AS TUOMKY,
		       B.QTTPUM AS QTTPUM,
		       B.TDUOKY AS TDUOKY,
		       B.QTTDUM AS QTTDUM,
		       B.LOCATG AS LOCAAC,
		       B.SECTTG AS SECTAC,
		       B.PAIDTG AS PAIDAC,
		       B.TRNUTG AS TRNUAC,
		       B.TTRUTY AS ATRUTY,
		       B.TMEAKY AS AMEAKY,
		       B.TUOMKY AS AUOMKY,
		       B.QTTPUM AS QTAPUM,
		       B.TDUOKY AS ADUOKY,
		       B.QTTDUM AS QTADUM,
		       B.REFDKY AS REFDKY,
		       B.REFDIT AS REFDIT,
		       B.REFCAT AS REFCAT,
		       B.REFDAT AS REFDAT,
		       B.PURCKY AS PURCKY,
		       B.PURCIT AS PURCIT,
		       B.ASNDKY AS ASNDKY,
		       B.ASNDIT AS ASNDIT,
		       B.RECVKY AS RECVKY,
		       B.RECVIT AS RECVIT,
		       B.SHPOKY AS SHPOKY,
		       B.SHPOIT AS SHPOIT,
		       B.GRPOKY AS GRPOKY,
		       B.GRPOIT AS GRPOIT,
		       B.SADJKY AS SADJKY,
		       B.SADJIT AS SADJIT,
		       B.SDIFKY AS SDIFKY,
		       B.SDIFIT AS SDIFIT,
		       B.PHYIKY AS PHYIKY,
		       B.PHYIIT AS PHYIIT,
		       B.DROPID AS DROPID,
		       B.DESC01 AS DESC01,
		       B.DESC02 AS DESC02,
		       B.ASKU01 AS ASKU01,
		       B.ASKU02 AS ASKU02,
		       B.ASKU03 AS ASKU03,
		       B.ASKU04 AS ASKU04,
		       B.ASKU05 AS ASKU05,
		       B.EANCOD AS EANCOD,
		       B.GTINCD AS GTINCD,
		       B.SKUG01 AS SKUG01,
		       B.SKUG02 AS SKUG02,
		       B.SKUG03 AS SKUG03,
		       B.SKUG04 AS SKUG04,
		       B.SKUG05 AS SKUG05,
		       B.GRSWGT AS GRSWGT,
		       B.NETWGT AS NETWGT,
		       B.WGTUNT AS WGTUNT,
		       B.LENGTH AS LENGTH,
		       B.WIDTHW AS WIDTHW,
		       B.HEIGHT AS HEIGHT,
		       B.CUBICM AS CUBICM,
		       B.CAPACT AS CAPACT,
		       B.WORKID AS WORKID,
		       B.WORKNM AS WORKNM,
		       B.HHTTID AS HHTTID,
		       B.AREAKY AS AREAKY,
		       B.LOTA01 AS LOTA01,
		       B.LOTA02 AS LOTA02,
		       B.LOTA03 AS LOTA03,
		       B.LOTA04 AS LOTA04,
		       B.LOTA05 AS LOTA05,
		       B.LOTA06 AS LOTA06,
		       B.LOTA07 AS LOTA07,
		       B.LOTA08 AS LOTA08,
		       B.LOTA09 AS LOTA09,
		       B.LOTA10 AS LOTA10,
		       B.LOTA11 AS LOTA11,
		       B.LOTA12 AS LOTA12,
		       B.LOTA13 AS LOTA13,
		       B.LOTA14 AS LOTA14,
		       B.LOTA15 AS LOTA15,
		       B.LOTA16 AS LOTA16,
		       B.LOTA17 AS LOTA17,
		       B.LOTA18 AS LOTA18,
		       B.LOTA19 AS LOTA19,
		       B.LOTA20 AS LOTA20,
		       B.AWMSNO AS AWMSNO,
		       B.AWMSTS AS AWMSTS,
		       B.SMANDT AS SMANDT,
		       B.SEBELN AS SEBELN,
		       B.SEBELP AS SEBELP,
		       B.SZMBLNO AS SZMBLNO,
		       B.SZMIPNO AS SZMIPNO,
		       B.STRAID AS STRAID,
		       B.SVBELN AS SVBELN,
		       B.SPOSNR AS SPOSNR,
		       B.STKNUM AS STKNUM,
		       B.STPNUM AS STPNUM,
		       B.SWERKS AS SWERKS,
		       B.SLGORT AS SLGORT,
		       B.SDATBG AS SDATBG,
		       B.STDLNR AS STDLNR,
		       B.SSORNU AS SSORNU,
		       B.SSORIT AS SSORIT,
		       B.SMBLNR AS SMBLNR,
		       B.SZEILE AS SZEILE,
		       B.SMJAHR AS SMJAHR,
		       B.SXBLNR AS SXBLNR,
		       B.SAPSTS AS SAPSTS,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       C.AUTLOC AS AUTLOC,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK
		  FROM TASDH A,
		       TASDI B,
		       LOCMA C
		 WHERE A.TASKKY = B.TASKKY
		   AND A.WAREKY = C.WAREKY
		   AND B.LOCASR = C.LOCAKY
	   <choose>
			<when test="STKNUM != null and STKNUM != '' and STKNUM.indexOf('*') > -1">
				AND B.SHPOKY = REPLACE(#{STKNUM}, '*')
			</when>
			<otherwise>
				AND B.STKNUM = #{STKNUM}
			</otherwise>
		</choose>
		   AND B.STATIT = 'NEW'
		 ORDER BY B.TASKKY, B.TASKIT
	</select>
	<!-- DL061 피킹완료 (선적단위) END -->
</mapper>