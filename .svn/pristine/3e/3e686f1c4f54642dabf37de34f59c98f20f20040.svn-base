			 , TI.TTRUTY
			 , TI.TMEAKY
			 , TI.TUOMKY
			 , TI.QTTPUM
			 , TI.TDUOKY
			 , TI.QTTDUM
			 , TI.LOCATG AS LOCAAC
			 , TI.SECTTG AS SECTAC
			 , TI.PAIDTG AS PAIDAC
			 , TI.TRNUTG AS TRNUAC
