			 , ZM.PLNTKY
			 , ZM.PLNTKY AS PLNTKY_ORG
			 , SW.PASTKY
		     , SRC_T.SRCSKY
		FROM TASDH TH
		  INNER JOIN TASDI TI
		          ON TI.TASKKY = TH.TASKKY
				 AND TI.OWNRKY = #{OWNRKY}
				 AND TI.STATIT = 'NEW'
		  INNER JOIN LOCMA LM
		          ON LM.WAREKY = TH.WAREKY 
		         AND LM.LOCAKY = TI.LOCASR 
		  LEFT OUTER JOIN STLMA SLM
		               ON SLM.OWNRKY = TI.OWNRKY 
		              AND SLM.PLNTKY = TI.LOTA02 
		              AND SLM.STLKY  = TI.LOTA01
		  LEFT OUTER JOIN LOCMA LMA
		               ON LMA.WAREKY = TH.WAREKY
		 		      AND LMA.LOCAKY = TI.LOCATG		   
		  LEFT OUTER JOIN ZONMA ZM
		               ON ZM.WAREKY = LMA.WAREKY
		              AND ZM.ZONEKY = LMA.ZONEKY		  
		  LEFT OUTER JOIN SKUWC SW
		               ON SW.OWNRKY = TI.OWNRKY
		              AND SW.SKUKEY = TI.SKUKEY
		              AND SW.WAREKY = TH.WAREKY
		  LEFT OUTER JOIN SK_T SRC_T 
                       ON SRC_T.TASKKY = TI.TASKKY
   	                  AND SRC_T.TASKIT = TI.TASKIT
		WHERE TH.WAREKY = #{WAREKY}
		  AND TH.TASKKY = #{TASKKY}
		ORDER BY TI.TASKKY, TI.TASKIT

	</select>
	
