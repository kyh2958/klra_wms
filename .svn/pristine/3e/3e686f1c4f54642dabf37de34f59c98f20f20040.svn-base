			 , TI.HHTTID
			 , TI.AREAKY
			 , TI.LOTA01
			 , SLM.STLNM AS LOTA01NM
			 , TI.LOTA02
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA02', TI.LOTA02) AS LOTA02NM
			 , TI.LOTA03
			 , TI.LOTA04
			 , TI.LOTA05
			 , TI.LOTA06
			 , TI.LOTA07
			 , TI.LOTA08
			 , TI.LOTA09
			 , TI.LOTA10
			 , TI.LOTA11
			 , TI.LOTA12
			 , TI.LOTA13
			 , TI.LOTA14
			 , TI.LOTA15
			 , TI.LOTA16
			 , TI.LOTA17
			 , TI.LOTA18
			 , TI.LOTA19
			 , TI.LOTA20
			  
			 , TI.LOTA01 AS ALOTA01
			 , TI.LOTA02 AS ALOTA02
			 , TI.LOTA03 AS ALOTA03
			 , TI.LOTA04 AS ALOTA04
			 , TI.LOTA05 AS ALOTA05
			 , TI.LOTA06 AS ALOTA06
			 , TI.LOTA07 AS ALOTA07
			 , TI.LOTA08 AS ALOTA08
			 , TI.LOTA09 AS ALOTA09
			 , TI.LOTA10 AS ALOTA10
			 , TI.LOTA11 AS ALOTA11
			 , TI.LOTA12 AS ALOTA12
			 , TI.LOTA13 AS ALOTA13
			 , TI.LOTA14 AS ALOTA14
			 , TI.LOTA15 AS ALOTA15
			 , TI.LOTA16 AS ALOTA16
			 , TI.LOTA17 AS ALOTA17
			 , TI.LOTA18 AS ALOTA18
			 , TI.LOTA19 AS ALOTA19
			 , TI.LOTA20 AS ALOTA20
			   
			 , TI.AWMSNO
			 , TI.AWMSTS
			 , TI.SMANDT
			 , TI.SEBELN
			 , TI.SEBELP
			 , TI.SZMBLNO
			 , TI.SZMIPNO
			 , TI.STRAID
			 , TI.SVBELN
			 , TI.SPOSNR
			 , TI.STKNUM
			 , TI.STPNUM
			 , TI.SWERKS
			 , TI.SLGORT
			 , TI.SDATBG
			 , TI.STDLNR
			 , TI.SSORNU
			 , TI.SSORIT
			 , TI.SMBLNR
			 , TI.SZEILE
			 , TI.SMJAHR
			 , TI.SXBLNR
			 , TI.SAPSTS
			 , TI.DOORKY
			 , TI.PTLT01
			 , TI.PTLT02
			 , TI.PTLT03
			 , TI.PTLT04
			 , TI.PTLT05
			 , TI.PTLT06
			 , TI.PTLT07
			 , TI.PTLT08
			 , TI.PTLT09
			 , TI.PTLT10
			 , TI.PTLT11
			 , TI.PTLT12
			 , TI.PTLT13
			 , TI.PTLT14
			 , TI.PTLT15
			 , TI.PTLT16
			 , TI.PTLT17
			 , TI.PTLT18
			 , TI.PTLT19
			 , TI.PTLT20
			 , LM.AUTLOC
			 , TI.CREDAT
			 , TI.CRETIM
			 , TI.CREUSR
			 , (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TI.CREUSR) AS CUSRNM
			 , TI.LMODAT
			 , TI.LMOTIM
			 , TI.LMOUSR
			 , (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = TI.LMOUSR) AS LUSRNM
			 , TI.INDBZL
			 , TI.INDARC
			 , TI.UPDCHK
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.TUOMKY, 'KG')),'0') AS TOT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.TUOMKY, 'BAG')),'0') AS BAG
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.TUOMKY, 'BOX')),'0') AS BOX
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.TUOMKY, 'PAL')),'0') AS PLT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.TUOMKY, 'SOK')),'0') AS SOK
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.TUOMKY, 'EA')),'0') AS EA
			 , ZM.STLKY
			 , ZM.STLKY AS STLKY_ORG
			 , ZM.PLNTKY
			 , ZM.PLNTKY AS PLNTKY_ORG
			 , SW.PASTKY
		     , SRC_T.SRCSKY
		FROM TASDH TH
		  INNER JOIN TASDI TI
		          ON TI.TASKKY = TH.TASKKY
				 AND TI.OWNRKY = #{OWNRKY}
				 AND TI.STATIT = 'NEW'
		  INNER JOIN LOCMA LM
		          ON LM.WAREKY = TH.WAREKY 
		         AND LM.LOCAKY = TI.LOCASR 
		  LEFT OUTER JOIN STLMA SLM
		               ON SLM.OWNRKY = TI.OWNRKY 
		              AND SLM.PLNTKY = TI.LOTA02 
		              AND SLM.STLKY  = TI.LOTA01
		  LEFT OUTER JOIN LOCMA LMA
		               ON LMA.WAREKY = TH.WAREKY
		 		      AND LMA.LOCAKY = TI.LOCATG		   
		  LEFT OUTER JOIN ZONMA ZM
		               ON ZM.WAREKY = LMA.WAREKY
		              AND ZM.ZONEKY = LMA.ZONEKY
		  LEFT OUTER JOIN SKUMA SM
		               ON SM.OWNRKY = TI.OWNRKY 
		              AND SM.SKUKEY = TI.SKUKEY
		  LEFT OUTER JOIN SKUWC SW
		               ON SW.OWNRKY = TI.OWNRKY
		              AND SW.SKUKEY = TI.SKUKEY
		              AND SW.WAREKY = TH.WAREKY
		  LEFT OUTER JOIN SK_T SRC_T 
                       ON SRC_T.TASKKY = TI.TASKKY
   	                  AND SRC_T.TASKIT = TI.TASKIT
		WHERE TH.WAREKY = #{WAREKY}
		  AND TH.TASKKY = #{TASKKY}
		  <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		  </if>
		  <if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		  </if>
		  <if test="LOTA06 != null and LOTA06 != ''">
			AND TI.LOTA06 = #{LOTA06}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
		   	${RANGE_SQL}
		  </if>
		ORDER BY TI.TASKKY, TI.TASKIT
	</select>	
	
	
	<select id="PT02_SAVE_LIST" parameterType="Map" resultType="DataMap">
		WITH SK_T AS (
		    SELECT SK.TASKKY
		         , SK.TASKIT
		         , MIN(SK.SRCSKY) AS SRCSKY
		    FROM STKKY SK
		      INNER JOIN TASDR TD
		              ON TD.TASKKY = SK.TASKKY
		             AND TD.TASKIT = SK.TASKIT
		    WHERE SK.WAREKY = #{WAREKY}
		      AND SK.TASKKY = #{TASKKY}
		    GROUP BY SK.TASKKY, SK.TASKIT
		)
		SELECT TH.WAREKY
			 , TI.TASKKY
			 , TI.TASKIT
			 , TI.TASKTY
			 , TI.RSNCOD
			 , TI.TASRSN
			 , TI.STATIT
			 , TI.QTTAOR
