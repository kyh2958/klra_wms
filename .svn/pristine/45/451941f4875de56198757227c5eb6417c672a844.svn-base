		    ,  S.UPDCHK AS  UPDCHK 
		FROM   SHPDI S
		WHERE  S.SHPOKY= #{SHPOKY}
		AND    1=1
		<choose>
		<when test='SAMETYPE == "N"'> 
			AND   S.SKUKEY= #{SKUKEY}
			AND   ROWNUM = 1
		</when>
		<otherwise>
			AND   S.SHPOIT= #{SHPOIT}
		</otherwise> 	
		</choose>	
	</select>

	<select id="DL041_SEARCHMAXTASDH_LIST" parameterType="Map" resultType="DataMap">
		SELECT  MAX(TASDI.TASKKY) AS TASKKY
	       	   ,MAX(TASDI.TASKIT) AS TASKIT
		FROM	TASDI
		    INNER JOIN TASDH ON TASDH.TASKKY = TASDI.TASKKY
		WHERE	1 = 1
		AND		TASDI.SHPOKY = #{SHPOKY}
<!-- 		AND		TASDI.SHPOIT = #{SHPOIT} -->
		AND		TASDH.WAREKY = #{WAREKY}
		AND		TASDI.TASKKY= #{TASKKY}				
	</select>
	
	<parameterMap id="ProcMap" type="java.util.Map">
		<parameter property="TASKKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="TASKIT" javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="ERRNUM" javaType="java.lang.Long" jdbcType="DECIMAL" mode="OUT"/>
		<parameter property="ERRMSG" javaType="java.lang.String" jdbcType="VARCHAR" mode="OUT"/>
	</parameterMap>
	
	<select id="DL041_SHPDPROCALL_MAP" parameterType="Map" resultType="DataMap">
		{ call P_TASK_COMPLETE_BY_SHPD(#{SHPOKY}, #{SES_USER_ID}) }
	</select>
	
	<resultMap id="DL041_ALLOC_PROCALL_RESULT" type="hashmap"></resultMap>
	<select id="ALLOC_PROCALL_MAP" parameterType="Map" statementType="CALLABLE">
		{ call SZP_BATCH_ALLOCATION(#{SHPOKY}, #{SES_USER_ID}, #{result, mode=OUT, jdbcType=VARCHAR, javaType=String, resultMap=ALLOC_PROCALL_RESULT}) }
	</select>

	<!-- 할당 : 선적번호를 출고문서 번호로 변경-->
	<select id="CONVERT_STKNUM_TO_SHPOKY_LIST" parameterType="Map" resultType="DataMap">
		SELECT	 SI.STKNUM			--선적번호
				,SI.SHPOKY			--출고문서번호
				,SI.SVBELN			--출고오더번호/납품문서번호
				,SH.RQSHPD			--출하요청일자
--				,SI.SHPOIT			--아이템번호
				,SI.STATIT			--아이템상태코드
		FROM SHPDI SI
			INNER JOIN SHPDH SH ON SH.SHPOKY = SI.SHPOKY
			INNER JOIN SKUMA M  ON SI.SKUKEY = M.SKUKEY
								AND SH.OWNRKY = M.OWNRKY
		WHERE 1=1
		AND SI.STATIT NOT IN('FCO')  --주문취소 제외
		AND SUBSTR(SI.SHPOIT, 0, 1) != 1
		AND SH.WAREKY = #{WAREKY}
		AND SI.LOTA02 IN ${LOTA02}
		<choose>
			<when test="STKNUM != null and STKNUM != '' and STKNUM.indexOf('*') > -1">
				AND SI.SHPOKY = REPLACE(${STKNUM}, '*')
			</when>
			<otherwise>
				AND SI.STKNUM IN (${STKNUM})
			</otherwise>
		</choose>
		<if test="RQSHPD_FR != null and RQSHPD_FR != '' and RQSHPD_TO != null and RQSHPD_TO != ''">
			AND SH.RQSHPD <![CDATA[>=]]> #{RQSHPD_FR}
			AND SH.RQSHPD <![CDATA[<=]]> #{RQSHPD_TO} 
		</if>
		<if test="RQSHPD != null and RQSHPD != ''">
			AND SH.RQSHPD <![CDATA[=]]> #{RQSHPD_FR}
		</if>
<!-- 		AND	SH.STATDO IN ( 'DUMMY'
                        <if test="STAT01 == &quot;V&quot;">, 'NEW' /*미작업*/ </if>
                        <if test="STAT02 == &quot;V&quot;">, 'PAL' /*부분할당*/</if>
                        <if test="STAT03 == &quot;V&quot;">, 'FAL' /*할당완료*/</if>
                        <if test="STAT04 == &quot;V&quot;">, 'PPC' /*부분피킹*/</if>
                        <if test="STAT05 == &quot;V&quot;">, 'FPC' /*피킹완료*/</if>
                        <if test="STAT06 == &quot;V&quot;">, 'PCK' /*부분상차*/</if>
                        <if test="STAT07 == &quot;V&quot;">, 'FCK' /*상차완료*/</if>
                        <if test="STAT08 == &quot;V&quot;">, 'PSH' /*부분출고*/</if>
                        <if test="STAT09 == &quot;V&quot;">, 'FSH' /*출고완료*/</if>
                        ) -->
		GROUP BY SI.STKNUM
				,SI.SVBELN
				,SI.SHPOKY
				,SH.RQSHPD
--				,SI.SHPOIT
				,SI.STATIT
		ORDER BY SI.STKNUM, SI.SHPOKY
	</select>
	
	<!-- 할당 : 실제 할당 프로스저 호출-->
	<resultMap id="DL041_CALL_ALLO_RESULT" type="hashmap"></resultMap>
	<select id="DL041_CALL_ALLO_MAP" parameterType="Map" statementType="CALLABLE">
		{ call SZP_CALL_ALLOCATION(#{SHPOKY}, #{SES_USER_ID}, #{EXCEPTBARCOD}, #{result, mode=OUT, jdbcType=VARCHAR, javaType=String, resultMap=DL041_CALL_ALLO_RESULT}) }
	</select>
	
