			T.PTLT01,
			T.PTLT02,
			T.PTLT03,
			T.PTLT04,
			T.PTLT05,
			T.PTLT06,
			T.PTLT07,
			T.PTLT08,
			T.PTLT09,
			T.PTLT10,
			T.PTLT11,
			T.PTLT12,
			T.PTLT13,
			T.PTLT14,
			T.PTLT15,
			T.PTLT16,
			T.PTLT17,
			T.PTLT18,
			T.PTLT19,
			T.PTLT20,
			T.PASTKY,
			T.ALSTKY,
			T.SBKTXT,
			T.TASRSN,
			T.CREDAT,
			T.CRETIM,
			T.CREUSR,
			T.LMODAT,
			T.LMOTIM,
			T.LMOUSR,
			T.INDBZL,
			T.INDARC,
			T.UPDCHK
		FROM TASDI T
		WHERE T.SHPOKY = #{SHPOKY}
		AND	  T.SHPOIT = #{SHPOIT}
		AND	  T.TASKKY = #{TASKKY}
		<if test="TASKIT != null and TASKIT != ''">
		AND	  T.TASKIT = #{TASKIT}
		</if>
		AND	  T.STATIT != 'FCN'		
	</select>
	
	<select id="DL041_CLOSING_SHIPMENT_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT *
		  FROM (
		         SELECT CASE WHEN SH.STATDO IN ('PAL','FAL')
		                          THEN 'OUT_M0155†' || STD.SHPOKY
		                     WHEN SH.STATDO IN ('PPC','FPC')
		                          THEN 'OUT_M0156†' || STD.SHPOKY
		                     WHEN SH.STATDO IN ('PSH','FSH')
		                          THEN 'OUT_M0157†' || STD.SHPOKY
		                     WHEN SH.STATDO IN ('CLS')
		                          THEN 'OUT_M0158†' || STD.SHPOKY
		                     ELSE 'OK'
		                  END AS RESULTMSG
		           FROM (
		                  ${APPEND_QUERY}
		                ) STD
		                INNER JOIN SHPDH SH ON SH.SHPOKY = STD.SHPOKY
		       )
		 WHERE RESULTMSG != 'OK'
	</select>
	
	<update id="DL041_CLOSING_SHIPMENT_UPDATE" parameterType="Map">
		UPDATE SHPDH
		   SET STATDO = 'CLS'
		     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
		     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
		     , LMOUSR = #{SES_USER_ID} 
		 WHERE SHPOKY = #{SHPOKY}
		   AND STATDO = 'NEW'
	</update>
	
	<select id="VEHINOVal_MAP" parameterType="Map" resultType="DataMap">
		SELECT	
			VEHITY
		FROM	VEHMA
		WHERE	1 = 1
		AND		VEHINO = #{VEHINO}
	</select>
	
	<select id="VEHINO_COMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT VEHIID AS VALUE_COL
		    ,  VEHINO AS TEXT_COL
		FROM VEHMA
		ORDER BY VEHIID, VEHINO 
	</select>

	<!-- SVBELN체크 -->
	<select id="IFWMS113CHK_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) CNT
		  FROM SHPDI X
		       INNER JOIN SHPDH Y ON Y.SHPOKY = X.SHPOKY
		 WHERE X.SVBELN = #{SVBELN}
		   AND X.STATIT != 'FCN'
		   AND Y.STATDO != 'FCN'
		   AND Y.DOCUTY = NVL(TRIM(#{DOCUTY}),Y.DOCUTY)
	</select>  

	<select id="DL041_ALLOC_ITEM_PROCALL_MAP" parameterType="Map" resultType="DataMap">
		{ call SZP_BATCH_ALLOCATION_ITEM(#{SHPOKY}, #{SHPOIT}, #{SES_USER_ID}) }
	</select>
	
	<!-- TOTAL_PICKING_DUPLICATE OBJECT-->	
	<select id="TOTAL_PICKING_DUPLICATE_CHECK_OBJECT" parameterType="Map" resultType="java.lang.String">
		 SELECT DISTINCT            
             SHPOKY
         FROM 
	         TASTP
	     WHERE 1=1	
	     <if test="SHPOKY != null and SHPOKY != ''">
	     AND SHPOKY = #{SHPOKY}
		</if>
	</select>
	
	<!-- TOTAL_PICKING_STKNUM OBJECT -->	
	<select id="TOTAL_PICKING_STKNUM_OBJECT" resultType="Map">
		SELECT NVL(MAX(STKNUM)+1,CONCAT( TO_CHAR(SYSDATE, 'YYYYMMDD'), CONCAT('0000', NVL(COUNT(*), 0)+1))) AS STKNUM
			 , TO_CHAR(SYSDATE,'YYYYMMDD') AS CREDAT
			 , TO_CHAR(SYSDATE,'HH24MISS') AS CRETIM
		FROM 
			(
			SELECT CREDAT
				, STKNUM
			FROM TASTP
              WHERE CREDAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
              GROUP BY CREDAT, STKNUM
	        )
	</select>
	
	<!-- TOTAL_PICKING_CREATE INSERT -->
	<insert id="TOTAL_PICKING_CREATE_INSERT" parameterType="Map">
		INSERT INTO TASTP(
				  STKNUM
				, ORDDAT
				, OWNRKY
				, WAREKY
				, SHPOKY
				, CREDAT
				, CRETIM
				, CREUSR
						)
		SELECT    #{STKNUM}
				, TO_CHAR(SYSDATE,'YYYYMMDD') AS ORDDAT
				, SH.OWNRKY
				, SH.WAREKY
				, SH.SHPOKY
				, #{CREDAT}
		        , #{CRETIM}
				, #{SES_USER_ID} AS CREUSR
		FROM SHPDH SH
		WHERE SH.SHPOKY = #{SHPOKY}		
	</insert>	
	
	<!-- TOTAL_PICKING_DELETE DELETE-->
	<delete id="TOTAL_PICKING_DELETE_DELETE" parameterType="Map">
		DELETE TASTP  
		WHERE STKNUM = #{STKNUM}		 	
	</delete>	
	
	<select id="SEARCHMAXSHPOIT_LIST" parameterType="Map" resultType="DataMap">
		  SELECT
		   		 NVL(SUBSTR(MAX(NVL(SHPOIT,0)), 2,6),0) AS SHPOIT
          FROM SHPDI 
          WHERE	1 = 1
				AND	SHPOKY = #{SHPOKY}
				AND SUBSTR(SHPOIT,0,1) = 1
	</select>			
	
	<!-- 할당 취소시 SHPDI update -->
	<update id="DL041_SHPDI_UPDATE" parameterType="Map">
		<selectKey resultType="string" keyProperty="WAREKY" order="BEFORE">
			SELECT WAREKY FROM SHPDH WHERE SHPOKY = #{SHPOKY}
		</selectKey>
		UPDATE SHPDI
		   SET LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}			
			 , STATIT = CASE WHEN QTYORG = 0 THEN 'FCO'
			 				 ELSE STATIT
			 			END	
			 , QTSHPO = SZF_GET_CONVERT_QTY(#{WAREKY}, SKUKEY, QTYORG, UOMKEY, DUOMKY)
			 , QTYUOM = SZF_GET_CONVERT_QTY(#{WAREKY}, SKUKEY, QTYORG, UOMKEY, DUOMKY)
			 , QTPUOM = SZF_GET_CONVERT_QTY(#{WAREKY}, SKUKEY, 1, UOMKEY, DUOMKY)
			 , CHGFLG = CASE WHEN STATIT = 'FCO' THEN CHGFLG
			 				 ELSE ' '
			 			END	 	 		
			 , KEEPIT = #{KEEPIT}  
			 			 				   
		 WHERE SHPOKY = #{SHPOKY}		
		<if test="SHPOIT != '' and SHPOIT != null">  
		   AND SHPOIT = #{SHPOIT}
		</if>  		   	
			  
		AND SUBSTR(SHPOIT,0,1) != 1 
	</update>
	
	<!-- 할당 취소시 SHPDH update -->
	<update id="DL041_SHPDH_UPDATE" parameterType="Map">
		UPDATE SHPDH
		   SET LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
			 , KEEPTS = ' '
			 			<!-- CASE WHEN (SELECT SUM(NVL(SI.QTYORG, 0)) FROM SHPDI SI WHERE SI.SHPOKY = #{SHPOKY} AND SUBSTR(SI.SHPOIT,0,1) != 1)  = 0  
			 					   AND KEEPTS != ' 'THEN ' '
			 				 ELSE KEEPTS
			 			END -->	 
 			, STATDO = CASE WHEN (SELECT SUM(SI.QTYORG) FROM SHPDI SI WHERE SI.SHPOKY = #{SHPOKY} AND SUBSTR(SI.SHPOIT,0,1) != 1 )  = 0  
			 					AND KEEPTS != ' ' THEN 'OCN'
			 				ELSE STATDO
			 			END	
		 WHERE SHPOKY = #{SHPOKY}
	</update>

	<select id="DL041_DEALKY_OBJECT" resultType="int">
		SELECT NVL(MAX(DEALKY), 0) + 1 FROM DEALH
	</select>
	
	<insert id="DL041_DEALH_MULTI_INSERT" parameterType="Map">
		INSERT INTO DEALH (
			  DEALKY
			, TKNUM
			, KUNNR
			, KUNAG
			, STCD2_A, TELF2_A, NAME1_A, J1KFREPRE_A, ADDR_A, J_1KFTIND_A, J_1KFTBUS_A
			, STCD2_B, TELF2_B, NAME1_B, J1KFREPRE_B, ADDR_B, J_1KFTIND_B, J_1KFTBUS_B
			, KUNWE_T, KUNWE_TEL, KUNWE_ADDR
			, KVGR1
			, DRIVE_INFO
			, DRIVERCEL
			, MEMO1
			, MEMO2
			, PERNE_INFO
			, CBM
			, FSC
			, CONFIRM
			, LOGSEQNO
			, CREDAT, CRETIM, CREUSR
			, LMODAT, LMOTIM, LMOUSR
		)
		<foreach collection="list" item="i" separator=" UNION ALL " open="" close="">
			SELECT #{i.DEALKY}
				 , NVL(#{i.TKNUM}, ' ')
				 , NVL(SUBSTR(LPAD(TRIM(#{i.KUNNR}), 10, '0'), 5, 6), ' ')
				 , NVL(SUBSTR(LPAD(TRIM(#{i.KUNAG}), 10, '0'), 5, 6), ' ')
				 , NVL(#{i.STCD2_A}, ' '), NVL(#{i.TELF2_A}, ' '), NVL(#{i.NAME1_A}, ' '), NVL(#{i.J1KFREPRE_A}, ' '), NVL(#{i.ADDR_A}, ' '), NVL(#{i.J_1KFTIND_A}, ' '), NVL(#{i.J_1KFTBUS_A}, ' ')
				 , NVL(#{i.STCD2_B}, ' '), NVL(#{i.TELF2_B}, ' '), NVL(#{i.NAME1_B}, ' '), NVL(#{i.J1KFREPRE_B}, ' '), NVL(#{i.ADDR_B}, ' '), NVL(#{i.J_1KFTIND_B}, ' '), NVL(#{i.J_1KFTBUS_B}, ' ')
				 , NVL(#{i.KUNWE_T}, ' '), NVL(#{i.KUNWE_TEL}, ' '), NVL(#{i.KUNWE_ADDR}, ' ')
				 , NVL(#{i.KVGR1}, ' ')
				 , NVL(#{i.DRIVE_INFO}, ' ')
				 , NVL(#{i.DRIVERCEL}, ' ')
				 , NVL(#{i.MEMO1}, ' ')
				 , NVL(#{i.MEMO2}, ' ')
				 , NVL(#{i.PERNE_INFO}, ' ')
				 , NVL(#{i.CBM}, ' ')
				 , NVL(#{i.FSC}, ' ')
				 , NVL(#{i.CONFIRM}, ' ')
				 , NVL(#{i.LOGSEQNO}, ' ')
				 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{i.SES_USER_ID}
				 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{i.SES_USER_ID}
			FROM DUAL
		</foreach>
	</insert>
	
	<insert id="DL041_DEALI_MULTI" parameterType="Map">
		INSERT INTO DEALI (
			  DEALKY
			, TKNUM
			, KUNNR
			, KUNAG
			, STCD2_B
			, MAKTX
			, MAKTX2
			, BARCODE
			, KONDM
			, ZSPEC
			, LFIMG1
			, LFIMG2
			, NETPR
			, NETWR
			, BIGO
			, BIGO2
			, TOT_FLAG
			, LFIMG1_TOT
			, LFIMG2_TOT
			, NETWR_TOT
			, VAT_TOT
			, NETWR_VAT
			, FSC
			, MATNR
		)
		<foreach collection="list" item="i" separator=" UNION ALL " open="" close="">
			SELECT #{i.DEALKY}
				 , NVL(#{i.TKNUM}, ' ')
				 , NVL(SUBSTR(LPAD(TRIM(#{i.KUNNR}), 10, '0'), 5, 6), ' ')
				 , NVL(SUBSTR(LPAD(TRIM(#{i.KUNAG}), 10, '0'), 5, 6), ' ')
				 , NVL(#{i.STCD2_B}, ' ')
				 , NVL(#{i.MAKTX}, ' ')
				 , NVL(#{i.MAKTX2}, ' ')
				 , NVL(#{i.BARCODE}, ' ')
				 , NVL(#{i.KONDM}, ' ')
				 , NVL(#{i.ZSPEC}, ' ')
				 , NVL(TO_NUMBER(TRIM(REPLACE(#{i.LFIMG1}, ',', ''))), 0)
				 , NVL(TO_NUMBER(TRIM(REPLACE(#{i.LFIMG2}, ',', ''))), 0)
				 , NVL(TO_NUMBER(TRIM(REPLACE(#{i.NETPR }, ',', ''))), 0)
				 , NVL(TO_NUMBER(TRIM(REPLACE(#{i.NETWR }, ',', ''))), 0)
				 , NVL(#{i.BIGO}, ' ')
				 , NVL(#{i.BIGO2}, ' ')
				 , NVL(#{i.TOT_FLAG}, ' ')
				 , NVL(#{i.LFIMG1_TOT}, ' ')
				 , NVL(#{i.LFIMG2_TOT}, ' ')
				 , NVL(#{i.NETWR_TOT}, ' ')
				 , NVL(#{i.VAT_TOT}, ' ')
				 , NVL(#{i.NETWR_VAT}, ' ')
				 , NVL(#{i.FSC}, ' ')
				 , NVL(#{i.MATNR}, ' ')
			  FROM DUAL
		</foreach>
	</insert>
	
	<select id="DL041_SHPDI_STKNUM_INFO_LIST" parameterType="Map" resultType="DataMap">
				SELECT SI.STKNUM AS STKNUM
					 , SI.SVBELN AS SVBELN
					 , #{WAREKY} AS WAREKY	
					 , #{STATUS} AS STATUS					 				          	
				  FROM SHPDH SH
                 INNER JOIN SHPDI SI ON SH.SHPOKY = SI.SHPOKY				       
				 WHERE 1 = 1
				   AND SH.WAREKY = #{WAREKY}
		           AND SI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
				   AND SUBSTR(SI.SHPOIT, 0, 1) != 1 
				   AND NVL(TRIM(SI.SAPSTS), NULL) IS NOT NULL
	    	   	<choose>
					<when test="STATUS == &quot;C&quot;">
				   AND SI.STATIT IN('PAL', 'FAL', 'PPC', 'FPC')                   
					</when>
					<otherwise>
				   AND SI.STATIT IN('NEW')
					</otherwise> 	
			   	</choose>

			   <if test="SHPOKY != null and SHPOKY != ''">
				   AND SH.SHPOKY IN ${SHPOKY}
			   </if>			   
       			 GROUP BY SI.STKNUM, SI.SVBELN
	</select>
	
	<select id="DL041_ALLCATIONVAL_MAP" parameterType="Map" resultType="DataMap">
		SELECT STATDO FROM SHPDH
		 WHERE SHPOKY = #{SHPOKY}	   				
	</select>
	
	<update id="DL041_PRTCHK_SHPDH_UPDATE" parameterType="Map">
		UPDATE SHPDH
		   SET PRTCHK = 'V'
		 WHERE SHPOKY = #{SHPOKY} 
	</update>

	<select id="DL041_STKNUM_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT SI.STKNUM AS TKNUM
			 , SI.SVBELN AS VBELN
			 , SH.WAREKY AS WAREKY
			 , #{STATUS} AS STATUS
		 FROM SHPDH SH
		INNER JOIN SHPDI SI ON SH.SHPOKY = SI.SHPOKY
		WHERE 1 = 1
		  AND SH.WAREKY = #{WAREKY}
		  AND SH.SHPOKY = #{SHPOKY}
		  AND SH.DPTNKY = #{DPTNKY}
		  AND SH.STATDO IN('NEW')
		  AND NVL(TRIM(SI.SAPSTS), NULL) IS NOT NULL
		GROUP BY SI.STKNUM, SI.SVBELN, SH.WAREKY
	</select>
	
	<select id="DL041_WMS_IFS301_STATDO_LIST" parameterType="Map" resultType="DataMap">
        SELECT    SI.STKNUM                                                  AS STKNUM           --선적번호
                , SI.SVBELN                                                  AS SVBELN           --출고오더번호/납품문서번호
                , SI.SHPOKY                                                  AS SHPOKY           --출고문서번호
                , SH.RQSHPD                                                  AS RQSHPD           --출하요청일자
                , SH.STATDO                                                  AS STATDO           --문서상태      /*Detail*/
                , ST.CDESC1                                                  AS STATDONM         --문서상태명    /*Detail*/
                , SH.DOCUTY                                                                      --문서유형      /*Detail*/
                , (SELECT SHORTX FROM DOCTM WHERE DOCUTY = SH.DOCUTY)        AS DOCUTYNM         --문서유형명    /*Detail*/
        FROM SHPDI SI
            INNER JOIN SHPDH SH ON SH.SHPOKY = SI.SHPOKY
            LEFT OUTER JOIN CMCDV ST ON ST.CMCDKY = 'STATDO'
                                    AND ST.CMCDVL = SH.STATDO
        WHERE 1=1
        AND SI.STATIT NOT IN('FCO')  --주문취소 제외
        AND SUBSTR(SI.SHPOIT, 0, 1) != 1
        AND SH.WAREKY = #{WAREKY}
            AND NVL(DECODE(SI.STKNUM, ' ', NULL, SI.STKNUM), '*'||SI.SHPOKY) = #{STKNUM}
            
            AND ( SH.RQSHPD BETWEEN #{RQSHPD_FR} AND #{RQSHPD_TO} )
        GROUP BY  SI.STKNUM
                , SI.SVBELN
                , SI.SHPOKY
                , SH.RQSHPD
                , SH.STATDO
                , ST.CDESC1
                , SH.DOCUTY
	</select>
</mapper>
