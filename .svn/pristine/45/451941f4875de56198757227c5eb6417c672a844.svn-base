	<delete id="DL041_SHPDI_DELETE" parameterType="Map">
		DELETE FROM SHPDI
		WHERE SHPOKY = #{SHPOKY}
		  AND QTALOC = 0
		  AND QTJCMP = 0
		  AND QTSHPC = 0
		  AND NOT EXISTS (SELECT 1
		                   FROM TASDI
		                  WHERE TASDI.SHPOKY = SHPDI.SHPOKY)
	</delete>
	
