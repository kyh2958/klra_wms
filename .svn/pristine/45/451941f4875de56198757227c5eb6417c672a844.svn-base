		    ,  S.SZMIPNO AS SZMIPNO
		    ,  S.STKNUM AS  STKNUM 
		    ,  S.STPNUM AS  STPNUM 
		    ,  S.SLGORT AS  SLGORT 
		    ,  S.SDATBG AS  SDATBG 
