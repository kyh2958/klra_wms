	<delete id="DL041_SHPDH_DELETE" parameterType="Map">
		DELETE FROM SHPDH
		WHERE SHPOKY = #{SHPOKY}
		  AND NOT EXISTS (SELECT 1
		                    FROM SHPDI
		                   WHERE SHPDI.SHPOKY = SHPDH.SHPOKY)
	</delete>
	
