			LOTA14,
			LOTA15,
			LOTA16,
			LOTA17,
			LOTA18,
			LOTA19,
			LOTA20,
			' ' AS LOTA01NM,
			' ' AS SBKTXT,
			AWMSNO,
			REFDKY,
			REFDIT,
			REFCAT,
			REFDAT,
			DESC01,
			DESC02,
			ASKU01,
			ASKU02,
