	<select id="GR15BAKR_LIST" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT H.RECVKY,
		       I.SEBELN,
		       DT.SHORTX AS RCPTTYNM,
		       I.SSORNU AS SHPOKY,
		       WAREKY,
		       RCPTTY,
		       STATDO,
		       H.SAPSTS,
		       DOCDAT,
		       H.DOCCAT,
		       DPTNKY,
		       ' ' AS DPTNKYNM,
		       ' ' AS WAREKYNM,
		       DC.SHORTX AS DOCCATNM,
		       ' ' AS LGORT,
		       ' ' AS LGORTNM,
		       DRELIN,
		       ARCPTD,
		       OWNRKY,
		       H.INDRCN,
		       H.CRECVD,
		       H.RSNCOD,
		       PUTSTS,
		       USRID1,
		       UNAME1,
		       DEPTID1,
		       DNAME1,
		       USRID2,
		       UNAME2,
		       DEPTID2,
		       DNAME2,
		       USRID3,
		       UNAME3,
		       DEPTID3,
		       DNAME3,
		       USRID4,
		       UNAME4,
		       DEPTID4,
		       DNAME4,
		       DOCTXT,
		       H.CREDAT,
		       H.CRETIM,
		       H.CREUSR,
		       H.LMODAT,
		       H.LMOTIM,
		       H.LMOUSR
		FROM   RECDH H
		    LEFT OUTER JOIN RECDI I
		ON H.RECVKY = I.RECVKY
		    LEFT OUTER JOIN DOCTM DT	
		ON DT.DOCUTY = H.RECVKY
		    LEFT OUTER JOIN DOCCM DC	
		ON DC.DOCCAT = '100'
		WHERE H.RECVKY IN ( ${RECVKY} )
	</select>
	
	<select id="GR15BAKIR_LIST" parameterType="Map" resultType="DataMap">
		SELECT
			RECVKY,
			RECVIT,
			STATIT,
			SAPSTS,
			SKUKEY,
			LOTNUM,
			AREAKY,
			LOCAKY,
			SECTID,
			TRNUID,
			PACKID,
			QTYRCV ,
			TRUNC(QTYRCV/QTDUOM) AS BOXQTY,
			MOD(QTYRCV,QTDUOM) AS REMQTY,
			QTYDIF,
			QTYUOM,
			TRUNTY,
			MEASKY,
			UOMKEY,
			QTPUOM,
			DUOMKY,
			QTDUOM,
			INDRCN,
			CRECVD,
			RSNCOD,
			LOTA01,
			LOTA02,
			LOTA03,
			LOTA04,
			LOTA05,
			LOTA06,
			LOTA07,
			LOTA08,
			LOTA09,
			LOTA10,
			LOTA11,
			LOTA12,
			LOTA13,
			LOTA14,
			LOTA15,
			LOTA16,
			LOTA17,
			LOTA18,
			LOTA19,
			LOTA20,
			' ' AS LOTA01NM,
			' ' AS SBKTXT,
			AWMSNO,
			REFDKY,
			REFDIT,
			REFCAT,
			REFDAT,
			DESC01,
			DESC02,
			ASKU01,
			ASKU02,
			ASKU03,
			ASKU04,
			ASKU05,
			EANCOD,
			GTINCD,
			SKUG01,
			SKUG02,
			SKUG03,
			SKUG04,
			SKUG05,
			GRSWGT,
			NETWGT,
			WGTUNT,
			LENGTH,
			WIDTHW,
			HEIGHT,
			CUBICM,
			CAPACT,
			QTYORG,
			SMANDT,
			SEBELN,
			SEBELP,
			SZMBLNO,
			SZMIPNO,
			STRAID,
			SVBELN,
			SPOSNR,
			STKNUM,
			STPNUM,
			SWERKS,
			SLGORT,
			SDATBG,
			STDLNR,
			SSORNU,
			SSORIT,
			SMBLNR,
			SZEILE,
			SMJAHR,
			SXBLNR,
			RCPRSN,
			CREDAT,
			CRETIM,
			CREUSR,
			LMODAT,
			LMOTIM,
			LMOUSR
		FROM RECDI
		WHERE RECVKY = #{RECVKY}
	</select>
	
	<!-- <select id="GR05_LIST" parameterClass="Map" resultClass="DataMap">
		SELECT	 
				' ' AS RECVKY,
				IFWMS113.WAREKY AS WAREKY,
				WH.NAME01 AS WAREKYNM,
				#{RCPTTY} AS RCPTTY,
				DT.SHORTX AS RCPTTYNM,
				'NEW' AS STATDO,
				' ' AS SAPSTS,
				TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT,
				'100' AS DOCCAT,
				DC.SHORTX AS DOCCATNM,
				IFWMS113.KUNNR AS DPTNKY,
				VD.NAME01 AS DPTNKYNM,
				' ' AS DRELIN,
				TO_CHAR(SYSDATE,'YYYYMMDD') AS ARCPTD,
				#{SES_OWNER} AS OWNRKY,
				' ' AS INDRCN,
				' ' AS CRECVD,
				' ' AS RSNCOD,
				' ' AS PUTSTS,
				IFWMS113.LGORT AS LGORT,
				' ' AS LGORTNM,
				NVL( IFWMS113.C00103,' ') AS DOCTXT,
				IFWMS113.VBELN AS SEBELN,
				NVL(IFWMS113.C00102,' ') AS CONFIM
		FROM	IFWMS113
				LEFT OUTER JOIN SKUMA SM	ON SM.OWNRKY = #{SES_OWNER}
											AND SM.SKUKEY = IFWMS113.SKUKEY
				LEFT OUTER JOIN SKUWC SW	ON SW.WAREKY = #{WAREKY}
											AND SW.OWNRKY = #{SES_OWNER}
											AND SW.SKUKEY = IFWMS113.SKUKEY
				LEFT OUTER JOIN WAHMA WH	ON WH.WAREKY = IFWMS113.WAREKY
				LEFT OUTER JOIN DOCCM DC	ON DC.DOCCAT = '100'
				LEFT OUTER JOIN DOCTM DT	ON DT.DOCUTY = #{RCPTTY}
				LEFT OUTER JOIN BZPTN VD	ON VD.PTNRKY = IFWMS113.KUNNR
		 				AND VD.PTNRTY IN (CASE	WHEN #{RCPTTY} IN ('108','109','110','111','115','116') THEN 'CT'
		 										WHEN #{RCPTTY} IN ('166') THEN 'TM'
		 									 ELSE 'VD' END)
											AND VD.OWNRKY = #{SES_OWNER}
			WHERE	IFWMS113.WERKS = #{SES_OWNER}  
			AND		IFWMS113.IFFLG = 'N'
			AND		IFWMS113.WAREKY = #{WAREKY} 
			AND		IFWMS113.BWART IN ( CASE WHEN  #{RCPTTY} = '109' THEN '220' 
			                              WHEN  #{RCPTTY} = '108' THEN '211'
			                              ELSE #{RCPTTY}
			                              END )
			AND		IFWMS113.LFIMG - IFWMS113.QTSHP  > 0
		<isNotEmpty property="RANGE_SQL">
		       ${RANGE_SQL}
		</isNotEmpty>
		 GROUP BY IFWMS113.VBELN, IFWMS113.WAREKY, IFWMS113.KUNNR, IFWMS113.LGORT, IFWMS113.C00103,IFWMS113.C00102,
		 WH.NAME01, DC.SHORTX, DT.SHORTX, VD.NAME01 
		 ORDER BY IFWMS113.VBELN DESC
	</select>
	
 	<select id="GR05Sub_LIST" parameterClass="Map" resultClass="DataMap">
		SELECT 
		       ' '                 AS RECVKY
		     , ' '                 AS RECVIT
		     , 'NEW'               AS STATIT
		     , ' '                 AS SAPSTS
		     , IFWMS113.SKUKEY     AS SKUKEY
		     , ' '                 AS LOTNUM
		     , ' '                 AS AREAKY
             , (SELECT NVL(LM.SYSLOC,'RCVLOC') FROM DOCTM LM WHERE LM.DOCUTY = #{RCPTTY}) 
		     , ' '                 AS SECTID
		     , ' '                 AS TRNUID
		     , ' '                 AS PACKID
		     , IFWMS113.LFIMG - IFWMS113.QTSHP AS ASNQTY
		     , IFWMS113.LFIMG - IFWMS113.QTSHP AS QTYRCV
		     , 0                   AS QTYDIF
		     , IFWMS113.LFIMG - IFWMS113.QTSHP AS QTYUOM
		     , ' '                 AS TRUNTY
		     , NVL(SW.MEASKY,' ')  AS MEASKY
		     , NVL((SELECT UOMKEY FROM UOMMA WHERE UOMKEY = IFWMS113.MEINS), 'EA') AS UOMKEY
		     , NVL(ITFMS.QTPUOM,0) AS QTPUOM
		     , NVL(SM.DUOMKY,' ')  AS DUOMKY
		     , NVL(DECODE(SM.QTDUOM,0,9999999,SM.QTDUOM),9999999) AS QTDUOM
		     , TRUNC((IFWMS113.LFIMG - IFWMS113.QTSHP)/NVL(DECODE(SM.QTDUOM,0,9999999,SM.QTDUOM),9999999)) AS BOXQTY
		     , MOD(IFWMS113.LFIMG - IFWMS113.QTSHP,NVL(DECODE(SM.QTDUOM,0,9999999,SM.QTDUOM),9999999)) AS REMQTY
		     , ' '                 AS INDRCN
		     , ' '                 AS CRECVD
		     , ' '                 AS RSNCOD
		     , IFWMS113.KUNNR  AS LOTA01
		     , (SELECT BZ.NAME01 FROM BZPTN BZ WHERE PTNRTY = 'CT' AND BZ.PTNRKY = IFWMS113.KUNNR AND ROWNUM = 1)  AS LOTA01NM 
		     , ' '                 AS LOTA02
		     , ' '                 AS LOTA03
		     , IFWMS113.VBELN      AS LOTA04
		     , SM.SKUG04           AS LOTA05 
		     , '00'                AS LOTA06
		     , ' '                 AS LOTA07
		     , ' '                 AS LOTA08
		     , ' '                 AS LOTA09
		     , ' '                 AS LOTA10
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA11
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA12
		     , TO_CHAR(SYSDATE + SM.RIMDMT,'YYYYMMDD') AS LOTA13
		     , ' '                 AS LOTA14
		     , ' '                 AS LOTA15
		     , 0                   AS LOTA16
		     , 0                   AS LOTA17
		     , 0                   AS LOTA18
		     , 0                   AS LOTA19
		     , 0                   AS LOTA20
		     , ' '                 AS AWMSNO
		     , ' '   			   AS REFDKY
		     , ' '    			   AS REFDIT
		     , ' '                 AS REFCAT
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS REFDAT
		     , NVL(SM.DESC01,' ')  AS DESC01
		     , NVL(SM.DESC02,' ')  AS DESC02
		     , NVL(SM.ASKU01,' ')  AS ASKU01
		     , NVL(SM.ASKU02,' ')  AS ASKU02
		     , NVL(SM.ASKU03,' ')  AS ASKU03
		     , NVL(SM.ASKU04,' ')  AS ASKU04
		     , NVL(SM.ASKU05,' ')  AS ASKU05
		     , NVL(SM.EANCOD,' ')  AS EANCOD
		     , NVL(SM.GTINCD,' ')  AS GTINCD
		     , NVL(SM.SKUG01,' ')  AS SKUG01
		     , NVL(SM.SKUG02,' ')  AS SKUG02
		     , NVL(SM.SKUG03,' ')  AS SKUG03
		     , NVL(SM.SKUG04,' ')  AS SKUG04
		     , NVL(SM.SKUG05,' ')  AS SKUG05
		     , NVL(SM.GRSWGT,0)    AS GRSWGT
		     , NVL(SM.NETWGT,0)    AS NETWGT
		     , NVL(SM.WGTUNT,' ')  AS WGTUNT
		     , NVL(SM.LENGTH,0)    AS LENGTH
		     , NVL(SM.WIDTHW,0)    AS WIDTHW
		     , NVL(SM.HEIGHT,0)    AS HEIGHT
		     , NVL(SM.CUBICM,0)    AS CUBICM
		     , NVL(SM.CAPACT,0)    AS CAPACT
		     , 0                   AS QTYORG
		     , IFWMS113.MANDT      AS SMANDT
		     , ' '   			   AS SEBELN
		     , ' '                 AS SEBELP
		     , ' '                 AS SZMBLNO
		     , ' '                 AS SZMIPNO
		     , ' '                 AS STRAID
		     , IFWMS113.VBELN      AS SVBELN
		     , IFWMS113.POSNR      AS SPOSNR
		     , ' '                 AS STKNUM
		     , ' '                 AS STPNUM
		     , ' '                 AS SWERKS
		     , ' '    			   AS SLGORT
		     , ' '                 AS SDATBG
		     , ' '                 AS STDLNR
		     , ' '                 AS SSORNU
		     , ' '                 AS SSORIT
		     , ' '                 AS SMBLNR
		     , ' '                 AS SZEILE
		     , ' '                 AS SMJAHR
		     , ' '                 AS SXBLNR
		     , ' '                 AS SBKTXT
		     , ' '                 AS RCPRSN
		  FROM IFWMS113
		       LEFT OUTER JOIN SKUMA SM
		    ON SM.OWNRKY        = #{SES_OWNER} 
		   AND SM.SKUKEY        = IFWMS113.SKUKEY
		       LEFT OUTER JOIN SKUWC SW
		    ON SW.WAREKY        = #{WAREKY}
		   AND SW.OWNRKY        = #{SES_OWNER} 
		   AND SW.SKUKEY        = IFWMS113.SKUKEY
		       LEFT OUTER JOIN MEASI ITFMS
		    ON ITFMS.WAREKY     = #{WAREKY}
		   AND ITFMS.MEASKY     = SW.MEASKY
		   AND ITFMS.UOMKEY     = IFWMS113.MEINS
		 WHERE IFWMS113.WERKS = #{SES_OWNER}  
		   AND IFWMS113.IFFLG  IN ('N', 'Y')
		   AND IFWMS113.STATUS IN ('A', 'C')
		   AND IFWMS113.BWART  IN ( CASE WHEN  #{RCPTTY} = '109' THEN '220' 
			                              WHEN  #{RCPTTY} = '108' THEN '211'
			                              ELSE #{RCPTTY}
			                              END )
		   AND IFWMS113.LFIMG - IFWMS113.QTSHP > 0
		   AND IFWMS113.VBELN = #{SEBELN}
		<isNotEmpty property="RANGE_SQL">
			${RANGE_SQL}
		</isNotEmpty>
	</select> -->
	
	<select id="BARCOD_MAP" parameterType="Map" resultType="DataMap">
		SELECT	LOTA03,
			    WAREKY,
			    SKUKEY,
			    DESC01,
			    DESC02,
			    PRTDAT,
			    QTDUOM,
			    QTDBOX,
			    QTDREM,
			    QTDPRT,
			    LOTA05,
			    LOTA02,
			    RECVKY,
			    SHPOKY,
			    TASKKY,
			    SADJKY,
			    LOTA14
		FROM	V_SHP_BARCOD
		WHERE	1 = 1
		AND		LOTA03 = #{BARCOD}
		AND		WAREKY = #{WAREKY}
		AND		SKUKEY = #{SKUKEY}
	</select>
	
	<select id="NAME01_MAP" parameterType="Map" resultType="DataMap">
		SELECT 
			PTNRKY,
		    NAME01,
		    PTNG01,
		    PTNL01,
		    PTNG02,
		    PTNL02
		FROM V_BZPTN_PV
		WHERE 1 = 1
		  AND PTNRKY = #{LOTA02}
	</select>
	
	<select id="AREAKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
        FROM   
        	AREMA 
		WHERE  
			AREAKY = #{AREA}
	</select>
	
	<select id="GR20LOG1_MAP" parameterType="Map" resultType="DataMap">
		 { call SZP_PLSQL_LOG(#{RECVKY} || #{SKUKEY})}
	</select>
	
	<select id="GR20LOG2_MAP" parameterType="Map" resultType="DataMap">
		 { call SZP_PLSQL_LOG(#{RECVKY} || #{SKUKEY})}
	</select>
	
	<select id="GR01_LIST" parameterType="Map" resultType="DataMap">
		SELECT	PO.WERKS AS OWNRKY,
				NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = PO.WERKS), ' ') AS OWNRNM,
				' ' AS RECVKY,
				PO.EBELN AS SEBELN,
				PO.EBELN AS DOCKEY,
				PO.WAREKY,
				NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = PO.WAREKY),' ') AS WARENM,
				PO.BWART AS RCPTTY,
				NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS RCPTNM,
				PO.EINDT AS ASNDAT,
				NVL((SELECT DOCCAT FROM DOCTM WHERE DOCUTY = PO.BWART), '100') AS DOCCAT,
				TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT,
				PO.LGORT AS AREAKY,
				NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = PO.LGORT),' ') AS AREANM,
				PO.LIFNR AS DPTNKY,
				NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = #{OWNRKY} AND PTNRKY = PO.LIFNR AND PTNRTY = DECODE(SUBSTR(PO.BWART,0,2), '13', 'CT', 'VD')),' ') AS DPTNNM,
			    BZ.NAME01 AS DPTNNM,
			    PO.BWART AS DOCUTY,
	         	PO.VGBEL AS SALCOM,
	         	NVL((SELECT BC.NAME01 FROM BZPTN BC WHERE BC.OWNRKY = #{OWNRKY} AND BC.PTNRKY = PO.VGBEL AND BC.PTNRTY = 'CO'), ' ') AS SALCOMNM, 
	         	PO.VGPOS AS SALPLT,
	         	NVL((SELECT BC.NAME01 FROM BZPTN BC WHERE BC.OWNRKY = #{OWNRKY} AND BC.PTNRKY = PO.VGPOS AND BC.PTNRTY = 'CT'), ' ') AS SALPLTNM,
			    NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS DOCTNM,
			    'NEW' AS STATDO,
			    NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = 'NEW'),' ') AS STATDONM,
			    ' ' AS DOCTXT, 
			    <!-- PO.BOX_CNT, -->
			    PO.EBELN
		FROM	IFWMS103 PO
			 LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = DECODE(SUBSTR(PO.BWART,0,2), '13', 'CT', 'VD')
			 LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
		WHERE	PO.WAREKY = #{WAREKY}
		  AND 	PO.WERKS  = #{OWNRKY} 
		  AND   PO.BWART =  #{RCPTTY}
	      AND  (PO.MENGE - PO.MENGE_R - PO.MENGE_B) &gt; 0
	      AND 	PO.STATUS IN ('U','C')
	      AND 	PO.IFFLG IN ('N')
	    <if test="SEBELN != null and SEBELN != ''">
		  AND 	PO.EBELN = #{SEBELN}
	    </if>
        <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		GROUP BY PO.WERKS,
				 PO.EBELN,
				 PO.WAREKY,
				 PO.BWART,
				 PO.EINDT,
				 PO.LIFNR,
			     BZ.NAME01,
			     PO.VGBEL,
			     PO.VGPOS,
			     PO.LGORT
			     <!-- PO.C00110, -->
			     <!-- PO.BOX_CNT -->
		ORDER BY PO.EBELN DESC
	</select>
	
	<select id="GR01H_LIST" parameterType="Map" resultType="DataMap">
		SELECT	RH.RECVKY,
		       	RI.SEBELN,
		       	RI.REFDKY,
		       	RH.WAREKY,
		       	WH.NAME01 AS WARENM,
		       	RH.RCPTTY AS DOCUTY,
		       	DT.SHORTX AS RCPTTYNM,
		       	RH.STATDO AS STATDO,
                NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = RH.STATDO),' ') AS STATDONM,
		       	RH.SAPSTS,
		       	RH.DOCDAT,
		       	RH.DOCCAT,
		       	RH.DPTNKY,
		       	VD.NAME01 AS DPTNNM,
		       	RH.ARCPTD AS ASNDAT,
		       	RH.OWNRKY,
		       	(SELECT NAME01 FROM OWNER OW WHERE OW.OWNRKY = RH.OWNRKY) AS OWNRNM,
		       	RH.DOCTXT
		FROM 	RECDH RH
    		LEFT OUTER JOIN BZPTN VD
							     ON	VD.PTNRKY = RH.DPTNKY
								AND VD.PTNRTY = 'VD'
								AND VD.PTNL05 IN (SELECT ADDR05 FROM WAHMA WHERE WAREKY = #{WAREKY})
		    LEFT OUTER JOIN RECDI RI ON	RI.RECVKY = RH.RECVKY
		    LEFT OUTER JOIN WAHMA WH ON WH.WAREKY = RH.WAREKY
		    LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = RH.RCPTTY
		WHERE	RH.RECVKY IN ( ${RECVKY} )	
		AND		RH.WAREKY = #{WAREKY}
		GROUP BY RH.RECVKY, RI.SEBELN, RI.REFDKY, RH.WAREKY, WH.NAME01,
		 	     RH.RCPTTY,	DT.SHORTX, RH.STATDO, RH.SAPSTS, RH.DOCDAT,
		 	     RH.DOCCAT, RH.DPTNKY, VD.NAME01, RH.ARCPTD, RH.OWNRKY,
		 	     RH.DOCTXT
		ORDER BY RECVKY
	</select>
	
	<select id="GR01Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT PO.SKUKEY
		     , SM.DESC01 
		     , SM.DESC02
		     , 'RCVLOC' AS LOCAKY
		     <!-- , NVL(TRIM(SW.LOCARV),NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = PO.BWART),'RCVLOC')) AS LOCAKY -->
		     , ' ' AS TRNUID
		     , PO.MENGE AS QTYORD
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE_R AS MENGER
		     , (PO.MENGE - PO.MENGE_R - PO.MENGE_B) AS QTYRCV1
		     , (PO.MENGE - PO.MENGE_R - PO.MENGE_B) AS QTYRCV
		     , ' '		 AS LOTA01
		     , ' '       AS LOTA02
		     , ' '       AS LOTA03
		     , ' '		 AS LOTA04
		     , ' '		 AS LOTA05
		     , '00'      AS LOTA06
		     , ' ' 		 AS LOTA07
		     , ' '       AS LOTA08
		     , ' '		 AS LOTA09
		     , PO.C00101 AS LOTA10
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA11
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA12
		     , '99991231' AS LOTA13
		     , ' '       AS LOTA14
		     , ' '       AS LOTA15
		     , ' '		 AS LOTA16
		     , ' '		 AS LOTA17
		     , ' '       AS LOTA18
		     , ' '       AS LOTA19
		     , ' '       AS LOTA20
		     , PO.EBELN AS SEBELN
		     , PO.EBELP AS SEBELP
		     , ' '      AS RECVKY
		     , ' '      AS RECVIT
		     , BZ.NAME01 AS DPTNNM
		     , PO.MANDT
		     , PO.SEQNO
		     , SM.ASKU05
		     , SW.MEASKY AS MEASKY 
		  FROM IFWMS103 PO
		       LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
		       LEFT OUTER JOIN SKUWC SW ON SW.WAREKY = PO.WAREKY AND SW.OWNRKY = #{OWNRKY} AND SW.SKUKEY = PO.SKUKEY
			   LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = DECODE(SUBSTR(PO.BWART,0,2), '13', 'CT', 'VD')
		 WHERE PO.WAREKY = #{WAREKY}
		   AND PO.WERKS = #{OWNRKY} 
		   AND PO.EBELN = #{SEBELN}
           AND (PO.MENGE - PO.MENGE_R - PO.MENGE_B) &gt; 0
           AND PO.STATUS IN ('U','C')
           AND PO.IFFLG IN ('N')
	</select>
	
	<select id="GR01I_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
		       RI.RECVKY  AS RECVKY,
		       RI.RECVIT  AS RECVIT,
		       RI.STATIT  AS STATIT,
		       DECODE(RI.SAPSTS,' ',' ','V') AS SAPSTS,
		       RI.SKUKEY  AS SKUKEY,
		       RI.LOTNUM  AS LOTNUM,
		       RI.LOCAKY  AS LOCAKY, 
		       #{AREA} AS AREAKY,
		       RI.SECTID  AS SECTID,
		       RI.TRNUID  AS TRNUID,
		       RI.PACKID  AS PACKID,
			   PO.MENGE   AS QTYORD,
			   PO.MENGE_R AS MENGER,
		       (PO.MENGE - PO.MENGE_R - PO.MENGE_B) AS QTYRCV1,
		       RI.QTYRCV  AS QTYRCV,
		       RI.QTYRCV  AS SNDQTY,
		       RI.QTYDIF  AS QTYDIF,
		       RI.QTYUOM  AS QTYUOM,
		       RI.TRUNTY  AS TRUNTY,
		       RI.MEASKY  AS MEASKY,
		       RI.UOMKEY  AS UOMKEY,
		       RI.QTPUOM  AS QTPUOM,
		       RI.DUOMKY  AS DUOMKY,
		       RI.QTDUOM  AS QTDUOM,
		       TRUNC(RI.QTYRCV/RI.QTDUOM) AS BOXQTY,
		       MOD(RI.QTYRCV,RI.QTDUOM) AS REMQTY,
		       RI.INDRCN  AS INDRCN,
		       RI.CRECVD  AS CRECVD,
		       RI.RSNCOD  AS RSNCOD,
		       RI.LOTA01  AS LOTA01,
		       NVL((SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'VD' AND PTNRKY = RI.LOTA01), ' ') AS LOTA01NMN,
		       L01NM.NAME01 AS LOTA01NM,
		       RI.LOTA02  AS LOTA02,
		       (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'DP' AND PTNRKY = RI.LOTA02) AS LOTA02NM,
		       RI.LOTA03  AS LOTA03,
		       RI.LOTA04  AS LOTA04,
		       RI.LOTA05  AS LOTA05,
		       RI.LOTA06  AS LOTA06,
		       RI.LOTA07  AS LOTA07,
		       RI.LOTA08  AS LOTA08,
		       RI.LOTA09  AS LOTA09,
		       RI.LOTA10  AS LOTA10,
		       RI.LOTA11  AS LOTA11,
		       RI.LOTA12  AS LOTA12,
		       RI.LOTA13  AS LOTA13,
		       RI.LOTA14  AS LOTA14,
		       RI.LOTA15  AS LOTA15,
		       RI.LOTA16  AS LOTA16,
		       RI.LOTA17  AS LOTA17,
		       RI.LOTA18  AS LOTA18,
		       RI.LOTA19  AS LOTA19,
		       RI.LOTA20  AS LOTA20,
		       RI.AWMSNO  AS AWMSNO,
		       RI.REFDKY  AS REFDKY,
		       RI.REFDIT  AS REFDIT,
		       RI.REFCAT  AS REFCAT,
		       RI.REFDAT  AS REFDAT,
		       RI.DESC01  AS DESC01,
		       RI.DESC02  AS DESC02,
		       RI.ASKU01  AS ASKU01,
		       RI.ASKU02  AS ASKU02,
		       RI.ASKU03  AS ASKU03,
		       RI.ASKU04  AS ASKU04,
		       RI.ASKU05  AS ASKU05,
		       RI.EANCOD  AS EANCOD,
		       RI.GTINCD  AS GTINCD,
		       RI.SKUG01  AS SKUG01,
		       RI.SKUG02  AS SKUG02,
		       RI.SKUG03  AS SKUG03,
		       RI.SKUG04  AS SKUG04,
		       RI.SKUG05  AS SKUG05,
		       RI.GRSWGT  AS GRSWGT,
		       RI.NETWGT  AS NETWGT,
		       RI.WGTUNT  AS WGTUNT,
		       RI.LENGTH  AS LENGTH,
		       RI.WIDTHW  AS WIDTHW,
		       RI.HEIGHT  AS HEIGHT,
		       RI.CUBICM  AS CUBICM,
		       RI.CAPACT  AS CAPACT,
		       RI.QTYORG  AS QTYORG,
		       RI.SMANDT  AS SMANDT,
		       RI.SEBELN  AS SEBELN,
		       RI.SEBELP  AS SEBELP,
		       RI.SZMBLNO AS SZMBLNO,
		       RI.SZMIPNO AS SZMIPNO,
		       RI.STRAID  AS STRAID,
		       RI.SVBELN  AS SVBELN,
		       RI.SPOSNR  AS SPOSNR,
		       RI.STKNUM  AS STKNUM,
		       RI.STPNUM  AS STPNUM,
		       RI.SWERKS  AS SWERKS,
		       RI.SLGORT  AS SLGORT,
		       RI.SDATBG  AS SDATBG,
		       RI.STDLNR  AS STDLNR,
		       RI.SSORNU  AS SSORNU,
		       RI.SSORIT  AS SSORIT,
		       RI.SMBLNR  AS SMBLNR,
		       RI.SZEILE  AS SZEILE,
		       RI.SMJAHR  AS SMJAHR,
		       RI.SXBLNR  AS SXBLNR,
		       RI.SBKTXT  AS SBKTXT,
		       RI.RCPRSN  AS RCPRSN,
		       RI.CREDAT  AS CREDAT,
		       RI.CRETIM  AS CRETIM,
		       RI.CREUSR  AS CREUSR,
		       CU.NMLAST  AS CUSRNM,
		       RI.LMODAT  AS LMODAT,
		       RI.LMOTIM  AS LMOTIM,
		       RI.LMOUSR  AS LMOUSR,
		       LU.NMLAST  AS LUSRNM
		  FROM RECDH RH
		       INNER JOIN RECDI RI
		               ON RI.RECVKY = RH.RECVKY
		       LEFT OUTER JOIN SKUMA SM
		          	   ON SM.OWNRKY = RH.OWNRKY
		              AND SM.SKUKEY = RI.SKUKEY
		       LEFT OUTER JOIN USRMA CU
		               ON CU.USERID = RI.CREUSR
		       LEFT OUTER JOIN USRMA LU
		               ON LU.USERID = RI.LMOUSR
		       LEFT OUTER JOIN BZPTN L01NM
		               ON L01NM.PTNRKY = RI.LOTA01
		              AND L01NM.PTNRTY = 'TM'
		       LEFT OUTER JOIN IFWMS103 PO
		       		   ON PO.EBELN = RI.SEBELN
		       		  AND PO.EBELP = RI.SEBELP
		 WHERE 1 = 1
		   AND RH.WAREKY = #{WAREKY}
		   AND RI.RECVKY = #{RECVKY}
		 ORDER BY RI.RECVKY, RI.RECVIT
	</select>
	
	<insert id="GR01_INSERT" parameterType="Map">
		INSERT INTO RECDH (RECVKY,WAREKY,RCPTTY,STATDO,SAPSTS,
			               DOCDAT,DOCCAT,DPTNKY,DRELIN,ARCPTD,
			               OWNRKY,INDRCN,CRECVD,RSNCOD,PUTSTS,
			               USRID1,UNAME1,DEPTID1,DNAME1,USRID2,
			               UNAME2,DEPTID2,DNAME2,USRID3,UNAME3,
			               DEPTID3,DNAME3,USRID4,UNAME4,DEPTID4,
			               DNAME4,DOCTXT,CREDAT,CRETIM,CREUSR,
			               LMODAT,LMOTIM,LMOUSR,INDBZL,INDARC,UPDCHK) 
			VALUES (#{RECVKY},#{WAREKY},#{RCPTTY},#{STATDO},' ',
				    #{DOCDAT},#{DOCCAT},#{DPTNKY},' ',#{ASNDAT},
			        #{OWNRKY},' ',' ',' ',' ',
			        ' ',' ',' ',' ',' ',
			        ' ',' ',' ',' ',' ',
			        ' ',' ',' ',' ',' ',
			        ' ',NVL( #{DOCTXT}, ' ' ),TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
 				    TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},' ',' ',0)
	</insert>
	
	<insert id="GR01Sub_INSERT" parameterType="Map">
		INSERT INTO RECDI (RECVKY,RECVIT,STATIT,SAPSTS,SKUKEY,
						   LOTNUM,AREAKY,LOCAKY,SECTID,TRNUID,
						   PACKID,QTYRCV,QTYDIF,QTYUOM,TRUNTY,
						   MEASKY,UOMKEY,QTPUOM,DUOMKY,QTDUOM,
						   INDRCN,CRECVD,RSNCOD,WORKID,WORKNM,
						   
						   HHTTID,LOTA01,LOTA02,LOTA03,LOTA04,
						   LOTA05,LOTA06,LOTA07,LOTA08,LOTA09,
						   LOTA10,LOTA11,LOTA12,LOTA13,LOTA14,
						   LOTA15,LOTA16,LOTA17,LOTA18,LOTA19,
						   
						   LOTA20,AWMSNO,REFDKY,REFDIT,REFCAT,
						   REFDAT,DESC01,DESC02,ASKU01,ASKU02,
						   ASKU03,ASKU04,ASKU05,EANCOD,GTINCD,
						   SKUG01,SKUG02,SKUG03,SKUG04,SKUG05,
						   
						   GRSWGT,NETWGT,WGTUNT,LENGTH,WIDTHW,
						   HEIGHT,CUBICM,CAPACT,QTYORG,SMANDT,
						   SEBELN,SEBELP,SZMBLNO,SZMIPNO,STRAID,
						   SVBELN,SPOSNR,STKNUM,STPNUM,SWERKS,
						   SLGORT,SDATBG,STDLNR,SSORNU,SSORIT,
						   SMBLNR,SZEILE,SMJAHR,SXBLNR,SBKTXT,
						   RCPRSN,CREDAT,CRETIM,CREUSR,LMODAT,
						   LMOTIM,LMOUSR,INDBZL,INDARC,UPDCHK) 
			VALUES (#{RECVKY},#{RECVIT},' ',' ',#{SKUKEY},
					' ',NVL(#{AREAKY}, ' '), #{LOCAKY},' ',NVL(#{TRNUID},' '),
				    ' ',#{QTYRCV},0,0,' ',
					#{SKUKEY},#{UOMKEY},0,' ',0,
					' ',' ',' ',' ',' ',
					
					' ',#{LOTA01},#{LOTA02},#{LOTA03},#{LOTA04},
					#{LOTA05},#{LOTA06},NVL( #{LOTA07}, ' ' ),#{LOTA08},NVL( #{LOTA09}, ' ' ),
					#{LOTA10},#{LOTA11},#{LOTA12},#{LOTA13},' ',
					' ',0,0,0,0,
					
					0,' ',NVL(#{REFDKY},' '),NVL(#{REFDIT},' '),NVL(#{REFCAT},' '),
					#{ASNDAT},#{DESC01},#{DESC02},' ',' ',
				    ' ',' ',' ',NVL(#{EANCOD},' '),NVL(#{GTINCD},' '),
					' ',' ',' ',' ',' ',
					
					0,0,' ',0,0,
					0,0,0,0,' ',
					#{SEBELN},#{SEBELP},' ',' ',' ',
					' ',' ',' ',' ',' ',
					' ',' ',' ',' ',' ',
					' ',' ',' ',' ',' ',
					' ',TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
 				    TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},' ',' ',0)
	</insert>
	
	<select id="GR_AIRWMS_DOCUMENT_PROCESS_MAP" parameterType="Map" resultType="DataMap">
		{ call P_AIRWMS_DOCUMENT_PROCESS(#{DOCCAT}, #{DOCUKY}, NVL(#{DOCUIT}, ' '), NVL(#{DOFLAG}, ' '), #{SES_USER_ID}) }
	</select>
	
	<select id="GR01PROCALL_MAP" parameterType="Map" resultType="DataMap">
		{ call P_RECEIPT_PROCESS(#{RECVKY}, #{SES_USER_ID}) }
	</select>
	
	<!-- <select id="GR01Sub_VALIDATION" parameterClass="Map" resultClass="DataMap">
	 	SELECT
			CASE
		         WHEN SM.SKUKEY IS NOT NULL THEN 'MASTER_M0669' || ' ' || STD.SKUKEY
		         WHEN SW.IBPROT = 'V' THEN 'VALID_M1559' || ' ' || STD.IBPROT      
		         WHEN BZ.PROCHA = 'V' THEN 'VALID_M1559' || ' ' || STD.PROCHA     
		         WHEN MI.MEASKY IS NOT NULL THEN 'VALID_M1556' || ' ' || STD.MEASKY 
		         WHEN BZ.PTNRKY IS NOT NULL THEN 'VALID_M1558' || ' ' || STD.PTNRKY 
		         ELSE 'OK'
		       END AS MSG
		FROM   ( 
					${VALIDATION_SQL} 
                ) STD 
		       LEFT OUTER JOIN SKUMA SM 
		      		ON SM.OWNRKY = #{SES_OWNER} AND SM.SKUKEY = STD.SKUKEY
		       LEFT OUTER JOIN SKUWC SW	
		            ON SW.WAREKY = STD.WAREKY 
              	   AND SW.OWNRKY = STD.OWNRKY 
              	   AND SW.SKUKEY = STD.SKUKEY
		       LEFT OUTER JOIN MEASI MI	
		       		ON MI.WAREKY = STD.WAREKY 
              	   AND MI.MEASKY = STD.MEASKY 
              	   AND MI.UOMKEY = STD.UOMKEY
               LEFT OUTER JOIN BZPTN BZ 
               		ON BZ.PTNRKY = STD.PTNRKY AND BZ.PTNRTY = STD.PTNRTY
	 </select> -->
	
	<select id="VALIDCHECK_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) AS CNT 
        FROM IFWMS103 PO
             INNER JOIN SKUMA SM ON SM.OWNRKY = 'IMV' AND SM.SKUKEY = PO.SKUKEY
             INNER JOIN SKUWC SW ON SW.WAREKY = PO.WAREKY AND SW.OWNRKY = 'IMV' AND SW.SKUKEY = PO.SKUKEY
             INNER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = 'IMV' AND BZ.PTNRTY = 'VD'
       WHERE PO.MANDT = #{MANDT}
         AND PO.SEQNO = #{SEQNO} 
         AND (SW.IBPROT = 'V' OR BZ.PROCHA = 'V' OR (PO.MENGE-PO.MENGE_R)  &lt;  0  OR PO.STATUS = 'D')
	</select>
	
	
	<select id="GR03_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			' ' AS RECVKY,
			PO.EBELN AS SEBELN,
			PO.WAREKY,
			NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = PO.WAREKY),' ') AS WARENM,
			PO.BWART AS RCPTTY,
			NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS RCPTNM,
			PO.EINDT AS ASNDAT,
			TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT,
			PO.LGORT AS AREAKY,
			NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = PO.LGORT),' ') AS AREANM,
			PO.LIFNR AS DPTNKY,
		    BZ.NAME01 AS DPTNNM,
		    PO.BWART AS DOCUTY,
		    NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS DOCTNM,
		    'NEW' AS STATDO,
		    NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = 'NEW'),' ') AS STATDONM,
		    PO.C00110 AS DOCTXT
		FROM IFWMS103 PO
		     INNER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = 'IMV' AND BZ.PTNRTY = 'CT'
		     INNER JOIN SKUMA SM ON SM.OWNRKY = 'IMV' AND SM.SKUKEY = PO.SKUKEY
		WHERE PO.WAREKY = #{WAREKY}
		  AND PO.WERKS  = #{SES_OWNER} 
		  AND PO.LGORT  = #{AREAKY}
          AND PO.BWART = '104'
          AND PO.MENGE - PO.MENGE_R &gt; 0
          AND PO.STATUS IN ('U','C')
          AND PO.IFFLG IN ('N','Y')
        <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		GROUP BY PO.EBELN,
			     PO.WAREKY,
			     PO.BWART,
		     	 PO.EINDT,
			     PO.LGORT,
			     PO.LIFNR,
		         BZ.NAME01,
		         PO.BWART,
		         PO.C00110
	</select>
	
	<select id="GR03Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT PO.SKUKEY
		     , SM.DESC01 
		     , SM.DESC02
		     , ('RCV'||#{AREAKY}) AS LOCAKY
		     <!-- , NVL(TRIM(SW.LOCARV),NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = PO.BWART),'RCVLOC')) AS LOCAKY -->
		     , ' ' AS TRNUID
		     , PO.MENGE AS QTYORD
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE AS QTYRCV
		     , PO.LIFNR  AS LOTA01
		     , ' '       AS LOTA02
		     , ' '       AS LOTA03
		     , PO.MBLNO  AS LOTA04
		     , PO.MIPNO  AS LOTA05
		     , '00'      AS LOTA06
		     , CASE WHEN PO.C00107 = 'IMV' THEN PO.EBELN ELSE ' ' END AS LOTA07
		     , ' '       AS LOTA08
		     , CASE WHEN PO.C00107 = 'WMS' THEN PO.EBELN ELSE ' ' END AS LOTA09
		     , PO.C00101 AS LOTA10
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA11
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA12
		     , '99991231' AS LOTA13
		     , ' '       AS LOTA14
		     , ' '       AS LOTA15
		     , PO.N00101 AS LOTA16
		     , PO.N00103 AS LOTA17
		     , ' '       AS LOTA18
		     , ' '       AS LOTA19
		     , ' '       AS LOTA20
		     , PO.EBELN AS SEBELN
		     , PO.EBELP AS SEBELP
		     , ' '      AS RECVKY
		     , ' '      AS RECVIT
		     , BZ.NAME01 AS DPTNNM
		     , PO.MANDT
		     , PO.SEQNO
		  FROM IFWMS103 PO
		       INNER JOIN SKUMA SM ON SM.OWNRKY = 'IMV' AND SM.SKUKEY = PO.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = PO.WAREKY AND SW.OWNRKY = 'IMV' AND SW.SKUKEY = PO.SKUKEY
			   INNER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = 'IMV' AND BZ.PTNRTY = 'CT'
		 WHERE PO.WAREKY = #{WAREKY}
		   AND PO.WERKS = #{SES_OWNER} 
		   AND PO.EBELN = #{SEBELN}
		   AND PO.LGORT = #{AREAKY}
           AND PO.BWART = '104'
           AND PO.MENGE - PO.MENGE_R &gt; 0
           AND PO.STATUS IN ('U','C')
           AND PO.IFFLG IN ('N','Y')
	</select>
	
	<select id="GR04_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			' ' AS RECVKY,
			PO.EBELN AS SEBELN,
			PO.WAREKY,
			NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = PO.WAREKY),' ') AS WARENM,
			PO.BWART AS RCPTTY,
			NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS RCPTNM,
			PO.EINDT AS ASNDAT,
			TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT,
			PO.LGORT AS AREAKY,
			NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = PO.LGORT),' ') AS AREANM,
			PO.LIFNR AS DPTNKY,
		    BZ.NAME01 AS DPTNNM,
		    PO.BWART AS DOCUTY,
		    NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS DOCTNM,
		    'NEW' AS STATDO,
		    NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = 'NEW'),' ') AS STATDONM,
		    ' ' AS DOCTXT
		FROM IFWMS103 PO
		     LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.VGPOS AND BZ.OWNRKY = 'IMV' AND BZ.PTNRTY = 'CT'
		     LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = 'IMV' AND SM.SKUKEY = PO.SKUKEY
		WHERE PO.WAREKY = #{WAREKY}
		  AND PO.WERKS  = #{SES_OWNER} 
		  AND PO.LGORT  = #{AREAKY}
          AND PO.BWART IN ('107')
          AND PO.MENGE - PO.MENGE_R &gt; 0
          AND PO.STATUS IN ('U','C')
          AND PO.IFFLG IN ('N','Y')
        <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		GROUP BY PO.EBELN,
			     PO.WAREKY,
			     PO.BWART,
			     PO.EINDT,
			     PO.LGORT,
			     PO.LIFNR,
		         BZ.NAME01,
		         PO.BWART
		ORDER BY PO.EBELN DESC
	</select>
	
	<select id="GR04Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT PO.SKUKEY
		     , SM.DESC01 
		     , SM.DESC02
		     , ('RTN'||#{AREAKY}) AS LOCAKY
		     , ' ' AS TRNUID
		     , PO.MENGE AS QTYORD
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE AS QTYRCV
		     , PO.LIFNR  AS LOTA01
		     , ' '       AS LOTA02
		     , ' '       AS LOTA03
		     , PO.MBLNO  AS LOTA04
		     , PO.MIPNO  AS LOTA05
		     , '10'      AS LOTA06
		     , ' ' AS LOTA07
		     , ' '       AS LOTA08
		     , ' ' AS LOTA09
		     , ' ' AS LOTA10
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA11
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA12
		     , '99991231' AS LOTA13
		     , ' '       AS LOTA14
		     , ' '       AS LOTA15
		     , PO.N00101 AS LOTA16
		     , ' ' AS LOTA17
		     , ' '       AS LOTA18
		     , ' '       AS LOTA19
		     , ' '       AS LOTA20
		     , PO.EBELN AS SEBELN
		     , PO.EBELP AS SEBELP
		     , ' '      AS RECVKY
		     , ' '      AS RECVIT
		     , BZ.NAME01 AS DPTNNM
		     , PO.MANDT
		     , PO.SEQNO
		     , SM.SKUG05
		     , SM.ASKU05
		  FROM IFWMS103 PO
		       LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{SES_OWNER}  AND SM.SKUKEY = PO.SKUKEY
		       LEFT OUTER JOIN SKUWC SW ON SW.WAREKY = PO.WAREKY AND SW.OWNRKY = #{SES_OWNER}  AND SW.SKUKEY = PO.SKUKEY
			   LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.VGPOS AND BZ.OWNRKY = #{SES_OWNER}  AND BZ.PTNRTY = 'CT'
		 WHERE PO.WAREKY = #{WAREKY}
		   AND PO.WERKS = #{SES_OWNER} 
		   AND PO.EBELN = #{SEBELN}
		   AND PO.LGORT = #{AREAKY}
           AND PO.BWART IN ('107')
           AND PO.MENGE - PO.MENGE_R &gt; 0
           AND PO.STATUS IN ('U','C')
           AND PO.IFFLG IN ('N','Y')
	</select>
	
	<select id="GR18_LIST" parameterType="Map" resultType="DataMap">
		WITH OE_T AS (
		    SELECT NVL(OE.NAME01,' ') AS OWNRNM
		    FROM OWNER OE 
		    WHERE OE.OWNRKY = #{OWNRKY}
		),
		WM_T AS (
		    SELECT NVL(WM.NAME01,' ') AS WARENM  
		    FROM WAHMA WM
		    WHERE WM.WAREKY = #{WAREKY}
		),
		LOTA02_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'LOTA02'
		),
		LOTA06_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'LOTA06'
		),
		LOTA08_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'NATNKY'
		),
		STATIT_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'STATIT'
		),
        DOCCM_T AS (
          SELECT DC.DOCCAT
             , NVL(DL.SHORTX, DC.SHORTX) AS DOCCATNM
          FROM DOCCM DC
            LEFT OUTER JOIN DOCCM_LANG DL ON DL.LANGKY = #{LANGKY} AND DL.DOCCAT = DC.DOCCAT
        ),
        RSNCD_T AS (
            SELECT RC.DOCCAT
                 , RC.DOCUTY
                 , RC.RSNCOD
                 , NVL(RL.SHORTX, RC.SHORTX) AS RSNCODNM
            FROM RSNCD RC
              LEFT OUTER JOIN RSNCD_LANG RL 
                           ON RL.LANGKY = #{LANGKY}
                          AND RL.OWNRKY = RC.OWNRKY
                          AND RL.DOCCAT = RC.DOCCAT
                          AND RL.DOCUTY = RC.DOCUTY
                          AND RL.RSNCOD = RC.RSNCOD
             WHERE RC.OWNRKY = #{OWNRKY}
        ),
        SLM_T AS (
          	SELECT SLM.OWNRKY
			     , SLM.PLNTKY
			     , SLM.STLKY
			     , SLM.STLNM
			FROM STLMA SLM 
			WHERE SLM.OWNRKY = #{OWNRKY} 
        ),
        UIM_T AS (
          	SELECT UM.OWNRKY
			     , UM.PLNTKY
			     , UM.UNITNO
			     , UM.UNITNM
			FROM UNITMA UM 
			  WHERE UM.OWNRKY = #{OWNRKY} 
        ),
        DOCPG_T AS (
		   SELECT X.DOCUTY
		   FROM DOCPG X
		   WHERE X.PROGID = #{PROGID}
		),
		D_UOMQTY_T AS (
		  	SELECT A.MEASKY
                 , A.D_UOMKEY
			     , ( CASE WHEN A.QTAUOM_KG=0 THEN 0 ELSE (A.QTPUOM_KG / A.QTAUOM_KG) END ) AS DSN_KG
			     , ( CASE WHEN A.QTAUOM_BAG=0 THEN 0 ELSE (A.QTPUOM_BAG / A.QTAUOM_BAG) END ) AS DSN_BAG
			     , ( CASE WHEN A.QTAUOM_BOX=0 THEN 0 ELSE (A.QTPUOM_BOX / A.QTAUOM_BOX) END ) AS DSN_BOX
			     , ( CASE WHEN A.QTAUOM_PAL=0 THEN 0 ELSE (A.QTPUOM_PAL / A.QTAUOM_PAL) END ) AS DSN_PAL
			     , ( CASE WHEN A.QTAUOM_SOK=0 THEN 0 ELSE (A.QTPUOM_SOK / A.QTAUOM_SOK) END ) AS DSN_SOK
			     , ( CASE WHEN A.QTAUOM_EA=0 THEN 0 ELSE (A.QTPUOM_EA / A.QTAUOM_EA) END ) AS DSN_EA
			FROM (
			    SELECT MI.MEASKY
			         , MAX( CASE WHEN MI.INDDFU='V' THEN MI.UOMKEY ELSE ' ' END ) AS D_UOMKEY
			         , SUM( CASE WHEN MI.UOMKEY='KG' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_KG
			         , SUM( CASE WHEN MI.UOMKEY='KG' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_KG
			         , SUM( CASE WHEN MI.UOMKEY='BAG' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_BAG
			         , SUM( CASE WHEN MI.UOMKEY='BAG' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_BAG     
			         , SUM( CASE WHEN MI.UOMKEY='BOX' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_BOX
			         , SUM( CASE WHEN MI.UOMKEY='BOX' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_BOX     
			         , SUM( CASE WHEN MI.UOMKEY='PAL' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_PAL
			         , SUM( CASE WHEN MI.UOMKEY='PAL' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_PAL     
			         , SUM( CASE WHEN MI.UOMKEY='SOK' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_SOK
			         , SUM( CASE WHEN MI.UOMKEY='SOK' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_SOK     
			         , SUM( CASE WHEN MI.UOMKEY='EA' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_EA
			         , SUM( CASE WHEN MI.UOMKEY='EA' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_EA     
			    FROM MEASI MI
			    WHERE MI.WAREKY = #{WAREKY}			      
			      AND EXISTS (
			                     SELECT 'X'
			                     FROM RECDI RI 
								   INNER JOIN RECDH RH ON RI.RECVKY = RH.RECVKY AND RH.WAREKY = #{WAREKY} AND RH.OWNRKY = #{OWNRKY}  
								   INNER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = RI.SKUKEY
								   INNER JOIN LOCMA LM ON LM.WAREKY = #{WAREKY} AND LM.LOCAKY = RI.LOCAKY
								   LEFT OUTER JOIN BZPTN BT ON BT.PTNRKY = RH.DPTNKY AND BT.PTNRTY = RH.PTNRTY AND BT.OWNRKY = #{OWNRKY}
			                     WHERE RI.SKUKEY = MI.MEASKY
							        <if test="SES_MTYPE != null and SES_MTYPE != ''">
							            AND SM.MTYPE LIKE #{SES_MTYPE}
							        </if>
									<if test="RANGE_SQL != null and RANGE_SQL != ''">
										${RANGE_SQL}
									</if>
									<if test="RCPTTY != null and RCPTTY != ''">
										AND RH.RCPTTY = ${RCPTTY}
									</if>
									<if test="LOTA06 != null and LOTA06 != ''">
										AND RI.LOTA06 = #{LOTA06}
									</if>
									<if test="SKUG01 != null and SKUG01 != ''">
										AND SM.SKUG01 = #{SKUG01}
									</if>
									<if test="SKUL01 != null and SKUL01 != ''">
										AND SM.SKUL01 = #{SKUL01}
									</if>
									<if test="STATDO != null and STATDO != ''">
										AND 	RH.STATDO = #{STATDO} 
									</if>
									<if test="Opt == 1">
										AND TRIM(RI.INDRCN) IS NULL
									</if>
									<if test="Opt == 2">
										AND TRIM(RI.INDRCN) IS NOT NULL
									</if>
			                  )
			    GROUP BY MI.MEASKY
			) A
		)
		SELECT RH.OWNRKY
		     , ( SELECT OWNRNM FROM OE_T ) AS OWNRNM
    		 , RH.WAREKY
    		 , ( SELECT WARENM FROM WM_T ) AS WARENM  
    		 , RI.STKNUM 
		     , RI.AREAKY
		     , NVL(AM.SHORTX,' ') AS AREANM  
		     , RH.DOCDAT
		     , RI.REFDAT AS ASNDAT 
		     , RH.RECVKY
		     , RI.RECVIT
		     , RI.SEBELN
		     , RI.SEBELP 
		     , RH.RCPTTY
		     , NVL(DT.SHORTX,' ') AS RCPTNM
		     , RI.INDRCN
		     , RI.CRECVD 
		     , RH.DPTNKY
		     , NVL(BT.NAME01,' ') AS DPTNNM
		     , RI.SKUKEY
		     , SM.DESC01
		     , SM.DESC02 
		     , RI.QTYRCV
		     , RI.UOMKEY 
		     , RI.LOTA01
		     , ( SELECT X.STLNM FROM SLM_T X WHERE X.PLNTKY = RI.LOTA02 AND X.STLKY = RI.LOTA01 ) AS LOTA01NM
		     , RI.LOTA02
		     , ( SELECT X.CDESC1 FROM LOTA02_T X WHERE X.CMCDVL=RI.LOTA02 ) AS LOTA02NM
		     , RI.LOTA03
		     , RI.LOTA04
		     , ( SELECT X.UNITNM FROM UIM_T X WHERE X.PLNTKY = RI.LOTA02 AND X.UNITNO = RI.LOTA04 ) AS LOTA04NM
		     , RI.LOTA05
		     , RI.LOTA06
		     , ( SELECT X.CDESC1 FROM LOTA06_T X WHERE X.CMCDVL=RI.LOTA06 ) AS LOTA06NM
		     , RI.LOTA07
		     , RI.LOTA08
		     , ( SELECT X.CDESC1 FROM LOTA08_T X WHERE X.CMCDVL=RI.LOTA08 ) AS LOTA08NM
		     , RI.LOTA09
		     , RI.LOTA10 
		     , RI.LOTA11
		     , RI.LOTA12
		     , RI.LOTA13
		     , RI.LOTA14
		     , RI.LOTA15
		     
		     , RI.LOTA16
		     , RI.LOTA17
		     , RI.LOTA18
		     , RI.LOTA19
		     , RI.LOTA20
		     
		     , RI.LOTA21
		     , RI.LOTA22
		     , RI.LOTA23
		     , RI.LOTA24
		     
		     , RI.LOTA41
		     , RI.LOTA42
		     
		     , RI.CREDAT
		     , RI.CRETIM
		     , RI.CREUSR
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RI.CREUSR),' ') AS CUSRNM 
		     , RI.LMODAT
		     , RI.LMOTIM
		     , RI.LMOUSR
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RI.LMOUSR),' ') AS LUSRNM
		     , RI.RSNCOD
		     , ( SELECT X.RSNCODNM FROM RSNCD_T X WHERE X.DOCCAT=RH.DOCCAT AND X.DOCUTY=RH.RCPTTY AND X.RSNCOD=RI.RSNCOD ) AS RSNCODNM
		     , RI.RCPRSN
		     , RH.DOCCAT
		     , ( SELECT X.DOCCATNM FROM DOCCM_T X WHERE X.DOCCAT=RH.DOCCAT ) AS DOCCATNM
		     , RI.STATIT
		     , ( SELECT X.CDESC1 FROM STATIT_T X WHERE X.CMCDVL=RI.STATIT ) AS STATITNM
		     , RI.LOCAKY		     
		     , RH.ORDDAT
		     , LM.ZONEKY
		     , RH.DOCTXT
		     , RI.QTYUOM
		     , RI.DUOMKY
			 , (
 					CASE WHEN RI.UOMKEY='KG' 
 					       THEN RI.QTYRCV
                         WHEN RI.UOMKEY!='KG' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_KG=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_KG) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_KG=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_KG ) END)
                    END 
			   ) AS TOT
			 , (
 					CASE WHEN RI.UOMKEY='BAG' 
 					       THEN RI.QTYRCV
                         WHEN RI.UOMKEY!='BAG' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_BAG=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_BAG) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_BAG=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_BAG ) END)
                    END 
			   ) AS BAG
			 , (
 					CASE WHEN RI.UOMKEY='BOX' 
 					       THEN RI.QTYRCV
                         WHEN RI.UOMKEY!='BOX' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_BOX=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_BOX) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_BOX=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_BOX ) END)
                    END 
			   ) AS BOX
			 , (
 					CASE WHEN RI.UOMKEY='PAL' 
 					       THEN RI.QTYRCV
                         WHEN RI.UOMKEY!='PAL' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_PAL=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_PAL) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_PAL=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_PAL ) END)
                    END 
			   ) AS PLT
			 , (
 					CASE WHEN RI.UOMKEY='SOK' 
 					       THEN RI.QTYRCV
                         WHEN SM.SKUG05 = '20'
			               THEN 0
                         WHEN RI.UOMKEY!='SOK' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_SOK=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_SOK) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_SOK=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_SOK ) END)
                    END 
			   ) AS SOK
			 , (
 					CASE WHEN RI.UOMKEY='EA' 
 					       THEN RI.QTYRCV
                         WHEN SM.SKUG05 = '20'
			               THEN 0
                         WHEN RI.UOMKEY!='EA' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_EA=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_EA) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_EA=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_EA ) END)
                    END 
			   ) AS EA 
			 , CASE WHEN RI.QTYRCV = 0 THEN 0 
			 		ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BOX'))),'0.000') 
				END AS BOXBAG
		  FROM RECDI RI 
		    INNER JOIN RECDH RH ON RI.RECVKY = RH.RECVKY AND RH.WAREKY = #{WAREKY} AND RH.OWNRKY = #{OWNRKY} 
		    INNER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = RI.SKUKEY
		    INNER JOIN DOCTM DT ON DT.DOCUTY = RH.RCPTTY
		    INNER JOIN LOCMA LM ON LM.WAREKY = #{WAREKY} AND LM.LOCAKY = RI.LOCAKY
		    LEFT OUTER JOIN BZPTN BT ON BT.PTNRKY = RH.DPTNKY AND BT.PTNRTY = RH.PTNRTY AND BT.OWNRKY = #{OWNRKY}
		    LEFT OUTER JOIN AREMA AM ON AM.WAREKY = #{WAREKY} AND AM.AREAKY = RI.AREAKY
		    LEFT OUTER JOIN D_UOMQTY_T DUMO_T ON DUMO_T.MEASKY = RI.SKUKEY 
		 WHERE RI.STATIT != 'FTV'
		   AND EXISTS (
			            SELECT 'X'
			            FROM DOCPG_T X
			            WHERE X.DOCUTY = RH.RCPTTY
			          )
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		<if test="RCPTTY != null and RCPTTY != ''">
			AND RH.RCPTTY = ${RCPTTY}
		</if>
		<if test="LOTA06 != null and LOTA06 != ''">
			AND RI.LOTA06 = #{LOTA06}
		</if>
		<if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		</if>
		<if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		</if>
        <if test="SES_MTYPE != null and SES_MTYPE != ''">
            AND SM.MTYPE LIKE #{SES_MTYPE}
        </if>
		<if test="STATDO != null and STATDO != ''">
			AND 	RH.STATDO = #{STATDO} 
		</if>
		<if test="Opt == 1">
			AND TRIM(RI.INDRCN) IS NULL
		</if>
		<if test="Opt == 2">
			AND TRIM(RI.INDRCN) IS NOT NULL
		</if>
		ORDER BY RI.RECVKY DESC, RI.RECVIT
	</select>
	
	
	<select id="FN_DOCUSEQ_LIST" parameterType="Map" resultType="DataMap" timeout="600">
		${SQL}
	</select>
	
	<select id="GOODS_RECEIPT_VALIDATION" parameterType="Map" resultType="DataMap" timeout="600">
		SELECT *
		  FROM (
		         SELECT CASE WHEN NOT EXISTS (SELECT 1 FROM IFWMS103 WHERE WERKS = STD.OWNRKY AND EBELN = STD.SEBELN AND EBELP = STD.SEBELP AND IFFLG IN ('Y','N') AND STATUS IN ('U','C'))
		                          THEN 'IN_M0125†' || STD.SEBELN || '/' || STD.SEBELP
		                     <if test='QTYCHKYN = null or QTYCHKYN != "N"'>
		                     WHEN (STD.RCPTTY != '121' AND SLME.WMSMAK != 'V') AND NVL((SELECT MAX(MENGE - MENGE_R) FROM IFWMS103 WHERE WERKS = STD.OWNRKY AND EBELN = STD.SEBELN AND EBELP = STD.SEBELP AND IFFLG IN ('Y','N') AND STATUS IN ('U','C') <!-- AND BWART = #{RCPTTY} -->),0) - STD.QTYRCV &lt; 0
		                          THEN 'IN_M0078†' || STD.SEBELN || '/' || STD.SEBELP
		                     </if>
		                     WHEN NOT EXISTS (SELECT PROCHA FROM BZPTN WHERE PTNRTY = STD.PTNRTY AND PTNRKY = STD.DPTNKY)
		                          THEN 'VALID_M0205†' || STD.DPTNKY
<!-- 		                     WHEN STD.RCPTTY NOT IN ('104','105','107') AND NVL((SELECT PROCHA FROM BZPTN WHERE OWNRKY = STD.OWNRKY AND PTNRTY = NVL((SELECT CDOCTY FROM DOCTM WHERE DOCUTY = STD.RCPTTY),'VD') AND PTNRKY = STD.DPTNKY),'V') = 'V' -->
<!-- 		                          THEN 'IN_M0127†' || STD.DPTNKY || '/' || NVL((SELECT NAME01 FROM BZPTN WHERE OWNRKY = STD.OWNRKY AND PTNRTY = NVL((SELECT CDOCTY FROM DOCTM WHERE DOCUTY = STD.RCPTTY),'VD') AND PTNRKY = STD.DPTNKY),'X') -->
		                     WHEN NOT EXISTS (SELECT 1 FROM SKUMA WHERE OWNRKY = STD.OWNRKY AND SKUKEY = STD.SKUKEY)
		                          THEN 'VALID_M0206†' || STD.SKUKEY
<!-- 		                     WHEN NVL((SELECT IBPROT FROM SKUWC WHERE WAREKY = STD.WAREKY AND OWNRKY = STD.OWNRKY AND SKUKEY = STD.SKUKEY),'V') = 'V' -->
<!-- 		                          THEN 'IN_M0128†' || STD.SKUKEY || '/' || NVL((SELECT DESC01 FROM SKUMA WHERE OWNRKY = STD.OWNRKY AND SKUKEY = STD.SKUKEY),'X') -->
<!-- 		                     WHEN NOT EXISTS (SELECT 1 FROM MEASI WHERE WAREKY = STD.WAREKY AND MEASKY = STD.OWNRKY || STD.SKUKEY AND UOMKEY = STD.UOMKEY) -->
<!-- 		                          THEN 'IN_M0129†' || STD.UOMKEY || '/' || NVL((SELECT DUOMKY FROM SKUMA WHERE OWNRKY = STD.OWNRKY AND SKUKEY = STD.SKUKEY),'X') -->
		                     WHEN NOT EXISTS (SELECT 1 FROM LOCMA WHERE WAREKY = STD.WAREKY AND LOCAKY = STD.LOCAKY)
		                          THEN 'IN_M0130†' || STD.LOCAKY
		                     ELSE 'OK'
		                  END AS RESULTMSG
		           FROM (
		                  ${APPEND_QUERY}
		                ) STD
		             LEFT OUTER JOIN IFWMS103 PO ON PO.EBELN = STD.SEBELN AND PO.EBELP = STD.SEBELP
		             LEFT OUTER JOIN STLMA SLME ON SLME.OWNRKY = STD.OWNRKY AND SLME.PLNTKY = PO.FLOTA02 AND SLME.STLKY  = PO.FLOTA01
		       )
		 WHERE RESULTMSG != 'OK'
	</select>
	
	<select id="GR05_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			' ' AS RECVKY,
			PO.EBELN AS SEBELN,
			PO.WAREKY,
			NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = PO.WAREKY),' ') AS WARENM,
			PO.BWART AS RCPTTY,
			NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS RCPTNM,
			PO.EINDT AS ASNDAT,
			TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT,
			PO.LGORT AS AREAKY,
			NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = PO.LGORT),' ') AS AREANM,
			PO.LIFNR AS DPTNKY,
		    NVL(US.NMLAST,' ') AS DPTNNM,
		    PO.BWART AS DOCUTY,
         	' ' AS SALCOM,
         	' ' AS SALCOMNM, 
         	' ' AS SALPLT,
         	' ' AS SALPLTNM,
		    NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS DOCTNM,
		    'NEW' AS STATDO,
		    NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = 'NEW'),' ') AS STATDONM,
		    ' ' AS DOCTXT, 
		    '1' AS BOX_CNT
		FROM IFWMS103 PO
			 LEFT OUTER JOIN USRMA US ON US.USERID = PO.LIFNR
			 LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = 'IMV' AND SM.SKUKEY = PO.SKUKEY
		WHERE PO.WAREKY = #{WAREKY}
		  AND PO.WERKS  = #{SES_OWNER} 
		  AND PO.LGORT  = #{AREAKY}
	      AND PO.BWART IN ('104','105')
	      AND PO.MENGE - PO.MENGE_R &gt; 0
	      AND PO.STATUS IN ('U','C')
	      AND PO.IFFLG IN ('N','Y')
        <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		GROUP BY PO.EBELN,
			PO.WAREKY,
			PO.BWART,
			PO.EINDT,
			PO.LGORT,
			PO.LIFNR,
		    NVL(US.NMLAST,' '),
		    PO.BWART
		ORDER BY PO.EBELN DESC
	</select>
	
	<select id="GR05Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT PO.SKUKEY
		     , SM.DESC01 
		     , SM.DESC02
		     , ('RTN'||#{AREAKY}) AS LOCAKY
		     <!-- , NVL(TRIM(SW.LOCARV),NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = PO.BWART),'RCVLOC')) AS LOCAKY -->
		     , ' ' AS TRNUID
		     , PO.MENGE AS QTYORD
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE AS QTYRCV
		     , PO.LIFNR  AS LOTA01
		     , NVL((SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'VD' AND PTNRKY = PO.LIFNR),' ') AS LOTA01NMN
		     , ' '       AS LOTA02
		     , ' '       AS LOTA03
		     , PO.MBLNO  AS LOTA04
		     , PO.MIPNO  AS LOTA05
		     , '10'      AS LOTA06
		     , ' ' AS LOTA07
		     , ' '       AS LOTA08
		     , ' ' AS LOTA09
		     , PO.C00101 AS LOTA10
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA11
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA12
		     , '99991231' AS LOTA13
		     , ' '       AS LOTA14
		     , ' '       AS LOTA15
		     , PO.N00101 AS LOTA16
		     , ' ' AS LOTA17
		     , ' '       AS LOTA18
		     , ' '       AS LOTA19
		     , ' '       AS LOTA20
		     , PO.EBELN AS SEBELN
		     , PO.EBELP AS SEBELP
		     , ' '      AS RECVKY
		     , ' '      AS RECVIT
		     , NVL(US.NMLAST,' ') AS DPTNNM
		     , PO.MANDT
		     , PO.SEQNO
		     , SM.SKUG05
		     , SM.ASKU05
		  FROM IFWMS103 PO
		       LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{SES_OWNER} AND SM.SKUKEY = PO.SKUKEY
		       LEFT OUTER JOIN SKUWC SW ON SW.WAREKY = PO.WAREKY AND SW.OWNRKY = #{SES_OWNER} AND SW.SKUKEY = PO.SKUKEY
			   LEFT OUTER JOIN USRMA US ON US.USERID = PO.LIFNR
		 WHERE PO.WAREKY = #{WAREKY}
		   AND PO.WERKS = #{SES_OWNER} 
		   AND PO.EBELN = #{SEBELN}
		   AND PO.LGORT = #{AREAKY}
           AND PO.BWART IN ('104','105')
           AND PO.MENGE - PO.MENGE_R &gt; 0
           AND PO.STATUS IN ('U','C')
           AND PO.IFFLG IN ('N','Y')
	</select>
	
	<select id="DOCTMCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT  DOCUTY AS VALUE_COL
		      , SHORTX AS TEXT_COL
		FROM    DOCTM
		WHERE   1 = 1
		<if test="DOCCAT != null and DOCCAT != ''">
		AND     DOCCAT = #{DOCCAT}
		</if>
		<if test="DOCUTY != null and DOCUTY != ''">
		AND     DOCUTY = #{DOCUTY}
		</if>
		<if test="PROGID == &quot;MGR01&quot;">
		AND     DOCCAT = '100'
		AND     DOCUTY IN ('101','102','103','112','166')
		</if>
	</select>
	
    <!-- 사유코드 조회 -->
	<select id="RSNCDRSNCOD_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.RSNCOD AS VALUE_COL 
		      ,A.SHORTX AS TEXT_COL
		 FROM RSNCD A
		 WHERE 1=1
		 AND A.OWNRKY = #{OWNRKY}
		 <if test="DOCCAT != null and DOCCAT != ''">
		 AND A.DOCCAT = #{DOCCAT}
		 </if>
		 <if test="DOCUTY != null and DOCUTY != ''">
		 AND A.DOCUTY = #{DOCUTY}
		 </if>
		 <if test="PROGID == &quot;GR09&quot;">AND DOCCAT IN ('100')</if>
		 ORDER BY A.DOCCAT, A.DOCUTY, A.RSNCOD
	</select>	
	
	
	<select id="SELECT_ARVTYP_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
      		 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'ARVTYP', CMCDVL) AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'ARVTYP'
	</select>
	
	<select id="PltBcdChk_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) AS CNT
		  FROM BARCD
		 WHERE SUBSTR(BARCOD,0,10) = #{ASNDKY}
	</select>
	
	<select id="ASNDIT_LIST" parameterType="Map" resultType="DataMap">
		SELECT *
		  FROM ASNDI
		 WHERE ASNDKY = #{ASNDKY}
	</select>
	
	<select id="PltCount_MAP" parameterType="Map" resultType="DataMap">
		SELECT  AH.WAREKY 
		      , AI.ASNDKY
		      , AI.ASNDIT
		      , AI.SKUKEY
		      , AI.DESC01
		      , AI.MEASKY
		      , AI.QTYASN
		      , (SELECT QTPUOM
		           FROM MEASH MH
		                INNER JOIN MEASI MI
		                        ON MH.WAREKY = MI.WAREKY
		                       AND MH.MEASKY = MI.MEASKY
		          WHERE 1 = 1
		            AND MI.WAREKY = AH.WAREKY
		            AND MI.MEASKY = AI.MEASKY
		            AND MI.UOMKEY = 'PL'
		        ) AS QTPUOM
		      , TO_CHAR(CEIL(AI.QTYASN/( SELECT QTPUOM
		                                   FROM MEASH MH
		                                        INNER JOIN MEASI MI
		                                                ON MH.WAREKY = MI.WAREKY
		                                               AND MH.MEASKY = MI.MEASKY
		                                  WHERE 1 = 1
		                                    AND MI.WAREKY = AH.WAREKY
		                                    AND MI.MEASKY = AI.MEASKY
		                                    AND MI.UOMKEY = 'PL'
		                               )
		                    )
		               )AS PLTCNT
		      , TO_CHAR(MOD(AI.QTYASN,( SELECT QTPUOM
		                                  FROM MEASH MH
		                                       INNER JOIN MEASI MI
		                                               ON MH.WAREKY = MI.WAREKY
		                                              AND MH.MEASKY = MI.MEASKY
		                                 WHERE 1 = 1
		                                   AND MI.WAREKY = AH.WAREKY
		                                   AND MI.MEASKY = AI.MEASKY
		                                   AND MI.UOMKEY = 'PL'
		                              )
		                   ) 
		               ) AS QTYMOD
		FROM  ASNDI AI
			  INNER JOIN ASNDH AH
		              ON AH.ASNDKY = AI.ASNDKY
	   WHERE  1=1
		 AND  AI.ASNDKY = #{ASNDKY}
		 AND  AI.ASNDIT = #{ASNDIT}
	</select>
	
	<insert id="BARCD_INSERT" parameterType="Map">
		INSERT INTO BARCD 
		(
	    	 REFDKY
	        ,BARCOD
	        ,WAREKY
	        ,SKUKEY
	        ,DESC01
	        ,DESC02
	        ,PRTDAT
	        ,QTDUOM
	        ,QTDBOX
	        ,QTDREM
	        ,QTDPRT
	        ,CREDAT
	        ,CRETIM
	        ,CREUSR
	        ,LMODAT
	        ,LMOTIM
	        ,LMOUSR
            ,UPDCHK
	        ,LOTA05
	        ,LOTA02
	    )
	    VALUES
	    (
	         SEQ_BARCODE.NEXTVAL
	        ,#{BARCOD}
	        ,#{WAREKY}
	        ,#{SKUKEY} 
	        ,NVL(#{DESC01}, ' ')
	        ,NVL(#{DESC02}, ' ')
	        ,TO_CHAR(SYSDATE,'YYYYMMDD')
	        ,NVL(#{QTDUOM}, 0)
	        ,NVL(#{QTDBOX}, 0)
	        ,NVL(#{QTDREM}, 0)
	        ,NVL(#{QTDPRT}, 0)
	        ,TO_CHAR(SYSDATE,'YYYYMMDD')
	        ,TO_CHAR(SYSDATE,'HH24MISS')
	        ,#{SES_USER_ID}
	        ,TO_CHAR(SYSDATE,'YYYYMMDD')
	        ,TO_CHAR(SYSDATE,'HH24MISS')
	        ,#{SES_USER_ID}
	        ,0
	        ,' '
	        ,' '
	      )
	</insert>
	
	
	<!-- GR98 SQL START -->
	
	<select id="GR98_MAP" parameterType="Map" resultType="DataMap">
		SELECT (SELECT LM.AREAKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC ) AS AREAKY
		     , (SELECT LM.ZONEKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC ) AS ZONEKY
		     , DT.SYSLOC AS LOCAKY
		FROM DUAL A
		  LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = '199'
	</select>
	
	<delete id="saveGR98EXCEL_DELETE" parameterType="Map">
		DELETE FROM TMP_STK WHERE WAREKY = #{WAREKY} AND PRCFLG = 'N'
	</delete>
	
	<insert id="saveGR98EXCEL_INSERT" parameterType="Map">
		INSERT INTO TMP_STK
	    (
	       WAREKY
         , SKUKEY
         , UOMKEY
         , QTYRCV
         , AREAKY
         , ZONEKY
         , LOCAKY
         , PTNRTY
         , DPTNKY
         , LOTA01
         , LOTA02
         , LOTA03
         , LOTA04
         , LOTA05
         , LOTA06
         , LOTA07
         , LOTA08
         , LOTA09
         , LOTA10
         , LOTA11
         , LOTA12
         , LOTA13
         , LOTA14
         , LOTA15
         , LOTA16
         , LOTA17
         , LOTA18
         , LOTA19
         , LOTA20
         , LOTA21
         , LOTA22
         , LOTA23
         , LOTA24
	     , LOTA41
	     , LOTA42
	     , PRCFLG
	    )
	    VALUES
	    (
	       #{WAREKY}
         , #{SKUKEY}
         , #{UOMKEY}
         , #{QTYRCV}
         , NVL(#{AREAKY},' ')
         , NVL(#{ZONEKY},' ')
         , NVL(#{LOCAKY},' ')
         , NVL(#{PTNRTY},' ')
         , NVL(#{DPTNKY},' ')
         , NVL(#{LOTA01},' ')
         , NVL(#{LOTA02},' ')
         , NVL(#{LOTA03},' ')
         , NVL(#{LOTA04},' ')
         , NVL(#{LOTA05},' ')
         , NVL(#{LOTA06},' ')
         , NVL(#{LOTA07},' ')
         , NVL(#{LOTA08},' ')
         , NVL(#{LOTA09},' ')
         , NVL(#{LOTA10},' ')
         , NVL(#{LOTA11},' ')
         , NVL(#{LOTA12},' ')
         , NVL(#{LOTA13},' ')
         , NVL(#{LOTA14},' ')
         , NVL(#{LOTA15},' ')
         , NVL(TRIM(#{LOTA16}),0)
         , NVL(TRIM(#{LOTA17}),' ')
         , NVL(TRIM(#{LOTA18}),0)
         , NVL(TRIM(#{LOTA19}),0)
         , NVL(TRIM(#{LOTA20}),0)
         , NVL(TRIM(#{LOTA21}),0)
         , NVL(TRIM(#{LOTA22}),0)
         , NVL(TRIM(#{LOTA23}),0)
         , NVL(TRIM(#{LOTA24}),0)
	     , NVL(#{LOTA41},' ')
	     , NVL(#{LOTA42},' ')
	     , 'N'
	    )
	</insert>
	
	<insert id="saveGR98EXCELBatch_INSERT" parameterType="Map">
		INSERT INTO TMP_STK 
		(
			   WAREKY, SKUKEY, UOMKEY, QTYRCV, AREAKY
	         , ZONEKY, LOCAKY, PTNRTY, DPTNKY, LOTA01
	         , LOTA02, LOTA03, LOTA04, LOTA05, LOTA06
	         , LOTA07, LOTA08, LOTA09, LOTA10, LOTA11
	         , LOTA12, LOTA13, LOTA14, LOTA15, LOTA16
	         , LOTA17, LOTA18, LOTA19, LOTA20, PRCFLG
	         , CREDAT, CRETIM, CREUSR, LMODAT, LMOTIM
	         , LMOUSR, PALQTY, LOTA21, LOTA22, LOTA23
	         , LOTA24, LOTA41, LOTA42
		) 
		<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
			SELECT  #{item.WAREKY, jdbcType=VARCHAR} AS WAREKY, #{item.SKUKEY, jdbcType=VARCHAR} AS SKUKEY, #{item.UOMKEY, jdbcType=VARCHAR} AS UOMKEY, #{item.QTYRCV, jdbcType=VARCHAR} AS QTYRCV, NVL(#{item.AREAKY, jdbcType=VARCHAR},' ') AS AREAKY
                  , NVL(#{item.ZONEKY, jdbcType=VARCHAR},' ') AS ZONEKY, NVL(#{item.LOCAKY, jdbcType=VARCHAR},' ') AS LOCAKY, NVL(#{item.PTNRTY, jdbcType=VARCHAR},' ') AS PTNRTY, NVL(#{item.DPTNKY, jdbcType=VARCHAR},' ') AS DPTNKY, NVL(#{item.LOTA01, jdbcType=VARCHAR},' ') AS LOTA01
                  , NVL(#{item.LOTA02, jdbcType=VARCHAR},' ') AS LOTA02, NVL(#{item.LOTA03, jdbcType=VARCHAR},' ') AS LOTA03, NVL(#{item.LOTA04, jdbcType=VARCHAR},' ') AS LOTA04, NVL(#{item.LOTA05, jdbcType=VARCHAR},' ') AS LOTA05, NVL(#{item.LOTA06, jdbcType=VARCHAR},' ') AS LOTA06
                  , NVL(#{item.LOTA07, jdbcType=VARCHAR},' ') AS LOTA07, NVL(#{item.LOTA08, jdbcType=VARCHAR},' ') AS LOTA08, NVL(#{item.LOTA09, jdbcType=VARCHAR},' ') AS LOTA09, NVL(#{item.LOTA10, jdbcType=VARCHAR},' ') AS LOTA10, NVL(#{item.LOTA11, jdbcType=VARCHAR},' ') AS LOTA11
                  , NVL(#{item.LOTA12, jdbcType=VARCHAR},' ') AS LOTA12, NVL(#{item.LOTA13, jdbcType=VARCHAR},' ') AS LOTA13, NVL(#{item.LOTA14, jdbcType=VARCHAR},' ') AS LOTA14, NVL(#{item.LOTA15, jdbcType=VARCHAR},' ') AS LOTA15, NVL(TRIM(#{item.LOTA16, jdbcType=VARCHAR}),0) AS LOTA16
                  , NVL(TRIM(#{item.LOTA17, jdbcType=VARCHAR}),' ') AS LOTA17, NVL(TRIM(#{item.LOTA18, jdbcType=VARCHAR}),0) AS LOTA18, NVL(TRIM(#{item.LOTA19, jdbcType=VARCHAR}),0) AS LOTA19, NVL(TRIM(#{item.LOTA20, jdbcType=VARCHAR}),0) AS LOTA20, 'N' AS PRCFLG
                  , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, #{item.SES_USER_ID, jdbcType=VARCHAR} AS CREUSR,TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT,TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM 
                  , NVL(#{item.SES_USER_ID, jdbcType=VARCHAR},' ') AS LMOUSR, NVL(TRIM(#{item.PALQTY, jdbcType=VARCHAR}),0) AS PALQTY, NVL(#{item.LOTA21, jdbcType=VARCHAR},' ') AS LOTA21, NVL(#{item.LOTA22, jdbcType=VARCHAR},' ') AS LOTA22, NVL(#{item.LOTA23, jdbcType=VARCHAR},' ') AS LOTA23
                  , NVL(#{item.LOTA24, jdbcType=VARCHAR},' ') AS LOTA24, NVL(#{item.LOTA41, jdbcType=VARCHAR},' ') AS LOTA41, NVL(#{item.LOTA42, jdbcType=VARCHAR},' ') AS LOTA42
 			 FROM DUAL 
		</foreach>
		
	</insert>
	
	<insert id="saveGR98RcvLBatch_INSERT" parameterType="Map">
		INSERT INTO TMP_STK_RCV
		(
			   SEQNUM, RECVKY, RECVIT, CREDAT, CRETIM, 
			   CREUSR, LMODAT, LMOTIM, LMOUSR
		) 
		<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
			SELECT  #{item.SEQNUM, jdbcType=VARCHAR} AS SEQNUM, #{item.RECVKY, jdbcType=VARCHAR} AS RECVKY, #{item.RECVIT, jdbcType=VARCHAR} AS RECVIT, TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM
                  , #{item.SES_USER_ID, jdbcType=VARCHAR} AS CREUSR,TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT,TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM, #{item.SES_USER_ID, jdbcType=VARCHAR} AS LMOUSR
 			 FROM DUAL 
		</foreach>
		
	</insert>
	
	<select id="GR98_LIST" parameterType="Map" resultType="DataMap">
		SELECT ' ' AS RECVKY
			 , TMP.WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TMP.WAREKY),' ') AS WARENM
		     , TMP.LOTA02
		     , SZF_GET_CMCDV_CDESC1_TEXT('KR', 'LOTA02', TMP.LOTA02) AS LOTA02NM
		     , TMP.PRCFLG
		     , TMP.DOCDAT AS DOCDAT_ORG
		     , ( CASE WHEN TMP.PRCFLG = 'Y' THEN TMP.DOCDAT ELSE F_SET_DATE(SYSDATE) END ) AS DOCDAT
		     , #{OWNRKY} AS OWNRKY
		     , '100' AS DOCCAT
		     , SZF_GET_DOCCAT_TEXT('KR', '100') AS DOCCATNM
		     , '199' AS DOCUTY
		     , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = '199'),' ') AS DOCUTYNM
		     , 'NEW' AS STATDO
		     , SZF_GET_CMCDV_CDESC1_TEXT('KR', 'STATDO', 'NEW') AS STATDONM
		     , ( CASE WHEN TMP.PRCFLG = 'Y' THEN TMP.DOCTXT ELSE '기초재고셋업' END ) AS DOCTXT
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS ASNDAT
		     , COUNT(TMP.WAREKY) AS CNT
		     , SUM(TMP.QTYRCV) AS QTYRCV
		     , TMP.PRCFLG
		FROM TMP_STK TMP
		WHERE 1=1
		  <if test="WAREKY != null and WAREKY != ''">
		    AND TMP.WAREKY = #{WAREKY}
		  </if>
		  <if test="PRCFLG != null and PRCFLG != ''">
		    AND TMP.PRCFLG = #{PRCFLG}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		  </if>
		GROUP BY TMP.WAREKY, TMP.LOTA02, TMP.PRCFLG, TMP.DOCDAT, TMP.DOCTXT
		ORDER BY TMP.WAREKY, DECODE(TMP.PRCFLG, 'N', 1, 2), TMP.DOCDAT DESC, TMP.LOTA02
	</select>
	
	<select id="GR98_LIST_20220413" parameterType="Map" resultType="DataMap">
		SELECT ' ' AS RECVKY
		     , TMP.WAREKY
		     , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TMP.WAREKY),' ') AS WARENM
		     , #{OWNRKY} AS OWNRKY
		     , (SELECT NAME01 FROM OWNER WHERE OWNRKY = #{OWNRKY}) AS OWNRNM
		     , ( CASE WHEN PRCFLG = 'Y' THEN TMP.DOCDAT ELSE TO_CHAR(SYSDATE,'YYYYMMDD') END ) AS DOCDAT
		     , '100' AS DOCCAT
		     , SZF_GET_DOCCAT_TEXT(#{LANGKY}, '100') AS DOCCATNM
		     , '199' AS DOCUTY
		     , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = '199'),' ') AS DOCUTYNM
		     , 'NEW' AS STATDO
		     , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', 'NEW') AS STATDONM
		     , ( CASE WHEN PRCFLG = 'Y' THEN TMP.DOCTXT ELSE '기초재고셋업' END ) AS DOCTXT
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS ASNDAT
		     , TMP.PTNRTY
		     , TMP.DPTNKY
		     , BZ.NAME01 AS DPTNNM
		     , COUNT(TMP.WAREKY) AS CNT
		     , SUM(TMP.QTYRCV) AS QTYRCV
		     , TMP.PRCFLG
		  FROM TMP_STK TMP
		    LEFT OUTER JOIN BZPTN BZ ON BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRKY = TMP.DPTNKY AND BZ.PTNRTY = TMP.PTNRTY 
		  WHERE 1=1
		    <if test="WAREKY != null and WAREKY != ''">
		    AND TMP.WAREKY = #{WAREKY}
		    </if>
		    <if test="PRCFLG != null and PRCFLG != ''">
		    AND TMP.PRCFLG = #{PRCFLG}
		    </if>
		    <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
			</if>
		  GROUP BY TMP.WAREKY, TMP.PTNRTY, TMP.DPTNKY, BZ.NAME01, TMP.PRCFLG, TMP.DOCDAT, TMP.DOCTXT
		  ORDER BY TMP.WAREKY, DECODE(TMP.PRCFLG, 'N', 1, 2), TMP.DOCDAT DESC, TMP.LOTA02, TMP.PTNRTY, TMP.DPTNKY
	</select>
	
	
	<select id="GR98Head_LIST" parameterType="Map" resultType="DataMap">
		SELECT TMP.WAREKY
			 , #{OWNRKY} AS OWNRKY
		     , TMP.LOTA02
		     , TMP.PTNRTY
		     , TMP.DPTNKY
		     , NVL(TRIM(#{DOCDAT}),TO_CHAR(SYSDATE,'YYYYMMDD')) AS DOCDAT
		     , '100' AS DOCCAT
		     , '199' AS RCPTTY
		     , 'NEW' AS STATDO
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS ASNDAT
		     , SZF_GETDOCNUMBER('199') AS RECVKY
		FROM TMP_STK TMP
		WHERE 1=1
		  AND TMP.WAREKY = #{WAREKY}
		  AND TMP.LOTA02 = #{LOTA02}
		  AND TMP.PRCFLG = #{PRCFLG}
		GROUP BY TMP.WAREKY, TMP.LOTA02, TMP.PTNRTY, TMP.DPTNKY
		ORDER BY TMP.WAREKY, TMP.LOTA02, TMP.PTNRTY, TMP.DPTNKY
	</select>
	
	<select id="GR98Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT TMP.SEQNUM
		     , TMP.WAREKY
             , TMP.SKUKEY
             , TMP.UOMKEY
             , TMP.QTYRCV
             , TMP.QTYRCV AS QTYRCV1
             , NVL(TRIM(SZF_GET_DEFAULT_QTY(TMP.WAREKY, TMP.SKUKEY, TMP.QTYRCV, TMP.UOMKEY)),'0.000') AS UOMQTY
             , TMP.AREAKY
             , TMP.ZONEKY
             , TMP.LOCAKY
             , TMP.PTNRTY
             , TMP.DPTNKY
             , TMP.LOTA01
             , TMP.LOTA02
             , TMP.LOTA03
             , TMP.LOTA04
             , TMP.LOTA05
             , TMP.LOTA06
             , TMP.LOTA07
             , TMP.LOTA08
             , TMP.LOTA09
             , TMP.LOTA10
             , TMP.LOTA11
             , TMP.LOTA12
             , TMP.LOTA13
             , TMP.LOTA14
             , TMP.LOTA15
             , TMP.LOTA16
             , TMP.LOTA17
             , TMP.LOTA18
             , TMP.LOTA19
             , TMP.LOTA20
             , TMP.LOTA21
             , TMP.LOTA22
             , TMP.LOTA23
             , TMP.LOTA24
	         , TMP.PRCFLG
	         , 'FRV' AS STATIT
	         , SM.DESC01 
		     , SM.DESC02
			 , SM.SKUG01
			 , SM.SKUG02
			 , SM.SKUG03
			 , SM.SKUG04
			 , SM.SKUG05
			 , SM.SKUG05 AS SKUG05_1
			 , SM.ASKU05
			 , SM.EANCOD
			 , ' ' AS SEBELN
		     , ' ' AS SEBELP
		     , MI.UOMKEY AS MUOMKEY
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS ASNDAT
		     , ( CASE WHEN NVL(TMP.PALQTY,0)=0 THEN NVL(MIP.QTPUOM,'0.000') ELSE TMP.PALQTY END ) AS PALQTY 
		     , '199' AS RCPTTY
		FROM TMP_STK TMP
		  INNER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = TMP.SKUKEY
<!-- 		  INNER JOIN LOCMA LM ON LM.WAREKY = TMP.WAREKY AND LM.LOCAKY = TMP.LOCAKY -->
<!-- 		  INNER JOIN ZONMA ZM ON ZM.WAREKY = TMP.WAREKY AND ZM.ZONEKY = LM.ZONEKY -->
<!-- 		  INNER JOIN AREMA AM ON AM.WAREKY = TMP.WAREKY AND AM.AREAKY = LM.AREAKY -->
		  LEFT OUTER JOIN MEASI MI ON MI.WAREKY = TMP.WAREKY AND MI.MEASKY = TMP.SKUKEY AND MI.INDDFU = 'V'
		  LEFT OUTER JOIN MEASI MIP ON MIP.WAREKY = TMP.WAREKY AND MIP.MEASKY = TMP.SKUKEY AND MIP.UOMKEY = 'PAL'
		WHERE TMP.WAREKY = #{WAREKY}
		  AND TMP.LOTA02 = #{LOTA02}
		  AND TMP.PTNRTY = #{PTNRTY}
		  AND TMP.DPTNKY = #{DPTNKY}
		  AND TMP.PRCFLG = 'N'
		ORDER BY TMP.SEQNUM
	</select>
	
	<select id="SAVE_GR98_PROC_CALL_MAP" parameterType="HashMap" resultType="HashMap" statementType="CALLABLE">
         { call P_AIRWMS_SAVE_GR98 (
         								#{OWNRKY,      mode=IN,  jdbcType=VARCHAR},
						                #{WAREKY,      mode=IN,  jdbcType=VARCHAR},
						                #{LOTA02,      mode=IN,  jdbcType=VARCHAR},
						                #{DOCDAT,      mode=IN,  jdbcType=VARCHAR},
						                #{DOCTXT,      mode=IN,  jdbcType=VARCHAR},
						                #{SES_USER_ID, mode=IN,  jdbcType=VARCHAR},
						                #{ERRORCODE,   mode=OUT, jdbcType=VARCHAR},
						                #{ERRORMESG,   mode=OUT, jdbcType=VARCHAR}
						           )
         }
    </select>
	
	<update id="GR98_UPDATE" parameterType="Map">
		UPDATE TMP_STK
		   SET PRCFLG = 'Y'
		     , DOCDAT = #{DOCDAT}
		     , DOCTXT = #{DOCTXT}
		WHERE PRCFLG = 'N'
		  AND WAREKY = #{WAREKY}
		  AND TMP.LOTA02 = #{LOTA02}
	</update>
	
	
	<insert id="GR98Batch_INSERT" parameterType="Map">
		UPDATE TMP_STK TS SET TS.PRCFLG = 'Y'
		                    , TS.LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
		                    , TS.LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
		                    , TS.LMOUSR = (
											 SELECT DISTINCT X.SES_USER_ID
											 FROM (
													<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
														SELECT  #{item.SES_USER_ID, jdbcType=VARCHAR} AS SES_USER_ID
											 			 FROM DUAL 
													</foreach>
												  ) X
		                                   )
		                    , TS.DOCDAT = (
											 SELECT DISTINCT NVL(X.DOCDAT,TO_CHAR(SYSDATE,'YYYYMMDD'))
											 FROM (
													<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
														SELECT  #{item.SEQNUM, jdbcType=VARCHAR} AS SEQNUM
														      , #{item.DOCDAT, jdbcType=VARCHAR} AS DOCDAT
											 			 FROM DUAL 
													</foreach>
												  ) X
											 WHERE X.SEQNUM = TS.SEQNUM 	  
		
		                                   )
		                    , TS.DOCTXT = (
											 SELECT DISTINCT X.DOCTXT
											 FROM (
													<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
														SELECT  #{item.SEQNUM, jdbcType=VARCHAR} AS SEQNUM
														      , #{item.DOCTXT, jdbcType=VARCHAR} AS DOCTXT
											 			 FROM DUAL 
													</foreach>
												  ) X
											 WHERE X.SEQNUM = TS.SEQNUM 	  
		
		                                   )
		                    , TS.RECVKY = (
											 SELECT DISTINCT X.RECVKY
											 FROM (
													<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
														SELECT  #{item.SEQNUM, jdbcType=VARCHAR} AS SEQNUM
														      , #{item.RECVKY, jdbcType=VARCHAR} AS RECVKY
											 			 FROM DUAL 
													</foreach>
												  ) X
											 WHERE X.SEQNUM = TS.SEQNUM 	  
		
		                                   )
			                                   
		WHERE EXISTS (
						 SELECT 'X'
						 FROM (
								<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
									SELECT  #{item.SEQNUM, jdbcType=VARCHAR} AS SEQNUM
						 			 FROM DUAL 
								</foreach>
							  ) X
						 WHERE X.SEQNUM = TS.SEQNUM 	  
		             )
		
	</insert>
	
	<delete id="GR98_DELETE" parameterType="Map">
		DELETE FROM TMP_STK WHERE WAREKY = #{WAREKY} AND LOTA02 = #{LOTA02} AND PRCFLG = 'N'
	</delete>
	
	<!-- GR98 SQL START -->
	
	
	<!-- GR99 SQL START -->
	<!-- GR99 Main Page -->
	<select id="GR99_LIST" parameterType="Map" resultType="DataMap">
		WITH TBL01 AS (
			SELECT T1.PROGID
			     , T1.DOCCAT 
			     , T1.DOCUTY 
			FROM DOCPG T1
			WHERE T1.PROGID=#{PROGID}
			  AND ROWNUM=1
		)
		SELECT ' ' AS RECVKY
			 , #{WAREKY} AS WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM
			 , NVL(#{OWNRKY},' ') AS OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = NVL(#{OWNRKY},' ')),' ') AS OWNRNM
			 , F_SET_DATE(SYSDATE) AS DOCDAT
			 , (SELECT X.DOCCAT FROM TBL01 X) AS DOCCAT
			 , SZF_GET_DOCCAT_TEXT(#{LANGKY}, (SELECT X.DOCCAT FROM TBL01 X)) AS DOCCATNM
			 , (SELECT X.DOCUTY FROM TBL01 X) AS DOCUTY
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, (SELECT X.DOCUTY FROM TBL01 X)) AS DOCUTYNM
			 , 'NEW' AS STATDO
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', 'NEW') AS STATDONM
			 , ' ' AS DOCTXT
			 , ' ' AS PTNRTY
			 , ' ' AS DPTNKY
		     , ' ' AS DPTNKYNM
		     , 'V' AS SAPIFYN
		     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS ASNDAT
		     , 'WMS_IF_219' AS IFID
		     , 'WMS_IF_219' AS IFID_SAP -- 실적IFID_SAP
			 , #{OWNRKY} AS OWNRKY
			 , ' ' AS SEBELN
			 , '199' AS RCPTTY 
		FROM DUAL
	</select>
	
	<select id="GR99Sub_LIST" parameterType="Map" resultType="DataMap">
		
		WITH TBL01 AS (
			SELECT T1.PROGID
			     , T1.DOCCAT 
			     , T1.DOCUTY 
			FROM DOCPG T1
			WHERE T1.PROGID=#{PROGID}
			  AND ROWNUM=1
		)
		SELECT #{WAREKY} AS WAREKY
		     , #{OWNRKY} AS OWNRKY 
		     , ' ' AS LOTA01    -- 저장위치
		     , ''  AS LOTA01NM  -- 저장위치명
		     , ' ' AS LOTA02    -- 플랜트
		     , ' ' AS LOTA03    -- 포장타입(PS)
		     , ' ' AS LOTA04    -- 호기
		     , ' ' AS LOTA05    -- 
		     , '00' AS LOTA06   -- 재고상태
		     , ' ' AS LOTA07    -- 주문번호(10)+아이템번호(6)MTO
		     , ' ' AS LOTA08    -- 국가코드
		     , ' ' AS LOTA09    -- 판매처
		     , ' ' AS LOTA10    -- 보류사유명
		     , ' ' AS LOTA11    -- 제조일자
		     , ' ' AS LOTA12    -- 입고일자
		     , ' ' AS LOTA13    -- 입고일자
		     , ' ' AS LOTA14    -- 입고제조 LOT
		     , ' ' AS LOTA15    -- LOT번호
		     , ' ' AS LOTA16    -- 평량
		     , ' ' AS LOTA17    -- 컨테이너유형
		     , ' ' AS LOTA20
		     
		     , ' ' AS LOTA21
		     , ' ' AS LOTA22
		     , ' ' AS LOTA23
		     , ' ' AS LOTA24
		     
		     , (SELECT LM.AREAKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC ) AS AREAKY
		     , NVL((SELECT SHORTX FROM AREMA AM WHERE AM.WAREKY = #{WAREKY} AND AM.AREAKY = (SELECT LM.AREAKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC )),' ') AS AREANM
		     , (SELECT LM.ZONEKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC ) AS ZONEKY
		     , DT.SYSLOC AS LOCAKY
		     , ' ' AS SKUKEY
		     , ' ' AS DESC01
		     , ' ' AS DESC02
		     , ' ' AS UOMKEY 
		     , ' ' AS MUOMKEY
		     , '0.000' AS QTYRCV
		     , '999' AS RSNCOD
		     , ' ' AS RCPRSN
		     , ' ' AS SKUL05
		     , ' ' AS ASKU01
		     , '1' AS EXCELDOWN
		     , '0.000' AS TOT
		     , '0.000' AS BAG
		     , '0.000' AS BOX
		     , '0.000' AS PLT
		     , '0.000' AS SOK
		     , '0.000' AS EA
		     , '0.000' AS BOXBAG
		     , ' ' AS SKUG01
		     , ' ' AS SKUG02
		     , ' ' AS SKUG03
		     , ' ' AS SKUG04
		     , ' ' AS SKUG05
		     , ' ' AS SKUG05_1
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS ASNDAT
		     , ' ' AS SEBELN
		     , ' ' AS SEBELP
		     , '0.000' AS UOMQTY
		     , 'FRV' AS STATIT
		     , ' ' AS PTNRTY
		     , '0' AS MENGE
		     , ' ' AS WMSMAK
		     , 'WMS_IF_219' AS IFID_SAP -- 실적IFID_SAP
		     , ' ' AS SALENO
		     , ' ' AS SKUNUM
		     , ' ' AS RECVKY
		FROM DUAL A
		  LEFT OUTER JOIN DOCTM DT ON EXISTS (
		                                       SELECT 'X' 
		                                       FROM TBL01 X
		                                       WHERE X.DOCUTY=DT.DOCUTY
		                                     )
	</select>
	
	<!-- 재고실사입고 (GROUP BY 처리필요 RECDI 중복 ROW) -->
	<select id="GR99KYHTESTSub_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			PI.QTYPDA
			,DECODE(PI.LOTA11, ' ',TO_CHAR(SYSDATE,'YYYYMMDD'), PI.LOTA11) AS LOTA11
			--,DECODE(PI.LOTA15, ' ',RE.LOTA15, PI.LOTA15) AS LOTA15
			
			, (CASE WHEN PI.LOTA15 = ' ' 
					THEN (SELECT MAX(LOTA15) FROM RECDI RE WHERE PI.LOTA14 = RE.LOTA14) 
					ELSE PI.LOTA15 
				END) AS LOTA15 
			, ' ' AS RCPRSN
		     , ' ' AS SKUL05
		     , ' ' AS ASKU01
		     , '1' AS EXCELDOWN
		     , '0.000' AS TOT
		     , '0.000' AS BAG
		     , '0.000' AS BOX
		     , '0.000' AS PLT
		     , '0.000' AS SOK
		     , '0.000' AS EA
		     , '0.000' AS BOXBAG
		     , ' ' AS SKUG01
		     , ' ' AS SKUG02
		     , ' ' AS SKUG03
		     , ' ' AS SKUG04
		     , ' ' AS SKUG05
		     , ' ' AS SKUG05_1
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS ASNDAT
		     , ' ' AS SEBELN
		     , ' ' AS SEBELP
		     , '0.000' AS UOMQTY
		     , 'FRV' AS STATIT
		     , ' ' AS PTNRTY
		     , '0' AS MENGE
		     , ' ' AS WMSMAK
		     , 'WMS_IF_219' AS IFID_SAP -- 실적IFID_SAP
		     , ' ' AS SALENO
		     , ' ' AS SKUNUM
		     , ' ' AS RECVKY
		     , ' ' AS SEBELN
		     , ' ' AS SEBELP
		     , NVL(SLM.WMSMAK, ' ') AS WMSMAK
			,'00' AS LOTA06   -- 재고상태
			,PI.QTYPDA AS QTYRCV	-- 입고수량
			, NVL(SM.DUOMKY, 'BAG')	AS UOMKEY
			, 'ETC' AS AREAKY
			, 'ETCLOC' AS LOCAKY
			--,PI.* 
			,PI.LOTA02
			,PI.LOTA01
			,PI.LOTA11 
			,PI.LOTA14 
			,' ' AS STLNM
			,PI.SKUKEY
			,PI.DESC01 
			, ' ' AS DESC02 
		FROM PHYDH PH                  
		INNER JOIN PHYDI PI ON (PI.PHYIKY = PH.PHYIKY )
		-- LEFT JOIN RECDI RE ON (PI.LOTA14 = RE.LOTA14) 
		LEFT JOIN SKUMA SM ON SM.OWNRKY = PI.OWNRKY AND SM.SKUKEY = PI.SKUKEY AND SM.MTYPE LIKE '%' || '%'
		LEFT JOIN STLMA SLM ON (SLM.OWNRKY = PI.OWNRKY AND SLM.PLNTKY = PI.LOTA02 AND SLM.STLKY  = PI.LOTA01)
		WHERE 1 = 1              
		AND PH.PHYIKY = '5000000279' 
		AND (PH.INDDCL  = 'V' OR PI.REFCAT  = 'V') AND PI.QTYPDA != PI.QTSIWH /* 실사차이 */ 
		AND PI.LOTA15 = ' '	/* STKKY 미존재인 CASE (RECDI만 내역존재) */
		AND ROWNUM = 1
	</select>
	
	<select id="GR99_SKUG04COMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT USARG1 AS VALUE_COL,
		       CDESC2 AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'SKUG05'
		 ORDER BY CMCDVL
	</select>
	
	<select id="GR99_OWNRNM_MAP" parameterType="Map" resultType="DataMap">
		SELECT NAME01 AS OWNRNM
		  FROM OWNER
		 WHERE OWNRKY = #{OWNRKY}
	</select>
	
	<select id="GR99_DOCUTYNM_MAP" parameterType="Map" resultType="DataMap">
		SELECT SZF_GET_DOCUTY_TEXT(#{LANGKY}, DOCUTY) AS DOCUTYNM
		  FROM DOCPG
		 WHERE PROGID = #{PROGID}
		   AND DOCUTY = #{DOCUTY}
	</select>
	
	<select id="GR99_DPTNKYNM_MAP" parameterType="Map" resultType="DataMap">
		SELECT NAME01 AS DPTNKYNM
		  FROM BZPTN
		 WHERE PTNRTY = #{PTNRTY}
		   AND OWNRKY = #{OWNRKY}
		   AND PTNRKY = #{DPTNKY}
	</select>
	
	<select id="GR99_ADDROW_MAP" parameterType="Map" resultType="DataMap">
		SELECT AREAKY
		     , ZONEKY
		     , LOCAKY
		  FROM LOCMA
		 WHERE LOCAKY = NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = #{DOCUTY}),' ')
		   AND WAREKY = #{WAREKY}
	</select>
	
	<select id="GR99_SKUINFO_MAP" parameterType="Map" resultType="DataMap">
		SELECT SM.DESC01
		     , SM.DESC02
		     , SM.DUOMKY AS UOMKEY
		     , SM.SKUL05
		     , SM.ASKU01
		     , SM.ASKL02
		     , SM.ASKL03
		     , SM.LOTL20
		     , SM.SKUG01
		     , SM.SKUG02
		     , SM.SKUG03
<!-- 		     , SM.SKUG04 -->
		     , SM.SKUG05
		     , SG05.CDESC1 AS SKUG04NM
             , NVL(SG05.USARG1,SM.SKUG04) AS SKUG04
		FROM SKUMA SM
		  LEFT OUTER JOIN CMCDV SG05
                       ON SG05.CMCDKY = 'SKUG05'
                      AND SG05.CMCDVL = SM.SKUG05
		WHERE SM.SKUKEY = #{SKUKEY}
		  AND SM.OWNRKY = #{OWNRKY}
	</select>
	
	<select id="GR99_SKUG05_MAP" parameterType="Map" resultType="DataMap">
		SELECT SG05.CDESC1 AS SKUG04NM
             , SG05.USARG1 AS SKUG04
		FROM CMCDV SG05
		WHERE SG05.CMCDKY = 'SKUG05'
          AND SG05.CMCDVL = #{SKUG05}
	</select>
	
	<select id="GR99_STLKYINFO_MAP" parameterType="Map" resultType="DataMap">
		SELECT SLM.OWNRKY
			 , SLM.PLNTKY
			 , SLM.STLKY
			 , SLM.STLNM
			 , SLM.WMSMAK
		FROM STLMA SLM
		WHERE SLM.OWNRKY = #{OWNRKY}
		  AND SLM.PLNTKY = #{LOTA02}
		  AND SLM.STLKY  = #{LOTA01}
	</select>
	
	<!-- GR99 Save -->
	<insert id="GR99_INSERT" parameterType="Map">
		INSERT INTO RECDH
		(
		    RECVKY
		  , WAREKY
		  , RCPTTY
		  , STATDO
		  , SAPSTS
		  , DOCDAT
		  , DOCCAT
		  , VENDOR
		  , RTNPTN
		  , TRNWAH
		  , DRELIN
		  , ASNDAT
		  , ARCPTD
		  , OWNRKY
		  , INDRCN
		  , CRECVD
		  , RSNCOD
		  , PUTSTS
		  , USRID1, UNAME1, DEPTID1, DNAME1
		  , USRID2, UNAME2, DEPTID2, DNAME2
		  , USRID3, UNAME3, DEPTID3, DNAME3
		  , USRID4, UNAME4, DEPTID4, DNAME4
		  , DOCTXT
		  , CREDAT, CRETIM, CREUSR
		  , LMODAT, LMOTIM, LMOUSR
		  , INDBZL, INDARC, UPDCHK, KEEPTS
		)
		VALUES(
		          NVL(#{RECVKY},' ')
		        , NVL(#{WAREKY},' ')
		        , NVL(#{RCPTTY},' ')
		        , NVL(#{STATDO},' ')
		        , NVL(#{SAPSTS},' ')
		        , NVL(#{DOCDAT},' ')
		        , NVL(#{DOCCAT},' ')
		        , NVL(#{VENDOR},' ')
		        , NVL(#{RTNPTN},' ')
		        , NVL(#{TRNWAH},' ')
		        , NVL(#{DRELIN},' ')
		        , NVL(#{ASNDAT},' ')
		        , NVL(#{ARCPTD},' ')
		        , NVL(#{OWNRKY},' ')
		        , NVL(#{INDRCN},' ')
		        , NVL(#{CRECVD},' ')
		        , NVL(#{RSNCOD},' ')
		        , NVL(#{PUTSTS},' ')
		        , NVL(#{USRID1},' '), NVL(#{UNAME1},' '), NVL(#{DEPTID1},' '), NVL(#{DNAME1},' ')
		        , NVL(#{USRID2},' '), NVL(#{UNAME2},' '), NVL(#{DEPTID2},' '), NVL(#{DNAME2},' ')
		        , NVL(#{USRID3},' '), NVL(#{UNAME3},' '), NVL(#{DEPTID3},' '), NVL(#{DNAME3},' ')
		        , NVL(#{USRID4},' '), NVL(#{UNAME4},' '), NVL(#{DEPTID4},' '), NVL(#{DNAME4},' ')
		        , NVL(#{DOCTXT},' ')
		        , TO_CHAR(SYSDATE,'YYYYMMDD'),TO_CHAR(SYSDATE,'HH24MISS'),  #{SES_USER_ID}
		        , TO_CHAR(SYSDATE,'YYYYMMDD'),TO_CHAR(SYSDATE,'HH24MISS'),  #{SES_USER_ID}
		        , NVL(#{INDBZL},' '), NVL(#{INDARC},' '), NVL(#{UPDCHK}, 0), NVL(#{KEEPTS},' ')
		      )
	</insert>
	
	<!-- GR99 Save List -->
	<select id="GR99ReHead_LIST" parameterType="Map" resultType="DataMap">
		SELECT RH.RECVKY
		     , RH.WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = RH.WAREKY),' ') AS WARENM
		     , RH.OWNRKY, NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = RH.OWNRKY),' ') AS OWNRNM
		     , RH.DOCDAT
		     , RH.DOCCAT, SZF_GET_DOCCAT_TEXT(#{LANGKY}, RH.DOCCAT) AS DOCCATNM
		     , RH.RCPTTY AS DOCUTY, SZF_GET_DOCUTY_TEXT(#{LANGKY}, RH.RCPTTY) AS DOCUTYNM
		     , RH.STATDO, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', RH.STATDO) AS STATDONM
		     , RH.DOCTXT
		     , RH.DPTNKY
		     , NVL((SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'VD' AND OWNRKY = RH.OWNRKY AND PTNRKY = RH.DPTNKY),' ') AS DPTNKYNM
		     , RH.PTNRTY
		     , #{SAPIFYN} AS SAPIFYN
		  FROM RECDH RH
		 WHERE RH.RECVKY = #{RECVKY}
	</select>
	
	<select id="GR99ReSub_LIST" parameterType="Map" resultType="DataMap">
		SELECT RI.AREAKY
<!-- 		     , NVL((SELECT ZONEKY FROM ZONMA WHERE AREAKY = RI.AREAKY AND WAREKY = #{WAREKY}), ' ') AS ZONEKY -->
		     , LM.ZONEKY  
		     , RI.LOCAKY
		     , RI.SKUKEY
		     , RI.DESC01
		     , RI.DESC02
		     , RI.UOMKEY
		     , RI.QTYRCV
		     , SM.SKUL05
		     , SM.ASKU01
		     , SM.LOTL20
		     , RI.LOTA01
		     , SLM.STLNM AS LOTA01NM
		     , RI.LOTA02
		     , RI.LOTA03
		     , RI.LOTA04
		     , RI.LOTA05
		     , RI.LOTA06
		     , RI.LOTA07
		     , SUBSTR(RI.LOTA07, 0, 10) AS SALENO
		     , SUBSTR(RI.LOTA07, 11, 16) AS SKUNUM
		     , RI.LOTA08
		     , RI.LOTA09
		     , RI.LOTA10
		     , RI.LOTA11
		     , RI.LOTA12
		     , RI.LOTA13
		     , RI.LOTA14
		     , RI.LOTA15
		     , RI.LOTA16
		     , RI.LOTA17
		     , RI.RSNCOD
		     , RI.RCPRSN
		     , RI.SKUG01
		     , RI.SKUG02
		     , RI.SKUG03
		     , RI.SKUG04
		     , RI.SKUG05
		     , SG05.CMCDVL AS SKUG05_1
		     , RI.QTYUOM AS UOMQTY
		     , MI.UOMKEY AS MUOMKEY
		     , RI.LOTA21
		     , RI.LOTA22
		     , RI.LOTA23
		     , RI.LOTA24
		     , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'KG')),'0.000') AS TOT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BAG')),'0.000') AS BAG
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BOX')),'0.000') AS BOX
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'PAL')),'0.000') AS PLT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'SOK')),'0.000') AS SOK
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'EA')),'0.000') AS EA
		  FROM RECDI RI
		    LEFT OUTER JOIN SKUMA SM ON SM.SKUKEY = RI.SKUKEY
		    LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = #{OWNRKY} AND SLM.PLNTKY = RI.LOTA02 AND SLM.STLKY  = RI.LOTA01
		    LEFT OUTER JOIN CMCDV SG05 ON SG05.CMCDKY = 'SKUG05' AND SG05.USARG1 = RI.SKUG04
		    LEFT OUTER JOIN MEASI MI ON MI.WAREKY = #{WAREKY} AND MI.MEASKY = RI.SKUKEY AND MI.INDDFU = 'V'
		    LEFT OUTER JOIN LOCMA LM ON LM.WAREKY = #{WAREKY} AND LM.LOCAKY = RI.LOCAKY
		 WHERE RI.RECVKY = #{RECVKY}
	</select>
	<!-- GR99 SQL END -->
	
	<!-- GR81 SQL END -->
	<!-- GROUP BY 처리필요 RECDI 중복 ROW -->
	<select id="GR81Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			PI.QTYPDA
			,DECODE(PI.LOTA11, ' ',TO_CHAR(SYSDATE,'YYYYMMDD'), PI.LOTA11) AS LOTA11
			,DECODE(PI.LOTA12, ' ',TO_CHAR(SYSDATE,'YYYYMMDD'), PI.LOTA12) AS LOTA12
			--,DECODE(PI.LOTA15, ' ',RE.LOTA15, PI.LOTA15) AS LOTA15
			
			, (CASE WHEN PI.LOTA15 = ' ' 
					THEN (SELECT MAX(LOTA15) FROM RECDI RE WHERE PI.LOTA14 = RE.LOTA14) 
					ELSE PI.LOTA15 
				END) AS LOTA15 
			, (CASE WHEN PI.LOTA04 = ' ' 
					THEN (SELECT MAX(LOTA04) FROM RECDI RE WHERE PI.LOTA14 = RE.LOTA14) 
					ELSE PI.LOTA04 
				END) AS LOTA04 
			, ' ' AS RCPRSN
		     , ' ' AS SKUL05
		     , ' ' AS ASKU01
		     , '1' AS EXCELDOWN
		     , '0.000' AS TOT
		     , '0.000' AS BAG
		     , '0.000' AS BOX
		     , '0.000' AS PLT
		     , '0.000' AS SOK
		     , '0.000' AS EA
		     , '0.000' AS BOXBAG
		     , ' ' AS SKUG01
		     , ' ' AS SKUG02
		     , ' ' AS SKUG03
		     , ' ' AS SKUG04
		     , ' ' AS SKUG05
		     , ' ' AS SKUG05_1
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS ASNDAT
		     , ' ' AS SEBELN
		     , ' ' AS SEBELP
		     --, PI.QTYPDA AS UOMQTY
		     , (PI.QTYPDA - PI.QTSIWH) AS UOMQTY	-- 기본수량
		     , 'FRV' AS STATIT
		     , ' ' AS PTNRTY
		     , '0' AS MENGE
		     , ' ' AS WMSMAK
		     , 'WMS_IF_219' AS IFID_SAP -- 실적IFID_SAP
		     , ' ' AS SALENO
		     , ' ' AS SKUNUM
		     , ' ' AS RECVKY
		     , ' ' AS SEBELN
		     , ' ' AS SEBELP
		     , NVL(SLM.WMSMAK, ' ') AS WMSMAK
			, PI.LOTA04		  -- 호기
			,'00' AS LOTA06   -- 재고상태
			,'KR' AS LOTA08   -- 국가코드
			, PI.QTSIWH -- 재고수량
			, PI.QTYPDA -- 실사수량
			-- , PI.QTYPDA AS QTYRCV	-- 입고수량
			, (PI.QTYPDA - PI.QTSIWH) AS QTYRCV	-- 입고수량
			, NVL(SM.DUOMKY, 'BAG')	AS UOMKEY
			, NVL(SM.DUOMKY, 'BAG')	AS MUOMKEY
			--, 'ETC' AS AREAKY
			--, 'ETCLOC' AS LOCAKY
			,PI.AREAKY AS AREAKY
			,PI.LOCAKY AS LOCAKY
			, '801' AS RSNCOD	-- 재고실사 실물입고
			--,PI.* 
			,PI.LOTA02
			,PI.LOTA01
			,PI.LOTA11 
			,PI.LOTA14 
			,' ' AS STLNM
			,PI.SKUKEY
			,PI.DESC01 
			, ' ' AS DESC02 
			, (CASE WHEN PI.QTSIWH = '0' 
				THEN (SELECT DECODE(LISTAGG(DISTINCT(CONCAT(LOTA02 || ' ',LOTA01))), NULL, ' ', LISTAGG(DISTINCT(CONCAT(LOTA02 || ' ',LOTA01)), ', ')) FROM STKKY WHERE LOTA14 = PI.LOTA14 AND LOTA02 != PI.LOTA02 AND LOTA01 != PI.LOTA01) 
				ELSE '' 
			END) AS EXIST_OTHER_LOTA01_YN 
			, LM.AREAKY 
			, LM.ZONEKY 
			, LM.LOCAKY 
			, CASE WHEN PH.WAREKY = '4000' THEN 0 ELSE (PI.QTYPDA - PI.QTSIWH) * NVL(DECODE(MV.PEINH, 0, 0, MV.STPRS / MV.PEINH), 0) END AS STKAMT
		FROM PHYDH PH                  
		INNER JOIN PHYDI PI ON (PI.PHYIKY = PH.PHYIKY ) 
		INNER JOIN LOCMA LM ON (PH.WAREKY = LM.WAREKY AND PI.LOCAKY = LM.LOCAKY)	-- 실사된 데이터의 영역, 구역, 지번으로 조회
		LEFT JOIN MATVAL MV ON MV.MATNR  = PI.SKUKEY AND MV.BWKEY  = PI.LOTA02 AND MV.MEINS = 'BAG' -- BAG 고정 
		-- LEFT JOIN RECDI RE ON (PI.LOTA14 = RE.LOTA14) 
		LEFT JOIN SKUMA SM ON SM.OWNRKY = PI.OWNRKY AND SM.SKUKEY = PI.SKUKEY AND SM.MTYPE LIKE '%' || '%'
		LEFT JOIN STLMA SLM ON (SLM.OWNRKY = PI.OWNRKY AND SLM.PLNTKY = PI.LOTA02 AND SLM.STLKY  = PI.LOTA01)
		WHERE 1 = 1              
		AND PH.PHYIKY = #{PHYIKY} 		
		-- AND (PH.INDDCL  = 'V' OR PI.REFCAT  = 'V') 
		AND (PI.QTYPDA - PI.QTSIWH) > 0 /* 실사차이 (재고실사입고 대상) */
		-- AND PI.LOTA15 = ' '	/* STKKY 미존재인 CASE (RECDI만 내역존재) */
		AND PI.SKUKEY != 'EMPTY'	/* 전산 미존재인 CASE 비노출 (수동 입고처리 대상) */
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL} 
		</if>
		-- AND ROWNUM = 1
	</select>
	
	
	<!-- GR71 SQL END -->
	
	
	<!-- GR11 SQL START -->
	<select id="GR11_LIST" parameterType="Map" resultType="DataMap">
		WITH OE_T AS (
		    SELECT NVL(OE.NAME01,' ') AS OWNRNM
		    FROM OWNER OE 
		    WHERE OE.OWNRKY = #{OWNRKY}
		),
		WM_T AS (
		    SELECT NVL(WM.NAME01,' ') AS WARENM  
		    FROM WAHMA WM
		    WHERE WM.WAREKY = #{WAREKY}
		),
		LOTA02_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'LOTA02'
		),
		LOTA06_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'LOTA06'
		),
		LOTA08_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'NATNKY'
		),
		STATIT_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'STATIT'
		),
        DOCCM_T AS (
          SELECT DC.DOCCAT
             , NVL(DL.SHORTX, DC.SHORTX) AS DOCCATNM
          FROM DOCCM DC
            LEFT OUTER JOIN DOCCM_LANG DL ON DL.LANGKY = #{LANGKY} AND DL.DOCCAT = DC.DOCCAT
        ),
        RSNCD_T AS (
            SELECT RC.DOCCAT
                 , RC.DOCUTY
                 , RC.RSNCOD
                 , NVL(RL.SHORTX, RC.SHORTX) AS RSNCODNM
            FROM RSNCD RC
              LEFT OUTER JOIN RSNCD_LANG RL 
                           ON RL.LANGKY = #{LANGKY}
                          AND RL.OWNRKY = RC.OWNRKY
                          AND RL.DOCCAT = RC.DOCCAT
                          AND RL.DOCUTY = RC.DOCUTY
                          AND RL.RSNCOD = RC.RSNCOD
             WHERE RC.OWNRKY = #{OWNRKY}
        ),
		SLM_T AS (
          	SELECT SLM.OWNRKY
			     , SLM.PLNTKY
			     , SLM.STLKY
			     , SLM.STLNM
			FROM STLMA SLM 
			WHERE SLM.OWNRKY = #{OWNRKY} 
        ),
        UIM_T AS (
          	SELECT UM.OWNRKY
			     , UM.PLNTKY
			     , UM.UNITNO
			     , UM.UNITNM
			FROM UNITMA UM 
			  WHERE UM.OWNRKY = #{OWNRKY} 
        ),
        DOCPG_T AS (
		   SELECT X.DOCUTY
		   FROM DOCPG X
		   WHERE X.PROGID = #{PROGID}
		),
		D_UOMQTY_T AS (
		  	SELECT A.MEASKY
                 , A.D_UOMKEY
			     , ( CASE WHEN A.QTAUOM_KG=0 THEN 0 ELSE (A.QTPUOM_KG / A.QTAUOM_KG) END ) AS DSN_KG
			     , ( CASE WHEN A.QTAUOM_BAG=0 THEN 0 ELSE (A.QTPUOM_BAG / A.QTAUOM_BAG) END ) AS DSN_BAG
			     , ( CASE WHEN A.QTAUOM_BOX=0 THEN 0 ELSE (A.QTPUOM_BOX / A.QTAUOM_BOX) END ) AS DSN_BOX
			     , ( CASE WHEN A.QTAUOM_PAL=0 THEN 0 ELSE (A.QTPUOM_PAL / A.QTAUOM_PAL) END ) AS DSN_PAL
			     , ( CASE WHEN A.QTAUOM_SOK=0 THEN 0 ELSE (A.QTPUOM_SOK / A.QTAUOM_SOK) END ) AS DSN_SOK
			     , ( CASE WHEN A.QTAUOM_EA=0 THEN 0 ELSE (A.QTPUOM_EA / A.QTAUOM_EA) END ) AS DSN_EA
			FROM (
			    SELECT MI.MEASKY
			         , MAX( CASE WHEN MI.INDDFU='V' THEN MI.UOMKEY ELSE ' ' END ) AS D_UOMKEY
			         , SUM( CASE WHEN MI.UOMKEY='KG' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_KG
			         , SUM( CASE WHEN MI.UOMKEY='KG' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_KG
			         , SUM( CASE WHEN MI.UOMKEY='BAG' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_BAG
			         , SUM( CASE WHEN MI.UOMKEY='BAG' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_BAG     
			         , SUM( CASE WHEN MI.UOMKEY='BOX' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_BOX
			         , SUM( CASE WHEN MI.UOMKEY='BOX' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_BOX     
			         , SUM( CASE WHEN MI.UOMKEY='PAL' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_PAL
			         , SUM( CASE WHEN MI.UOMKEY='PAL' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_PAL     
			         , SUM( CASE WHEN MI.UOMKEY='SOK' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_SOK
			         , SUM( CASE WHEN MI.UOMKEY='SOK' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_SOK     
			         , SUM( CASE WHEN MI.UOMKEY='EA' THEN MI.QTPUOM ELSE 0 END ) AS QTPUOM_EA
			         , SUM( CASE WHEN MI.UOMKEY='EA' THEN MI.QTAUOM ELSE 0 END ) AS QTAUOM_EA     
			    FROM MEASI MI
			    WHERE MI.WAREKY = #{WAREKY}
			       AND EXISTS (
			                     SELECT 'X'
			                     FROM RECDH RH 
								   INNER JOIN RECDI RI ON RI.RECVKY = RH.RECVKY AND RI.SKUKEY = MI.MEASKY
								   INNER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = RI.SKUKEY
								   INNER JOIN LOCMA LM ON LM.WAREKY = #{WAREKY} AND LM.LOCAKY = RI.LOCAKY
								   LEFT OUTER JOIN BZPTN BT ON BT.PTNRKY = RH.DPTNKY AND BT.PTNRTY = RH.PTNRTY AND BT.OWNRKY = #{OWNRKY}
			                     WHERE RH.WAREKY = #{WAREKY}
			                       AND RH.OWNRKY = #{OWNRKY}
									<if test="RANGE_SQL != null and RANGE_SQL != ''">
										${RANGE_SQL}
									</if>
									<if test="RCPTTY != null and RCPTTY != ''">
										AND RH.RCPTTY = ${RCPTTY}
									</if>
									<if test="LOTA06 != null and LOTA06 != ''">
										AND RI.LOTA06 = #{LOTA06}
									</if>
									<if test="SKUG01 != null and SKUG01 != ''">
										AND SM.SKUG01 = #{SKUG01}
									</if>
									<if test="SKUL01 != null and SKUL01 != ''">
										AND SM.SKUL01 = #{SKUL01}
									</if>
							        <if test="SES_MTYPE != null and SES_MTYPE != ''">
							            AND SM.MTYPE LIKE #{SES_MTYPE}
							        </if>
									<if test="Opt == 1">
										AND TRIM(RI.INDRCN) IS NULL
									</if>
									<if test="Opt == 2">
										AND TRIM(RI.INDRCN) IS NOT NULL
									</if>
			                  )
			    GROUP BY MI.MEASKY
			) A
		)
		SELECT RH.OWNRKY
		     , ( SELECT OWNRNM FROM OE_T ) AS OWNRNM
    		 , RH.WAREKY
    		 , ( SELECT WARENM FROM WM_T ) AS WARENM  
		     , RI.STKNUM 
		     , RI.AREAKY
		     , NVL(AM.SHORTX,' ') AS AREANM  
		     , RH.DOCDAT
		     , RI.REFDAT AS ASNDAT 
		     , RH.RECVKY
		     , RI.RECVIT
		     , RI.SEBELN
		     , RI.SEBELP 
		     , RH.RCPTTY
		     , NVL(DT.SHORTX,' ') AS RCPTNM
		     , RI.INDRCN
		     , RI.CRECVD 
		     , RH.DPTNKY
		     , NVL(BT.NAME01,' ') AS DPTNNM
		     , RI.SKUKEY
		     , SM.DESC01
		     , SM.DESC02 
		     , RI.QTYRCV
		     , RI.UOMKEY 
		     , RI.LOTA01
		     , ( SELECT X.STLNM FROM SLM_T X WHERE X.PLNTKY = RI.LOTA02 AND X.STLKY = RI.LOTA01 ) AS LOTA01NM
		     , RI.LOTA02
		     , ( SELECT X.CDESC1 FROM LOTA02_T X WHERE X.CMCDVL=RI.LOTA02 ) AS LOTA02NM
		     , RI.LOTA03
		     , RI.LOTA04
		     , ( SELECT X.UNITNM FROM UIM_T X WHERE X.PLNTKY = RI.LOTA02 AND X.UNITNO = RI.LOTA04 ) AS LOTA04NM
		     , RI.LOTA05 
		     , RI.LOTA06
		     , ( SELECT X.CDESC1 FROM LOTA06_T X WHERE X.CMCDVL=RI.LOTA06 ) AS LOTA06NM		     
		     , RI.LOTA07
		     , RI.LOTA08
		     , ( SELECT X.CDESC1 FROM LOTA08_T X WHERE X.CMCDVL=RI.LOTA08 ) AS LOTA08NM
		     , RI.LOTA09
		     , RI.LOTA10 
		     , RI.LOTA11
		     , RI.LOTA12
		     , RI.LOTA13
		     , RI.LOTA14
		     , RI.LOTA15
		     
		     , RI.LOTA16
		     , RI.LOTA17
		     , RI.LOTA18
		     , RI.LOTA19
		     , RI.LOTA20
		     
		     , RI.LOTA21
		     , RI.LOTA22
		     , RI.LOTA23
		     , RI.LOTA24
		     
		     , RI.LOTA41
		     , RI.LOTA42
		     
		     , RI.CREDAT
		     , RI.CRETIM
		     , RI.CREUSR
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RI.CREUSR),' ') AS CUSRNM 
		     , RI.LMODAT
		     , RI.LMOTIM
		     , RI.LMOUSR
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RI.LMOUSR),' ') AS LUSRNM
		     , RI.RSNCOD
		     , ( SELECT X.RSNCODNM FROM RSNCD_T X WHERE X.DOCCAT=RH.DOCCAT AND X.DOCUTY=RH.RCPTTY AND X.RSNCOD=RI.RSNCOD ) AS RSNCODNM
		     , RI.RCPRSN
		     , RH.DOCCAT
		     , ( SELECT X.DOCCATNM FROM DOCCM_T X WHERE X.DOCCAT=RH.DOCCAT ) AS DOCCATNM
		     , RI.STATIT
		     , ( SELECT X.CDESC1 FROM STATIT_T X WHERE X.CMCDVL=RI.STATIT ) AS STATITNM
		     , RI.LOCAKY
		     , RH.ORDDAT
		     , LM.ZONEKY
		     , RH.DOCTXT
		     , RI.QTYUOM
		     , RI.DUOMKY
			 , (  
 					CASE WHEN RI.UOMKEY='KG' 
 					       THEN RI.QTYRCV
                         WHEN RI.UOMKEY!='KG' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_KG=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_KG) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_KG=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_KG ) END)
                    END 
			   ) AS TOT
			 , (  
 					CASE WHEN RI.UOMKEY='BAG' 
 					       THEN RI.QTYRCV
                         WHEN RI.UOMKEY!='BAG' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_BAG=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_BAG) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_BAG=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_BAG ) END)
                    END 
			   ) AS BAG
			 , (  
 					CASE WHEN RI.UOMKEY='BOX' 
 					       THEN RI.QTYRCV
                         WHEN RI.UOMKEY!='BOX' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_BOX=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_BOX) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_BOX=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_BOX ) END)
                    END 
			   ) AS BOX
			 , ( 
 					CASE WHEN RI.UOMKEY='PAL' 
 					       THEN RI.QTYRCV
                         WHEN RI.UOMKEY!='PAL' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_PAL=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_PAL) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_PAL=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_PAL ) END)
                    END 
			   ) AS PLT
			 , ( 
 					CASE WHEN RI.UOMKEY='SOK' 
 					       THEN RI.QTYRCV
                         WHEN SM.SKUG05 = '20'
			               THEN 0
                         WHEN RI.UOMKEY!='SOK' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_SOK=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_SOK) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_SOK=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_SOK ) END)
                    END 
			   ) AS SOK
			 , (
 					CASE WHEN RI.UOMKEY='EA' 
 					       THEN RI.QTYRCV
                         WHEN SM.SKUG05 = '20'
			               THEN 0
                         WHEN RI.UOMKEY!='EA' AND DUMO_T.D_UOMKEY=RI.UOMKEY
                           THEN
                           (CASE WHEN DUMO_T.DSN_EA=0 THEN 0 ELSE (RI.QTYRCV / DUMO_T.DSN_EA) END)
                         ELSE
                           (CASE WHEN DUMO_T.DSN_EA=0 THEN 0 ELSE ( NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY)),0) / DUMO_T.DSN_EA ) END)
                    END 
			   ) AS EA 
			   , CASE WHEN RI.QTYRCV = 0 THEN 0 
			   		  ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BOX'))),'0.000')
   		  		  END AS BOXBAG
		  FROM RECDI RI 
		    INNER JOIN RECDH RH ON RI.RECVKY = RH.RECVKY AND RH.WAREKY = #{WAREKY} AND RH.OWNRKY = #{OWNRKY}
		    INNER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = RI.SKUKEY
		    INNER JOIN DOCTM DT ON DT.DOCUTY = RH.RCPTTY
		    INNER JOIN LOCMA LM ON LM.WAREKY = RH.WAREKY AND LM.LOCAKY = RI.LOCAKY
		    LEFT OUTER JOIN BZPTN BT ON BT.PTNRKY = RH.DPTNKY AND BT.PTNRTY = RH.PTNRTY AND BT.OWNRKY = #{OWNRKY}       
		    LEFT OUTER JOIN AREMA AM ON AM.WAREKY = #{WAREKY} AND AM.AREAKY = RI.AREAKY
		    LEFT OUTER JOIN D_UOMQTY_T DUMO_T ON DUMO_T.MEASKY = RI.SKUKEY 
		 WHERE RI.STATIT != 'FTV'
		   AND EXISTS (
			            SELECT 'X'
			            FROM DOCPG_T X
			            WHERE X.DOCUTY = RH.RCPTTY
			          )
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		<if test="LOTA06 != null and LOTA06 != ''">
			AND RI.LOTA06 = #{LOTA06}
		</if>
		<if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		</if>
		<if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		</if>
        <if test="SES_MTYPE != null and SES_MTYPE != ''">
            AND SM.MTYPE LIKE #{SES_MTYPE}
        </if>
		<if test="Opt == 1">
			AND TRIM(RI.INDRCN) IS NULL
		</if>
		<if test="Opt == 2">
			AND TRIM(RI.INDRCN) IS NOT NULL
		</if>
		 ORDER BY RI.LOTA14, RI.RECVKY DESC, RI.RECVIT
	</select>
	
	<!-- GR11 SQL END -->
	
	<!-- GR12 SQL START -->
	<select id="PLNTKYCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT MS.PLNTKY AS VALUE_COL
              , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA02', MS.PLNTKY) AS TEXT_COL
		FROM STLMA MS
		WHERE MS.OWNRKY = #{OWNRKY}
		<if test="WAREKYS != null and WAREKYS != ''">
			AND MS.WAREKY IN (${WAREKYS})
		</if>
		
		<if test="WAREKY_LIST != null and WAREKY_LIST != ''">
		   <foreach collection="WAREKY_LIST" item="item" separator="," close=")" open="AND MS.WAREKY IN (">
 				#{item}
		  </foreach>
		</if>
		ORDER BY MS.PLNTKY 
	</select>
	
	<select id="UNITNOOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT UA.UNITNO AS VALUE_COL
		     , UA.UNITNM||'-'||SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA02', UA.PLNTKY) AS TEXT_COL
		FROM UNITMA UA
		WHERE UA.OWNRKY = #{OWNRKY}
		  <if test="PLNTKYS != null and PLNTKYS != ''">
			AND UA.PLNTKY IN (${PLNTKYS})
		  </if>
		GROUP BY UA.PLNTKY, UA.UNITNO, UA.UNITNM
		ORDER BY UA.PLNTKY, UA.UNITNO, UA.UNITNM
	</select>
	
	<select id="GR12_LIST" parameterType="Map" resultType="DataMap">
		SELECT PN.OWNRKY
		 	 , PN.WAREKY
		 	 , PN.PLNTKY
		 	 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA02', PN.PLNTKY) AS PLNTNM
		 	 , PN.UNITNO
		 	 , UA.UNITNM
		 	 , PN.SKUKEY
		 	 , PN.QTYPRD
		 	 , PN.UOMKEY
		 	 , PN.PRDDTS
		 	 , PN.PRDDTE
		 	 , PN.REMARK
		 	 , PN.CREDAT
		 	 , PN.CRETIM
		 	 , PN.CREUSR
		 	 , PN.LMODAT
		 	 , PN.LMOTIM
		 	 , PN.LMOUSR
		 	 , PN.INDBZL
		 	 , PN.INDARC
		 	 , PN.UPDCHK
		 	 , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = PN.CREUSR),' ') AS CUSRNM
		 	 , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = PN.LMOUSR),' ') AS LUSRNM
		 	 , SM.DESC01
		 	 , SM.SKUG01
		 	 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUG01', SM.SKUG01) AS SKUG01NM
		 	 , SM.SKUL01
		 	 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
		 	 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PN.SKUKEY, PN.QTYPRD, PN.UOMKEY, 'KG')),'0.000') AS TOT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PN.SKUKEY, PN.QTYPRD, PN.UOMKEY, 'BAG')),'0.000') AS BAG
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PN.SKUKEY, PN.QTYPRD, PN.UOMKEY, 'BOX')),'0.000') AS BOX
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PN.SKUKEY, PN.QTYPRD, PN.UOMKEY, 'PAL')),'0.000') AS PLT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PN.SKUKEY, PN.QTYPRD, PN.UOMKEY, 'SOK')),'0.000') AS SOK
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PN.SKUKEY, PN.QTYPRD, PN.UOMKEY, 'EA')),'0.000') AS EA
			 , CASE WHEN PN.QTYPRD = 0 THEN 0 
			 		ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PN.SKUKEY, PN.QTYPRD, PN.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PN.SKUKEY, PN.QTYPRD, PN.UOMKEY, 'BOX'))),'0.000')
				END AS BOXBAG
		FROM PRDPLN PN
		  LEFT OUTER JOIN SKUMA SM
		               ON SM.OWNRKY = PN.OWNRKY
		              AND SM.SKUKEY = PN.SKUKEY
		  LEFT OUTER JOIN UNITMA UA
		               ON UA.OWNRKY = PN.OWNRKY
		              AND UA.PLNTKY = PN.PLNTKY
		              AND UA.UNITNO = PN.UNITNO
		WHERE PN.OWNRKY = #{OWNRKY}
		  AND PN.WAREKY = #{WAREKY}
		   <if test="UNITNO != null and UNITNO != ''">
				AND PN.UNITNO = #{UNITNO}
			</if>
			<if test="SKUG01 != null and SKUG01 != ''">
				AND SM.SKUG01 = #{SKUG01}
			</if>
			<if test="SKUL01 != null and SKUL01 != ''">
				AND SM.SKUL01 = #{SKUL01}
			</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">
		    ${RANGE_SQL}
		   </if>
	</select>
	<!-- GR12 SQL END -->
	
	<!-- GR02 SQL START -->
	<select id="SKUL01COMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL,
		       CDESC1 AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'SKUL01'
		 <if test="CMCDVL_LIST != null and CMCDVL_LIST != ''">
		   <foreach collection="CMCDVL_LIST" item="item" separator="," close=")" open="AND CMCDVL IN (">
 				#{CMCDVL_item}
		  </foreach>
		</if>
		 ORDER BY CMCDVL
	</select>
	
	<select id="COMMON_VALUE_LANG_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
		     , NVL((
		             SELECT CDESC1
		               FROM CMCDV_LANG
		              WHERE CMCDV_LANG.LANGKY = #{LANGKY}
		                AND CMCDV_LANG.CMCDKY = CMCDV.CMCDKY
		                AND CMCDV_LANG.CMCDVL = CMCDV.CMCDVL
		           ), CDESC1) AS TEXT_COL
		  FROM CMCDV
		 WHERE 1 = 1
		   AND CMCDKY = #{CMCDKY}
		   <if test="USARG1 != null and USARG1 != ''">AND USARG1 = #{USARG1}</if>
		   <if test="USARG2 != null and USARG2 != ''">AND USARG2 = #{USARG2}</if>
		   <if test="USARG3 != null and USARG3 != ''">AND USARG3 = #{USARG3}</if>
		   <if test="USARG4 != null and USARG4 != ''">AND USARG4 = #{USARG4}</if>
		   <if test="USARG5 != null and USARG5 != ''">AND USARG5 = #{USARG5}</if>
		 ORDER BY CMCDVL
	</select>
	
	<select id="UOMQTYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, #{SKUKEY}, REPLACE(#{QTY},',',''), #{UOMKEY})),'0.000') AS UOMQTY
		     , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, REPLACE(#{QTY},',',''), #{UOMKEY}, 'KG')),'0.000') AS TOT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, REPLACE(#{QTY},',',''), #{UOMKEY}, 'BAG')),'0.000') AS BAG
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, REPLACE(#{QTY},',',''), #{UOMKEY}, 'BOX')),'0.000') AS BOX
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, REPLACE(#{QTY},',',''), #{UOMKEY}, 'PAL')),'0.000') AS PLT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, REPLACE(#{QTY},',',''), #{UOMKEY}, 'SOK')),'0.000') AS SOK
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, REPLACE(#{QTY},',',''), #{UOMKEY}, 'EA')),'0.000') AS EA
			 , ( SELECT MI.UOMKEY FROM MEASI MI WHERE MI.WAREKY = #{WAREKY} AND MI.MEASKY = #{SKUKEY} AND MI.INDDFU = 'V' AND ROWNUM=1 ) AS MUOMKEY 
			 , CASE WHEN REPLACE(#{QTY},',','') = 0 THEN 0 
					ELSE DECODE(#{QTY},'0.0',0, NVL((TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, REPLACE(#{QTY},',',''), #{UOMKEY}, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, REPLACE(#{QTY},',',''), #{UOMKEY}, 'BOX'))), '0.000') )
				END AS BOXBAG
		FROM DUAL
	</select>
	
	<select id="GR02_LIST" parameterType="Map" resultType="DataMap">
		WITH IF103_T AS (
			SELECT PO.SEQNO
			     , PO.WERKS
				 , PO.EBELN
				 , PO.EBELP
				 , PO.WAREKY
				 , PO.BWART
				 , PO.EINDT
				 , PO.ORDCAT
				 , PO.LIFNR
			     , PO.PTNRTY
				 , PO.BEDAT
				 , PO.IFID
			     , PO.MRFLG
			     , PO.BWARTSAP
			     , PO.DLEFLG
			     , PO.AR_NO
				 , PO.AR_REV
				 , CASE WHEN  EXISTS (SELECT MAX(RECVKY) ,STATIT FROM RECDI re WHERE re.SEBELN = po.EBELN AND re.SEBELP = po.EBELP GROUP BY STATIT HAVING STATIT = 'FRV'  ) THEN 'Y' ELSE PO.IFFLG  END AS IFFLG
				<!--  , PO.IFFLG -->
				 , PO.LOTNUM
				 , PO.SKUKEY
				 , PO.MEINS
				 , PO.LOTA01
				 , PO.LOTA02
				 , PO.LOTA14
				 , PO.LOTA15
				 , PO.FLOTA01
				 , PO.FLOTA02
				 , PO.STKNUM
				 , (PO.MENGE-PO.MENGE_R) AS QTYRCV1
				 , BZ.NAME01 AS DPTNNM
				 , LM.AREAKY AS AREAKY
				 , AM.SHORTX AS AREANM
				 , SLM.WMSMAK
				 , ( CASE WHEN SLT.SHTAYN = 'V' AND SLM.WMSMAK = 'V' THEN 'V' ELSE '' END ) AS IMIB01
     		 	 , ( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN 'V' ELSE '' END ) AS IMIB02
     		 	 , ( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) ELSE '' END ) AS IMIB02_LOTA01
			FROM IFWMS103 PO
			  LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
			  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
			  LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
			  LEFT OUTER JOIN LOTAT LT ON LT.LOTNUM = PO.LOTNUM
			  LEFT OUTER JOIN LOCMA LM ON LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC
			  LEFT OUTER JOIN AREMA AM ON AM.WAREKY = #{WAREKY} AND AM.AREAKY = LM.AREAKY
			  LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = #{OWNRKY} AND SLT.WAREKY = #{WAREKY} AND SLT.PLNTKY = PO.LOTA02 AND SLT.SKUKEY = PO.SKUKEY
			  LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = #{OWNRKY} AND SLM.PLNTKY = PO.LOTA02 AND SLM.STLKY  = NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) AND SLM.WMSMAK = 'V'
			WHERE PO.WAREKY = #{WAREKY}
			  AND PO.WERKS  = #{OWNRKY}
			  AND PO.STATUS IN ('U','C')
			  AND PO.IFFLG IN ('N','Y')
			  AND PO.PRCFLG = 'C'
			  AND (PO.MRFLG != 'S0' 
			  		OR ( PO.MRFLG  = 'S0'
			  		     AND PO.LOTA01 != '2400' 
			  		     AND PO.LOTA02 LIKE CASE WHEN PO.BWART = '121' THEN '%' ELSE 'P100' END 
			  		    )
			  		)
			  AND EXISTS (
			               SELECT 'X'
			               FROM DOCPG X
			               WHERE X.PROGID = #{PROGID}
			                 AND X.DOCUTY = PO.BWART
			             )
			  AND ( 
		          1 = 2
		          <if test="STTNEW == &quot;V&quot;">
		          OR PO.IFFLG = 'N'
		          </if>
		          <if test="STTTC2 == &quot;V&quot;">
		          OR PO.IFFLG = 'Y'
		          </if>
		        )
		    
		    <if test="BWART != null and BWART != ''">AND PO.BWART = #{BWART}</if>
		    
	        <if test="SES_MTYPE != null and SES_MTYPE != ''">
	            AND SM.MTYPE LIKE #{SES_MTYPE}
	        </if>
		    <if test="SKUG01 != null and SKUG01 != ''">
				AND SM.SKUG01 = #{SKUG01}
			</if>
			<if test="SKUL01 != null and SKUL01 != ''">
				AND SM.SKUL01 = #{SKUL01}
			</if>
			<!-- 반품입고_선적단위 입고시 사용되는 파라메터 -->
			<if test="STKNUM != null and STKNUM != ''">
				AND PO.STKNUM = #{STKNUM}
			</if>
			<if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			</if>
			
		)
		<if test="LOTA14_SQL != null and LOTA14_SQL != ''">
		,
		TDI_T AS (
		    SELECT PO.EBELN
			     , PO.EBELP
			     , TI.OWNRKY
			     , TI.LOTA11
			     , TI.LOTA14
			     , TI.LOTA15
			     , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, SUM(TI.QTCOMP), TI.AUOMKY, PO.MEINS)),'0.000') AS QTCOMP
			     , SK.LOTNUM
			     , LA.LOTA21
			     , LA.LOTA22
			     , LA.LOTA23
			     , LA.LOTA24
			     , PO.IFFLG
			FROM IF103_T PO
			  INNER JOIN SHPDI SI
			          ON SI.SVBELN = PO.EBELN
		             AND SI.SPOSNR = PO.EBELP
			  INNER JOIN TASDI TI
			          ON TI.OWNRKY = PO.WERKS
			         AND TI.SHPOKY = SI.SHPOKY
			         AND TI.SHPOIT = SI.SHPOIT
			         AND TI.LOTA15 = PO.LOTA15
			         AND TI.LOTA15 != ' '
			         AND TI.STATIT IN ('FPC', 'PPC')
			  INNER JOIN TASDR TR
			          ON TR.TASKKY = TI.TASKKY 
			         AND TR.TASKIT = TI.TASKIT 
			         AND TR.TASKIR = (
			                            SELECT MIN(X.TASKIR)
			                            FROM TASDR X
			                            WHERE X.TASKKY = TR.TASKKY 
			                              AND X.TASKIT = TR.TASKIT
			                            GROUP BY X.TASKKY, X.TASKIT
			                         )
			  INNER JOIN STKKY SK
			          ON SK.STOKKY = TR.STOKKY
			  INNER JOIN LOTAT LA
			          ON LA.LOTNUM = SK.LOTNUM
			WHERE PO.BWART = '121'
			  AND PO.WERKS = #{OWNRKY}
			  AND (PO.MRFLG != 'S0' 
			  		OR ( PO.MRFLG  = 'S0' 
			  			 AND PO.LOTA01 != '2400' 
			  		     AND PO.LOTA02 LIKE CASE WHEN PO.BWART = '121' THEN '%' ELSE 'P100' END 
			  		    )
			  		)
			  ${LOTA14_SQL}
			  AND EXISTS (
			               SELECT 'X'
			               FROM STLMA X
			               WHERE X.OWNRKY = #{OWNRKY} 
			                 AND X.WAREKY = (
			                                  SELECT MAX(SA.WAREKY)
			                                  FROM STLMA SA
			                                  WHERE SA.OWNRKY = #{OWNRKY} 
			                                    AND SA.PLNTKY = PO.FLOTA02 
			                                    AND SA.STLKY = PO.FLOTA01
			                                )
			                 AND X.WMSMAK = 'V'
			                 AND X.OWNRKY = PO.WERKS
		         			 AND X.PLNTKY = PO.FLOTA02
		         			 AND X.STLKY = PO.FLOTA01
			             )
			GROUP BY PO.EBELN, PO.EBELP, TI.LOTA14, TI.LOTA15, TI.OWNRKY
			     , TI.LOTA11, SK.LOTNUM, LA.LOTA21, LA.LOTA22, LA.LOTA23
			     , LA.LOTA24, PO.SKUKEY, PO.IFFLG, TI.AUOMKY, PO.MEINS
		),
		RICNT_T AS (
			SELECT RI.SEBELN, RI.SEQNO, RI.LOTA14, COUNT(1) AS CNT
			FROM RECDI RI
			WHERE EXISTS (
			                SELECT 'X'
			                FROM TDI_T X
			                WHERE X.EBELN = RI.SEBELN
			             )
			  AND EXISTS (
			                SELECT 'X'
			                FROM RECDH RH
			                WHERE RH.RECVKY = RI.RECVKY
			                  AND RH.STATDO != 'RCN'
			             )
			GROUP BY RI.SEBELN, RI.SEQNO, RI.LOTA14
		)
		</if>
		SELECT A.OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = #{OWNRKY}), ' ') AS OWNRNM
			 , A.EBELN
			 , A.SEBELN
			 , A.DOCKEY
			 , A.WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM	 
			 , A.DOCUTY
			 , A.RCPTTY
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, A.BWART) AS RCPTNM
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, A.BWART) AS DOCTNM
			 , A.ASNDAT
			 , A.DOCCAT	 
			 , SZF_GET_DOCCAT_TEXT('', A.DOCCAT) AS DOCCATNM	 
			 , DECODE(A.STATDO, 'FRV', A.DOCDAT, TO_CHAR(SYSDATE, 'YYYYMMDD')) AS DOCDAT
			 , A.DPTNKY
			 , A.DPTNNM	 
			 , A.STATDO
		     , SZF_GET_CMCDV_CDESC1_TEXT('', 'STATDO', A.STATDO ) AS STATDONM
		     , A.AREAKY
		     , A.AREANM
		     , A.DOCTXT
			 , A.PTNRTY
			 , A.BEDAT
			 , A.IFID_RECV
			 , A.MRFLG
		     , A.BWARTSAP
		     , A.DLEFLG
		     , A.AR_NO
			 , A.AR_REV
		     , A.SAPIFYN
		     , A.LOTA14_EMPTY_YN
		     , A.COAYN
		     , A.QTYRCV1
		     , A.WMSMAK
		     , A.IMIB01
		     , A.IMIB02
		     , A.IMIB02_LOTA01
		     , A.STKNUM
<!-- 		     , A.STI_CNT -->
		FROM (
			SELECT #{OWNRKY} AS OWNRKY
<!-- 				 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = #{OWNRKY}), ' ') AS OWNRNM -->
				 , PO.EBELN
				 , PO.EBELN AS SEBELN
				 , PO.EBELN AS DOCKEY
				 , #{WAREKY} AS WAREKY
<!-- 				 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM -->
				 , MAX(PO.BWART) AS DOCUTY
				 , MAX(PO.BWART) AS RCPTTY
				 , MAX(PO.BWART) AS BWART
<!-- 				 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, MAX(PO.BWART)) AS RCPTNM -->
<!-- 				 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, MAX(PO.BWART)) AS DOCTNM -->
				 , MAX(PO.EINDT) AS ASNDAT
				 , MAX(PO.ORDCAT) AS DOCCAT	 
<!-- 				 , SZF_GET_DOCCAT_TEXT('', MAX(PO.ORDCAT)) AS DOCCATNM	  -->
				 <!-- 20221130 , F_SET_DATE(SYSDATE) AS DOCDAT -->
				 , MAX(PO.EINDT) AS DOCDAT
				 , MAX(PO.LIFNR) AS DPTNKY
				 , MAX(PO.DPTNNM) AS DPTNNM	 
				 , DECODE(SUM( CASE WHEN PO.IFFLG != 'Y' THEN 1 ELSE 0 END ), 0, 'FRV', 'NEW') AS STATDO
<!-- 			     , SZF_GET_CMCDV_CDESC1_TEXT('', 'STATDO', DECODE(SUM( CASE WHEN PO.IFFLG != 'Y' THEN 1 ELSE 0 END ), 0, 'FRV', 'NEW') ) AS STATDONM -->
			     , MAX(PO.AREAKY) AS AREAKY
			     , MAX(PO.AREANM) AS AREANM
			     , ' ' AS DOCTXT
				 , MAX(PO.PTNRTY) AS PTNRTY
				 , MAX(PO.BEDAT) AS BEDAT
				 , MAX(PO.IFID) AS IFID_RECV
				 , MAX(PO.MRFLG) AS MRFLG
			     , MAX(PO.BWARTSAP) AS BWARTSAP
			     , MAX(PO.DLEFLG) AS DLEFLG
			     , MAX(PO.AR_NO) AS AR_NO
				 , MAX(PO.AR_REV) AS AR_REV
			     , 'V' AS SAPIFYN
			     , (CASE WHEN (CASE WHEN TRIM(MAX(PO.LOTA14)) IS NULL THEN 1 ELSE 0 END)=0 THEN 'N' ELSE 'Y' END) AS LOTA14_EMPTY_YN
			     , (CASE WHEN 0 = (SELECT COUNT(0) FROM COAMA WHERE SEBELN = PO.EBELN) THEN ' ' ELSE 'V' END) AS COAYN
			     , SUM(PO.QTYRCV1) AS QTYRCV1
			     , MIN(PO.WMSMAK) AS WMSMAK
			     , MAX(PO.IMIB01) AS IMIB01
		         , MAX(PO.IMIB02) AS IMIB02
		         , MAX(PO.IMIB02_LOTA01) AS IMIB02_LOTA01
		         , MAX(PO.STKNUM) AS STKNUM
<!-- 		         , ( CASE WHEN ( -->
<!-- 			     					SELECT COUNT(1) AS CNT -->
<!-- 			     					FROM IF103_T IWM103 -->
<!-- 			     					  INNER JOIN SHPDI SI -->
<!-- 			     					          ON SI.SVBELN = IWM103.EBELN -->
<!-- 					                         AND SI.SPOSNR = IWM103.EBELP -->
<!-- 								      INNER JOIN TASDI TI -->
<!-- 								              ON TI.OWNRKY = IWM103.WERKS -->
<!-- 								             AND TI.SHPOKY = SI.SHPOKY -->
<!-- 								             AND TI.SHPOIT = SI.SHPOIT -->
<!-- 								             AND TI.LOTA15 = IWM103.LOTA15 -->
<!-- 								             AND TI.LOTA14 != ' ' -->
<!-- 								             AND TI.LOTA15 != ' ' -->
<!-- 								             AND TI.STATIT IN ('FPC', 'PPC') -->
<!-- 								    WHERE IWM103.EBELN = PO.EBELN -->
<!-- 				     			) > 0 THEN 1 ELSE 0 END  -->
<!-- 				   ) AS STI_CNT -->
			FROM IF103_T PO
			  <if test="LOTA14_SQL != null and LOTA14_SQL != ''">
			  LEFT OUTER JOIN TDI_T TI_T ON TI_T.EBELN = PO.EBELN AND TI_T.EBELP = PO.EBELP AND TI_T.LOTA15 = PO.LOTA15 AND TI_T.IFFLG = PO.IFFLG
  			  LEFT OUTER JOIN RICNT_T RT_T ON RT_T.SEBELN = PO.EBELN AND RT_T.SEQNO = PO.SEQNO AND RT_T.LOTA14 = TI_T.LOTA14
  			  </if>
			WHERE 1=1			  
			  <choose>
		        <when test="LOTA14_SQL != null and LOTA14_SQL != ''">
				  AND ( 
				        1 = 2
				        <if test="STTNEW == &quot;V&quot;">
				        OR DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, DECODE(PO.QTYRCV1,0,'Y','N') ) = 'N'
				        </if>
				        <if test="STTTC2 == &quot;V&quot;">
				        OR DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, DECODE(PO.QTYRCV1,0,'Y','N') ) = 'Y'
				        </if>
				      )
				</when>
			    <otherwise>
			    	AND ( 
				        1 = 2
				        <if test="STTNEW == &quot;V&quot;">
				        OR PO.IFFLG = 'N'
				        </if>
				        <if test="STTTC2 == &quot;V&quot;">
				        OR PO.IFFLG = 'Y'
				        </if>
				      )
			    </otherwise>
			  </choose>
			  <if test="LOTA14_TR_SQL != null and LOTA14_TR_SQL != ''">
				${LOTA14_TR_SQL}
			  </if>
			GROUP BY PO.EBELN
			ORDER BY PO.EBELN DESC
		) A
	</select>
	
	<select id="GR02_LIST_20220928_BK" parameterType="Map" resultType="DataMap">
		SELECT PO.WERKS AS OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = PO.WERKS), ' ') AS OWNRNM
			 , PO.EBELN
			 , PO.EBELN AS SEBELN
			 , PO.EBELN AS DOCKEY
			 , PO.WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = PO.WAREKY),' ') AS WARENM
			 , PO.BWART AS RCPTTY
			 , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS RCPTNM
			 , PO.EINDT AS ASNDAT
			 , PO.ORDCAT AS DOCCAT
			 , SZF_GET_DOCCAT_TEXT(#{LANGKY}, PO.ORDCAT) AS DOCCATNM
			 , TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT
			 , (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC ) AS AREAKY
			 , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC )),' ') AS AREANM
			 , PO.LIFNR AS DPTNKY
			 , MAX(BZ.NAME01) AS DPTNNM
			 , PO.BWART AS DOCUTY
			 , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS DOCTNM
			 , DECODE(SUM( CASE WHEN PO.IFFLG != 'Y' THEN 1 ELSE 0 END ), 0, 'FRV', 'NEW')  AS STATDO
             , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', DECODE(SUM( CASE WHEN PO.IFFLG != 'Y' THEN 1 ELSE 0 END ), 0, 'FRV', 'NEW') ) AS STATDONM
			 ,  ' ' AS DOCTXT
			 , PO.PTNRTY
			 , PO.BEDAT
			 , PO.IFID AS IFID_RECV
             , (CASE WHEN SUM(CASE WHEN TRIM(PO.LOTA14) IS NULL THEN 1 ELSE 0 END)=0 THEN 'N' ELSE 'Y' END) AS LOTA14_EMPTY_YN
             , CASE WHEN 0 = (SELECT COUNT(0) FROM COAMA WHERE SEBELN = PO.EBELN) THEN ' ' ELSE 'V' END AS COAYN
             , PO.MRFLG
             , PO.BWARTSAP
             , PO.DLEFLG
             , MAX(PO.AR_NO) AS AR_NO
     		 , MAX(PO.AR_REV) AS AR_REV
             , 'V' AS SAPIFYN
             , MAX(SLM.WMSMAK) AS WMSMAK
             , MAX( CASE WHEN SLT.SHTAYN = 'V' AND SLM.WMSMAK = 'V' THEN 'V' ELSE '' END ) AS IMIB01
     		 , MAX( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN 'V' ELSE '' END ) AS IMIB02
     		 , MAX( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) ELSE '' END ) AS IMIB02_LOTA01
     		 , SUM(PO.MENGE-PO.MENGE_R) AS QTYRCV1
		FROM IFWMS103 PO
		  LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
		  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
	 	  LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
		  LEFT OUTER JOIN LOTAT LT ON LT.LOTNUM = PO.LOTNUM
		  LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = #{OWNRKY} AND SLT.WAREKY = #{WAREKY} AND SLT.PLNTKY = PO.LOTA02 AND SLT.SKUKEY = PO.SKUKEY
		  LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = #{OWNRKY} AND SLM.PLNTKY = PO.LOTA02 AND SLM.STLKY  = NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) AND SLM.WMSMAK = 'V' 
		WHERE PO.WAREKY = #{WAREKY}
		  AND PO.WERKS  = #{OWNRKY} 
		  <if test="RCPTTY != null and RCPTTY != ''">
		  AND PO.BWART =  #{RCPTTY}
		  </if>
		  AND PO.STATUS IN ('U','C')
		  AND PO.IFFLG IN ('N','Y')
		  AND PO.PRCFLG = 'C'
		  AND PO.MRFLG != 'S0'
		  AND EXISTS (
                       SELECT 'X'
                       FROM DOCPG X
                       WHERE X.PROGID = #{PROGID}
                         AND X.DOCUTY = PO.BWART
                     )
		AND ( 
	          1 = 2
	          <if test="STTNEW == &quot;V&quot;">
	          OR PO.IFFLG = 'N'
	          </if>
	          <if test="STTTC2 == &quot;V&quot;">
	          OR PO.IFFLG = 'Y'
	          </if>
	        )
	    <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		</if>
		<if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		GROUP BY PO.WERKS,
				 PO.EBELN,
				 PO.WAREKY,
				 PO.BWART,
				 PO.EINDT,
				 PO.LIFNR,
			     PO.LGORT,
			     PO.BEDAT, 
			     PO.ORDCAT,
			     DT.SYSLOC,
			     PO.PTNRTY, 
			     PO.IFID,
			     PO.MRFLG,
			     PO.BWARTSAP,
			     PO.DLEFLG
		ORDER BY PO.EBELN DESC
	</select>
	
	<sql id="INBOUND_SUB_WITH_SQL">
		WITH SKUG05_T AS(
			SELECT CMCDKY
			     , CMCDVL
			     , CDESC1 
			     , CDESC2 
			     , USARG1 
			FROM CMCDV
			WHERE CMCDKY = 'SKUG05'
		),
		OE_T AS (
		    SELECT NVL(OE.NAME01,' ') AS OWNRNM
		    FROM OWNER OE 
		    WHERE OE.OWNRKY = #{OWNRKY}
		),
		WM_T AS (
		    SELECT NVL(WM.NAME01,' ') AS WARENM  
		    FROM WAHMA WM
		    WHERE WM.WAREKY = #{WAREKY}
		),
	    USR_T AS (
	        SELECT UM.USERID
	             , UM.NMLAST
	        FROM USRMA UM
	    )
	</sql>
	
	<sql id="INBOUND_SUB_WITH_TRANS_SQL">
		<if test="RCPTTY != null and RCPTTY == '121'">
		,
		TDI_T AS (
		    SELECT IWM103.EBELN
			     , IWM103.EBELP
			     , TI.OWNRKY
			     , TI.LOTA03 
                 , TI.LOTA04 
                 , TI.LOTA09 
                 , TI.LOTA17
			     , TI.LOTA11
			     , TI.LOTA14
			     , TI.LOTA15
			     , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, IWM103.SKUKEY, SUM(TI.QTCOMP), TI.AUOMKY, IWM103.MEINS)),'0.000') AS QTCOMP
			     , SK.LOTNUM
			     , LA.LOTA21
			     , LA.LOTA22
			     , LA.LOTA23
			     , LA.LOTA24
			     , IWM103.IFFLG
			FROM IFWMS103 IWM103
			  INNER JOIN SHPDI SI
			          ON SI.SVBELN = IWM103.EBELN
                     AND SI.SPOSNR = IWM103.EBELP
			  INNER JOIN TASDI TI
			          ON TI.OWNRKY = IWM103.WERKS
			         AND TI.SHPOKY = SI.SHPOKY
			         AND TI.SHPOIT = SI.SHPOIT
			         AND TI.LOTA15 = IWM103.LOTA15
			         AND TI.LOTA15 != ' '
			         AND TI.STATIT IN ('FPC', 'PPC')
			         AND TI.TASKTY = 'PK'  	
			  INNER JOIN TASDR TR
			          ON TR.TASKKY = TI.TASKKY 
			         AND TR.TASKIT = TI.TASKIT 
			         AND TR.TASKIR = (
			                            SELECT MIN(X.TASKIR)
			                            FROM TASDR X
			                            WHERE X.TASKKY = TR.TASKKY 
			                              AND X.TASKIT = TR.TASKIT
			                            GROUP BY X.TASKKY, X.TASKIT
			                         )
			  INNER JOIN STKKY SK
			          ON SK.STOKKY = TR.STOKKY
			  INNER JOIN LOTAT LA
			          ON LA.LOTNUM = SK.LOTNUM
			WHERE IWM103.BWART = '121'
			  AND IWM103.WERKS = #{OWNRKY}
			  AND IWM103.EBELN = #{SEBELN}
              AND (IWM103.MRFLG != 'S0'  
			  	   OR ( IWM103.MRFLG  = 'S0'
			  		     AND IWM103.LOTA01 != '2400' 
			  		     AND IWM103.LOTA02 LIKE CASE WHEN IWM103.BWART = '121' THEN '%' ELSE 'P100' END 
			  		  )
                  )
			  AND IWM103.STATUS IN ('U','C')
			  AND IWM103.IFFLG IN ('N','Y') 
			  AND IWM103.PRCFLG = 'C'
			  AND EXISTS (
			               SELECT 'X'
			               FROM STLMA X
			               WHERE X.OWNRKY = #{OWNRKY} 
			                 AND X.WAREKY = (
			                                  SELECT MAX(SA.WAREKY)
			                                  FROM STLMA SA
			                                  WHERE SA.OWNRKY = #{OWNRKY} 
			                                    AND SA.PLNTKY = IWM103.FLOTA02 
			                                    AND SA.STLKY = IWM103.FLOTA01
			                                )
			                 AND X.WMSMAK = 'V'
			                 AND X.OWNRKY = IWM103.WERKS
                 			 AND X.PLNTKY = IWM103.FLOTA02
                 			 AND X.STLKY = IWM103.FLOTA01
			             )
			GROUP BY IWM103.EBELN, IWM103.EBELP, TI.LOTA14, TI.LOTA15, TI.OWNRKY
				 , TI.LOTA03, TI.LOTA04, TI.LOTA09, TI.LOTA17
			     , TI.LOTA11, SK.LOTNUM, LA.LOTA21, LA.LOTA22, LA.LOTA23
			     , LA.LOTA24, IWM103.SKUKEY, IWM103.IFFLG, TI.AUOMKY, IWM103.MEINS
		),
		RICNT_T AS (
			SELECT RI.SEBELN, RI.SEQNO, RI.LOTA14, COUNT(1) AS CNT
			FROM RECDI RI
			WHERE RI.SEBELN =#{SEBELN}
			  AND EXISTS (
			                SELECT 'X'
			                FROM RECDH RH
			                WHERE RH.RECVKY = RI.RECVKY
			                  AND RH.STATDO != 'RCN'
			             )
			GROUP BY RI.SEBELN, RI.SEQNO, RI.LOTA14
		)
		</if>
	</sql>
	
	<sql id="INBOUND_SUB_TOP_SQL">
		SELECT PO.WERKS AS OWNRKY
			 , (SELECT OWNRNM FROM OE_T) AS OWNRNM
		     , PO.WAREKY
		     , (SELECT WARENM FROM WM_T) AS WARENM
			 , NVL(DECODE(SM.SKUG05, '10', ZT.PALCNT, NVL(MIP.QTPUOM,'0.000')), '0.000') AS PALQTY -- 2022.03.11 팔레트 입수량 추가
			 , PO.SKUKEY
		     , SM.DESC01 
		     , SM.DESC02
		     , DT.SYSLOC AS LOCAKY
		     , ' ' AS TRNUID
		     , PO.MENGE
		     , TO_CHAR(SUM(PO.MENGE) OVER(PARTITION BY PO.SKUKEY ORDER BY PO.SKUKEY), 'FM99999999999999999990.000')||' / '||PO.SKUKEY AS SUM_ITEM
		 
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE_R
		     , PO.PTNRTY
		     , NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) AS LOTA01
		     , PO.LOTA01 AS LOTA01_ORG
		     , PO.LOTA02
		     , PO.LOTA02 AS LOTA02_ORG
		     , PO.LOTA05
		     , PO.LOTA06
		     , (
		     		CASE WHEN PO.BWART='131' AND PO.SOBKZ='E' THEN TRIM(PO.VGBEL)||TRIM(PO.VGPOS)
		     		 	 ELSE PO.LOTA07
		     		END
		        ) AS LOTA07
		     , PO.LOTA07 AS LOTA07_ORG
		     , PO.LOTA08
		     , PO.LOTA08 AS LOTA08_ORG
		     , PO.LOTA10
		     --, NVL(TRIM(PO.LOTA12),TO_CHAR(SYSDATE,'YYYYMMDD')) AS LOTA12
		     , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA12
		     , PO.LOTA13
		     , PO.LOTA15
		     , PO.LOTA16
		     , PO.LOTA16 AS LOTA16_ORG
		     <choose>
		     	<when test="RCPTTY != null and RCPTTY == '121'">
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA03, TI_T.LOTA03 ) AS LOTA03
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA03, TI_T.LOTA03 ) AS LOTA03_ORG
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA04, TI_T.LOTA04 ) AS LOTA04
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA09, TI_T.LOTA09 ) AS LOTA09
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA17, TI_T.LOTA17 ) AS LOTA17
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA17, TI_T.LOTA17 ) AS LOTA17_ORG
		      	</when>
				<otherwise>
				 	, PO.LOTA03
			     	, PO.LOTA03 AS LOTA03_ORG
			     	, PO.LOTA04
			     	, PO.LOTA09
				 	, PO.LOTA17
			     	, PO.LOTA17 AS LOTA17_ORG
				</otherwise>
			 </choose>
		     , PO.LOTA18
		     , PO.LOTA19
		     , PO.LOTA20
		     , PO.EBELN  AS SEBELN
		     , PO.EBELP  AS SEBELP
		     , ' '       AS RECVKY
		     , ' '       AS RECVIT
		     , PO.MANDT
		     , PO.SEQNO
		     , PO.EBELN
		     , PO.EBELP
		     , PO.BEDAT
		     , PO.BWART
		     , PO.RTNRSN AS RSNCOD-- 반품사유
		     , SZF_GET_RSNCOD_TEXT(#{LANGKY}, #{OWNRKY}, NVL(DT.DOCCAT, '100'), PO.BWART, PO.RTNRSN) AS RSNCODNM -- 반품사유명
		     <choose>
		     	<when test="RCPTTY != null and RCPTTY == '131' and STATDO=='NEW'">
             , '' AS RCPRSN -- 상세사유
		      	</when>
		     	<when test="RCPTTY != null and RCPTTY == '131' and STATDO=='FRV'">
             , NVL((SELECT MAX(RCPRSN) FROM RECDI WHERE SEBELN = PO.EBELN AND SEBELP = PO.EBELP AND STATIT = 'FRV'),' ') AS RCPRSN -- 상세사유2424
		      	</when>
				<otherwise>
             , PO.RTNTXT AS RCPRSN -- 상세사유
				</otherwise>
			 </choose>
		     , SM.ASKU05
		     , SW.MEASKY AS MEASKY 
		     , SM.EANCOD
		     , MI.UOMKEY AS MUOMKEY
		     <choose>
		       <when test="RCPTTY != null and RCPTTY == '121'">
			    , ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), 'FM99999999999999999990.000') END ) AS QTYRCV1
     			, ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN TO_CHAR(TI_T.QTCOMP, 'FM99999999999999999990.000') ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP ), 'FM99999999999999999990.000') END ) AS QTYRCV
     			 , TO_CHAR(SUM(( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN TO_CHAR(TI_T.QTCOMP, 'FM99999999999999999990.000') ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP ), 'FM99999999999999999990.000') END )) OVER(PARTITION BY PO.SKUKEY ORDER BY PO.SKUKEY), 'FM99999999999999999990.000')||' / '||PO.SKUKEY AS SUM_ITEM2
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA11, TI_T.LOTA11 ) AS LOTA11
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA14, TI_T.LOTA14 ) AS LOTA14
			    , CASE WHEN SZF_GET_DOCUTY_TEXT('', PO.BWART) = '구매입고' AND PO.MEINS = 'KG' AND MI.UOMKEY = 'R' 
			           THEN NVL(TRIM(SZF_GET_DEFAULT_QTY_R(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', TI_T.QTCOMP, DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP )), PO.MEINS)),'0.00') 
			    	   ELSE NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', TI_T.QTCOMP, DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP )), PO.MEINS)),'0.000') 
			    	   END AS UOMQTY
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'KG')),'0.000') AS TOT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'BAG')),'0.000') AS BAG
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'BOX')),'0.000') AS BOX
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'PAL')),'0.000') AS PLT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'SOK')),'0.000') AS SOK
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'EA')),'0.000') AS EA
			    , CASE WHEN DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ) = 0 THEN 0 
					   ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'BOX'))),'0.000')
				   END AS BOXBAG
			    , TRIM(TI_T.EBELN) AS TEBELN
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA21, TI_T.LOTA21 ) AS LOTA21
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA22, TI_T.LOTA22 ) AS LOTA22
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA23, TI_T.LOTA23 ) AS LOTA23
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA24, TI_T.LOTA24 ) AS LOTA24
			    , DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, 'Y' ) AS IFFLG
			   </when>
			   <otherwise>
			    , ( CASE WHEN BWART ='111' AND ( PO.DLEFLG = 'Y' ) THEN '0.000' 
			             WHEN BWART !='111' AND ( PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y') THEN '0.000'  ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV1
     			, ( CASE WHEN BWART ='111' AND ( PO.DLEFLG = 'Y' ) THEN '0.000' 
			             WHEN BWART !='111' AND ( PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y') THEN '0.000'  ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END )  AS QTYRCV
			   <!--  , ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV1
     			, ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV -->
     			 , TO_CHAR(SUM(( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END )) OVER(PARTITION BY PO.SKUKEY ORDER BY PO.SKUKEY), 'FM99999999999999999990.000')||' / '||PO.SKUKEY AS SUM_ITEM2
			    , CASE WHEN PO.BWART = '131' AND PO.LOTA11 = ' ' 
			           THEN TO_CHAR(SYSDATE, 'YYYYMMDD') 
			           ELSE PO.LOTA11 END AS LOTA11
			    , PO.LOTA14
			    , CASE WHEN SZF_GET_DOCUTY_TEXT('', PO.BWART) = '구매입고' AND PO.MEINS = 'KG' AND MI.UOMKEY = 'R' 
			           THEN NVL(TRIM(SZF_GET_DEFAULT_QTY_R(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.00',(PO.MENGE - PO.MENGE_R)), PO.MEINS)),'0.00') 
			    	   ELSE NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.000',(PO.MENGE - PO.MENGE_R)), PO.MEINS)),'0.000')
			    	   END AS UOMQTY
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'KG')),'0.000') AS TOT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BAG')),'0.000') AS BAG
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BOX')),'0.000') AS BOX
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'PAL')),'0.000') AS PLT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'SOK')),'0.000') AS SOK
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'EA')),'0.000') AS EA
			    , CASE WHEN (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END) = 0 THEN 0 
					   ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BOX'))),'0.000')
				   END AS BOXBAG
			    , '' AS TEBELN
			    , PO.LOTA21
	            , PO.LOTA22
	            , PO.LOTA23
	            , PO.LOTA24
	            , PO.IFFLG
			   </otherwise>
			 </choose>
			 , PO.CREDAT
		 	 , PO.CRETIM
		 	 , PO.CREUSR
		 	 , PO.LMODAT
		 	 , PO.LMOTIM
		 	 , PO.LMOUSR
		 	 , PO.INDBZL
		 	 , PO.INDARC
		 	 , PO.UPDCHK
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.CREUSR),' ') AS CUSRNM
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.LMOUSR),' ') AS LUSRNM
		 	 , SLM.STLNM AS LOTA01NM
			 , (SELECT LM.AREAKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC ) AS AREAKY
		 	 , NVL((SELECT AM.SHORTX FROM AREMA AM WHERE AM.WAREKY = PO.WAREKY AND EXISTS ( SELECT 'X' FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC AND LM.AREAKY = AM.AREAKY )),' ') AS AREANM
			 , 'FRV' AS STATIT
			 , SM.SKUG01
			 , SM.SKUG02
			 , SM.SKUG03
			 , NVL((SELECT X.USARG1 FROM SKUG05_T X WHERE X.CMCDVL=SM.SKUG05),SKUG04) AS SKUG04
			 , SM.SKUG05
			 , SM.SKUG05 AS SKUG05_1
			 , SLT.QRTAYN
			 , SLT.SHTAYN
			 , SLME.WMSMAK AS FWMSMAK
			 , PO.BWART AS RCPTTY
			 , PO.LIFNR AS DPTNKY
			 , PO.ZEKKO_AEDAT
			 , PO.EINDT AS ASNDAT
			 , 'NEW' AS STATDO
			 , NVL(#{DOCDAT},TO_CHAR(SYSDATE,'YYYYMMDD')) AS DOCDAT
			 , NVL((SELECT DOCCAT FROM DOCTM WHERE DOCUTY = PO.BWART), '100') AS DOCCAT
			 , PO.SIGNI
			 , DECODE(PO.BWART, '111', PO.SSORNU, PO.VGBEL) AS VGBEL
			 , DECODE(PO.BWART, '111', PO.SSORIT, PO.VGPOS) AS VGPOS
			 , PO.MRFLG
			 , PO.AR_NO
			 , PO.AR_REV
			 , PO.AR_LNO
			 , PO.BWARTSAP
			 , PO.POREV
		 	 , PO.SSORNU
			 , PO.SSORIT
			 , PO.DLEFLG
			 , PO.SERV1
			 , 'V' AS SAPIFYN
			 , SLM.WMSMAK
	</sql>
	
	<sql id="INBOUND_SUB_IFID_SQL">
			, (
                CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_214,WMS_IF_215'          -- 입고실적정보(자재,상품)
                     WHEN PO.IFID = 'WMS_IF_204' THEN 'WMS_IF_216'                     -- 입고실적정보(이송)
                     WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_221,WMS_IF_222'          -- 입고실적정보(제품) SAP,입고실적정보(제품) MES
                     WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_217'                     -- 반품입고실적정보 SAP
                     WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_218,WMS_IF_224'          -- 반납입고실적정보 MES,반납입고실적정보(자재)
                     ELSE '' 
                END
               ) AS IFID -- 실적IFID
			, (
                CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_215'                     -- 입고실적정보(자재,상품) SAP
                     WHEN PO.IFID = 'WMS_IF_204' THEN 'WMS_IF_216'                     -- 입고실적정보(이송) SAP
                     WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_221'                     -- 입고실적정보(제품) SAP
                     WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_217'                     -- 반품입고실적정보 SAP
                     WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_224'                     -- 반납입고실적정보(자재) SAP
                     ELSE '' 
                END
              ) AS IFID_SAP -- 실적IFID_SAP
            , (
                CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_214'                     -- 입고실적정보(자재,상품) PORTAL
                     ELSE '' 
                END
              ) AS IFID_PTL -- 실적IFID(PORTAL)
            , (
                CASE WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_222'                     -- 입고실적정보(제품) MES
                     WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_218'                     -- 반납입고실적정보 MES
                     ELSE '' 
                END
              ) AS IFID_MES -- 실적IFID(MES)
            , (
               CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_208'                      -- 입고실적정보(자재,상품)
                    WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_212'                      -- 반품입고실적정보 SAP
                    ELSE '' 
               END
              ) AS IFID_QTR -- 품질검사IFID
            , (
               CASE WHEN SLT.SHTAYN = 'V' THEN 'WMS_IF_310'                            -- 즉시불출
                    ELSE '' 
               END
              ) AS IFID_STN -- 즉시분출 IFID
            , (
                CASE WHEN PO.BWART = '121' AND PO.MRFLG = 'S0' THEN 'WMS_IF_404'       -- 수입밀롤
                     ELSE '' 
                END                 
              ) AS IFID_ITM -- 수입밀롤 IFID
            , (
                CASE WHEN PO.BWART = '131' THEN 'WMS_IF_401' -- 반품입고 재고상태 변경
                     ELSE '' 
                END                 
              ) AS IFID_RTN -- 반품입고 재고상태 변경 IFID
	</sql>
	
	<sql id="INBOUND_HEAD_CANCEL_IFID_SQL">
			, (
                CASE WHEN T1.IFID = 'WMS_IF_202' THEN 'WMS_IF_215'            		-- 입고실적정보(자재,상품) SAP
                     WHEN T1.IFID = 'WMS_IF_204' THEN 'WMS_IF_216'            		-- 입고실적정보(이송) SAP
                     WHEN T1.IFID = 'WMS_IF_205' THEN 'WMS_IF_221'            		-- 입고실적정보(제품) SAP
                     WHEN T1.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_217'            		-- 반품입고실적정보 SAP
                     WHEN T1.IFID = 'WMS_IF_207' THEN 'WMS_IF_224'            		-- 반납입고실적정보(자재) SAP
                     WHEN T1.RCPTTY = '199'      THEN 'WMS_IF_219'                 -- 재고조정입고 SAP
                     ELSE '' 
                END
              ) AS IFID_SAP -- 실적IFID_SAP
            , (
                CASE WHEN T1.IFID = 'WMS_IF_202' THEN 'WMS_IF_214'            		-- 입고실적정보(자재,상품) PORTAL
                     ELSE '' 
                END
              ) AS IFID_PTL -- 실적IFID(구매포탈)
            , (
                CASE WHEN T1.IFID = 'WMS_IF_205' THEN 'WMS_IF_222'            		-- 입고실적정보(제품) MES
                     WHEN T1.IFID = 'WMS_IF_207' THEN 'WMS_IF_218'            		-- 반납입고실적정보 MES                     
                     ELSE '' 
                END
              ) AS IFID_MES -- 실적IFID(MES)
            , (
               CASE WHEN T1.IFID = 'WMS_IF_202' THEN 'WMS_IF_208'                  -- 입고실적정보(자재,상품)
                    WHEN T1.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_212'                  -- 반품입고실적정보 SAP
                    ELSE '' 
               END
              ) AS IFID_QTR -- 품질검사IFID
             , (
               CASE WHEN (CASE WHEN T1.SHTAYN = 'V' THEN 'V' ELSE '' END) = 'V' THEN 'WMS_IF_310' -- 즉시불출
                    ELSE '' 
               END
              ) AS IFID_STN -- 즉시분출 IFID
             , (
                CASE WHEN T1.BWARTSAP = '641'    THEN 'Z_WMS_MAT_DOC_CANCEL'       -- 이동유형 641은 무조건 DOC_CANCEL
                	 WHEN T1.IFID = 'WMS_IF_202' THEN 'Z_WMS_MAT_DOC_CANCEL'       -- 입고실적정보(자재,상품) SAP
                     WHEN T1.IFID = 'WMS_IF_204' THEN 'Z_WMS_DELIVERY_CANCEL'      -- 입고실적정보(이송) SAP
                     WHEN T1.IFID = 'WMS_IF_205' THEN 'Z_WMS_MAT_DOC_CANCEL'       -- 입고실적정보(제품) SAP
                     WHEN T1.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'Z_WMS_DELIVERY_CANCEL'      -- 반품입고실적정보 SAP
                     WHEN T1.IFID = 'WMS_IF_207' THEN 'Z_WMS_MAT_DOC_CANCEL'       -- 반납입고실적정보(자재) SAP
                     WHEN T1.RCPTTY = '199'      THEN 'Z_WMS_MAT_DOC_CANCEL'       -- 재고조정입고 SAP
                     ELSE '' 
                END
              ) AS SAP_RFCFN
             , (
                CASE WHEN T1.RCPTTY = '121' AND T1.MRFLG = 'S0' THEN 'Z_WMS_MR_DELIVERY_CANCEL'       -- 수입밀롤
                     ELSE '' 
                END                 
              ) AS SAP_RFCFN_ITM -- 수입밀롤 RFC
	</sql>
	
	<sql id="INBOUND_SUB_CANCEL_IFID_SQL">
			, (
                CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_214,WMS_IF_215'          -- 입고실적정보(자재,상품)
                     WHEN PO.IFID = 'WMS_IF_204' THEN 'WMS_IF_216'                     -- 입고실적정보(이송)
                     WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_221,WMS_IF_222'          -- 입고실적정보(제품) SAP,입고실적정보(제품) MES
                     WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_217'                     -- 반품입고실적정보 SAP
                     WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_218,WMS_IF_224'          -- 반납입고실적정보 MES,반납입고실적정보(자재)
                     ELSE '' 
                END
               ) AS IFID -- 실적IFID
			, (
                CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_215'                     -- 입고실적정보(자재,상품) SAP
                     WHEN PO.IFID = 'WMS_IF_204' THEN 'WMS_IF_216'                     -- 입고실적정보(이송) SAP
                     WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_221'                     -- 입고실적정보(제품) SAP
                     WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_217'                     -- 반품입고실적정보 SAP
                     WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_224'                     -- 반납입고실적정보(자재) SAP
                     ELSE '' 
                END
              ) AS IFID_SAP -- 실적IFID_SAP
            , (
                CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_214'                     -- 입고실적정보(자재,상품) PORTAL
                     ELSE '' 
                END
              ) AS IFID_PTL -- 실적IFID(구매포탈)
            , (
                CASE WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_222'                     -- 입고실적정보(제품) MES
                     WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_218'                     -- 반납입고실적정보 MES
                     ELSE '' 
                END
              ) AS IFID_MES -- 실적IFID(MES)
            , (
               CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_208'                      -- 입고실적정보(자재,상품)
                    WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_212'                      -- 반품입고실적정보 SAP
                    ELSE '' 
               END
              ) AS IFID_QTR -- 품질검사IFID
            , (
<!--                CASE WHEN SLT.SHTAYN = 'V' THEN 'WMS_IF_310'                             -->
               CASE WHEN RI.SHTAYN = 'V' THEN 'WMS_IF_310'                            -- 즉시불출
                    ELSE '' 
               END
              ) AS IFID_STN -- 즉시분출 IFID
            , (
                CASE WHEN PO.BWART = '121' AND PO.MRFLG = 'S0' THEN 'WMS_IF_404'       -- 수입밀롤
                     ELSE '' 
                END                 
              ) AS IFID_ITM -- 수입밀롤 IFID
            , (
                CASE WHEN PO.BWART = '131' THEN 'WMS_IF_401' -- 반품입고 재고상태 변경
                     ELSE '' 
                END                 
              ) AS IFID_RTN -- 반품입고 재고상태 변경 IFID
	</sql>
	
	<sql id="INBOUND_HEAD_ML_CANCEL_IFID_SQL">
			, (
                CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_215'            			-- 입고실적정보(자재,상품) SAP
                     WHEN PO.IFID = 'WMS_IF_204' THEN 'WMS_IF_216'            			-- 입고실적정보(이송) SAP
                     WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_221'            			-- 입고실적정보(제품) SAP
                     WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_217'            			-- 반품입고실적정보 SAP
                     WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_224'            			-- 반납입고실적정보(자재) SAP
                     WHEN MAX(RH.RCPTTY) = '199' THEN 'WMS_IF_219'                      -- 재고조정입고 SAP
                     ELSE '' 
                END
              ) AS IFID_SAP -- 실적IFID_SAP
             , (
                CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_214'            			-- 입고실적정보(자재,상품) PORTAL
                     ELSE '' 
                END
              ) AS IFID_PTL -- 실적IFID(구매포탈)
             , (
                CASE WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_222'            			-- 입고실적정보(제품) MES
                     WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_218'            			-- 반납입고실적정보 MES                     
                     ELSE '' 
                END
              ) AS IFID_MES -- 실적IFID(MES)
             , (
               CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_208'                  -- 입고실적정보(자재,상품)
                    WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_212'                  -- 반품입고실적정보 SAP
                    ELSE '' 
               END
              ) AS IFID_QTR -- 품질검사IFID
             , (
               CASE WHEN MAX(CASE WHEN SLT.SHTAYN = 'V' THEN 'V' ELSE '' END) = 'V' THEN 'WMS_IF_310' -- 즉시불출
                    ELSE '' 
               END
              ) AS IFID_STN -- 즉시분출 IFID 
             , (
                CASE WHEN PO.BWARTSAP = '641'    THEN 'Z_WMS_MAT_DOC_CANCEL'            -- 이동유형 641은 무조건 DOC_CANCEL
                	 WHEN PO.IFID = 'WMS_IF_202' THEN 'Z_WMS_MAT_DOC_CANCEL'            -- 입고실적정보(자재,상품) SAP
                     WHEN PO.IFID = 'WMS_IF_204' THEN 'Z_WMS_DELIVERY_CANCEL'           -- 입고실적정보(이송) SAP
                     WHEN PO.IFID = 'WMS_IF_205' THEN 'Z_WMS_MAT_DOC_CANCEL'            -- 입고실적정보(제품) SAP
                     WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'Z_WMS_DELIVERY_CANCEL'           -- 반품입고실적정보 SAP
                     WHEN PO.IFID = 'WMS_IF_207' THEN 'Z_WMS_MAT_DOC_CANCEL'            -- 반납입고실적정보(자재) SAP
                     WHEN MAX(RH.RCPTTY) = '199' THEN 'Z_WMS_MAT_DOC_CANCEL'            -- 재고조정입고 SAP
                     ELSE '' 
                END
              ) AS SAP_RFCFN
             , (
                CASE WHEN PO.BWART = '121' AND PO.MRFLG = 'S0' THEN 'Z_WMS_MR_DELIVERY_CANCEL'       -- 수입밀롤
                     ELSE '' 
                END                 
              ) AS SAP_RFCFN_ITM -- 수입밀롤 RFC 
	</sql>
	
	<sql id="INBOUND_SUB_FROM_SQL">
		FROM IFWMS103 PO
		  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
		  LEFT OUTER JOIN SKUWC SW ON SW.WAREKY = #{WAREKY} AND SW.OWNRKY = #{OWNRKY} AND SW.SKUKEY = PO.SKUKEY
		  LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
		  LEFT OUTER JOIN LOTAT LT ON LT.LOTNUM = PO.LOTNUM
		  LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
		  LEFT OUTER JOIN MEASI MI ON MI.WAREKY = #{WAREKY} AND MI.MEASKY = PO.SKUKEY AND MI.INDDFU = 'V'
		  LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = #{OWNRKY} AND SLT.WAREKY = #{WAREKY} AND SLT.PLNTKY = PO.LOTA02 AND SLT.SKUKEY = PO.SKUKEY
		  LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = #{OWNRKY} AND SLM.PLNTKY = PO.LOTA02 AND SLM.STLKY  = NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY))
		  LEFT OUTER JOIN MEASI MIP ON MIP.WAREKY = #{WAREKY} AND MIP.MEASKY = PO.SKUKEY AND MIP.UOMKEY = 'PAL'		  
		  LEFT OUTER JOIN ZPPTM ZT ON ZT.LOTA02 = PO.LOTA02 AND ZT.LOTA03 = PO.LOTA03 AND ZT.LOTA09 = PO.LOTA09 AND ZT.LOTA16 = PO.LOTA16 AND ZT.LOTA17 = PO.LOTA17
		  LEFT OUTER JOIN STLMA SLME ON SLME.OWNRKY = #{OWNRKY} AND SLME.PLNTKY = PO.FLOTA02 AND SLME.STLKY = PO.FLOTA01
		  
	</sql>
	
	<sql id="INBOUND_SUB_FROM_TRANS_SQL">
		  <if test="RCPTTY != null and RCPTTY == '121'">
		  LEFT OUTER JOIN TDI_T TI_T ON TI_T.EBELN = PO.EBELN AND TI_T.EBELP = PO.EBELP AND TI_T.LOTA15 = PO.LOTA15 AND TI_T.IFFLG = PO.IFFLG
		  LEFT OUTER JOIN RICNT_T RT_T ON RT_T.SEBELN = PO.EBELN AND RT_T.SEQNO = PO.SEQNO AND RT_T.LOTA14 = TI_T.LOTA14
		  </if> 
	</sql>
	
	<sql id="INBOUND_SUB_WHERE_SQL">	  
		WHERE PO.WAREKY = #{WAREKY}
		  AND PO.WERKS = #{OWNRKY}		  
          AND PO.STATUS IN ('U','C')
          AND PO.IFFLG IN ('N','Y') 
          AND PO.PRCFLG = 'C'
          AND EXISTS (
                       SELECT 'X'
                       FROM DOCPG X
                       WHERE X.PROGID = #{PROGID}
                         AND X.DOCUTY = PO.BWART
                     )
	</sql>
	
	<sql id="INBOUND_SUB_SORT_SQL">
		<choose>
	       <when test="RCPTTY != null and RCPTTY == '121'">
		    ORDER BY PO.EBELN, PO.EBELP, PO.SEQNO
		   </when>
		   <otherwise>
		    ORDER BY PO.EBELN, PO.EBELP
		   </otherwise>
		 </choose>
	</sql>
	
	
	<select id="GR02Sub_LIST" parameterType="Map" resultType="DataMap">
		
		<include refid="WmsInbound.INBOUND_SUB_WITH_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WITH_TRANS_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_TOP_SQL"/>
		     , ' ' AS LOTA41
			 , ' ' AS LOTA42
			 , ' ' AS LOTA43
			 , ' ' AS LOTA44
			 , ' ' AS LOTA45
			 , '0' AS LOTA46
			 , '0' AS LOTA47
			 , '0' AS LOTA48
			 , ' ' AS LOTA49
		<include refid="WmsInbound.INBOUND_SUB_IFID_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_TRANS_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WHERE_SQL"/>
          AND PO.EBELN = #{SEBELN}
          AND (PO.MRFLG != 'S0' 
               OR (PO.MRFLG = 'S0' 
               	   AND PO.LOTA01 != '2400' 
               	   AND PO.LOTA02 LIKE CASE WHEN PO.BWART = '121' THEN '%' ELSE 'P100' END 
                  )
              )   
          AND ( 
	          1 = 2
	          <if test="STTNEW == &quot;V&quot;">
	          OR PO.IFFLG = 'N'
	          </if>
	          <if test="STTTC2 == &quot;V&quot;">
	          OR PO.IFFLG = 'Y'
	          </if>
	        )
	      <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		  </if>
		  <if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		  </if>
		  
		  <choose>
		       <when test="RCPTTY != null and RCPTTY == '121'">
		       	${LOTA14_TR_SQL}
			   </when>
			   <otherwise>
			   	${LOTA14_SQL}
			   </otherwise>
		 </choose>
			 
		 <include refid="WmsInbound.INBOUND_SUB_SORT_SQL"/>
         
	</select>
	
	<select id="GR02Sub_LIST_20220929_BK" parameterType="Map" resultType="DataMap">
		
		<include refid="WmsInbound.INBOUND_SUB_WITH_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WITH_TRANS_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_TOP_SQL"/>
		     , ' ' AS LOTA41
			 , ' ' AS LOTA42
			 , ' ' AS LOTA43
			 , ' ' AS LOTA44
			 , ' ' AS LOTA45
			 , '0' AS LOTA46
			 , '0' AS LOTA47
			 , '0' AS LOTA48
			 , ' ' AS LOTA49
		<include refid="WmsInbound.INBOUND_SUB_IFID_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_TRANS_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WHERE_SQL"/>
          AND PO.EBELN = #{SEBELN}
          AND PO.MRFLG != 'S0'
          AND ( 
	          1 = 2
	          <if test="STTNEW == &quot;V&quot;">
	          OR PO.IFFLG = 'N'
	          </if>
	          <if test="STTTC2 == &quot;V&quot;">
	          OR PO.IFFLG = 'Y'
	          </if>
	        )
	      <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		  </if>
		  <if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		  </if>
         <include refid="WmsInbound.INBOUND_SUB_SORT_SQL"/>
         
	</select>
	
	<select id="GR02SubShort_LIST" parameterType="Map" resultType="DataMap">
		<include refid="WmsInbound.INBOUND_SUB_WITH_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WITH_TRANS_SQL"/>
		SELECT PO.WERKS AS OWNRKY
		     , PO.WAREKY
			 , PO.SKUKEY
		     , SM.DESC01
		     , SM.DESC02
		     , DT.SYSLOC AS LOCAKY
		     , ' ' AS TRNUID
		     , PO.MENGE
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE_R
		     , PO.PTNRTY
		     , NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) AS LOTA01
		     , PO.LOTA01 AS LOTA01_ORG
		     , PO.LOTA02
		     , PO.LOTA02 AS LOTA02_ORG
		     , PO.LOTA03
		     , PO.LOTA03 AS LOTA03_ORG
		     , PO.LOTA04
		     , PO.LOTA05
		     , PO.LOTA06
		     , (
		     		CASE WHEN PO.BWART='131' AND PO.SOBKZ='E' THEN TRIM(PO.VGBEL)||TRIM(PO.VGPOS)
		     		 	 ELSE PO.LOTA07
		     		END
		        ) AS LOTA07
		     , PO.LOTA07 AS LOTA07_ORG
		     , PO.LOTA08
		     , PO.LOTA08 AS LOTA08_ORG
		     , PO.LOTA09
		     , PO.LOTA10
		     , PO.LOTA11
		     , NVL(TRIM(PO.LOTA12),TO_CHAR(SYSDATE,'YYYYMMDD')) AS LOTA12
		     , PO.LOTA13
		     , PO.LOTA15
		     , PO.LOTA16
		     , PO.LOTA16 AS LOTA16_ORG
		     , PO.LOTA17
		     , PO.LOTA17 AS LOTA17_ORG
		     , PO.LOTA18
		     , PO.LOTA19
		     , PO.LOTA20
		     , PO.EBELN AS SEBELN
		     , PO.EBELP AS SEBELP
		     , ' '      AS RECVKY
		     , ' '      AS RECVIT
		     , PO.MANDT
		     , PO.SEQNO		     
		     , PO.EBELN
		     , PO.EBELP
		     , PO.BEDAT
		     , PO.BWART
		     , PO.RTNRSN AS RSNCOD-- 반품사유
             , PO.RTNTXT AS RCPRSN -- 상세사유
		     , SM.ASKU05
		     , SW.MEASKY AS MEASKY 
		     , SM.EANCOD
		     , MI.UOMKEY AS MUOMKEY
		     <choose>
		       <when test="RCPTTY != null and RCPTTY == '121'">
			    , ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP ), 'FM99999999999999999990.000') END ) AS QTYRCV1
     			, ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP ), 'FM99999999999999999990.000') END ) AS QTYRCV
     			,  TO_CHAR(SUM( ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN TO_CHAR(TI_T.QTCOMP, 'FM99999999999999999990.000') ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP ), 'FM99999999999999999990.000') END )) OVER(PARTITION BY PO.SKUKEY ORDER BY PO.SKUKEY), 'FM99999999999999999990.000')||' / '||PO.SKUKEY AS SUM_ITEM2
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA11, TI_T.LOTA11 ) AS LOTA11
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA14, TI_T.LOTA14 ) AS LOTA14
			    , NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.000',DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP )), PO.MEINS)),'0.000') AS UOMQTY
			    , TRIM(TI_T.EBELN) AS TEBELN
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA21, TI_T.LOTA21 ) AS LOTA21
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA22, TI_T.LOTA22 ) AS LOTA22
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA23, TI_T.LOTA23 ) AS LOTA23
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA24, TI_T.LOTA24 ) AS LOTA24
			    , DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, 'Y' ) AS IFFLG
			   </when>
			   <otherwise>
			   , ( CASE WHEN BWART ='111' AND ( PO.DLEFLG = 'Y' ) THEN '0.000' 
			             WHEN BWART !='111' AND ( PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y') THEN '0.000'  ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV1
     			, ( CASE WHEN BWART ='111' AND ( PO.DLEFLG = 'Y' ) THEN '0.000' 
			             WHEN BWART !='111' AND ( PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y') THEN '0.000'  ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END )  AS QTYRCV
			   <!--  , ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV1
     			, ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV -->
			    , PO.LOTA11
			    , PO.LOTA14
			    , NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.000',(PO.MENGE - PO.MENGE_R)), PO.MEINS)),'0.000') AS UOMQTY
			    , '' AS TEBELN
			    , PO.LOTA21
	            , PO.LOTA22
	            , PO.LOTA23
	            , PO.LOTA24
	            , PO.IFFLG
			   </otherwise>
			 </choose>
			 , PO.CREDAT
		 	 , PO.CRETIM
		 	 , PO.CREUSR
		 	 , PO.LMODAT
		 	 , PO.LMOTIM
		 	 , PO.LMOUSR
		 	 , PO.INDBZL
		 	 , PO.INDARC
		 	 , PO.UPDCHK
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.CREUSR),' ') AS CUSRNM
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.LMOUSR),' ') AS LUSRNM
		 	 , SLM.STLNM AS LOTA01NM
			 , (SELECT LM.AREAKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC ) AS AREAKY
			 , 'FRV' AS STATIT
			 , SM.SKUG01
			 , SM.SKUG02
			 , SM.SKUG03
			 , NVL((SELECT X.USARG1 FROM SKUG05_T X WHERE X.CMCDVL=SM.SKUG05),SKUG04) AS SKUG04
			 , SM.SKUG05
			 , SM.SKUG05 AS SKUG05_1
			 , SLT.QRTAYN
			 , SLT.SHTAYN
			 , SLME.WMSMAK AS FWMSMAK
			 , PO.BWART AS RCPTTY
			 , PO.LIFNR AS DPTNKY
			 , PO.ZEKKO_AEDAT
			 , PO.EINDT AS ASNDAT
			 , 'NEW' AS STATDO
			 , NVL(#{DOCDAT},TO_CHAR(SYSDATE,'YYYYMMDD')) AS DOCDAT
			 , NVL((SELECT DOCCAT FROM DOCTM WHERE DOCUTY = PO.BWART), '100') AS DOCCAT
			 , PO.SIGNI
			 , DECODE(PO.BWART, '111', PO.SSORNU, PO.VGBEL) AS VGBEL
			 , DECODE(PO.BWART, '111', PO.SSORIT, PO.VGPOS) AS VGPOS
			 , PO.MRFLG
			 , PO.AR_NO
			 , PO.AR_REV
			 , PO.AR_LNO
			 , PO.BWARTSAP
			 , PO.POREV
		 	 , PO.SSORNU
			 , PO.SSORIT
			 , PO.DLEFLG
			 , PO.SERV1
			 , 'V' AS SAPIFYN
			 , SLM.WMSMAK
			 , ' ' AS LOTA41
			 , ' ' AS LOTA42
			 , ' ' AS LOTA43
			 , ' ' AS LOTA44
			 , ' ' AS LOTA45
			 , '0' AS LOTA46
			 , '0' AS LOTA47
			 , '0' AS LOTA48
			 , ' ' AS LOTA49	
		<include refid="WmsInbound.INBOUND_SUB_IFID_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_TRANS_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WHERE_SQL"/>
		  AND PO.EBELN = #{SEBELN}
          AND PO.IFFLG = 'N'
          AND PO.MRFLG != 'S0'
	     <include refid="WmsInbound.INBOUND_SUB_SORT_SQL"/>
         
	</select>
	
	
	<select id="GR02_ORDER_01_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT *
		 FROM (
		        SELECT CASE WHEN NOT EXISTS ( SELECT '1' FROM IFWMS103 X
		        							   WHERE X.WAREKY = STD.WAREKY
		        							   AND X.SEQNO = STD.SEQNO
		        							   AND X.EBELN = STD.EBELN
		        							   AND X.EBELP = STD.EBELP
		        							   AND X.STATUS IN ('U','C')
											   AND X.IFFLG IN ('N','Y')
											   AND X.PRCFLG = 'C'
											   AND X.DLEFLG != 'Y'
		        							 )
		                      THEN 'VALID_M2115†' || STD.EBELN || '/' || STD.SEQNO
		                    WHEN NOT EXISTS ( SELECT '1' FROM IFWMS103 X
		        							   WHERE X.WAREKY = STD.WAREKY 
		        							   AND X.SEQNO = STD.SEQNO
		        							   AND X.EBELN = STD.EBELN
		        							   AND X.EBELP = STD.EBELP
											   AND X.MENGE = STD.MENGE
											   AND X.MENGE_R = STD.MENGE_R
											   AND X.SKUKEY = STD.SKUKEY
											   AND X.MEINS = STD.UOMKEY
											   AND X.LOTA01 = STD.LOTA01
											   AND X.LOTA02 = STD.LOTA02
											   <!-- AND X.LOTA03 = STD.LOTA03 -->
											   AND X.LOTA07 = STD.LOTA07
											   <!-- AND X.LOTA08 = STD.LOTA08 -->
											   <!-- AND X.LOTA16 = STD.LOTA16 -->
											   <!-- AND X.LOTA17 = STD.LOTA17 -->
		        							   AND X.STATUS IN ('U','C')
											   AND X.IFFLG IN ('N','Y')
											   AND X.PRCFLG = 'C'
											   AND X.DLEFLG != 'Y'
											)
                              THEN 'VALID_M2115†' || STD.EBELN || '/' || STD.SEQNO
								<!--VALIDATION 조건 추가 -->
                           WHEN EXISTS ( SELECT '1' FROM IFWMS103 X  
                                               WHERE X.WAREKY = STD.WAREKY
                                               <!-- 240215 HNW LOGSEQNO 기준으로 변경 -->
                                               <!-- AND X.CREDAT >= STD.CREDAT -->
                                               <!-- AND X.CRETIM > STD.CRETIM -->
                                               AND X.LOGSEQNO > (
                                               						SELECT A.LOGSEQNO
                                               						FROM IFWMS103 A
                                               						WHERE A.SEQNO = STD.SEQNO	
                                               					)
		        							   AND X.EBELN = STD.EBELN
		        							   <!-- 231127 HNW -->
                                               <!-- AND X.EBELP = STD.EBELP -->
											   <!-- 240207 HNW LOTA15 추가(해당 구문은 아래 조건에 부합하는 오더건이 있는지를 체크하는 것 = 없어야 정상) -->
											   <!-- AND X.LOTA15 = STD.LOTA15 -->
                                               AND X.STATUS IN ('U','C')
											   AND X.IFFLG IN ('N','Y')
											   AND X.PRCFLG = 'C'
                                               )
                              THEN 'VALID_M2115†' || STD.EBELN || '/' || STD.SEQNO
                            WHEN EXISTS ( SELECT '1' FROM IFWMS103 X
		        							   WHERE X.WAREKY = STD.WAREKY 
		        							   AND X.SEQNO = STD.SEQNO
		        							   AND X.EBELN = STD.EBELN
		        							   AND X.EBELP = STD.EBELP
		        							   AND X.STATUS IN ('U','C')
											   AND X.IFFLG IN ('N','Y')
											   AND X.PRCFLG = 'C'
											   AND X.MENGE = 0
											   AND X.DLEFLG != 'Y'
											)
                              THEN 'VALID_M2109†' || STD.EBELN
                            WHEN EXISTS ( SELECT '1' FROM IFWMS103 X
	        							   WHERE X.WAREKY = STD.WAREKY 
	        							   AND X.EBELN = STD.EBELN
	        							   AND X.EBELP = STD.EBELP
	        							   AND X.STATUS IN ('U','C')
										   AND X.IFFLG = 'Y'
										   AND X.PRCFLG = 'C'
										   AND X.BWART != '111'
										 )
                              THEN 'VALID_M0971†' || STD.EBELN
                         <!--    WHEN NOT EXISTS ( SELECT '1' FROM IFWMS103 X
		        							   WHERE X.WAREKY = STD.WAREKY
		        							   AND X.SEQNO = STD.SEQNO
		        							   AND X.EBELN = STD.EBELN
		        							   AND X.EBELP = STD.EBELP
		        							   AND X.STATUS IN ('U','C')
											   AND X.IFFLG = 'N'
											   AND X.PRCFLG = 'C'
											   AND X.DLEFLG != 'Y'
											)
                              THEN 'VALID_M2116†' || STD.EBELN || '/' || STD.SEQNO -->
                              <!-- 이삭수정 -->
                             WHEN  (SELECT BWART FROM IFWMS103 X
		        							   WHERE X.WAREKY = STD.WAREKY
		        							   AND X.SEQNO = STD.SEQNO
		        							   AND X.EBELN = STD.EBELN
		        							   AND X.EBELP = STD.EBELP) ! =  '111' AND  NOT EXISTS ( SELECT '1' FROM IFWMS103 X
																		        							   WHERE X.WAREKY = STD.WAREKY
																		        							     AND X.SEQNO = STD.SEQNO
																		        							     AND X.EBELN = STD.EBELN
																		        							     AND X.EBELP = STD.EBELP
																		        							     AND X.STATUS IN ('U','C')
																											     AND X.IFFLG = 'N'
																											     AND X.PRCFLG = 'C'
																											     AND X.DLEFLG != 'Y'
									)
                              THEN 'VALID_M2116†' || STD.EBELN || '/' || STD.SEQNO
                                WHEN  (SELECT BWART FROM IFWMS103 X
		        							   WHERE X.WAREKY = STD.WAREKY
		        							   AND X.SEQNO = STD.SEQNO
		        							   AND X.EBELN = STD.EBELN
		        							   AND X.EBELP = STD.EBELP)  =  '111' AND   EXISTS ( SELECT '1' FROM IFWMS103 X
																		        							   WHERE X.WAREKY = STD.WAREKY
																		        							     AND X.SEQNO = STD.SEQNO
																		        							     AND X.EBELN = STD.EBELN
																		        							     AND X.EBELP = STD.EBELP
																		        							     AND X.STATUS IN ('U','C')
<!-- 																										     AND X.IFFLG = 'N'
																										     AND X.PRCFLG = 'C' -->
																		        							     AND (X.MENGE - X.MENGE_R) = 0
																											     AND X.DLEFLG != 'Y'
									) 
                              THEN 'VALID_M2116†' || STD.EBELN || '/' || STD.SEQNO
                            WHEN NOT EXISTS ( SELECT '1'
                                    			FROM MEASH A
                                         			 INNER JOIN MEASI B
                                            			ON A.WAREKY = B.WAREKY
                                           			   AND A.MEASKY = B.MEASKY
                                   			   WHERE 1 = 1
                                    			 AND A.WAREKY = STD.WAREKY
                                    			 AND A.MEASKY = STD.SKUKEY
											)
                              THEN 'VALID_M9004†' || STD.EBELN || '/' || 'STD.SKUKEY'    
		                    ELSE 'OK'
		                END AS RESULTMSG  
		        FROM ( ${APPEND_QUERY} ) STD
		      )
		 WHERE RESULTMSG != 'OK'
		 AND ROWNUM = 1
	</select>
	
	
	<select id="GR02_ORDER_02_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT *
		 FROM (
		        SELECT CASE WHEN EXISTS ( SELECT '1' FROM IFWMS103 X
		        							   WHERE X.WAREKY = STD.WAREKY 
		        							   AND X.EBELN = STD.EBELN
		        							   AND X.STATUS IN ('U','C')
											   AND X.IFFLG IN ('N','Y')
											   AND X.PRCFLG = 'C'
											   AND X.MENGE = 0
										)
                              THEN 'VALID_M2109†' || STD.EBELN
                            WHEN NOT EXISTS ( SELECT '1' FROM IFWMS103 X
		        							   WHERE X.WAREKY = STD.WAREKY
		        							   AND X.EBELN = STD.EBELN
		        							   AND X.STATUS IN ('U','C')
											   AND X.IFFLG = 'N'
											   AND X.PRCFLG = 'C'
											)
                              THEN 'VALID_M2116†' || STD.EBELN     
		                    ELSE 'OK'
		                END AS RESULTMSG
		        FROM ( ${APPEND_QUERY} ) STD
		      )
		 WHERE RESULTMSG != 'OK'
		 AND ROWNUM = 1
	</select>
	
	<select id="GR02VAL_LIST" parameterType="Map" resultType="DataMap">
		
		<include refid="WmsInbound.INBOUND_SUB_WITH_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WITH_TRANS_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_TOP_SQL"/>
		     , ' ' AS LOTA41
			 , ' ' AS LOTA42
			 , ' ' AS LOTA43
			 , ' ' AS LOTA44
			 , ' ' AS LOTA45
			 , '0' AS LOTA46
			 , '0' AS LOTA47
			 , '0' AS LOTA48
			 , ' ' AS LOTA49
		<include refid="WmsInbound.INBOUND_SUB_IFID_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_TRANS_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WHERE_SQL"/>
          AND PO.EBELN IN (${SEBELN})
          AND (PO.MRFLG != 'S0' 
               OR (PO.MRFLG = 'S0' 
               	   AND PO.LOTA01 != '2400' 
               	   AND PO.LOTA02 LIKE CASE WHEN PO.BWART = '121' THEN '%' ELSE 'P100' END 
                  )
              )   
          AND ( 
	          1 = 2
	          <if test="STTNEW == &quot;V&quot;">
	          OR PO.IFFLG = 'N'
	          </if>
	          <if test="STTTC2 == &quot;V&quot;">
	          OR PO.IFFLG = 'Y'
	          </if>
	        )
	      <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		  </if>
		  <if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		  </if>
		  
		  <choose>
		       <when test="RCPTTY != null and RCPTTY == '121'">
		       	${LOTA14_TR_SQL}
			   </when>
			   <otherwise>
			   	${LOTA14_SQL}
			   </otherwise>
		 </choose>
			 
		 <include refid="WmsInbound.INBOUND_SUB_SORT_SQL"/>
         
	</select>
	
	
	<select id="STLKY_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT SLM.OWNRKY
		     , SLM.PLNTKY
		     , SLM.STLKY
		     , SLM.STLNM
		     , SLM.WAREKY
		     , SLM.WMSMAK
		FROM STLMA SLM
		WHERE SLM.OWNRKY = #{OWNRKY}
		  AND SLM.STLKY = #{STLKY}
	</select>
	
	<select id="DIRECT_OUTBOUND_PROC_CALL_MAP" parameterType="HashMap" resultType="HashMap" statementType="CALLABLE">
         { call P_AIRWMS_DIRECT_OUTBOUND (
								            #{RECVKY, mode=IN,jdbcType=VARCHAR}, 
								            #{LOGSEQNO, mode=IN,jdbcType=VARCHAR}
								         )
         }
    </select>
    
    <select id="PORTAL_INOUT_PROC_CALL_MAP" parameterType="HashMap" resultType="HashMap" statementType="CALLABLE" timeout="6000">
         { call P_AIRWMS_PORTAL_INOUT (
         								#{INOUT_TYPE,  mode=IN,  jdbcType=VARCHAR},
         								#{LOGSEQNO,    mode=IN,  jdbcType=VARCHAR},
						                #{ERRORMESG,   mode=OUT, jdbcType=VARCHAR}
						              )
         }
    </select>
	
	<insert id="GR02_INSERT" parameterType="Map">
		INSERT INTO RECDH (RECVKY,WAREKY,RCPTTY,STATDO,SAPSTS,
			               DOCDAT,DOCCAT,DPTNKY,DRELIN,ARCPTD,
			               OWNRKY,INDRCN,CRECVD,RSNCOD,PUTSTS,
			               USRID1,UNAME1,DEPTID1,DNAME1,USRID2,
			               UNAME2,DEPTID2,DNAME2,USRID3,UNAME3,
			               DEPTID3,DNAME3,USRID4,UNAME4,DEPTID4,
			               DNAME4,DOCTXT,CREDAT,CRETIM,CREUSR,
			               LMODAT,LMOTIM,LMOUSR,INDBZL,INDARC,UPDCHK,
			               PTNRTY,ORDDAT,SAPETC
			               ) 
			VALUES (#{RECVKY},#{WAREKY},#{RCPTTY},#{STATDO},NVL(#{BWARTSAP},' '),
				    #{DOCDAT},#{DOCCAT},NVL(#{DPTNKY},' '),' ',#{ASNDAT},
			        #{OWNRKY},' ',' ',' ',' ',
			        ' ',' ',' ',' ',' ',
			        ' ',' ',' ',' ',' ',
			        ' ',' ',' ',' ',' ',
			        ' ',NVL( #{DOCTXT}, ' ' ),TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
 				    TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},' ',' ',0,
 				    #{PTNRTY},NVL(#{BEDAT},' '),NVL(#{SAPIFYN},' ')
 				    )
	</insert>
	
	<insert id="GR02Batch_INSERT" parameterType="Map">
		INSERT INTO RECDH 
		(
			RECVKY,WAREKY,RCPTTY,STATDO,SAPSTS,
			DOCDAT,DOCCAT,DPTNKY,DRELIN,ARCPTD,
			OWNRKY,INDRCN,CRECVD,RSNCOD,PUTSTS,
			USRID1,UNAME1,DEPTID1,DNAME1,USRID2,
			UNAME2,DEPTID2,DNAME2,USRID3,UNAME3,
			DEPTID3,DNAME3,USRID4,UNAME4,DEPTID4,
			DNAME4,DOCTXT,CREDAT,CRETIM,CREUSR,
			LMODAT,LMOTIM,LMOUSR,INDBZL,INDARC,UPDCHK,
			PTNRTY,ORDDAT,SAPETC
		) 
		<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
			SELECT  
				#{item.RECVKY, jdbcType=VARCHAR},#{item.WAREKY, jdbcType=VARCHAR},#{item.RCPTTY, jdbcType=VARCHAR},#{item.STATDO, jdbcType=VARCHAR},NVL(#{item.BWARTSAP, jdbcType=VARCHAR},' '),
			    #{item.DOCDAT, jdbcType=VARCHAR},#{item.DOCCAT, jdbcType=VARCHAR},NVL(#{item.DPTNKY, jdbcType=VARCHAR},' '),' ',#{item.ASNDAT, jdbcType=VARCHAR},
		        #{item.OWNRKY, jdbcType=VARCHAR},' ',' ',' ',' ',
		        ' ',' ',' ',' ',' ',
		        ' ',' ',' ',' ',' ',
		        ' ',' ',' ',' ',' ',
		        ' ',NVL( #{item.DOCTXT, jdbcType=VARCHAR}, ' ' ),TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{item.SES_USER_ID, jdbcType=VARCHAR},
				TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{item.SES_USER_ID, jdbcType=VARCHAR},' ',' ',0,
				#{item.PTNRTY, jdbcType=VARCHAR},NVL(#{item.BEDAT, jdbcType=VARCHAR},' '),NVL(#{item.SAPIFYN, jdbcType=VARCHAR},' ')
 			 FROM DUAL 
		</foreach>
		
	</insert>
	
	
	<insert id="GR02Sub_INSERT" parameterType="Map">
		INSERT INTO RECDI 
		(
			RECVKY,RECVIT,STATIT,SAPSTS,SKUKEY,
		   	LOTNUM,AREAKY,LOCAKY,SECTID,TRNUID,
		   	PACKID,QTYRCV,QTYDIF,QTYUOM,TRUNTY,
		   	MEASKY,UOMKEY,QTPUOM,DUOMKY,QTDUOM,
		   	INDRCN,CRECVD,RSNCOD,WORKID,WORKNM,
		   
		   	HHTTID,LOTA01,LOTA02,LOTA03,LOTA04,
		   	LOTA05,LOTA06,LOTA07,LOTA08,LOTA09,
		   	LOTA10,LOTA11,LOTA12,LOTA13,LOTA14,
		   	LOTA15,LOTA16,LOTA17,LOTA18,LOTA19,
		   
		   	LOTA20,AWMSNO,REFDKY,REFDIT,REFCAT,
		   	REFDAT,DESC01,DESC02,ASKU01,ASKU02,
		   	ASKU03,ASKU04,ASKU05,EANCOD,GTINCD,
		   	SKUG01,SKUG02,SKUG03,SKUG04,SKUG05,
		   
		   	GRSWGT,NETWGT,WGTUNT,LENGTH,WIDTHW,
		   	HEIGHT,CUBICM,CAPACT,QTYORG,SMANDT,
		   	SEBELN,SEBELP,SZMBLNO,SZMIPNO,STRAID,
		   	SVBELN,SPOSNR,STKNUM,STPNUM,SWERKS,
		   	SLGORT,SDATBG,STDLNR,SSORNU,SSORIT,
		   	SMBLNR,SZEILE,SMJAHR,SXBLNR,SBKTXT,
		   	RCPRSN,CREDAT,CRETIM,CREUSR,LMODAT,
		   	LMOTIM,LMOUSR,INDBZL,INDARC,UPDCHK,
		   
		   	LOTA21,LOTA22,LOTA23,LOTA24,SEQNO,
		   	LOTA41,LOTA42,LOTA43,LOTA44,LOTA45,
		   	LOTA46,LOTA47,LOTA48,LOTA49,POREV,
		   	AR_NO,AR_REV,AR_LNO,QRTAYN,SHTAYN,
		   	SERV1
					   
		) 
		VALUES 
		(
			#{RECVKY},#{RECVIT},NVL(#{STATIT},' '),NVL(#{BWARTSAP},' '),#{SKUKEY},
			' ',NVL(#{AREAKY}, ' '), #{LOCAKY},' ',NVL(#{TRNUID},' '),
			' ',#{QTYRCV},0,NVL(TRIM(#{UOMQTY}),0),' ',				    
			#{SKUKEY},#{UOMKEY},0,' ',0,
			' ',' ',NVL(#{RSNCOD},' '),' ',' ',
			
			' ',NVL(#{LOTA01},' '),NVL(#{LOTA02},' ' ),NVL(#{LOTA03},' ' ),NVL(#{LOTA04},' ' ),
			NVL(#{LOTA05},' '),NVL(#{LOTA06},' '),NVL(#{LOTA07},' ' ),NVL(TRIM(#{LOTA08}),' ' ),NVL( #{LOTA09},' '),
			NVL(#{LOTA10},' '),NVL(TRIM(#{LOTA11}),'19000101'),NVL(#{LOTA12},' ' ),NVL(#{LOTA13},' ' ),NVL(#{LOTA14},' ' ),
			NVL(#{LOTA15},' '),NVL(TRIM(#{LOTA16}),0),NVL(TRIM(#{LOTA17}),' '),NVL(TRIM(#{LOTA18}),0),NVL(TRIM(#{LOTA19}),0),
				
			NVL(TRIM(#{LOTA20}),0),' ',NVL(#{REFDKY},' '),NVL(#{REFDIT},' '),NVL(#{REFCAT},' '),
			#{ASNDAT},#{DESC01},#{DESC02},' ',' ',
			   ' ',' ',' ',NVL(#{EANCOD},' '),NVL(#{GTINCD},' '),
			NVL(#{SKUG01},' '),NVL(#{SKUG02},' '),NVL(#{SKUG03},' '),NVL(#{SKUG04},' '),NVL(#{SKUG05},' '),
				
			0,0,' ',0,0,
			0,0,0,NVL(TRIM(#{MENGE}),0),' ',
			#{SEBELN},#{SEBELP},' ',' ',' ',
			' ',' ',' ',' ',' ',
			' ',' ',' ',NVL(#{VGBEL},' '),NVL(#{VGPOS},' '),
			' ',' ',' ',' ',' ',
			NVL(#{RCPRSN},' '),TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
			TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},' ',' ',0,
			
			NVL(#{LOTA21},' '),NVL(#{LOTA22},' '),NVL(#{LOTA23},' '),NVL(#{LOTA24},' '),NVL(TRIM(#{SEQNO}),0),
			NVL(#{LOTA41},' '),NVL(#{LOTA42},' '),NVL(#{LOTA43},' '),NVL(#{LOTA44},' '),NVL(#{LOTA45},' '),
		   	NVL(TRIM(#{LOTA46}),0),NVL(TRIM(#{LOTA47}),0),NVL(TRIM(#{LOTA48}),0),NVL(#{LOTA49},' '),NVL(TRIM(#{POREV}),'0'),
		   	NVL(#{AR_NO},' '),NVL(TRIM(#{AR_REV}),'0'),NVL(#{AR_LNO},' '),NVL(#{QRTAYN},' '),NVL(#{SHTAYN},' '),
		   	NVL(#{SERV1},' ')
		   	
		)
	</insert>
	
	
	<insert id="GR02SubBatch_INSERT" parameterType="Map">
		INSERT INTO RECDI
		(
			RECVKY,RECVIT,STATIT,SAPSTS,SKUKEY,
			LOTNUM,AREAKY,LOCAKY,SECTID,TRNUID,
			PACKID,QTYRCV,QTYDIF,QTYUOM,TRUNTY,
			MEASKY,UOMKEY,QTPUOM,DUOMKY,QTDUOM,
			INDRCN,CRECVD,RSNCOD,WORKID,WORKNM,
					   
			HHTTID,LOTA01,LOTA02,LOTA03,LOTA04,
			LOTA05,LOTA06,LOTA07,LOTA08,LOTA09,
			LOTA10,LOTA11,LOTA12,LOTA13,LOTA14,
			LOTA15,LOTA16,LOTA17,LOTA18,LOTA19,
					   
			LOTA20,AWMSNO,REFDKY,REFDIT,REFCAT,
			REFDAT,DESC01,DESC02,ASKU01,ASKU02,
			ASKU03,ASKU04,ASKU05,EANCOD,GTINCD,
			SKUG01,SKUG02,SKUG03,SKUG04,SKUG05,
					   
			GRSWGT,NETWGT,WGTUNT,LENGTH,WIDTHW,
			HEIGHT,CUBICM,CAPACT,QTYORG,SMANDT,
			SEBELN,SEBELP,SZMBLNO,SZMIPNO,STRAID,
			SVBELN,SPOSNR,STKNUM,STPNUM,SWERKS,
			SLGORT,SDATBG,STDLNR,SSORNU,SSORIT,
			SMBLNR,SZEILE,SMJAHR,SXBLNR,SBKTXT,
			RCPRSN,CREDAT,CRETIM,CREUSR,LMODAT,
			LMOTIM,LMOUSR,INDBZL,INDARC,UPDCHK,
			
			LOTA21,LOTA22,LOTA23,LOTA24,SEQNO,
			LOTA41,LOTA42,LOTA43,LOTA44,LOTA45,
			LOTA46,LOTA47,LOTA48,LOTA49,POREV,
		   	AR_NO,AR_REV,AR_LNO,QRTAYN,SHTAYN,
		   	SERV1
		) 
		<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
			SELECT  
				#{item.RECVKY, jdbcType=VARCHAR},#{item.RECVIT, jdbcType=VARCHAR},NVL(#{item.STATIT, jdbcType=VARCHAR},' '),NVL(#{item.BWARTSAP, jdbcType=VARCHAR},' '),#{item.SKUKEY, jdbcType=VARCHAR},
				' ',NVL(#{item.AREAKY, jdbcType=VARCHAR}, ' '), #{item.LOCAKY, jdbcType=VARCHAR},' ',NVL(#{item.TRNUID, jdbcType=VARCHAR},' '),
				
				<!-- ' ',#{item.QTYRCV},0,NVL(TRIM(#{item.UOMQTY}),0),' ', -->
				' ',#{item.QTYRCV},0,DECODE(#{item.MUOMKEY, jdbcType=VARCHAR}, 'BAG', ROUND(NVL(TRIM(#{item.UOMQTY}),0)), NVL(TRIM(#{item.UOMQTY}),0)),' ',
								    
				#{item.SKUKEY, jdbcType=VARCHAR},#{item.UOMKEY, jdbcType=VARCHAR},0,' ',0,
				' ',' ',NVL(#{item.RSNCOD, jdbcType=VARCHAR},' '),' ',' ',
					
				' ',NVL(#{item.LOTA01, jdbcType=VARCHAR},' '),NVL(#{item.LOTA02, jdbcType=VARCHAR},' ' ),NVL(#{item.LOTA03, jdbcType=VARCHAR},' ' ),NVL(#{item.LOTA04, jdbcType=VARCHAR},' ' ),
				NVL(#{item.LOTA05, jdbcType=VARCHAR},' '),NVL(#{item.LOTA06, jdbcType=VARCHAR},' '),NVL(#{item.LOTA07, jdbcType=VARCHAR},' ' ),NVL(TRIM(#{item.LOTA08, jdbcType=VARCHAR}),' ' ),NVL( #{item.LOTA09, jdbcType=VARCHAR},' '),
				NVL(#{item.LOTA10, jdbcType=VARCHAR},' '),NVL(TRIM(#{item.LOTA11, jdbcType=VARCHAR}),'19000101'),NVL(#{item.LOTA12, jdbcType=VARCHAR},' ' ),NVL(#{item.LOTA13, jdbcType=VARCHAR},' ' ),NVL(#{item.LOTA14, jdbcType=VARCHAR},' ' ),
				NVL(#{item.LOTA15, jdbcType=VARCHAR},' '),NVL(TRIM(#{item.LOTA16, jdbcType=VARCHAR}),0),NVL(TRIM(#{item.LOTA17, jdbcType=VARCHAR}),' '),NVL(TRIM(#{item.LOTA18, jdbcType=VARCHAR}),0),NVL(TRIM(#{item.LOTA19, jdbcType=VARCHAR}),0),
					
				NVL(TRIM(#{item.LOTA20, jdbcType=VARCHAR}),0),' ',NVL(#{item.REFDKY, jdbcType=VARCHAR},' '),NVL(#{item.REFDIT, jdbcType=VARCHAR},' '),NVL(#{item.REFCAT, jdbcType=VARCHAR},' '),
				#{item.ASNDAT, jdbcType=VARCHAR},#{item.DESC01, jdbcType=VARCHAR},#{item.DESC02, jdbcType=VARCHAR},' ',' ',
				' ',' ',' ',NVL(#{item.EANCOD, jdbcType=VARCHAR},' '),NVL(#{item.GTINCD, jdbcType=VARCHAR},' '),
				NVL(#{item.SKUG01, jdbcType=VARCHAR},' '),NVL(#{item.SKUG02, jdbcType=VARCHAR},' '),NVL(#{item.SKUG03, jdbcType=VARCHAR},' '),NVL(#{item.SKUG04, jdbcType=VARCHAR},' '),NVL(#{item.SKUG05, jdbcType=VARCHAR},' '),
					
				0,0,' ',0,0,
				0,0,0,#{item.MENGE, jdbcType=VARCHAR},' ',
				#{item.SEBELN, jdbcType=VARCHAR},#{item.SEBELP, jdbcType=VARCHAR},' ',' ',' ',
				' ',' ',NVL(#{item.STKNUM, jdbcType=VARCHAR},' '),' ',' ',
				' ',' ',' ',NVL(#{item.VGBEL, jdbcType=VARCHAR},' '),NVL(#{item.VGPOS, jdbcType=VARCHAR},' '),
				' ',' ',' ',NVL(#{item.MBLNR, jdbcType=VARCHAR},' '),' ',
				NVL(#{item.RCPRSN, jdbcType=VARCHAR},' '),TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{item.SES_USER_ID, jdbcType=VARCHAR},
 				TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{item.SES_USER_ID, jdbcType=VARCHAR},' ',' ',0,
 				
 				NVL(#{item.LOTA21, jdbcType=VARCHAR},' '),NVL(#{item.LOTA22, jdbcType=VARCHAR},' '),NVL(#{item.LOTA23, jdbcType=VARCHAR},' '),NVL(#{item.LOTA24, jdbcType=VARCHAR},' '),NVL(TRIM(#{item.SEQNO, jdbcType=VARCHAR}),0),
 				
 				NVL(#{item.LOTA41, jdbcType=VARCHAR},' '),NVL(#{item.LOTA42, jdbcType=VARCHAR},' '),NVL(#{item.LOTA43, jdbcType=VARCHAR},' '),NVL(#{item.LOTA44, jdbcType=VARCHAR},' '),NVL(#{item.LOTA45, jdbcType=VARCHAR},' '),
 				NVL(TRIM(#{item.LOTA46, jdbcType=VARCHAR}),0),NVL(TRIM(#{item.LOTA47, jdbcType=VARCHAR}),0),NVL(TRIM(#{item.LOTA48, jdbcType=VARCHAR}),0),NVL(#{item.LOTA49, jdbcType=VARCHAR},' '),NVL(TRIM(#{item.POREV, jdbcType=VARCHAR}),'0'),
 				NVL(#{item.AR_NO, jdbcType=VARCHAR},' '),NVL(TRIM(#{item.AR_REV, jdbcType=VARCHAR}),'0'),NVL(#{item.AR_LNO, jdbcType=VARCHAR},' '),NVL(#{item.QRTAYN, jdbcType=VARCHAR},' '),NVL(#{item.SHTAYN, jdbcType=VARCHAR},' '),
 				NVL(#{item.SERV1, jdbcType=VARCHAR},' ')
 				
 			 FROM DUAL 
		</foreach>
		
	</insert>
	
	<update id="SAPIFSKIP_UPDATE" parameterType="hashmap">
		UPDATE RECDH 
		  SET SAPIFSKIP = #{SAPIFSKIP}
		    , LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
		    , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
		    , LMOUSR = #{SES_USER_ID}
		WHERE RECVKY = #{RECVKY}
	</update>
	
	<select id="GRFILE_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.SEBELN
		     , A.UUID
		     , A.DOCTXT
		     , A.UUID AS ATTACH
		     , B.RPATH
		     , B.PATH
		     , B.FNAME
		     , B.NAME AS UUID_FILEVIEW
		     , B.NAME AS ATTACH_FILEVIEW
		     , B.MIME
		     , B.STYPE
		     , CASE WHEN B.BYTE  <![CDATA[<]]>  1024 THEN B.BYTE || ' BYTE'
		            WHEN B.BYTE <![CDATA[>]]> 1024 AND B.BYTE  <![CDATA[<]]>  (1024*1024) THEN  ROUND(B.BYTE/1024,2) || ' KB'
		            ELSE ROUND(B.BYTE/(1024*1024),2) || ' MB'
		       END  AS BYTE_FILESIZEVIEW
		     , A.CREDAT
			 , A.CRETIM
			 , A.CREUSR
			 , NVL((SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR),' ') AS CUSRNM 
			 , A.LMODAT
			 , A.LMOTIM
			 , A.LMOUSR
			 , NVL((SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR),' ') AS LUSRNM    
		FROM   COAMA A
		  LEFT OUTER JOIN SYSFILE B ON A.UUID = B.UUID AND B.DELETEYN = 'N'
		WHERE 1=1
		  AND A.SEBELN = #{SEBELN}
		  <if test="FILENM != null and FILENM != ''">AND UPPER(B.NAME) LIKE '%' || UPPER(#{FILENM}) || '%'</if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
			</if>
		ORDER BY A.UUID DESC
	</select>
	
	<select id="GRFILE_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS FILE_CNT
		FROM COAMA
		WHERE SEBELN = #{SEBELN}
	</select>
	
	<insert id="GRFILE_INSERT" parameterType="hashmap">
		INSERT INTO COAMA(
			  SEBELN, UUID, DOCTXT
			, CREDAT, CRETIM, CREUSR			
			, LMODAT, LMOTIM, LMOUSR
		) VALUES (
			#{SEBELN}, #{ATTACH}, NVL(#{DOCTXT},' ')
			, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
		)
	</insert>
	
	<update id="GRFILE_UPDATE" parameterType="hashmap">
		UPDATE COAMA
		   SET UUID = #{ATTACH}
		     , DOCTXT = NVL(#{DOCTXT},' ')
		     , LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
		     , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
		     , LMOUSR = #{SES_USER_ID}
		WHERE SEBELN = #{SEBELN}
		  AND UUID = #{UUID}
	</update>
	
	<delete id="GRFILE_DELETE" parameterType="hashmap">
		DELETE
		FROM COAMA
		WHERE SEBELN = #{SEBELN}
		  AND UUID = #{UUID}
	</delete>
	
	<select id="SKUG01COMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
			 , CDESC1 AS TEXT_COL
		FROM CMCDV
		WHERE CMCDKY = 'SKUG01' 
		  AND USARG1 = 'V'
		ORDER BY CMCDVL,USARG1
	</select>
	
	<select id="GR_COMPLETE_LIST" parameterType="Map" resultType="DataMap">
		SELECT PO.EBELN AS SEBELN
		FROM IFWMS103 PO
		WHERE PO.EBELN != ' '
		  AND PO.IFFLG = 'Y'
		  AND PO.STATUS IN ('U','C') 
		  AND PO.PRCFLG = 'C'
		  AND PO.EBELN IN ( ${SEBELNS} )
		GROUP BY PO.EBELN
	</select>
	
	<insert id="GR_IF_SAP_LOG_BATCH_INSERT" parameterType="Map">
		INSERT INTO IFSAPLOG
		(
			SEQNO,UI,ZDOCNO,ERRTXT,WAREKY,
			CREDAT,CRETIM,CREUSR,
			LMODAT,LMOTIM,LMOUSR
		) 
		<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
			SELECT IFSAPLOGSEQ.nextval, #{item.PROGID, jdbcType=VARCHAR},NVL(#{item.SEBELN, jdbcType=VARCHAR},' '),NVL(#{item.ERRTXT, jdbcType=VARCHAR},' '),NVL(#{item.WAREKY, jdbcType=VARCHAR},' '),
				TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{item.SES_USER_ID, jdbcType=VARCHAR},
 				TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{item.SES_USER_ID, jdbcType=VARCHAR}
 			 FROM DUAL 
		</foreach>
		
	</insert>
	
	<update id="GR02_DEADLINE_FLAG_UPDATE" parameterType="Map">
	   UPDATE IFWMS103
          SET DLEFLG = #{DLEFLG}
            , DLEDAT = TO_CHAR(SYSDATE,'YYYYMMDD')
		    , DLETIM = TO_CHAR(SYSDATE,'HH24MISS')
		    , DLEUSR = #{SES_USER_ID}
	    WHERE EBELN = #{SEBELN}
	</update>

	<insert id="GR02_IF_PTL_DEADLINE_INSERT" parameterType="Map">
		INSERT INTO IF_PORTAL.T_IF_EPK_DEADLINE (
			IF_SEQ,IF_DATE,RECV_FLAG,RECV_ERR_MSG,RECV_DATE,
			AR_NO,AR_REV,STATUS
		) 
		VALUES (
			IF_PORTAL.SEQ_T_IF_EPK_DEADLINE.nextval,SYSDATE,'N',' ',NULL,
			#{AR_NO},#{AR_REV},#{STATUS}
		)
	</insert>	
	
	<insert id="GR02_POTAL_COMPLETE_BATCH_INSERT" parameterType="Map">
		UPDATE IFWMS103 
		SET
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'), 
			IFFLG = 'Y',
			LMOUSR = (
						 SELECT DISTINCT X.SES_USER_ID
						 FROM (
								<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
									SELECT  #{item.SES_USER_ID, jdbcType=VARCHAR} AS SES_USER_ID
						 			 FROM DUAL 
								</foreach>
							  ) X
	                 )
		 WHERE 1 = 1
		<foreach item="item" index="index" collection="list" open=" AND (EBELN, EBELP, SEQNO) IN ( " separator="," close=" ) ">
			(#{item.SEBELN, jdbcType=VARCHAR},#{item.EBELP, jdbcType=VARCHAR},#{item.SEQNO, jdbcType=VARCHAR})
		</foreach>
		
	</insert>
	
	
	<select id="GR30_RECDI_LIST" parameterType="Map" resultType="DataMap">
		SELECT RH.OWNRKY
		     , RH.WAREKY
		     , RI.RECVKY
		     , RI.RECVIT
		     , RI.SKUKEY
		     , RI.LOTA06
		     , SM.SKUG05
		FROM RECDH RH
		  INNER JOIN RECDI RI ON RI.RECVKY = RH.RECVKY
		  INNER JOIN SKUMA SM ON SM.OWNRKY = RH.OWNRKY AND SM.SKUKEY = RI.SKUKEY
		WHERE RH.RECVKY = #{RECVKY}
		ORDER BY RI.RECVKY, RI.RECVIT
	</select>
	
	<select id="GR30_RECDI_RTN_LIST" parameterType="Map" resultType="DataMap">
		SELECT RH.OWNRKY
		     , RH.WAREKY
		     , RI.RECVKY
		     , RI.RECVIT
		     , RI.SKUKEY
		     , RI.LOTA06
		     , RI.QTYRCV
		     , RI.QTYUOM
		     , SM.SKUG05
			 , RH.DOCDAT
			 , '402' AS ADJUTY
			 , '400' AS DOCCAT
			 , '402' AS ADJUCA
			 , ' ' AS DOCTXT
		FROM RECDH RH
		  INNER JOIN RECDI RI ON RI.RECVKY = RH.RECVKY
		  INNER JOIN SKUMA SM ON SM.OWNRKY = RH.OWNRKY AND SM.SKUKEY = RI.SKUKEY
		WHERE RH.SEBELN = #{SEBELN}
		  AND RI.LOTA06 != '10'
		ORDER BY RI.LOTA06
	</select>
	
	<update id="GR30_LOTA06_UPDATE" parameterType="Map">
		UPDATE RECDI RI 
		  SET RI.LOTA06 = #{LOTA06}
		    , RI.LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
		    , RI.LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
		    , RI.LMOUSR = #{SES_USER_ID}
		WHERE RI.RECVKY = #{RECVKY}
		  AND RI.RECVIT = #{RECVIT}
	</update>
	
	<insert id="GR30_IFWMS223_INSERT" parameterType="Map">
		INSERT INTO IFWMS223
		     (
		       MANDT
		     , SEQNO
		     , SADJKY
		     , SADJIT
		     , ORDCAT
		     , BWART
		     , WERKS
		     , MATNR
		     , QTADJU
		     , TMATNR
		     , MEINS
		     , VGBEL
		     , VGPOS
		     , STATUS
		     , WAREKY
		     , ZDOC_NO
		     , ZDOC_ITEM
		     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
		     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
		     , TLOTA01, TLOTA02, TLOTA03, TLOTA04, TLOTA05, TLOTA06, TLOTA07, TLOTA08, TLOTA09, TLOTA10
		     , TLOTA11, TLOTA12, TLOTA13, TLOTA14, TLOTA15, TLOTA16, TLOTA17, TLOTA18, TLOTA19, TLOTA20
		     , CDATE, CREDAT, CRETIM, CREUSR
		     , IFID
		     , IFFLG
		     , ITFFLG, ITFDAT, ITFTIM
		     , PRCFLG
		     , LOGSEQNO
		     , BWARTSAP
		     )	
		     SELECT NVL(#{MANDT},'100') AS MANDT
		          , SEQ_IFWMS223.NEXTVAL AS SEQNO
		          , RI.RECVKY AS SADJKY
		          , RI.RECVIT AS SADJIT
		          , '400' AS ORDCAT
		          , '401' AS BWART
		          , RH.OWNRKY
		          , RI.SKUKEY AS MATNR
		          , RI.QTYRCV AS QTADJU
		          , RI.SKUKEY AS TMATNR
		          , RI.UOMKEY AS MEINS
		          , RI.SSORNU AS VGBEL
		          , RI.SSORIT AS VGPOS
		          , 'C'
		          , RH.WAREKY AS WAREKY
		          , RI.RECVKY AS SADJKY
		          , RI.RECVIT AS SADJIT
				  
		          , RI.LOTA01, RI.LOTA02, RI.LOTA03, RI.LOTA04, RI.LOTA05
		          , RI.LOTA06, RI.LOTA07, RI.LOTA08, RI.LOTA09, RI.LOTA10
		          , RI.LOTA11, RI.LOTA12, RI.LOTA13, RI.LOTA14, RI.LOTA15
		          , RI.LOTA16, RI.LOTA17, RI.LOTA18, RI.LOTA19, RI.LOTA20
				  
				  , RI.LOTA01 AS TLOTA01, RI.LOTA02 AS TLOTA02, RI.LOTA03 AS TLOTA03, RI.LOTA04 AS TLOTA04, RI.LOTA05 AS TLOTA05
		          , #{TLOTA06} AS TLOTA06, RI.LOTA07 AS TLOTA07, RI.LOTA08 AS TLOTA08, RI.LOTA09 AS TLOTA09, RI.LOTA10 AS TLOTA10
		          , RI.LOTA11 AS TLOTA11, RI.LOTA12 AS TLOTA12, RI.LOTA13 AS TLOTA13, RI.LOTA14 AS TLOTA14, RI.LOTA15 AS TLOTA15
		          , RI.LOTA16 AS TLOTA16, RI.LOTA17 AS TLOTA17, RI.LOTA18 AS TLOTA18, RI.LOTA19 As TLOTA19, RI.LOTA20 AS TLOTA20
				  
		          , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
		          , #{IFID}
		          , 'N' --IFFLG
		          , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
		          , 'I' --PRCFLG
		          , #{LOGSEQNO}
		          , #{BWARTSAP}
		     FROM RECDH RH
			   INNER JOIN RECDI RI ON RI.RECVKY = RH.RECVKY
			 WHERE RH.OWNRKY = #{OWNRKY}
			   AND RH.WAREKY = #{WAREKY}
			   AND RH.RECVKY = #{RECVKY}
			   AND RI.RECVIT = #{RECVIT}
	</insert>
	
	
	<!-- GR02 SQL END -->
	
	<!-- GR14 SQL START -->
	
	<select id="GR14_LIST" parameterType="Map" resultType="DataMap">
		SELECT *
		FROM (
			SELECT IF109.MANDT
			     , IF109.SEQNO
			     , IF109.EBELN AS SEBELN
			     , IF109.EBELP AS SEBELP
			     , IF109.LIFNR
			     , RH.RCPTTY
			     , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = RH.RCPTTY),' ') AS RCPTNM
			     , IF109.BEDAT
			     , IF109.WERKS
			     , IF109.VGBEL AS RECVKY
			     , IF109.VGPOS AS RECVIT
			     , IF109.WAREKY
			     , IF109.SKUKEY
			     , IF109.ORDCAT
			     , IF109.STOKKY
			     , IF109.LOTA01
			     , IF109.LOTA02
			     , IF109.LOTA03
			     , IF109.LOTA04
			     , IF109.LOTA05
			     , IF109.LOTA06
			     , IF109.LOTA07
			     , IF109.LOTA08
			     , IF109.LOTA09
			     , IF109.LOTA10
			     , IF109.LOTA11
			     , IF109.LOTA12
			     , IF109.LOTA13
			     , IF109.LOTA14
			     , IF109.LOTA15
			     , IF109.CHKRST
			     , IF109.QTYGOD
			     , NVL(TRIM(SZF_GET_DEFAULT_QTY(IF109.WAREKY, IF109.SKUKEY, IF109.QTYGOD, IF109.MEINS)),'0.000') AS QTYGOD1
			     , IF109.QTYBAD
			     , NVL(TRIM(SZF_GET_DEFAULT_QTY(IF109.WAREKY, IF109.SKUKEY, IF109.QTYBAD, IF109.MEINS)),'0.000') AS QTYBAD1
			     , IF109.BADRSN
			     , IF109.MATNR
			     , TO_CHAR(IF109.MENGE) AS MENGE
			     , NVL(TRIM(SZF_GET_DEFAULT_QTY(IF109.WAREKY, IF109.SKUKEY, IF109.MENGE, IF109.MEINS)),'0.000') AS UOMQTY
			     , IF109.MEINS AS UOMKEY
			     , MI.UOMKEY AS DUOMKEY
			     , IF109.ITFFLG
			     , IF109.IFID
			     , SM.DESC01
			     , '402' AS ADJUTY
	 			 , TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT
	 			 , '400' AS DOCCAT
				 , '402' AS ADJUCA
				 , ' ' AS DOCTXT
				 , RH.ORDDAT
				 , RH.STATDO
				 , 'IFWMS109' AS TBLNM
				 , '10' AS QULTTY
				 , IF109.CHKRSTG
				 , IF109.CHKRSTB
				 , IF109.LOGSEQNO
			FROM IFWMS109 IF109
			  LEFT OUTER JOIN SKUMA SM
			               ON SM.OWNRKY = IF109.WERKS AND SM.SKUKEY = IF109.SKUKEY
			  LEFT OUTER JOIN RECDH RH
			               ON RH.RECVKY = IF109.VGBEL
			  LEFT OUTER JOIN MEASI MI 
                           ON MI.WAREKY = IF109.WAREKY
                          AND MI.MEASKY = IF109.SKUKEY 
                          AND MI.INDDFU = 'V'
			WHERE IF109.WERKS = #{OWNRKY}
			  AND IF109.WAREKY = #{WAREKY}
			  AND IF109.ITFFLG = 'C'
			  AND IF109.CHKRST = 'QR'
			  <if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			  </if>
			  <if test="SKUL01 != null and SKUL01 != ''">
				AND SM.SKUL01 = #{SKUL01}
			  </if>
			  <if test="LOTA06 != null and LOTA06 != ''">
				AND IF109.LOTA06 = #{LOTA06}
			  </if>
			  <if test="STATDO != null and STATDO != ''">
				AND 	RH.STATDO = #{STATDO} 
			  </if>
			  <if test="SKUG01 != null and SKUG01 != ''">
				AND SM.SKUG01 = #{SKUG01}
			  </if>
			  <if test="SKUL01 != null and SKUL01 != ''">
				AND SM.SKUL01 = #{SKUL01}
			  </if>
			UNION ALL
			SELECT IF109.MANDT
			     , IF109.SEQNO
			     , IF109.EBELN AS SEBELN
			     , IF109.EBELP AS SEBELP
			     , IF109.LIFNR
			     , RH.RCPTTY
			     , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = RH.RCPTTY),' ') AS RCPTNM
			     , IF109.BEDAT
			     , IF109.WERKS
			     , RH.RECVKY
			     , IF109.VGPOS AS RECVIT
			     , IF109.WAREKY
			     , IF109.SKUKEY
			     , IF109.ORDCAT
			     , IF109.STOKKY
			     , IF109.LOTA01
			     , IF109.LOTA02
			     , IF109.LOTA03
			     , IF109.LOTA04
			     , IF109.LOTA05
			     , IF109.LOTA06
			     , IF109.LOTA07
			     , IF109.LOTA08
			     , IF109.LOTA09
			     , IF109.LOTA10
			     , IF109.LOTA11
			     , IF109.LOTA12
			     , IF109.LOTA13
			     , IF109.LOTA14
			     , IF109.LOTA15
			     , IF109.CHKRST
			     , IF109.QTYGOD
			     , NVL(TRIM(SZF_GET_DEFAULT_QTY(IF109.WAREKY, IF109.SKUKEY, IF109.QTYGOD, IF109.MEINS)),'0.000') AS QTYGOD1
			     , IF109.QTYBAD
			     , NVL(TRIM(SZF_GET_DEFAULT_QTY(IF109.WAREKY, IF109.SKUKEY, IF109.QTYBAD, IF109.MEINS)),'0.000') AS QTYBAD1
			     , IF109.BADRSN
			     , IF109.MATNR
			     , TO_CHAR(IF109.MENGE) AS MENGE
			     , NVL(TRIM(SZF_GET_DEFAULT_QTY(IF109.WAREKY, IF109.SKUKEY, IF109.MENGE, IF109.MEINS)),'0.000') AS UOMQTY
			     , IF109.MEINS AS UOMKEY
			     , MI.UOMKEY AS DUOMKEY
			     , IF109.ITFFLG
			     , IF109.IFID
			     , SM.DESC01
			     , '402' AS ADJUTY
	 			 , TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT
	 			 , '400' AS DOCCAT
				 , '402' AS ADJUCA
				 , ' ' AS DOCTXT
				 , RH.ORDDAT
				 , RH.STATDO
				 , 'IFWMS108' AS TBLNM
				 , '20' AS QULTTY
				 , IF109.CHKRSTG
				 , IF109.CHKRSTB
				 , IF109.LOGSEQNO
			FROM IFWMS108 IF109
			  LEFT OUTER JOIN STKKY SK
			               ON SK.STOKKY = IF109.STOKKY
			  LEFT OUTER JOIN SKUMA SM
			               ON SM.OWNRKY = IF109.WERKS AND SM.SKUKEY = IF109.SKUKEY
			  LEFT OUTER JOIN RECDH RH
			               ON RH.RECVKY = SK.RECVKY
			  LEFT OUTER JOIN MEASI MI 
                           ON MI.WAREKY = IF109.WAREKY
                          AND MI.MEASKY = IF109.SKUKEY 
                          AND MI.INDDFU = 'V'
			WHERE IF109.WERKS = #{OWNRKY}
			  AND IF109.WAREKY = #{WAREKY}
			  AND IF109.ITFFLG = 'C'
			  AND IF109.CHKRST = 'QR'
			  <if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			  </if>
			  <if test="SKUL01 != null and SKUL01 != ''">
				AND SM.SKUL01 = #{SKUL01}
			  </if>
			  <if test="LOTA06 != null and LOTA06 != ''">
				AND IF109.LOTA06 = #{LOTA06}
			  </if>
			  <if test="STATDO != null and STATDO != ''">
				AND 	RH.STATDO = #{STATDO} 
			  </if>
			  <if test="SKUG01 != null and SKUG01 != ''">
				AND SM.SKUG01 = #{SKUG01}
			  </if>
			  <if test="SKUL01 != null and SKUL01 != ''">
				AND SM.SKUL01 = #{SKUL01}
			  </if>
<!-- 		ORDER BY IF109.SEQNO DESC, IF109.EBELN DESC, IF109.EBELP DESC -->
		) A
		ORDER BY A.SEQNO DESC, A.SEBELN DESC, A.SEBELP DESC
	</select>
	
	<select id="GR14Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT SK.STOKKY
		     , SK.STOKKY AS REFSTK
		     , SK.WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = SK.WAREKY),' ') AS WARENM
		     , SK.LOTNUM
		     , SK.LOCAKY
		     , SK.RECVKY
		     , SK.RECVIT
		     , SK.SKUKEY
		     , SK.DESC01
		     , SK.DESC02
		     , SK.MEASKY
		     , SK.LOTA01
		     , SLM.STLNM AS LOTA01NM
		     , SK.LOTA02
		     , SK.LOTA03
		     , SK.LOTA04
		     , SK.LOTA05
		     , SK.LOTA06
		     , SK.LOTA07
		     , SK.LOTA08
		     , SK.LOTA09
		     , SK.LOTA10
		     , SK.LOTA11
		     , SK.LOTA12
		     , SK.LOTA13
		     , SK.LOTA14
		     , SK.LOTA15
		     , SK.LOTA16
		     , SK.LOTA17
		     , SK.LOTA18
		     , SK.LOTA19
		     , SK.LOTA20
		     , SK.UOMKEY
		     , SK.AREAKY
		     , SK.TRNUID
		     , SK.AWMSNO
		     , SK.ASKU01
		     , SK.ASKU02
		     , SK.ASKU03
		     , SK.ASKU04
		     , SK.ASKU05
		     , SK.SADJIT
		     , SK.QTYUOM
		     , SK.TRUNTY
		     , SK.QTPUOM
		     , SK.DUOMKY
		     , SK.QTDUOM
		     , SK.REFDKY
		     , SK.REFDIT
		     , SK.REFCAT
		     , SK.OWNRKY
		     , SK.EANCOD
		     , SK.GTINCD
		     , SK.SKUG01
		     , SK.SKUG02
		     , SK.SKUG03
		     , SK.SKUG04
		     , SK.SKUG05
		     , SK.WGTUNT
		     , SK.LENGTH
		     , SK.WIDTHW
		     , SK.HEIGHT
		     , SK.CUBICM
		     , SK.CAPACT
		     , SK.SMANDT
		     , SK.SEBELN
		     , SK.SEBELP
		     , SK.SZMBLNO
		     , SK.SZMIPNO
		     , SK.STRAID
		     , SK.SVBELN
		     , SK.SPOSNR
		     , SK.STKNUM
		     , SK.STPNUM
		     , SK.SWERKS
		     , SK.SLGORT
		     , SK.SDATBG
		     , SK.STDLNR
		     , SK.SSORNU
		     , SK.SSORIT
		     , SK.SMBLNR
		     , SK.SZEILE
		     , SK.SMJAHR
		     , SK.SXBLNR
		     , SK.SAPSTS
		     , SK.SECTID
		     , SK.PACKID
		     
		     , SK.QTSIWH
		     , SK.QTSIWH AS QTYGODTOT
		     , SK.QTSIWH AS QTYBADTOT
		     , '0.000' AS QTYGOD
		     , '0.000' AS QTYBAD
		     
		     , '0.000' AS QTYGODOD
		     , '0.000' AS QTYBADOD
		     
		     , NVL(TRIM(SZF_GET_CONVERT_QTY(SK.WAREKY, SK.SKUKEY, SK.QTSIWH, SK.UOMKEY, 'KG')),'0.000') AS TOT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(SK.WAREKY, SK.SKUKEY, SK.QTSIWH, SK.UOMKEY, 'BAG')),'0.000') AS BAG
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(SK.WAREKY, SK.SKUKEY, SK.QTSIWH, SK.UOMKEY, 'BOX')),'0.000') AS BOX
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(SK.WAREKY, SK.SKUKEY, SK.QTSIWH, SK.UOMKEY, 'PAL')),'0.000') AS PLT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(SK.WAREKY, SK.SKUKEY, SK.QTSIWH, SK.UOMKEY, 'SOK')),'0.000') AS SOK
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(SK.WAREKY, SK.SKUKEY, SK.QTSIWH, SK.UOMKEY, 'EA')),'0.000') AS EA
			 
			 , ' ' AS ARSNADJ
			 , ' ' AS AADJRSN
			 , ' ' AS RELRSN
			 , SK.LOTA01 AS ALOTA01
		     , SK.LOTA02 AS ALOTA02
		     , SK.LOTA03 AS ALOTA03
		     , SK.LOTA04 AS ALOTA04
		     , SK.LOTA05 AS ALOTA05
		     , SK.LOTA06 AS ALOTA06
		     , SK.LOTA07 AS ALOTA07
		     , SK.LOTA08 AS ALOTA08
		     , SK.LOTA09 AS ALOTA09
		     , SK.LOTA10 AS ALOTA10
		     , SK.LOTA11 AS ALOTA11
		     , SK.LOTA12 AS ALOTA12
		     , SK.LOTA13 AS ALOTA13
		     , SK.LOTA14 AS ALOTA14
		     , SK.LOTA15 AS ALOTA15
		     , SK.LOTA16 AS ALOTA16
		     , SK.LOTA17 AS ALOTA17
		     , SK.LOTA18 AS ALOTA18
		     , SK.LOTA19 AS ALOTA19
		     , SK.LOTA20 AS ALOTA20
			 , SK.LOCAKY AS ALOCAKY
			 , SK.TRNUID AS ATRNUID
			 , SK.QTSIWH AS AQTADJU
			 , SK.AREAKY AS AAREAKY
			 , SK.SKUKEY AS ASKUKEY
			 , SK.ASKU01 AS AASKU01 
			 , SK.ASKU02 AS AASKU02
		     , SK.ASKU03 AS AASKU03
		     , SK.ASKU04 AS AASKU04
		     , SK.ASKU05 AS AASKU05
			 , SM.GRSWGT
			 , SM.NETWGT
			 , #{TBLNM} AS TBLNM
			 , RI.UOMKEY AS MEINSOD
	 		 , RI.QTYRCV
		FROM STKKY SK
		  LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = SK.OWNRKY AND SLM.PLNTKY = SK.LOTA02 AND SLM.STLKY = SK.LOTA01
		  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = SK.OWNRKY AND SM.SKUKEY = SK.SKUKEY
		  LEFT OUTER JOIN RECDI RI ON RI.RECVKY = SK.RECVKY AND RI.RECVIT = SK.RECVIT
		WHERE SK.OWNRKY = #{OWNRKY}
		  AND SK.WAREKY = #{WAREKY}
		  AND SK.SKUKEY = #{SKUKEY}
		  AND SK.LOTA06 = '05'
		  AND SK.QTSIWH - (SK.QTSALO + SK.QTSBLK) > 0
		  AND SK.QTSIWH - (SK.QTSPMO + SK.QTSBLK) > 0
		  <choose>
		    <when test="TBLNM != null and TBLNM == 'IFWMS108'"> 
		  		AND SK.LOTA14 = #{LOTA14}
		  		AND SK.LOTA15 = #{LOTA15}
		  	</when>
			<otherwise>
				AND SK.LOTA01 = #{LOTA01}
		  		AND SK.LOTA02 = #{LOTA02}
		  		AND SK.RECVKY = #{RECVKY} 
			</otherwise>
		  </choose>
		  AND SK.QTSIWH > 0
	</select>
	
	<select id="GR14_VAL_MAP" parameterType="Map" resultType="DataMap">
		SELECT T1.ITFFLG, T1.PRCFLG
		<choose>
		    <when test="TBLNM != null and TBLNM == 'IFWMS108'"> 
		  		FROM IFWMS108 T1
		  	</when>
			<otherwise>
				FROM IFWMS109 T1 
			</otherwise>
		</choose>
		WHERE T1.MANDT = #{MANDT}
		  AND T1.SEQNO = #{SEQNO}
	</select>
	
	<update id="GR14_COMPLETE_UPDATE" parameterType="Map">
		<choose>
		    <when test="TBLNM != null and TBLNM == 'IFWMS108'"> 
		  		UPDATE IFWMS108
		  	</when>
			<otherwise>
				UPDATE IFWMS109 
			</otherwise>
		</choose>
		SET
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'), 
			LMOUSR = #{SES_USER_ID},
			PRCFLG = 'C'
			<if test="CHKRST != null and CHKRST != ''">
		    	,CHKRST = #{CHKRST}
		    </if>
		 WHERE MANDT = #{MANDT}
		   AND SEQNO = #{SEQNO}
	</update>
	
	<select id="GR14_UOMQTY_MAP" parameterType="Map" resultType="DataMap">
		SELECT NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, #{QTYGOD}, #{UOMKEY}, #{CONVTP})),'0.000') AS QTYGODOD
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, #{QTYBAD}, #{UOMKEY}, #{CONVTP})),'0.000') AS QTYBADOD
		FROM DUAL
	</select>
	
	
	<update id="IFWMS108_CHKRST_UPDATE" parameterType="Map">
		UPDATE IFWMS108 A
		   SET CHKRST = NVL(#{CHKRST},' ')
		     , CHKRSTG = NVL((SELECT PRCFLG FROM IFWMS223 G1 WHERE LOGSEQNO = #{IF_KEY} AND BWARTSAP = '321' AND ROWNUM=1), CHKRSTG) -- CHKRSTG 정상건 SAP리턴결과
		     , CHKRSTB = NVL((SELECT PRCFLG FROM IFWMS223 B1 WHERE LOGSEQNO = #{IF_KEY} AND BWARTSAP = '350' AND ROWNUM=1), CHKRSTB) -- CHKRSTB 불량건 SAP리턴결과
		     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
		     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
		     , LMOUSR = NVL(#{IFID},' ')
		 WHERE LOGSEQNO = #{IF_KEY_REF}
		   AND A.SEQNO = #{SEQNO}
	</update>
	
	<update id="IFWMS109_CHKRST_UPDATE" parameterType="Map">
		UPDATE IFWMS109 A
		   SET CHKRST = NVL(#{CHKRST},' ')
		     , CHKRSTG = NVL((SELECT PRCFLG FROM IFWMS223 G1 WHERE LOGSEQNO = #{IF_KEY} AND BWARTSAP = '321' AND ROWNUM=1), CHKRSTG) -- CHKRSTG 정상건 SAP리턴결과
		     , CHKRSTB = NVL((SELECT PRCFLG FROM IFWMS223 B1 WHERE LOGSEQNO = #{IF_KEY} AND BWARTSAP = '350' AND ROWNUM=1), CHKRSTB) -- CHKRSTB 불량건 SAP리턴결과
		     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
		     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
		     , LMOUSR = NVL(#{IFID},' ')
		 WHERE LOGSEQNO = #{IF_KEY_REF}
		   AND A.SEQNO = #{SEQNO}
	</update>
	
	<!-- GR14 SQL END -->
	
	<select id="PALLET_MAP" parameterType="Map" resultType="DataMap">
	   SELECT DECODE(${PALQTY},0,0,CEIL(TMP.DEFAULT_QTY / ${PALQTY})) AS PALCNT 
	        , MOD(NVL(TRIM(TMP.DEFAULT_QTY),0), ${PALQTY}) AS REMQTY
	        
	        , SZF_GET_DEFAULT_QTY(#{WAREKY}, #{SKUKEY}, NVL(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, ${PALQTY}, #{MUOMKEY}, #{UOMKEY}),0), #{UOMKEY}) AS UOMQTY
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, ${PALQTY}, #{MUOMKEY}, 'KG')),'0.000') AS TOT
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, ${PALQTY}, #{MUOMKEY}, 'BAG')),'0.000') AS BAG
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, ${PALQTY}, #{MUOMKEY}, 'BOX')),'0.000') AS BOX
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, ${PALQTY}, #{MUOMKEY}, 'PAL')),'0.000') AS PLT
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, ${PALQTY}, #{MUOMKEY}, 'SOK')),'0.000') AS SOK
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, ${PALQTY}, #{MUOMKEY}, 'EA')),'0.000') AS EA
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, ${PALQTY}, #{MUOMKEY}, #{UOMKEY})),'0.000') AS QTYRCV
            
            , SZF_GET_DEFAULT_QTY(#{WAREKY}, #{SKUKEY}, NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, DECODE(MOD(TMP.DEFAULT_QTY, ${PALQTY}),0,${PALQTY},MOD(TMP.DEFAULT_QTY, ${PALQTY})), #{MUOMKEY}, #{UOMKEY})),0), #{UOMKEY}) AS UOMQTY_REM
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, DECODE(MOD(TMP.DEFAULT_QTY, ${PALQTY}),0,${PALQTY},MOD(TMP.DEFAULT_QTY, ${PALQTY})), #{MUOMKEY}, 'KG')),'0.000') AS TOT_REM
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, DECODE(MOD(TMP.DEFAULT_QTY, ${PALQTY}),0,${PALQTY},MOD(TMP.DEFAULT_QTY, ${PALQTY})), #{MUOMKEY}, 'BAG')),'0.000') AS BAG_REM
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, DECODE(MOD(TMP.DEFAULT_QTY, ${PALQTY}),0,${PALQTY},MOD(TMP.DEFAULT_QTY, ${PALQTY})), #{MUOMKEY}, 'BOX')),'0.000') AS BOX_REM
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, DECODE(MOD(TMP.DEFAULT_QTY, ${PALQTY}),0,${PALQTY},MOD(TMP.DEFAULT_QTY, ${PALQTY})), #{MUOMKEY}, 'PAL')),'0.000') AS PLT_REM
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, DECODE(MOD(TMP.DEFAULT_QTY, ${PALQTY}),0,${PALQTY},MOD(TMP.DEFAULT_QTY, ${PALQTY})), #{MUOMKEY}, 'SOK')),'0.000') AS SOK_REM
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, DECODE(MOD(TMP.DEFAULT_QTY, ${PALQTY}),0,${PALQTY},MOD(TMP.DEFAULT_QTY, ${PALQTY})), #{MUOMKEY}, 'EA')),'0.000') AS EA_REM
            , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, #{SKUKEY}, DECODE(MOD(TMP.DEFAULT_QTY, ${PALQTY}),0,${PALQTY},MOD(TMP.DEFAULT_QTY, ${PALQTY})), #{MUOMKEY}, #{UOMKEY})),'0.000') AS QTYRCV_REM
	   FROM (SELECT NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, #{SKUKEY}, NVL(TRIM(${QTYRCV}),'0'), #{UOMKEY})),0) AS DEFAULT_QTY FROM DUAL) TMP
	</select>
	
    <select id="NEW_BARCODE_PROC_CALL_MAP" parameterType="HashMap" resultType="HashMap" statementType="CALLABLE" flushCache="true" useCache="false" >
         { call P_AIRWMS_NEW_BARCODE(
                #{SKUKEY, mode=IN,jdbcType=VARCHAR}, 
                #{SKUG05_1, mode=IN,jdbcType=VARCHAR}, 
                #{LOTA11, mode=IN,jdbcType=VARCHAR},
                #{PALCNT, mode=IN,jdbcType=INTEGER}, 
                #{SES_USER_ID, mode=IN,jdbcType=VARCHAR}, 
                #{BARCODE, mode=OUT, jdbcType=VARCHAR}, 
                #{BARCODE2, mode=OUT, jdbcType=VARCHAR}, 
                #{STRSEQ, mode=OUT, jdbcType=INTEGER}, 
                #{ENDSEQ, mode=OUT, jdbcType=INTEGER}
           )
         }
    </select>
    
	
	<select id="PALLETIZING_MAP" parameterType="Map" resultType="DataMap">
		WITH SKUG05_T AS(
			SELECT CMCDKY
			     , CMCDVL
			     , CDESC1 
			     , CDESC2 
			     , USARG1 
			FROM CMCDV
			WHERE CMCDKY = 'SKUG05'
		)
		SELECT PO.WERKS AS OWNRKY
             , NVL(OE.NAME01,' ') AS OWNRNM
             , PO.WAREKY
             , NVL(WM.NAME01,' ') AS WARENM
             , PO.SKUKEY
             , SM.DESC01 
             , SM.DESC02
             , DT.SYSLOC AS LOCAKY
             , ' ' AS TRNUID
             , PO.MENGE
             , PO.MEINS AS UOMKEY
             , PO.MENGE_R
             , PO.LOTA01 AS LOTA01
             , PO.LOTA02 AS LOTA02
             , PO.LIFNR AS LOTA03
             , BZ.NAME01 AS LOTA03NM
             , PO.LOTA04 AS LOTA04
             , PO.LOTA05 AS LOTA05
             , PO.LOTA06 AS LOTA06
             , PO.LOTA07 AS LOTA07
             , PO.LOTA08 AS LOTA08
             , PO.LOTA09 AS LOTA09
             , PO.LOTA10 AS LOTA10
             , PO.LOTA11 AS LOTA11
             , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA12
             , PO.LOTA13 AS LOTA13
             , PO.LOTA14 AS LOTA14
             , PO.LOTA15 AS LOTA15
             , PO.LOTA16 AS LOTA16
             , PO.LOTA17 AS LOTA17
             , PO.LOTA18 AS LOTA18
             , PO.LOTA19 AS LOTA19
             , PO.LOTA20 AS LOTA20
             , PO.EBELN AS SEBELN
             , PO.EBELP AS SEBELP
             , ' '      AS RECVKY
             , ' '      AS RECVIT
             , PO.MANDT
             , PO.SEQNO
             , PO.EBELN
             , PO.EBELP
             , PO.BEDAT
             , PO.BWART
             , PO.RTNRSN AS RSNCOD-- 반품사유
             , SZF_GET_RSNCOD_TEXT(#{LANGKY}, #{OWNRKY}, NVL((SELECT DOCCAT FROM DOCTM WHERE DOCUTY = PO.BWART), '100'), PO.BWART, PO.RTNRSN) AS RSNCODNM -- 반품사유명
             , PO.RTNTXT AS RCPRSN -- 상세사유
             , SM.ASKU05
             , SW.MEASKY AS MEASKY 
             , SM.EANCOD
             , MI.UOMKEY AS MUOMKEY
             , PO.CREDAT
             , PO.CRETIM
             , PO.CREUSR
             , PO.LMODAT
             , PO.LMOTIM
             , PO.LMOUSR
             , PO.INDBZL
             , PO.INDARC
             , PO.UPDCHK
             , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = PO.CREUSR),' ') AS CUSRNM
             , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = PO.LMOUSR),' ') AS LUSRNM
             , SLM.STLNM AS LOTA01NM
             , (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC ) AS AREAKY
             , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC )),' ') AS AREANM
             , 'FRV' AS STATIT
             , SM.SKUG01
             , SM.SKUG02
             , SM.SKUG03
             , NVL((SELECT X.USARG1 FROM SKUG05_T X WHERE X.CMCDVL=SM.SKUG05),SKUG04) AS SKUG04
             , SM.SKUG05
             , SM.SKUG05 AS SKUG05_1
             , 0 AS QTYRCV
             , 0 AS QTYRCV1
             , PO.IFFLG
			 , PO.VGBEL
			 , PO.VGPOS
        FROM IFWMS103 PO
          LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
          LEFT OUTER JOIN SKUWC SW ON SW.WAREKY = PO.WAREKY AND SW.OWNRKY = #{OWNRKY} AND SW.SKUKEY = PO.SKUKEY
          LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
          LEFT OUTER JOIN MEASI MI ON MI.WAREKY = PO.WAREKY AND MI.MEASKY = PO.SKUKEY AND MI.INDDFU = 'V'
          LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = PO.WERKS AND SLM.PLNTKY = PO.LOTA02 AND SLM.STLKY  = PO.LOTA01
          LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
       	  LEFT OUTER JOIN OWNER OE ON OE.OWNRKY = PO.WERKS
          LEFT OUTER JOIN WAHMA WM ON WM.WAREKY = PO.WAREKY
        WHERE PO.WAREKY = #{WAREKY}
          AND PO.WERKS = #{OWNRKY} 
          AND PO.EBELN = #{EBELN}
          AND PO.EBELP = #{EBELP}
          AND PO.SEQNO = #{SEQNO}
	
	</select>
	
	<select id="PALLETIZING_LIST" parameterType="Map" resultType="DataMap">
        SELECT TMP.OWNRKY
             , TMP.OWNRNM
             , TMP.WAREKY
             , TMP.WARENM
             , TMP.SKUKEY
             , TMP.DESC01 
             , TMP.DESC02
             , TMP.LOCAKY
             , TMP.TRNUID
             , TMP.QTYRCV AS MENGE
             , TMP.UOMKEY
             , TMP.MENGE_R
             , TMP.QTYRCV AS QTYRCV1
             , TMP.QTYRCV
             , TMP.LOTA01
             , TMP.LOTA02
             , TMP.LOTA03
             , TMP.LOTA03NM
             , TMP.LOTA04
             , TMP.LOTA05
             , TMP.LOTA06
             , TMP.LOTA07
             , TMP.LOTA08
             , TMP.LOTA09
             , TMP.LOTA10
             , TMP.LOTA11
             , TMP.LOTA12
             , TMP.LOTA13
             , TMP.LOTA14
             , TMP.LOTA15
             , TMP.LOTA16
             , TMP.LOTA17
             , TMP.LOTA18
             , TMP.LOTA19
             , TMP.LOTA20
             , TMP.SEBELN
             , TMP.SEBELP
             , TMP.RECVKY
             , TMP.RECVIT
             , TMP.MANDT
             , TMP.SEQNO
             , TMP.EBELN
             , TMP.EBELP
             , TMP.BEDAT
             , TMP.BWART
             , TMP.RSNCOD-- 반품사유
             , TMP.RSNCODNM -- 반품사유명
             , TMP.RCPRSN -- 상세사유
             , TMP.ASKU05
             , TMP.MEASKY 
             , TMP.EANCOD
             , TMP.MUOMKEY
             , SZF_GET_DEFAULT_QTY(TMP.WAREKY, TMP.SKUKEY, TMP.QTYRCV, TMP.UOMKEY) AS UOMQTY
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TMP.WAREKY, TMP.SKUKEY, TMP.QTYRCV, TMP.UOMKEY, 'KG')),'0.000') AS TOT
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TMP.WAREKY, TMP.SKUKEY, TMP.QTYRCV, TMP.UOMKEY, 'BAG')),'0.000') AS BAG
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TMP.WAREKY, TMP.SKUKEY, TMP.QTYRCV, TMP.UOMKEY, 'BOX')),'0.000') AS BOX
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TMP.WAREKY, TMP.SKUKEY, TMP.QTYRCV, TMP.UOMKEY, 'PAL')),'0.000') AS PLT
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TMP.WAREKY, TMP.SKUKEY, TMP.QTYRCV, TMP.UOMKEY, 'SOK')),'0.000') AS SOK
             , NVL(TRIM(SZF_GET_CONVERT_QTY(TMP.WAREKY, TMP.SKUKEY, TMP.QTYRCV, TMP.UOMKEY, 'EA')),'0.000') AS EA
             , TMP.CREDAT
             , TMP.CRETIM
             , TMP.CREUSR
             , TMP.LMODAT
             , TMP.LMOTIM
             , TMP.LMOUSR
             , TMP.INDBZL
             , TMP.INDARC
             , TMP.UPDCHK
             , TMP.CUSRNM
             , TMP.LUSRNM
             , TMP.LOTA01NM
             , TMP.AREAKY
             , NVL(AM.SHORTX,' ') AS AREANM
             , TMP.STATIT
             , TMP.SKUG01
             , TMP.SKUG02
             , TMP.SKUG03
             , TMP.SKUG04
             , TMP.SKUG05
          FROM (
		        SELECT PO.WERKS AS OWNRKY
		             , NVL(OE.NAME01,' ') AS OWNRNM
		             , PO.WAREKY
		             , NVL(WM.NAME01,' ') AS WARENM
		             , PO.SKUKEY
		             , SM.DESC01 
		             , SM.DESC02
		             , DT.SYSLOC AS LOCAKY
		             , ' ' AS TRNUID
		             , PO.MENGE
		             , PO.MEINS AS UOMKEY
		             , PO.MENGE_R
		             , CASE WHEN (${QTYRCV} - (SZF_GET_CONVERT_QTY(PO.WAREKY, PO.SKUKEY, ${PALQTY}, PO.MEINS, PO.MEINS) * ROWNO)) <![CDATA[<]]> 0
		                    THEN TO_CHAR(SZF_GET_CONVERT_QTY(PO.WAREKY, PO.SKUKEY, ${PALQTY}, PO.MEINS, PO.MEINS) + (${QTYRCV} - (SZF_GET_CONVERT_QTY(PO.WAREKY, PO.SKUKEY, ${PALQTY}, PO.MEINS, PO.MEINS) * ROWNO)))
		                    ELSE SZF_GET_CONVERT_QTY(PO.WAREKY, PO.SKUKEY, ${PALQTY}, PO.MEINS, PO.MEINS)
		                END QTYRCV
		             , PO.LOTA01 AS LOTA01
		             , PO.LOTA02 AS LOTA02
		             , PO.LIFNR AS LOTA03
		             , BZ.NAME01 AS LOTA03NM
		             , PO.LOTA04 AS LOTA04
		             , PO.LOTA05 AS LOTA05
		             , PO.LOTA06 AS LOTA06
		             , PO.LOTA07 AS LOTA07
		             , PO.LOTA08 AS LOTA08
		             , PO.LOTA09 AS LOTA09
		             , PO.LOTA10 AS LOTA10
		             , PO.LOTA11 AS LOTA11
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS LOTA12
		             , PO.LOTA13 AS LOTA13
		             , SZF_GENBARCODE(PO.SKUKEY, #{SES_USER_ID}) AS LOTA14
<!-- 		             , SZF_GENNOTNO(PO.SKUKEY, #{BWART}, PO.LOTA04, TO_CHAR(SYSDATE,'YYYYMMDD'), PO.LOTA15) AS LOTA15 -->
		             , PO.LOTA15 AS LOTA15
		             , PO.LOTA16 AS LOTA16
		             , PO.LOTA17 AS LOTA17
		             , PO.LOTA18 AS LOTA18
		             , PO.LOTA19 AS LOTA19
		             , PO.LOTA20 AS LOTA20
		             , PO.EBELN AS SEBELN
		             , PO.EBELP AS SEBELP
		             , ' '      AS RECVKY
		             , ' '      AS RECVIT
		             , PO.MANDT
		             , PO.SEQNO
		             , PO.EBELN
		             , PO.EBELP
		             , PO.BEDAT
		             , PO.BWART
		             , PO.RTNRSN AS RSNCOD-- 반품사유
		             , SZF_GET_RSNCOD_TEXT(#{LANGKY}, #{OWNRKY}, NVL((SELECT DOCCAT FROM DOCTM WHERE DOCUTY = PO.BWART), '100'), PO.BWART, PO.RTNRSN) AS RSNCODNM -- 반품사유명
		             , PO.RTNTXT AS RCPRSN -- 상세사유
		             , SM.ASKU05
		             , SW.MEASKY AS MEASKY 
		             , SM.EANCOD
		             , MI.UOMKEY AS MUOMKEY
		             , PO.CREDAT
		             , PO.CRETIM
		             , PO.CREUSR
		             , PO.LMODAT
		             , PO.LMOTIM
		             , PO.LMOUSR
		             , PO.INDBZL
		             , PO.INDARC
		             , PO.UPDCHK
		             , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = PO.CREUSR),' ') AS CUSRNM
		             , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = PO.LMOUSR),' ') AS LUSRNM
		             , SLM.STLNM AS LOTA01NM
		             , (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC ) AS AREAKY
<!-- 		             , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC )),' ') AS AREANM -->
		             , 'FRV' AS STATIT
		             , SM.SKUG01
		             , SM.SKUG02
		             , SM.SKUG03
		             , SM.SKUG04
		             , SM.SKUG05
		        FROM IFWMS103 PO
		          LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
		          LEFT OUTER JOIN SKUWC SW ON SW.WAREKY = PO.WAREKY AND SW.OWNRKY = #{OWNRKY} AND SW.SKUKEY = PO.SKUKEY
		          LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
		          LEFT OUTER JOIN MEASI MI ON MI.WAREKY = PO.WAREKY AND MI.MEASKY = PO.SKUKEY AND MI.INDDFU = 'V'
		          LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = PO.WERKS AND SLM.PLNTKY = PO.LOTA02 AND SLM.STLKY  = PO.LOTA01
		          LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
		       	  LEFT OUTER JOIN OWNER OE ON OE.OWNRKY = PO.WERKS
		          LEFT OUTER JOIN WAHMA WM ON WM.WAREKY = PO.WAREKY
		          
		          INNER JOIN (SELECT LEVEL AS ROWNO FROM DUAL CONNECT BY LEVEL <![CDATA[<=]]> ${PALCNT} ) ON 1 = 1
		        WHERE PO.WAREKY = #{WAREKY}
		          AND PO.WERKS = #{OWNRKY} 
		          AND PO.EBELN = #{EBELN}
		          AND PO.EBELP = #{EBELP}
              ) TMP
              LEFT OUTER JOIN AREMA AM ON AM.WAREKY = TMP.WAREKY AND AM.AREAKY = TMP.AREAKY 
	</select>
	
	
	<select id="GENNOTNO_OBJECT" parameterType="Map" resultType="String">
		SELECT SZF_GENNOTNO (
							      #{DPTNKY}
							    , #{SKUKEY} 
							    , #{RCPTTY}
							    , NVL(TRIM(#{SEBELN}),' ')
							    , #{LOTA11}
							    , NVL(TRIM(#{LOTA12}),TO_CHAR('YYYYMMDD'))
							    , NVL(TRIM(#{LOTA15}),' ')
							    , #{SES_USER_ID}
							)
		FROM DUAL
	</select>
	
	<!-- GR40 SQL START -->
	
	<select id="GR40_LIST" parameterType="Map" resultType="DataMap">
		SELECT PO.WERKS AS OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = PO.WERKS), ' ') AS OWNRNM
			 , PO.EBELN AS SEBELN
			 , PO.EBELN AS DOCKEY
			 , PO.WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = PO.WAREKY),' ') AS WARENM
			 , PO.BWART AS RCPTTY
			 , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS RCPTNM
			 , PO.EINDT AS ASNDAT
			 , PO.ORDCAT AS DOCCAT
			 , SZF_GET_DOCCAT_TEXT(#{LANGKY}, PO.ORDCAT) AS DOCCATNM
			 , F_SET_DATE(SYSDATE) AS DOCDAT
			 , (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC ) AS AREAKY
			 , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC )),' ') AS AREANM
			 , PO.LIFNR AS DPTNKY
			 , MAX(BZ.NAME01) AS DPTNNM
			 , PO.BWART AS DOCUTY
			 , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS DOCTNM
             , DECODE(SUM( CASE WHEN PO.IFFLG != 'Y' THEN 1 ELSE 0 END ), 0, 'FRV', 'NEW')  AS STATDO
             , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', DECODE(SUM( CASE WHEN PO.IFFLG != 'Y' THEN 1 ELSE 0 END ), 0, 'FRV', 'NEW') ) AS STATDONM
			 ,  ' ' AS DOCTXT
			 , PO.PTNRTY
			 , PO.BEDAT
			 , PO.IFID AS IFID_RECV
             , (CASE WHEN SUM(CASE WHEN TRIM(PO.LOTA14) IS NULL THEN 1 ELSE 0 END)=0 THEN 'N' ELSE 'Y' END) AS LOTA14_EMPTY_YN
             , CASE WHEN 0 = (SELECT COUNT(0) FROM COAMA WHERE SEBELN = PO.EBELN) THEN ' ' ELSE 'V' END AS COAYN
             , PO.SIGNI
             , MAX(RI.RECVKY) AS RECVKY
             , PO.MRFLG
             , PO.BWARTSAP
             , PO.DLEFLG
             , 'V' AS SAPIFYN
             , MAX(RH.SAPETC) AS SAPETC
             , MAX(CASE WHEN SLT.QRTAYN = 'V' THEN 'V' ELSE '' END) AS QRTAYN
             , MAX(CASE WHEN SLT.SHTAYN = 'V' THEN 'V' ELSE '' END) AS SHTAYN
             <include refid="WmsInbound.INBOUND_HEAD_ML_CANCEL_IFID_SQL"/>
		FROM IFWMS103 PO
		  LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
		  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
		  LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
		  LEFT OUTER JOIN RECDI RI ON RI.SEBELN = PO.EBELN AND RI.SEBELP = PO.EBELP AND RI.SEQNO = PO.SEQNO AND RI.STATIT = 'FRV'
		  LEFT OUTER JOIN RECDH RH ON RH.RECVKY = RI.RECVKY
		  LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = #{OWNRKY} AND SLT.WAREKY = #{WAREKY} AND SLT.PLNTKY = PO.LOTA02 AND SLT.SKUKEY = PO.SKUKEY
		WHERE PO.WAREKY = #{WAREKY}
		  AND PO.WERKS  = #{OWNRKY} 
		  <if test="RCPTTY != null and RCPTTY != ''">
		  AND PO.BWART =  #{RCPTTY}
		  </if>
		  AND PO.STATUS IN ('U','C')
<!-- 		  AND PO.IFFLG = 'N' -->
		  AND PO.PRCFLG = 'C'
		  AND PO.MRFLG  = 'S0'	 <!-- 수입밀롤 조건 1 -->
		  AND PO.LOTA01 = '2400' <!-- 수입밀롤 조건 2 -->
		  AND PO.LOTA02 = 'P100' <!-- 수입밀롤 조건 3 -->
		  AND EXISTS (
                       SELECT 'X'
                       FROM DOCPG X
                       WHERE X.PROGID = #{PROGID}
                         AND X.DOCUTY = PO.BWART
                     )
          AND ( 
	          1 = 2
	          <if test="STTNEW == &quot;V&quot;">
	          OR PO.IFFLG = 'N'
	          </if>
	          <if test="STTTC2 == &quot;V&quot;">
	          OR PO.IFFLG = 'Y'
	          </if>
	        )
	    <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		</if>
		<if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		GROUP BY PO.WERKS,
				 PO.EBELN,
				 PO.WAREKY,
				 PO.BWART,
				 PO.EINDT,
				 PO.LIFNR,
			     PO.LGORT,
			     PO.BEDAT, 
			     PO.ORDCAT,
			     DT.SYSLOC,
			     PO.PTNRTY, 
			     PO.IFID,
			     PO.MRFLG,
			     PO.BWARTSAP,
			     PO.DLEFLG,
			     PO.SIGNI
		ORDER BY PO.EBELN DESC
	</select>
	
	<select id="GR40Sub_LIST" parameterType="Map" resultType="DataMap">
		
		<include refid="WmsInbound.INBOUND_SUB_WITH_SQL"/>
		SELECT PO.WERKS AS OWNRKY
			 , (SELECT OWNRNM FROM OE_T) AS OWNRNM
		     , PO.WAREKY
		     , (SELECT WARENM FROM WM_T) AS WARENM
			 , NVL(DECODE(SM.SKUG05, '10', ZT.PALCNT, NVL(MIP.QTPUOM,'0.000')), '0.000') AS PALQTY -- 2022.03.11 팔레트 입수량 추가
			 , PO.SKUKEY
		     , SM.DESC01 
		     , SM.DESC02
		     , DT.SYSLOC AS LOCAKY
		     , ' ' AS TRNUID
		     , PO.MENGE
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE_R
		     , PO.PTNRTY
		     , DECODE(PO.LOTA01, ' ', SLT.STLKY, PO.LOTA01) AS LOTA01
		     , PO.LOTA02
		     , PO.LOTA03
		     , PO.LOTA04
		     , PO.LOTA05
		     , PO.LOTA06
		     , PO.LOTA07
		     , PO.LOTA08
		     , PO.LOTA09
		     , PO.LOTA10
		     , PO.LOTA11
		     , NVL(TRIM(PO.LOTA12),TO_CHAR(SYSDATE,'YYYYMMDD')) AS LOTA12
		     , PO.LOTA13
		     , PO.LOTA14
		     , PO.LOTA15
		     , PO.LOTA15 AS LOTA15_ORG
		     , PO.LOTA16
		     , PO.LOTA17
		     , PO.LOTA18
		     , PO.LOTA19
		     , PO.LOTA20
		     , PO.EBELN  AS SEBELN
		     , PO.EBELP  AS SEBELP
		     , ' '       AS RECVKY
		     , ' '       AS RECVIT
		     , PO.MANDT
		     , PO.SEQNO
		     , PO.EBELN
		     , PO.EBELP
		     , PO.BEDAT
		     , PO.BWART
		     , PO.RTNRSN AS RSNCOD
		     , SZF_GET_RSNCOD_TEXT(#{LANGKY}, #{OWNRKY}, NVL(DT.DOCCAT, '100'), PO.BWART, PO.RTNRSN) AS RSNCODNM
             , PO.RTNTXT AS RCPRSN
		     , SM.ASKU05
		     , SW.MEASKY
		     , SM.EANCOD
		     , MI.UOMKEY AS MUOMKEY
		     
		     , DECODE(PO.IFFLG, 'Y', '0.000', (PO.MENGE - PO.MENGE_R)) AS QTYRCV1
			 , DECODE(PO.IFFLG, 'Y', '0.000', TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000')) AS QTYRCV
			 
			 , NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.000', (PO.MENGE - PO.MENGE_R)), PO.MEINS)),'0.000') AS UOMQTY
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'KG')),'0.000') AS TOT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BAG')),'0.000') AS BAG
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BOX')),'0.000') AS BOX
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'PAL')),'0.000') AS PLT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'SOK')),'0.000') AS SOK
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'EA')),'0.000') AS EA
		     
		     , '' AS TEBELN
		     , PO.LOTA21
             , PO.LOTA22
             , PO.LOTA23
             , PO.LOTA24
			 
			 , PO.CREDAT
		 	 , PO.CRETIM
		 	 , PO.CREUSR
		 	 , PO.LMODAT
		 	 , PO.LMOTIM
		 	 , PO.LMOUSR
		 	 , PO.INDBZL
		 	 , PO.INDARC
		 	 , PO.UPDCHK
		 	 , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = PO.CREUSR),' ') AS CUSRNM
		 	 , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = PO.LMOUSR),' ') AS LUSRNM
		 	 , SLM.STLNM AS LOTA01NM
		 	 , (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC ) AS AREAKY
			 , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC )),' ') AS AREANM
			 , 'FRV' AS STATIT
			 , SM.SKUG01
			 , SM.SKUG02
			 , SM.SKUG03
			 , NVL((SELECT X.USARG1 FROM SKUG05_T X WHERE X.CMCDVL=SM.SKUG05),SKUG04) AS SKUG04
			 , SM.SKUG05
			 , SM.SKUG05 AS SKUG05_1
			 , SLT.QRTAYN
			 , SLT.SHTAYN
			 , SLM.WMSMAK
			 , PO.BWART AS RCPTTY
			 , PO.LIFNR AS DPTNKY
			 , PO.ZEKKO_AEDAT
			 , PO.EINDT AS ASNDAT
			 , 'NEW' AS STATDO
			 , NVL(#{DOCDAT},TO_CHAR(SYSDATE,'YYYYMMDD')) AS DOCDAT
			 , NVL((SELECT DOCCAT FROM DOCTM WHERE DOCUTY = PO.BWART), '100') AS DOCCAT
			 , PO.SIGNI
			 , PO.IFFLG
			 , PO.VGBEL
			 , PO.VGPOS
			 , PO.MRFLG
			 , PO.DLEFLG
			 , ' ' AS LOTA41
			 , ' ' AS LOTA42
			 , ' ' AS LOTA43
			 , ' ' AS LOTA44
			 , ' ' AS LOTA45
			 , '0' AS LOTA46
			 , '0' AS LOTA47
			 , '0' AS LOTA48
			 , ' ' AS LOTA49
			 , ' ' AS LOTA49NM
		<include refid="WmsInbound.INBOUND_SUB_IFID_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WHERE_SQL"/>
          AND PO.EBELN = #{SEBELN}
          AND PO.MRFLG = 'S0'
<!--           AND PO.IFFLG = 'N' -->
          AND ( 
	          1 = 2
	          <if test="STTNEW == &quot;V&quot;">
	          OR PO.IFFLG = 'N'
	          </if>
	          <if test="STTTC2 == &quot;V&quot;">
	          OR PO.IFFLG = 'Y'
	          </if>
	        )
	      <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		  </if>
		  <if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		  </if>
         ORDER BY PO.EBELN, PO.EBELP
         
	</select>
	
	<select id="GR40SubRoll_LIST" parameterType="Map" resultType="DataMap">
		SELECT RLM.PTNRKY
		     , BZ.NAME01 AS PTNRKYNM
		     , RLM.CONTNO
		     , RLM.BARCNO
		     , RLM.ZFBLNO
		     , RLM.ROLLID
		     , RLM.MATNR
		     , RLM.MRGSM
		     , RLM.LENGTH
		     , RLM.NETWT
		     , RLM.WGTMUL
		     , RLM.COREDI
		     , RLM.KUNIT
		     , RLM.CPCOD
		     , RLM.TBRGEW
		     , RLM.RBRGEW
		     , RLM.LUNIT
		     , RLM.DESCRI
		     , RLM.WEIGHT
		     , RLM.RMK1
		     , RLM.RMK2
		     , RLM.RMK3
		     , RLM.RMK4
		     , RLM.RMK5
		     , RLM.SEQ
		     , RLM.ITEMNO
		     , RLM.PTNRPO
		     , RLM.INVONO
		     , RLM.PREFIX
		     , RLM.RECYN
		     , RLM.ITFCNT
		     , RLM.ITFFLG
		     , RLM.ITFETX
		     , RLM.ITFDAT
		     , RLM.ITFTIM
		     , RLM.PRCCNT
		     , RLM.PRCFLG
		     , RLM.PRCETX
		     , RLM.PRCDAT
		     , RLM.PRCTIM
		     , RLM.ADDDAT
		FROM ROLLMA RLM
		  LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = RLM.PTNRKY AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = 'VD'
		WHERE RLM.MATNR = #{SKUKEY}
		  AND EXISTS (
		               SELECT 'X'
		               FROM IFWMS103 X
		               WHERE X.EBELN = #{SEBELN}
<!--                          AND X.IFFLG = 'N' -->
		                 AND X.SIGNI = RLM.CONTNO
		                 AND X.MRFLG = 'S0'
		             )
	</select>
	
	<select id="GR40Confirm_LIST" parameterType="Map" resultType="DataMap">
		
		<include refid="WmsInbound.INBOUND_SUB_WITH_SQL"/>
		SELECT PO.WERKS AS OWNRKY
			 , (SELECT OWNRNM FROM OE_T) AS OWNRNM
		     , PO.WAREKY
		     , (SELECT WARENM FROM WM_T) AS WARENM
			 , NVL(MIP.QTPUOM,'0.000') AS PALQTY
			 , PO.SKUKEY
		     , SM.DESC01 
		     , SM.DESC02
		     , DT.SYSLOC AS LOCAKY
		     , ' ' AS TRNUID
		     , PO.MENGE
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE_R
		     , PO.PTNRTY
		     , RI.LOTA01
		     , RI.LOTA02
		     , RI.LOTA03
		     , RI.LOTA04
		     , RI.LOTA05
		     , RI.LOTA06
		     , RI.LOTA07
		     , RI.LOTA08
		     , RI.LOTA09
		     , RI.LOTA10
		     , RI.LOTA11
		     , NVL(TRIM(RI.LOTA12),TO_CHAR(SYSDATE,'YYYYMMDD')) AS LOTA12
		     , RI.LOTA13
		     , RI.LOTA14
		     , RI.LOTA15
		     , RI.LOTA15 AS LOTA15_ORG
		     , RI.LOTA16
		     , RI.LOTA17
		     , RI.LOTA18
		     , RI.LOTA19
		     , RI.LOTA20
		     , PO.EBELN  AS SEBELN
		     , PO.EBELP  AS SEBELP
		     , RI.RECVKY
		     , RI.RECVIT
		     , PO.MANDT
		     , PO.SEQNO
		     , PO.EBELN
		     , PO.EBELP
		     , PO.BEDAT
		     , PO.BWART
		     , PO.RTNRSN AS RSNCOD
		     , SZF_GET_RSNCOD_TEXT(#{LANGKY}, #{OWNRKY}, NVL(DT.DOCCAT, '100'), PO.BWART, PO.RTNRSN) AS RSNCODNM
             , PO.RTNTXT AS RCPRSN
		     , SM.ASKU05
		     , SW.MEASKY
		     , SM.EANCOD
		     , MI.UOMKEY AS MUOMKEY
		     
		     , NVL((RLM.NETWT * RLM.WGTMUL),'0.000') AS QTYRCV1
			 , RI.QTYRCV
			 
			 , NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, RI.QTYRCV, PO.MEINS)),'0.000') AS UOMQTY
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, RI.QTYRCV, PO.MEINS, 'KG')),'0.000') AS TOT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, RI.QTYRCV, PO.MEINS, 'BAG')),'0.000') AS BAG
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, RI.QTYRCV, PO.MEINS, 'BOX')),'0.000') AS BOX
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, RI.QTYRCV, PO.MEINS, 'PAL')),'0.000') AS PLT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, RI.QTYRCV, PO.MEINS, 'SOK')),'0.000') AS SOK
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, RI.QTYRCV, PO.MEINS, 'EA')),'0.000') AS EA
		     
		     , '' AS TEBELN
		     , RI.LOTA21
             , RI.LOTA22
             , RI.LOTA23
             , RI.LOTA24
			 
			 , RI.CREDAT
		 	 , RI.CRETIM
		 	 , RI.CREUSR
		 	 , RI.LMODAT
		 	 , RI.LMOTIM
		 	 , RI.LMOUSR
		 	 , RI.INDBZL
		 	 , RI.INDARC
		 	 , RI.UPDCHK
		 	 , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = RI.CREUSR),' ') AS CUSRNM
		 	 , NVL((SELECT X.NMLAST FROM USRMA X WHERE X.USERID = RI.LMOUSR),' ') AS LUSRNM
		 	 , SLM.STLNM AS LOTA01NM
		 	 , (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC ) AS AREAKY
			 , NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = PO.WAREKY AND AREAKY = (SELECT LM.AREAKY FROM LOCMA LM WHERE WAREKY = #{WAREKY} AND LOCAKY = DT.SYSLOC )),' ') AS AREANM
			 , 'FRV' AS STATIT
			 , SM.SKUG01
			 , SM.SKUG02
			 , SM.SKUG03
			 , NVL((SELECT X.USARG1 FROM SKUG05_T X WHERE X.CMCDVL=SM.SKUG05),RI.SKUG04) AS SKUG04
			 , SM.SKUG05
			 , SM.SKUG05 AS SKUG05_1
			 , SLT.QRTAYN
			 , SLT.SHTAYN
			 , SLM.WMSMAK
			 , PO.BWART AS RCPTTY
			 , PO.LIFNR AS DPTNKY
			 , PO.ZEKKO_AEDAT
			 , PO.EINDT AS ASNDAT
			 , 'NEW' AS STATDO
			 , NVL(#{DOCDAT},TO_CHAR(SYSDATE,'YYYYMMDD')) AS DOCDAT
			 , NVL((SELECT DOCCAT FROM DOCTM WHERE DOCUTY = PO.BWART), '100') AS DOCCAT
			 , PO.SIGNI
			 , PO.IFFLG
			 , PO.VGBEL
			 , PO.VGPOS
			 , PO.MRFLG
			 , PO.DLEFLG
			 , RI.LOTA41
			 , RI.LOTA42
			 , RI.LOTA43
			 , RI.LOTA44
			 , RI.LOTA45
			 , RI.LOTA46
			 , RI.LOTA47
			 , RI.LOTA48
			 , RI.LOTA49
			 
			 , RLM.PTNRKY
			 , LT42.NAME01 AS PTNRKYNM
			 , RLM.CONTNO
			 , RLM.BARCNO
			 , RLM.ZFBLNO
			 , RLM.ROLLID
			 , RLM.DESCRI
			 , RLM.MRGSM
			 , RLM.LENGTH
			 , RLM.NETWT
			 , RLM.WGTMUL
			 , RLM.COREDI
			 , RLM.MATNR
			 , RLM.KUNIT
			 , RLM.CPCOD
			 , RLM.WEIGHT
			 , RLM.TBRGEW
			 , RLM.RBRGEW
			 , RLM.LUNIT
			 , RLM.RMK1
			 , RLM.RMK2
			 , RLM.RMK3
			 , RLM.RMK4
			 , RLM.RMK5
			 , RLM.SEQ
			 , RLM.ITEMNO
			 , RLM.PTNRPO
			 , RLM.INVONO
			 , RLM.PREFIX
			 , RLM.RECYN      
			 , RLM.ITFCNT
			 , RLM.ITFFLG
			 , RLM.ITFETX
			 , RLM.ITFDAT
			 , RLM.ITFTIM
			 , RLM.PRCCNT
			 , RLM.PRCFLG
			 , RLM.PRCETX
			 , RLM.PRCDAT
			 , RLM.PRCTIM
			 
		<include refid="WmsInbound.INBOUND_SUB_IFID_SQL"/>
		FROM IFWMS103 PO
		  INNER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
		  INNER JOIN SKUWC SW ON SW.WAREKY = #{WAREKY} AND SW.OWNRKY = #{OWNRKY} AND SW.SKUKEY = PO.SKUKEY
		  INNER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
		  INNER JOIN RECDI RI ON RI.SEQNO = PO.SEQNO AND RI.SEBELN = PO.EBELN AND RI.SEBELP = PO.EBELP AND RI.STATIT IN ('FTV','FRV')
          INNER JOIN RECDH RH ON RH.RECVKY = RI.RECVKY
		  LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
		  LEFT OUTER JOIN MEASI MI ON MI.WAREKY = #{WAREKY} AND MI.MEASKY = PO.SKUKEY AND MI.INDDFU = 'V'
		  LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = #{OWNRKY} AND SLM.PLNTKY = RI.LOTA02 AND SLM.STLKY  = RI.LOTA01
		  LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = #{OWNRKY} AND SLT.WAREKY = #{WAREKY} AND SLT.PLNTKY = RI.LOTA02 AND SLT.SKUKEY = RI.SKUKEY
		  LEFT OUTER JOIN MEASI MIP ON MIP.WAREKY = #{WAREKY} AND MIP.MEASKY = PO.SKUKEY AND MIP.UOMKEY = 'PAL'
          
          LEFT OUTER JOIN ROLLMA RLM ON RLM.CONTNO = RI.LOTA41 AND RLM.BARCNO = RI.LOTA15 AND RLM.PTNRKY = RI.LOTA42
          LEFT OUTER JOIN BZPTN LT42 ON LT42.PTNRKY = RI.LOTA42 AND LT42.OWNRKY = #{OWNRKY} AND LT42.PTNRTY = 'VD'
          
		<include refid="WmsInbound.INBOUND_SUB_WHERE_SQL"/>
          AND PO.EBELN = #{SEBELN}
<!--           AND PO.IFFLG = 'N' -->
          AND PO.MRFLG = 'S0'
          AND PO.LOTA01='2400'
          AND PO.LOTA02='P100'
        ORDER BY RI.RECVKY, RI.RECVIT
         
	</select>
	
	<select id="GR40_STLM_MAP" parameterType="Map" resultType="DataMap">
		SELECT SLT.QRTAYN
             , SLT.SHTAYN
             , SLM.WMSMAK
             <include refid="WmsInbound.INBOUND_SUB_IFID_SQL"/>
		FROM IFWMS103 PO
		  LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = PO.WERKS AND SLM.PLNTKY = #{LOTA02} AND SLM.STLKY  = #{LOTA01}
          LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = PO.WERKS AND SLT.WAREKY = #{WAREKY} AND SLT.PLNTKY = #{LOTA02} AND SLT.SKUKEY = #{SKUKEY}
        WHERE PO.WERKS = #{OWNRKY}
	      AND PO.EBELN = #{SEBELN}
	      AND PO.EBELP = #{SEBELP}
	</select>
	
	<select id="GR40_ROLLMA_PTNRKY_MAP" parameterType="Map" resultType="DataMap">
		SELECT RLM.PTNRKY
			 , BPN.NAME01 AS PTNRKYNM
			 , RLM.DESCRI 
		FROM IFWMS103 PO
		  INNER JOIN ROLLMA RLM ON RLM.CONTNO = PO.SIGNI AND RLM.MATNR = PO.MATNR
			LEFT OUTER JOIN BZPTN BPN ON BPN.OWNRKY = #{OWNRKY} AND BPN.PTNRKY = RLM.PTNRKY AND BPN.PTNRTY = 'VD'
        WHERE PO.WERKS = #{OWNRKY}
	      AND PO.EBELN = #{SEBELN}
	      AND ROWNUM = 1
	</select>
	
	<select id="GR40_RECVKY_MAP" parameterType="Map" resultType="DataMap">
		SELECT RI.RECVKY
		FROM RECDI RI
		 INNER JOIN RECDH RH ON RH.RECVKY = RI.RECVKY AND RH.OWNRKY = #{OWNRKY} AND RH.WAREKY = #{WAREKY}
		 INNER JOIN IFWMS103 PO 
		         ON PO.EBELN = RI.SEBELN 
		        AND PO.EBELP = RI.SEBELP
		        AND PO.EBELN != ' '
		        AND PO.IFFLG = 'Y'
		        AND PO.STATUS IN ('U','C') 
		        AND PO.PRCFLG = 'C'
		        AND RI.STATIT != 'FCV'
		        AND PO.EBELN = #{SEBELN}
		WHERE ROWNUM = 1
		GROUP BY RI.RECVKY
	</select>
	
	<select id="GR40_ROLL_MAP" parameterType="Map" resultType="DataMap">
		SELECT NVL(A.CNT,0) AS CNT, NVL(B.FTV_CNT,0) AS FTV_CNT
		FROM (
		SELECT #{SEBELN} AS SEBELN, COUNT(1) AS CNT
		FROM ROLLMA RLM
		  INNER JOIN IFWMS103 PO 
		          ON PO.EBELN = #{SEBELN}
		         AND PO.SIGNI = RLM.CONTNO
		         AND PO.MATNR = RLM.MATNR
		         AND PO.MRFLG = 'S0'
		         AND PO.LOTA01='2400'
		         AND PO.LOTA02='P100'
		         AND PO.IFFLG = 'N'
		         AND PO.STATUS IN ('U','C')
		) A
		LEFT OUTER JOIN (
		                    SELECT #{SEBELN} AS SEBELN
							     , COUNT(1) AS FTV_CNT
							FROM RECDI RI
							WHERE RI.SEBELN = #{SEBELN}
							  AND RI.STATIT = 'FTV'
		                ) B
		           ON B.SEBELN = A.SEBELN
	</select>
	
	<insert id="GR40_IFWMS223_INSERT" parameterType="Map">
		INSERT INTO IFWMS223
		     (
		       MANDT
		     , SEQNO
		     , SADJKY
		     , SADJIT
		     , ORDCAT
		     , BWART
		     , WERKS
		     , MATNR
		     , QTADJU
		     , TMATNR
		     , MEINS
		     , VGBEL
		     , VGPOS
		     , STATUS
		     , WAREKY
		     , ZDOC_NO
		     , ZDOC_ITEM
		     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
		     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
		     , TLOTA01, TLOTA02, TLOTA03, TLOTA04, TLOTA05, TLOTA06, TLOTA07, TLOTA08, TLOTA09, TLOTA10
		     , TLOTA11, TLOTA12, TLOTA13, TLOTA14, TLOTA15, TLOTA16, TLOTA17, TLOTA18, TLOTA19, TLOTA20
		     , CDATE, CREDAT, CRETIM, CREUSR
		     , IFID
		     , IFFLG
		     , ITFFLG, ITFDAT, ITFTIM
		     , PRCFLG
		     , LOGSEQNO
		     , BWARTSAP
		     )	
		     SELECT NVL(#{MANDT},'100') AS MANDT
		          , SEQ_IFWMS223.NEXTVAL AS SEQNO
		          , RI.RECVKY AS SADJKY
		          , RI.RECVIT AS SADJIT
		          , '400' AS ORDCAT
		          , '401' AS BWART
		          , RH.OWNRKY
		          , RI.SKUKEY AS MATNR
		          , RI.QTYRCV AS QTADJU
		          , RI.SKUKEY AS TMATNR
		          , RI.UOMKEY AS MEINS
		          , RI.SSORNU AS VGBEL
		          , RI.SSORIT AS VGPOS
		          , 'C'
		          , RH.WAREKY AS WAREKY
		          , RI.RECVKY AS SADJKY
		          , RI.RECVIT AS SADJIT
				  
		          , RI.LOTA01, RI.LOTA02, RI.LOTA03, RI.LOTA04, RI.LOTA05
		          , RI.LOTA06, RI.LOTA07, RI.LOTA08, RI.LOTA09, RI.LOTA10
		          , RI.LOTA11, RI.LOTA12, RI.LOTA13, RI.LOTA41 AS LOTA14, RI.LOTA41 AS LOTA15
		          , RI.LOTA16, RI.LOTA17, RI.LOTA18, RI.LOTA19, RI.LOTA20
				  
				  , RI.LOTA01 AS TLOTA01, RI.LOTA02 AS TLOTA02, RI.LOTA03 AS TLOTA03, RI.LOTA04 AS TLOTA04, RI.LOTA05 AS TLOTA05
		          , RI.LOTA06 AS TLOTA06, RI.LOTA07 AS TLOTA07, RI.LOTA08 AS TLOTA08, RI.LOTA09 AS TLOTA09, RI.LOTA10 AS TLOTA10
		          , RI.LOTA11 AS TLOTA11, RI.LOTA12 AS TLOTA12, RI.LOTA13 AS TLOTA13, RI.LOTA14 AS TLOTA14, RI.LOTA15 AS TLOTA15
		          , RI.LOTA16 AS TLOTA16, RI.LOTA17 AS TLOTA17, RI.LOTA18 AS TLOTA18, RI.LOTA19 As TLOTA19, RI.LOTA20 AS TLOTA20
				  
		          , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
		          , #{IFID}
		          , 'N' --IFFLG
		          , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
		          , 'I' --PRCFLG
		          , #{LOGSEQNO}
		          , #{BWARTSAP}
		     FROM RECDH RH
			   INNER JOIN RECDI RI ON RI.RECVKY = RH.RECVKY
			 WHERE RH.OWNRKY = #{OWNRKY}
			   AND RH.WAREKY = #{WAREKY}
			   AND RH.RECVKY IN (${RECVKYIN})
	</insert>
	
	<select id="GR40_CONTNO_ITEMCNT_COUNT" parameterType="Map" resultType="Integer">
		SELECT COUNT(1) AS CNT
		FROM RECDI RI
		WHERE RI.SEBELN = #{SEBELN}
		  AND RI.STATIT = 'FTV'
		  AND RI.LOTA41 = #{LOTA41}
		  AND RI.LOTA14 = #{LOTA14}
	</select>
	
	<select id="GR40_SKUKEY_GRP_LIST" parameterType="Map" resultType="DataMap">
		SELECT PO.SKUKEY
		     , SUM(PO.MENGE) AS MENGE
		FROM IFWMS103 PO
		WHERE PO.WAREKY = #{WAREKY}
		  AND PO.WERKS = #{OWNRKY}
		  AND PO.EBELN = #{SEBELN}
		  AND PO.MRFLG = 'S0'
		  AND PO.STATUS IN ('U','C')
		  AND PO.IFFLG IN ('N','Y') 
		GROUP BY PO.SKUKEY
	</select>
	
	<delete id="GR40_SEBELN_HEAD_DELETE" parameterType="Map">
	   DELETE 
	   FROM RECDH
	   WHERE RECVKY = #{RECVKY}
	</delete>
	
	<delete id="GR40_ROLLMA_ITEM_DELETE" parameterType="Map">
	   DELETE 
	   FROM ROLLMA
	   WHERE CONTNO = #{CONTNO}
	     AND BARCNO = #{BARCNO}
	     AND PTNRKY = #{PTNRKY}
	     AND ADDDAT = 'V'
	</delete>
	
	<delete id="GR40_SEBELN_ITEM_ALL_DELETE" parameterType="Map">
	   DELETE 
	   FROM RECDI
	   WHERE RECVKY = #{RECVKY}
	     AND STATIT = 'FTV'
	</delete>
	
	<delete id="GR40_SEBELN_ITEM_DELETE" parameterType="Map">
	   DELETE 
	   FROM RECDI
	   WHERE RECVKY = #{RECVKY}
	     AND RECVIT = #{RECVIT}
	     AND STATIT = 'FTV'
	</delete>
	
	<select id="GR40_RECDI_ITEMCNT_COUNT" parameterType="Map" resultType="Integer">
		SELECT COUNT(1) AS CNT
		  FROM RECDI
		 WHERE RECVKY = #{RECVKY}
	</select>
	
	<update id="GR40_CANCEL_UPDATE" parameterType="Map">
		UPDATE IFWMS103 
		SET
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'), 
			LMOUSR = #{SES_USER_ID},
			IFFLG = 'N'
		 WHERE EBELN = #{SEBELN}
	</update>
	
	<update id="GR40_COMPLETE_UPDATE" parameterType="Map">
		UPDATE IFWMS103 
		SET
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'), 
			LMOUSR = #{SES_USER_ID},
			IFFLG = 'Y'
		 WHERE EBELN = #{SEBELN}
	</update>
	
	<insert id="GR40_COMPLETE_BATCH_INSERT" parameterType="Map">
		UPDATE IFWMS103 
		SET
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'), 
			IFFLG = 'Y',
			LMOUSR = (
						 SELECT DISTINCT X.SES_USER_ID
						 FROM (
								<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
									SELECT  #{item.SES_USER_ID, jdbcType=VARCHAR} AS SES_USER_ID
						 			 FROM DUAL 
								</foreach>
							  ) X
	                 )
		 WHERE 1 = 1
		<foreach item="item" index="index" collection="list" open=" AND EBELN IN ( " separator="," close=" ) ">
			#{item.SEBELN, jdbcType=VARCHAR}
		</foreach>
		
	</insert>
	
	<update id="GR40_ROLLMA_INIT_UPDATE" parameterType="Map">
		UPDATE ROLLMA A SET A.RECYN = ' '
						  , A.PRCFLG = 'N'
						  , A.PRCCNT = '0'
						  , A.LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
						  , A.LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
						  , A.LMOUSR = #{SES_USER_ID}
		WHERE A.CONTNO = #{CONTNO}
	</update>
	
	<delete id="GR40_ROLLMA_INIT_DELETE" parameterType="Map">
		DELETE
		FROM ROLLMA
		WHERE CONTNO = #{CONTNO}
		  AND ADDDAT = 'V'
	</delete>
	
	<insert id="GR40_ROLLMA_MERGE_BATCH_INSERT" parameterType="Map">
		MERGE INTO ROLLMA A
		USING (
		         <foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
		         	SELECT #{item.PTNRKY, jdbcType=VARCHAR} AS PTNRKY
			             , #{item.CONTNO, jdbcType=VARCHAR} AS CONTNO
			             , #{item.BARCNO, jdbcType=VARCHAR} AS BARCNO
			             , #{item.ZFBLNO, jdbcType=VARCHAR} AS ZFBLNO
			             , #{item.ROLLID, jdbcType=VARCHAR} AS ROLLID
			             , #{item.MATNR, jdbcType=VARCHAR} AS MATNR
			             , #{item.DESCRI, jdbcType=VARCHAR} AS DESCRI
					     , #{item.MRGSM,  jdbcType=VARCHAR} AS MRGSM
					     , #{item.LENGTH, jdbcType=VARCHAR} AS LENGTH
					     , #{item.NETWT,  jdbcType=VARCHAR} AS NETWT
					     , #{item.WGTMUL, jdbcType=VARCHAR} AS WGTMUL
					     , #{item.COREDI, jdbcType=VARCHAR} AS COREDI
					     , #{item.KUNIT,  jdbcType=VARCHAR} AS KUNIT
					     , #{item.CPCOD,  jdbcType=VARCHAR} AS CPCOD
					     , #{item.WEIGHT, jdbcType=VARCHAR} AS WEIGHT
					     , NVL(TRIM(#{item.TBRGEW, jdbcType=VARCHAR}),'0') AS TBRGEW
					     , #{item.RBRGEW, jdbcType=VARCHAR} AS RBRGEW
					     , #{item.LUNIT,  jdbcType=VARCHAR} AS LUNIT
					     , #{item.RMK1,   jdbcType=VARCHAR} AS RMK1
					     , #{item.RMK2,   jdbcType=VARCHAR} AS RMK2
					     , #{item.RMK3,   jdbcType=VARCHAR} AS RMK3
					     , #{item.RMK4,   jdbcType=VARCHAR} AS RMK4
					     , #{item.RMK5,   jdbcType=VARCHAR} AS RMK5
					     , #{item.SES_USER_ID, jdbcType=VARCHAR} AS SES_USER_ID
					     , '0' AS SEQ
					     , '0' AS ITEMNO
	                     , ' ' AS PTNRPO
	                     , ' ' AS INVONO
	                     , ' ' AS PREFIX
	                     , #{item.RECYN,   jdbcType=VARCHAR} AS RECYN
	                     , '0' AS ITFCNT
	                     , 'N' AS ITFFLG
	                     , ' ' AS ITFETX
	                     , ' ' AS ITFDAT
	                     , ' ' AS ITFTIM
	                     , DECODE(#{item.RECYN,   jdbcType=VARCHAR}, 'V', '1', '0') AS PRCCNT
	                     , DECODE(#{item.RECYN,   jdbcType=VARCHAR}, 'V', 'C', 'N') AS PRCFLG
	                     , ' ' AS PRCETX
	                     , DECODE(#{item.RECYN,   jdbcType=VARCHAR}, 'V', TO_CHAR(SYSDATE, 'YYYYMMDD'), ' ') AS PRCDAT
					     , DECODE(#{item.RECYN,   jdbcType=VARCHAR}, 'V', TO_CHAR(SYSDATE, 'HH24MISS'), ' ') AS PRCTIM
					     , 'V' AS ADDDAT
		         	FROM DUAL
		         </foreach>
		      ) B
		ON (A.CONTNO = B.CONTNO AND A.BARCNO = B.BARCNO AND A.PTNRKY = B.PTNRKY)
		WHEN MATCHED THEN
			UPDATE SET A.ROLLID = B.ROLLID
			         , A.DESCRI = B.DESCRI
					 , A.MRGSM  = B.MRGSM
					 , A.LENGTH = B.LENGTH
					 , A.NETWT  = B.NETWT
					 , A.WGTMUL = B.WGTMUL
					 , A.COREDI = B.COREDI
					 , A.KUNIT  = B.KUNIT
					 , A.CPCOD  = B.CPCOD
					 , A.WEIGHT = B.WEIGHT
					 , A.RBRGEW = B.RBRGEW
					 , A.LUNIT  = B.LUNIT
					 , A.RMK1   = B.RMK1
					 , A.RMK2   = B.RMK2
					 , A.RMK3   = B.RMK3
					 , A.RMK4   = B.RMK4
					 , A.RMK5   = B.RMK5					 
					 , A.PRCCNT = B.PRCCNT
					 , A.RECYN  = B.RECYN
					 , A.PRCFLG = B.PRCFLG
					 , A.PRCDAT = B.PRCDAT
					 , A.PRCTIM = B.PRCTIM	
					 , A.LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
					 , A.LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
					 , A.LMOUSR = B.SES_USER_ID
		WHEN NOT MATCHED THEN
			INSERT (
			     	  PTNRKY, CONTNO, BARCNO, ZFBLNO, ROLLID
	                , MATNR,  MRGSM,  LENGTH, NETWT,  WGTMUL
	                , COREDI,  KUNIT,  CPCOD,  TBRGEW, RBRGEW
	                , LUNIT,  DESCRI, WEIGHT, RMK1,   RMK2
	                , RMK3,   RMK4,   RMK5,   SEQ,    ITEMNO
	                , PTNRPO, INVONO, PREFIX, RECYN,  ITFCNT
	                , ITFFLG, ITFETX, ITFDAT, ITFTIM, PRCCNT
	                , PRCFLG, PRCETX, PRCDAT, PRCTIM, CREDAT
	                , CRETIM, CREUSR, LMODAT, LMOTIM, LMOUSR
	                , ADDDAT
			) VALUES (
				      B.PTNRKY, B.CONTNO, B.BARCNO, B.ZFBLNO, B.ROLLID
	                , B.MATNR,  B.MRGSM,  B.LENGTH, B.NETWT,  B.WGTMUL
	                , B.COREDI,  B.KUNIT,  B.CPCOD,  B.TBRGEW, B.RBRGEW
	                , B.LUNIT,  B.DESCRI, B.WEIGHT, B.RMK1,   B.RMK2
	                , B.RMK3,   B.RMK4,   B.RMK5,   B.SEQ,    B.ITEMNO
	                , B.PTNRPO, B.INVONO, B.PREFIX, B.RECYN,  B.ITFCNT
	                , B.ITFFLG, B.ITFETX, B.ITFDAT, B.ITFTIM, B.PRCCNT
	                , B.PRCFLG, B.PRCETX, B.PRCDAT, B.PRCTIM, TO_CHAR(SYSDATE, 'YYYYMMDD')
	                , TO_CHAR(SYSDATE, 'HH24MISS'), B.SES_USER_ID, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), B.SES_USER_ID
	                , B.ADDDAT
			)
	</insert>
	
	<!-- GR40 SQL END -->
	
	<select id="SKUG05val_MAP" parameterType="Map" resultType="DataMap">
		SELECT CASE WHEN SKUG05 = ' ' THEN 'OT'
            		WHEN SKUG05 = '00' THEN 'OT'
            		WHEN SKUG05 = '10' THEN 'PS'
            		WHEN SKUG05 = '20' THEN 'HL' ELSE ' ' END AS FLG 
          FROM RECDI
		<if test="RECVKY != null and RECVKY != ''">
		WHERE RECVKY = #{RECVKY}
		  AND ROWNUM = 1
		</if> 
	</select>	
	
	<select id="SKUG05Check_MAP" parameterType="Map" resultType="DataMap">
		SELECT CASE WHEN SKUG05 = ' ' THEN 'OT'
            		WHEN SKUG05 = '00' THEN 'OT'
            		ELSE ' ' END AS FLG 
          FROM RECDI
		<if test="RECVKY != null and RECVKY != ''">
		WHERE RECVKY = #{RECVKY}
		  AND ROWNUM = 1
		</if> 
	</select>	
	
	<select id="Arnoval_MAP" parameterType="Map" resultType="DataMap">
		SELECT AR_NO AS ARNO
          FROM RECDI
		<if test="RECVKY != null and RECVKY != ''">
		WHERE RECVKY = #{RECVKY}
		  AND ROWNUM = 1
		</if> 
	</select>	
	
	
	
	
	<select id="GR16_LIST" parameterType="Map" resultType="DataMap">
		WITH IF103_T AS (
			SELECT PO.SEQNO
			     , PO.WERKS
				 , PO.EBELN
				 , PO.EBELP
				 , PO.WAREKY
				 , PO.BWART
				 , PO.EINDT
				 , PO.ORDCAT
				 , PO.LIFNR
			     , PO.PTNRTY
				 , PO.BEDAT
				 , PO.IFID
			     , PO.MRFLG
			     , PO.BWARTSAP
			     , PO.DLEFLG
			     , PO.AR_NO
				 , PO.AR_REV
				 , PO.IFFLG
				 , PO.LOTNUM
				 , PO.SKUKEY
				 , PO.MEINS
				 , PO.LOTA01
				 , PO.LOTA02
				 , PO.LOTA14
				 , PO.LOTA15
				 , PO.FLOTA01
				 , PO.FLOTA02
				 , (PO.MENGE-PO.MENGE_R) AS QTYRCV1
				 , BZ.NAME01 AS DPTNNM
				 , LM.AREAKY AS AREAKY
				 , AM.SHORTX AS AREANM
				 , SLM.WMSMAK
				 , ( CASE WHEN SLT.SHTAYN = 'V' AND SLM.WMSMAK = 'V' THEN 'V' ELSE '' END ) AS IMIB01
     		 	 , ( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN 'V' ELSE '' END ) AS IMIB02
     		 	 , ( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) ELSE '' END ) AS IMIB02_LOTA01
			FROM IFWMS103 PO
			  LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
			  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
			  LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
			  LEFT OUTER JOIN LOTAT LT ON LT.LOTNUM = PO.LOTNUM
			  LEFT OUTER JOIN LOCMA LM ON LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC
			  LEFT OUTER JOIN AREMA AM ON AM.WAREKY = #{WAREKY} AND AM.AREAKY = LM.AREAKY
			  LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = #{OWNRKY} AND SLT.WAREKY = #{WAREKY} AND SLT.PLNTKY = PO.LOTA02 AND SLT.SKUKEY = PO.SKUKEY
			  LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = #{OWNRKY} AND SLM.PLNTKY = PO.LOTA02 AND SLM.STLKY  = NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) AND SLM.WMSMAK = 'V'
			WHERE PO.WAREKY = #{WAREKY}
			  AND PO.WERKS  = #{OWNRKY}
			  AND PO.STATUS IN ('U','C')
			  AND PO.IFFLG IN ('N','Y')
			  AND PO.PRCFLG = 'C'
			  AND PO.MRFLG != 'S0'
			  AND EXISTS (
			               SELECT 'X'
			               FROM DOCPG X
			               WHERE X.PROGID = #{PROGID}
			                 AND X.DOCUTY = PO.BWART
			             )
			  AND ( 
		          1 = 2
		          <if test="STTNEW == &quot;V&quot;">
		          OR PO.IFFLG = 'N'
		          </if>
		          <if test="STTTC2 == &quot;V&quot;">
		          OR PO.IFFLG = 'Y'
		          </if>
		        )
		    <if test="SKUG01 != null and SKUG01 != ''">
				AND SM.SKUG01 = #{SKUG01}
			</if>
			<if test="SKUL01 != null and SKUL01 != ''">
				AND SM.SKUL01 = #{SKUL01}
			</if>
			<if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			</if>
			
		),
		TDI_T AS (
		    SELECT PO.EBELN
			     , PO.EBELP
			     , LA.OWNRKY
			     , LA.LOTA11
			     , LA.LOTA14
			     , LA.LOTA15
			     , LA.LOTNUM
			     , LA.LOTA21
			     , LA.LOTA22
			     , LA.LOTA23
			     , LA.LOTA24
			     , PO.IFFLG
			FROM IF103_T PO
			  INNER JOIN TMP_TRANS TT 
			          ON TT.SVBELN = PO.EBELN
		             AND TT.SPOSNR = PO.EBELP
			  INNER JOIN LOTAT LA
			          ON LA.SKUKEY = TT.SKUKEY
			         AND LA.LOTA14 = TT.LOTA14
			         AND LA.LOTNUM = ( SELECT MIN(X.LOTNUM) FROM LOTAT X WHERE X.SKUKEY=LA.SKUKEY AND X.LOTA14=LA.LOTA14 )
			WHERE PO.BWART = '121'
			  AND PO.WERKS = #{OWNRKY}
			  AND PO.MRFLG != 'S0'
			  <if test="LOTA14_SQL != null and LOTA14_SQL != ''">
			  ${LOTA14_SQL}
			  </if>
			  AND EXISTS (
			               SELECT 'X'
			               FROM STLMA X
			               WHERE X.OWNRKY = #{OWNRKY} 
			                 AND X.WAREKY = (
			                                  SELECT SA.WAREKY
			                                  FROM STLMA SA
			                                  WHERE SA.OWNRKY = #{OWNRKY} 
			                                    AND SA.PLNTKY = PO.FLOTA02 
			                                    AND SA.STLKY = PO.FLOTA01
			                                )
			                 AND X.WMSMAK = 'V'
			                 AND X.OWNRKY = PO.WERKS
		         			 AND X.PLNTKY = PO.FLOTA02
		         			 AND X.STLKY = PO.FLOTA01
			             )
		),
		RICNT_T AS (
			SELECT RI.SEBELN, RI.SEQNO, RI.LOTA14, COUNT(1) AS CNT
			FROM RECDI RI
			WHERE EXISTS (
			                SELECT 'X'
			                FROM TDI_T X
			                WHERE X.EBELN = RI.SEBELN
			             )
			  AND EXISTS (
			                SELECT 'X'
			                FROM RECDH RH
			                WHERE RH.RECVKY = RI.RECVKY
			                  AND RH.STATDO != 'RCN'
			             )
			GROUP BY RI.SEBELN, RI.SEQNO, RI.LOTA14
		)
		
		SELECT A.OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = #{OWNRKY}), ' ') AS OWNRNM
			 , A.EBELN
			 , A.SEBELN
			 , A.DOCKEY
			 , A.WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM	 
			 , A.DOCUTY
			 , A.RCPTTY
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, A.BWART) AS RCPTNM
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, A.BWART) AS DOCTNM
			 , A.ASNDAT
			 , A.DOCCAT	 
			 , SZF_GET_DOCCAT_TEXT('', A.DOCCAT) AS DOCCATNM	 
			 , A.DOCDAT
			 , A.DPTNKY
			 , A.DPTNNM	 
			 , A.STATDO
		     , SZF_GET_CMCDV_CDESC1_TEXT('', 'STATDO', A.STATDO ) AS STATDONM
		     , A.AREAKY
		     , A.AREANM
		     , A.DOCTXT
			 , A.PTNRTY
			 , A.BEDAT
			 , A.IFID_RECV
			 , A.MRFLG
		     , A.BWARTSAP
		     , A.DLEFLG
		     , A.AR_NO
			 , A.AR_REV
		     , A.SAPIFYN
		     , A.LOTA14_EMPTY_YN
		     , A.COAYN
		     , A.QTYRCV1
		     , A.WMSMAK
		     , A.IMIB01
		     , A.IMIB02
		     , A.IMIB02_LOTA01
		FROM (
			SELECT #{OWNRKY} AS OWNRKY

				 , PO.EBELN
				 , PO.EBELN AS SEBELN
				 , PO.EBELN AS DOCKEY
				 , #{WAREKY} AS WAREKY
				 , MAX(PO.BWART) AS DOCUTY
				 , MAX(PO.BWART) AS RCPTTY
				 , MAX(PO.BWART) AS BWART
				 , MAX(PO.EINDT) AS ASNDAT
				 , MAX(PO.ORDCAT) AS DOCCAT	 
				 , TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT
				 , MAX(PO.LIFNR) AS DPTNKY
				 , MAX(PO.DPTNNM) AS DPTNNM	 
				 , DECODE(SUM( CASE WHEN PO.IFFLG != 'Y' THEN 1 ELSE 0 END ), 0, 'FRV', 'NEW') AS STATDO
			     , MAX(PO.AREAKY) AS AREAKY
			     , MAX(PO.AREANM) AS AREANM
			     , ' ' AS DOCTXT
				 , MAX(PO.PTNRTY) AS PTNRTY
				 , MAX(PO.BEDAT) AS BEDAT
				 , MAX(PO.IFID) AS IFID_RECV
				 , MAX(PO.MRFLG) AS MRFLG
			     , MAX(PO.BWARTSAP) AS BWARTSAP
			     , MAX(PO.DLEFLG) AS DLEFLG
			     , MAX(PO.AR_NO) AS AR_NO
				 , MAX(PO.AR_REV) AS AR_REV
			     , 'V' AS SAPIFYN
			     , (CASE WHEN (CASE WHEN TRIM(MAX(PO.LOTA14)) IS NULL THEN 1 ELSE 0 END)=0 THEN 'N' ELSE 'Y' END) AS LOTA14_EMPTY_YN
			     , (CASE WHEN 0 = (SELECT COUNT(0) FROM COAMA WHERE SEBELN = PO.EBELN) THEN ' ' ELSE 'V' END) AS COAYN
			     , SUM(PO.QTYRCV1) AS QTYRCV1
			     , MIN(PO.WMSMAK) AS WMSMAK
			     , MAX(PO.IMIB01) AS IMIB01
		         , MAX(PO.IMIB02) AS IMIB02
		         , MAX(PO.IMIB02_LOTA01) AS IMIB02_LOTA01			     
			FROM IF103_T PO
			  INNER JOIN TDI_T TI_T ON TI_T.EBELN = PO.EBELN AND TI_T.EBELP = PO.EBELP AND TI_T.IFFLG = PO.IFFLG
  			  INNER JOIN RICNT_T RT_T ON RT_T.SEBELN = PO.EBELN AND RT_T.SEQNO = PO.SEQNO AND RT_T.LOTA14 = TI_T.LOTA14
			WHERE 1=1			  
			  <choose>
		        <when test="LOTA14_SQL != null and LOTA14_SQL != ''">
				  AND ( 
				        1 = 2
				        <if test="STTNEW == &quot;V&quot;">
				        OR DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, 'Y' ) = 'N'
				        </if>
				        <if test="STTTC2 == &quot;V&quot;">
				        OR DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, 'Y' ) = 'Y'
				        </if>
				      )
				</when>
			    <otherwise>
			    	AND ( 
				        1 = 2
				        <if test="STTNEW == &quot;V&quot;">
				        OR PO.IFFLG = 'N'
				        </if>
				        <if test="STTTC2 == &quot;V&quot;">
				        OR PO.IFFLG = 'Y'
				        </if>
				      )
			    </otherwise>
			  </choose>
			  <if test="LOTA14_TR_SQL != null and LOTA14_TR_SQL != ''">
				${LOTA14_TR_SQL}
			  </if>
			GROUP BY PO.EBELN
			ORDER BY PO.EBELN DESC
		) A
	</select>
	
	<select id="GR16Sub_LIST" parameterType="Map" resultType="DataMap">
		
		<include refid="WmsInbound.INBOUND_SUB_WITH_SQL"/>
		,
		TDI_T AS (
		    SELECT IWM103.EBELN
			     , IWM103.EBELP
			     , LA.OWNRKY
			     , LA.LOTA11
			     , LA.LOTA14
			     , LA.LOTA15
<!-- 			     , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, IWM103.SKUKEY, TI.QTCOMP, TI.AUOMKY, IWM103.MEINS)),'0.000') AS QTCOMP -->
			     , (IWM103.MENGE - IWM103.MENGE_R) AS QTCOMP
			     , LA.LOTNUM
			     , LA.LOTA21
			     , LA.LOTA22
			     , LA.LOTA23
			     , LA.LOTA24
			     , IWM103.IFFLG
			FROM IFWMS103 IWM103
			  INNER JOIN TMP_TRANS TT 
			          ON TT.SVBELN = IWM103.EBELN
		             AND TT.SPOSNR = IWM103.EBELP
			  INNER JOIN LOTAT LA
			          ON LA.SKUKEY = TT.SKUKEY
			         AND LA.LOTA14 = TT.LOTA14
			         AND LA.LOTNUM = ( SELECT MIN(X.LOTNUM) FROM LOTAT X WHERE X.SKUKEY=LA.SKUKEY AND X.LOTA14=LA.LOTA14 )
			WHERE IWM103.BWART = '121'
			  AND IWM103.WERKS = #{OWNRKY}
			  AND IWM103.EBELN = #{SEBELN}
			  AND IWM103.MRFLG != 'S0'
			  AND IWM103.STATUS IN ('U','C')
			  AND IWM103.IFFLG IN ('N','Y') 
			  AND IWM103.PRCFLG = 'C'
			  AND EXISTS (
			               SELECT 'X'
			               FROM STLMA X
			               WHERE X.OWNRKY = #{OWNRKY} 
			                 AND X.WAREKY = (
			                                  SELECT SA.WAREKY
			                                  FROM STLMA SA
			                                  WHERE SA.OWNRKY = #{OWNRKY} 
			                                    AND SA.PLNTKY = IWM103.FLOTA02 
			                                    AND SA.STLKY = IWM103.FLOTA01
			                                )
			                 AND X.WMSMAK = 'V'
			                 AND X.OWNRKY = IWM103.WERKS
                 			 AND X.PLNTKY = IWM103.FLOTA02
                 			 AND X.STLKY = IWM103.FLOTA01
			             )
		),
		RICNT_T AS (
			SELECT RI.SEBELN, RI.SEQNO, RI.LOTA14, COUNT(1) AS CNT
			FROM RECDI RI
			WHERE RI.SEBELN =#{SEBELN}
			  AND EXISTS (
			                SELECT 'X'
			                FROM RECDH RH
			                WHERE RH.RECVKY = RI.RECVKY
			                  AND RH.STATDO != 'RCN'
			             )
			GROUP BY RI.SEBELN, RI.SEQNO, RI.LOTA14
		)
		SELECT PO.WERKS AS OWNRKY
			 , (SELECT OWNRNM FROM OE_T) AS OWNRNM
		     , PO.WAREKY
		     , (SELECT WARENM FROM WM_T) AS WARENM
			 , NVL(DECODE(SM.SKUG05, '10', ZT.PALCNT, NVL(MIP.QTPUOM,'0.000')), '0.000') AS PALQTY -- 2022.03.11 팔레트 입수량 추가
			 , PO.SKUKEY
		     , SM.DESC01 
		     , SM.DESC02
		     , DT.SYSLOC AS LOCAKY
		     , ' ' AS TRNUID
		     , PO.MENGE
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE_R
		     , PO.PTNRTY
		     , NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) AS LOTA01
		     , PO.LOTA01 AS LOTA01_ORG
		     , PO.LOTA02
		     , PO.LOTA02 AS LOTA02_ORG
		     , PO.LOTA03
		     , PO.LOTA03 AS LOTA03_ORG
		     , PO.LOTA04
		     , PO.LOTA05
		     , PO.LOTA06
		     , (
		     		CASE WHEN PO.BWART='131' AND PO.SOBKZ='E' THEN TRIM(PO.VGBEL)||TRIM(PO.VGPOS)
		     		 	 ELSE PO.LOTA07
		     		END
		        ) AS LOTA07
		     , PO.LOTA07 AS LOTA07_ORG
		     , PO.LOTA08
		     , PO.LOTA08 AS LOTA08_ORG
		     , PO.LOTA09
		     , PO.LOTA10
		     , NVL(TRIM(PO.LOTA12),TO_CHAR(SYSDATE,'YYYYMMDD')) AS LOTA12
		     , PO.LOTA13
		     , PO.LOTA15
		     , PO.LOTA16
		     , PO.LOTA16 AS LOTA16_ORG
		     , PO.LOTA17
		     , PO.LOTA17 AS LOTA17_ORG
		     , PO.LOTA18
		     , PO.LOTA19
		     , PO.LOTA20
		     , PO.EBELN  AS SEBELN
		     , PO.EBELP  AS SEBELP
		     , ' '       AS RECVKY
		     , ' '       AS RECVIT
		     , PO.MANDT
		     , PO.SEQNO
		     , PO.EBELN
		     , PO.EBELP
		     , PO.BEDAT
		     , PO.BWART
		     , PO.RTNRSN AS RSNCOD-- 반품사유
		     , SZF_GET_RSNCOD_TEXT(#{LANGKY}, #{OWNRKY}, NVL(DT.DOCCAT, '100'), PO.BWART, PO.RTNRSN) AS RSNCODNM -- 반품사유명
             , PO.RTNTXT AS RCPRSN -- 상세사유
		     , SM.ASKU05
		     , SW.MEASKY AS MEASKY 
		     , SM.EANCOD
		     , MI.UOMKEY AS MUOMKEY
			    , ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), (TI_T.QTCOMP/(SELECT COUNT(1) FROM TDI_T) ) ), 'FM99999999999999999990.000') END ) AS QTYRCV1
     			, ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), (TI_T.QTCOMP/(SELECT COUNT(1) FROM TDI_T) ) ), 'FM99999999999999999990.000') END ) AS QTYRCV
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA11, TI_T.LOTA11 ) AS LOTA11
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA14, TI_T.LOTA14 ) AS LOTA14
			    , NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.000',DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), (TI_T.QTCOMP/(SELECT COUNT(1) FROM TDI_T) ) )), PO.MEINS)),'0.000') AS UOMQTY
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), (TI_T.QTCOMP/(SELECT COUNT(1) FROM TDI_T) ) ), PO.MEINS, 'KG')),'0.000') AS TOT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), (TI_T.QTCOMP/(SELECT COUNT(1) FROM TDI_T) ) ), PO.MEINS, 'BAG')),'0.000') AS BAG
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), (TI_T.QTCOMP/(SELECT COUNT(1) FROM TDI_T) ) ), PO.MEINS, 'BOX')),'0.000') AS BOX
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), (TI_T.QTCOMP/(SELECT COUNT(1) FROM TDI_T) ) ), PO.MEINS, 'PAL')),'0.000') AS PLT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), (TI_T.QTCOMP/(SELECT COUNT(1) FROM TDI_T) ) ), PO.MEINS, 'SOK')),'0.000') AS SOK
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), (TI_T.QTCOMP/(SELECT COUNT(1) FROM TDI_T) ) ), PO.MEINS, 'EA')),'0.000') AS EA
			    , TRIM(TI_T.EBELN) AS TEBELN
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA21, TI_T.LOTA21 ) AS LOTA21
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA22, TI_T.LOTA22 ) AS LOTA22
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA23, TI_T.LOTA23 ) AS LOTA23
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA24, TI_T.LOTA24 ) AS LOTA24
			    , DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, 'Y' ) AS IFFLG
			 , PO.CREDAT
		 	 , PO.CRETIM
		 	 , PO.CREUSR
		 	 , PO.LMODAT
		 	 , PO.LMOTIM
		 	 , PO.LMOUSR
		 	 , PO.INDBZL
		 	 , PO.INDARC
		 	 , PO.UPDCHK
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.CREUSR),' ') AS CUSRNM
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.LMOUSR),' ') AS LUSRNM
		 	 , SLM.STLNM AS LOTA01NM
			 , (SELECT LM.AREAKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC ) AS AREAKY
		 	 , NVL((SELECT AM.SHORTX FROM AREMA AM WHERE AM.WAREKY = PO.WAREKY AND EXISTS ( SELECT 'X' FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC AND LM.AREAKY = AM.AREAKY )),' ') AS AREANM
			 , 'FRV' AS STATIT
			 , SM.SKUG01
			 , SM.SKUG02
			 , SM.SKUG03
			 , NVL((SELECT X.USARG1 FROM SKUG05_T X WHERE X.CMCDVL=SM.SKUG05),SKUG04) AS SKUG04
			 , SM.SKUG05
			 , SM.SKUG05 AS SKUG05_1
			 , SLT.QRTAYN
			 , SLT.SHTAYN
			 , SLME.WMSMAK AS FWMSMAK
			 , PO.BWART AS RCPTTY
			 , PO.LIFNR AS DPTNKY
			 , PO.ZEKKO_AEDAT
			 , PO.EINDT AS ASNDAT
			 , 'NEW' AS STATDO
			 , NVL(#{DOCDAT},TO_CHAR(SYSDATE,'YYYYMMDD')) AS DOCDAT
			 , NVL((SELECT DOCCAT FROM DOCTM WHERE DOCUTY = PO.BWART), '100') AS DOCCAT
			 , PO.SIGNI
			 , DECODE(PO.BWART, '111', PO.SSORNU, PO.VGBEL) AS VGBEL
			 , DECODE(PO.BWART, '111', PO.SSORIT, PO.VGPOS) AS VGPOS
			 , PO.MRFLG
			 , PO.AR_NO
			 , PO.AR_REV
			 , PO.AR_LNO
			 , PO.BWARTSAP
			 , PO.POREV
		 	 , PO.SSORNU
			 , PO.SSORIT
			 , PO.DLEFLG
			 , PO.SERV1
			 , 'V' AS SAPIFYN
			 , SLM.WMSMAK
		     , ' ' AS LOTA41
			 , ' ' AS LOTA42
			 , ' ' AS LOTA43
			 , ' ' AS LOTA44
			 , ' ' AS LOTA45
			 , '0' AS LOTA46
			 , '0' AS LOTA47
			 , '0' AS LOTA48
			 , ' ' AS LOTA49
		<include refid="WmsInbound.INBOUND_SUB_IFID_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_SQL"/>
		LEFT OUTER JOIN TDI_T TI_T ON TI_T.EBELN = PO.EBELN AND TI_T.EBELP = PO.EBELP AND TI_T.IFFLG = PO.IFFLG
		LEFT OUTER JOIN RICNT_T RT_T ON RT_T.SEBELN = PO.EBELN AND RT_T.SEQNO = PO.SEQNO AND RT_T.LOTA14 = TI_T.LOTA14
		<include refid="WmsInbound.INBOUND_SUB_WHERE_SQL"/>
          AND PO.EBELN = #{SEBELN}
          AND PO.MRFLG != 'S0'
          AND ( 
	          1 = 2
	          <if test="STTNEW == &quot;V&quot;">
	          OR PO.IFFLG = 'N'
	          </if>
	          <if test="STTTC2 == &quot;V&quot;">
	          OR PO.IFFLG = 'Y'
	          </if>
	        )
	      <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		  </if>
		  <if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		  </if>
		  
		  <choose>
		       <when test="RCPTTY != null and RCPTTY == '121'">
		       	${LOTA14_TR_SQL}
			   </when>
			   <otherwise>
			   	${LOTA14_SQL}
			   </otherwise>
			 </choose>
		  
         <include refid="WmsInbound.INBOUND_SUB_SORT_SQL"/>
         
	</select>
	
	<select id="GR30POP_LIST" parameterType="Map" resultType="DataMap">
		SELECT   CASE WHEN PO.IFFLG = 'N' THEN '미작업' ELSE '입고완료' END   AS STATDONM  
		 	   , PO.EBELN  AS SEBELN --오더번호
			   , PO.STKNUM AS STKNUM --선적번호
			   , PO.LIFNR  AS DPTNKY --납품처코드
		  	   , BZ.NAME01 AS DPTNNM --남품처명
		  	   , PO.SKUKEY AS SKUKEY --품목코드
		  	   , SM.DESC01 AS DESC01 --상품명
		  	   , PO.MENGE  AS MENGE --오더수량
		  	   , PO.MEINS  AS UOMKEY  -- 단위
		  	   , MI.UOMKEY AS MUOMKEY --기본단위
		  	   , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BOX')),'0.000') AS BOX
		   FROM  IFWMS103 PO
		   LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = 'KN' AND BZ.PTNRTY = PO.PTNRTY
		   LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = 'KN' AND SM.SKUKEY = PO.SKUKEY
		   LEFT OUTER JOIN MEASI MI ON MI.WAREKY = '1100' AND MI.MEASKY = PO.SKUKEY AND MI.INDDFU = 'V'
		    	  
		  WHERE PO.WAREKY = #{WAREKY}
		    AND PO.WERKS = 'KN'		  
		    AND PO.STATUS IN ('U','C')
		    AND PO.PRCFLG = 'C'
		    AND EXISTS (
		                       SELECT 'X'
		                       FROM DOCPG X
		                       WHERE X.PROGID = 'GR30'
		                         AND X.DOCUTY = PO.BWART
		                     )
		    AND ( 
				          1 = 2
				          <if test="STTNEW == &quot;V&quot;">
				          OR PO.IFFLG = 'N'
				          </if>
				          <if test="STTTC2 == &quot;V&quot;">
				          OR PO.IFFLG = 'Y'
				          </if>
				        )
		    AND PO.STKNUM = #{STKNUM}
	</select>
	
	<select id="GR31_LIST" parameterType="Map" resultType="DataMap">
		
		<include refid="WmsInbound.INBOUND_SUB_WITH_SQL"/>
		SELECT PO.SEQNO
             , PO.MANDT
             , PO.WERKS AS OWNRKY
			 , (SELECT OWNRNM FROM OE_T) AS OWNRNM
             , PO.STKNUM
		     , PO.EBELN
		     , PO.EBELP
             , PO.EBELN  AS SEBELN
		     , PO.EBELP  AS SEBELP
		     , PO.WAREKY
		     , (SELECT WARENM FROM WM_T) AS WARENM
		     , PO.BWART AS DOCUTY
		     , NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = PO.BWART),' ') AS RCPTNM
             , PO.EINDT
			 , PO.EINDT AS ASNDAT
             , PO.ORDCAT
             , PO.LIFNR
			 , PO.LIFNR AS DPTNKY
		     , PO.PTNRTY
		     , PO.BEDAT
             , PO.IFID
			 , PO.MRFLG
			 , PO.BWARTSAP
			 , PO.DLEFLG
			 , PO.AR_NO
			 , PO.AR_REV
			 , PO.AR_LNO
             , PO.IFFLG
             , PO.LOTNUM
			 , NVL(DECODE(SM.SKUG05, '10', ZT.PALCNT, NVL(MIP.QTPUOM,'0.000')), '0.000') AS PALQTY -- 2022.03.11 팔레트 입수량 추가
			 , PO.SKUKEY
             , PO.MEINS
		     , PO.MEINS AS UOMKEY		     
		     , SM.DESC01 
		     , SM.DESC02
             , SM.SKUG01
			 , SM.SKUG02
			 , SM.SKUG03
			 , NVL((SELECT X.USARG1 FROM SKUG05_T X WHERE X.CMCDVL=SM.SKUG05),SKUG04) AS SKUG04
			 , SM.SKUG05
			 , SM.SKUG05 AS SKUG05_1
		     , DT.SYSLOC AS LOCAKY
		     , ' ' AS TRNUID
		     , PO.MENGE
             , PO.MENGE_R
             , PO.RTNRSN AS RSNCOD -- 반품사유
		     , SZF_GET_RSNCOD_TEXT(#{LANGKY}, #{OWNRKY}, NVL(DT.DOCCAT, '100'), PO.BWART, PO.RTNRSN) AS RSNCODNM -- 반품사유명
		     , TO_CHAR(SUM(PO.MENGE) OVER(PARTITION BY PO.SKUKEY ORDER BY PO.SKUKEY), 'FM99999999999999999990.000')||' / '||PO.SKUKEY AS SUM_ITEM
		     , ' ' AS RECVKY
		     , ' ' AS RECVIT
             <choose>
		     	<when test="RCPTTY != null and RCPTTY == '131' and STATDO=='NEW'">
             , '' AS RCPRSN -- 상세사유
		      	</when>
		     	<when test="RCPTTY != null and RCPTTY == '131' and STATDO=='FRV'">
             , (SELECT RCPRSN FROM RECDI WHERE SEBELN = PO.EBELN AND SEBELP = PO.EBELP) AS RCPRSN -- 상세사유
		      	</when>
				<otherwise>
             , PO.RTNTXT AS RCPRSN -- 상세사유
				</otherwise>
			 </choose>
		     , SM.ASKU05
		     , SW.MEASKY AS MEASKY 
		     , SM.EANCOD
		     , MI.UOMKEY AS MUOMKEY
		     , ( CASE WHEN BWART ='111' AND ( PO.DLEFLG = 'Y' ) THEN '0.000' 
			             WHEN BWART !='111' AND ( PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y') THEN '0.000'  ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV1
     		 , ( CASE WHEN BWART ='111' AND ( PO.DLEFLG = 'Y' ) THEN '0.000' 
			             WHEN BWART !='111' AND ( PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y') THEN '0.000'  ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END )  AS QTYRCV
             <!-- , ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV1
             , ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV -->
             , CASE WHEN SZF_GET_DOCUTY_TEXT('', PO.BWART) = '구매입고' AND PO.MEINS = 'KG' AND MI.UOMKEY = 'R' 
			        THEN NVL(TRIM(SZF_GET_DEFAULT_QTY_R(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.00',(PO.MENGE - PO.MENGE_R)), PO.MEINS)),'0.00') 
			        ELSE NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.000',(PO.MENGE - PO.MENGE_R)), PO.MEINS)),'0.000')
			    	END AS UOMQTY
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'KG')),'0.000') AS TOT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BAG')),'0.000') AS BAG
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BOX')),'0.000') AS BOX
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'PAL')),'0.000') AS PLT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'SOK')),'0.000') AS SOK
             , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'EA')),'0.000') AS EA
             , '' AS TEBELN
			 , PO.CREDAT
		 	 , PO.CRETIM
		 	 , PO.CREUSR
		 	 , PO.LMODAT
		 	 , PO.LMOTIM
		 	 , PO.LMOUSR
		 	 , PO.INDBZL
		 	 , PO.INDARC
		 	 , PO.UPDCHK
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.CREUSR),' ') AS CUSRNM
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.LMOUSR),' ') AS LUSRNM
		 	 , SLM.STLNM AS LOTA01NM
			 , (SELECT LM.AREAKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC ) AS AREAKY
		 	 , NVL((SELECT AM.SHORTX FROM AREMA AM WHERE AM.WAREKY = PO.WAREKY AND EXISTS ( SELECT 'X' FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC AND LM.AREAKY = AM.AREAKY )),' ') AS AREANM, 'FRV' AS STATIT
			 , SLT.QRTAYN
			 , SLT.SHTAYN
			 , SLME.WMSMAK AS FWMSMAK
			 , PO.BWART AS RCPTTY
			 , PO.ZEKKO_AEDAT
			 , CASE WHEN PO.IFFLG != 'Y' THEN 'NEW' ELSE 'FRV' END AS STATDO /* 상태값 */
			 , (SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = DECODE(PO.IFFLG, 'N', 'NEW', 'FRV') ) AS STATDONM /* 상태값명 */
			 , NVL(#{DOCDAT},TO_CHAR(SYSDATE,'YYYYMMDD')) AS DOCDAT
			 , '131' AS DOCCAT
			 , '반품입고' AS DOCCATNM
			 , PO.SIGNI
			 , PO.VGBEL
			 , PO.VGPOS
			 , PO.POREV
		 	 , PO.SSORNU
			 , PO.SSORIT
			 , PO.SERV1
			 , 'V' AS SAPIFYN
			 , SLM.WMSMAK
             , NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) AS LOTA01
		     , PO.LOTA01 AS LOTA01_ORG
		     , PO.LOTA02
		     , PO.LOTA02 AS LOTA02_ORG             
             , PO.LOTA03
             , PO.LOTA03 AS LOTA03_ORG
             , PO.LOTA04
             , PO.LOTA05
		     , PO.LOTA06
		     , CASE WHEN PO.BWART='131' AND PO.SOBKZ='E' THEN TRIM(PO.VGBEL)||TRIM(PO.VGPOS)
                    ELSE PO.LOTA07
               END AS LOTA07
		     , PO.LOTA07 AS LOTA07_ORG
		     , PO.LOTA08
		     , PO.LOTA08 AS LOTA08_ORG
             , PO.LOTA09
             , PO.LOTA10
             , CASE WHEN PO.BWART = '131' AND PO.LOTA11 = ' ' 
                    THEN TO_CHAR(SYSDATE, 'YYYYMMDD') 
                    ELSE PO.LOTA11 END AS LOTA11
             , NVL(TRIM(PO.LOTA12),TO_CHAR(SYSDATE,'YYYYMMDD')) AS LOTA12
		     , PO.LOTA13   
             , PO.LOTA14 
             , PO.LOTA15
		     , PO.LOTA16
		     , PO.LOTA16 AS LOTA16_ORG
             , PO.LOTA17
             , PO.LOTA17 AS LOTA17_ORG
		     , PO.LOTA18
		     , PO.LOTA19
		     , PO.LOTA20             
             , PO.LOTA21
             , PO.LOTA22
             , PO.LOTA23
             , PO.LOTA24             
		     , ' ' AS LOTA41
			 , ' ' AS LOTA42
			 , ' ' AS LOTA43
			 , ' ' AS LOTA44
			 , ' ' AS LOTA45
			 , '0' AS LOTA46
			 , '0' AS LOTA47
			 , '0' AS LOTA48
			 , ' ' AS LOTA49
             , PO.FLOTA01
             , PO.FLOTA02
             , BZ.NAME01 AS DPTNNM
             , ( CASE WHEN SLT.SHTAYN = 'V' AND SLM.WMSMAK = 'V' THEN 'V' ELSE '' END ) AS IMIB01
     		 , ( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN 'V' ELSE '' END ) AS IMIB02
     		 , ( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) ELSE '' END ) AS IMIB02_LOTA01
			 , ( CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_214,WMS_IF_215'          -- 입고실적정보(자재,상품)
                      WHEN PO.IFID = 'WMS_IF_204' THEN 'WMS_IF_216'                     -- 입고실적정보(이송)
                      WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_221,WMS_IF_222'          -- 입고실적정보(제품) SAP,입고실적정보(제품) MES
                      WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_217'                     -- 반품입고실적정보 SAP
                      WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_218,WMS_IF_224'          -- 반납입고실적정보 MES,반납입고실적정보(자재)
                      ELSE '' 
                 END
               ) AS IFID -- 실적IFID
			 , ( CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_215'                     -- 입고실적정보(자재,상품) SAP
                      WHEN PO.IFID = 'WMS_IF_204' THEN 'WMS_IF_216'                     -- 입고실적정보(이송) SAP
                      WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_221'                     -- 입고실적정보(제품) SAP
                      WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_217'                     -- 반품입고실적정보 SAP
                      WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_224'                     -- 반납입고실적정보(자재) SAP
                      ELSE '' 
                 END
               ) AS IFID_SAP -- 실적IFID_SAP
             , ( CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_214'                     -- 입고실적정보(자재,상품) PORTAL
                      ELSE '' 
                 END
               ) AS IFID_PTL -- 실적IFID(PORTAL)
             , (
                 CASE WHEN PO.IFID = 'WMS_IF_205' THEN 'WMS_IF_222'                     -- 입고실적정보(제품) MES
                      WHEN PO.IFID = 'WMS_IF_207' THEN 'WMS_IF_218'                     -- 반납입고실적정보 MES
                      ELSE '' 
                 END
               ) AS IFID_MES -- 실적IFID(MES)
             , ( CASE WHEN PO.IFID = 'WMS_IF_202' THEN 'WMS_IF_208'                      -- 입고실적정보(자재,상품)
                      WHEN PO.IFID IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN 'WMS_IF_212'                      -- 반품입고실적정보 SAP
                      ELSE '' 
                 END
               ) AS IFID_QTR -- 품질검사IFID
             , ( CASE WHEN SLT.SHTAYN = 'V' THEN 'WMS_IF_310'                            -- 즉시불출
                      ELSE '' 
                 END
               ) AS IFID_STN -- 즉시분출 IFID
             , ( CASE WHEN PO.BWART = '121' AND PO.MRFLG = 'S0' THEN 'WMS_IF_404'       -- 수입밀롤
                      ELSE '' 
                 END                 
               ) AS IFID_ITM -- 수입밀롤 IFID
             , ( CASE WHEN PO.BWART = '131' THEN 'WMS_IF_401' -- 반품입고 재고상태 변경
                      ELSE '' 
                 END                 
               ) AS IFID_RTN -- 반품입고 재고상태 변경 IFID
		  FROM IFWMS103 PO
			  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
			  LEFT OUTER JOIN SKUWC SW ON SW.WAREKY = #{WAREKY} AND SW.OWNRKY = #{OWNRKY} AND SW.SKUKEY = PO.SKUKEY
			  LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
			  LEFT OUTER JOIN LOTAT LT ON LT.LOTNUM = PO.LOTNUM
			  LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
			  LEFT OUTER JOIN MEASI MI ON MI.WAREKY = #{WAREKY} AND MI.MEASKY = PO.SKUKEY AND MI.INDDFU = 'V'
			  LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = #{OWNRKY} AND SLT.WAREKY = #{WAREKY} AND SLT.PLNTKY = PO.LOTA02 AND SLT.SKUKEY = PO.SKUKEY
			  LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = #{OWNRKY} AND SLM.PLNTKY = PO.LOTA02 AND SLM.STLKY  = NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY))
			  LEFT OUTER JOIN MEASI MIP ON MIP.WAREKY = #{WAREKY} AND MIP.MEASKY = PO.SKUKEY AND MIP.UOMKEY = 'PAL'		  
			  LEFT OUTER JOIN ZPPTM ZT ON ZT.LOTA02 = PO.LOTA02 AND ZT.LOTA03 = PO.LOTA03 AND ZT.LOTA09 = PO.LOTA09 AND ZT.LOTA16 = PO.LOTA16 AND ZT.LOTA17 = PO.LOTA17
			  LEFT OUTER JOIN STLMA SLME ON SLME.OWNRKY = #{OWNRKY} AND SLME.PLNTKY = PO.FLOTA02 AND SLME.STLKY = PO.FLOTA01
         WHERE PO.WAREKY = #{WAREKY}
		   AND PO.WERKS  = #{OWNRKY}			  
           AND PO.STATUS IN ('U','C')
           AND PO.IFFLG IN ('N','Y') 
           AND PO.PRCFLG = 'C'
           AND EXISTS ( SELECT 'X'
                          FROM DOCPG X
                         WHERE X.PROGID = #{PROGID}
                           AND X.DOCUTY = PO.BWART
                      )
           AND (PO.MRFLG != 'S0' 
               OR (PO.MRFLG = 'S0' 
               	   AND PO.LOTA01 != '2400' 
               	   AND PO.LOTA02 LIKE CASE WHEN PO.BWART = '121' THEN '%' ELSE 'P100' END 
                  )
              )   
          AND ( 
	          1 = 2
	          <if test="STTNEW == &quot;V&quot;">
	          OR PO.IFFLG = 'N'
	          </if>
	          <if test="STTTC2 == &quot;V&quot;">
	          OR PO.IFFLG = 'Y'
	          </if>
	        )
	      <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		  </if>
		  <if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		  </if>
		 ORDER BY PO.STKNUM, PO.EBELN, PO.EBELP
         
	</select>
	
	<!-- 240105 GR09 HEAD GRID SELECT FOR CANCEL FOR WMS START -->
	<select id="GR09CANCEL_WMS_LIST" parameterType="Map" resultType="DataMap">
		WITH WM_T AS (
		    SELECT NVL(WM.NAME01,' ') AS WARENM  
		    FROM WAHMA WM
		    WHERE WM.WAREKY = #{WAREKY}
	   	),
        DOCTM_T AS (
          SELECT DT.DOCUTY
             , DT.SHORTX AS DOCUTYNM
          FROM DOCTM DT
        ),
		STATDO_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = 'KR' AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'STATDO'
		)
		SELECT T1.*
		     , ( SELECT WARENM FROM WM_T ) AS WAREKYNM
		     , NVL(TRIM(T1.SEBELN), T1.RECVKY) AS SEBELN
		     , ( SELECT X.DOCUTYNM FROM DOCTM_T X WHERE X.DOCUTY=T1.RCPTTY ) AS RCPTTYNM
		     , ( SELECT X.CDESC1 FROM STATDO_T X WHERE X.CMCDVL=T1.STATDO ) AS STATDONM
		     , ( SELECT CUM.NMLAST FROM USRMA CUM WHERE CUM.USERID = T1.CREUSR ) AS CUSRNM
		     , ( SELECT LUM.NMLAST FROM USRMA LUM WHERE LUM.USERID = T1.LMOUSR ) AS LUSRNM
		     , CASE WHEN 0 = (SELECT COUNT(0) FROM COAMA WHERE SEBELN = NVL(TRIM(T1.SEBELN), T1.RECVKY)) THEN ' ' ELSE 'V' END AS COAYN
		     <!-- 입고취소를 위한 설정값 하드코딩 WmsInbound.INBOUND_HEAD_CANCEL_IFID_SQL -->
		     , ''					  AS IFID_SAP 		<!-- 실적IFID_SAP -->
		     , ''                     AS IFID_PTL 		<!-- 실적IFID(구매포탈) -->
		     , ''                     AS IFID_MES 		<!-- 실적IFID(MES) -->
		     , ''                     AS IFID_QTR 		<!-- 품질검사IFID -->
		     , ''                     AS IFID_STN 		<!-- 즉시분출 IFID -->
		     , 'Z_WMS_MAT_DOC_CANCEL' AS SAP_RFCFN 		<!-- SAP RFC FUNCTION -->
		     , ''  					  AS SAP_RFCFN_ITM 	<!-- 수입밀롤 RFC -->
		FROM (
		    WITH DOCPG_T AS (
			   SELECT X.DOCUTY
			   FROM DOCPG X
			   WHERE X.PROGID = 'GR09'
			)
		    SELECT MAX(RH.WAREKY) AS WAREKY
	             , MAX(RH.OWNRKY) AS OWNRKY
		         , RH.RECVKY
		         , MAX(RH.RCPTTY) AS RCPTTY
		         , MAX(RH.DPTNKY) AS DPTNKY
		         , MAX(VD.NAME01) AS DPTNKYNM
		         , MAX(RH.INDRCN) AS INDRCN
		         , MAX(RH.DOCTXT) AS DOCTXT
		         , MAX(RH.CREDAT) AS CREDAT
		         , MAX(RH.CRETIM) AS CRETIM
		         , MAX(RH.CREUSR) AS CREUSR
		         , MAX(RH.LMODAT) AS LMODAT
		         , MAX(RH.LMOTIM) AS LMOTIM
		         , MAX(RH.LMOUSR) AS LMOUSR
				 , MAX(RH.ORDDAT) AS ORDDAT
				 , MAX(RH.DOCDAT) AS DOCDAT
				 , MAX(RI.SXBLNR) AS SXBLNR
				 , MAX(RH.STATDO) AS STATDO
				 , MAX(RH.SAPETC) AS SAPETC
				 , MAX(RH.SAPSTS) AS SAPSTS
				 , MAX(PO.MRFLG) AS MRFLG
				 , MAX(PO.BWARTSAP) AS BWARTSAP
				 , NVL(TRIM(MAX(PO.DLEFLG)),'N') AS DLEFLG
				 , MAX(PO.SIGNI) AS SIGNI
				 , MAX(RI.SEBELN) AS SEBELN
				 , MAX(PO.AR_NO) AS AR_NO
     		     , MAX(PO.AR_REV) AS AR_REV
				 , MAX(CASE WHEN RI.QRTAYN = 'V' THEN 'V' ELSE '' END) AS QRTAYN
	     		 , MAX(CASE WHEN RI.SHTAYN = 'V' THEN 'V' ELSE '' END) AS SHTAYN
	             , MAX(PO.IFID) AS IFID
	             , MAX(RI.SERV1) AS SERV1
	             , 'V' AS SAPIFSKIP
		   FROM RECDH RH
	         INNER JOIN RECDI RI ON RI.RECVKY = RH.RECVKY AND RI.STATIT != 'FTV' 
	         LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = RH.OWNRKY AND SM.SKUKEY = RI.SKUKEY
	         LEFT OUTER JOIN BZPTN VD ON VD.PTNRKY = RH.DPTNKY AND VD.PTNRTY = RH.PTNRTY
	         LEFT OUTER JOIN IFWMS103 PO ON PO.SEQNO = RI.SEQNO AND PO.EBELN = RI.SEBELN AND PO.EBELP = RI.SEBELP
		   WHERE RH.WAREKY = #{WAREKY}
			 AND RI.SEBELN = #{EBELN}
			 AND RH.STATDO = 'FRV'
		     AND EXISTS (
			               SELECT 'X'
			               FROM DOCPG_T X
			               WHERE X.DOCUTY = RH.RCPTTY
			             )
           <!-- <if test="RECVKY != null and RECVKY != ''"> -->
			 AND RH.RECVKY = #{RECVKY}           
           <!-- </if> -->
		   <if test="OWNRKY != null and OWNRKY != ''">
			 AND RH.OWNRKY = #{OWNRKY}
		   </if>
		   GROUP BY RH.RECVKY
	       ORDER BY RH.RECVKY DESC
        ) T1
	</select>
	<!-- GR09 HEAD GRID SELECT FOR CANCEL END -->
	<!-- IFWMS213 SAP ERROR건 MES 삭제 (새로운 취소 로직에 따른 수정) -->
	
	<!-- 240108 입고완료 SAP 오류 발생 시, MES건 삭제 -->
	<delete id="IFWMS203_MES_T_DELETE" parameterType="Map">
		DELETE IFWMS203
 		 WHERE MANDT = 'MES' 
 		   AND PRCFLG = 'I'
 		   AND EBELN = #{EBELN}
		   AND ZDOC_NO IN (SELECT ZDOC_NO FROM IFWMS203
		    			    WHERE MANDT = 'SAP'
					     	  AND PRCFLG = 'E' 
					     	  AND LOGSEQNO = #{LOGSEQNO})  
	</delete>
	
	<!-- 240108 IFWMS203 SAP 입고취소 건 조회 -->
	<select id="GR09_SAP_CANCEL_LIST" parameterType="Map" resultType="DataMap">
	WITH LOTA02_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'LOTA02'
		),
		LOTA06_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'LOTA06'
		),
		LOTA08_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'NATNKY'
		),
		STATIT_T AS (
		    SELECT CD.CMCDVL
		         , NVL(CL.CDESC1, CD.CDESC1) AS CDESC1
		    FROM CMCDV CD
		      LEFT OUTER JOIN CMCDV_LANG CL 
		                   ON CL.LANGKY = #{LANGKY} AND CL.CMCDKY = CD.CMCDKY AND CL.CMCDVL = CD.CMCDVL
		    WHERE CD.CMCDKY = 'STATIT'
		),
        DOCCM_T AS (
          SELECT DC.DOCCAT
             , NVL(DL.SHORTX, DC.SHORTX) AS DOCCATNM
          FROM DOCCM DC
            LEFT OUTER JOIN DOCCM_LANG DL ON DL.LANGKY = #{LANGKY} AND DL.DOCCAT = DC.DOCCAT
        ),
        RSNCD_T AS (
            SELECT RC.DOCCAT
                 , RC.DOCUTY
                 , RC.RSNCOD
                 , NVL(RL.SHORTX, RC.SHORTX) AS RSNCODNM
            FROM RSNCD RC
              LEFT OUTER JOIN RSNCD_LANG RL 
                           ON RL.LANGKY = #{LANGKY}
                          AND RL.OWNRKY = RC.OWNRKY
                          AND RL.DOCCAT = RC.DOCCAT
                          AND RL.DOCUTY = RC.DOCUTY
                          AND RL.RSNCOD = RC.RSNCOD
             WHERE RC.OWNRKY = #{OWNRKY}
        ),
		OE_T AS (
		    SELECT NVL(OE.NAME01,' ') AS OWNRNM
		    FROM OWNER OE 
		    WHERE OE.OWNRKY = #{OWNRKY}
		),
		WM_T AS (
		    SELECT NVL(WM.NAME01,' ') AS WARENM  
		    FROM WAHMA WM
		    WHERE WM.WAREKY = #{WAREKY}
		)
		SELECT RI.RECVKY
		     , RI.RECVIT
		     , RI.STATIT
		     , DECODE(RI.SAPSTS,' ',' ','V') AS SAPSTS
		     , RI.SKUKEY
		     , RI.LOTNUM
		     , RI.LOCAKY 
		     , RI.AREAKY
		     , RI.SECTID
		     , RI.TRNUID
		     , RI.PACKID
		     , RI.QTYRCV
		     , RI.QTYDIF
		     , RI.QTYUOM
		     , RI.TRUNTY
		     , RI.MEASKY
		     , RI.UOMKEY
		     , RI.QTPUOM
		     , RI.DUOMKY
		     , RI.QTDUOM
		     , DECODE(RI.QTDUOM, 0, 0, TRUNC(RI.QTYRCV/RI.QTDUOM)) AS BOXQTY
		     , MOD(RI.QTYRCV,RI.QTDUOM) AS REMQTY
		     , RI.INDRCN
		     , RI.CRECVD
		     , RI.RSNCOD
		     , RI.LOTA01
		     , RI.LOTA02	       
		     , RI.LOTA03
		     , RI.LOTA04
		     , RI.LOTA05
		     , RI.LOTA06
		     , RI.LOTA07
		     , RI.LOTA08
		     , RI.LOTA09
		     , RI.LOTA10
		     , RI.LOTA11
		     , RI.LOTA12
		     , RI.LOTA13
		     , RI.LOTA14
		     , RI.LOTA15
		     , RI.LOTA16
		     , RI.LOTA17
		     , RI.LOTA18
		     , RI.LOTA19
		     , RI.LOTA20
		     , RI.AWMSNO
		     , RI.REFDKY
		     , RI.REFDIT
		     , RI.REFCAT
		     , RI.REFDAT
		     , RI.DESC01
		     , RI.DESC02
		     , RI.ASKU01
		     , RI.ASKU02
		     , RI.ASKU03
		     , RI.ASKU04
		     , RI.ASKU05
		     , RI.EANCOD
		     , RI.GTINCD
		     , RI.SKUG01
		     , RI.SKUG02
		     , RI.SKUG03
		     , RI.SKUG04
		     , RI.SKUG05
		     , RI.GRSWGT
		     , RI.NETWGT
		     , RI.WGTUNT
		     , RI.LENGTH
		     , RI.WIDTHW
		     , RI.HEIGHT
		     , RI.CUBICM
		     , RI.CAPACT
		     , RI.QTYORG
		     , RI.SMANDT
		     , RI.SEBELN
		     , RI.SEBELP
		     , RI.SZMBLNO
		     , RI.SZMIPNO
		     , RI.STRAID
		     , RI.SVBELN
		     , RI.SPOSNR
		     , RI.STKNUM
		     , RI.STPNUM
		     , RI.SWERKS
		     , RI.SLGORT
		     , RI.SDATBG
		     , RI.STDLNR
		     , RI.SSORNU
		     , RI.SSORIT
		     , RI.SMBLNR
		     , RI.SZEILE
		     , RI.SMJAHR
		     , RI.SXBLNR
		     , RI.SBKTXT
		     , RI.RCPRSN
		     , RI.CREDAT
		     , RI.CRETIM
		     , RI.CREUSR
<!-- 		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RI.CREUSR),' ') AS CUSRNM  -->
		     , CU.NMLAST AS CUSRNM
		     , RI.LMODAT
		     , RI.LMOTIM
		     , RI.LMOUSR
<!-- 		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RI.LMOUSR),' ') AS LUSRNM -->
		     , LU.NMLAST AS LUSRNM
		     , CEIL(NVL(TRIM(SZF_GET_CONVERT_QTY(RH.WAREKY, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'PAL')), 1)) AS QTDPRT
		     , ( SELECT X.CDESC1 FROM STATIT_T X WHERE X.CMCDVL=RI.STATIT ) AS STATITNM
			 , RH.ORDDAT
		     , LM.ZONEKY
		     , RH.WAREKY
		     , ( SELECT WARENM FROM WM_T ) AS WARENM
		     , RH.OWNRKY AS OWNRKY
	         , ( SELECT OWNRNM FROM OE_T ) AS OWNRNM
	         , NVL(AR.SHORTX, ' ') AS AREAKYNM
	         , RH.DOCCAT
	         , ( SELECT X.DOCCATNM FROM DOCCM_T X WHERE X.DOCCAT=RH.DOCCAT ) AS DOCCATNM
	         , SLM.STLNM AS LOTA01NM
	         , ( SELECT X.CDESC1 FROM LOTA02_T X WHERE X.CMCDVL=RI.LOTA02 ) AS LOTA02NM
	         , ( SELECT X.CDESC1 FROM LOTA06_T X WHERE X.CMCDVL=RI.LOTA06 ) AS LOTA06NM
	         , ( SELECT X.CDESC1 FROM LOTA08_T X WHERE X.CMCDVL=RI.LOTA08 ) AS LOTA08NM
	         , ( SELECT X.RSNCODNM FROM RSNCD_T X WHERE X.DOCCAT=RH.DOCCAT AND X.DOCUTY=RH.RCPTTY AND X.RSNCOD=RI.RSNCOD ) AS RSNCODNM
	         , RH.DOCTXT AS DOCTXT
	         , RI.QTYUOM
	         , UM.UNITNM AS LOTA04NM
	         
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(RH.WAREKY, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'KG')),'0.000') AS TOT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(RH.WAREKY, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BAG')),'0.000') AS BAG
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(RH.WAREKY, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BOX')),'0.000') AS BOX
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(RH.WAREKY, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'PAL')),'0.000') AS PLT
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(RH.WAREKY, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'SOK')),'0.000') AS SOK
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(RH.WAREKY, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'EA')),'0.000') AS EA 
			 , CASE WHEN RI.QTYRCV = 0 THEN 0 
			 		ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(RH.WAREKY, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(RH.WAREKY, RI.SKUKEY, RI.QTYRCV, RI.UOMKEY, 'BOX'))),'0.000')	
				END AS BOXBAG
			 , RH.RCPTTY
			 , RH.DOCDAT
			 , (
		          CASE WHEN RH.RCPTTY='101' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
		               WHEN RH.RCPTTY='111' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
		               WHEN RH.RCPTTY='114' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
		               WHEN RH.RCPTTY='121' THEN DECODE(RI.STATIT, 'FCV', '648', DECODE(STM.WMSMAK, 'V', '101', '641') )
		               WHEN RH.RCPTTY='131' THEN DECODE(RI.STATIT, 'FCV', '656', '655')
		               WHEN RH.RCPTTY='135' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
		               WHEN RH.RCPTTY='199' THEN '902'
		               ELSE ''
		          END
		       ) AS BWARTSAP
		     , RI.SAPSTS  
<!-- 		     , SLT.QRTAYN -->
<!-- 	 		 , SLT.SHTAYN -->
	 		 , RI.QRTAYN
	 		 , RI.SHTAYN
	 		 , RI.AR_NO
		     , RI.AR_REV
		     , RI.AR_LNO
		     , RI.SERV1
		     <include refid="WmsInbound.INBOUND_SUB_CANCEL_IFID_SQL"/>
		  FROM IFWMS203 PO
		  	   INNER JOIN RECDH RH ON RH.RECVKY = PO.ZDOC_NO
		       INNER JOIN RECDI RI
		               ON RI.RECVKY = RH.RECVKY
		              AND RI.STATIT != 'FTV'
		       LEFT OUTER JOIN IFWMS103 PO
		                    ON PO.SEQNO = RI.SEQNO
		                   AND PO.EBELN = RI.SEBELN
		                   AND PO.EBELP = RI.SEBELP
		       LEFT OUTER JOIN SKUMA SM
		          	        ON SM.OWNRKY = RH.OWNRKY
		                   AND SM.SKUKEY = RI.SKUKEY
		       LEFT OUTER JOIN USRMA CU
		                    ON CU.USERID = RI.CREUSR
		       LEFT OUTER JOIN USRMA LU
		                    ON LU.USERID = RI.LMOUSR
               LEFT OUTER JOIN LOCMA LM
  				            ON LM.WAREKY = RH.WAREKY
                           AND LM.LOCAKY = RI.LOCAKY
			   LEFT OUTER JOIN STLMA SLM 
			                ON SLM.OWNRKY = #{OWNRKY} 
			               AND SLM.PLNTKY = RI.LOTA02 
			               AND SLM.STLKY  = RI.LOTA01
               LEFT OUTER JOIN AREMA AR
                            ON AR.WAREKY = RH.WAREKY 
                           AND AR.AREAKY = RI.AREAKY
               LEFT OUTER JOIN UNITMA UM 
                            ON UM.OWNRKY = RH.OWNRKY 
                           AND UM.PLNTKY = RI.LOTA02 
                           AND UM.UNITNO = RI.LOTA04
               LEFT OUTER JOIN STLMA STM 
                            ON STM.OWNRKY = #{OWNRKY} 
                           AND STM.STLKY = PO.FLOTA01 
                           AND STM.PLNTKY = PO.FLOTA02
               LEFT OUTER JOIN BZPTN VD 
                            ON VD.PTNRKY = RH.DPTNKY 
                           AND VD.PTNRTY = RH.PTNRTY
<!--                LEFT OUTER JOIN SKUPLT SLT  -->
<!--                             ON SLT.OWNRKY = #{OWNRKY}  -->
<!--                            AND SLT.WAREKY = #{WAREKY}  -->
<!--                            AND SLT.PLNTKY = RI.LOTA02  -->
<!--                            AND SLT.SKUKEY = RI.SKUKEY -->
		 WHERE 1 = 1
		   AND RH.WAREKY = #{WAREKY}
		   AND RI.RECVKY = #{RECVKY}
		   AND PO.LOGSEQNO = #{LOGSEQNO}
		<if test="RCPTTY != null and RCPTTY != ''">
			AND 	RH.RCPTTY = #{RCPTTY} 
		</if>
		<if test="LOTA06 != null and LOTA06 != ''">
			AND 	RI.LOTA06 = #{LOTA06} 
		</if>
		<if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		</if>
		<if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
		       ${RANGE_SQL}
		</if>
		 ORDER BY RI.RECVKY, RI.RECVIT
	 </select>
	 
	 <!-- 240129 HNW 현재 입고키의 오더 상태 조회 -->
	 <select id="RECDI_STAT_MAP" parameterType="Map" resultType="DataMap">
			SELECT  RECVKY AS RES
			FROM	RECDI
			WHERE	1 = 1
			AND		SEBELN = #{SEBELN}
			AND		SEBELP = #{SEBELP}
			AND		STATIT = 'FRV'
			AND		ROWNUM = 1
			FOR UPDATE
	</select>

	<select id="GR301_LIST" parameterType="Map" resultType="DataMap">
		WITH IF103_T AS (
			SELECT PO.SEQNO
			     , PO.WERKS
				 , PO.EBELN
				 , PO.EBELP
				 , PO.WAREKY
				 , PO.BWART
				 , PO.EINDT
				 , PO.ORDCAT
				 , PO.LIFNR
			     , PO.PTNRTY
				 , PO.BEDAT
				 , PO.IFID
			     , PO.MRFLG
			     , PO.BWARTSAP
			     , PO.DLEFLG
			     , PO.AR_NO
				 , PO.AR_REV
				 , CASE WHEN  EXISTS (SELECT MAX(RECVKY) ,STATIT FROM RECDI re WHERE re.SEBELN = po.EBELN AND re.SEBELP = po.EBELP GROUP BY STATIT HAVING STATIT = 'FRV'  ) THEN 'Y' ELSE PO.IFFLG  END AS IFFLG
				 , PO.LOTNUM
				 , PO.SKUKEY
				 , PO.MEINS
				 , PO.LOTA01
				 , PO.LOTA02
				 , PO.LOTA14
				 , PO.LOTA15
				 , PO.FLOTA01
				 , PO.FLOTA02
				 , PO.STKNUM
				 , (PO.MENGE-PO.MENGE_R) AS QTYRCV1
				 , BZ.NAME01 AS DPTNNM
				 , LM.AREAKY AS AREAKY
				 , AM.SHORTX AS AREANM
				 , SLM.WMSMAK
				 , ( CASE WHEN SLT.SHTAYN = 'V' AND SLM.WMSMAK = 'V' THEN 'V' ELSE '' END ) AS IMIB01
     		 	 , ( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN 'V' ELSE '' END ) AS IMIB02
     		 	 , ( CASE WHEN SLT.SHTAYN != 'V' AND SLM.WMSMAK != 'V' THEN NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) ELSE '' END ) AS IMIB02_LOTA01
			FROM IFWMS103 PO
			  LEFT OUTER JOIN BZPTN BZ ON BZ.PTNRKY = PO.LIFNR AND BZ.OWNRKY = #{OWNRKY} AND BZ.PTNRTY = PO.PTNRTY
			  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = PO.SKUKEY
			  LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = PO.BWART
			  LEFT OUTER JOIN LOTAT LT ON LT.LOTNUM = PO.LOTNUM
			  LEFT OUTER JOIN LOCMA LM ON LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC
			  LEFT OUTER JOIN AREMA AM ON AM.WAREKY = #{WAREKY} AND AM.AREAKY = LM.AREAKY
			  LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = #{OWNRKY} AND SLT.WAREKY = #{WAREKY} AND SLT.PLNTKY = PO.LOTA02 AND SLT.SKUKEY = PO.SKUKEY
			  LEFT OUTER JOIN STLMA SLM ON SLM.OWNRKY = #{OWNRKY} AND SLM.PLNTKY = PO.LOTA02 AND SLM.STLKY  = NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) AND SLM.WMSMAK = 'V'
			  LEFT OUTER JOIN RECDI RI ON (RI.SEBELN = PO.EBELN AND RI.SEBELP = PO.EBELP AND STATIT = 'FRV') 
			WHERE PO.WAREKY = #{WAREKY}
			  AND PO.WERKS  = #{OWNRKY}
			  AND PO.STATUS IN ('U','C')
			  AND PO.IFFLG IN ('N','Y')
			  AND PO.PRCFLG = 'C'
			  AND (PO.MRFLG != 'S0' 
			  		OR ( PO.MRFLG  = 'S0'
			  		     AND PO.LOTA01 != '2400' 
			  		     AND PO.LOTA02 LIKE CASE WHEN PO.BWART = '121' THEN '%' ELSE 'P100' END 
			  		    )
			  		)
			  AND EXISTS (
			               SELECT 'X'
			               FROM DOCPG X
			               WHERE X.PROGID = #{PROGID}
			                 AND X.DOCUTY = PO.BWART
			             )
			  AND ( 
		          1 = 2
		          <if test="STTNEW == &quot;V&quot;">
		          OR PO.IFFLG = 'N'
		          </if>
		          <if test="STTTC2 == &quot;V&quot;">
		          OR PO.IFFLG = 'Y'
		          </if>
		        )
		    
		    <if test="BWART != null and BWART != ''">AND PO.BWART = #{BWART}</if>
		    
	        <if test="SES_MTYPE != null and SES_MTYPE != ''">
	            AND SM.MTYPE LIKE #{SES_MTYPE}
	        </if>
		    <if test="SKUG01 != null and SKUG01 != ''">
				AND SM.SKUG01 = #{SKUG01}
			</if>
			<if test="SKUL01 != null and SKUL01 != ''">
				AND SM.SKUL01 = #{SKUL01}
			</if>
			<if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			</if>
			
		)
		<if test="LOTA14_SQL != null and LOTA14_SQL != ''">
		,
		TDI_T AS (
		    SELECT PO.EBELN
			     , PO.EBELP
			     , TI.OWNRKY
			     , TI.LOTA11
			     , TI.LOTA14
			     , TI.LOTA15
			     , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, SUM(TI.QTCOMP), TI.AUOMKY, PO.MEINS)),'0.000') AS QTCOMP
			     , SK.LOTNUM
			     , LA.LOTA21
			     , LA.LOTA22
			     , LA.LOTA23
			     , LA.LOTA24
			     , PO.IFFLG
			FROM IF103_T PO
			  INNER JOIN SHPDI SI
			          ON SI.SVBELN = PO.EBELN
		             AND SI.SPOSNR = PO.EBELP
			  INNER JOIN TASDI TI
			          ON TI.OWNRKY = PO.WERKS
			         AND TI.SHPOKY = SI.SHPOKY
			         AND TI.SHPOIT = SI.SHPOIT
			         AND TI.LOTA15 = PO.LOTA15
			         AND TI.LOTA15 != ' '
			         AND TI.STATIT IN ('FPC', 'PPC')
			  INNER JOIN TASDR TR
			          ON TR.TASKKY = TI.TASKKY 
			         AND TR.TASKIT = TI.TASKIT 
			         AND TR.TASKIR = (
			                            SELECT MIN(X.TASKIR)
			                            FROM TASDR X
			                            WHERE X.TASKKY = TR.TASKKY 
			                              AND X.TASKIT = TR.TASKIT
			                            GROUP BY X.TASKKY, X.TASKIT
			                         )
			  INNER JOIN STKKY SK
			          ON SK.STOKKY = TR.STOKKY
			  INNER JOIN LOTAT LA
			          ON LA.LOTNUM = SK.LOTNUM
			WHERE PO.BWART = '121'
			  AND PO.WERKS = #{OWNRKY}
			  AND (PO.MRFLG != 'S0' 
			  		OR ( PO.MRFLG  = 'S0' 
			  			 AND PO.LOTA01 != '2400' 
			  		     AND PO.LOTA02 LIKE CASE WHEN PO.BWART = '121' THEN '%' ELSE 'P100' END 
			  		    )
			  		)
			  ${LOTA14_SQL}
			  AND EXISTS (
			               SELECT 'X'
			               FROM STLMA X
			               WHERE X.OWNRKY = #{OWNRKY} 
			                 AND X.WAREKY = (
			                                  SELECT MAX(SA.WAREKY)
			                                  FROM STLMA SA
			                                  WHERE SA.OWNRKY = #{OWNRKY} 
			                                    AND SA.PLNTKY = PO.FLOTA02 
			                                    AND SA.STLKY = PO.FLOTA01
			                                )
			                 AND X.WMSMAK = 'V'
			                 AND X.OWNRKY = PO.WERKS
		         			 AND X.PLNTKY = PO.FLOTA02
		         			 AND X.STLKY = PO.FLOTA01
			             )
			GROUP BY PO.EBELN, PO.EBELP, TI.LOTA14, TI.LOTA15, TI.OWNRKY
			     , TI.LOTA11, SK.LOTNUM, LA.LOTA21, LA.LOTA22, LA.LOTA23
			     , LA.LOTA24, PO.SKUKEY, PO.IFFLG, TI.AUOMKY, PO.MEINS
		),
		RICNT_T AS (
			SELECT RI.SEBELN, RI.SEQNO, RI.LOTA14, COUNT(1) AS CNT
			FROM RECDI RI
			WHERE EXISTS (
			                SELECT 'X'
			                FROM TDI_T X
			                WHERE X.EBELN = RI.SEBELN
			             )
			  AND EXISTS (
			                SELECT 'X'
			                FROM RECDH RH
			                WHERE RH.RECVKY = RI.RECVKY
			                  AND RH.STATDO != 'RCN'
			             )
			GROUP BY RI.SEBELN, RI.SEQNO, RI.LOTA14
		)
		</if>
		SELECT A.OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = #{OWNRKY}), ' ') AS OWNRNM
			 ---, A.EBELN
			 ---, A.SEBELN
			 ---, A.DOCKEY
			 , A.WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM	 
			 , A.DOCUTY
			 , A.RCPTTY
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, A.BWART) AS RCPTNM
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, A.BWART) AS DOCTNM
			 , A.ASNDAT
			 , A.DOCCAT	 
			 , SZF_GET_DOCCAT_TEXT('', A.DOCCAT) AS DOCCATNM	 
			 , A.DOCDAT
			 , A.DPTNKY
			 , A.DPTNNM	 
			 , A.STATDO
		     , SZF_GET_CMCDV_CDESC1_TEXT('', 'STATDO', A.STATDO ) AS STATDONM
		     , A.AREAKY
		     , A.AREANM
		     , A.DOCTXT
			 , A.PTNRTY
			 , A.BEDAT
			 , A.IFID_RECV
			 , A.MRFLG
		     , A.BWARTSAP
		     , A.DLEFLG
		     , A.AR_NO
			 , A.AR_REV
		     , A.SAPIFYN
		     ---, A.LOTA14_EMPTY_YN
		     ---, A.COAYN
		     , A.QTYRCV1
		     , A.WMSMAK
		     , A.IMIB01
		     , A.IMIB02
		     , A.IMIB02_LOTA01
		     , A.STKNUM
<!-- 		     , A.STI_CNT -->
		FROM (
			SELECT #{OWNRKY} AS OWNRKY
				 ---, PO.EBELN
				 ---, PO.EBELN AS SEBELN
				 ---, PO.EBELN AS DOCKEY
				 , #{WAREKY} AS WAREKY
				 , MAX(PO.BWART) AS DOCUTY
				 , MAX(PO.BWART) AS RCPTTY
				 , MAX(PO.BWART) AS BWART
				 , MAX(PO.EINDT) AS ASNDAT
				 , MAX(PO.ORDCAT) AS DOCCAT	 
				 , MAX(PO.EINDT) AS DOCDAT
				 , MAX(PO.LIFNR) AS DPTNKY
				 , MAX(PO.DPTNNM) AS DPTNNM	 
				 , DECODE(SUM( CASE WHEN PO.IFFLG != 'Y' THEN 1 ELSE 0 END ), 0, 'FRV', 'NEW') AS STATDO
			     , MAX(PO.AREAKY) AS AREAKY
			     , MAX(PO.AREANM) AS AREANM
			     , ' ' AS DOCTXT
				 , MAX(PO.PTNRTY) AS PTNRTY
				 , MAX(PO.BEDAT) AS BEDAT
				 , MAX(PO.IFID) AS IFID_RECV
				 , MAX(PO.MRFLG) AS MRFLG
			     , MAX(PO.BWARTSAP) AS BWARTSAP
			     , MAX(PO.DLEFLG) AS DLEFLG
			     , MAX(PO.AR_NO) AS AR_NO
				 , MAX(PO.AR_REV) AS AR_REV
			     , 'V' AS SAPIFYN
			     ---, (CASE WHEN (CASE WHEN TRIM(MAX(PO.LOTA14)) IS NULL THEN 1 ELSE 0 END)=0 THEN 'N' ELSE 'Y' END) AS LOTA14_EMPTY_YN
			     ---, (CASE WHEN 0 = (SELECT COUNT(0) FROM COAMA WHERE SEBELN = PO.EBELN) THEN ' ' ELSE 'V' END) AS COAYN
			     , SUM(PO.QTYRCV1) AS QTYRCV1
			     , MIN(PO.WMSMAK) AS WMSMAK
			     , MAX(PO.IMIB01) AS IMIB01
		         , MAX(PO.IMIB02) AS IMIB02
		         , MAX(PO.IMIB02_LOTA01) AS IMIB02_LOTA01
		         , MAX(PO.STKNUM) AS STKNUM
			FROM IF103_T PO
			  <if test="LOTA14_SQL != null and LOTA14_SQL != ''">
			  LEFT OUTER JOIN TDI_T TI_T ON TI_T.EBELN = PO.EBELN AND TI_T.EBELP = PO.EBELP AND TI_T.LOTA15 = PO.LOTA15 AND TI_T.IFFLG = PO.IFFLG
  			  LEFT OUTER JOIN RICNT_T RT_T ON RT_T.SEBELN = PO.EBELN AND RT_T.SEQNO = PO.SEQNO AND RT_T.LOTA14 = TI_T.LOTA14
  			  </if>
			WHERE 1=1			  
			  <choose>
		        <when test="LOTA14_SQL != null and LOTA14_SQL != ''">
				  AND ( 
				        1 = 2
				        <if test="STTNEW == &quot;V&quot;">
				        OR DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, DECODE(PO.QTYRCV1,0,'Y','N') ) = 'N'
				        </if>
				        <if test="STTTC2 == &quot;V&quot;">
				        OR DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, DECODE(PO.QTYRCV1,0,'Y','N') ) = 'Y'
				        </if>
				      )
				</when>
			    <otherwise>
			    	AND ( 
				        1 = 2
				        <if test="STTNEW == &quot;V&quot;">
				        OR PO.IFFLG = 'N'
				        </if>
				        <if test="STTTC2 == &quot;V&quot;">
				        OR PO.IFFLG = 'Y'
				        </if>
				      )
			    </otherwise>
			  </choose>
			  <if test="LOTA14_TR_SQL != null and LOTA14_TR_SQL != ''">
				${LOTA14_TR_SQL}
			  </if>
			GROUP BY PO.STKNUM
			ORDER BY PO.STKNUM DESC
		) A
	</select>
	
	
	<select id="GR301Sub_LIST" parameterType="Map" resultType="DataMap">
		
		<include refid="WmsInbound.INBOUND_SUB_WITH_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_WITH_TRANS_SQL"/>
		<!--  <include refid="WmsInbound.INBOUND_SUB_TOP_SQL"/>-->
		,RI_T AS (

		   SELECT PO.EBELN, PO.EBELP, MAX(RI.LOTA14) AS LOTA14 
		   FROM IFWMS103 PO
		   INNER JOIN RECDI RI ON (RI.SEBELN = PO.EBELN AND RI.SEBELP = PO.EBELP AND STATIT = 'FRV') 
		   
		   <include refid="WmsInbound.INBOUND_SUB_WHERE_SQL"/>
		   <if test="STKNUM != null and STKNUM != ''">
			AND PO.STKNUM = #{STKNUM}
		  </if>
          <if test="SEBELN != null and SEBELN != ''">
			AND PO.EBELN = #{SEBELN}
		  </if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		  </if>
		   GROUP BY PO.EBELN, PO.EBELP 
		)

		SELECT PO.WERKS AS OWNRKY
			 , (SELECT OWNRNM FROM OE_T) AS OWNRNM
		     , PO.WAREKY
		     , (SELECT WARENM FROM WM_T) AS WARENM
			 , NVL(DECODE(SM.SKUG05, '10', ZT.PALCNT, NVL(MIP.QTPUOM,'0.000')), '0.000') AS PALQTY -- 2022.03.11 팔레트 입수량 추가
			 , PO.SKUKEY
		     , SM.DESC01 
		     , SM.DESC02
		     , DT.SYSLOC AS LOCAKY
		     , ' ' AS TRNUID
		     , PO.MENGE
		     , TO_CHAR(SUM(PO.MENGE) OVER(PARTITION BY PO.SKUKEY ORDER BY PO.SKUKEY), 'FM99999999999999999990.000')||' / '||PO.SKUKEY AS SUM_ITEM
		 
		     , PO.MEINS AS UOMKEY
		     , PO.MENGE_R
		     , PO.PTNRTY
		     , NVL(TRIM(LT.LOTA01), NVL(TRIM(PO.LOTA01),SLT.STLKY)) AS LOTA01
		     , PO.LOTA01 AS LOTA01_ORG
		     , PO.LOTA02
		     , PO.LOTA02 AS LOTA02_ORG
		     , PO.LOTA05
		     , PO.LOTA06
		     , (
		     		CASE WHEN PO.BWART='131' AND PO.SOBKZ='E' THEN TRIM(PO.VGBEL)||TRIM(PO.VGPOS)
		     		 	 ELSE PO.LOTA07
		     		END
		        ) AS LOTA07
		     , PO.LOTA07 AS LOTA07_ORG
		     , PO.LOTA08
		     , PO.LOTA08 AS LOTA08_ORG
		     , PO.LOTA10
		     , NVL(TRIM(PO.LOTA12),TO_CHAR(SYSDATE,'YYYYMMDD')) AS LOTA12
		     , PO.LOTA13
		     --, PO.LOTA15
		     , PO.LOTA16
		     , PO.LOTA16 AS LOTA16_ORG
		     <choose>
		     	<when test="RCPTTY != null and RCPTTY == '121'">
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA03, TI_T.LOTA03 ) AS LOTA03
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA03, TI_T.LOTA03 ) AS LOTA03_ORG
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA04, TI_T.LOTA04 ) AS LOTA04
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA09, TI_T.LOTA09 ) AS LOTA09
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA17, TI_T.LOTA17 ) AS LOTA17
		     		, DECODE(TI_T.EBELN, NULL, PO.LOTA17, TI_T.LOTA17 ) AS LOTA17_ORG
		      	</when>
				<otherwise>
				 	, PO.LOTA03
			     	, PO.LOTA03 AS LOTA03_ORG
			     	, PO.LOTA04
			     	, PO.LOTA09
				 	, PO.LOTA17
			     	, PO.LOTA17 AS LOTA17_ORG
				</otherwise>
			 </choose>
		     , PO.LOTA18
		     , PO.LOTA19
		     , PO.LOTA20
		     , PO.EBELN  AS SEBELN
		     , PO.EBELP  AS SEBELP
		     , ' '       AS RECVKY
		     , ' '       AS RECVIT
		     , PO.BWART  AS DOCUTY
		     , PO.MANDT
		     , PO.SEQNO
		     , PO.EBELN
		     , PO.EBELP
		     , PO.BEDAT
		     , PO.BWART
		     , PO.RTNRSN AS RSNCOD-- 반품사유
		     , SZF_GET_RSNCOD_TEXT(#{LANGKY}, #{OWNRKY}, NVL(DT.DOCCAT, '100'), PO.BWART, PO.RTNRSN) AS RSNCODNM -- 반품사유명
		     <choose>
		     	<when test="RCPTTY != null and RCPTTY == '131' and STATDO=='NEW'">
             , '' AS RCPRSN -- 상세사유
		      	</when>
		     	<when test="RCPTTY != null and RCPTTY == '131' and STATDO=='FRV'">
             , NVL((SELECT MAX(RCPRSN) FROM RECDI WHERE SEBELN = PO.EBELN AND SEBELP = PO.EBELP AND STATIT = 'FRV'),' ') AS RCPRSN -- 상세사유
		      	</when>
				<otherwise>
             , PO.RTNTXT AS RCPRSN -- 상세사유
				</otherwise>
			 </choose>
			 , NVL((SELECT LOTA14 FROM RECDI WHERE SEBELN = PO.EBELN AND SEBELP = PO.EBELP AND STATIT = 'FRV' ORDER BY RECVKY DESC, RECVIT DESC FETCH FIRST 1 ROWS ONLY),' ') AS LOTA14 -- 개별바코드
			 , NVL((SELECT LOTA15 FROM RECDI WHERE SEBELN = PO.EBELN AND SEBELP = PO.EBELP AND STATIT = 'FRV' ORDER BY RECVKY DESC, RECVIT DESC FETCH FIRST 1 ROWS ONLY),PO.LOTA15) AS LOTA15 -- LOT번호
		     , SM.ASKU05
		     , SW.MEASKY AS MEASKY 
		     , SM.EANCOD
		     , MI.UOMKEY AS MUOMKEY
		     <choose>
		       <when test="RCPTTY != null and RCPTTY == '121'">
			    , ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), 'FM99999999999999999990.000') END ) AS QTYRCV1
     			, ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN TO_CHAR(TI_T.QTCOMP, 'FM99999999999999999990.000') ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP ), 'FM99999999999999999990.000') END ) AS QTYRCV
     			 , TO_CHAR(SUM(( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN TO_CHAR(TI_T.QTCOMP, 'FM99999999999999999990.000') ELSE TO_CHAR(DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP ), 'FM99999999999999999990.000') END )) OVER(PARTITION BY PO.SKUKEY ORDER BY PO.SKUKEY), 'FM99999999999999999990.000')||' / '||PO.SKUKEY AS SUM_ITEM2
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA11, TI_T.LOTA11 ) AS LOTA11
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA14, TI_T.LOTA14 ) AS LOTA14
			    , CASE WHEN SZF_GET_DOCUTY_TEXT('', PO.BWART) = '구매입고' AND PO.MEINS = 'KG' AND MI.UOMKEY = 'R' 
			           THEN NVL(TRIM(SZF_GET_DEFAULT_QTY_R(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', TI_T.QTCOMP, DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP )), PO.MEINS)),'0.00') 
			    	   ELSE NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', TI_T.QTCOMP, DECODE(TI_T.EBELN, NULL, (PO.MENGE - PO.MENGE_R), TI_T.QTCOMP )), PO.MEINS)),'0.000') 
			    	   END AS UOMQTY
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'KG')),'0.000') AS TOT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'BAG')),'0.000') AS BAG
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'BOX')),'0.000') AS BOX
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'PAL')),'0.000') AS PLT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'SOK')),'0.000') AS SOK
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'EA')),'0.000') AS EA
			    , CASE WHEN DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ) = 0 THEN 0 
					   ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(TI_T.EBELN, NULL, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), DECODE(PO.IFFLG,'Y', 0, TI_T.QTCOMP) ), PO.MEINS, 'BOX'))),'0.000')
				   END AS BOXBAG
			    , TRIM(TI_T.EBELN) AS TEBELN
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA21, TI_T.LOTA21 ) AS LOTA21
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA22, TI_T.LOTA22 ) AS LOTA22
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA23, TI_T.LOTA23 ) AS LOTA23
			    , DECODE(TI_T.EBELN, NULL, PO.LOTA24, TI_T.LOTA24 ) AS LOTA24
			    , DECODE(NVL(TRIM(RT_T.CNT),'0'), '0', PO.IFFLG, 'Y' ) AS IFFLG
			   </when>
			   <otherwise>
			    , ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV1
     			, ( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END ) AS QTYRCV
     			 , TO_CHAR(SUM(( CASE WHEN PO.DLEFLG = 'Y' OR PO.IFFLG = 'Y' THEN '0.000' ELSE TO_CHAR((PO.MENGE - PO.MENGE_R), 'FM99999999999999999990.000') END )) OVER(PARTITION BY PO.SKUKEY ORDER BY PO.SKUKEY), 'FM99999999999999999990.000')||' / '||PO.SKUKEY AS SUM_ITEM2
			    , CASE WHEN PO.BWART = '131' AND PO.LOTA11 = ' ' 
			           THEN TO_CHAR(SYSDATE, 'YYYYMMDD') 
			           ELSE PO.LOTA11 END AS LOTA11
			    -- , PO.LOTA14
			    , CASE WHEN SZF_GET_DOCUTY_TEXT('', PO.BWART) = '구매입고' AND PO.MEINS = 'KG' AND MI.UOMKEY = 'R' 
			           THEN NVL(TRIM(SZF_GET_DEFAULT_QTY_R(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.00',(PO.MENGE - PO.MENGE_R)), PO.MEINS)),'0.00') 
			    	   ELSE NVL(TRIM(SZF_GET_DEFAULT_QTY(#{WAREKY}, PO.SKUKEY, DECODE(PO.IFFLG, 'Y', '0.000',(PO.MENGE - PO.MENGE_R)), PO.MEINS)),'0.000')
			    	   END AS UOMQTY
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'KG')),'0.000') AS TOT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BAG')),'0.000') AS BAG
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BOX')),'0.000') AS BOX
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'PAL')),'0.000') AS PLT
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'SOK')),'0.000') AS SOK
			    , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'EA')),'0.000') AS EA
			    , CASE WHEN (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END) = 0 THEN 0 
					   ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, PO.SKUKEY, (CASE WHEN PO.IFFLG != 'N' THEN PO.MENGE_R ELSE (PO.MENGE - PO.MENGE_R) END), PO.MEINS, 'BOX'))),'0.000')
				   END AS BOXBAG
			    , '' AS TEBELN
			    , PO.LOTA21
	            , PO.LOTA22
	            , PO.LOTA23
	            , PO.LOTA24
	            , PO.IFFLG
			   </otherwise>
			 </choose>
			 , PO.CREDAT
		 	 , PO.CRETIM
		 	 , PO.CREUSR
		 	 , PO.LMODAT
		 	 , PO.LMOTIM
		 	 , PO.LMOUSR
		 	 , PO.INDBZL
		 	 , PO.INDARC
		 	 , PO.UPDCHK
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.CREUSR),' ') AS CUSRNM
		 	 , NVL((SELECT X.NMLAST FROM USR_T X WHERE X.USERID = PO.LMOUSR),' ') AS LUSRNM
		 	 , SLM.STLNM AS LOTA01NM
			 , (SELECT LM.AREAKY FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC ) AS AREAKY
		 	 , NVL((SELECT AM.SHORTX FROM AREMA AM WHERE AM.WAREKY = PO.WAREKY AND EXISTS ( SELECT 'X' FROM LOCMA LM WHERE LM.WAREKY = #{WAREKY} AND LM.LOCAKY = DT.SYSLOC AND LM.AREAKY = AM.AREAKY )),' ') AS AREANM
			 , 'FRV' AS STATIT
			 , SM.SKUG01
			 , SM.SKUG02
			 , SM.SKUG03
			 , NVL((SELECT X.USARG1 FROM SKUG05_T X WHERE X.CMCDVL=SM.SKUG05),SM.SKUG04) AS SKUG04
			 , SM.SKUG05
			 , SM.SKUG05 AS SKUG05_1
			 , SLT.QRTAYN
			 , SLT.SHTAYN
			 , SLME.WMSMAK AS FWMSMAK
			 , PO.BWART AS RCPTTY
			 , PO.LIFNR AS DPTNKY
			 , PO.ZEKKO_AEDAT
			 , PO.EINDT AS ASNDAT
			 , 'NEW' AS STATDO
			 , NVL(#{DOCDAT},TO_CHAR(SYSDATE,'YYYYMMDD')) AS DOCDAT
			 , NVL((SELECT DOCCAT FROM DOCTM WHERE DOCUTY = PO.BWART), '100') AS DOCCAT
			 , PO.SIGNI
			 , DECODE(PO.BWART, '111', PO.SSORNU, PO.VGBEL) AS VGBEL
			 , DECODE(PO.BWART, '111', PO.SSORIT, PO.VGPOS) AS VGPOS
			 , PO.MRFLG
			 , PO.AR_NO
			 , PO.AR_REV
			 , PO.AR_LNO
			 , PO.BWARTSAP
			 , PO.POREV
		 	 , PO.SSORNU
			 , PO.SSORIT
			 , PO.DLEFLG
			 , PO.SERV1
			 , 'V' AS SAPIFYN
			 , SLM.WMSMAK
		     , ' ' AS LOTA41
			 , ' ' AS LOTA42
			 , ' ' AS LOTA43
			 , ' ' AS LOTA44
			 , ' ' AS LOTA45
			 , '0' AS LOTA46
			 , '0' AS LOTA47
			 , '0' AS LOTA48
			 , ' ' AS LOTA49
		<include refid="WmsInbound.INBOUND_SUB_IFID_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_SQL"/>
		<include refid="WmsInbound.INBOUND_SUB_FROM_TRANS_SQL"/>
			LEFT OUTER JOIN RI_T RI ON (RI.EBELN = PO.EBELN AND RI.EBELP = PO.EBELP) 
		<include refid="WmsInbound.INBOUND_SUB_WHERE_SQL"/>
          <if test="STKNUM != null and STKNUM != ''">
			AND PO.STKNUM = #{STKNUM}
		  </if>
          <if test="SEBELN != null and SEBELN != ''">
			AND PO.EBELN = #{SEBELN}
		  </if>
          AND (PO.MRFLG != 'S0' 
               OR (PO.MRFLG = 'S0' 
               	   AND PO.LOTA01 != '2400' 
               	   AND PO.LOTA02 LIKE CASE WHEN PO.BWART = '121' THEN '%' ELSE 'P100' END 
                  )
              )   
          AND ( 
	          1 = 2
	          <if test="STTNEW == &quot;V&quot;">
	          OR PO.IFFLG = 'N'
	          </if>
	          <if test="STTTC2 == &quot;V&quot;">
	          OR PO.IFFLG = 'Y'
	          </if>
	        )
	      <if test="SKUG01 != null and SKUG01 != ''">
			AND SM.SKUG01 = #{SKUG01}
		  </if>
		  <if test="SKUL01 != null and SKUL01 != ''">
			AND SM.SKUL01 = #{SKUL01}
		  </if>
		  <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		  </if>
		  
		  <choose>
		       <when test="RCPTTY != null and RCPTTY == '121'">
		       	${LOTA14_TR_SQL}
			   </when>
			   <otherwise>
			   	${LOTA14_SQL}
			   </otherwise>
		 </choose>
			 
		 <include refid="WmsInbound.INBOUND_SUB_SORT_SQL"/>
         
	</select>
</mapper>