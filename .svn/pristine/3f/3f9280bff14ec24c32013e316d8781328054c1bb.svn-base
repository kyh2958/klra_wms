	<!-- <select id="RECDTYPE_LIST" parameterClass="Map" resultClass="DataMap">
		SELECT DOCUTY AS VALUE_COL
			 , SHORTX AS TEXT_COL
		FROM DOCTM
		WHERE 1 = 1
		AND DOCCAT = '100'
		<isEqual property="RCPTTY" compareValue="GR02">
			AND DOCUTY IN ('101','102','103','104','105','106','107')
