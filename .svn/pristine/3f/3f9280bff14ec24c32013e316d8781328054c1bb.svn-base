			STDLNR,
			SSORNU,
			SSORIT,
			SMBLNR,
			SZEILE,
			SMJAHR,
			SXBLNR,
			RCPRSN,
			CREDAT,
			CRETIM,
			CREUSR,
			LMODAT,
			LMOTIM,
			LMOUSR,
			' ' AS CUSRNM,
			' ' AS LUSRNM
		FROM RECDI
		WHERE RECVKY = #{RECVKY}
	</select>
	
