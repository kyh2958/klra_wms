			LOTA20,
			' ' AS LOTA01NM,
			' ' AS SBKTXT,
			AWMSNO,
			REFDKY,
			REFDIT,
			REFCAT,
			REFDAT,
			DESC01,
			DESC02,
			ASKU01,
			ASKU02,
			ASKU03,
