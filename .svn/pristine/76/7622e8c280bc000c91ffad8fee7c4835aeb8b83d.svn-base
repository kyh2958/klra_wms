<insert id="IFWMS108_MULTI_INSERT" parameterType="Map">
	INSERT INTO IFWMS108
	     (
	       MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , VGBEL
	     , VGPOS
	     , WAREKY
	     , SKUKEY
