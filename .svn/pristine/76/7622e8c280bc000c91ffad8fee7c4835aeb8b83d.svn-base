<!-- 재고검증 전송대상 검색 -->
<select id="IFWMS999_LIST" parameterType="Map" resultType="DataMap">
	SELECT MATNR
	     , LOTA01
	     , LOTA02
	     , LOTA15
	     , USEQTY
	     , QTSCNU
	     , QTSIQT
	     , LOTA07
	     , MEINS
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE 'E'
	       END AS SOBKZ
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 1, 10)
	       END AS VBELN
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 11)
	       END AS POSNR
	     , STKDT
	     , STKTM
	  FROM IFWMS999
	 WHERE PRCFLG != 'C'
	   AND LOGSEQNO = #{LOGSEQNO}
</select>

<!-- 전송 실패건 재처리대상 검색 
     예외처리 : IFWMS223에서
                WMS_IF_209,213은 SAP전송 실패시 QR처리하여 GR14화면에서 처리되기때문에 제외
                WMS_IF_401,402,404,405 관련 에러시 롤백되므로 제외
                사실상 현시점에는 WMS_IF_903 MTO/MTS 자동처리만 재처리 가능 -->
<select id="IFWMS000_AUTO_LIST" parameterType="Map" resultType="DataMap">
	SELECT 'IFWMS203' AS TBL, LOGSEQNO, IFID 
      FROM IFWMS203 
     WHERE PRCFLG = 'E' 
       AND ITFCNT &lt; 5 
	   AND MANDT != 'SAP'
	GROUP BY LOGSEQNO, IFID
	UNION
	SELECT 'IFWMS209' AS TBL, LOGSEQNO, IFID FROM IFWMS209 WHERE PRCFLG = 'E' AND ITFCNT &lt; 5 GROUP BY LOGSEQNO, IFID
	UNION
	SELECT 'IFWMS213' AS TBL, LOGSEQNO, IFID 
      FROM IFWMS213 
     WHERE PRCFLG = 'E' 
       AND ITFCNT &lt; 5 
	   AND MANDT != 'SAP'
	 GROUP BY LOGSEQNO, IFID
	UNION
	SELECT 'IFWMS223' AS TBL, LOGSEQNO, IFID
	  FROM IFWMS223
	 WHERE PRCFLG = 'E' 
	   AND IFID NOT IN ('WMS_IF_209', 'WMS_IF_213', 'WMS_IF_401', 'WMS_IF_402', 'WMS_IF_404', 'WMS_IF_405')
	   AND ITFCNT &lt; 5
	   AND MANDT != '100'
	 GROUP BY LOGSEQNO, IFID
    ORDER BY LOGSEQNO ASC
</select>

<!-- 전송 실패건 재처리 시도회수 증가처리 -->
<update id="IFWMS000_COUNT_UPDATE" parameterType="Map">
	UPDATE ${TBL}
	   SET ITFCNT = ITFCNT + 1
	 WHERE LOGSEQNO = #{LOGSEQNO}
</update>

<update id="RETRY_FLG_UPDATE" parameterType="Map">
	UPDATE ${TBL}
	   SET LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , ITFCNT = ITFCNT + 1
	 WHERE PRCFLG != 'C'
	   AND ITFCNT &lt; 5
	   AND IFID     = #{IFID}
	   AND LOGSEQNO = #{SEQNO}
</update>

