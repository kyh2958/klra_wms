<!-- IFWMS213 MES 출고실적정보 등록 -->
<insert id="IFWMS213_MES_INSERT" parameterType="Map">
	INSERT INTO IFWMS213
	     (
	       MANDT
	     , SEQNO
	     , VBELN
	     , POSNR
	     , BWART
	     , WADAT
	     , KUNAG
	     , WERKS
	     , MATNR
	     , MEINS
	     , ZDOC_NO
	     , ZDOC_ITEM
	     , SKUKEY
	     , ZQTSACT
	     , ORDCAT
	     , PTNRTY
	     , QTSHP
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10,
		   LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , BWARTSAP
	     , STATUS
	     , STOKKY
	     , LOTNUM
	     , PIKSUM
	     , PO_NO
		 , PO_REV
		 , PO_LNO
		 , LFART
		 , ZLGORT
		 , SIGNI
		 , EXTI2
		 , WAREKY
		 , ESHPKY
		 , ESHPKY_ITEM
	     )
	 
	SELECT   A.MANDT
		   , SEQ_IFWMS213.NEXTVAL   AS SEQNO
	       , A.VBELN
	       , A.POSNR
	       , A.BWART
	       , A.WADAT
	       , A.KUNAG
	       , A.WERKS
	       , A.MATNR
	       , A.MEINS
	       , A.ZDOC_NO
	       , A.ZDOC_ITEM
	       , A.SKUKEY
	       , A.ZQTSACT 
	       , A.ORDCAT
	       , A.PTNRTY
	       , A.QTSHP
	       , A.LOTA01, A.LOTA02, A.LOTA03, A.LOTA04, A.LOTA05, A.LOTA06, A.LOTA07, A.LOTA08, A.LOTA09, A.LOTA10,
		     A.LOTA11, A.LOTA12, A.LOTA13, A.LOTA14, A.LOTA15, A.LOTA16, A.LOTA17, A.LOTA18, A.LOTA19, A.LOTA20
	       , A.CDATE, A.CREDAT, A.CRETIM, A.CREUSR
	       , A.IFID
	       , A.IFFLG
	       , A.ITFFLG, A.ITFDAT, A.ITFTIM
	       , A.PRCFLG
	       , A.LOGSEQNO
	       , A.BWARTSAP 
	       , A.STATUS
	       , A.STOKKY
	       , A.LOTNUM
		   , SUM(A.ZQTSACT) OVER (PARTITION BY A.VBELN, A.POSNR)
		   , A.PO_NO
		   , A.PO_REV
		   , A.PO_LNO
		   , A.LFART
		   , A.ZLGORT
		   , A.SIGNI
		   , A.EXTI2
		   , A.WAREKY
		   , A.ESHPKY
		   , A.LOTA18 AS ESHPKY_ITEM
	FROM (
	    
	SELECT   A.MANDT
	       , A.VBELN
	       , A.POSNR
	       , A.BWART
	       , A.WADAT
	       , A.KUNAG
	       , A.WERKS
	       , A.MATNR
	       , A.MEINS
	       , A.ZDOC_NO
	       , A.ZDOC_ITEM
	       , A.SKUKEY
	       --, SUM(A.ZQTSACT) AS ZQTSACT
           , NVL(TRIM(SZF_GET_CONVERT_QTY(MAX(A.WAREKY), MAX(A.SKUKEY), SUM(NVL(TRIM(A.QTSTKM), 0)), MAX(A.DUOMKY), MAX(A.UOMKEY))),'0') AS ZQTSACT
	       , A.ORDCAT
	       , A.PTNRTY
	       , A.QTSHP
	       , A.LOTA01, A.LOTA02, A.LOTA03, A.LOTA04, A.LOTA05, A.LOTA06, A.LOTA07, A.LOTA08, A.LOTA09, A.LOTA10,
		     A.LOTA11, A.LOTA12, A.LOTA13, A.LOTA14, A.LOTA15, A.LOTA16, A.LOTA17, A.LOTA18, A.LOTA19, A.LOTA20
	       , A.CDATE, A.CREDAT, A.CRETIM, A.CREUSR
	       , A.IFID
	       , A.IFFLG
	       , A.ITFFLG, A.ITFDAT, A.ITFTIM
	       , A.PRCFLG
	       , A.LOGSEQNO
	       , A.BWARTSAP 
	       , A.STATUS
	       , A.STOKKY
	       , A.LOTNUM
	       , A.PO_NO
		   , A.PO_REV
		   , A.PO_LNO
		   , A.LFART
		   , A.ZLGORT
		   , A.SIGNI
		   , A.EXTI2
		   , A.WAREKY
		   , A.ESHPKY
	FROM(
	     
		SELECT CASE WHEN #{IFID} IN ('WMS_IF_317','WMS_IF_307','WMS_IF_308','WMS_IF_320','WMS_IF_321','WMS_IF_311','WMS_IF_313','WMS_IF_314','WMS_IF_315','WMS_IF_323') THEN 'SAP'
		            WHEN #{IFID} IN ('WMS_IF_309','WMS_IF_310','WMS_IF_322') THEN 'MES'
		       END AS MANDT
		     , SI.SVBELN    AS VBELN
		     , SI.SPOSNR    AS POSNR
		     , CASE WHEN #{IFID} = 'WMS_IF_307' THEN '201' -- 출고실적정보(주문)-SAP
		            WHEN #{IFID} = 'WMS_IF_308' THEN '221' -- 출고실적정보(이송)-SAP
		            WHEN #{IFID} = 'WMS_IF_309' THEN '205' -- 자재불출실적정보-MES
		            WHEN #{IFID} = 'WMS_IF_310' THEN '354' -- 즉시불출실적정보-MES
		            WHEN #{IFID} = 'WMS_IF_311' THEN '231' -- 반품출고실적정보-SAP
		            WHEN #{IFID} = 'WMS_IF_315' THEN '206' -- 무상출고실적정보-SAP
		            WHEN #{IFID} = 'WMS_IF_317' THEN '353' -- 생산투입불출정보 353 생산투입불출, 356 생산직불출
		            WHEN #{IFID} = 'WMS_IF_320' THEN '205' -- 자재불출실적정보-SAP
		       END AS BWART
		     , SH.DOCDAT AS WADAT
		     , SH.DPTNKY AS KUNAG
		     , SH.OWNRKY AS WERKS
		     , SI.SKUKEY AS MATNR
		     , SI.UOMKEY AS MEINS
		     , SI.SHPOKY AS ZDOC_NO
		     , SI.SHPOIT AS ZDOC_ITEM
		     , SI.SKUKEY AS SKUKEY
		     , NVL(TRIM(TR.QTSTKM), 0) AS QTSTKM -- 추가
             , SI.DUOMKY AS DUOMKY --추가
             , SI.UOMKEY AS UOMKEY --추가
		     , NVL(TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, NVL(TRIM(TR.QTSTKM), 0), SI.DUOMKY, SI.UOMKEY)),'0') AS ZQTSACT
		     , SH.DOCCAT AS ORDCAT
		     , 'CT'      AS PTNRTY
		     , CASE WHEN SI.DUOMKY = SI.UOMKEY THEN TO_CHAR(SI.QTSHPD)
		       ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTSHPD, SI.DUOMKY, SI.UOMKEY)),'0')
		       END AS QTSHP 		    
		     , NVL(TRIM(TI.LOTA01), ' ') AS LOTA01
		     , NVL(TRIM(TI.LOTA02), ' ') AS LOTA02
		     , NVL(TRIM(TI.LOTA03), ' ') AS LOTA03
		     , NVL(TRIM(TI.LOTA04), ' ') AS LOTA04
		     , NVL(TRIM(TI.LOTA05), ' ') AS LOTA05
		     , NVL(TRIM(TI.LOTA06), ' ') AS LOTA06
		     , NVL(TRIM(TI.LOTA07), ' ') AS LOTA07
		     , NVL(TRIM(TI.LOTA08), ' ') AS LOTA08
		     , NVL(TRIM(TI.LOTA09), ' ') AS LOTA09
		     , NVL(TRIM(TI.LOTA10), ' ') AS LOTA10
		     , NVL(TRIM(TI.LOTA11), ' ') AS LOTA11
		     , NVL(TRIM(TI.LOTA12), ' ') AS LOTA12
		     , NVL(TRIM(TI.LOTA13), ' ') AS LOTA13
		     , NVL(TRIM(TI.LOTA14), ' ') AS LOTA14
		     , NVL(TRIM(TI.LOTA15), ' ') AS LOTA15
		     , NVL(TRIM(TI.LOTA16), 0) 	 AS LOTA16
		     , NVL(TRIM(TI.LOTA17), ' ') AS LOTA17
		     , NVL(TRIM(SI.LOTA18), 0)   AS LOTA18
		     , NVL(TRIM(TI.LOTA19), 0)   AS LOTA19
		     , NVL(TRIM(TI.LOTA20), 0)   AS LOTA20
		     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') AS CDATE, TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, NVL(TRIM(#{SES_USER_ID}),#{IFID}) AS CREUSR		     
		     , #{IFID} AS IFID
		     , 'N' AS IFFLG
		     , 'I' AS ITFFLG, TO_CHAR(SYSDATE, 'YYYYMMDD') AS ITFDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS ITFTIM
		     , 'I' AS PRCFLG
		     , #{LOGSEQNO} AS LOGSEQNO
		     , (
		        CASE WHEN SH.SHPMTY IN ('201','208')             THEN DECODE(SH.STATDO, 'FSH', '601', 'PSH', '601', '602')   --판매출고, 수출출고
		             WHEN SH.SHPMTY IN ('205','346','353','356') THEN DECODE(SH.STATDO, 'FSH', '311', 'PSH', '311', '312')   --자재불출, 생산투입불출, 생산직불출
		             WHEN SH.SHPMTY IN ('206')                   THEN DECODE(SH.STATDO, 'FSH', '511', 'PSH', '511', '512')   --무상출고
		             WHEN SH.SHPMTY IN ('221')                   THEN DECODE(SH.STATDO, 'FSH',  SI.SAPSTS, 'PSH', SI.SAPSTS, '648')   --이송출고
		             WHEN SH.SHPMTY IN ('231')                   THEN DECODE(SH.STATDO, 'FSH', '161', 'PSH', '161', '162')   --반품출고
		             WHEN SH.SHPMTY IN ('361')                   THEN DECODE(SH.STATDO, 'FSH', '551', 'PSH', '551', '555')   --폐기출고
		             WHEN SH.SHPMTY IN ('399')                   THEN DECODE(SH.STATDO, 'FSH', '702', 'PSH', '702', '701')   --재고조정출고
		             ELSE SH.SHPMTY
		        END
		       ) AS BWARTSAP
		     , (
		      	CASE WHEN SH.SHPMTY IN ('201','208')             THEN DECODE(SH.STATDO, 'FSH', 'A', 'PSH', 'A', 'D')   --판매출고, 수출출고
		             WHEN SH.SHPMTY IN ('205','346','353','356') THEN DECODE(SH.STATDO, 'FSH', 'A', 'PSH', 'A', 'D')   --자재불출, 생산투입불출, 생산직불출
		             WHEN SH.SHPMTY IN ('206')                   THEN DECODE(SH.STATDO, 'FSH', 'A', 'PSH', 'A', 'D')   --무상출고
		             WHEN SH.SHPMTY IN ('221')                   THEN DECODE(SH.STATDO, 'FSH', 'A', 'PSH', 'A', 'D')   --이송출고
		             WHEN SH.SHPMTY IN ('231')                   THEN DECODE(SH.STATDO, 'FSH', 'A', 'PSH', 'A', 'D')   --반품출고
		             WHEN SH.SHPMTY IN ('361')                   THEN DECODE(SH.STATDO, 'FSH', 'A', 'PSH', 'A', 'D')   --폐기출고
		             WHEN SH.SHPMTY IN ('399')                   THEN DECODE(SH.STATDO, 'FSH', 'A', 'PSH', 'A', 'D')   --재고조정출고
		             ELSE 'A'
		        END
		       ) AS STATUS
		      , NVL(TRIM(TR.STOKKY), ' ') AS STOKKY
	       	  , NVL(TRIM(TI.LOTNUM), ' ') AS LOTNUM
	       	  , SI.PO_NO
			  , SI.PO_REV
			  , SI.PO_LNO
			  , SH.LFART
			  , SH.ZLGORT
		 	  , SH.SIGNI
		 	  , SH.EXTI2
		 	  , SH.WAREKY
		 	  , SI.ESHPKY
		  FROM SHPDI SI
		     INNER JOIN SHPDH SH ON SH.SHPOKY = SI.SHPOKY	     	                        
		     INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT= SI.SHPOIT
		                        AND TI.STATIT IN ('FPC', 'PPC')
		                        AND TI.TASKTY IN ('PK')
		     LEFT OUTER JOIN TASDR TR ON TI.TASKKY = TR.TASKKY AND TI.TASKIT = TR.TASKIT
		     
		 WHERE SI.SHPOKY IN (${RECVKYIN})
	 )	A  GROUP BY A.MANDT                                 
				, A.VBELN                                 
				, A.POSNR                                 
				, A.BWART                                 
				, A.WADAT                                 
				, A.KUNAG                                 
				, A.WERKS                                 
				, A.MATNR                                 
				, A.MEINS                                 
				, A.ZDOC_NO
				, A.ZDOC_ITEM                               
				, A.SKUKEY                                
				--, A.ZQTSACT                               
				, A.ORDCAT                                
				, A.PTNRTY                                
				, A.QTSHP                                 
				, A.LOTA01, A.LOTA02, A.LOTA03, A.LOTA04, A.LOTA05, A.LOTA06, A.LOTA07, A.LOTA08, A.LOTA09, A.LOTA10,
		     	  A.LOTA11, A.LOTA12, A.LOTA13, A.LOTA14, A.LOTA15, A.LOTA16, A.LOTA17, A.LOTA18, A.LOTA19, A.LOTA20                              
				, A.CDATE, A.CREDAT, A.CRETIM, A.CREUSR   
				, A.IFID                                  
				, A.IFFLG                                 
				, A.ITFFLG, A.ITFDAT, A.ITFTIM            
				, A.PRCFLG      
				, A.STATUS                          
				, A.LOGSEQNO                              
				, A.BWARTSAP 
				, A.STATUS
		       	, A.STOKKY
		       	, A.LOTNUM  
		       	, A.PO_NO
			    , A.PO_REV
			    , A.PO_LNO
			    , A.LFART
			    , A.ZLGORT
			    , A.SIGNI
			    , A.EXTI2
			    , A.WAREKY
			    , A.ESHPKY
	) A		                           
</insert>

<!-- IFWMS213 SAP 출고실적정보 등록 -->
<insert id="IFWMS213_SAP_INSERT" parameterType="Map">
	INSERT INTO IFWMS213
	     (
	       MANDT
	     , SEQNO
	     , VBELN
	     , POSNR
	     , BWART
	     , WADAT
	     , KUNAG
	     , WERKS
	     , MATNR
	     , MEINS
	     , ZDOC_NO
	     , ZDOC_ITEM
	     , SKUKEY
	     , ZQTSACT 
	     , ORDCAT
	     , PTNRTY
	     , QTSHP
	     , LOTA01, LOTA02, LOTA06, LOTA07 ,LOTA08, LOTA15
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , BWARTSAP
	     , STATUS
	     , PIKSUM 
	     , PO_NO
		 , PO_REV
		 , PO_LNO
		 , LFART
		 , ZLGORT
		 , SIGNI
		 , EXTI2
		 , WAREKY
	     )
	 
	SELECT   A.MANDT
		   , SEQ_IFWMS213.NEXTVAL   AS SEQNO
	       , A.VBELN
	       , A.POSNR
	       , A.BWART
	       , A.WADAT
	       , A.KUNAG
	       , A.WERKS
	       , A.MATNR
	       , A.MEINS
	       , A.ZDOC_NO
	       , CASE WHEN #{IFID} IN ('WMS_IF_311') 
	              THEN LTRIM(RTRIM(TO_CHAR(ROW_NUMBER() OVER(PARTITION BY A.VBELN ORDER BY A.VBELN, A.POSNR) * 10, '000000')))
	              ELSE A.ZDOC_ITEM 
	         END AS ZDOC_ITEM
	       , A.SKUKEY
	       , A.ZQTSACT 
	       , A.ORDCAT
	       , A.PTNRTY
	       , A.QTSHP
	       , A.LOTA01, A.LOTA02, A.LOTA06, A.LOTA07, A.LOTA08, A.LOTA15
	       , A.CDATE, A.CREDAT, A.CRETIM, A.CREUSR
	       , A.IFID
	       , A.IFFLG
	       , A.ITFFLG, A.ITFDAT, A.ITFTIM
	       , A.PRCFLG
	       , A.LOGSEQNO
	       , A.BWARTSAP 
	       , A.STATUS
		   , SUM(A.ZQTSACT) OVER (PARTITION BY   A.VBELN, A.POSNR) AS PIKSUM
		   , A.PO_NO
		   , A.PO_REV
		   , A.PO_LNO
		   , A.LFART
		   , A.ZLGORT
		   , A.SIGNI
		   , A.EXTI2
		   , A.WAREKY
	FROM (
	    
	SELECT   A.MANDT
	       , A.VBELN
	       , A.POSNR
	       , A.BWART
	       , A.WADAT
	       , A.KUNAG
	       , A.WERKS
	       , A.MATNR
	       , A.MEINS
	       , A.ZDOC_NO
	       , A.ZDOC_ITEM
	       , A.SKUKEY
	       , NVL(TRIM(SZF_GET_CONVERT_QTY(MAX(A.WAREKY), MAX(A.SKUKEY), SUM(NVL(TRIM(A.QTSTKM), 0)), MAX(A.DUOMKY), MAX(A.UOMKEY))), '0') AS ZQTSACT
	       --, ROUND(NVL(TRIM(SZF_GET_CONVERT_QTY(MAX(A.WAREKY), MAX(A.SKUKEY), SUM(NVL(TRIM(A.QTSTKM), 0)), MAX(A.DUOMKY), MAX(A.UOMKEY))), '0'), 2) AS ZQTSACT -- 환산오차 발생시 ROUND 적용해서 보정 (개발자 로컬환경에서 수동맞춤시 사용처리)
	       , A.ORDCAT
	       , A.PTNRTY
	       , A.QTSHP
	       , A.LOTA01, A.LOTA02, A.LOTA06, A.LOTA07, A.LOTA08, A.LOTA15
	       , A.CDATE, A.CREDAT, A.CRETIM, A.CREUSR
	       , A.IFID
	       , A.IFFLG
	       , A.ITFFLG, A.ITFDAT, A.ITFTIM
	       , A.PRCFLG
	       , A.LOGSEQNO
	       , A.BWARTSAP 
	       , A.STATUS
	       , A.PO_NO
		   , A.PO_REV
		   , A.PO_LNO
		   , A.LFART
		   , A.ZLGORT
		   , A.SIGNI
		   , A.EXTI2
		   , A.WAREKY

	FROM(
	     
		SELECT CASE WHEN #{IFID} IN ('WMS_IF_317','WMS_IF_307','WMS_IF_308','WMS_IF_320','WMS_IF_321','WMS_IF_311','WMS_IF_313','WMS_IF_314','WMS_IF_315','WMS_IF_323') THEN 'SAP'
		            WHEN #{IFID} IN ('WMS_IF_309','WMS_IF_310','WMS_IF_322') THEN 'MES'
		       END AS MANDT
		     , SI.SVBELN    AS VBELN
		     , SI.SPOSNR    AS POSNR
		     , CASE WHEN #{IFID} = 'WMS_IF_307' THEN '201' -- 출고실적정보(주문)-SAP
		            WHEN #{IFID} = 'WMS_IF_308' THEN '221' -- 출고실적정보(이송)-SAP
		            WHEN #{IFID} = 'WMS_IF_309' THEN '205' -- 자재불출실적정보-MES
		            WHEN #{IFID} = 'WMS_IF_310' THEN '354' -- 즉시불출실적정보-MES
		            WHEN #{IFID} = 'WMS_IF_311' THEN '231' -- 반품출고실적정보-SAP
		            WHEN #{IFID} = 'WMS_IF_315' THEN '206' -- 무상출고실적정보-SAP
		            WHEN #{IFID} = 'WMS_IF_317' THEN '353' -- 생산투입불출정보 353 생산투입불출, 356 생산직불출
		            WHEN #{IFID} = 'WMS_IF_320' THEN '205' -- 자재불출실적정보-SAP
		       END AS BWART
		     , SH.DOCDAT AS WADAT
		     , CASE WHEN SH.SHPMTY = '231' THEN SH.PTRCVR
				ELSE SH.DPTNKY 
				END AS KUNAG
		     , SH.OWNRKY AS WERKS
		     , SI.SKUKEY AS MATNR
		     , SI.UOMKEY AS MEINS
		     , SI.SHPOKY AS ZDOC_NO
		     , SI.SHPOIT AS ZDOC_ITEM
		     , SI.SKUKEY AS SKUKEY
		     , SI.UOMKEY AS UOMKEY
             , SI.DUOMKY AS DUOMKY
             , NVL(TRIM(TR.QTSTKM), 0) AS QTSTKM
             , NVL(TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, NVL(TRIM(TR.QTSTKM), 0), SI.DUOMKY, SI.UOMKEY)),'0') AS ZQTSACT
		     , SH.DOCCAT AS ORDCAT
		     , 'CT'      AS PTNRTY
		     , CASE WHEN SI.DUOMKY = SI.UOMKEY THEN TO_CHAR(SI.QTSHPD)
		       ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTSHPD, SI.DUOMKY, SI.UOMKEY)),'0')
		       END AS QTSHP 		    
		     , NVL(TRIM(TI.LOTA01), ' ') AS LOTA01
		     , NVL(TRIM(TI.LOTA02), ' ') AS LOTA02
		     , NVL(TRIM(TI.LOTA03), ' ') AS LOTA03
		     , NVL(TRIM(TI.LOTA04), ' ') AS LOTA04
		     , NVL(TRIM(TI.LOTA05), ' ') AS LOTA05
		     , NVL(TRIM(TI.LOTA06), ' ') AS LOTA06
		     , NVL(TRIM(TI.LOTA07), ' ') AS LOTA07
		     , NVL(TRIM(TI.LOTA08), ' ') AS LOTA08
		     , NVL(TRIM(TI.LOTA09), ' ') AS LOTA09
		     , NVL(TRIM(TI.LOTA10), ' ') AS LOTA10
		     , NVL(TRIM(TI.LOTA11), ' ') AS LOTA11
		     , NVL(TRIM(TI.LOTA12), ' ') AS LOTA12
		     , NVL(TRIM(TI.LOTA13), ' ') AS LOTA13
		     , NVL(TRIM(TI.LOTA14), ' ') AS LOTA14
		     , NVL(TRIM(TI.LOTA15), ' ') AS LOTA15
		     , NVL(TRIM(TI.LOTA16), 0) 	 AS LOTA16
		     , NVL(TRIM(TI.LOTA17), ' ') AS LOTA17
		     , NVL(TRIM(TI.LOTA18), 0)   AS LOTA18
		     , NVL(TRIM(TI.LOTA19), 0)   AS LOTA19
		     , NVL(TRIM(TI.LOTA20), 0)   AS LOTA20
		     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') AS CDATE, TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, NVL(TRIM(#{SES_USER_ID}),#{IFID}) AS CREUSR		     
		     , #{IFID} AS IFID
		     , 'N' AS IFFLG
		     , 'I' AS ITFFLG, TO_CHAR(SYSDATE, 'YYYYMMDD') AS ITFDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS ITFTIM
		     , 'I' AS PRCFLG
		     , #{LOGSEQNO} AS LOGSEQNO
		     , (
		      CASE WHEN SH.SHPMTY IN ('201','208')             THEN DECODE(SH.STATDO, 'FSH', '601', 'PSH', '601', '602')   --판매출고, 수출출고
		            WHEN SH.SHPMTY IN ('205','346','353','356') THEN DECODE(SH.STATDO, 'FSH', '311', 'PSH', '311', '312')   --자재불출, 생산투입불출, 생산직불출
		            WHEN SH.SHPMTY IN ('206')                   THEN DECODE(SH.STATDO, 'FSH', '511', 'PSH', '511', '512')   --무상출고
		            WHEN SH.SHPMTY IN ('221')                   THEN DECODE(SH.STATDO, 'FSH',  SI.SAPSTS, 'PSH', SI.SAPSTS, '648')   --이송출고
		            WHEN SH.SHPMTY IN ('231')                   THEN DECODE(SH.STATDO, 'FSH', '161', 'PSH', '161', '162')   --반품출고
		            WHEN SH.SHPMTY IN ('361')                   THEN DECODE(SH.STATDO, 'FSH', '551', 'PSH', '551', '555')   --폐기출고
		            WHEN SH.SHPMTY IN ('399')                   THEN DECODE(SH.STATDO, 'FSH', '702', 'PSH', '702', '701')   --재고조정출고
		            ELSE SH.SHPMTY
		       END
		       ) AS BWARTSAP
		       , (
		      	CASE WHEN SH.SHPMTY IN ('201','208')            THEN DECODE(SH.STATDO, 'FSH', 'C', 'PSH', 'C', 'D')   --판매출고, 수출출고
		            WHEN SH.SHPMTY IN ('205','346','353','356') THEN DECODE(SH.STATDO, 'FSH', 'C', 'PSH', 'C', 'D')   --자재불출, 생산투입불출, 생산직불출
		            WHEN SH.SHPMTY IN ('206')                   THEN DECODE(SH.STATDO, 'FSH', 'C', 'PSH', 'C', 'D')   --무상출고
		            WHEN SH.SHPMTY IN ('221')                   THEN DECODE(SH.STATDO, 'FSH', 'C', 'PSH', 'C', 'D')   --이송출고
		            WHEN SH.SHPMTY IN ('231')                   THEN DECODE(SH.STATDO, 'FSH', 'C', 'PSH', 'C', 'D')   --반품출고
		            WHEN SH.SHPMTY IN ('361')                   THEN DECODE(SH.STATDO, 'FSH', 'C', 'PSH', 'C', 'D')   --폐기출고
		            WHEN SH.SHPMTY IN ('399')                   THEN DECODE(SH.STATDO, 'FSH', 'C', 'PSH', 'C', 'D')   --재고조정출고
		            ELSE 'A'
		       END
		       ) AS STATUS
		      , NVL(TRIM(TR.STOKKY), ' ') AS STOKKY
	       	  , NVL(TRIM(TI.LOTNUM), ' ') AS LOTNUM
	       	  , SI.PO_NO
			  , SI.PO_REV
			  , SI.PO_LNO
			  , SH.LFART
			  , SH.ZLGORT
			  , SH.SIGNI
			  , SH.EXTI2
			  , SH.WAREKY
		  FROM SHPDI SI
		     INNER JOIN SHPDH SH ON SH.SHPOKY = SI.SHPOKY	     	                        
		     INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT= SI.SHPOIT
		                        AND TI.STATIT IN ('FPC', 'PPC')
		                        AND TI.TASKTY IN('PK')
		     LEFT OUTER JOIN TASDR TR ON TI.TASKKY = TR.TASKKY AND TI.TASKIT = TR.TASKIT
		     
		 WHERE SI.SHPOKY IN (${RECVKYIN})
	 )	A  GROUP BY A.MANDT                                 
				, A.VBELN                                 
				, A.POSNR                                 
				, A.BWART                                 
				, A.WADAT                                 
				, A.KUNAG                                 
				, A.WERKS                                 
				, A.MATNR                                 
				, A.MEINS                                 
				, A.ZDOC_NO
				, A.ZDOC_ITEM                               
				, A.SKUKEY                                
				--, A.ZQTSACT                               
				, A.ORDCAT                                
				, A.PTNRTY                                
				, A.QTSHP                                 
				, A.LOTA01, A.LOTA02, A.LOTA06, A.LOTA07, A.LOTA08, A.LOTA15                        
				, A.CDATE, A.CREDAT, A.CRETIM, A.CREUSR   
				, A.IFID                                  
				, A.IFFLG                                 
				, A.ITFFLG, A.ITFDAT, A.ITFTIM            
				, A.PRCFLG      
				, A.STATUS                          
				, A.LOGSEQNO                              
				, A.BWARTSAP 
				, A.STATUS
		       	, A.PO_NO
			    , A.PO_REV
			    , A.PO_LNO
			    , A.LFART
			    , A.ZLGORT
			    , A.SIGNI
			    , A.EXTI2
			    , A.WAREKY
			    
	) A		                           
</insert>

<!-- IFWMS213 출고실적정보 등록 TAS 기반 -->
<insert id="IFWMS213_TAS_INSERT" parameterType="Map">
	INSERT INTO IFWMS213
	     (
	       MANDT
	     , SEQNO
	     , VBELN
	     , POSNR	     
	     , BWART
	     , WADAT
	     , KUNAG
	     , WERKS
	     , MATNR
	     , MEINS
	     , ZDOC_NO
		 , ZDOC_ITEM
	     , WAREKY
	     , SKUKEY
	     , ZQTSACT
	     , ORDCAT
	     , PTNRTY
	     , QTSHP
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , BWARTSAP
	     , STOKKY
	     , LOTNUM
	     , ZDFF
	     , PIKSUM
	     , PTNRKY       
		 , CONTNO       
		 , BARCNO       
		 , ZFBLNO       
		 , ROLLID       		 
		 , MRGSM        
		 , LENGTH       
		 , NETWT        
		 , WGTMUL       
		 , COREDI       
		 , KUNIT        
		 , CPCOD        
		 , TBRGEW       
		 , RBRGEW       
		 , LUNIT        
		 , DESCRI       
		 , WEIGHT       
		 , RMK1         
		 , RMK2         
		 , RMK3         
		 , RMK4         
		 , RMK5     
		 , STATUS   
		 , SEBELN
		 , DOCDAT 
		 , UI
		 , REMARK
		 , VGBEL
		 , VGPOS
	     )
	SELECT CASE WHEN #{IFID} IN ('WMS_IF_313','WMS_IF_314','WMS_IF_320') THEN 'SAP'
                WHEN #{IFID} IN ('WMS_IF_322','WMS_IF_324', 'WMS_IF_310') THEN 'MES' <!-- 즉시불출은 취소시에 TAS기준으로 생성 -->
	       END --MANDT
	     , SEQ_IFWMS213.NEXTVAL   -- SEQNO
	     , TI.TASKKY -- VBELN
	     , TI.TASKIT -- POSNR
	     , TH.TASOTY --BWART
	     , TH.DOCDAT -- WADAT
	     , TH.PTNRKY -- KUNAG
	     , TI.OWNRKY -- WERKS
	     , TI.SKUKEY -- MATNR
	     , TI.SUOMKY -- MEINS
	     , TI.TASKKY -- ZDOC_NO
	     , TI.TASKIT -- ZDOC_ITEM
	     , TH.WAREKY
	     , TI.SKUKEY
	     , TI.QTTAOR -- ZQTSACT
	     , TH.DOCCAT -- ORDCAT
	     , 'CT'      -- PTNRTY
	     , TI.QTCOMP -- QTSHP
	     , TI.LOTA01, TI.LOTA02, TI.LOTA03, TI.LOTA04, TI.LOTA05, TI.LOTA06, TI.LOTA07, TI.LOTA08, TI.LOTA09, TI.LOTA10
	     , TI.LOTA11, TI.LOTA12, TI.LOTA13, TI.LOTA14, TI.LOTA15, TI.LOTA16, TI.LOTA17, TI.LOTA18, TI.LOTA19, TI.LOTA20
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID}
	     , 'N' --IFFLG
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'I' --PRCFLG
	     , #{LOGSEQNO}
	     , (
	       CASE WHEN TH.TASOTY IN ('399') AND TH.STATDO IN ('FSH', 'PSH') THEN '702'
	       		WHEN TH.TASOTY IN ('399') AND TH.STATDO IN ('SCN') THEN '701'
	            WHEN TH.TASOTY IN ('361') AND TH.STATDO IN ('FSH', 'PSH') AND TI.LOTA06 IN('10','30', '50') THEN '555'
	            WHEN TH.TASOTY IN ('361') AND TH.STATDO IN ('SCN') AND TI.LOTA06 IN('10','30', '50') THEN  '556'
	            WHEN TH.TASOTY IN ('361') AND TH.STATDO IN ('FSH', 'PSH') AND TI.LOTA06 IN('00','05') THEN '551'
	            WHEN TH.TASOTY IN ('361') AND TH.STATDO IN ('SCN') AND TI.LOTA06 IN('00','05') THEN '552'
	            WHEN TH.TASOTY IN ('356') AND TH.STATDO IN ('FSH', 'PSH') THEN '311'
	            WHEN TH.TASOTY IN ('356') AND TH.STATDO IN ('SCN') THEN '312'
	            ELSE TH.TASOTY 
	       END
	       ) --BWARTSAP
	     , TR.STOKKY
	     , TI.LOTNUM  
	     , CASE WHEN TI.QTTAOR != TI.QTCOMP AND TI.STATIT IN('FSH', 'PSH') THEN 'X'
	            ELSE ' '
	       END
	     , TI.QTCOMP  
	  	, NVL(TRIM(RM.PTNRKY), ' ')
	  	, NVL(TRIM(RM.CONTNO), ' ')
	  	, NVL(TRIM(RM.BARCNO), ' ')
	  	, NVL(TRIM(RM.ZFBLNO), ' ')
	  	, NVL(TRIM(RM.ROLLID), ' ')
	  	, NVL(TRIM(RM.MRGSM), 0)		
		, NVL(TRIM(RM.LENGTH), 0)
	  	, NVL(TRIM(RM.NETWT), 0)
	  	, NVL(TRIM(RM.WGTMUL), 0)
	  	, NVL(TRIM(RM.COREDI), 0)
	  	, NVL(TRIM(RM.KUNIT), ' ')
	  	, NVL(TRIM(RM.CPCOD), ' ')	  	
		, NVL(TRIM(RM.TBRGEW), 0)
	  	, NVL(TRIM(RM.RBRGEW), 0)
	  	, NVL(TRIM(RM.LUNIT), ' ')
	  	, NVL(TRIM(RM.DESCRI), ' ')
	  	, NVL(TRIM(RM.WEIGHT), 0)
	  	, NVL(TRIM(RM.RMK1), ' ')
	  	, NVL(TRIM(RM.RMK2), ' ')
	  	, NVL(TRIM(RM.RMK3), ' ')
	  	, NVL(TRIM(RM.RMK4), ' ')
	  	, NVL(TRIM(RM.RMK5), ' ')
		, CASE WHEN TI.STATIT IN ('FSH', 'PSH') THEN 'A'
		  ELSE 'D'
		  END STATUS
		, SUBSTR(ST.SSORNU,0,10)
		, NVL(RH.DOCDAT, TH.DOCDAT)  
		, #{menuId}
		, #{SES_USER_ID}
		, CASE WHEN #{IFID} IN ('WMS_IF_310') THEN TI.TASKKY ELSE ' ' END
		, CASE WHEN #{IFID} IN ('WMS_IF_310') THEN TI.TASKIT ELSE ' ' END
	  FROM TASDI TI
	       INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
	       INNER JOIN TASDR TR ON TR.TASKKY = TI.TASKKY AND TR.TASKIT = TI.TASKIT
           INNER JOIN STKKY ST ON TR.STOKKY = ST.STOKKY 
           LEFT OUTER JOIN LOTAT LT ON ST.LOTNUM= LT.LOTNUM
           LEFT OUTER JOIN ROLLMA RM ON LT.LOTA14 = RM.BARCNO AND RM.PRCFLG = 'C' 
                                   <!--  AND LT.LOTA41 = RM.CONTNO 수입밀롤입고 컨테이너번호로 인해 전송 안됨 -->
		   LEFT OUTER JOIN STKKY ST ON ST.STOKKY = TR.STOKKY 
		   LEFT OUTER JOIN RECDH RH ON ST.RECVKY = RH.RECVKY                                    
	 WHERE TI.TASKKY IN (${RECVKYIN})
</insert>
<!-- IFWMS213 출고실적정보 등록 SD07 SAP만재고조정 -->
<insert id="IFWMS213_SD_INSERT" parameterType="Map">
	INSERT INTO IFWMS213
	     (
	       MANDT
	     , SEQNO
	     , VBELN
	     , POSNR	     
	     , BWART
	     , WADAT
	     , KUNAG
	     , WERKS
	     , MATNR
	     , MEINS
	     , ZDOC_NO
		 , ZDOC_ITEM
	     , WAREKY
	     , SKUKEY
	     , ZQTSACT
	     , ORDCAT
	     , PTNRTY
	     , QTSHP
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05
	     , LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , BWARTSAP      
		 , RMK1         
		 , STATUS   
		 , DOCDAT
		 , UI
		 , REMARK
		 , C00103, C00104, C00105
	     )
	VALUES ('SAP'
	     , SEQ_IFWMS213.NEXTVAL 
	     , ${RECVKYIN} 
	     , '0' 
	     , '399' 
	     , ${DOCDAT} 
	    -- , TO_CHAR(SYSDATE, 'YYYYMMDD')
	     , NVL(#{PTNRKY}, '0') 
	     , #{OWNRKY}
	     , #{SKUKEY}
	     , #{UOMKEY}
	     , ${RECVKYIN}
	     , NVL(#{PTNRKY}, '0') 
	     , #{WAREKY}
	     , #{SKUKEY}
	     , ABS(#{QTTAOR}) 
	     , NVL(#{DOCCAT}, '300')
	     , 'CT'  
	     , ABS(#{QTTAOR}) 
	     , NVL(#{LOTA01},' '), NVL(#{LOTA02},' '), NVL(#{LOTA03},' ') ,NVL(#{LOTA04},' '), NVL(#{LOTA05},' ')
	     , NVL(#{LOTA06},' '), NVL(#{LOTA07},' '), NVL(#{LOTA08},' '), NVL(#{LOTA09},' '), NVL(#{LOTA10},' ')
	     , NVL(#{LOTA11},' '), NVL(#{LOTA12},' '), NVL(#{LOTA13},' '), NVL(#{LOTA14},' '), NVL(#{LOTA15},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID}
	     , 'N' 
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'I' 
	     , #{LOGSEQNO}
	     , '702'
	  	 , 'SAP만 재고조정'
		 , 'A'
		 , TO_CHAR(SYSDATE, 'YYYYMMDD')
		 ,'SD07' 
		 , #{REMARK}      
		 , NVL(#{KDAUF},''), NVL(#{KDPOS},''), NVL(#{SOBKZ},'')        
	)
</insert>
<!-- IFWMS203 입고실적정보 등록 SD07 SAP만재고조정 -->
<insert id="IFWMS203_SD_INSERT" parameterType="Map">
	 INSERT INTO IFWMS203
	     (
	       MANDT
	     , SEQNO
	     , BWART
	     , MATNR
	     , MEINS
	     , WERKS
	     , EINDT
	     , STATUS
	     , WAREKY
	     , SKUKEY
	     , ZDOC_NO 
	     , QTYRCV  
	     , ORDCAT  
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05
         , LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , ITFFLG, ITFDAT, ITFTIM  
	     , PRCFLG  
	     , LOGSEQNO 
	     , BWARTSAP   
	     , ZDFF 
         , PIKSUM 
         , GR_CHR_ID
         , UI
         , REMARK
         , C00103, C00104, C00105
	     )
   VALUES(
          'SAP'
         , SEQ_IFWMS203.NEXTVAL
         , '199'
         , #{SKUKEY}
         , #{UOMKEY}
         , #{OWNRKY}
         , TO_CHAR(SYSDATE, 'YYYYMMDD')
         , 'C'
         , #{WAREKY}
         , #{SKUKEY}
         , #{RECVKY}
         , ABS(#{QTTAOR})
         , NVL('100',' ') 
         , NVL(#{LOTA01},' '), NVL(#{LOTA02},' '), NVL(#{LOTA03},' ') ,NVL(#{LOTA04},' '), NVL(#{LOTA05},' ')
         , NVL(#{LOTA06},' '), NVL(#{LOTA07},' '), NVL(#{LOTA08},' '), NVL(#{LOTA09},' '), NVL(#{LOTA10},' ')
         , NVL(#{LOTA11},' '), NVL(#{LOTA12},' '), NVL(#{LOTA13},' '), NVL(#{LOTA14},' '), NVL(#{LOTA15},' ')
         , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
         , #{IFID}
         , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
         , 'I' 
         , #{LOGSEQNO}
         , '701'  
         , 'X'
         , ABS(#{QTTAOR})
         , 'SAP만 재고조정' 
         ,'SD07' 
         , #{REMARK}
         , NVL(#{KDAUF},''), NVL(#{KDPOS},''), NVL(#{SOBKZ},'')   
         )
</insert>

<!-- IFWMS213 PAL 팔레트출고실적 등록 -->
<insert id="IFWMS213_PAL_INSERT" parameterType="Map">
	INSERT INTO IFWMS213
	     (
	       MANDT
	     , SEQNO
	     , VBELN
	     , POSNR
	     , WERKS
	     , MATNR
	     , MEINS
	     , SKUKEY
	     , ZQTSACT
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , STATUS	     
	     , STKNUM	     
	     , REMARK	-- 차량번호로 사용
	     , RMK1		-- 차량톤수	     
	     , RMK2		-- 차량구분	     
	     , RMK3		-- 기사명	     
	     , RMK4		-- 연락처	     
	     , RMK5		-- 운송업체	     
	     )
	     
		SELECT 'SAP'
		     , SEQ_IFWMS213.NEXTVAL   AS SEQNO
		     , NVL(TRIM(#{SVBELN}), ' ')
		     , NVL(TRIM(#{SHPOIT}), ' ')
		     , NVL(TRIM(#{OWNRKY}), ' ')
		     , NVL(TRIM(#{SKUKEY}), ' ')		     
   		     , NVL(TRIM(#{DUOMKY}), ' ')		    
		     , NVL(TRIM(#{SKUKEY}), ' ')		       
		     , NVL(TRIM(#{QTSHPD}), 0) 		    
		     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') AS CDATE, TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, NVL(TRIM(#{SES_USER_ID}),#{IFID}) AS CREUSR		     
		     , #{IFID} AS IFID
		     , 'N' AS IFFLG
		     , 'I' AS ITFFLG, TO_CHAR(SYSDATE, 'YYYYMMDD') AS ITFDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS ITFTIM
		     , 'I' AS PRCFLG
		     , #{LOGSEQNO} AS LOGSEQNO		    
		     , #{STATE} AS STATUS
		     , NVL(TRIM(#{STKNUM}), ' ')		
		     , NVL(TRIM(#{CARNO}), ' ')		
		     , NVL(TRIM(#{CARTON}), ' ')		
		     , NVL(TRIM(#{CARART}), ' ')		
		     , NVL(TRIM(#{DRIVER}), ' ')		
		     , NVL(TRIM(#{DRIVERCEL}), ' ')		
		     , NVL(TRIM(#{TDLNR}), ' ')		
		  FROM DUAL	                        	
</insert>

<!-- IFWMS213 출고실적 전송대상 검색 -->
<select id="IFWMS213_LIST" parameterType="Map" resultType="DataMap">
	SELECT MANDT
	     , SEQNO
	     , VBELN
	     , POSNR
	     , BWART
	     , WADAT
	     , KUNNR
	     , CASE WHEN #{IFID} IN ('WMS_IF_213', 'WMS_IF_309', 'WMS_IF_310', 'WMS_IF_317', 'WMS_IF_322', 'WMS_IF_324') THEN SUBSTR(KUNAG,5)
	            ELSE KUNAG
	       END AS KUNAG
	     , CASE WHEN #{IFID} IN ('WMS_IF_320', 'WMS_IF_309') THEN SUBSTR(KUNAG,1,4)	     
	            ELSE LOTA02
	       END AS PLTFR
	     , CASE WHEN #{IFID} IN ('WMS_IF_320', 'WMS_IF_309') THEN SUBSTR(KUNAG,5)
	            ELSE LOTA01
	       END AS LGORT
	     , WERKS
	     <!-- , CASE WHEN NVL(TRIM(LOTA07), ' ') = ' ' THEN MATNR 
	     	ELSE ' ' 
	     	END AS MATNR 
	     , CASE WHEN NVL(TRIM(LOTA07), ' ') != ' ' THEN MATNR 
	     	ELSE ' ' 
	     	END AS UMMAT -->
		 , MATNR
		 , MATNR AS UMMAT 
	     , MEINS
	     , VGBEL
	     , VGPOS
	     , WAREKY
	     , SKUKEY
	     , ZQTSACT
	     , ORDCAT
	     , PTNRTY
	     , QTSHP
	     , ESHPKY
	     , ESHPKY_ITEM
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , BWARTSAP
	     , ZDOC_NO
	     , ZDOC_ITEM
	     , PIKSUM
		 , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE 'E'
	       END AS SOBKZ
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 1, 10)
	       END AS KDAUF
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 11)
	       END AS KDPOS 
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 1, 10)
	       END AS MAT_KDAUF
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 11)
	       END AS MAT_KDPOS 
	     , STATUS 	
	     , STOKKY
	     , LOTNUM
	     , PTNRKY
		 , CONTNO
		 , BARCNO
		 , ZFBLNO
		 , ROLLID
		 , MRGSM
		 , LENGTH
		 , NETWT
		 , WGTMUL
		 , COREDI
		 , KUNIT
		 , CPCOD
		 , TBRGEW
		 , RBRGEW
		 , LUNIT
		 , DESCRI
		 , WEIGHT
		 , RMK1
		 , RMK2
		 , RMK3
		 , RMK4
		 , RMK5
		 , ZLGORT
		 , SIGNI
		 , EXTI2
		 , LFART
		 , SEBELN
		 , DOCDAT
		 , STKNUM 
		 , REMARK
		 , TRIM(C00103) AS C00103, TRIM(C00104) AS C00104, TRIM(C00105) AS C00105
	  FROM IFWMS213
	 WHERE PRCFLG != 'C'
	   AND LOGSEQNO = #{LOGSEQNO}
	 ORDER BY VBELN ASC, POSNR ASC
</select>

<!-- IFWMS213 출고실적 전송대상 검색 -->
<select id="IFWMS213_HEAD_LIST" parameterType="Map" resultType="DataMap">
	SELECT DISTINCT
	       VBELN
	     , WADAT
	     , KUNAG
	     , STATUS
	     , ZDOC_NO
	     , ZDOC_ITEM
	     , LOTA12
	     , PO_NO
	     , PO_REV
	     , CREUSR
	  FROM IFWMS213
	 WHERE PRCFLG != 'C'
	   AND LOGSEQNO = #{LOGSEQNO}
	 ORDER BY VBELN ASC
</select>

<!-- IFWMS213 출고실적 전송대상 검색 -->
<select id="IFWMS213_ITEM_LIST" parameterType="Map" resultType="DataMap">
	SELECT IFWMS213.VBELN
	     , IFWMS213.MATNR
	     , IFWMS213.MEINS
	     , IFWMS213.ZQTSACT
	     , IFWMS213.LOTA01
	     , IFWMS213.LOTA02
	     , IFWMS213.LOTA06
	     , IFWMS213.LOTA11
	     , IFWMS213.LOTA13
	     , IFWMS213.LOTA15
	     , IFWMS213.PO_LNO	
	     , IFWMS213.ZDOC_NO
	     , IFWMS213.ZDOC_ITEM    
	     , IFWMS213.PO_NO
	     , SKUMA.DESC01	
	     , IFWMS213.VBELN     
	  FROM IFWMS213 
	  LEFT OUTER JOIN SKUMA ON IFWMS213.WERKS = SKUMA.OWNRKY AND IFWMS213.MATNR = SKUMA.SKUKEY
	 WHERE IFWMS213.PRCFLG != 'C'
	   AND IFWMS213.LOGSEQNO = #{LOGSEQNO}
	 ORDER BY IFWMS213.VBELN ASC
</select>

<update id="IFWMS213_SHPDI_UPDATE" parameterType="Map">
	UPDATE SHPDI
	   SET SXBLNR = #{MBLNR}
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE SHPOKY = #{WMSDN}	   
</update>

<update id="IFWMS213_SHPDH_CARNO_UPDATE" parameterType="Map">
	UPDATE SHPDH
	   SET CARNO = #{CARNO}
	   	 , CARTON = (SELECT NVL(CDESC1, ' ') FROM CMCDV WHERE CMCDKY = 'TMS_CARCLASS' AND CMCDVL = #{CARTON})
	   	 , CARART = NVL(#{CARART}, ' ')
	   	 , DRIVER = NVL(#{DRIVER}, ' ')
	   	 , DRIVERCEL = NVL(#{DRIVERCEL}, ' ')
	   	 , TDLNR = NVL(#{TDLNR}, ' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE SHPOKY IN (SELECT SHPOKY FROM SHPDI WHERE STKNUM = #{STKNUM}) 
</update>

<update id="IFWMS213_SHPDH_UPDATE" parameterType="Map">
	UPDATE SHPDH
	   SET INDDCL = ' '
	     , LSHPCD = ' '
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE SHPOKY = #{WMSDN}	   
</update>

<update id="IFWMS213_TASDI_UPDATE" parameterType="Map">
	UPDATE TASDI
	   SET SXBLNR = #{MBLNR}
	   	 , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE TASKKY = #{WMSDN}
	 	  
</update>

<update id="IFWMS213_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS213
	   SET MBLNR  = NVL(TRIM(#{MBLNR}), MBLNR)
	   	 , ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = '[' || NVL(#{PRCFLG},' ') || ']' || NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE PRCFLG IN ('I','N','E')
	   AND LOGSEQNO = #{LOGSEQNO}
</update>

<update id="IFWMS213multi_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS213
	   SET MBLNR  = NVL(TRIM(#{MBLNR}), MBLNR)
	   	 , ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = '[' || NVL(#{PRCFLG},' ') || ']' || NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , REMARK = NVL(TRIM(#{REMARK}), ' ')
	 WHERE PRCFLG IN ('I','N','E')
	   AND ZDOC_NO = #{WMSDN}
	   AND LOGSEQNO = #{LOGSEQNO}
</update>

<!-- IFWMS223 재고조정 -->
<insert id="IFWMS223_INSERT" parameterType="Map">
	INSERT INTO IFWMS223 (
	       MANDT
	     , SEQNO
	     , SADJKY
	     , SADJIT
	     , ORDCAT
	     , BWART
	     , WERKS
	     , MATNR
	     , QTADJU
	     , TMATNR
	     , MEINS
	     , VGBEL
	     , VGPOS
	     , STATUS
	     , WAREKY
	     , ZDOC_NO
	     , ZDOC_ITEM
	     ,  LOTA01,  LOTA02,  LOTA03,  LOTA04,  LOTA05
	     ,  LOTA06,  LOTA07,  LOTA08,  LOTA09,  LOTA10
	     ,  LOTA11,  LOTA12,  LOTA13,  LOTA14,  LOTA15
	     ,  LOTA16,  LOTA17,  LOTA18,  LOTA19,  LOTA20
	     , TLOTA01, TLOTA02, TLOTA03, TLOTA04, TLOTA05
	     , TLOTA06, TLOTA07, TLOTA08, TLOTA09, TLOTA10
	     , TLOTA11, TLOTA12, TLOTA13, TLOTA14, TLOTA15
	     , TLOTA16, TLOTA17, TLOTA18, TLOTA19, TLOTA20
	     , CDATE
	     , CREDAT
	     , CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , BWARTSAP
	     , UI
	)
	SELECT
	       NVL(#{MANDT},'100')  AS MANDT
	     , SEQ_IFWMS223.NEXTVAL AS SEQNO
	     , NVL(#{SADJKY},' ')   AS SADJKY
	     , NVL(#{SADJIT},' ')   AS SADJIT
	     , NVL(#{ORDCAT},' ')   AS ORDCAT
	     , NVL(#{BWART},' ')    AS BWART
	     , 'KN'                 AS WERKS
	     , NVL(#{MATNR},' ')    AS MATNR
	     , NVL(#{QTADJU},' ')   AS QTADJU
	     , NVL(#{TMATNR},' ')   AS TMATNR
	     , NVL(#{MEINS},' ')    AS MEINS
	     , ' '                  AS VGBEL
	     , ' '                  AS VGPOS
	     , 'C'                  AS STATUS
	     , NVL(#{WAREKY},' ')   AS WAREKY
	     , NVL(#{SADJKY},' ')   AS ZDOC_NO
	     , NVL(#{SADJIT},' ')   AS ZDOC_ITEM
	     , NVL(#{ LOTA01},' ') AS  LOTA01, NVL(#{ LOTA02},' ') AS  LOTA02, NVL(#{ LOTA03},' ') AS  LOTA03, NVL(#{ LOTA04},' ') AS  LOTA04, NVL(#{ LOTA05},' ') AS  LOTA05
	     , NVL(#{ LOTA06},' ') AS  LOTA06, NVL(#{ LOTA07},' ') AS  LOTA07, NVL(#{ LOTA08},' ') AS  LOTA08, NVL(#{ LOTA09},' ') AS  LOTA09, NVL(#{ LOTA10},' ') AS  LOTA10
	     , NVL(#{ LOTA11},' ') AS  LOTA11, NVL(#{ LOTA12},' ') AS  LOTA12, NVL(#{ LOTA13},' ') AS  LOTA13, NVL(#{ LOTA14},' ') AS  LOTA14, NVL(#{ LOTA15},' ') AS  LOTA15
	     , NVL(#{ LOTA16}, 0 ) AS  LOTA16, NVL(#{ LOTA17},' ') AS  LOTA17, NVL(#{ LOTA18}, 0 ) AS  LOTA18, NVL(#{ LOTA19}, 0 ) AS  LOTA19, NVL(#{ LOTA20}, 0 ) AS  LOTA20
	     , NVL(#{TLOTA01},' ') AS TLOTA01, NVL(#{TLOTA02},' ') AS TLOTA02, NVL(#{TLOTA03},' ') AS TLOTA03, NVL(#{TLOTA04},' ') AS TLOTA04, NVL(#{TLOTA05},' ') AS TLOTA05
	     , NVL(#{TLOTA06},' ') AS TLOTA06, NVL(#{TLOTA07},' ') AS TLOTA07, NVL(#{TLOTA08},' ') AS TLOTA08, NVL(#{TLOTA09},' ') AS TLOTA09, NVL(#{TLOTA10},' ') AS TLOTA10
	     , NVL(#{TLOTA11},' ') AS TLOTA11, NVL(#{TLOTA12},' ') AS TLOTA12, NVL(#{TLOTA13},' ') AS TLOTA13, NVL(#{TLOTA14},' ') AS TLOTA14, NVL(#{TLOTA15},' ') AS TLOTA15
	     , NVL(#{TLOTA16}, 0 ) AS TLOTA16, NVL(#{TLOTA17},' ') AS TLOTA17, NVL(#{TLOTA18}, 0 ) AS TLOTA18, NVL(#{TLOTA19}, 0 ) AS TLOTA19, NVL(#{TLOTA20}, 0 ) AS TLOTA20
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS')
     	<choose>
		    <when test='BWART == "402" or BWART == "401"'> 
		  		, NVL(#{DOCDAT}, TO_CHAR(SYSDATE, 'YYYYMMDD'))
		  	</when>
			<otherwise>
	     		, TO_CHAR(SYSDATE, 'YYYYMMDD')
			</otherwise>
		  </choose>
	     , TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID} AS IFID
	     , 'N' AS IFFLG
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'I' AS PRCFLG
	     , #{LOGSEQNO}     AS LOGSEQNO
	     , #{BWARTSAP}     AS BWARTSAP
	     , NVL(#{UI}, ' ') AS UI
	FROM DUAL
</insert>

<insert id="IFWMS223_MULTI_INSERT" parameterType="Map">
	INSERT INTO IFWMS223
	     (
	       MANDT
	     , SEQNO
	     , SADJKY
	     , SADJIT
	     , ORDCAT
	     , BWART
	     , WERKS
	     , MATNR
	     , QTADJU
	     , TMATNR
	     , MEINS
	     , VGBEL
	     , VGPOS
	     , WAREKY
	     , ZDOC_NO
	     , ZDOC_ITEM
	     ,  LOTA01,  LOTA02,  LOTA03,  LOTA04,  LOTA05
	     ,  LOTA06,  LOTA07,  LOTA08,  LOTA09,  LOTA10
	     ,  LOTA11,  LOTA12,  LOTA13,  LOTA14,  LOTA15
	     ,  LOTA16,  LOTA17,  LOTA18,  LOTA19,  LOTA20
	     , TLOTA01, TLOTA02, TLOTA03, TLOTA04, TLOTA05
	     , TLOTA06, TLOTA07, TLOTA08, TLOTA09, TLOTA10
	     , TLOTA11, TLOTA12, TLOTA13, TLOTA14, TLOTA15
	     , TLOTA16, TLOTA17, TLOTA18, TLOTA19, TLOTA20
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , UI
	     )
		<foreach item="i" index="index" collection="list" open=" " separator=" UNION ALL " close="">
	SELECT
	       NVL(#{MANDT, jdbcType=VARCHAR},'100')
	     , F_GET_SEQ_MULTICASE('IFWMS223')
	     , NVL(#{i.SADJKY, jdbcType=VARCHAR},' ') AS SADJKY
	     , NVL(#{i.SADJIT, jdbcType=VARCHAR},' ') AS SADJIT
	     , NVL(#{i.ORDCAT, jdbcType=VARCHAR},' ') AS ORDCAT
	     , NVL(#{i.BWART , jdbcType=VARCHAR},' ') AS BWART
	     , 'KN'
	     , NVL(#{i.MATNR , jdbcType=VARCHAR},' ') AS MATNR 
	     , NVL(#{i.QTADJU, jdbcType=VARCHAR},' ') AS QTADJU
	     , NVL(#{i.TMATNR, jdbcType=VARCHAR},' ') AS TMATNR
	     , NVL(#{i.MEINS , jdbcType=VARCHAR},' ') AS MEINS 
	     , ' '                                    AS VGBEL
	     , ' '                                    AS VGPOS
	     , NVL(#{i.WAREKY, jdbcType=VARCHAR},' ') AS WAREKY
	     , NVL(#{i.SADJKY, jdbcType=VARCHAR},' ') AS SADJKY
	     , NVL(#{i.SADJIT, jdbcType=VARCHAR},' ') AS SADJIT
	     , NVL(#{i. LOTA01, jdbcType=VARCHAR},' ') AS  LOTA01, NVL(#{i. LOTA02, jdbcType=VARCHAR},' ') AS  LOTA02, NVL(#{i. LOTA03, jdbcType=VARCHAR},' ') AS  LOTA03, NVL(#{i. LOTA04, jdbcType=VARCHAR},' ') AS  LOTA04, NVL(#{i. LOTA05, jdbcType=VARCHAR},' ') AS  LOTA05
	     , NVL(#{i. LOTA06, jdbcType=VARCHAR},' ') AS  LOTA06, NVL(#{i. LOTA07, jdbcType=VARCHAR},' ') AS  LOTA07, NVL(#{i. LOTA08, jdbcType=VARCHAR},' ') AS  LOTA08, NVL(#{i. LOTA09, jdbcType=VARCHAR},' ') AS  LOTA09, NVL(#{i. LOTA10, jdbcType=VARCHAR},' ') AS  LOTA10
	     , NVL(#{i. LOTA11, jdbcType=VARCHAR},' ') AS  LOTA11, NVL(#{i. LOTA12, jdbcType=VARCHAR},' ') AS  LOTA12, NVL(#{i. LOTA13, jdbcType=VARCHAR},' ') AS  LOTA13, NVL(#{i. LOTA14, jdbcType=VARCHAR},' ') AS  LOTA14, NVL(#{i. LOTA15, jdbcType=VARCHAR},' ') AS  LOTA15
	     , NVL(#{i. LOTA16, jdbcType=VARCHAR}, 0 ) AS  LOTA16, NVL(#{i. LOTA17, jdbcType=VARCHAR},' ') AS  LOTA17, NVL(#{i. LOTA18, jdbcType=VARCHAR}, 0 ) AS  LOTA18, NVL(#{i. LOTA19, jdbcType=VARCHAR}, 0 ) AS  LOTA19, NVL(#{i. LOTA20, jdbcType=VARCHAR}, 0 ) AS  LOTA20
	     , NVL(#{i.TLOTA01, jdbcType=VARCHAR},' ') AS TLOTA01, NVL(#{i.TLOTA02, jdbcType=VARCHAR},' ') AS TLOTA02, NVL(#{i.TLOTA03, jdbcType=VARCHAR},' ') AS TLOTA03, NVL(#{i.TLOTA04, jdbcType=VARCHAR},' ') AS TLOTA04, NVL(#{i.TLOTA05, jdbcType=VARCHAR},' ') AS TLOTA05
	     , NVL(#{i.TLOTA06, jdbcType=VARCHAR},' ') AS TLOTA06, NVL(#{i.TLOTA07, jdbcType=VARCHAR},' ') AS TLOTA07, NVL(#{i.TLOTA08, jdbcType=VARCHAR},' ') AS TLOTA08, NVL(#{i.TLOTA09, jdbcType=VARCHAR},' ') AS TLOTA09, NVL(#{i.TLOTA10, jdbcType=VARCHAR},' ') AS TLOTA10
	     , NVL(#{i.TLOTA11, jdbcType=VARCHAR},' ') AS TLOTA11, NVL(#{i.TLOTA12, jdbcType=VARCHAR},' ') AS TLOTA12, NVL(#{i.TLOTA13, jdbcType=VARCHAR},' ') AS TLOTA13, NVL(#{i.TLOTA14, jdbcType=VARCHAR},' ') AS TLOTA14, NVL(#{i.TLOTA15, jdbcType=VARCHAR},' ') AS TLOTA15
	     , NVL(#{i.TLOTA16, jdbcType=VARCHAR}, 0 ) AS TLOTA16, NVL(#{i.TLOTA17, jdbcType=VARCHAR},' ') AS TLOTA17, NVL(#{i.TLOTA18, jdbcType=VARCHAR}, 0 ) AS TLOTA18, NVL(#{i.TLOTA19, jdbcType=VARCHAR}, 0 ) AS TLOTA19, NVL(#{i.TLOTA20, jdbcType=VARCHAR}, 0 ) AS TLOTA20
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{i.SES_USER_ID, jdbcType=VARCHAR}),#{i.IFID, jdbcType=VARCHAR})
	     , #{i.IFID, jdbcType=VARCHAR}
	     , 'N' --IFFLG
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'I' --PRCFLG
	     , #{i.LOGSEQNO, jdbcType=VARCHAR}
	     , NVL(#{i.UI, jdbcType=VARCHAR}, ' ') AS UI
	  FROM DUAL
		</foreach>
</insert>

<!-- IFWMS223 재고조정실적 전송대상 검색 -->
<select id="IFWMS223_LIST" parameterType="Map" resultType="DataMap">
	SELECT MANDT
	     , SEQNO
	     , SADJKY
	     , SADJIT
	     , ORDCAT
	     , BWART
	     , PSTYV
	     , WERKS
	     , QTADJU
	     , MEINS
	     , VGBEL
	     , VGPOS
	     , STATUS
	     , TDATE
	     , CDATE
	     , IFFLG
	     , ERTXT
	     , WAREKY
	     , ZDOC_NO
	     , ZDOC_ITEM
	     /* 2022.06.24 
	        SAP 안이사님이 이동유형이 322, 344, 350인 경우 취소건 개념이라고
	        FROM, TO 반대로 보내줘야 한다고 함.
	     */
	     , CASE WHEN BWARTSAP IN ('322', '324', '326', '344', '350') THEN TMATNR  ELSE   MATNR END AS   MATNR
	     , CASE WHEN BWARTSAP IN ('322', '324', '326', '344', '350') THEN MATNR   ELSE  TMATNR END AS  TMATNR
	     , CASE WHEN BWARTSAP IN ('322', '324', '326', '344', '350') THEN TLOTA01 ELSE  LOTA01 END AS  LOTA01
	     , CASE WHEN BWARTSAP IN ('322', '324', '326', '344', '350') THEN TLOTA02 ELSE  LOTA02 END AS  LOTA02
	     , CASE WHEN BWARTSAP IN ('322', '324', '326', '344', '350') THEN TLOTA15 ELSE  LOTA15 END AS  LOTA15
	     , CASE WHEN BWARTSAP IN ('322', '324', '326', '344', '350') THEN LOTA01  ELSE TLOTA01 END AS TLOTA01
	     , CASE WHEN BWARTSAP IN ('322', '324', '326', '344', '350') THEN LOTA02  ELSE TLOTA02 END AS TLOTA02
	     , CASE WHEN BWARTSAP IN ('322', '324', '326', '344', '350') THEN LOTA15  ELSE TLOTA15 END AS TLOTA15
	                       ,  LOTA03,  LOTA04,  LOTA05
	     ,  LOTA06,  LOTA07,  LOTA08,  LOTA09,  LOTA10
	     ,  LOTA11,  LOTA12,  LOTA13,  LOTA14
	     ,  LOTA16,  LOTA17,  LOTA18,  LOTA19,  LOTA20
	                       , TLOTA03, TLOTA04, TLOTA05
	     , TLOTA06, TLOTA07, TLOTA08, TLOTA09, TLOTA10
	     , TLOTA11, TLOTA12, TLOTA13, TLOTA14
	     , TLOTA16, TLOTA17, TLOTA18, TLOTA19, TLOTA20
	     , BWARTSAP
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE 'E'
	       END AS SOBKZ
	     , CASE WHEN ' ' = NVL(TRIM(TLOTA07), ' ') THEN NULL
	            ELSE SUBSTR(TLOTA07, 1, 10)
	       END AS KDAUF
	     , CASE WHEN ' ' = NVL(TRIM(TLOTA07), ' ') THEN NULL
	            ELSE SUBSTR(TLOTA07, 11)
	       END AS KDPOS
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 1, 10)
	       END AS MAT_KDAUF
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 11)
	       END AS MAT_KDPOS
	     , CREDAT
	  FROM IFWMS223 
	 WHERE PRCFLG != 'C'
	   AND LOGSEQNO = #{LOGSEQNO}
	 ORDER BY SEQNO ASC --SADJKY ASC, SADJIT ASC
</select>

<update id="IFWMS223_ADJDI_UPDATE" parameterType="Map">
	UPDATE ADJDI
	   SET SXBLNR = #{MBLNR}
	 WHERE SADJKY = #{WMSDN}
	   AND SAPSTS = #{BWART}
</update>

<update id="IFWMS223_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS223
	   SET MBLNR  = NVL(#{MBLNR},' ')
	     , ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = '[' || NVL(#{PRCFLG},' ') || ']' || NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE PRCFLG IN ('I', ' ', 'E')
	   AND BWARTSAP = #{BWART}
	   AND LOGSEQNO = #{IF_KEY}
</update>

<!-- 240126 IFWMS223_수동 업데이트  -->
<update id="IFWMS223_FLG_NEW_UPDATE" parameterType="Map">
	UPDATE IFWMS223
	   SET 
	       ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = '[' || NVL(#{PRCFLG},' ') || ']' || NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE PRCFLG IN ('I', ' ')
	   <!-- AND BWARTSAP = #{BWART} -->
