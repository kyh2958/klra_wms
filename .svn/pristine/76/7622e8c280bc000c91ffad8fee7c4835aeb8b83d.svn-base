	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS103
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND IFID = A.IFID
	                                                          )
	                                         )
	            WHEN IFTBL = 'IFWMS108' THEN (SELECT COUNT(SEQNO) FROM IFWMS108 WHERE PRCFLG = 'C' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS108 ))
	            WHEN IFTBL = 'IFWMS109' THEN (SELECT COUNT(SEQNO) FROM IFWMS109 
