<?xml version="1.0" encoding="UTF-8"?><!--Converted at: Wed Feb 23 09:49:03 KST 2022-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Erpif">

<!-- IFWMSLOG 통신로그 -->
<select id="IFWMSLOGSEQNO_MAP" parameterType="Map" resultType="DataMap">
	SELECT 'W' || LTRIM(RTRIM(TO_CHAR(SEQ_IFCOMMLOG.NEXTVAL, '00000000000000000000000000000'))) AS LOGSEQNO FROM DUAL
</select>

<insert id="IFWMSLOG_INSERT" parameterType="Map">
	<selectKey resultType="string" keyProperty="SEQNO" order="BEFORE">
		SELECT 'W' || LTRIM(RTRIM(TO_CHAR(SEQ_IFCOMMLOG.NEXTVAL, '00000000000000000000000000000'))) FROM DUAL
	</selectKey>
	INSERT INTO IFWMSLOG
	     ( SEQNO
	     , IFID
	     , COMSTAT
	     , CREDAT
	     , CRETIM
	     , CDATE
	     , CREUSR
	     , REMARK
	     )
	SELECT #{SEQNO}
	     , #{IFID}
	     , NVL(#{COMSTAT},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDD')
	     , TO_CHAR(SYSDATE, 'HH24MISS')
	     , SYSDATE
	     , NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{REMARK}
	  FROM DUAL
</insert>

<insert id="IFWMSLOG_RESULT_INSERT" parameterType="Map">
	INSERT INTO IFWMSLOG
	     ( SEQNO
	     , IFID
	     , COMSTAT
	     , CREDAT
	     , CRETIM
	     , CDATE
	     , CREUSR
	     , REMARK
	     )
	SELECT #{SEQNO}
	     , #{IFID}
	     , NVL(#{COMSTAT},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDD')
	     , TO_CHAR(SYSDATE, 'HH24MISS')
	     , SYSDATE
	     , NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{REMARK}
	  FROM DUAL
</insert>

<update id="IFWMSLOG_RESULT_UPDATE" parameterType="Map">
	UPDATE IFWMSLOG
	   SET COMSTAT = #{COMSTAT}
	 WHERE SEQNO = #{SEQNO}
	   AND IFID  = #{IFID}
</update>

<update id="IFWMSLOG_UPDATE" parameterType="Map">
	UPDATE IFWMSLOG
	   SET COMSTAT = NVL(#{COMSTAT},' ')
	     , ERRTXT  = SUBSTR(NVL(#{ERRTXT},' '),1,200)
	     , REMARK = NVL(#{REMARK},' ')
	 WHERE SEQNO = #{SEQNO}
</update>

<update id="IFWMSLOG_INERR_UPDATE" parameterType="Map">
	UPDATE IFWMSLOG
	   SET INERRAT  = 'E'
	     , INERRTXT = SUBSTR(NVL(#{ERRTXT},' '),1,200)
	 WHERE SEQNO = #{SEQNO}
</update>

<select id="IFWMSLOG_LIST" parameterType="Map" resultType="DataMap">
	SELECT SEQNO
	     , IFID
	     , (SELECT IFKNM FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') AS IFKNM
	     , (SELECT IFTBL FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') AS IFTBL
	     , (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') AS BWART
	     , (SELECT LISTAGG(NVL(X, ''' '''), ',') WITHIN GROUP(ORDER BY X ASC) FROM
	           (SELECT DOCUTY||' '||SHORTX AS X FROM DOCTM WHERE DOCUTY IN 
	               (SELECT REGEXP_SUBSTR (B.BWART,'[^,]+',1,LEVEL) VALUE FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID) B
	                CONNECT BY LEVEL &lt;= LENGTH ( B.BWART ) - LENGTH ( REPLACE ( B.BWART, ',' ) ) + 1
	               )
	           )
	       ) AS BWARTNM
	     , COMSTAT
	     , (SELECT CMCDVL || ' ' || CDESC1 FROM CMCDV WHERE CMCDKY = 'COMSTAT' AND CMCDVL = A.COMSTAT) AS COMSTATNM
	     , ERRTXT
	     , INERRAT
	     , INERRTXT
	     , CREDAT
	     , CRETIM
	     , CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , REMARK
	     , (SELECT SYSFR FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') AS SYSFR
	     , (SELECT SYSTO FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') AS SYSTO
	  FROM IFWMSLOG A
	 WHERE 1=1
	 <if test="RANGE_SQL != null and RANGE_SQL != ' '.toString() and RANGE_SQL != ''.toString()">
		${RANGE_SQL}
	 </if>
	 ORDER BY SEQNO DESC
</select>

<select id="IFWMSLOGDETAIL_LIST" parameterType="Map" resultType="DataMap">
	SELECT *
	  FROM ${IFTBL}
<!-- 	 WHERE LOGSEQNO = #{LOGSEQNO} -->
	 WHERE LOGSEQNO IN (#{LOGSEQNO}, (SELECT SUBSTR(REMARK,10,30) FROM IFWMSLOG WHERE SEQNO = #{LOGSEQNO} AND ROWNUM = 1))
	 ORDER BY SEQNO DESC
</select>

<select id="IFSAPLOG_LIST" parameterType="Map" resultType="DataMap">
	SELECT SEQNO
	     , UI AS MENUID
	     , (SELECT MENUNAME FROM MSTMENU WHERE COMPID = 'KN' AND MENUID = A.UI) AS MENUNAME
	     , ZDOCNO
	     , ERRTXT
	     , WAREKY
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM 
	  FROM IFSAPLOG A
	 WHERE 1=1
	 <if test="RANGE_SQL != null and RANGE_SQL != ' '.toString() and RANGE_SQL != ''.toString()">
		${RANGE_SQL}
	 </if>
	 ORDER BY SEQNO DESC
</select>

<!-- 인터페이스 COMBO -->
<select id="IFCOMBO_LIST" parameterType="Map" resultType="DataMap">
	SELECT IFID AS VALUE_COL
	     , IFKNM AS TEXT_COL
	  FROM ITFMA
	 WHERE DELMAK != 'V'
	 ORDER BY SEQNO
</select>
<select id="IFTABLE_LIST" parameterType="Map" resultType="DataMap">
	SELECT CDESC1 AS VALUE_COL
	     , CDESC2 AS TEXT_COL
	  FROM CMCDV
	 WHERE CMCDKY = 'IFTABLE'
	 ORDER BY CMCDVL
</select>
<select id="IFSYSFR_LIST" parameterType="Map" resultType="DataMap">
	SELECT DISTINCT
	       SYSFR AS VALUE_COL
	     , SYSFR AS TEXT_COL
	  FROM ITFMA
	 WHERE DELMAK != 'V'
	 ORDER BY SYSFR
</select>
<select id="IFSYSTO_LIST" parameterType="Map" resultType="DataMap">
	SELECT DISTINCT
	       SYSTO AS VALUE_COL
	     , SYSTO AS TEXT_COL
	  FROM ITFMA
	 WHERE DELMAK != 'V'
	 ORDER BY SYSTO
</select>

<!-- RFC INFO -->
<select id="RFCINFO_MAP" parameterType="Map" resultType="DataMap">
	SELECT RFCFN
	     , RFCTBL
	     , RFCP1
	     , RFCP2
	  FROM ITFMA
	 WHERE IFID = #{IFID}
	   AND DELMAK != 'V'
</select>

<!-- 인터페이스 배치목록 : 우선순위순 -->
<select id="IF_LIST" parameterType="Map" resultType="DataMap">
	SELECT IFTY, IFID, IFENM, IFKNM, SYSFR, SYSTO, IFTBL, BWART, IFSTAT, POLLTY, POLLTM, PRORTY
	     , RFCFN, RFCTBL, RFCP1, RFCP2, COMTYP
	  FROM ITFMA A
	 WHERE DELMAK != 'V'
	   AND IFID NOT IN ('WMS_IF_301', 'WMS_IFC301', 'WMS_IFB301', 'WMS_IFS301', 'WMS_IFC302', 'WMS_IFB302', 'WMS_IFS302', 'TMS_IFC3012', 'TMS_IFB3012')
	 ORDER BY PRORTY
</select>

<!-- 인터페이스 배치목록 : 개별 -->
<select id="IFID_LIST" parameterType="Map" resultType="DataMap">
	SELECT IFTY, IFID, IFENM, IFKNM, SYSFR, SYSTO, IFTBL, BWART, IFSTAT, POLLTY, POLLTM, PRORTY
	     , RFCFN, RFCTBL, RFCP1, RFCP2, COMTYP
	  FROM ITFMA A
	 WHERE DELMAK != 'V'
	   AND IFID = #{IFID}
	 ORDER BY PRORTY
</select>

<!-- 인터페이스 실행/중지 -->
<update id="IF_UPDATE" parameterType="Map">
	UPDATE ITFMA
	   SET IFSTAT = #{IFSTAT}
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),' ')
	 WHERE IFID = #{IFID}
</update>

<!-- 인터페이스 저장 : 실행주기,시간,SAP정보 -->
<update id="IFSTAT_UPDATE" parameterType="Map">
	UPDATE ITFMA
	   SET POLLTY = #{POLLTY}, POLLTM = #{POLLTM}, PRORTY = NVL(TRIM(#{PRORTY}), NULL)
	     , RFCFN = #{RFCFN}, RFCTBL = #{RFCTBL}, RFCP1 = #{RFCP1}, RFCP2 = #{RFCP2}
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),' ')
	 WHERE IFID = #{IFID}
</update>

<!-- 인터페이스 매핑컬럼 -->
<select id="IFCOL_LIST" parameterType="Map" resultType="DataMap">
	SELECT IFID, SOURCE, TARGET, STRAT, STRVAL
<!-- 	     , REGEXP_REPLACE(REPLACE(COLNM,' ','_'),'[[:punct:]]','_') AS COLNM -->
	     , REPLACE(COLNM,' ','_') AS COLNM
	     , REMARK, SORTNO, COLSEQ, VIEWAT, IFAT, EXCELAT
	     , (SELECT SYSFR FROM ITFMA WHERE IFID = ITF.IFID) AS SYSFR
	     , (SELECT SYSTO FROM ITFMA WHERE IFID = ITF.IFID) AS SYSTO
	  FROM ITFCOL ITF
	 WHERE IFID = #{IFID}
	 ORDER BY IFID ASC, SORTNO ASC
</select>

<!-- 인터페이스 매핑 조회 -->
<select id="IFCOLMAP_LIST" parameterType="Map" resultType="DataMap">
	SELECT IFID
	     , (SELECT IFKNM FROM ITFMA WHERE IFID = ITF.IFID) AS IFKNM
	     , SOURCE
	     , TARGET
	     , STRAT, STRVAL
<!-- 	     , REGEXP_REPLACE(REPLACE(COLNM,' ','_'),'[[:punct:]]','_') AS COLNM -->
	     , REPLACE(COLNM,' ','_') AS COLNM
	     , REMARK, SORTNO, COLSEQ, VIEWAT, IFAT, EXCELAT
	     , (SELECT SYSFR FROM ITFMA WHERE IFID = ITF.IFID) AS SYSFR
	     , (SELECT SYSTO FROM ITFMA WHERE IFID = ITF.IFID) AS SYSTO
	  FROM ITFCOL ITF
	 WHERE IFID IN (${IFID})
	 ORDER BY IFID ASC, SORTNO ASC
</select>

<!-- 인터페이스 목록 -->
<select id="ITFMA_LIST" parameterType="Map" resultType="DataMap">
	SELECT IFTY, IFID, IFENM, IFKNM, SYSFR, SYSTO, IFTBL, BWART
<!-- 	     , (SELECT DOCUTY || ' ' || SHORTX FROM DOCTM WHERE DOCUTY = A.BWART) AS BWARTNM -->
	     , (SELECT LISTAGG(NVL(X, ''' '''), ',') WITHIN GROUP(ORDER BY X ASC) FROM
	           (SELECT DOCUTY||' '||SHORTX AS X FROM DOCTM WHERE DOCUTY IN 
	               (SELECT REGEXP_SUBSTR (B.BWART,'[^,]+',1,LEVEL) VALUE FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID) B
	                CONNECT BY LEVEL &lt;= LENGTH ( B.BWART ) - LENGTH ( REPLACE ( B.BWART, ',' ) ) + 1
	               )
	           )
	       ) AS BWARTNM
	     , IFSTAT, (SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'IFSTAT' AND CMCDVL = A.IFSTAT) AS IFSTATNM
	     , COMTYP, (SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'COMTYP' AND CMCDVL = A.COMTYP) AS COMTYPNM
	     , POLLTY, POLLTM, PRORTY
	     , RFCFN, RFCTBL, RFCP1, RFCP2
	     , NVL(
	       CASE WHEN IFTBL = 'IFWMS001' THEN (SELECT COUNT(SEQNO) FROM IFWMS001 WHERE ITFFLG = 'C' AND PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS002' THEN (SELECT COUNT(SEQNO) FROM IFWMS002 WHERE PRCFLG = 'C' AND IFID = A.IFID AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS006' THEN (SELECT COUNT(SEQNO) FROM IFWMS006 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS005' THEN (SELECT COUNT(SEQNO) FROM IFWMS005 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS008' THEN (SELECT COUNT(SEQNO) FROM IFWMS008 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS009' THEN (SELECT COUNT(SEQNO) FROM IFWMS009 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS010' THEN (SELECT COUNT(SEQNO) FROM IFWMS010 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS000' THEN (SELECT COUNT(SEQNO) FROM IFWMS000 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFID = 'WMS_IF_777' THEN (SELECT COUNT(1) FROM IFWMSLOG WHERE IFID = 'WMS_IF_777' AND CREDAT = #{CREDAT})
	            WHEN IFID = 'WMS_IF_778' THEN (SELECT COUNT(1) FROM IFWMSLOG WHERE IFID = 'WMS_IF_778' AND CREDAT = #{CREDAT})
	            WHEN IFID = 'WMS_IF_779' THEN (SELECT COUNT(1) FROM IFWMSLOG WHERE IFID = 'WMS_IF_779' AND CREDAT = #{CREDAT})
	            WHEN IFID = 'WMS_IF_888' THEN (SELECT COUNT(1) FROM STKDY WHERE STDDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS999' THEN (SELECT COUNT(SEQNO) FROM IFWMS999 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS010' THEN (SELECT COUNT(SEQNO) FROM IFWMS010 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS100' THEN (SELECT COUNT(SEQNO) FROM IFWMS100 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS333' THEN (SELECT COUNT(SEQNO) FROM IFWMS333 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS900' THEN (SELECT COUNT(SEQNO) FROM IFWMS900 WHERE CREDAT = #{CREDAT})
	            WHEN IFTBL = 'DEALH' THEN (SELECT COUNT(DEALKY) FROM DEALH WHERE CREDAT = #{CREDAT})
	            WHEN IFTBL = 'TB_IFR012' THEN (SELECT COUNT(1) FROM TB_IFR012 WHERE NVL(RECV_FLAG,' ') IN ('C')
	                                              AND RECV_DATE BETWEEN TO_DATE(#{CREDAT} || '000000','YYYYMMDDHH24MISS')
	                                                                AND TO_DATE(#{CREDAT} || '235959','YYYYMMDDHH24MISS'))
	            WHEN IFTBL = 'IFWMS103' THEN (SELECT COUNT(SEQNO) FROM IFWMS103 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'C' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS108' THEN (SELECT COUNT(SEQNO) FROM IFWMS108 WHERE PRCFLG = 'C' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS109' THEN (SELECT COUNT(SEQNO) FROM IFWMS109 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'C' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS113' THEN (SELECT COUNT(SEQNO) FROM IFWMS113 
	                                           WHERE IFID = A.IFID AND PRCFLG IN ('C','Y') 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS203' THEN (SELECT COUNT(SEQNO) FROM IFWMS203 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'C' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS209' THEN (SELECT COUNT(SEQNO) FROM IFWMS209 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'C' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS213' THEN (SELECT COUNT(SEQNO) FROM IFWMS213 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'C' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS223' THEN (SELECT COUNT(SEQNO) FROM IFWMS223 
	                                           WHERE (IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_209',A.IFID) OR IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_213',A.IFID))
	                                             AND PRCFLG = 'C' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	       END,   0) AS LASTCNT
	     , NVL(
	       CASE WHEN IFTBL = 'IFWMS001' THEN (SELECT COUNT(SEQNO) FROM IFWMS001 WHERE (ITFFLG = 'I' OR PRCFLG = 'I') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS002' THEN (SELECT COUNT(SEQNO) FROM IFWMS002 WHERE PRCFLG NOT IN ('C','E','D') AND IFID = A.IFID AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS006' THEN (SELECT COUNT(SEQNO) FROM IFWMS006 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS005' THEN (SELECT COUNT(SEQNO) FROM IFWMS005 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS008' THEN (SELECT COUNT(SEQNO) FROM IFWMS008 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS009' THEN (SELECT COUNT(SEQNO) FROM IFWMS009 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS010' THEN (SELECT COUNT(SEQNO) FROM IFWMS010 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS999' THEN (SELECT COUNT(SEQNO) FROM IFWMS999 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS010' THEN (SELECT COUNT(SEQNO) FROM IFWMS010 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS000' THEN (SELECT COUNT(SEQNO) FROM IFWMS000 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS100' THEN (SELECT COUNT(SEQNO) FROM IFWMS100 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS333' THEN (SELECT COUNT(SEQNO) FROM IFWMS333 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'TB_IFR012' THEN (SELECT COUNT(1) FROM TB_IFR012 WHERE NVL(RECV_FLAG,' ') NOT IN ('C','E')
	                                              AND RECV_DATE BETWEEN TO_DATE(#{CREDAT} || '000000','YYYYMMDDHH24MISS')
	                                                              AND TO_DATE(#{CREDAT} || '235959','YYYYMMDDHH24MISS'))
	            WHEN IFTBL = 'IFWMS103' THEN (SELECT COUNT(SEQNO) FROM IFWMS103 
	                                           WHERE IFID = A.IFID AND PRCFLG NOT IN ('C','E','D')
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS108' THEN (SELECT COUNT(SEQNO) FROM IFWMS108 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS109' THEN (SELECT COUNT(SEQNO) FROM IFWMS109 
	                                           WHERE IFID = A.IFID AND PRCFLG NOT IN ('C','E','D')
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS113' THEN (SELECT COUNT(SEQNO) FROM IFWMS113 
	                                           WHERE IFID = A.IFID AND PRCFLG NOT IN ('C','Y','E','D')
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS203' THEN (SELECT COUNT(SEQNO) FROM IFWMS203 
	                                           WHERE IFID = A.IFID AND PRCFLG NOT IN ('C','E','D')
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS209' THEN (SELECT COUNT(SEQNO) FROM IFWMS209 
	                                           WHERE IFID = A.IFID AND PRCFLG NOT IN ('C','E','D')
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS213' THEN (SELECT COUNT(SEQNO) FROM IFWMS213 
	                                           WHERE IFID = A.IFID AND PRCFLG NOT IN ('C','E','D')
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS223' THEN (SELECT COUNT(SEQNO) FROM IFWMS223 
	                                           WHERE (IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_209',A.IFID) OR IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_213',A.IFID))
	                                             AND PRCFLG NOT IN ('C','E','D')
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	       END,   0) AS LASTING
	     , NVL(
	       CASE WHEN IFTBL = 'IFWMS001' THEN (SELECT COUNT(SEQNO) FROM IFWMS001 WHERE (ITFFLG = 'E' OR PRCFLG = 'E') AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS002' THEN (SELECT COUNT(SEQNO) FROM IFWMS002 WHERE PRCFLG = 'E' AND IFID = A.IFID AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS006' THEN (SELECT COUNT(SEQNO) FROM IFWMS006 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS005' THEN (SELECT COUNT(SEQNO) FROM IFWMS005 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS008' THEN (SELECT COUNT(SEQNO) FROM IFWMS008 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS009' THEN (SELECT COUNT(SEQNO) FROM IFWMS009 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS010' THEN (SELECT COUNT(SEQNO) FROM IFWMS010 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS000' THEN (SELECT COUNT(SEQNO) FROM IFWMS000 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS999' THEN (SELECT COUNT(SEQNO) FROM IFWMS999 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS010' THEN (SELECT COUNT(SEQNO) FROM IFWMS010 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS100' THEN (SELECT COUNT(SEQNO) FROM IFWMS100 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS333' THEN (SELECT COUNT(SEQNO) FROM IFWMS333 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'TB_IFR012' THEN (SELECT COUNT(1) FROM TB_IFR012 WHERE NVL(RECV_FLAG,' ') IN ('E')
	                                              AND RECV_DATE BETWEEN TO_DATE(#{CREDAT} || '000000','YYYYMMDDHH24MISS')
	                                                              AND TO_DATE(#{CREDAT} || '235959','YYYYMMDDHH24MISS'))
	            WHEN IFTBL = 'IFWMS103' THEN (SELECT COUNT(SEQNO) FROM IFWMS103 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS108' THEN (SELECT COUNT(SEQNO) FROM IFWMS108 WHERE PRCFLG = 'E' AND CREDAT = #{CREDAT})
	            WHEN IFTBL = 'IFWMS109' THEN (SELECT COUNT(SEQNO) FROM IFWMS109 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS113' THEN (SELECT COUNT(SEQNO) FROM IFWMS113 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS203' THEN (SELECT COUNT(SEQNO) FROM IFWMS203 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS209' THEN (SELECT COUNT(SEQNO) FROM IFWMS209 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS213' THEN (SELECT COUNT(SEQNO) FROM IFWMS213 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	            WHEN IFTBL = 'IFWMS223' THEN (SELECT COUNT(SEQNO) FROM IFWMS223 
	                                           WHERE (IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_209',A.IFID) OR IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_213',A.IFID))
	                                             AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = #{CREDAT}
	                                         )
	       END,   0) AS LASTERR
	  FROM ITFMA A
	 WHERE DELMAK != 'V'
	 <if test="RANGE_SQL != null and RANGE_SQL != ' '.toString() and RANGE_SQL != ''.toString()">
		${RANGE_SQL}
	 </if>
	 ORDER BY SEQNO
</select>

<select id="ITFMAX_LIST" parameterType="Map" resultType="DataMap">
	SELECT IFTY, IFID, IFENM, IFKNM, SYSFR, SYSTO, IFTBL, BWART
<!-- 	     , (SELECT DOCUTY || ' ' || SHORTX FROM DOCTM WHERE DOCUTY = A.BWART) AS BWARTNM -->
	     , (SELECT LISTAGG(NVL(X, ''' '''), ',') WITHIN GROUP(ORDER BY X ASC) FROM
	           (SELECT DOCUTY||' '||SHORTX AS X FROM DOCTM WHERE DOCUTY IN 
	               (SELECT REGEXP_SUBSTR (B.BWART,'[^,]+',1,LEVEL) VALUE FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID) B
	                CONNECT BY LEVEL &lt;= LENGTH ( B.BWART ) - LENGTH ( REPLACE ( B.BWART, ',' ) ) + 1
	               )
	           )
	       ) AS BWARTNM
	     , IFSTAT, (SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'IFSTAT' AND CMCDVL = A.IFSTAT) AS IFSTATNM
	     , COMTYP, (SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'COMTYP' AND CMCDVL = A.COMTYP) AS COMTYPNM
	     , POLLTY, POLLTM, PRORTY
	     , RFCFN, RFCTBL, RFCP1, RFCP2
	     , NVL(
	       CASE WHEN IFTBL = 'IFWMS001' THEN (SELECT COUNT(SEQNO) FROM IFWMS001 WHERE ITFFLG = 'C' AND PRCFLG = 'C' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS001 ))
	            WHEN IFTBL = 'IFWMS002' THEN (SELECT COUNT(SEQNO) FROM IFWMS002 WHERE PRCFLG = 'C' AND IFID = A.IFID AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS002 WHERE IFID = A.IFID))
