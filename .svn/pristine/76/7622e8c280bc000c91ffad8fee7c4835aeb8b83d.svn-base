</update>


<!-- IFWMS223 재고조정실적 품질검사결과 상태변경건 자동전송대상 검색 -->
<select id="IFWMS223_AUTO_LIST" parameterType="Map" resultType="DataMap">
	SELECT DISTINCT
	       LOGSEQNO
	     , SADJKY
	     , WAREKY
	     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS DOCDAT
	     --, ZDOC_NO 
	     --, ZDOC_ITEM
	  FROM IFWMS223
	 WHERE PRCFLG IN ('I', ' ')
	   AND IFID IN ('WMS_IF_209','WMS_IF_213')
	   AND CREDAT >= TO_CHAR(SYSDATE - 7, 'YYYYMMDD')  
	 ORDER BY LOGSEQNO ASC
</select>

