	            WHEN IFTBL = 'IFWMS005' THEN (SELECT COUNT(SEQNO) FROM IFWMS005 WHERE PRCFLG = 'C' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS005 ))
	            WHEN IFTBL = 'IFWMS008' THEN (SELECT COUNT(SEQNO) FROM IFWMS008 WHERE PRCFLG = 'C' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS008 ))
	            WHEN IFTBL = 'IFWMS009' THEN (SELECT COUNT(SEQNO) FROM IFWMS009 WHERE PRCFLG = 'C' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS009 ))
