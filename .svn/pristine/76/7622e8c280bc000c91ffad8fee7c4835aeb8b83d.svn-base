	  FROM YMWMS.WAHMA
</select>

<insert id="IFWMS333_INSERT" parameterType="Map">
	INSERT INTO IFWMS333
	     (
	       SEQNO
	     , OWNRKY, WAREKY
	     , TKNUM, VBELN, STATUS
	     , REMARK
	     , ITFCNT, ITFFLG, ITFETX, ITFDAT, ITFTIM
	     , PRCCNT, PRCFLG, PRCETX, PRCDAT, PRCTIM
	     , CDATE, TDATE
	     , CREDAT, CRETIM, CREUSR
	     , WERKS
	     , IFID, LOGSEQNO
	     )
	 VALUES
	     (
	       SEQ_IFWMS333.NEXTVAL
	     , 'KN', NVL(#{WAREKY}, ' ')
	     , NVL(#{TKNUM}, ' '), NVL(#{VBELN},' '), NVL(#{STATUS},' ')
	     , NVL(#{REMARK},' ')
	     , 1, 'C', ' ', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 0, 'N', ' ', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS')
	     , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , 'KN'
	     , #{IFID}, #{LOGSEQNO}
	     )
</insert>

<insert id="IFWMS333_MULTI_INSERT" parameterType="Map">
	INSERT INTO IFWMS333
	     (
	       SEQNO
	     , OWNRKY, WAREKY
	     , TKNUM, VBELN, STATUS
	     , REAMRK
	     , ITFCNT, ITFFLG, ITFETX, ITFDAT, ITFTIM
	     , PRCCNT, PRCFLG, PRCETX, PRCDAT, PRCTIM
	     , CDATE, TDATE
	     , CREDAT, CRETIM, CREUSR
	     , WERKS
	     , IFID, LOGSEQNO
	     )
		<foreach item="i" index="index" collection="list" open=" " separator=" UNION ALL " close="">
	SELECT
	       F_GET_SEQ_MULTICASE('IFWMS333')
	     , 'KN', NVL(#{i.WAREKY, jdbcType=VARCHAR}, ' ')
	     , NVL(#{i.TKNUM, jdbcType=VARCHAR}, ' '), NVL(#{i.VBELN, jdbcType=VARCHAR},' '), NVL(#{i.STATUS, jdbcType=VARCHAR},' ')
	     , NVL(#{i.REMARK, jdbcType=VARCHAR},' ')
	     , 1, 'C', ' ', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS')
	     , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{i.SES_USER_ID, jdbcType=VARCHAR}),#{i.IFID, jdbcType=VARCHAR})
	     , 'KN'
	     , #{i.IFID, jdbcType=VARCHAR}, #{i.LOGSEQNO, jdbcType=VARCHAR}
	  FROM DUAL
		</foreach>
</insert>

<select id="IFWMS333_CHECK_COUNT" parameterType="Map" resultType="Integer">
	SELECT NVL(SUM(DECODE(STATUS, 'D', 0, 1)), 0) AS COUNT 
	  FROM ( 
	  	SELECT STATUS 
	  	  FROM IFWMS333 
	  	 WHERE TKNUM = #{TKNUM} 
	  	   AND ITFFLG = 'C' 
	  	   AND PRCFLG = 'C'  
  	     ORDER BY SEQNO DESC 
	  ) A 
  	 WHERE ROWNUM = 1 
</select>

<select id="IFWMS333_LIST" parameterType="Map" resultType="DataMap">
	SELECT SEQNO
	     , OWNRKY
	     , WAREKY
	     , TKNUM
	     , VBELN
	     , STATUS
	     , REMARK
	     , WERKS
	     , IFID
	     , LOGSEQNO 
	  FROM IFWMS333 
	 WHERE IFID = #{IFID} 
	   AND LOGSEQNO = #{LOGSEQNO}
	 ORDER BY SEQNO ASC
</select>

<update id="IFWMS333_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS333
	   SET ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE IFID = #{IFID}
	   AND LOGSEQNO = #{LOGSEQNO}
</update>

<!-- IF05 인터페이스 추적 -->
<select id="IF_CHK_LIST" parameterType="Map" resultType="DataMap">
	SELECT 'IFWMS103' AS IFTBL, SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, LOGSEQNO
	     , MATNR, MENGE AS CNT, MEINS, STATUS
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA06, LOTA07, LOTA09, LOTA14, LOTA15, LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , EBELN AS ORDNUM, EBELP AS ITEMNO, EINDT AS DAT, ' ' AS STKNUM
	     , ' ' AS MBLNR, ITFFLG, PRCFLG, PRCETX, ' ' AS ZDOC_NO, ' ' AS ZDOC_ITEM, REMARK
	     , BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM
	  FROM IFWMS103 A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND MATNR = NVL(TRIM(#{MATNR}), MATNR) AND EBELN = NVL(TRIM(#{ORDNUM}), EBELN)
	   AND '1' = NVL(TRIM(#{STKNUM}), '1')
	   AND '1' = NVL(TRIM(#{ZDOC_NO}), '1')
	   AND LOTA14 = NVL(TRIM(#{LOTA14}), LOTA14)
	   AND LOTA15 = NVL(TRIM(#{LOTA15}), LOTA15)
	UNION ALL
	SELECT 'IFWMS203' AS IFTBL, SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, LOGSEQNO
	     , MATNR, QTYRCV AS CNT, MEINS, STATUS
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA06, LOTA07, LOTA09, LOTA14, LOTA15, LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , EBELN AS ORDNUM, EBELP AS ITEMNO, ' ' AS DAT, ' ' AS STKNUM
	     , MBLNR, ITFFLG, PRCFLG, PRCETX, ZDOC_NO, ZDOC_ITEM, REMARK
	     , BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM
	  FROM IFWMS203 A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND MATNR = NVL(TRIM(#{MATNR}), MATNR) AND EBELN = NVL(TRIM(#{ORDNUM}), EBELN)
	   AND '1' = NVL(TRIM(#{STKNUM}), '1')
	   AND ZDOC_NO = NVL(TRIM(#{ZDOC_NO}), ZDOC_NO)
	   AND LOTA14 = NVL(TRIM(#{LOTA14}), LOTA14)
	   AND LOTA15 = NVL(TRIM(#{LOTA15}), LOTA15)
	UNION ALL
	SELECT /*+ INDEX_ASC(A IDX_IFWMS209_003)  */
	       'IFWMS209' AS IFTBL, SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, LOGSEQNO
	     , MATNR, TO_NUMBER(MENGE) AS CNT, MEINS, STATUS
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA06, LOTA07, LOTA09, LOTA14, LOTA15, LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , EBELN AS ORDNUM, EBELP AS ITEMNO, ' ' AS DAT, ' ' AS STKNUM
	     , ' ' AS MBLNR, ITFFLG, PRCFLG, PRCETX, VGBEL AS ZDOC_NO, VGPOS AS ZDOC_ITEM, ' ' AS REMARK
	     , ' ' AS BWARTSAP
	     , CREDAT, CRETIM, CREUSR
		 , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM
	  FROM IFWMS209 A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND MATNR = NVL(TRIM(#{MATNR}), MATNR) AND EBELN = NVL(TRIM(#{ORDNUM}), EBELN)
	   AND '1' = NVL(TRIM(#{STKNUM}), '1')
	   AND VGBEL = NVL(TRIM(#{ZDOC_NO}), VGBEL)
	   AND LOTA14 = NVL(TRIM(#{LOTA14}), LOTA14)
	   AND LOTA15 = NVL(TRIM(#{LOTA15}), LOTA15)
	UNION ALL
	SELECT 'IFWMS108' AS IFTBL, SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, LOGSEQNO
	     , MATNR, TO_NUMBER(MENGE) AS CNT, MEINS, ' ' AS STATUS
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA06, LOTA07, LOTA09, LOTA14, LOTA15, LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , EBELN AS ORDNUM, EBELP AS ITEMNO, ' ' AS DAT, ' ' AS STKNUM
	     , ' ' AS MBLNR, ITFFLG, PRCFLG, PRCETX, VGBEL AS ZDOC_NO, VGPOS AS ZDOC_ITEM, ' ' AS REMARK
	     , ' ' AS BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM
	  FROM IFWMS108 A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND MATNR = NVL(TRIM(#{MATNR}), MATNR) AND EBELN = NVL(TRIM(#{ORDNUM}), EBELN)
	   AND '1' = NVL(TRIM(#{STKNUM}), '1')
	   AND VGBEL = NVL(TRIM(#{ZDOC_NO}), VGBEL)
	   AND LOTA14 = NVL(TRIM(#{LOTA14}), LOTA14)
	   AND LOTA15 = NVL(TRIM(#{LOTA15}), LOTA15)
	UNION ALL
	SELECT /*+ INDEX_ASC(A IDX_IFWMS109_003)  */
	       'IFWMS109' AS IFTBL, SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, LOGSEQNO
	     , MATNR, MENGE AS CNT, MEINS, ' ' AS STATUS
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA06, LOTA07, LOTA09, LOTA14, LOTA15, LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , EBELN AS ORDNUM, EBELP AS ITEMNO, ' ' AS DAT, ' ' AS STKNUM
	     , ' ' AS MBLNR, ITFFLG, PRCFLG, PRCETX, VGBEL AS ZDOC_NO, VGPOS AS ZDOC_ITEM, ' ' AS REMARK
	     , ' ' AS BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM
	  FROM IFWMS109 A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND MATNR = NVL(TRIM(#{MATNR}), MATNR) AND EBELN = NVL(TRIM(#{ORDNUM}), EBELN)
	   AND '1' = NVL(TRIM(#{STKNUM}), '1')
	   AND VGBEL = NVL(TRIM(#{ZDOC_NO}), VGBEL)
	   AND LOTA14 = NVL(TRIM(#{LOTA14}), LOTA14)
	   AND LOTA15 = NVL(TRIM(#{LOTA15}), LOTA15)
	UNION ALL
	SELECT /*+ INDEX_ASC(A IDX_IFWMS223_004)  */
	       'IFWMS223' AS IFTBL, SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, LOGSEQNO
	     , MATNR, TO_NUMBER(QTADJU) AS CNT, MEINS, STATUS
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA06, LOTA07, LOTA09, LOTA14, LOTA15, LOTA17
	     , TLOTA01, TLOTA02, TLOTA03, TLOTA04, TLOTA06, TLOTA07, TLOTA09, TLOTA14, TLOTA15
	     , SADJKY AS ORDNUM, SADJIT AS ITEMNO, ' ' AS DAT, ' ' AS STKNUM
	     , MBLNR, ITFFLG, PRCFLG, PRCETX, ZDOC_NO, ZDOC_ITEM
	     , CASE WHEN IFID IN ('WMS_IF_209','WMS_IF_213')
	            THEN 'WMS_IF_209213 SAP자동전송'
	            ELSE UI || ' ' || (SELECT SHORTX FROM PROGM WHERE PROGID = A.UI)
	       END AS REMARK
	     , BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM
	  FROM IFWMS223 A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND MATNR = NVL(TRIM(#{MATNR}), MATNR) AND SADJKY = NVL(TRIM(#{ORDNUM}), SADJKY)
	   AND '1' = NVL(TRIM(#{STKNUM}), '1')
	   AND ZDOC_NO = NVL(TRIM(#{ZDOC_NO}), ZDOC_NO)
	   AND LOTA14 = NVL(TRIM(#{LOTA14}), LOTA14)
	   AND LOTA15 = NVL(TRIM(#{LOTA15}), LOTA15)
	UNION ALL
	SELECT 'IFWMS113' AS IFTBL, SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, LOGSEQNO
	     , MATNR, QTSHP AS CNT, MEINS, STATUS
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA06, LOTA07, LOTA09, LOTA14, LOTA15, LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , VBELN AS ORDNUM, POSNR AS ITEMNO, WADAT AS DAT, STKNUM AS STKNUM
	     , ' ' AS MBLNR, ITFFLG, PRCFLG, PRCETX, ' ' AS ZDOC_NO, ' ' AS ZDOC_ITEM, ' ' AS REMARK
	     , BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM
	  FROM IFWMS113 A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND MATNR = NVL(TRIM(#{MATNR}), MATNR) AND VBELN = NVL(TRIM(#{ORDNUM}), VBELN)
	   AND STKNUM = NVL(TRIM(#{STKNUM}), STKNUM)
	   AND '1' = NVL(TRIM(#{ZDOC_NO}), '1')
	   AND LOTA14 = NVL(TRIM(#{LOTA14}), LOTA14)
	   AND LOTA15 = NVL(TRIM(#{LOTA15}), LOTA15)
	UNION ALL
	SELECT /*+ INDEX_ASC(A IDX_IFWMS213_003)  */
	       'IFWMS213' AS IFTBL, SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, LOGSEQNO
	     , MATNR, ZQTSACT AS CNT, MEINS, STATUS
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA06, LOTA07, LOTA09, LOTA14, LOTA15, LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , VBELN AS ORDNUM, POSNR AS ITEMNO, ' ' AS DAT, STKNUM
	     , MBLNR, ITFFLG, PRCFLG, PRCETX, ZDOC_NO, ZDOC_ITEM, REMARK
	     , BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM
	  FROM IFWMS213 A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND MATNR = NVL(TRIM(#{MATNR}), MATNR) AND VBELN = NVL(TRIM(#{ORDNUM}), VBELN)
	   AND STKNUM = NVL(TRIM(#{STKNUM}), STKNUM)
	   AND ZDOC_NO = NVL(TRIM(#{ZDOC_NO}), ZDOC_NO)
	   AND LOTA14 = NVL(TRIM(#{LOTA14}), LOTA14)
	   AND LOTA15 = NVL(TRIM(#{LOTA15}), LOTA15)
	UNION ALL
	SELECT /*+ INDEX_ASC(A IDX_IFWMS333_001)  */
	       'IFWMS333' AS IFTBL, SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, LOGSEQNO
	     , ' ' AS MATNR, NULL AS CNT, ' ' AS MEINS, STATUS
	     , ' ' AS LOTA01, ' ' AS LOTA02, ' ' AS LOTA03, ' ' AS LOTA04, ' ' AS LOTA06, ' ' AS LOTA07, ' ' AS LOTA09, ' ' AS LOTA14, ' ' AS LOTA15, ' ' AS LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , VBELN AS ORDNUM, ' ' AS ITEMNO, ' ' AS DAT, TKNUM AS STKNUM
	     , ' ' AS MBLNR, ITFFLG, PRCFLG, PRCETX, ' ' AS ZDOC_NO, ' ' AS ZDOC_ITEM, REMARK
	     , ' ' AS BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , LMODAT, LMOTIM, LMOUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR) AS LUSRNM
	  FROM IFWMS333 A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND VBELN = NVL(TRIM(#{ORDNUM}), VBELN)
	   AND TKNUM = NVL(TRIM(#{STKNUM}), TKNUM)
	   AND '1' = NVL(TRIM(#{ZDOC_NO}), '1')
	   AND 'V' = NVL(TRIM(#{TKNUMAT}), ' ')
	UNION ALL
	SELECT '203 CANCEL' AS IFTBL, NULL AS SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, SEQNO AS LOGSEQNO
	     , ' ' AS MATNR, NULL AS CNT, ' ' AS MEINS, ' ' AS STATUS
	     , ' ' AS LOTA01, ' ' AS LOTA02, ' ' AS LOTA03, ' ' AS LOTA04, ' ' AS LOTA06, ' ' AS LOTA07, ' ' AS LOTA09, ' ' AS LOTA14, ' ' AS LOTA15, ' ' AS LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , ' ' AS ORDNUM, ' ' AS ITEMNO, ' ' AS DAT, ' ' AS STKNUM
	     , MBLNR, ' ' AS ITFFLG, ' ' AS PRCFLG, ' ' AS PRCETX, ' ' AS ZDOC_NO, ' ' AS ZDOC_ITEM, REMARK
	     , ' ' AS BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , ' ' AS LMODAT, ' ' AS LMOTIM, ' ' AS LMOUSR, ' ' AS LUSRNM
	  FROM IFWMSLOG A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND REMARK != ' '
	   AND REMARK IN (SELECT ZDOC_NO FROM IFWMS203 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD')
	                                                 AND MATNR = NVL(TRIM(#{MATNR}), MATNR)
	                                                 AND EBELN = NVL(TRIM(#{ORDNUM}), EBELN)
	                                                 AND '1' = NVL(TRIM(#{STKNUM}), '1')
	                                                 AND ZDOC_NO = NVL(TRIM(#{ZDOC_NO}), ZDOC_NO))
	UNION ALL
	SELECT '213 CANCEL' AS IFTBL, NULL AS SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, SEQNO AS LOGSEQNO
	     , ' ' AS MATNR, NULL AS CNT, ' ' AS MEINS, ' ' AS STATUS
	     , ' ' AS LOTA01, ' ' AS LOTA02, ' ' AS LOTA03, ' ' AS LOTA04, ' ' AS LOTA06, ' ' AS LOTA07, ' ' AS LOTA09, ' ' AS LOTA14, ' ' AS LOTA15, ' ' AS LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , ' ' AS ORDNUM, ' ' AS ITEMNO, ' ' AS DAT, ' ' AS STKNUM
	     , MBLNR, ' ' AS ITFFLG, ' ' AS PRCFLG, ' ' AS PRCETX, ' ' AS ZDOC_NO, ' ' AS ZDOC_ITEM, REMARK
	     , ' ' AS BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , ' ' AS LMODAT, ' ' AS LMOTIM, ' ' AS LMOUSR, ' ' AS LUSRNM
	  FROM IFWMSLOG A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND REMARK != ' '
	   AND REMARK IN (SELECT ZDOC_NO FROM IFWMS213 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD')
	                                                 AND MATNR = NVL(TRIM(#{MATNR}), MATNR)
	                                                 AND VBELN = NVL(TRIM(#{ORDNUM}), VBELN)
	                                                 AND STKNUM = NVL(TRIM(#{STKNUM}), STKNUM)
	                                                 AND ZDOC_NO = NVL(TRIM(#{ZDOC_NO}), ZDOC_NO))
	UNION ALL
	SELECT '223 CANCEL' AS IFTBL, NULL AS SEQNO, IFID, (SELECT SYSFR||'-'||SYSTO||' '||IFKNM FROM ITFMA WHERE IFID = A.IFID) AS IFNM, SEQNO AS LOGSEQNO
	     , ' ' AS MATNR, NULL AS CNT, ' ' AS MEINS, ' ' AS STATUS
	     , ' ' AS LOTA01, ' ' AS LOTA02, ' ' AS LOTA03, ' ' AS LOTA04, ' ' AS LOTA06, ' ' AS LOTA07, ' ' AS LOTA09, ' ' AS LOTA14, ' ' AS LOTA15, ' ' AS LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , ' ' AS ORDNUM, ' ' AS ITEMNO, ' ' AS DAT, ' ' AS STKNUM
	     , MBLNR, ' ' AS ITFFLG, ' ' AS PRCFLG, ' ' AS PRCETX, ' ' AS ZDOC_NO, ' ' AS ZDOC_ITEM, REMARK
	     , ' ' AS BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , ' ' AS LMODAT, ' ' AS LMOTIM, ' ' AS LMOUSR, ' ' AS LUSRNM
	  FROM IFWMSLOG A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD') AND REMARK != ' '
	   AND REMARK IN (SELECT ZDOC_NO FROM IFWMS223 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD')
	                                                 AND MATNR = NVL(TRIM(#{MATNR}), MATNR)
	                                                 AND SADJKY = NVL(TRIM(#{ORDNUM}), SADJKY)
	                                                 AND '1' = NVL(TRIM(#{STKNUM}), '1')
	                                                 AND ZDOC_NO = NVL(TRIM(#{ZDOC_NO}), ZDOC_NO))
	UNION ALL
	SELECT /*+ INDEX_ASC(A IDX_IFSAPLOG_001)  */
	       'ROLLBACK' AS IFTBL, SEQNO, UI AS IFID, (SELECT LABEL FROM SYSLABEL WHERE LABELGID = 'MENU' AND LANGCODE = 'KR' AND LABELID = A.UI AND ROWNUM = 1) AS IFNM, ' ' AS LOGSEQNO
	     , ' ' AS MATNR, NULL AS CNT, ' ' AS MEINS, ' ' AS STATUS
	     , ' ' AS LOTA01, ' ' AS LOTA02, ' ' AS LOTA03, ' ' AS LOTA04, ' ' AS LOTA06, ' ' AS LOTA07, ' ' AS LOTA09, ' ' AS LOTA14, ' ' AS LOTA15, ' ' AS LOTA17
	     , ' ' AS TLOTA01, ' ' AS TLOTA02, ' ' AS TLOTA03, ' ' AS TLOTA04, ' ' AS TLOTA06, ' ' AS TLOTA07, ' ' AS TLOTA09, ' ' AS TLOTA14, ' ' AS TLOTA15
	     , ' ' AS ORDNUM, ' ' AS ITEMNO, ' ' AS DAT, ' ' AS STKNUM
	     , ' ' AS MBLNR, ' ' AS ITFFLG, ' ' AS PRCFLG, ' ' AS PRCETX, ZDOCNO AS ZDOC_NO, ' ' AS ZDOC_ITEM, ERRTXT AS REMARK
	     , ' ' AS BWARTSAP
	     , CREDAT, CRETIM, CREUSR
	     , (SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR) AS CUSRNM
	     , ' ' AS LMODAT, ' ' AS LMOTIM, ' ' AS LMOUSR, ' ' AS LUSRNM
	  FROM IFSAPLOG A
	 WHERE CREDAT >= TO_CHAR(SYSDATE-#{STDAY},'YYYYMMDD')
	   AND ZDOCNO = NVL(TRIM(#{ZDOC_NO}), ZDOCNO)
	   AND 'V' = #{ROLLBACK}
	ORDER BY CREDAT DESC, CRETIM DESC, LOGSEQNO DESC, SEQNO DESC, LMODAT DESC, LMOTIM DESC, ORDNUM DESC, ITEMNO DESC
</select>

<select id="WMS_IFS301_STATDO_MAP" parameterType="Map" resultType="DataMap">
	SELECT STATDO
	  FROM SHPDH
	 WHERE SHPOKY = #{SHPOKY}
</select>
<resultMap id="IFWMS204_IFSEQ" type="hashmap"></resultMap>
<select id="IFWMS204_IFSEQ_MAP" parameterType="Map" statementType="CALLABLE">
    {
        CALL P_AIRWMS_IFWMS204_SEQNO( #{LOGSEQNO} )
    }
</select>

<!-- 231227 생산입고 프로시저 신규 추가 -->
<resultMap id="WMS_IFRWM006" type="hashmap"></resultMap>
<select id="WMS_IFRWM006_MAP" parameterType="Map" statementType="CALLABLE"> 
	{
		CALL SP_DBLINK_IFRWM006@MESLINK(
			<!-- #{P_STR, mode=IN, jdbcType=VARCHAR, javaType=String}, -->
			#{P_STR},
			#{RES_CD, mode=OUT, jdbcType=VARCHAR, javaType=String, resultMap=WMS_IFRWM006},
			#{RES_MSG, mode=OUT, jdbcType=VARCHAR, javaType=String, resultMap=WMS_IFRWM006}
		)
	}
</select>

<!-- 240201 IFWMS203 관련 프로시저 추가(실적 롤백 방지 목적) -->
<!-- IFWMS203 입고실적 등록 -->
<select id="IFWMS203_IF_LIST" parameterType="Map" resultType="DataMap">
	SELECT
	       CASE WHEN #{IFID} IN ('WMS_IF_214') THEN 'PTL'
	            WHEN #{IFID} IN ('WMS_IF_215','WMS_IF_216','WMS_IF_221','WMS_IF_217','WMS_IF_224','WMS_IF_219') THEN 'SAP'
	            WHEN #{IFID} IN ('WMS_IF_222','WMS_IF_218') THEN 'MES'
	            ELSE ' '
	       END AS MANDT
	     , SEQ_IFWMS203.NEXTVAL AS SEQNO
	     , RI.SEBELN AS EBELN
	     , RI.SEBELP AS EBELP
	     , RH.DPTNKY AS LIFNR
	     , RH.RCPTTY AS BWART
	     , RI.SKUKEY AS MATNR
	     , RI.QTYORG AS MENGE
	     , RI.UOMKEY AS MEINS
	     , RH.OWNRKY AS WERKS
	     , RH.DOCDAT AS EINDT
	     , NVL(TRIM(IF103.MENGE_B),0) AS MENGE_B
	     , NVL(TRIM(IF103.MENGE_R),0) AS MENGE_R
	     , RI.RECVKY AS VGBEL
	     , RI.RECVIT AS VGPOS
	     , DECODE(RI.STATIT, 'FCV', 'D', 'C') AS STATUS
	     , RH.WAREKY AS WAREKY
	     , RI.SKUKEY AS SKUKEY
	     , RI.RECVKY AS ZDOC_NO
	     , RI.RECVIT AS ZDOC_ITEM
	     , RI.QTYRCV AS QTYRCV
	     , RH.DOCCAT AS ORDCAT
	     , RI.LOTA01 AS LOTA01, RI.LOTA02 AS LOTA02, RI.LOTA03 AS LOTA03, RI.LOTA04 AS LOTA04, RI.LOTA05 AS LOTA05, RI.LOTA06 AS LOTA06, RI.LOTA07 AS LOTA07, RI.LOTA08 AS LOTA08, RI.LOTA09 AS LOTA09, RI.LOTA10 AS LOTA10
	     , RI.LOTA11 AS LOTA11, RI.LOTA12 AS LOTA12, RI.LOTA13 AS LOTA13, RI.LOTA14 AS LOTA14, ( CASE WHEN TRIM(RI.LOTA41) IS NULL THEN RI.LOTA15 ELSE RI.LOTA41 END ) AS LOTA15
	     , RI.LOTA16 AS LOTA16, RI.LOTA17 AS LOTA17, RI.LOTA18 AS LOTA18, RI.LOTA19 AS LOTA19, RI.LOTA20 AS LOTA20
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') AS CDATE, TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, NVL(TRIM(#{SES_USER_ID}),#{IFID}) AS CREUSR
	     , #{IFID} AS IFID
	     , 'I' AS ITFFLG, TO_CHAR(SYSDATE, 'YYYYMMDD') AS ITFDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS ITFTIM
	     , 'I' AS PRCFLG
	     , #{LOGSEQNO} AS LOGSEQNO
	     , (
	          CASE WHEN RH.RCPTTY='101' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
	               WHEN RH.RCPTTY='111' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
	               WHEN RH.RCPTTY='114' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
	               WHEN RH.RCPTTY IN ('121', '122') THEN DECODE(RI.STATIT, 'FCV', '648', DECODE(STM.WMSMAK, 'V', '101', '641') )
	               WHEN RH.RCPTTY='131' THEN DECODE(RI.STATIT, 'FCV', '656', '655')
	               WHEN RH.RCPTTY='135' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
	               WHEN RH.RCPTTY='199' THEN '701'
	               ELSE ''
	          END
	         ) AS BWARTSAP
	     , ( CASE WHEN RI.QTYORG=RI.QTYRCV THEN ' ' ELSE 'X' END ) AS ZDFF
	     , RI.SSORNU AS SSORNU
	     , RI.SSORIT AS SSORIT
	     , RI.POREV AS POREV
	     , RI.AR_NO AS AR_NO
	     , RI.AR_REV AS AR_REV
	     , RI.AR_LNO AS AR_LNO
	     , NVL(( SELECT SK.STOKKY FROM STKKY SK WHERE SK.RECVKY = RI.RECVKY AND SK.RECVIT = RI.RECVIT AND SK.QTSIWH > 0 AND ROWNUM = 1 ),' ') AS STOKKY
         , NVL(RI.LOTNUM,' ') AS LOTNUM
	  FROM RECDI RI
	    LEFT JOIN RECDH RH ON RH.RECVKY = RI.RECVKY
	    LEFT OUTER JOIN IFWMS103 IF103 ON IF103.SEQNO = RI.SEQNO AND IF103.EBELN = RI.SEBELN AND IF103.EBELP = RI.SEBELP
	    LEFT OUTER JOIN STLMA STM ON STM.OWNRKY = #{OWNRKY} AND STM.STLKY = RI.LOTA01 AND STM.PLNTKY = RI.LOTA02
	 WHERE RH.OWNRKY = #{OWNRKY}
	   AND RI.RECVKY IN (${RECVKYIN})
</select>

<!-- IFWMS203 입고실적 등록 -->
<select id="IFWMS203SAP_IF_LIST" parameterType="Map" resultType="DataMap">
	SELECT T1.MANDT						AS MANDT 
	     , SEQ_IFWMS203.NEXTVAL 		AS SEQNO      
	     , T1.SEBELN                    AS EBELN      
	     , T1.SEBELP                    AS EBELP      
	     , T1.LIFNR                     AS LIFNR      
	     , T1.BWART                     AS BWART      
	     , T1.MATNR                     AS MATNR      
	     , T1.MENGE                     AS MENGE      
	     , T1.MEINS                     AS MEINS      
	     , T1.WERKS                     AS WERKS      
	     , T1.EINDT                     AS EINDT      
	     , T1.MENGE_B                   AS MENGE_B    
	     , T1.MENGE_R                   AS MENGE_R    
	     , T1.VGBEL                     AS VGBEL      
	     , T1.VGPOS                     AS VGPOS      
	     , T1.STATUS                    AS STATUS     
	     , T1.WAREKY                    AS WAREKY     
	     , T1.SKUKEY                    AS SKUKEY     
	     , T1.ZDOC_NO                   AS ZDOC_NO    
	     , T1.ZDOC_ITEM                 AS ZDOC_ITEM  
	     , T1.QTYRCV                    AS QTYRCV     
	     , T1.ORDCAT                    AS ORDCAT     
	     , T1.LOTA01                    AS LOTA01     
	     , T1.LOTA02                    AS LOTA02     
	     , T1.LOTA03                    AS LOTA03     
	     , T1.LOTA04                    AS LOTA04     
	     , T1.LOTA05                    AS LOTA05     
	     , T1.LOTA06                    AS LOTA06     
	     , T1.LOTA07                    AS LOTA07     
	     , T1.LOTA08                    AS LOTA08     
	     , T1.LOTA09                    AS LOTA09     
	     , T1.LOTA10                    AS LOTA10     
	     , T1.LOTA11                    AS LOTA11     
	     , T1.LOTA12                    AS LOTA12     
	     , T1.LOTA13                    AS LOTA13     
	     , T1.LOTA14                    AS LOTA14     
	     , T1.LOTA15                    AS LOTA15     
	     , T1.LOTA16                    AS LOTA16     
	     , T1.LOTA17                    AS LOTA17     
	     , T1.LOTA18                    AS LOTA18     
	     , T1.LOTA19                    AS LOTA19     
	     , T1.LOTA20                    AS LOTA20     
	     , T1.CDATE                     AS CDATE      
	     , T1.CREDAT                    AS CREDAT     
	     , T1.CRETIM                    AS CRETIM     
	     , T1.CREUSR                    AS CREUSR     
	     , T1.IFID                      AS IFID       
	     , T1.ITFFLG                    AS ITFFLG     
	     , T1.ITFDAT                    AS ITFDAT     
	     , T1.ITFTIM                    AS ITFTIM     
	     , T1.PRCFLG                    AS PRCFLG     
	     , T1.LOGSEQNO                  AS LOGSEQNO   
	     , T1.BWARTSAP                  AS BWARTSAP   
	     , T1.ZDFF                      AS ZDFF       
	     , T1.PIKSUM                    AS PIKSUM     
	     , T1.SSORNU                    AS SSORNU     
	     , T1.SSORIT                    AS SSORIT     
	     , T1.POREV                     AS POREV      
	     , T1.AR_NO                     AS AR_NO      
	     , T1.AR_REV                    AS AR_REV     
	     , T1.AR_LNO                    AS AR_LNO     
	     , T1.UI                        AS UI         
	     , T1.REMARK                    AS REMARK     
	FROM (
		SELECT A.SEBELN
	         , A.SEBELP
	         , MAX(A.MANDT) AS MANDT
	         , MAX(A.LIFNR) AS LIFNR     
	         , MAX(A.BWART) AS BWART
	         , MAX(A.MATNR) AS MATNR
	         , MAX(A.MENGE) AS MENGE
	         , MAX(A.MEINS) AS MEINS
	         , MAX(A.WERKS) AS WERKS
	         , MAX(A.EINDT) AS EINDT
	         , SUM(A.MENGE_B) AS MENGE_B
	         , SUM(A.MENGE_R) AS MENGE_R
	         , NVL(MAX(A.VGBEL),' ') AS VGBEL
	         , NVL(MAX(A.VGPOS),' ') AS VGPOS     
	         , MAX(A.STATUS) AS STATUS     
	         , MAX(A.WAREKY) AS WAREKY     
	         , A.SKUKEY AS SKUKEY
	         , MAX(A.ZDOC_NO) AS ZDOC_NO
	         , MAX(A.ZDOC_ITEM) AS ZDOC_ITEM
	         --, SUM(A.QTYRCV) AS QTYRCV
	         , ( CASE WHEN ABS(sum(A.QTYRCV) - MAX(A.MENGE)) = '0.001' THEN MAX(A.MENGE) ELSE sum(A.QTYRCV) END ) AS QTYRCV	-- 0.001 오차 보정     
	         , MAX(A.ORDCAT) AS ORDCAT
	         , A.LOTA01 AS LOTA01
	         , A.LOTA02 AS LOTA02
	         , MAX(A.LOTA03) AS LOTA03
	         , MAX(A.LOTA04) AS LOTA04
	         , MAX(A.LOTA05) AS LOTA05
	         , MAX(A.LOTA06) AS LOTA06
	         , MAX(A.LOTA07) AS LOTA07
	         , MAX(A.LOTA08) AS LOTA08
	         , MAX(A.LOTA09) AS LOTA09
	         , MAX(A.LOTA10) AS LOTA10
	         , A.LOTA11 AS LOTA11
	         , MAX(A.LOTA12) AS LOTA12
	         , MAX(A.LOTA13) AS LOTA13
	         , MAX(A.LOTA14) AS LOTA14
	         , A.LOTA15 AS LOTA15
	         , MAX(A.LOTA16) AS LOTA16
	         , MAX(A.LOTA17) AS LOTA17
	         , MAX(A.LOTA18) AS LOTA18
	         , MAX(A.LOTA19) AS LOTA19
	         , MAX(A.LOTA20) AS LOTA20
	         , MAX(A.CDATE) AS CDATE
	         , MAX(A.CREDAT) AS CREDAT
	         , MAX(A.CRETIM) AS CRETIM
	         , MAX(A.CREUSR) AS CREUSR
	         , MAX(A.IFID) AS IFID
	         , MAX(A.ITFFLG) AS ITFFLG
	         , MAX(A.ITFDAT) AS ITFDAT
	         , MAX(A.ITFTIM) AS ITFTIM
	         , MAX(A.PRCFLG) AS PRCFLG
	         , MAX(A.LOGSEQNO) AS LOGSEQNO
	         , MAX(A.BWARTSAP) AS BWARTSAP
	         , ( CASE WHEN SUM(A.MENGE)=SUM(A.QTYRCV) THEN ' ' ELSE 'X' END ) AS ZDFF
	         --, SUM(A.QTYRCV) AS PIKSUM
	         , ( CASE WHEN ABS(sum(A.QTYRCV) - MAX(A.MENGE)) = '0.001' THEN MAX(A.MENGE) ELSE sum(A.QTYRCV) END ) AS PIKSUM	-- 0.001 오차 보정
	         , MAX(A.SSORNU) AS SSORNU
	         , MAX(A.SSORIT) AS SSORIT
	         , MAX(A.POREV) AS POREV
	         , MAX(A.AR_NO)  AS AR_NO
	         , MAX(A.AR_REV) AS AR_REV
	         , MAX(A.AR_LNO) AS AR_LNO
	         , MAX(A.UI) AS UI
	         , MAX(A.REMARK) AS REMARK
	    FROM ( 
			SELECT
			       CASE WHEN #{IFID} IN ('WMS_IF_214') THEN 'PTL'
			            WHEN #{IFID} IN ('WMS_IF_215','WMS_IF_216','WMS_IF_221','WMS_IF_217','WMS_IF_224','WMS_IF_219') THEN 'SAP'
			            WHEN #{IFID} IN ('WMS_IF_222','WMS_IF_218') THEN 'MES'
			            ELSE ' '
			       END AS MANDT
			     , RI.SEBELN
			     , RI.SEBELP
			     , RH.DPTNKY AS LIFNR
			     , RH.RCPTTY AS BWART
			     , RI.SKUKEY AS MATNR
			     , RI.QTYORG AS MENGE
			     , RI.UOMKEY AS MEINS
			     , RH.OWNRKY AS WERKS
			     , RH.DOCDAT AS EINDT
			     , NVL(TRIM(IF103.MENGE_B),0) AS MENGE_B
			     , NVL(TRIM(IF103.MENGE_R),0) AS MENGE_R
			     , IF103.VGBEL
			     , IF103.VGPOS
			     , DECODE(RI.STATIT, 'FCV', 'D', 'C') AS STATUS
			     , RH.WAREKY
			     , RI.SKUKEY
			     , RI.RECVKY AS ZDOC_NO
			     , RI.RECVIT AS ZDOC_ITEM
			     , RI.QTYRCV
			     , RH.DOCCAT AS ORDCAT
			     , RI.LOTA01, RI.LOTA02, RI.LOTA03, RI.LOTA04, RI.LOTA05, RI.LOTA06, RI.LOTA07, RI.LOTA08, RI.LOTA09, RI.LOTA10
			     , RI.LOTA11, RI.LOTA12, RI.LOTA13, RI.LOTA14, RI.LOTA15, RI.LOTA16, RI.LOTA17, RI.LOTA18, RI.LOTA19, RI.LOTA20
			     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') AS CDATE, TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT
	             , TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, NVL(TRIM(#{SES_USER_ID}),#{IFID}) AS CREUSR
			     , #{IFID} AS IFID
			     , 'I' AS ITFFLG, TO_CHAR(SYSDATE, 'YYYYMMDD') AS ITFDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS ITFTIM
			     , 'I' AS PRCFLG
			     , #{LOGSEQNO} AS LOGSEQNO
			     , (
			          CASE WHEN RH.RCPTTY='101' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
			               WHEN RH.RCPTTY='111' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
			               WHEN RH.RCPTTY='114' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
			               WHEN RH.RCPTTY IN ('121', '122') THEN DECODE(RI.STATIT, 'FCV', '648', DECODE(STM.WMSMAK, 'V', '101', '641') )
			               WHEN RH.RCPTTY='131' THEN DECODE(RI.STATIT, 'FCV', '656', '655')
			               WHEN RH.RCPTTY='135' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
			               WHEN RH.RCPTTY='199' THEN '701'
			               ELSE ''
			          END
			         ) AS BWARTSAP
			     , RI.SSORNU
			     , RI.SSORIT
			     , RI.POREV
			     , RI.AR_NO
			     , RI.AR_REV
			     , RI.AR_LNO
			     , #{menuId} AS UI
			     , #{SES_USER_ID} AS REMARK
			     , IF103.C00103 AS C00103
			     , IF103.C00103 AS C00103
			     , IF103.C00103 AS C00103
			     , IF103.C00103 AS C00103
			     , IF103.C00103 AS C00103
			  FROM RECDI RI
			       LEFT JOIN RECDH RH ON RH.RECVKY = RI.RECVKY
			       LEFT OUTER JOIN IFWMS103 IF103 ON IF103.SEQNO = RI.SEQNO AND IF103.EBELN = RI.SEBELN AND IF103.EBELP = RI.SEBELP
			       LEFT OUTER JOIN STLMA STM ON STM.OWNRKY = #{OWNRKY} AND STM.STLKY = RI.LOTA01 AND STM.PLNTKY = RI.LOTA02
			 WHERE RH.OWNRKY = #{OWNRKY}
			   AND RI.RECVKY IN (${RECVKYIN})
		 ) A
	     GROUP BY A.SEBELN, A.SEBELP, A.SKUKEY, A.LOTA01, A.LOTA02, A.LOTA11, A.LOTA15
     ) T1
</select>

<!-- IFWMS203 입고실적정보 등록 SD07 SAP만재고조정 -->
<select id="IFWMS203_SD_IF_LIST" parameterType="Map" resultType="DataMap">
	 SELECT
          'SAP'							AS MANDT
         , SEQ_IFWMS203.NEXTVAL			AS SEQNO
         , '199'						AS BWART
         , #{SKUKEY}					AS MATNR
         , #{UOMKEY}					AS MEINS
         , #{OWNRKY}					AS WERKS
         , TO_CHAR(SYSDATE, 'YYYYMMDD')	AS EINDT
         , 'C'							AS STATUS
         , #{WAREKY}					AS WAREKY
         , #{SKUKEY}					AS SKUKEY
         , #{RECVKY}					AS ZDOC_NO
         , ABS(#{QTTAOR})				AS QTYRCV
         , NVL('100',' ') 				AS ORDCAT
         , NVL(#{LOTA01},' ') AS LOTA01, NVL(#{LOTA02},' ') AS LOTA02, NVL(#{LOTA03},' ') AS LOTA03, NVL(#{LOTA04},' ') AS LOTA04, NVL(#{LOTA05},' ') AS LOTA05
         , NVL(#{LOTA06},' ') AS LOTA06, NVL(#{LOTA07},' ') AS LOTA07, NVL(#{LOTA08},' ') AS LOTA08, NVL(#{LOTA09},' ') AS LOTA09, NVL(#{LOTA10},' ') AS LOTA10
         , NVL(#{LOTA11},' ') AS LOTA11, NVL(#{LOTA12},' ') AS LOTA12, NVL(#{LOTA13},' ') AS LOTA13, NVL(#{LOTA14},' ') AS LOTA14, NVL(#{LOTA15},' ') AS LOTA15
         , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') AS CDATE, TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, NVL(TRIM(#{SES_USER_ID}),#{IFID}) AS CREUSR
         , #{IFID} AS IFID
         , 'I' AS ITFFLG, TO_CHAR(SYSDATE, 'YYYYMMDD') AS ITFDAT
         , TO_CHAR(SYSDATE, 'HH24MISS') AS ITFTIM
         , 'I' 							AS PRCFLG
         , #{LOGSEQNO} 					AS LOGSEQNO
         , '701'						AS BWARTSAP
         , 'X'							AS ZDFF
         , ABS(#{QTTAOR}) 				AS PIKSUM
         , 'SAP만 재고조정' 			AS GR_CHR_ID 
         ,'SD07'						AS UI
         , #{REMARK}					AS REMARK
         , NVL(#{KDAUF},'') 			AS C00103
         , NVL(#{KDPOS},'') 			AS C00104
         , NVL(#{SOBKZ},'')				AS C00105
	FROM DUAL
</select>

<!-- 240131 입고실적(IFWMS203) 프로시저 신규 추가 -->
<insert id="IFWMS203_IF_INSERT" parameterType="Map" statementType="CALLABLE">
	{
		CALL SZP_INS_IFWMS203(
			#{P_TYPE, mode=IN, jdbcType=VARCHAR, javaType=String},
			#{P_JSON_STR, mode=IN, jdbcType=VARCHAR, javaType=String},
			#{P_ERR_CODE, mode=OUT, jdbcType=VARCHAR, javaType=String},
			#{P_ERR_MSG, mode=OUT, jdbcType=VARCHAR, javaType=String}
		)
	}
</insert>

<update id="TB_CARINOUT_MERGE_UPDATE" parameterType="Map">

MERGE INTO TB_CARINOUT T
USING
(
<foreach collection="list" item="i" separator=" UNION ALL ">

SELECT

       #{i.parkingTrnsID} AS PARKING_TRNS_ID

     , NVL(#{i.inEqpmNo},0) AS IN_EQPM_NO
     , NVL(#{i.outEqpmNo},0) AS OUT_EQPM_NO

     , NVL(#{i.carNo},' ') AS CAR_NO
     , NVL(#{i.carNoSub},' ') AS CAR_NO_SUB

     /* 입차일 */
     , CASE
         WHEN #{i.inDtm} IS NULL
           OR TRIM(#{i.inDtm})=''
           OR LOWER(TRIM(#{i.inDtm}))='null'
         THEN NULL
         ELSE SUBSTR(#{i.inDtm},1,8)
       END AS IN_DATE

     /* 입차일시 */
     , CASE
         WHEN #{i.inDtm} IS NULL
           OR TRIM(#{i.inDtm})=''
           OR LOWER(TRIM(#{i.inDtm}))='null'
         THEN NULL
         ELSE TO_DATE(#{i.inDtm},'YYYYMMDDHH24MISS')
       END AS IN_DTM

     /* 출차일 */
     , CASE
         WHEN #{i.outDtm} IS NULL
           OR TRIM(#{i.outDtm})=''
           OR LOWER(TRIM(#{i.outDtm}))='null'
         THEN NULL
         ELSE SUBSTR(REPLACE(REPLACE(#{i.outDtm},'-',''),':',''),1,8)
       END AS OUT_DATE

     /* 출차일시 */
     , CASE
         WHEN #{i.outDtm} IS NULL
           OR TRIM(#{i.outDtm})=''
           OR LOWER(TRIM(#{i.outDtm}))='null'
         THEN NULL

         WHEN INSTR(#{i.outDtm},'-')>0 THEN
              TO_DATE(#{i.outDtm},'YYYY-MM-DD HH24:MI:SS')

         ELSE
              TO_DATE(#{i.outDtm},'YYYYMMDDHH24MISS')
       END AS OUT_DTM

     /* 정산일시 */
     , CASE
         WHEN #{i.payDtm} IS NULL
           OR TRIM(#{i.payDtm})=''
           OR LOWER(TRIM(#{i.payDtm}))='null'
         THEN NULL

         WHEN INSTR(#{i.payDtm},'-')>0 THEN
              TO_DATE(#{i.payDtm},'YYYY-MM-DD HH24:MI:SS')

         ELSE
              TO_DATE(#{i.payDtm},'YYYYMMDDHH24MISS')
       END AS PAY_DTM

     , NVL(#{i.firstFee},0) AS FIRST_FEE
     , NVL(#{i.finalFee},0) AS FINAL_FEE

     , NVL(#{i.carType},0) AS CAR_TYPE
     , NVL(#{i.payStatus},0) AS PAY_STATUS

     /* 정기권 시작 */
     , CASE
         WHEN #{i.cusdefStartDtm} IS NULL
           OR TRIM(#{i.cusdefStartDtm})=''
           OR LOWER(TRIM(#{i.cusdefStartDtm}))='null'
         THEN NULL

         WHEN INSTR(#{i.cusdefStartDtm},'-')>0 THEN
              TO_DATE(#{i.cusdefStartDtm},'YYYY-MM-DD HH24:MI:SS')

         ELSE
              TO_DATE(#{i.cusdefStartDtm},'YYYYMMDDHH24MISS')
       END AS CUSDEF_START_DTM

     /* 정기권 종료 */
     , CASE
         WHEN #{i.cusdefEndDtm} IS NULL
           OR TRIM(#{i.cusdefEndDtm})=''
           OR LOWER(TRIM(#{i.cusdefEndDtm}) )='null'
         THEN NULL

         WHEN INSTR(#{i.cusdefEndDtm},'-')>0 THEN
              TO_DATE(#{i.cusdefEndDtm},'YYYY-MM-DD HH24:MI:SS')

         ELSE
              TO_DATE(#{i.cusdefEndDtm},'YYYYMMDDHH24MISS')
       END AS CUSDEF_END_DTM

     , NVL(#{i.userName},' ') AS USER_NAME
     , NVL(#{i.groupNo},0) AS GROUP_NO
     , NVL(#{i.inCarPicName},' ') AS IN_CAR_PIC_NAME
     , NVL(#{i.outCarPicName},' ') AS OUT_CAR_PIC_NAME
     , NVL(#{i.payBack},0) AS PAY_BACK

FROM DUAL

</foreach>

) S

ON (T.PARKING_TRNS_ID = S.PARKING_TRNS_ID)

WHEN MATCHED THEN
UPDATE SET

      T.IN_EQPM_NO       = S.IN_EQPM_NO
    , T.OUT_EQPM_NO      = S.OUT_EQPM_NO

    , T.CAR_NO           = S.CAR_NO
    , T.CAR_NO_SUB       = S.CAR_NO_SUB

    , T.IN_DATE          = S.IN_DATE
    , T.IN_DTM           = S.IN_DTM

    , T.OUT_DATE         = S.OUT_DATE
    , T.OUT_DTM          = S.OUT_DTM

    , T.PAY_DTM          = S.PAY_DTM

    , T.FIRST_FEE        = S.FIRST_FEE
    , T.FINAL_FEE        = S.FINAL_FEE

    , T.CAR_TYPE         = S.CAR_TYPE
    , T.PAY_STATUS       = S.PAY_STATUS

    , T.CUSDEF_START_DTM = S.CUSDEF_START_DTM
    , T.CUSDEF_END_DTM   = S.CUSDEF_END_DTM

    , T.USER_NAME        = S.USER_NAME

    , T.GROUP_NO         = S.GROUP_NO

    , T.IN_CAR_PIC_NAME  = S.IN_CAR_PIC_NAME
    , T.OUT_CAR_PIC_NAME = S.OUT_CAR_PIC_NAME

    , T.PAY_BACK         = S.PAY_BACK

    , T.MOD_DATE         = SYSDATE

WHEN NOT MATCHED THEN
INSERT
(
      PARKING_TRNS_ID
    , IN_EQPM_NO
    , OUT_EQPM_NO

    , CAR_NO
    , CAR_NO_SUB

    , IN_DATE
    , IN_DTM

    , OUT_DATE
    , OUT_DTM

    , PAY_DTM

    , FIRST_FEE
    , FINAL_FEE

    , CAR_TYPE
    , PAY_STATUS

    , CUSDEF_START_DTM
    , CUSDEF_END_DTM

    , USER_NAME

    , GROUP_NO

    , IN_CAR_PIC_NAME
    , OUT_CAR_PIC_NAME

    , PAY_BACK

    , CRE_DATE
)
VALUES
(
      S.PARKING_TRNS_ID
    , S.IN_EQPM_NO
    , S.OUT_EQPM_NO

    , S.CAR_NO
    , S.CAR_NO_SUB

    , S.IN_DATE
    , S.IN_DTM

    , S.OUT_DATE
    , S.OUT_DTM

    , S.PAY_DTM

    , S.FIRST_FEE
    , S.FINAL_FEE

    , S.CAR_TYPE
    , S.PAY_STATUS

    , S.CUSDEF_START_DTM
    , S.CUSDEF_END_DTM

    , S.USER_NAME

    , S.GROUP_NO

    , S.IN_CAR_PIC_NAME
    , S.OUT_CAR_PIC_NAME

    , S.PAY_BACK

    , SYSDATE
)

</update>
</mapper>