	     , NVL(#{i.MATNR, jdbcType=VARCHAR},' '), NVL(#{i.GAMNG, jdbcType=VARCHAR},0), NVL(#{i.GMEIN, jdbcType=VARCHAR},' '), NVL(#{i.GSTRP, jdbcType=VARCHAR},' '), NVL(#{i.GLTRP, jdbcType=VARCHAR},' '), NVL(#{i.REMARK, jdbcType=VARCHAR},' ')
	     , 1, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
