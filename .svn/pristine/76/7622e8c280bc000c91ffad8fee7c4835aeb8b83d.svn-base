<!-- IFWMS100 생산계획 -->
<insert id="IFWMS100_INSERT" parameterType="Map">
	INSERT INTO IFWMS100
	     (
	       SEQNO, OWNRKY, WERKS
	     , WAREKY
	     , LOTA02, UNITNO
	     , SKUKEY, QTYPRD, UOMKEY, PRDDTS, PRDDTE, REMARK
	     , ITFCNT, ITFDAT, ITFTIM
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID, LOGSEQNO
	     )
	VALUES
	     (
	       SEQ_IFWMS100.NEXTVAL, 'KN', 'KN'
	     , NVL((SELECT WAREKY FROM STLMA WHERE OWNRKY = 'KN' AND PLNTKY = NVL(#{WERKS},' ') AND WAREKY != ' ' AND ROWNUM = 1),' ')
	     , NVL(#{WERKS},' '), NVL(#{MACHINE},' ')
	     , NVL(#{MATNR},' '), NVL(#{GAMNG},' '), NVL(#{GMEIN},' '), NVL(#{GSTRP},' '), NVL(#{GLTRP},' '), NVL(#{REMARK},' ')
	     , 1, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID}, #{LOGSEQNO}
	     )
</insert>

