	                                             AND PRCFLG = 'C' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS223
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND (IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_209',A.IFID) OR IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_213',A.IFID))
	                                                          )
	                                         )
	       END,   0) AS LASTCNT
	     , NVL(
	       CASE WHEN IFTBL = 'IFWMS001' THEN (SELECT COUNT(SEQNO) FROM IFWMS001 WHERE (ITFFLG = 'I' OR PRCFLG = 'I') AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS001 ))
	            WHEN IFTBL = 'IFWMS002' THEN (SELECT COUNT(SEQNO) FROM IFWMS002 WHERE PRCFLG NOT IN ('C','E','D') AND IFID = A.IFID AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS002 WHERE IFID = A.IFID))
	            WHEN IFTBL = 'IFWMS006' THEN (SELECT COUNT(SEQNO) FROM IFWMS006 WHERE PRCFLG NOT IN ('C','E','D') AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS006 ))
