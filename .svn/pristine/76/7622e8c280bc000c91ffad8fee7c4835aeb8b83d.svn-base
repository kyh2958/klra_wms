            #{result, mode=OUT, jdbcType=VARCHAR, javaType=String, resultMap=IFWMS006},
            #{LOGSEQNO},
            #{IFID}
        )
    }
</select>

<update id="IFWMS108_CHKRST_UPDATE" parameterType="Map">
	UPDATE IFWMS108 A
	   SET CHKRST = NVL(#{CHKRST},' ')
	     , CHKRSTG = NVL((SELECT PRCFLG FROM IFWMS223 G1 WHERE LOGSEQNO = A.LOGSEQNO AND ZDOC_NO = A.VGBEL AND ZDOC_ITEM = A.VGPOS AND BWARTSAP = '321' 
	                                                   AND SEQNO = (SELECT MAX(SEQNO) FROM IFWMS223 G2 WHERE G2.SEQNO = G1.SEQNO)), CHKRSTG) -- CHKRSTG 정상건 SAP리턴결과
	     , CHKRSTB = NVL((SELECT PRCFLG FROM IFWMS223 B1 WHERE LOGSEQNO = A.LOGSEQNO AND ZDOC_NO = A.VGBEL AND ZDOC_ITEM = A.VGPOS AND BWARTSAP = '350'
	                                                   AND SEQNO = (SELECT MAX(SEQNO) FROM IFWMS223 B2 WHERE B2.SEQNO = B1.SEQNO)), CHKRSTB) -- CHKRSTB 불량건 SAP리턴결과
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(#{IFID},' ')
	 WHERE LOGSEQNO = #{IF_KEY}
	   AND (VGBEL,VGPOS) IN (SELECT ZDOC_NO, ZDOC_ITEM FROM IFWMS223 WHERE LOGSEQNO = #{IF_KEY} AND SADJKY = #{SADJKY})
<!-- 	   AND VGBEL    = #{VGBEL} -->
<!-- 	   AND VGPOS    = #{VGPOS} -->
</update>

<update id="IFWMS109_CHKRST_UPDATE" parameterType="Map">
	UPDATE IFWMS109 A
	   SET CHKRST = NVL(#{CHKRST},' ')
	     , CHKRSTG = NVL((SELECT PRCFLG FROM IFWMS223 G1 WHERE LOGSEQNO = A.LOGSEQNO AND ZDOC_NO = A.VGBEL AND ZDOC_ITEM = A.VGPOS AND BWARTSAP = '321' 
	                                                   AND SEQNO = (SELECT MAX(SEQNO) FROM IFWMS223 G2 WHERE G2.SEQNO = G1.SEQNO)), CHKRSTG) -- CHKRSTG 정상건 SAP리턴결과
	     , CHKRSTB = NVL((SELECT PRCFLG FROM IFWMS223 B1 WHERE LOGSEQNO = A.LOGSEQNO AND ZDOC_NO = A.VGBEL AND ZDOC_ITEM = A.VGPOS AND BWARTSAP = '350'
	                                                   AND SEQNO = (SELECT MAX(SEQNO) FROM IFWMS223 B2 WHERE B2.SEQNO = B1.SEQNO)), CHKRSTB) -- CHKRSTB 불량건 SAP리턴결과
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(#{IFID},' ')
	 WHERE LOGSEQNO = #{IF_KEY}
	   AND (VGBEL,VGPOS) IN (SELECT ZDOC_NO, ZDOC_ITEM FROM IFWMS223 WHERE LOGSEQNO = #{IF_KEY} AND SADJKY = #{SADJKY})
<!-- 	   AND VGBEL    = #{VGBEL} -->
<!-- 	   AND VGPOS    = #{VGPOS} -->
</update>

