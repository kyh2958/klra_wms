	                                             AND PRCFLG NOT IN ('C','E','D')
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS223
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND (IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_209',A.IFID) OR IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_213',A.IFID))
	                                                          )
	                                         )
	       END,   0) AS LASTING
	     , NVL(
	       CASE WHEN IFTBL = 'IFWMS001' THEN (SELECT COUNT(SEQNO) FROM IFWMS001 WHERE (ITFFLG = 'E' OR PRCFLG = 'E') AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS001 ))
	            WHEN IFTBL = 'IFWMS002' THEN (SELECT COUNT(SEQNO) FROM IFWMS002 WHERE PRCFLG = 'E' AND IFID = A.IFID AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS002 WHERE IFID = A.IFID))
	            WHEN IFTBL = 'IFWMS006' THEN (SELECT COUNT(SEQNO) FROM IFWMS006 WHERE PRCFLG = 'E' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS006 ))
	            WHEN IFTBL = 'IFWMS005' THEN (SELECT COUNT(SEQNO) FROM IFWMS005 WHERE PRCFLG = 'E' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS005 ))
	            WHEN IFTBL = 'IFWMS008' THEN (SELECT COUNT(SEQNO) FROM IFWMS008 WHERE PRCFLG = 'E' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS008 ))
	            WHEN IFTBL = 'IFWMS009' THEN (SELECT COUNT(SEQNO) FROM IFWMS009 WHERE PRCFLG = 'E' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS009 ))
	            WHEN IFTBL = 'IFWMS100' THEN (SELECT COUNT(SEQNO) FROM IFWMS100 WHERE PRCFLG = 'E' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS100 ))
	            WHEN IFTBL = 'IFWMS103' THEN (SELECT COUNT(SEQNO) FROM IFWMS103 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS103
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND IFID = A.IFID
	                                                          )
	                                         )
	            WHEN IFTBL = 'IFWMS108' THEN (SELECT COUNT(SEQNO) FROM IFWMS108 WHERE PRCFLG = 'E' AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS108 ))
	            WHEN IFTBL = 'IFWMS109' THEN (SELECT COUNT(SEQNO) FROM IFWMS109 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS109
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND IFID = A.IFID
	                                                          )
	                                         )
	            WHEN IFTBL = 'IFWMS113' THEN (SELECT COUNT(SEQNO) FROM IFWMS113 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS113
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND IFID = A.IFID
	                                                          )
	                                         )
	            WHEN IFTBL = 'IFWMS203' THEN (SELECT COUNT(SEQNO) FROM IFWMS203 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS203
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND IFID = A.IFID
	                                                          )
	                                         )
	            WHEN IFTBL = 'IFWMS209' THEN (SELECT COUNT(SEQNO) FROM IFWMS209 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS209
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND IFID = A.IFID
	                                                          )
	                                         )
	            WHEN IFTBL = 'IFWMS213' THEN (SELECT COUNT(SEQNO) FROM IFWMS213 
	                                           WHERE IFID = A.IFID AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS213
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND IFID = A.IFID
	                                                          )
	                                         )
	            WHEN IFTBL = 'IFWMS223' THEN (SELECT COUNT(SEQNO) FROM IFWMS223 
	                                           WHERE (IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_209',A.IFID) OR IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_213',A.IFID))
	                                             AND PRCFLG = 'E' 
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1
	                                                          )
	                                             AND CREDAT = (SELECT MAX(CREDAT) FROM IFWMS223
	                                                            WHERE BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                                              AND (IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_209',A.IFID) OR IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_213',A.IFID))
	                                                          )
	                                         )
	       END,   0) AS LASTERR
	     , NVL(
	       CASE WHEN IFTBL = 'IFWMS001' THEN (SELECT MAX(CREDAT) FROM IFWMS001)
	            WHEN IFTBL = 'IFWMS002' THEN (SELECT MAX(CREDAT) FROM IFWMS002 WHERE IFID = A.IFID)
	            WHEN IFTBL = 'IFWMS006' THEN (SELECT MAX(CREDAT) FROM IFWMS006)
	            WHEN IFTBL = 'IFWMS005' THEN (SELECT MAX(CREDAT) FROM IFWMS005)
	            WHEN IFTBL = 'IFWMS008' THEN (SELECT MAX(CREDAT) FROM IFWMS008)
	            WHEN IFTBL = 'IFWMS009' THEN (SELECT MAX(CREDAT) FROM IFWMS009)
	            WHEN IFTBL = 'IFWMS100' THEN (SELECT MAX(CREDAT) FROM IFWMS100)
	            WHEN IFTBL = 'IFWMS103' THEN (SELECT MAX(CREDAT) FROM IFWMS103
	                                           WHERE IFID = A.IFID
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                         )
	            WHEN IFTBL = 'IFWMS108' THEN (SELECT MAX(CREDAT) FROM IFWMS108)
	            WHEN IFTBL = 'IFWMS109' THEN (SELECT MAX(CREDAT) FROM IFWMS109
	                                           WHERE IFID = A.IFID
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                         )
	            WHEN IFTBL = 'IFWMS113' THEN (SELECT MAX(CREDAT) FROM IFWMS113
	                                           WHERE IFID = A.IFID
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                         )
	            WHEN IFTBL = 'IFWMS203' THEN (SELECT MAX(CREDAT) FROM IFWMS203
	                                           WHERE IFID = A.IFID
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                         )
	            WHEN IFTBL = 'IFWMS209' THEN (SELECT MAX(CREDAT) FROM IFWMS209
	                                           WHERE IFID = A.IFID
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                         )
	            WHEN IFTBL = 'IFWMS213' THEN (SELECT MAX(CREDAT) FROM IFWMS213
	                                           WHERE IFID = A.IFID
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                         )
	            WHEN IFTBL = 'IFWMS223' THEN (SELECT MAX(CREDAT) FROM IFWMS223
	                                           WHERE (IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_209',A.IFID) OR IFID = DECODE(A.IFID,'WMS_IF_209213','WMS_IF_213',A.IFID))
	                                             AND BWART IN (SELECT REGEXP_SUBSTR(BWART, '[^,]+',1,level) FROM (SELECT BWART FROM ITFMA WHERE IFID = A.IFID AND DELMAK != 'V') B
	                                                           CONNECT BY LEVEL &lt;= LENGTH(REGEXP_REPLACE(BWART,'[^,]+',''))+1)
	                                         )
	       END, ' ') AS LASTDAT
	  FROM ITFMA A
	 WHERE DELMAK != 'V'
	 <if test="RANGE_SQL != null and RANGE_SQL != ' '.toString() and RANGE_SQL != ''.toString()">
		${RANGE_SQL}
	 </if>
	 ORDER BY SEQNO
</select>

<select id="IFDETAIL_LIST" parameterType="Map" resultType="DataMap">
	SELECT *
	  FROM ${IFTBL}
	 WHERE CREDAT = NVL(TRIM(#{LASTDAT}), #{CREDAT})
	<if test="BWART != null and BWART != ' '.toString() and BWART != ''.toString()">
	   AND NVL(TRIM(BWART),0) IN (${BWART})
	</if>
	   AND (IFID = DECODE(#{IFID},'WMS_IF_209213','WMS_IF_209',#{IFID}) OR IFID = DECODE(#{IFID},'WMS_IF_209213','WMS_IF_213',#{IFID}))
	 ORDER BY SEQNO DESC, CREDAT DESC, CRETIM DESC
</select>

<select id="IFUSR_LIST" parameterType="Map" resultType="DataMap">
	SELECT A.*
	     , NVL(RECV_FLAG,'I') AS PRCFLG
	     , IF_SEQ             AS LOGSEQNO
	     , RECV_ERR_MSG       AS PRCETX
	     , TO_CHAR(IF_DATE,'YYYYMMDD')   AS CREDAT
	     , TO_CHAR(IF_DATE,'HH24MISS')   AS CRETIM
	     , 'NEXTHR'                      AS CREUSR
	     , TO_CHAR(UPDT_DATE,'YYYYMMDD') AS LMODAT
	     , TO_CHAR(UPDT_DATE,'HH24MISS') AS LMOTIM
	     , UPDT_ID                       AS LMOUSR
	  FROM ${IFTBL} A
	 WHERE RECV_DATE BETWEEN TO_DATE(NVL(TRIM(#{LASTDAT}), #{CREDAT}) || '000000','YYYYMMDDHH24MISS')
	                   AND TO_DATE(NVL(TRIM(#{LASTDAT}), #{CREDAT}) || '235959','YYYYMMDDHH24MISS')
</select>

<!-- 수동 수신작업 가능여부 체크 -->
<select id="IFRCVAVAIL_MAP" parameterType="Map" resultType="DataMap">
	SELECT A.IFSTAT
	     , B.MAXDT
	  FROM ITFMA A
	     , (SELECT IFID, MAX(CRETIM) AS MAXDT
	          FROM IFWMSLOG
	         WHERE IFID = #{IFID}
	           AND CREDAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
	         GROUP BY IFID) B
	 WHERE A.IFID = #{IFID}
	   AND B.IFID = A.IFID
</select>

<!-- 수신데이터 조회이전 금일 MAX SEQNO -->
<select id="IFRCVMAXPREVSEQ_MAP" parameterType="Map" resultType="DataMap">
	SELECT MAX(SEQNO) AS SEQNO
	  FROM ${IFTBL}
	 WHERE CREDAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
	   AND WERKS = NVL(#{OWNRKY}, 'KN')
	<if test="BWART != null and BWART != ' '.toString() and BWART != ''.toString()">
	   AND BWART IN (${BWART})
	</if>
	   AND IFID = #{IFID}
</select>

<!-- 수신데이터 조회 -->
<select id="IFRECEIVE_LIST" parameterType="Map" resultType="DataMap">
	SELECT *
	  FROM ${IFTBL}
	 WHERE CREDAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
	   AND WERKS = NVL(#{OWNRKY}, 'KN')
	<if test="BWART != null and BWART != ' '.toString() and BWART != ''.toString()">
	   AND BWART IN (${BWART})
	</if>
	   AND IFID = #{IFID}
	   AND SEQNO > NVL(#{PREVSEQNO}, 0)
	 ORDER BY SEQNO DESC
</select>

<!-- IFWMS001 품목 -->
<insert id="IFWMS001_INSERT" parameterType="Map">
	INSERT INTO IFWMS001
	     (
	       MANDT, SEQNO, PLNTKY, MATNR, WERKS
	     , MTART, MEINS, MATKL, GROES
	     , NTGEW, BRGEW, GEWEI, LVORM, SKUKEY
	     , DESC01, MHDHB
	     , SKUG02, PASTKY
	     , ALSTKY, SPART, QRTAYN, STLKY
	     , MSTAE, XCHPF
	     , ZCODE, ZCODE_NM, ZWEIGHT, ZWIDTH, ZDEPTH, MTYPE
	     , MSTDE
	     , ITFCNT, ITFDAT, ITFTIM
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID, LOGSEQNO
	     )
	VALUES
	     (
	       NVL(#{MANDT},'100'), SEQ_IFWMS001.NEXTVAL, NVL(#{WERKS},' '), NVL(#{MATNR},' '), 'KN'
	     , NVL(#{MTART},' '), NVL(#{MEINS} ,' '), NVL(#{ZPRDTYP} ,' '), NVL(#{VOLUM},0)
	     , NVL(#{NTGEW},0), NVL(#{BRGEW},0), NVL(#{GEWEI},' '), NVL(#{LVORM},' '), NVL(#{MATNR},' ')
	     , NVL(#{MAKTX},' '), NVL(#{MHDHB},0)
	     , NVL(#{ZSKUG02},' '), 'STD'
	     , 'STD', NVL(#{SPART},' '), NVL(#{ZQRTAYN},' '), NVL(#{LGFSB},' ')
	     , NVL(#{MSTAE},' '), NVL(#{XCHPF},' ')
	     , NVL(#{ZCODE},' '), NVL(#{ZCODE_NM},' '), NVL(#{ZWEIGHT},' '), NVL(#{ZWIDTH},' '), NVL(#{ZDEPTH},' '), NVL(#{MTYPE},' ')
	     , NVL(#{MSTDE},' ')
	     , 1, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID}, #{LOGSEQNO}
	     )
</insert>

<insert id="IFWMS001_MULTI_INSERT" parameterType="Map">
	INSERT INTO IFWMS001
	     (
	       MANDT, SEQNO, PLNTKY, MATNR, WERKS
	     , MTART, MEINS, MATKL, GROES
	     , NTGEW, BRGEW, GEWEI, LVORM, SKUKEY
	     , DESC01, MHDHB
	     , SKUG02, PASTKY
	     , ALSTKY, SPART, QRTAYN, STLKY
	     , MSTAE, XCHPF
	     , ZCODE, ZCODE_NM, ZWEIGHT, ZWIDTH, ZDEPTH, MTYPE
	     , MSTDE
	     , ITFCNT, ITFDAT, ITFTIM
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID, LOGSEQNO
	     )
		<foreach item="i" index="index" collection="list" open=" " separator=" UNION ALL " close="">
	SELECT
	       NVL(#{i.MANDT, jdbcType=VARCHAR},'100'), F_GET_SEQ_MULTICASE('IFWMS001'), NVL(#{i.WERKS, jdbcType=VARCHAR},' '), NVL(#{i.MATNR, jdbcType=VARCHAR},' '), 'KN'
	     , NVL(#{i.MTART, jdbcType=VARCHAR},' '), NVL(#{i.MEINS, jdbcType=VARCHAR} ,' '), NVL(#{i.ZPRDTYP, jdbcType=VARCHAR} ,' '), NVL(#{i.VOLUM, jdbcType=VARCHAR},0)
	     , NVL(#{i.NTGEW, jdbcType=VARCHAR},0), NVL(#{i.BRGEW, jdbcType=VARCHAR},0), NVL(#{i.GEWEI, jdbcType=VARCHAR},' '), NVL(#{i.LVORM, jdbcType=VARCHAR},' '), NVL(#{i.MATNR, jdbcType=VARCHAR},' ')
	     , NVL(#{i.MAKTX, jdbcType=VARCHAR},' '), NVL(#{i.MHDHB, jdbcType=VARCHAR},0)
	     , NVL(#{i.ZSKUG02, jdbcType=VARCHAR},' '), 'STD'
	     , 'STD', NVL(#{i.SPART, jdbcType=VARCHAR},' '), NVL(#{i.ZQRTAYN, jdbcType=VARCHAR},' '), NVL(#{i.LGFSB, jdbcType=VARCHAR},' ')
	     , NVL(#{i.MSTAE, jdbcType=VARCHAR},' '), NVL(#{i.XCHPF, jdbcType=VARCHAR},' ')
	     , NVL(#{i.ZCODE, jdbcType=VARCHAR},' '), NVL(#{i.ZCODE_NM, jdbcType=VARCHAR},' '), NVL(#{i.ZWEIGHT, jdbcType=VARCHAR},' '), NVL(#{i.ZWIDTH, jdbcType=VARCHAR},' '), NVL(#{i.ZDEPTH, jdbcType=VARCHAR},' '), NVL(#{i.MTYPE, jdbcType=VARCHAR},' ')
	     , NVL(#{i.MSTDE, jdbcType=VARCHAR},' ')
	     , 1, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{i.SES_USER_ID, jdbcType=VARCHAR}),#{i.IFID, jdbcType=VARCHAR})
	     , #{i.IFID, jdbcType=VARCHAR}, #{i.LOGSEQNO, jdbcType=VARCHAR}
	  FROM DUAL
		</foreach>
</insert>

<update id="IFWMS001_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS001
	   SET ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE IFID = #{IFID}
	   AND LOGSEQNO = #{LOGSEQNO}
</update>

<resultMap id="IFWMS001" type="hashmap"></resultMap>
<select id="IFWMS001_MAP" parameterType="Map" statementType="CALLABLE">
    {
        CALL ITF_IFWMS001(
            #{result, mode=OUT, jdbcType=VARCHAR, javaType=String, resultMap=IFWMS001},
            #{LOGSEQNO},
            NVL(TRIM(#{SES_USER_ID}),#{IFID})
        )
    }
</select>

<!-- IFWMS002 거래처 -->
<insert id="IFWMS002_VD_INSERT" parameterType="Map">
	INSERT INTO IFWMS002
	     (
	       MANDT, SEQNO
	     , ZCLASSIFIER
	     , ZCODE, NAME1
	     , PSTLZ, LAND1, TELF1, TELF2, TELFX
	     , STCD2, J_1KFREPRE, LOEVM
	     , ADDR, ADDR2, REGIO, WERKS
	     , PTNL03, PTNL04
	     , ITFCNT, ITFDAT, ITFTIM
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID, LOGSEQNO
	     )
	 VALUES
	     (
	       NVL(#{MANDT}, '100'), SEQ_IFWMS002.NEXTVAL
	     , DECODE(#{IFID}, 'WMS_IF_103', 'VD', 'WMS_IF_104', 'CT', 'WMS_IF_109', 'CT', ' ')
	     , NVL(#{LIFNR}, ' '), NVL(#{NAME1},' ')
	     , NVL(#{PSTLZ},' '), NVL(#{LAND1},' '), NVL(#{TELF1},' '), NVL(#{TELF2},' '), NVL(#{TELFX},' ')
	     , NVL(#{STCD2},' '), NVL(#{J_1KFREPRE},' '), NVL(#{LOEVM},' ')
