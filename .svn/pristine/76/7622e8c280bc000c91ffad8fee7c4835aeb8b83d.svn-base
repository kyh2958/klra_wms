<!-- IFWMS103 입고예정 -->
<insert id="IFWMS103_INSERT" parameterType="Map">
	INSERT INTO IFWMS103
	     (
	       MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , LIFNR
	     , BWART
	     , LOEKZ
	     , BEDAT
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , EINDT
	     , MENGE_B
	     , VGBEL
	     , VGPOS
	     , STATUS
	     , WAREKY
	     , SKUKEY
	     , ORDCAT
	     , PTNRTY
	     , RTNSHP
	     , RTNSIT
	     , RTNRSN
	     , RTNTXT
	     , REMARK
	     , SPONUM --출고시 오더번호
	     , SPOSNR --출고시 오더아이템번호
	     , LOTA01
	     , LOTA02
	     , LOTA03
	     , LOTA04
	     , LOTA05
	     , LOTA06
	     , LOTA07
	     , LOTA08
	     , LOTA09
	     , LOTA10
	     , LOTA11
	     , LOTA12
	     , LOTA13
	     , LOTA14
	     , LOTA15
	     , LOTA16
	     , LOTA17
	     , LOTA18
	     , LOTA19
	     , LOTA20
	     , LOTA21
	     , LOTA22
	     , LOTA23
	     , LOTA24
	     , BSART
	     , BWARTSAP
	     , STKNUM
	     , SIGNI
	     , FLOTA01
	     , FLOTA02
	     , MRFLG
	     , SOBKZ
	     , VBELV
	     , POSNV
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , VTWEG
	     )
	 VALUES
	     (
	       CASE WHEN #{IFID} = 'WMS_IF_202' THEN 'PTL' --포탈구매입고
	            WHEN #{IFID} = 'WMS_IF_203' THEN '100' --SAP구매입고
	            WHEN #{IFID} = 'WMS_IF_204' THEN '100' --이송입고
	            WHEN #{IFID} = 'WMS_IF_205' THEN 'MES' --생산입고
	            WHEN #{IFID} IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN '100' --반품입고
	            WHEN #{IFID} = 'WMS_IF_207' THEN 'MES' --반납입고
	            WHEN #{IFID} = 'WMS_IF_220' THEN '100' --고지입고
	            WHEN #{IFID} = 'WMS_IF_2041' THEN '100' --임가공입고
	       END --MANDT
	     , SEQ_IFWMS103.NEXTVAL
	     , NVL(#{EBELN},' ')
	     , NVL(#{EBELP},' ')
	     , NVL(#{LIFNR},' ') -- LIFNR
	     , CASE WHEN #{IFID} = 'WMS_IF_202' THEN '111' --포탈구매입고
	            WHEN #{IFID} = 'WMS_IF_203' THEN '113' --SAP구매입고
	            WHEN #{IFID} = 'WMS_IF_204' THEN '121' --이송입고
	            WHEN #{IFID} = 'WMS_IF_205' THEN '101' --생산입고
	            WHEN #{IFID} IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN '131' --반품입고
	            WHEN #{IFID} = 'WMS_IF_207' THEN '135' --반납입고
	            WHEN #{IFID} = 'WMS_IF_220' THEN '114' --고지입고
	            WHEN #{IFID} = 'WMS_IF_2041' THEN '122' --임가공입고
	       END --BWART
	     , NVL(#{LOEKZ},' ')
	     , NVL(#{BEDAT},' ')
	     , NVL(#{MATNR},' ')
	     , NVL(#{MENGE},0)
	     , NVL(#{MEINS},' ')
	     , 'KN'
	     , NVL(#{EINDT},' ')
	     , NVL(#{MENGE_B},0)
	     , NVL(#{VGBEL},' ')
	     , NVL(#{VGPOS},' ')
	     , NVL(#{STATUS},'C')
	     , NVL((SELECT WAREKY FROM STLMA WHERE OWNRKY = 'KN' AND PLNTKY = NVL(#{LOTA02},' ') AND STLKY = NVL(TRIM(#{LOTA01}),STLKY) AND WAREKY != ' ' AND ROWNUM = 1),' ') --WAREKY
	     , NVL(#{MATNR},' ') --SKUKEY
	     , NVL(#{ORDCAT},'100')
	     , CASE WHEN #{IFID} IN ('WMS_IF_204','WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN NVL(#{PTNRTY},'CT')
	            ELSE NVL(#{PTNRTY},'VD')
	       END --PTNRTY 반품입고시 CT 그외 VD
	     , NVL(#{RTNSHP},' ')
	     , NVL(#{RTNSIT},' ')
	     , NVL(#{RTNRSN},' ')
	     , NVL(#{RTNTXT},' ')
	     , NVL(#{REMARK},' ')
	     , NVL(#{SPONUM},' ') --출고시 오더번호
	     , NVL(#{SPOSNR},' ') --출고시 오더아이템번호
	     , NVL(#{LOTA01},' ')
	     , NVL(#{LOTA02},' ')
	     , NVL(#{LOTA03},' ')
	     , NVL(#{LOTA04},' ')
	     , NVL(#{LOTA05},' ')
	     , CASE WHEN #{IFID} IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN '05' -- 반품시 품질로
	            ELSE NVL(#{LOTA06},'00')
	       END
	     , CASE WHEN #{IFID}  = 'WMS_IF_204' AND #{SOBKZ} = 'E' THEN NVL(#{LOTA07},' ') --이송입고
	            WHEN #{IFID} != 'WMS_IF_204' THEN NVL(#{LOTA07},' ')
	            ELSE ' '
	       END --LOTA07
	     , NVL(#{LOTA08},' ')
	     , CASE WHEN #{IFID}  = 'WMS_IF_204' AND #{SOBKZ} = 'E' THEN NVL(#{LOTA09},' ') --이송입고
	            WHEN #{IFID} != 'WMS_IF_204' THEN NVL(#{LOTA09},' ')
	            ELSE ' '
	       END --LOTA09
	     , NVL(#{LOTA10},' ')
	     , NVL(#{LOTA11},' ')
	     , NVL(#{LOTA12},' ')
	     , NVL(#{LOTA13},' ')
	     , NVL(#{LOTA14},' ')
	     , NVL(#{LOTA15},' ')
	     , NVL(TRIM(#{LOTA16}),0)
	     , NVL(TRIM(#{LOTA17}),' ')
	     , NVL(TRIM(#{LOTA18}),0)
	     , NVL(TRIM(#{LOTA19}),0)
	     , NVL(TRIM(#{LOTA20}),0)
	     , NVL(#{LOTA21},' ')
	     , NVL(#{LOTA22},' ')
	     , NVL(#{LOTA23},' ')
	     , NVL(#{LOTA24},' ')
	     , NVL(#{BSART},' ')
	     , NVL(#{BWARTSAP},' ')
	     , NVL(#{STKNUM},' ')
	     , CASE WHEN #{IFID} = 'WMS_IF_204' AND #{MRFLG} = 'S0' THEN NVL(#{SIGNI},' ') --이송 밀롤일경우 컨테이너ID를 배치번호로 대체 : 다시 원복 LOTA15를 SIGNI로
	            ELSE NVL(#{SIGNI},' ')
	       END --SIGNI
	     , NVL(#{FLOTA01},' ')
	     , NVL(#{FLOTA02},' ')
	     , NVL(#{MRFLG},' ')
	     , NVL(#{SOBKZ},' ')
	     , NVL(#{VBELV},' ')
	     , NVL(#{POSNV},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID}
	     , 'N' --IFFLG
	     , 'C', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'C' --PRCFLG
	     , #{LOGSEQNO}
	     , NVL(#{VTWEG},' ')
	     )
</insert>

<!-- IFWMS103 입고예정 -->
<insert id="IFWMS103_MULTI_INSERT" parameterType="Map">
	INSERT INTO IFWMS103
	     (
	       MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , LIFNR
	     , BWART
	     , LOEKZ
	     , BEDAT
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , EINDT
	     , MENGE_B
	     , VGBEL
	     , VGPOS
	     , STATUS
	     , WAREKY
	     , SKUKEY
	     , ORDCAT
	     , PTNRTY
	     , RTNSHP
	     , RTNSIT
	     , RTNRSN
	     , RTNTXT
	     , REMARK
	     , SPONUM --출고시 오더번호
	     , SPOSNR --출고시 오더아이템번호
	     , LOTA01
	     , LOTA02
	     , LOTA03
	     , LOTA04
	     , LOTA05
	     , LOTA06
	     , LOTA07
	     , LOTA08
	     , LOTA09
	     , LOTA10
	     , LOTA11
	     , LOTA12
	     , LOTA13
	     , LOTA14
	     , LOTA15
	     , LOTA16
	     , LOTA17
	     , LOTA18
	     , LOTA19
	     , LOTA20
	     , LOTA21
	     , LOTA22
	     , LOTA23
	     , LOTA24
	     , BSART
	     , BWARTSAP
	     , STKNUM
	     , SIGNI
	     , FLOTA01 -- 임가공/이송 (구성품 저장위치)
	     , FLOTA02 -- 임가공/이송 (구성품 출고플랜트)
	     , MRFLG
	     , SOBKZ
	     , VBELV
	     , POSNV
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , VTWEG

	     , N00101	-- 임가공 (단가)
	     , C00101	-- 임가공 (통화)
	     , C00102	-- 임가공 (구성품 자재코드)
	     , N00102	-- 임가공 (구성품 출고수량)
	     , C00103	-- 임가공 (구성품 배치번호)
	     , C00104	-- 임가공 (구성품 자재단위)

	     )
		<foreach item="i" index="index" collection="list" open=" " separator=" UNION ALL " close="">
	SELECT
	       CASE WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_202' THEN 'PTL' --포탈구매입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_203' THEN '100' --SAP구매입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_204' THEN '100' --이송입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_205' THEN 'MES' --생산입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN '100' --반품입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_207' THEN 'MES' --반납입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_220' THEN '100' --고지입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_2041' THEN '100' --임가공입고
	       END --MANDT
	     , F_GET_SEQ_MULTICASE('IFWMS103')
	     , NVL(#{i.EBELN, jdbcType=VARCHAR},' ')
	     , NVL(#{i.EBELP, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LIFNR, jdbcType=VARCHAR},' ') -- LIFNR
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_202' THEN '111' --포탈구매입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_203' THEN '113' --SAP구매입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_204' THEN '121' --이송입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_205' THEN '101' --생산입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN '131' --반품입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_207' THEN '135' --반납입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_220' THEN '114' --고지입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_2041' THEN '122' --고지입고
	       END --BWART
	     , NVL(#{i.LOEKZ, jdbcType=VARCHAR},' ')
	     , NVL(#{i.BEDAT, jdbcType=VARCHAR},' ')
	     , NVL(#{i.MATNR, jdbcType=VARCHAR},' ')
	     , NVL(#{i.MENGE, jdbcType=VARCHAR},0)
	     , NVL(#{i.MEINS, jdbcType=VARCHAR},' ')
	     , 'KN'
	     , NVL(#{i.EINDT, jdbcType=VARCHAR},' ')
	     , NVL(#{i.MENGE_B, jdbcType=VARCHAR},0)
	     , NVL(#{i.VGBEL, jdbcType=VARCHAR},' ')
	     , NVL(#{i.VGPOS, jdbcType=VARCHAR},' ')
	     , NVL(#{i.STATUS, jdbcType=VARCHAR},'C')
	     , NVL((SELECT WAREKY FROM STLMA WHERE OWNRKY = 'KN' AND PLNTKY = NVL(#{i.LOTA02, jdbcType=VARCHAR},' ') AND STLKY = NVL(TRIM(#{i.LOTA01, jdbcType=VARCHAR}),STLKY) AND WAREKY != ' ' AND ROWNUM = 1),' ') --WAREKY
	     , NVL(#{i.MATNR, jdbcType=VARCHAR},' ') --SKUKEY
	     , NVL(#{i.ORDCAT, jdbcType=VARCHAR},'100')
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_204', 'WMS_IF_2041', 'WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN NVL(#{i.PTNRTY, jdbcType=VARCHAR},'CT')
	            ELSE NVL(#{i.PTNRTY, jdbcType=VARCHAR},'VD')
	       END --PTNRTY
	     , NVL(#{i.RTNSHP, jdbcType=VARCHAR},' ')
	     , NVL(#{i.RTNSIT, jdbcType=VARCHAR},' ')
	     , NVL(#{i.RTNRSN, jdbcType=VARCHAR},' ')
	     , NVL(#{i.RTNTXT, jdbcType=VARCHAR},' ')
	     , NVL(#{i.REMARK, jdbcType=VARCHAR},' ')
	     , NVL(#{i.SPONUM, jdbcType=VARCHAR},' ') --출고시 오더번호
	     , NVL(#{i.SPOSNR, jdbcType=VARCHAR},' ') --출고시 오더아이템번호
	     , NVL(#{i.LOTA01, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA02, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA03, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA04, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA05, jdbcType=VARCHAR},' ')
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_206', 'WMS_IFC206', 'WMS_IFB206', 'WMS_IFS206') THEN '05' -- 반품시 품질로
	            ELSE NVL(#{i.LOTA06, jdbcType=VARCHAR},'00')
	       END
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR}  = 'WMS_IF_204' AND #{i.SOBKZ, jdbcType=VARCHAR} = 'E' THEN NVL(#{i.LOTA07, jdbcType=VARCHAR},' ') --이송입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} != 'WMS_IF_204' THEN NVL(#{i.LOTA07, jdbcType=VARCHAR},' ')
	            ELSE ' '
	       END --LOTA07
	     , NVL(#{i.LOTA08, jdbcType=VARCHAR},' ')
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR}  = 'WMS_IF_204' AND #{i.SOBKZ, jdbcType=VARCHAR} = 'E' THEN NVL(#{i.LOTA09, jdbcType=VARCHAR},' ') --이송입고
	            WHEN #{i.IFID, jdbcType=VARCHAR} != 'WMS_IF_204' THEN NVL(#{i.LOTA09, jdbcType=VARCHAR},' ')
	            ELSE ' '
	       END --LOTA09
	     , NVL(#{i.LOTA10, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA11, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA12, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA13, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA14, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA15, jdbcType=VARCHAR},' ')
	     , NVL(TRIM(#{i.LOTA16, jdbcType=VARCHAR}),0)
	     , NVL(TRIM(#{i.LOTA17, jdbcType=VARCHAR}),' ')
	     , NVL(TRIM(#{i.LOTA18, jdbcType=VARCHAR}),0)
	     , NVL(TRIM(#{i.LOTA19, jdbcType=VARCHAR}),0)
	     , NVL(TRIM(#{i.LOTA20, jdbcType=VARCHAR}),0)
	     , NVL(#{i.LOTA21, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA22, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA23, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA24, jdbcType=VARCHAR},' ')
	     , NVL(#{i.BSART, jdbcType=VARCHAR},' ')
	     , NVL(#{i.BWARTSAP, jdbcType=VARCHAR},' ')
	     , NVL(#{i.STKNUM, jdbcType=VARCHAR},' ')
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR}  = 'WMS_IF_204' AND #{i.MRFLG, jdbcType=VARCHAR} = 'S0' THEN NVL(#{i.SIGNI, jdbcType=VARCHAR},' ') --이송 밀롤일경우 컨테이너ID를 배치번호로 대체 : 다시 원복 LOTA15를 SIGNI로
	            ELSE NVL(#{i.SIGNI, jdbcType=VARCHAR},' ')
	       END --SIGNI
	     , CASE 
	     	WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_2041' THEN
	            NVL(#{i.LOTA01, jdbcType=VARCHAR}, ' ')
        	ELSE NVL(#{i.FLOTA01, jdbcType=VARCHAR}, ' ')
       	   END
	     , NVL(#{i.FLOTA02, jdbcType=VARCHAR},' ')
	     , NVL(#{i.MRFLG, jdbcType=VARCHAR},' ')
	     , NVL(#{i.SOBKZ, jdbcType=VARCHAR},' ')
	     , NVL(#{i.VBELV, jdbcType=VARCHAR},' ')
	     , NVL(#{i.POSNV, jdbcType=VARCHAR},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{i.SES_USER_ID, jdbcType=VARCHAR}),#{i.IFID, jdbcType=VARCHAR})
	     , #{i.IFID, jdbcType=VARCHAR}
	     , 'N' --IFFLG
	     , 'C', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'C' --PRCFLG
	     , #{i.LOGSEQNO, jdbcType=VARCHAR}
	     , #{i.VTWEG, jdbcType=VARCHAR}
	     
	     , NVL(#{i.N00101, jdbcType=VARCHAR}, 0)
	     , NVL(#{i.C00101, jdbcType=VARCHAR}, ' ')
	     , NVL(#{i.C00102, jdbcType=VARCHAR}, ' ')
	     , NVL(#{i.N00102, jdbcType=VARCHAR}, 0)
	     , NVL(#{i.C00103, jdbcType=VARCHAR}, ' ')
	     , NVL(#{i.C00104, jdbcType=VARCHAR}, ' ')	     
	  FROM DUAL
		</foreach>
</insert>

<update id="IFWMS103_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS103
	   SET ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE IFID = #{IFID}
	   AND LOGSEQNO = #{LOGSEQNO}
</update>

<!-- 삭제요청건 기존 오더 존재여부 체크 MES 수신건 -->
<select id="IFWMS103_EXIST_MAP" parameterType="Map" resultType="DataMap">
	SELECT SEQNO, EBELN, EBELP, IFFLG
	  FROM IFWMS103
	 WHERE 1 = 1
	  <!-- AND EBELN = #{EBELN} -->
	  <!-- AND EBELP = #{EBELP} -->
	   AND LOTA14 = #{LOTA14} 
	   AND LOTA15 = #{LOTA15}
	   AND STATUS != 'D'
	   AND ROWNUM = 1
</select>

<!-- 입고진행 여부 체크 MES 수신건 : (수정,삭제 수신시) -->
<select id="IFWMS103_CHK_MAP" parameterType="Map" resultType="DataMap">
	SELECT SEQNO, EBELN, EBELP, IFFLG
	  FROM IFWMS103
	 WHERE (IFFLG = 'Y' OR MENGE_R != 0 OR DLEFLG = 'Y')
	   <!-- AND EBELN = #{EBELN}  -->
	   <!-- AND EBELP = #{EBELP}  -->
	   AND LOTA14 = #{LOTA14}
	   AND LOTA15 = #{LOTA15}
	   AND IFID   = #{IFID} 
	   AND ROWNUM = 1
</select>

<!-- LOTA14개별바코드 중복건 체크 MES 수신건 -->
<select id="IFWMS103_LOTA14_CHK_MAP" parameterType="Map" resultType="DataMap">
	SELECT SEQNO, EBELN, EBELP, IFFLG
	  FROM IFWMS103 A
	 WHERE STATUS = 'C'
	   AND PRCFLG = 'C'
	   AND LOTA14 = #{LOTA14}
	   AND CREDAT >= TO_CHAR(SYSDATE-14, 'YYYYMMDD')
	   AND IFID = 'WMS_IF_205'
	   AND ( NOT EXISTS (SELECT '1' FROM IFWMS203 B
	                    WHERE B.EBELN = A.EBELN 
	                      AND B.EBELP = A.EBELP 
	                      AND B.IFID = 'WMS_IF_222' 
	                      AND B.CDATE > A.CDATE 
	                      AND B.STATUS = 'D')
          	 OR EXISTS (SELECT 1 FROM RECDI C
                   	  	 WHERE 1 = 1
                   	       AND A.EBELN != C.SEBELN
                   	       AND A.LOTA14 = C.LOTA14 
                   	       AND C.STATIT = 'FRV')
	       )
	   AND ROWNUM = 1
</select>

<!-- 기존 미진행건 삭제처리 MES 수신건 : UPDATE (수정,삭제 수신시) -->
<update id="IFWMS103_UD_UPDATE" parameterType="Map">
	UPDATE IFWMS103
	   SET REMARK = STATUS || ' >> D 기존 미진행건 삭제처리'
	     , IFFLG  = 'D'
	     , STATUS = 'D'
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	 WHERE IFFLG   = 'N'
	   AND MENGE_R = 0
	   AND LOTA14  = #{LOTA14}
	   AND LOTA15  = #{LOTA15}
	   AND IFID    = #{IFID} 
	   <!-- AND EBELN = #{EBELN} -->
	   <!-- AND EBELP = #{EBELP} -->
</update>

<!-- 입고진행 여부 체크 SAP 수신건 : (수정,삭제 수신시) -->
<select id="IFWMS103_SAP_CHK_MAP" parameterType="Map" resultType="DataMap">
	SELECT SEQNO, EBELN, EBELP, IFFLG
	  FROM IFWMS103 A
	 WHERE (IFFLG = 'Y' OR MENGE_R != 0)
	   AND LOGSEQNO != #{LOGSEQNO}
<!-- 	   AND (EBELN, EBELP) IN (SELECT EBELN, EBELP FROM IFWMS103 WHERE LOGSEQNO = #{LOGSEQNO} AND EBELN = A.EBELN AND EBELP = A.EBELP) -->
	   AND EBELN IN (SELECT DISTINCT EBELN FROM IFWMS103 WHERE LOGSEQNO = #{LOGSEQNO} AND EBELN = A.EBELN)
	   AND ROWNUM = 1
</select>

<!-- 기존 미진행건 삭제처리 SAP 수신건 : UPDATE (수정,삭제 수신시) -->
<update id="IFWMS103_SAP_UD_UPDATE" parameterType="Map">
	UPDATE IFWMS103 A
	   SET IFFLG  = 'D'
	     , STATUS = 'D'
	 WHERE 1 = 1
<!-- 	   AND IFFLG   = 'N' -->
<!-- 	   AND MENGE_R = 0 -->
	   AND DLEFLG != 'Y' <!-- 구매포탈 마감 플래그(Y:마감완료 / N:마감취소) -->
	   AND LOGSEQNO != #{LOGSEQNO}
<!-- 	   AND (EBELN, EBELP) IN (SELECT EBELN, EBELP FROM IFWMS103 WHERE LOGSEQNO = #{LOGSEQNO} AND EBELN = A.EBELN AND EBELP = A.EBELP) -->
	   AND EBELN IN (SELECT DISTINCT EBELN FROM IFWMS103 WHERE LOGSEQNO = #{LOGSEQNO} AND EBELN = A.EBELN)
</update>

<!-- 삭제된 오더 삭제 -->
<update id="IFWMS103_2041_UD_UPDATE" parameterType="Map">
	UPDATE IFWMS103 A
	   SET A.STATUS = 'D',
	       A.ERTXT  = '삭제된 오더로 판단되어 D 처리', 
	       A.LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD'), 
	       A.LMOTIM = TO_CHAR(SYSDATE,'HH24MISS') 
	WHERE A.LOGSEQNO &lt; #{LOGSEQNO}           	-- 이전 LOGSEQNO 데이터
	   AND A.MANDT = '100'
	   AND A.IFFLG = 'N'                        	-- 미입고
	   AND A.STATUS IN ('C','U') 
	   AND A.IFID IN ('WMS_IF_2041') 
	   AND A.CREDAT = TO_CHAR(SYSDATE,'YYYYMMDD')	-- 성능개선 목적 
	   AND A.LOGSEQNO != #{LOGSEQNO}   				-- 현재 수신건은 제외 (중요!)
	   AND A.MENGE_R = 0   						-- 입고수량 없는 오더대상
	   AND NOT EXISTS (SELECT 1
	                     FROM IFWMS103 B
	                    WHERE B.LOGSEQNO = #{LOGSEQNO} 
	                      AND B.EBELN  = A.EBELN
	                      AND B.EBELP  = A.EBELP
	                      AND B.LOTA15 = A.LOTA15
	                      AND B.MANDT  = A.MANDT)
</update>

<resultMap id="IFWMS103" type="hashmap"></resultMap>
<select id="IFWMS103_MAP" parameterType="Map" statementType="CALLABLE">
    {
        CALL ITF_IFWMS103(
            #{result, mode=OUT, jdbcType=VARCHAR, javaType=String, resultMap=IFWMS103},
            NVL(TRIM(#{SES_USER_ID}),#{IFID})
        )
    }
</select>

<!-- IFWMS209 품질검사대상 등록 -->
<insert id="IFWMS209_INSERT" parameterType="Map">
	INSERT INTO IFWMS209
	     (
	       MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , LIFNR
	     , BWART
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , VGBEL
	     , VGPOS
	     , WAREKY
	     , SKUKEY
	     , ORDCAT
	     , STOKKY
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , LOTNUM
	     , STATUS
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     )
	SELECT
	       'MES' --MANDT
	     , SEQ_IFWMS209.NEXTVAL
	     , SEBELN
	     , SEBELP
	     , RH.DPTNKY --LIFNR
	     , RH.RCPTTY --BWART
	     , RI.SKUKEY --MATNR
	     , RI.QTYRCV --MENGE
	     , RI.UOMKEY --MEINS
	     , RH.OWNRKY --WERKS
	     , RI.RECVKY --VGBEL
	     , RI.RECVIT --VGPOS
	     , RH.WAREKY
	     , RI.SKUKEY
	     , RH.DOCCAT --ORDCAT
	     , NVL((SELECT MAX(STOKKY) FROM STKKY WHERE RECVKY = RI.RECVKY AND RECVIT = RI.RECVIT AND LOTA06 = '05'),' ') --STOKKY 품질대상
	     , RI.LOTA01, RI.LOTA02, RI.LOTA03, RI.LOTA04, RI.LOTA05, RI.LOTA06, RI.LOTA07, RI.LOTA08, RI.LOTA09, RI.LOTA10
	     , RI.LOTA11, RI.LOTA12, RI.LOTA13, RI.LOTA14, RI.LOTA15, RI.LOTA16, RI.LOTA17, RI.LOTA18, RI.LOTA19, RI.LOTA20
	     , RI.LOTNUM
	     , DECODE(RH.STATDO, 'RCN', 'D', 'C') AS STATUS
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID}
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'I'
	     , #{LOGSEQNO}
	  FROM RECDI RI
	    LEFT JOIN RECDH RH ON RH.RECVKY = RI.RECVKY
	    LEFT OUTER JOIN SKUPLT SLT ON SLT.OWNRKY = RH.OWNRKY AND SLT.WAREKY = RH.WAREKY AND SLT.PLNTKY = RI.LOTA02 AND SLT.SKUKEY = RI.SKUKEY
	 WHERE RH.OWNRKY = #{OWNRKY}
	   AND RI.RECVKY IN (${RECVKYIN})
<!-- 	   AND RI.LOTA06 = '05' -->
       AND SLT.SHTAYN != 'V'	   
	   AND (
	           RH.RCPTTY = '131'
	           OR
	           SLT.QRTAYN = 'V'
	       )	   
</insert>

<!-- IFWMS209 품질검사대상 전송대상 검색 -->
<select id="IFWMS209_LIST" parameterType="Map" resultType="DataMap">
	SELECT MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , LIFNR
	     , BWART
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , VGBEL
	     , VGPOS
	     , WAREKY
	     , SKUKEY
	     , ORDCAT
	     , STOKKY
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , LOTNUM
	     , STATUS
	  FROM IFWMS209
	 WHERE ITFFLG IN ('I', ' ')
	   AND IFID = #{IFID}
	   AND LOGSEQNO = #{LOGSEQNO}
	 ORDER BY EBELN ASC, EBELP ASC
</select>

<update id="IFWMS209_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS209
	   SET ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE PRCFLG IN ('I','E')
	   AND LOGSEQNO = #{LOGSEQNO}
	   AND IFID = #{IFID}
	   AND ITFFLG != 'D'
</update>

<!-- IFWMS109 품질검사결과 기등록 체크 -->
<select id="IFWMS109_CHKQR_LIST" parameterType="Map" resultType="DataMap">
	SELECT SEQNO
	     , CHKRST
	     , LOGSEQNO
	  FROM IFWMS109
	 WHERE IFID = #{IFID}
	   AND EBELN = #{EBELN}
	   AND EBELP = #{EBELP}
	   AND VGBEL = #{VGBEL}
	   AND VGPOS = #{VGPOS}
	   AND ITFFLG != 'D'
</select>

<!-- IFWMS109 품질검사결과 현재 등록건 삭제 -->
<delete id="IFWMS109_CHKQR_DELETE" parameterType="Map">
	DELETE IFWMS109
	 WHERE IFID = #{IFID}
	   AND LOGSEQNO = #{LOGSEQNO}
	   AND ITFFLG != 'D'
</delete>

<!-- IFWMS109 품질검사결과 등록 -->
<insert id="IFWMS109_INSERT" parameterType="Map">
	INSERT INTO IFWMS109
	     (
	       MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , LIFNR
	     , BWART
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , VGBEL
	     , VGPOS
	     , WAREKY
	     , SKUKEY
	     , ORDCAT
	     , STOKKY
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , CHKRST
	     , QTYGOD, QTYBAD, BADRSN
	     , BADRSNNM
	     , LOTNUM
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     )
	VALUES
	     (
	       'MES' --MANDT
	     , SEQ_IFWMS109.NEXTVAL
	     , #{EBELN}
	     , #{EBELP}
	     , #{LIFNR}
	     , CASE WHEN #{IFID} IN ('WMS_IF_209') THEN '111'
	            WHEN #{IFID} IN ('WMS_IF_211') THEN '113'
	            WHEN #{IFID} IN ('WMS_IF_213') THEN '131'
	            ELSE ' '
	       END --BWART
	     , #{MATNR}
	     , NVL(#{MENGE},0)
	     , NVL(#{MEINS},' ')
	     , 'KN'
	     , NVL(#{VGBEL},' ')
	     , NVL(#{VGPOS},' ')
	     , NVL((SELECT WAREKY FROM STLMA WHERE OWNRKY = NVL(#{WERKS},'KN') AND PLNTKY = NVL(#{LOTA02},' ') AND STLKY = NVL(TRIM(#{LOTA01}),STLKY) AND WAREKY != ' ' AND ROWNUM = 1),' ')
	     , NVL(#{SKUKEY},#{MATNR})
	     , '100' --ORDCAT
	     , NVL(#{STOKKY},' ')
	     , NVL(#{LOTA01},' '), NVL(#{LOTA02},' '), NVL(#{LOTA03},' '), NVL(#{LOTA04},' '), NVL(#{LOTA05},' '), NVL(#{LOTA06},' '), NVL(#{LOTA07},' '), NVL(#{LOTA08},' '), NVL(#{LOTA09},' '), NVL(#{LOTA10},' ')
	     , NVL(#{LOTA11},' '), NVL(#{LOTA12},' '), NVL(#{LOTA13},' '), NVL(#{LOTA14},' '), NVL(#{LOTA15},' '), NVL(#{LOTA16},0), NVL(#{LOTA17},' '), NVL(#{LOTA18},0), NVL(#{LOTA19},0), NVL(#{LOTA20},0)
	     , 'QX'
	     , NVL(#{QTYGOD},0), NVL(#{QTYBAD},0), NVL(#{BADRSN},' ')
	     , NVL(#{BADRSNNM},' ')
	     , NVL(#{LOTNUM},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID}
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'I'
	     , #{LOGSEQNO}
	     )
</insert>

<insert id="IFWMS109_MULTI_INSERT" parameterType="Map">
	INSERT INTO IFWMS109
	     (
	       MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , LIFNR
	     , BWART
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , VGBEL
	     , VGPOS
	     , WAREKY
	     , SKUKEY
	     , ORDCAT
	     , STOKKY
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , CHKRST
	     , QTYGOD, QTYBAD, BADRSN
	     , BADRSNNM
	     , LOTNUM
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     )
		<foreach item="i" index="index" collection="list" open=" " separator=" UNION ALL " close="">
	SELECT
	       'MES' --MANDT
	     , F_GET_SEQ_MULTICASE('IFWMS109')
	     , #{i.EBELN, jdbcType=VARCHAR}
	     , #{i.EBELP, jdbcType=VARCHAR}
	     , #{i.LIFNR, jdbcType=VARCHAR}
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_209') THEN '111'
	            WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_211') THEN '113'
	            WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_213') THEN '131'
	            ELSE ' '
	       END --BWART
	     , #{i.MATNR, jdbcType=VARCHAR}
	     , NVL(#{i.MENGE, jdbcType=VARCHAR},0)
	     , NVL(#{i.MEINS, jdbcType=VARCHAR},' ')
	     , 'KN'
	     , NVL(#{i.VGBEL, jdbcType=VARCHAR},' ')
	     , NVL(#{i.VGPOS, jdbcType=VARCHAR},' ')
	     , NVL((SELECT WAREKY FROM STLMA WHERE OWNRKY = 'KN' AND PLNTKY = NVL(#{i.LOTA02, jdbcType=VARCHAR},' ') AND STLKY = NVL(TRIM(#{i.LOTA01, jdbcType=VARCHAR}),STLKY) AND WAREKY != ' ' AND ROWNUM = 1),' ')
	     , NVL(#{i.SKUKEY, jdbcType=VARCHAR},#{i.MATNR, jdbcType=VARCHAR})
	     , '100' --ORDCAT
	     , NVL(#{i.STOKKY, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA01, jdbcType=VARCHAR},' '), NVL(#{i.LOTA02, jdbcType=VARCHAR},' '), NVL(#{i.LOTA03, jdbcType=VARCHAR},' '), NVL(#{i.LOTA04, jdbcType=VARCHAR},' '), NVL(#{i.LOTA05, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA06, jdbcType=VARCHAR},' '), NVL(#{i.LOTA07, jdbcType=VARCHAR},' '), NVL(#{i.LOTA08, jdbcType=VARCHAR},' '), NVL(#{i.LOTA09, jdbcType=VARCHAR},' '), NVL(#{i.LOTA10, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA11, jdbcType=VARCHAR},' '), NVL(#{i.LOTA12, jdbcType=VARCHAR},' '), NVL(#{i.LOTA13, jdbcType=VARCHAR},' '), NVL(#{i.LOTA14, jdbcType=VARCHAR},' '), NVL(#{i.LOTA15, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA16, jdbcType=VARCHAR},0), NVL(#{i.LOTA17, jdbcType=VARCHAR},' '), NVL(#{i.LOTA18, jdbcType=VARCHAR},0), NVL(#{i.LOTA19, jdbcType=VARCHAR},0), NVL(#{i.LOTA20, jdbcType=VARCHAR},0)
	     , 'QX'
	     , NVL(#{i.QTYGOD, jdbcType=VARCHAR},0), NVL(#{i.QTYBAD, jdbcType=VARCHAR},0), NVL(#{i.BADRSN, jdbcType=VARCHAR},' ')
	     , NVL(#{i.BADRSNNM, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTNUM, jdbcType=VARCHAR},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{i.SES_USER_ID, jdbcType=VARCHAR}),#{i.IFID, jdbcType=VARCHAR})
	     , #{i.IFID, jdbcType=VARCHAR}
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'I'
	     , #{i.LOGSEQNO, jdbcType=VARCHAR}
	  FROM DUAL
		</foreach>
</insert>

<update id="IFWMS109_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS109
	   SET ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE LOGSEQNO = #{LOGSEQNO}
	   AND IFID = #{IFID}
	<if test="SEQNO != null and SEQNO != ' '.toString() and SEQNO != ''.toString()">
	   AND SEQNO = #{SEQNO}
	</if>
</update>

