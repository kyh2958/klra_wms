	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , CHKRST
	     , QTYGOD, QTYBAD, BADRSN
	     , LOTNUM
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     )
		<foreach item="i" index="index" collection="list" open=" " separator=" UNION ALL " close="">
	SELECT
	       'MES' --MANDT
	     , F_GET_SEQ_MULTICASE('IFWMS108')
	     , #{i.EBELN, jdbcType=VARCHAR}
	     , #{i.EBELP, jdbcType=VARCHAR}
	     , #{i.MATNR, jdbcType=VARCHAR}
	     , NVL(#{i.MENGE, jdbcType=VARCHAR},0)
	     , NVL(#{i.MEINS, jdbcType=VARCHAR},' ')
	     , 'KN'
	     , NVL(#{i.VGBEL, jdbcType=VARCHAR}, ' ')
	     , NVL(#{i.VGPOS, jdbcType=VARCHAR}, ' ')
	     , NVL(#{i.WAREKY, jdbcType=VARCHAR}, ' ')
	     , NVL(#{i.SKUKEY, jdbcType=VARCHAR},#{i.MATNR, jdbcType=VARCHAR})
	     , '100' --ORDCAT
	     , NVL(#{i.LOTA01, jdbcType=VARCHAR},' '), NVL(#{i.LOTA02, jdbcType=VARCHAR},' '), NVL(#{i.LOTA03, jdbcType=VARCHAR},' '), NVL(#{i.LOTA04, jdbcType=VARCHAR},' '), NVL(#{i.LOTA05, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA06, jdbcType=VARCHAR},' '), NVL(#{i.LOTA07, jdbcType=VARCHAR},' '), NVL(#{i.LOTA08, jdbcType=VARCHAR},' '), NVL(#{i.LOTA09, jdbcType=VARCHAR},' '), NVL(#{i.LOTA10, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA11, jdbcType=VARCHAR},' '), NVL(#{i.LOTA12, jdbcType=VARCHAR},' '), NVL(#{i.LOTA13, jdbcType=VARCHAR},' '), NVL(#{i.LOTA14, jdbcType=VARCHAR},' '), NVL(#{i.LOTA15, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA16, jdbcType=VARCHAR},0), NVL(#{i.LOTA17, jdbcType=VARCHAR},' '), NVL(#{i.LOTA18, jdbcType=VARCHAR},0), NVL(#{i.LOTA19, jdbcType=VARCHAR},0), NVL(#{i.LOTA20, jdbcType=VARCHAR},0)
	     , 'QR'
	     , NVL(#{i.QTYGOD, jdbcType=VARCHAR},0), NVL(#{i.QTYBAD, jdbcType=VARCHAR},0), NVL(#{i.BADRSN, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTNUM, jdbcType=VARCHAR},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{i.SES_USER_ID, jdbcType=VARCHAR}),#{i.IFID, jdbcType=VARCHAR})
	     , #{i.IFID, jdbcType=VARCHAR}
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'I'
	     , #{i.LOGSEQNO, jdbcType=VARCHAR}
	  FROM DUAL
		</foreach>
</insert>

<update id="IFWMS108_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS108
	   SET ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE LOGSEQNO = #{LOGSEQNO}
	   AND IFID = #{IFID}
	<if test="SEQNO != null and SEQNO != ' '.toString() and SEQNO != ''.toString()">
	   AND SEQNO = #{SEQNO}
	</if>
</update>

<!-- IFWMS108 순회 품질검사결과 기등록 체크 -->
<select id="IFWMS108_CHKQR_LIST" parameterType="Map" resultType="DataMap">
	SELECT SEQNO
	     , CHKRST
	     , LOGSEQNO
	  FROM IFWMS108
	 WHERE IFID = #{IFID}
	   AND EBELN = #{EBELN}
	   AND EBELP = #{EBELP}
	   AND LOTNUM = #{LOTNUM}
	   AND ITFFLG != 'D'
</select>

<!-- IFWMS108 순회 품질검사결과 현재 등록건 삭제 -->
<delete id="IFWMS108_CHKQR_DELETE" parameterType="Map">
	DELETE IFWMS108
	 WHERE IFID = #{IFID}
	   AND LOGSEQNO = #{LOGSEQNO}
	   AND ITFFLG != 'D'
</delete>

<!-- IFWMS203 입고실적 등록 -->
<insert id="IFWMS203_INSERT" parameterType="Map">
	INSERT INTO IFWMS203
	     (
	       MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , LIFNR
	     , BWART
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , EINDT
	     , MENGE_B
	     , MENGE_R
	     , VGBEL
	     , VGPOS
	     , STATUS
	     , WAREKY
	     , SKUKEY
	     , ZDOC_NO
	     , ZDOC_ITEM
	     , QTYRCV
	     , ORDCAT
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , BWARTSAP
	     , ZDFF
	     , SSORNU
	     , SSORIT
	     , POREV
	     , AR_NO
	     , AR_REV
	     , AR_LNO
	     , STOKKY
	     , LOTNUM
	     )
	SELECT
	       CASE WHEN #{IFID} IN ('WMS_IF_214') THEN 'PTL'
	            WHEN #{IFID} IN ('WMS_IF_215','WMS_IF_216','WMS_IF_221','WMS_IF_217','WMS_IF_224','WMS_IF_219') THEN 'SAP'
	            WHEN #{IFID} IN ('WMS_IF_222','WMS_IF_218') THEN 'MES'
	            ELSE ' '
	       END --MANDT
	     , SEQ_IFWMS203.NEXTVAL AS SEQNO
	     , RI.SEBELN
	     , RI.SEBELP
	     , RH.DPTNKY AS LIFNR
	     , RH.RCPTTY --BWART
	     , RI.SKUKEY --MATNR
	     , RI.QTYORG --MENGE 오더수량
	     , RI.UOMKEY --MEINS
	     , RH.OWNRKY --WERKS
	     , RH.DOCDAT --EINDT
	     , NVL(TRIM(IF103.MENGE_B),0) --MENGE_B
	     , NVL(TRIM(IF103.MENGE_R),0) --MENGE_R
	     , RI.RECVKY --VGBEL
	     , RI.RECVIT --VGPOS
	     , DECODE(RI.STATIT, 'FCV', 'D', 'C') -- STATUS
	     , RH.WAREKY
	     , RI.SKUKEY
	     , RI.RECVKY --ZDOC_NO
	     , RI.RECVIT --ZDOC_ITEM
	     , RI.QTYRCV
	     , RH.DOCCAT --ORDCAT
	     , RI.LOTA01, RI.LOTA02, RI.LOTA03, RI.LOTA04, RI.LOTA05, RI.LOTA06, RI.LOTA07, RI.LOTA08, RI.LOTA09, RI.LOTA10
	     , RI.LOTA11, RI.LOTA12, RI.LOTA13, RI.LOTA14, ( CASE WHEN TRIM(RI.LOTA41) IS NULL THEN RI.LOTA15 ELSE RI.LOTA41 END ) AS LOTA15, RI.LOTA16, RI.LOTA17, RI.LOTA18, RI.LOTA19, RI.LOTA20
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID}
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'I'
	     , #{LOGSEQNO}
	     , (
	          CASE WHEN RH.RCPTTY='101' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
	               WHEN RH.RCPTTY='111' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
	               WHEN RH.RCPTTY='114' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
	               WHEN RH.RCPTTY IN ('121', '122') THEN DECODE(RI.STATIT, 'FCV', '648', DECODE(STM.WMSMAK, 'V', '101', '641') )
	               WHEN RH.RCPTTY='131' THEN DECODE(RI.STATIT, 'FCV', '656', '655')
	               WHEN RH.RCPTTY='135' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
	               WHEN RH.RCPTTY='199' THEN '701'
	               ELSE ''
	          END
	         ) AS BWARTSAP
	     , ( CASE WHEN RI.QTYORG=RI.QTYRCV THEN ' ' ELSE 'X' END ) AS ZDFF
	     , RI.SSORNU
	     , RI.SSORIT
	     , RI.POREV
	     , RI.AR_NO
	     , RI.AR_REV
	     , RI.AR_LNO
<!-- 	     , NVL(SK.STOKKY, ' ') AS STOKKY -->
	     , NVL(( SELECT SK.STOKKY FROM STKKY SK WHERE SK.RECVKY = RI.RECVKY AND SK.RECVIT = RI.RECVIT AND SK.QTSIWH > 0 AND ROWNUM = 1 ),' ') AS STOKKY
         , NVL(RI.LOTNUM,' ') AS LOTNUM
	  FROM RECDI RI
	    LEFT JOIN RECDH RH ON RH.RECVKY = RI.RECVKY
	    LEFT OUTER JOIN IFWMS103 IF103 ON IF103.SEQNO = RI.SEQNO AND IF103.EBELN = RI.SEBELN AND IF103.EBELP = RI.SEBELP
	    LEFT OUTER JOIN STLMA STM ON STM.OWNRKY = #{OWNRKY} AND STM.STLKY = RI.LOTA01 AND STM.PLNTKY = RI.LOTA02
<!-- 	    LEFT OUTER JOIN STKKY SK ON SK.RECVKY = RI.RECVKY AND SK.RECVIT = RI.RECVIT AND SK.QTSIWH > 0 -->
	 WHERE RH.OWNRKY = #{OWNRKY}
	   AND RI.RECVKY IN (${RECVKYIN})
</insert>

<!-- IFWMS203 입고실적 등록 -->
<insert id="IFWMS203SAP_INSERT" parameterType="Map">
	INSERT INTO IFWMS203
	     (
	       MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , LIFNR
	     , BWART
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , EINDT
	     , MENGE_B
	     , MENGE_R
	     , VGBEL
	     , VGPOS
	     , STATUS
	     , WAREKY
	     , SKUKEY
	     , ZDOC_NO
	     , ZDOC_ITEM
	     , QTYRCV
	     , ORDCAT
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , BWARTSAP
	     , ZDFF
	     , PIKSUM
	     , SSORNU
	     , SSORIT
	     , POREV
	     , AR_NO
	     , AR_REV
	     , AR_LNO
	     , UI
         , REMARK
	     )
	SELECT T1.MANDT
	     , SEQ_IFWMS203.NEXTVAL AS SEQ
	     , T1.SEBELN
	     , T1.SEBELP
	     , T1.LIFNR
	     , T1.BWART
	     , T1.MATNR
	     , T1.MENGE
	     , T1.MEINS
	     , T1.WERKS     
	     , T1.EINDT
	     , T1.MENGE_B
	     , T1.MENGE_R
	     , T1.VGBEL
	     , T1.VGPOS     
	     , T1.STATUS     
	     , T1.WAREKY     
	     , T1.SKUKEY
	     , T1.ZDOC_NO
	     , T1.ZDOC_ITEM     
	     , T1.QTYRCV     
	     , T1.ORDCAT
	     , T1.LOTA01
	     , T1.LOTA02
	     , T1.LOTA03
	     , T1.LOTA04
	     , T1.LOTA05
	     , T1.LOTA06
	     , T1.LOTA07
	     , T1.LOTA08
	     , T1.LOTA09
	     , T1.LOTA10
	     , T1.LOTA11
	     , T1.LOTA12
	     , T1.LOTA13
	     , T1.LOTA14
	     , T1.LOTA15
	     , T1.LOTA16
	     , T1.LOTA17
	     , T1.LOTA18
	     , T1.LOTA19
	     , T1.LOTA20
	     , T1.CDATE
	     , T1.CREDAT
	     , T1.CRETIM
	     , T1.CREUSR
	     , T1.IFID
	     , T1.ITFFLG
	     , T1.ITFDAT
	     , T1.ITFTIM
	     , T1.PRCFLG
	     , T1.LOGSEQNO
	     , T1.BWARTSAP
	     , T1.ZDFF
	     , T1.PIKSUM
	     , T1.SSORNU
	     , T1.SSORIT
	     , T1.POREV
	     , T1.AR_NO
	     , T1.AR_REV
	     , T1.AR_LNO
	     , T1.UI
	     , T1.REMARK
	FROM (
		SELECT A.SEBELN
	         , A.SEBELP
	         , MAX(A.MANDT) AS MANDT
	         , MAX(A.LIFNR) AS LIFNR     
	         , MAX(A.BWART) AS BWART
	         , MAX(A.MATNR) AS MATNR
	         , MAX(A.MENGE) AS MENGE
	         , MAX(A.MEINS) AS MEINS
	         , MAX(A.WERKS) AS WERKS
	         , MAX(A.EINDT) AS EINDT
	         , SUM(A.MENGE_B) AS MENGE_B
	         , SUM(A.MENGE_R) AS MENGE_R
	         , NVL(MAX(A.VGBEL),' ') AS VGBEL
	         , NVL(MAX(A.VGPOS),' ') AS VGPOS     
	         , MAX(A.STATUS) AS STATUS     
	         , MAX(A.WAREKY) AS WAREKY     
	         , A.SKUKEY AS SKUKEY
	         , MAX(A.ZDOC_NO) AS ZDOC_NO
	         , MAX(A.ZDOC_ITEM) AS ZDOC_ITEM
	         , SUM(A.QTYRCV) AS QTYRCV     
	         , MAX(A.ORDCAT) AS ORDCAT
	         , A.LOTA01 AS LOTA01
	         , A.LOTA02 AS LOTA02
	         , MAX(A.LOTA03) AS LOTA03
	         , MAX(A.LOTA04) AS LOTA04
	         , MAX(A.LOTA05) AS LOTA05
	         , MAX(A.LOTA06) AS LOTA06
	         , MAX(A.LOTA07) AS LOTA07
	         , MAX(A.LOTA08) AS LOTA08
	         , MAX(A.LOTA09) AS LOTA09
	         , MAX(A.LOTA10) AS LOTA10
	         , A.LOTA11 AS LOTA11
	         , MAX(A.LOTA12) AS LOTA12
	         , MAX(A.LOTA13) AS LOTA13
	         , MAX(A.LOTA14) AS LOTA14
	         , A.LOTA15 AS LOTA15
	         , MAX(A.LOTA16) AS LOTA16
	         , MAX(A.LOTA17) AS LOTA17
	         , MAX(A.LOTA18) AS LOTA18
	         , MAX(A.LOTA19) AS LOTA19
	         , MAX(A.LOTA20) AS LOTA20
	         , MAX(A.CDATE) AS CDATE
	         , MAX(A.CREDAT) AS CREDAT
	         , MAX(A.CRETIM) AS CRETIM
	         , MAX(A.CREUSR) AS CREUSR
	         , MAX(A.IFID) AS IFID
	         , MAX(A.ITFFLG) AS ITFFLG
	         , MAX(A.ITFDAT) AS ITFDAT
	         , MAX(A.ITFTIM) AS ITFTIM
	         , MAX(A.PRCFLG) AS PRCFLG
	         , MAX(A.LOGSEQNO) AS LOGSEQNO
	         , MAX(A.BWARTSAP) AS BWARTSAP
	         , ( CASE WHEN SUM(A.MENGE)=SUM(A.QTYRCV) THEN ' ' ELSE 'X' END ) AS ZDFF
	         , SUM(A.QTYRCV) AS PIKSUM
	         , MAX(A.SSORNU) AS SSORNU
	         , MAX(A.SSORIT) AS SSORIT
	         , MAX(A.POREV) AS POREV
	         , MAX(A.AR_NO)  AS AR_NO
	         , MAX(A.AR_REV) AS AR_REV
	         , MAX(A.AR_LNO) AS AR_LNO
	         , MAX(A.UI) AS UI
	         , MAX(A.REMARK) AS REMARK
	    FROM ( 
			SELECT
			       CASE WHEN #{IFID} IN ('WMS_IF_214') THEN 'PTL'
			            WHEN #{IFID} IN ('WMS_IF_215','WMS_IF_216','WMS_IF_221','WMS_IF_217','WMS_IF_224','WMS_IF_219') THEN 'SAP'
			            WHEN #{IFID} IN ('WMS_IF_222','WMS_IF_218') THEN 'MES'
			            ELSE ' '
			       END AS MANDT
			     , RI.SEBELN
			     , RI.SEBELP
			     , RH.DPTNKY AS LIFNR
			     , RH.RCPTTY AS BWART
			     , RI.SKUKEY AS MATNR
			     , RI.QTYORG AS MENGE
			     , RI.UOMKEY AS MEINS
			     , RH.OWNRKY AS WERKS
			     , RH.DOCDAT AS EINDT
			     , NVL(TRIM(IF103.MENGE_B),0) AS MENGE_B
			     , NVL(TRIM(IF103.MENGE_R),0) AS MENGE_R
			     , IF103.VGBEL
			     , IF103.VGPOS
			     , DECODE(RI.STATIT, 'FCV', 'D', 'C') AS STATUS
			     , RH.WAREKY
			     , RI.SKUKEY
			     , RI.RECVKY AS ZDOC_NO
			     , RI.RECVIT AS ZDOC_ITEM
			     , RI.QTYRCV
			     , RH.DOCCAT AS ORDCAT
			     , RI.LOTA01, RI.LOTA02, RI.LOTA03, RI.LOTA04, RI.LOTA05, RI.LOTA06, RI.LOTA07, RI.LOTA08, RI.LOTA09, RI.LOTA10
			     , RI.LOTA11, RI.LOTA12, RI.LOTA13, RI.LOTA14, RI.LOTA15, RI.LOTA16, RI.LOTA17, RI.LOTA18, RI.LOTA19, RI.LOTA20
			     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') AS CDATE, TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT
	             , TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, NVL(TRIM(#{SES_USER_ID}),#{IFID}) AS CREUSR
			     , #{IFID} AS IFID
			     , 'I' AS ITFFLG, TO_CHAR(SYSDATE, 'YYYYMMDD') AS ITFDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS ITFTIM
			     , 'I' AS PRCFLG
			     , #{LOGSEQNO} AS LOGSEQNO
			     , (
			          CASE WHEN RH.RCPTTY='101' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
			               WHEN RH.RCPTTY='111' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
			               WHEN RH.RCPTTY='114' THEN DECODE(RI.STATIT, 'FCV', '102', '101')
			               WHEN RH.RCPTTY IN ('121', '122') THEN DECODE(RI.STATIT, 'FCV', '648', DECODE(STM.WMSMAK, 'V', '101', '641') )
			               WHEN RH.RCPTTY='131' THEN DECODE(RI.STATIT, 'FCV', '656', '655')
			               WHEN RH.RCPTTY='135' THEN DECODE(RI.STATIT, 'FCV', '312', '311')
			               WHEN RH.RCPTTY='199' THEN '701'
			               ELSE ''
			          END
			         ) AS BWARTSAP
			     , RI.SSORNU
			     , RI.SSORIT
			     , RI.POREV
			     , RI.AR_NO
			     , RI.AR_REV
			     , RI.AR_LNO
			     , #{menuId} AS UI
			     , #{SES_USER_ID} AS REMARK
			  FROM RECDI RI
			       LEFT JOIN RECDH RH ON RH.RECVKY = RI.RECVKY
			       LEFT OUTER JOIN IFWMS103 IF103 ON IF103.SEQNO = RI.SEQNO AND IF103.EBELN = RI.SEBELN AND IF103.EBELP = RI.SEBELP
			       LEFT OUTER JOIN STLMA STM ON STM.OWNRKY = #{OWNRKY} AND STM.STLKY = RI.LOTA01 AND STM.PLNTKY = RI.LOTA02
			 WHERE RH.OWNRKY = #{OWNRKY}
			   AND RI.RECVKY IN (${RECVKYIN})
		 ) A
	     GROUP BY A.SEBELN, A.SEBELP, A.SKUKEY, A.LOTA01, A.LOTA02, A.LOTA11, A.LOTA15
     ) T1
</insert>

<!-- IFWMS203 입고실적 전송대상 검색 -->
<select id="IFWMS203_LIST" parameterType="Map" resultType="DataMap">
	SELECT MANDT
	     , SEQNO
	     , EBELN
	     , EBELP
	     , CASE WHEN #{IFID} IN ('WMS_IF_218','WMS_IF_222') THEN SUBSTR(LIFNR,5)
	            ELSE LIFNR
	       END AS LIFNR
	     , CASE WHEN #{IFID} IN ('WMS_IF_221','WMS_IF_224') THEN SUBSTR(LIFNR,1,4)
	            ELSE LOTA02
	       END AS PLTFR
	     , CASE WHEN #{IFID} IN ('WMS_IF_221','WMS_IF_224') THEN SUBSTR(LIFNR,5)
	            ELSE LOTA01
	       END AS LGORT
	     , MATNR
	     , MENGE
	     , MEINS
	     , WERKS
	     , EINDT
	     , SUBSTR(EINDT, 0,4) AS MJAHR
	     , MENGE_B
	     , MENGE_R
	     , VGBEL
	     , VGPOS
	     , STATUS
	     , WAREKY
	     , SKUKEY
	     , ZDOC_NO
	     , ZDOC_ITEM
	     , QTYRCV
	     , ORDCAT
	     , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
	     , LOTA11, LOTA12, LOTA13, LOTA14, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
	     , BWARTSAP
	     , ZDFF
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE 'E'
	       END AS SOBKZ
	    <!--  , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 1, 10)
	       END AS KDAUF
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 11)
	       END AS KDPOS -->
	     
	     <!-- 20220818 KJH 재고조정입고(IFID WMS_IF_219) SAP연동시  특별재고(LOTA07 값있을경우) 일때 만 KDAUF,KDPOS,UMMAT 전송 요청 -->
	     , CASE WHEN IFID='WMS_IF_219' AND ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 1, 10)
	       END AS KDAUF
	     , CASE WHEN IFID='WMS_IF_219' AND ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 11)
	       END AS KDPOS
	     , CASE WHEN IFID='WMS_IF_219' AND ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE MATNR
	       END AS UMMAT
	     
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 1, 10)
	       END AS MAT_KDAUF
	     , CASE WHEN ' ' = NVL(TRIM(LOTA07), ' ') THEN NULL
	            ELSE SUBSTR(LOTA07, 11)
	       END AS MAT_KDPOS 
	     , PIKSUM
	     , SSORNU
	     , SSORIT
	     , POREV
	     , AR_NO
	     , AR_REV
	     , AR_LNO
	     , STOKKY
	     , LOTNUM
	     , REMARK
	     , C00105
     <choose>
	     <when test="IFID != null and IFID == 'WMS_IF_2161'">
     		, NVL(#{FLOTA02}, ' ') AS FLOTA02
     		, NVL(#{FLOTA01}, ' ') AS FLOTA01
     		, NVL(#{C00102}, ' ') AS C00102
     		, NVL(#{C00103}, ' ') AS C00103
     		, NVL(#{C00104}, ' ') AS C00104
     		, NVL(#{N00102}, ' ') AS N00102
     		, NVL(#{C00103}, ' ') AS LOTA15
      	</when>
      	<otherwise>
	     , C00103
	     , C00104
	     , LOTA15
      	</otherwise>
     </choose>
	  FROM IFWMS203
	 WHERE PRCFLG != 'C'
	   AND IFID = #{IFID}	<!-- 240207 IFID 추가 -->
	   AND LOGSEQNO = #{LOGSEQNO}
	 ORDER BY EBELN ASC, EBELP ASC
</select>

<!-- IFWMS203 입고실적정보(자재,상품) 전송대상 검색 -->
<select id="IFWMS203_HEAD_LIST" parameterType="Map" resultType="DataMap">
	 SELECT DISTINCT
		       SSORNU AS VBELN
		     , EINDT AS WADAT
		     , LIFNR AS KUNAG
		     , STATUS
		     , ZDOC_NO
		     , ZDOC_ITEM
		     , LOTA12
		     , SSORNU AS PO_NO
		     , POREV AS PO_REV
		     , CREUSR
		  FROM IFWMS203
		 WHERE PRCFLG != 'C'
		   AND LOGSEQNO = #{LOGSEQNO}
		   AND IFID = #{IFID} <!-- 240207 IFID -->
		 ORDER BY VBELN ASC
</select>

<!-- IFWMS203 입고실적정보(자재,상품) 전송대상 검색 -->
<select id="IFWMS203_ITEM_LIST" parameterType="Map" resultType="DataMap">
	SELECT IFWMS203.SSORNU AS VBELN
		 , IFWMS203.MATNR
		 , IFWMS203.MEINS
		 , IFWMS203.QTYRCV AS ZQTSACT
		 , IFWMS203.LOTA01
		 , IFWMS203.LOTA02
		 , IFWMS203.LOTA06 AS STCK_TYPE
		 , IFWMS203.LOTA11
		 , IFWMS203.LOTA13
		 , IFWMS203.LOTA15
		 , IFWMS203.SSORIT AS PO_LNO
		 , IFWMS203.ZDOC_NO
		 , IFWMS203.ZDOC_ITEM    
		 , IFWMS203.SSORNU AS PO_NO
		 , SKUMA.DESC01
	  FROM IFWMS203 
	  LEFT OUTER JOIN SKUMA ON IFWMS203.WERKS = SKUMA.OWNRKY AND IFWMS203.MATNR = SKUMA.SKUKEY
	 WHERE IFWMS203.PRCFLG != 'C'
	   AND IFWMS203.LOGSEQNO = #{LOGSEQNO}
	   AND IFWMS203.IFID = #{IFID} <!-- 240207 IFID -->
	 ORDER BY IFWMS203.EBELN ASC
</select>

<update id="IFWMS203_RECDI_UPDATE" parameterType="Map">
	UPDATE RECDI
	   SET SXBLNR = #{MBLNR}
	 WHERE RECVKY = #{WMSDN}
</update>

<update id="IFWMS203_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS203
	   SET MBLNR  = NVL(#{MBLNR},' ')
	   	 , ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = '[' || NVL(#{PRCFLG},' ') || ']' || NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE PRCFLG IN ('I','E')
	   AND IFID = #{IFID}
	   AND LOGSEQNO = #{LOGSEQNO}
</update>

<update id="IFWMS203SAP_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS203
	   SET MBLNR  = NVL(#{MBLNR},' ')
	   	 , ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = NVL(#{PRCFLG},' ')
	     , PRCETX = '[' || NVL(#{PRCFLG},' ') || ']' || NVL(#{PRCETX},' ')
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE PRCFLG = 'I'
	   AND IFID = #{IFID}
	   AND LOGSEQNO = #{LOGSEQNO}
	   AND ZDOC_NO  = #{WMSDN}
</update>

<!-- IFWMS113 출고예정 -->
<insert id="IFWMS113_INSERT" parameterType="Map">
	INSERT INTO IFWMS113
	     (
	       MANDT
	     , SEQNO
	     , VBELN
	     , POSNR
	     , BWART
	     , ZLIKP_AEDAT
	     , LFART
	     , WADAT
	     , KUNNR
	     , KUNAG
	     , WERKS
	     , MATNR
	     , LFIMG
	     , QTSHP
	     , MEINS
	     , VGBEL
	     , VGPOS
	     , STKNUM
	     , STATUS
	     , BNAME
	     , BPHON
	     , WAREKY
	     , SKUKEY
	     , USRID1
	     , DEPTID1
	     , ORDCAT
	     , PTNRTY
	     , SBKTXT
	     , LOTA01
	     , LOTA02
	     , LOTA03
	     , LOTA04
	     , LOTA05
	     , LOTA06
	     , LOTA07
	     , LOTA08
	     , LOTA09
	     , LOTA10
	     , LOTA11
	     , LOTA12
	     , LOTA13
	     , LOTA14
	     , LOTA15
	     , LOTA16
	     , LOTA17
	     , LOTA18
	     , LOTA19
	     , LOTA20
	     , TDLNR
	     , CARNO
	     , CARTON
	     , LOADTON
	     , CARART
	     , LOADVOLUME
	     , DRIVERCEL
	     , DTDIS
	     , UZDIS
	     , SIGNI
	     , EXTI2
	     , SDABW
	     , SAP12
	     , SAP13
	     , TDOBJECT
	     , LOEKZ
	     , BWARTSAP
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , VTXTK
	     , KVGR1
	     , KVGR2
	     , KVGR3
	     , SOBKZ
	     , AUGRU
	     , STOKKY
	     , LOTNUM
	     , PO_NO
	     , PO_REV
	     , PO_LNO
	     , TLOTA01
	     , TLOTA02
	     , ZKUNNR3
	     , VTWEG
		 , C00102
		 , C00105
		 , N00105
	     )
	VALUES
	     (
	       NVL(#{MANDT},'100')
	     , SEQ_IFWMS113.NEXTVAL
	     , CASE WHEN #{IFID} = 'WMS_IF_316' THEN TO_CHAR(SEQ_IFWMS113OUT.NEXTVAL) -- 고지/펄프만 전용으로 시퀀스하게 생성
	                                        ELSE NVL(#{VBELN},' ')       -- 그외
	       END -- VBELN
	     , CASE WHEN #{IFID} = 'WMS_IF_316' THEN '000010'                -- 고지/펄프만 전용으로 000010 으로 고정
	                                        ELSE NVL(#{POSNR},' ')       -- 그외
	       END -- POSNR
	     , CASE WHEN #{IFID} IN ('WMS_IF_301','WMS_IFC301','WMS_IFB301','WMS_IFS301','WMS_IFZ301', 'TMS_IFC3012', 'TMS_IFB3012')
	            THEN CASE WHEN NVL(#{LFART},' ') = 'ZELF'
	                      THEN '208' -- 수출ZELF
                          ELSE CASE WHEN NVL(#{BWARTSAP},' ') IN ('Y13','Y15','Y17','Y18','Y19'
                                                                 ,'Y39','Y40','Y41','Y42','Y43'
                                                                 ,'Y45','Y46','Y47','Y49','Y50'
                                                                 ,'Y51','Y52','Y53')
                                    THEN '206' -- 무상
                               		WHEN NVL(#{BWARTSAP},' ') IN ('641')
                               			THEN '221' -- 이송
                                    ELSE '201' -- 판매
                               END
	                      END
	            WHEN #{IFID} IN ('WMS_IF_302','WMS_IFC302','WMS_IFB302','WMS_IFS302') 
            	THEN CASE WHEN NVL(#{BWARTSAP}, ' ') = '601' 
            			THEN '201'	--판매
			            ELSE '221'	--출고예정정보(이송)
			        END
	            WHEN #{IFID} = 'WMS_IF_303' THEN '205' --출고예정정보(자재,수입밀롤)
	            WHEN #{IFID} = 'WMS_IF_305' THEN '353' --생산투입불출정보
	            WHEN #{IFID} = 'WMS_IF_318' THEN '231' --반품출고예정정보(자재,상품)
	            WHEN #{IFID} = 'WMS_IF_316' THEN '355' --생산투입정보(고지/펄프)
	       END -- BWART
	     , NVL(#{ZLIKP_AEDAT},' ')
	     , NVL(#{LFART},' ') -- LFART
	     , NVL(#{WADAT},' ')
	     , NVL(#{KUNNR},' ') -- KUNNR
	     , NVL(#{KUNAG},' ')
	     , 'KN' -- WERKS
	     , NVL(#{MATNR},' ') -- MATNR
	     , NVL(#{LFIMG},0) -- LFIMG
	     , NVL(#{QTSHP},0)
	     , NVL(#{MEINS},' ') -- MEINS
	     , NVL(#{VGBEL},' ')
	     , NVL(#{VGPOS},' ')
	     , NVL(#{STKNUM},' ')
	     , NVL(#{STATUS},'C')
	     , NVL(#{BNAME},' ')
	     , NVL(#{BPHON},' ')	     
	     , (SELECT WAREKY FROM STLMA WHERE OWNRKY = 'KN' AND PLNTKY = NVL(#{LOTA02},' ') AND STLKY = NVL(TRIM(#{LOTA01}), STLKY) AND WAREKY != ' ' AND ROWNUM = 1) --WAREKY
	     , NVL(#{MATNR},' ')
	     , NVL(#{USRID1},' ')
	     , NVL(#{DEPTID1},' ')
	     , CASE WHEN #{IFID} IN ('WMS_IF_305','WMS_IF_316') THEN NVL(#{ORDCAT},'300')
	            ELSE NVL(#{ORDCAT},'200')
	       END -- ORDCAT
	     , NVL(#{PTNRTY},'CT')
	     , NVL(#{SBKTXT},' ')
	     , NVL(#{LOTA01},' ')
	     , NVL(#{LOTA02},' ')
	     , NVL(#{LOTA03},' ')
	     , NVL(#{LOTA04},' ')
	     , NVL(#{LOTA05},' ')
	     , NVL(#{LOTA06},'00')
	     , CASE WHEN #{IFID} IN ('WMS_IF_303','WMS_IF_305') THEN NVL(#{LOTA07},' ')
	            ELSE DECODE(NVL(#{SOBKZ},' '), 'E', NVL(#{VBELV},' ') || NVL(#{POSNV},' '), ' ')
	       END
	     , NVL(#{LOTA08},' ')
	     , CASE WHEN #{IFID} IN ('WMS_IF_303','WMS_IF_305') THEN NVL(#{LOTA09},' ')
	            ELSE DECODE(NVL(#{SOBKZ},' '), 'E', NVL(#{KUNAG},' '), ' ')
	       END
	     , NVL(#{LOTA10},' ')
	     , NVL(#{LOTA11},' ')
	     , NVL(#{LOTA12},' ')
	     , NVL(#{LOTA13},' ')
	     , NVL(#{LOTA14},' ')
	     , NVL(#{LOTA15},' ')
	     , NVL(#{LOTA16},0)
	     , NVL(#{LOTA17},' ')
	     , NVL(#{LOTA18},0)
	     , NVL(#{LOTA19},0)
	     , NVL(#{LOTA20},0)
	     , NVL(#{TDLNR},' ')
	     , NVL(#{CARNO},' ')
	     , NVL(#{CARTON},' ')
	     , NVL(#{LOADTON},0)
	     , NVL(#{CARART},' ')
	     , NVL(#{LOADVOLUME},0)
	     , NVL(#{DRIVERCEL},' ')
	     , NVL(#{DTDIS},' ')
	     , NVL(#{UZDIS},' ')
	     , NVL(SUBSTRB(#{SIGNI},0, 20),' ') -- I/F 수신시 자리값초과 예방
	     , NVL(#{EXTI2},' ')
	     , NVL(#{SDABW},' ')
	     , NVL(#{SAP12},' ')
	     , NVL(#{SAP13},' ')
	     , NVL(#{TDOBJECT},' ')
	     , NVL(#{LOEKZ},' ')
	     , NVL(#{BWARTSAP},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{SES_USER_ID}),#{IFID})
	     , #{IFID}
	     , 'N' --IFFLG
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'N' --PRCFLG
	     , #{LOGSEQNO}
	     , NVL(#{VTXTK}, ' ')
	     , NVL(#{KVGR1}, ' ')
	     , NVL(#{KVGR2}, ' ')
	     , NVL(#{KVGR3}, ' ')
	     , NVL(#{SOBKZ}, ' ')
	     , NVL(#{AUGRU}, ' ')
	     , NVL(#{STOKKY}, ' ')
	     , NVL(#{LOTNUM}, ' ')
	     , NVL(#{PO_NO}, ' ')
	     , NVL(#{PO_REV}, NULL)
	     , NVL(#{PO_LNO}, NULL)
	     , NVL(#{TLOTA01}, ' ')
	     , NVL(#{TLOTA02}, ' ')
	     , NVL(#{ZKUNNR3}, ' ')
	     , NVL(#{VTWEG}, ' ')
		 , NVL(#{C00102}, ' ')
		 , NVL(#{C00105}, ' ')
		 , NVL(#{N00105}, 0)
	     )
</insert>

<insert id="IFWMS113_MULTI_INSERT" parameterType="Map">
	INSERT INTO IFWMS113
	     (
	       MANDT
	     , SEQNO
	     , VBELN
	     , POSNR
	     , BWART
	     , ZLIKP_AEDAT
	     , LFART
	     , WADAT
	     , KUNNR
	     , KUNAG
	     , WERKS
	     , MATNR
	     , LFIMG
	     , QTSHP
	     , MEINS
	     , VGBEL
	     , VGPOS
	     , STKNUM
	     , STATUS
	     , BNAME
	     , BPHON
	     , WAREKY
	     , SKUKEY
	     , USRID1
	     , DEPTID1
	     , ORDCAT
	     , PTNRTY
	     , SBKTXT
	     , LOTA01
	     , LOTA02
	     , LOTA03
	     , LOTA04
	     , LOTA05
	     , LOTA06
	     , LOTA07
	     , LOTA08
	     , LOTA09
	     , LOTA10
	     , LOTA11
	     , LOTA12
	     , LOTA13
	     , LOTA14
	     , LOTA15
	     , LOTA16
	     , LOTA17
	     , LOTA18
	     , LOTA19
	     , LOTA20
	     , TDLNR
	     , TDLNR_NM
	     , CARNO
	     , CARTON
	     , LOADTON
	     , CARART
	     , LOADVOLUME
	     , DRIVERCEL
	     , DTDIS
	     , UZDIS
	     , SIGNI
	     , EXTI2
	     , SDABW
	     , SAP12
	     , SAP13
	     , TDOBJECT
	     , LOEKZ
	     , BWARTSAP
	     , CDATE, CREDAT, CRETIM, CREUSR
	     , IFID
	     , IFFLG
	     , ITFFLG, ITFDAT, ITFTIM
	     , PRCFLG
	     , LOGSEQNO
	     , VTXTK
	     , KVGR1
	     , KVGR2
	     , KVGR3
	     , SOBKZ
	     , AUGRU
	     , STOKKY
	     , LOTNUM
	     , PO_NO
	     , PO_REV
	     , PO_LNO
	     , TLOTA01
	     , TLOTA02
	     , ZKUNNR3
	     , VTWEG
	     )
		<foreach item="i" index="index" collection="list" open=" " separator=" UNION ALL " close="">
	SELECT
	       NVL(#{i.MANDT, jdbcType=VARCHAR},'100')
	     , F_GET_SEQ_MULTICASE('IFWMS113')
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_316' THEN TO_CHAR(F_GET_SEQ_MULTICASE('IFWMS113OUT'))    -- 고지/펄프만 전용으로 시퀀스하게 생성
	                                                            ELSE NVL(#{i.VBELN, jdbcType=VARCHAR},' ') -- 그외
	       END AS VBELN
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_316' THEN '000010'                              -- 고지/펄프만 전용으로 000010 으로 고정
	                                                            ELSE NVL(#{i.POSNR, jdbcType=VARCHAR},' ') -- 그외
	       END AS POSNR
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_301','WMS_IFC301','WMS_IFB301','WMS_IFS301', 'WMS_IFZ301', 'TMS_IFC3012', 'TMS_IFB3012')
	            THEN CASE WHEN NVL(#{i.LFART, jdbcType=VARCHAR},' ') = 'ZELF'
	                      THEN '208' -- 수출ZELF
                          ELSE CASE WHEN NVL(#{i.BWARTSAP, jdbcType=VARCHAR},' ') IN ('Y13','Y15','Y17','Y18','Y19'
                                                                                     ,'Y39','Y40','Y41','Y42','Y43'
                                                                                     ,'Y45','Y46','Y47','Y49','Y50'
                                                                                     ,'Y51','Y52','Y53')
                                    	THEN '206' -- 무상
                                    WHEN NVL(#{i.BWARTSAP, jdbcType=VARCHAR},' ') IN ('641') 
                                    	THEN '221' -- 이송 
                                   	ELSE '201' -- 판매
                               END
                     END
	            WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_302','WMS_IFC302','WMS_IFB302','WMS_IFS302') THEN '221' --출고예정정보(이송)
	            WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_302','WMS_IFC302','WMS_IFB302','WMS_IFS302') 
	            	THEN CASE WHEN NVL(#{i.BWARTSAP, jdbcType=VARCHAR},' ') = '601' 
	            		THEN '201' --판매 
	            		ELSE '221' --출고예정정보(이송) 
            		END
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_303' THEN '205' --출고예정정보(자재,수입밀롤)
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_305' THEN '353' --생산투입불출정보
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_318' THEN '231' --반품출고예정정보(자재,상품)
	            WHEN #{i.IFID, jdbcType=VARCHAR} = 'WMS_IF_316' THEN '355' --생산투입정보(고지/펄프)
	       END --BWART
	     , NVL(#{i.ZLIKP_AEDAT, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LFART, jdbcType=VARCHAR},' ')
	     , NVL(#{i.WADAT, jdbcType=VARCHAR},' ')
	     , NVL(#{i.KUNNR, jdbcType=VARCHAR},' ')
	     , NVL(#{i.KUNAG, jdbcType=VARCHAR},' ')
	     , 'KN'
	     , NVL(#{i.MATNR, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LFIMG, jdbcType=VARCHAR},0)
	     , NVL(#{i.QTSHP, jdbcType=VARCHAR},0)
	     , NVL(#{i.MEINS, jdbcType=VARCHAR},' ')
	     , NVL(#{i.VGBEL, jdbcType=VARCHAR},' ')
	     , NVL(#{i.VGPOS, jdbcType=VARCHAR},' ')
	     , NVL(#{i.STKNUM, jdbcType=VARCHAR},' ')
	     , NVL(#{i.STATUS, jdbcType=VARCHAR},'C')
	     , NVL(#{i.BNAME, jdbcType=VARCHAR},' ')
	     , NVL(#{i.BPHON, jdbcType=VARCHAR},' ')	
	     , (SELECT WAREKY FROM STLMA WHERE OWNRKY = 'KN' AND PLNTKY = NVL(#{i.LOTA02, jdbcType=VARCHAR},' ') AND STLKY = NVL(TRIM(#{i.LOTA01, jdbcType=VARCHAR}), STLKY) AND WAREKY != ' ' AND ROWNUM = 1) --WAREKY
	     , NVL(#{i.MATNR, jdbcType=VARCHAR},' ')
	     , NVL(#{i.USRID1, jdbcType=VARCHAR},' ')
	     , NVL(#{i.DEPTID1, jdbcType=VARCHAR},' ')
	     , CASE WHEN #{i.IFID, jdbcType=VARCHAR} IN ('WMS_IF_305','WMS_IF_316') THEN NVL(#{i.ORDCAT, jdbcType=VARCHAR},'300')
	            ELSE NVL(#{i.ORDCAT, jdbcType=VARCHAR},'200')
	       END -- ORDCAT
	     , NVL(#{i.PTNRTY, jdbcType=VARCHAR},'CT')
	     , NVL(#{i.SBKTXT, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA01, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA02, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA03, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA04, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA05, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA06, jdbcType=VARCHAR},'00')
	     , CASE WHEN #{i.IFID} IN ('WMS_IF_303','WMS_IF_305') THEN NVL(#{i.LOTA07, jdbcType=VARCHAR},' ')
	            ELSE DECODE(NVL(#{i.SOBKZ, jdbcType=VARCHAR},' '), 'E', NVL(#{i.VBELV, jdbcType=VARCHAR},' ') || NVL(#{i.POSNV, jdbcType=VARCHAR},' '), ' ')
	       END
	     , NVL(#{i.LOTA08, jdbcType=VARCHAR},' ')
	     , CASE WHEN #{i.IFID} IN ('WMS_IF_303','WMS_IF_305') THEN NVL(#{i.LOTA09, jdbcType=VARCHAR},' ')
	            ELSE DECODE(NVL(#{i.SOBKZ, jdbcType=VARCHAR},' '), 'E', NVL(#{i.KUNAG, jdbcType=VARCHAR},' '), ' ')
	       END
	     , NVL(#{i.LOTA10, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA11, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA12, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA13, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA14, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA15, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA16, jdbcType=VARCHAR},0)
	     , NVL(#{i.LOTA17, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTA18, jdbcType=VARCHAR},0)
	     , NVL(#{i.LOTA19, jdbcType=VARCHAR},0)
	     , NVL(#{i.LOTA20, jdbcType=VARCHAR},0)
	     , NVL(#{i.TDLNR, jdbcType=VARCHAR},' ')
	     , NVL(#{i.TDLNR_NM, jdbcType=VARCHAR},' ')
	     , NVL(#{i.CARNO, jdbcType=VARCHAR},' ')
	     , NVL(#{i.CARTON, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOADTON, jdbcType=VARCHAR},0)
	     , NVL(#{i.CARART, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOADVOLUME, jdbcType=VARCHAR},0)
	     , NVL(#{i.DRIVERCEL, jdbcType=VARCHAR},' ')
	     , NVL(#{i.DTDIS, jdbcType=VARCHAR},' ')
	     , NVL(#{i.UZDIS, jdbcType=VARCHAR},' ')
	     , NVL(SUBSTRB(#{i.SIGNI, jdbcType=VARCHAR},0, 20),' ') -- I/F 수신시 자리값초과 예방
	     , NVL(#{i.EXTI2, jdbcType=VARCHAR},' ')
	     , NVL(#{i.SDABW, jdbcType=VARCHAR},' ')
	     , NVL(#{i.SAP12, jdbcType=VARCHAR},' ')
	     , NVL(#{i.SAP13, jdbcType=VARCHAR},' ')
	     , NVL(#{i.TDOBJECT, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOEKZ, jdbcType=VARCHAR},' ')
	     , NVL(#{i.BWARTSAP, jdbcType=VARCHAR},' ')
	     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS'), TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), NVL(TRIM(#{i.SES_USER_ID, jdbcType=VARCHAR}),#{i.IFID, jdbcType=VARCHAR})
	     , #{i.IFID, jdbcType=VARCHAR}
	     , 'N' --IFFLG
	     , 'I', TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS')
	     , 'N' --PRCFLG
	     , #{i.LOGSEQNO, jdbcType=VARCHAR}
	     , NVL(#{i.VTXTK, jdbcType=VARCHAR},' ')
	     , NVL(#{i.KVGR1, jdbcType=VARCHAR},' ')
	     , NVL(#{i.KVGR2, jdbcType=VARCHAR},' ')
	     , NVL(#{i.KVGR3, jdbcType=VARCHAR},' ')
	     , NVL(#{i.SOBKZ, jdbcType=VARCHAR},' ')
	     , NVL(#{i.AUGRU, jdbcType=VARCHAR},' ')
	     , NVL(#{i.STOKKY, jdbcType=VARCHAR},' ')
	     , NVL(#{i.LOTNUM, jdbcType=VARCHAR},' ')
	     , NVL(#{i.PO_NO, jdbcType=VARCHAR},' ')
	     , NVL(#{i.PO_REV, jdbcType=VARCHAR},NULL)
	     , NVL(#{i.PO_LNO, jdbcType=VARCHAR},NULL)
	     , NVL(#{i.TLOTA01, jdbcType=VARCHAR},' ')
	     , NVL(#{i.TLOTA02, jdbcType=VARCHAR},' ')
	     , NVL(#{i.ZKUNNR3, jdbcType=VARCHAR},' ')
	     , NVL(#{i.VTWEG, jdbcType=VARCHAR},' ')
	  FROM DUAL
		</foreach>
</insert>

<update id="IFWMS113_FLG_UPDATE" parameterType="Map">
	UPDATE IFWMS113
	   SET ITFFLG = NVL(#{ITFFLG},' ')
	     , ITFETX = NVL(#{ITFETX},' ')
	     , PRCFLG = CASE WHEN #{IFID} IN ('WMS_IF_301','WMS_IFC301','WMS_IFB301','WMS_IFS301','WMS_IFZ301','WMS_IF_302','WMS_IFC302','WMS_IFB302','WMS_IFS302','WMS_IF_318', 'TMS_IFC3012', 'TMS_IFB3012') THEN PRCFLG ELSE NVL(#{PRCFLG},' ') END
	     , PRCETX = CASE WHEN #{IFID} IN ('WMS_IF_301','WMS_IFC301','WMS_IFB301','WMS_IFS301','WMS_IFZ301','WMS_IF_302','WMS_IFC302','WMS_IFB302','WMS_IFS302','WMS_IF_318', 'TMS_IFC3012', 'TMS_IFB3012') THEN PRCETX ELSE NVL(#{PRCETX},' ') END
	     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
	     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
	     , LMOUSR = NVL(TRIM(#{SES_USER_ID}),#{IFID})
	 WHERE PRCFLG IN ('I','N','C')
	   AND LOGSEQNO = #{LOGSEQNO}
</update>

<update id="IFWMS113_IFZ301_UPDATE" parameterType="Map">
	MERGE INTO IFWMS113 T
	USING (
	    SELECT DISTINCT
	           I.LOGSEQNO,
	           D.STKNUM, 
	           H.SIGNI,
	           H.EXTI2
	      FROM IFWMS113 I
	      INNER JOIN SHPDI D ON D.STKNUM = I.STKNUM
	      INNER JOIN SHPDH H ON H.SHPOKY = D.SHPOKY
	     WHERE I.LOGSEQNO = #{LOGSEQNO}
	) S ON (T.LOGSEQNO = S.LOGSEQNO AND T.STKNUM   = S.STKNUM)
	WHEN MATCHED THEN
	UPDATE SET
	    T.SIGNI = S.SIGNI,
	    T.EXTI2 = S.EXTI2 
</update>

