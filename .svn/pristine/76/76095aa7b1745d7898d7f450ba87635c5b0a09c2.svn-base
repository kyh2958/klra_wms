<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%	String STKNUM = request.getParameter("STKNUM");
	String TASKKY = request.getParameter("TASKKY");
	String PREVITEM = request.getParameter("PREVITEM");
	String COMPLETE_YN = request.getParameter("COMPLETE_YN");
	String SEARCHCOUNT = request.getParameter("SEARCHCOUNT");
	
	if(STKNUM == null){
		STKNUM = "";
	}
	
	if(TASKKY == null){
		TASKKY = "";
	}
	
	if(PREVITEM == null){
		PREVITEM = "YES";
	}
	
	if(COMPLETE_YN == null){
		COMPLETE_YN = "N";
	}
	
	if(SEARCHCOUNT == null){
		SEARCHCOUNT = "";
	}
%>
<!doctype html>
<head>
<style type="text/css">
button{ vertical-align: bottom; height: 37px; }
input:read-only{ background-color: #e2e2e2; }
select:disabled{ background-color: #e2e2e2; }
.tem5_content .tableWrap_search  { overflow: hidden; }
.tem4_content .select_box table  { width  : 98% !important; margin: auto; }
.tem4_content .select_box .text  { padding: unset !important; margin: unset !important; }
.tem4_content table th           { padding: 3px !important; white-space: normal; }
.tem4_content table td           { padding: 3px !important; }
.number { text-align: right }
</style>
<meta charset="utf-8">
<meta name="viewport" content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width, target-densitydpi=medium-dpi" />
<meta name="format-detection" content="telephone=no" />
<title>Mobile WMS</title>
<%@ include file="/mobile/include/head.jsp" %>
<script>
	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",
			editable : false,
			module : "WmsMobileOutboundPicking",
			command : "PDLD21",
			gridMobileType : true,
			emptyMsgType:false
		});
		
		gridList.setGrid({
			id : "gridListHidden",
			editable : false,
			module : "WmsMobileOutboundPicking",
			command : "PDLD21_COUNT",
			gridMobileType : true,
			emptyMsgType : false
		}); 
		
		if("<%=STKNUM%>" != "") {
			$("#STKNUM").val("<%=STKNUM%>");
			var param = inputList.setRangeParam("searchArea");
			param.put("LANGKY", "<%=langky%>");
			param.put("WAREKY", "<%=wareky%>");
			
			if(new Number(<%=SEARCHCOUNT%>) < 2){
				param.put("TASKKY", "<%=TASKKY%>");
			}
				
			searchList(param);
		}
		
		$("#STKNUM").focus();
				
	});
	
	var goFlag = true;
	
	if("<%=PREVITEM%>" == "NO"){
		goFlag = false;
	}
	
	// 작업지시번호로 문서정보검색
	function searchList(resParam){		
		
		if(!validate.check("searchArea")){
			return;
		}
		
		var param = inputList.setRangeParam("searchArea");
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("LANGKY", "<%=langky%>");
<%-- 		param.put('PLNTKY', '<%=plntky%>'); --%>
		param.put("PROGID", "PK05");
		
		if(resParam != null && resParam !=''){
			param.put('TASKKY', resParam.get("TASKKY"));	
		}
		
		gridList.gridList({
			id : "gridList",
			param : param
		});
	
		gridList.gridList({
			id : "gridListHidden",
			param : param
		});	
		
		searchedParam = new DataMap();
		searchedParam.putObject(structuredClone(param.map));
	}
	
	function start(){
		var param = new DataMap();
		var head = gridList.getSelectData("gridList");	
		
		var stknum = $("#STKNUM").val();
		var checkCnt=0;
		
		if(head.length < 1) {
			PlaySound("e");					
			commonUtil.msgBox("MOBILE_M0039", null, null, function () { //체크박스 선택 후 상차완료를 진행해주세요.
				$('#STKNUM').focus();  
			}); 
			return;
		}	
		
		commonUtil.msgConfirm("SYSTEM_M0129",null,
			function () {
			
					param.put("head", head);
					param.put("WAREKY", "<%=wareky%>");
					param.put("OWNRKY", "<%=ownrky%>");	
			<%-- 		param.put("PLNTKY", '<%=plntky%>'); --%>
			
					var json = netUtil.sendData({
						url: "/mobile/Mobile/json/PDLD21SaveEnd.data",
						param: param
					});
			
					if(json && json.data) {
						if(!json.data.CNT && json.data.SHPOKY){
							PlaySound("e");	
				    		commonUtil.msgBox("OUT_M0195", json.data.SHPOKY, null, function () {
				    			$('#STKNUM').focus();  
							}); 
							return;
				    	}else{
				    						
				    		PlaySound("s");	
							commonUtil.msgBox("SYSTEM_M0133", null, null, function () { 
								searchList();
							}); 
							return;
							
				    	}			
					}	
				}, function () {
					$('#STKNUM').focus();   
					return;
				}
			);
				
		
	}
		
	function reset() {
		
		gridList.resetGrid("gridList");
		$("#TOTCOMPCNT").val("");
		$("#NOWCOMPCNT").val("");
		
		$('#STKNUM').val("");
		$('#STKNUM').focus();
		
	}	
		
	
	function gridListEventRowDblclick(gridId, rowNum, colName){
		
		var FCKCOM = gridList.getColData("gridList", rowNum, "FCKCOM")
		
		if(FCKCOM == "V"){
						
			PlaySound("e");					
			commonUtil.msgBox("MOBILE_M0044", null, null, function () { //이미 상차완료된 지시건입니다.
				$('#STKNUM').focus();            			
			}); 
			
			return;
		}
		
		
		
		if(colName != "FCKCOM"){
 		
		
		var STKNUM = gridList.getColData("gridList", rowNum, "STKNUM");
 		var SHPOKY = gridList.getColData("gridList", rowNum, "SHPOKY");
		var DPTNKY = gridList.getColData("gridList", rowNum, "PTNRKY");
		var TASKKY = gridList.getColData("gridList", rowNum, "TASKKY");	
		var SEARCHCOUNT = gridList.getGridData("gridList").length;
		
		location.href="/mobile/PDLD21_DETAIL.page?STKNUM="+STKNUM+"&DPTNKY="+DPTNKY+"&SHPOKY="+SHPOKY+"&TASKKY="+TASKKY+"&SEARCHCOUNT="+SEARCHCOUNT;
		}
		
		
	}
	
	
	function gridListEventDataBindEnd(gridId, dataLength){
		if(gridId == "gridListHidden" && dataLength > 0){
			$("#TOTCOMPCNT").val(gridList.getColData("gridListHidden", 0, "TOTCOMPCNT"));
			$("#NOWCOMPCNT").val(gridList.getColData("gridListHidden", 0, "NOWCOMPCNT"));
			$('#STKNUM').attr("readonly",true);
			$('#STKNUM').focus();
			setTimeout(function(){ $('#STKNUM').attr("readonly",false);}, 50);
			
		}else if(gridId == "gridList" && dataLength == 0){
			PlaySound('e');
			gridList.resetGrid("gridList");
			$("#TOTCOMPCNT").val(0);
			$("#NOWCOMPCNT").val(0);
			
			if("<%=COMPLETE_YN%>" == "Y"){
				$('#STKNUM').val("");
				$("#TOTCOMPCNT").val(0);
				$("#NOWCOMPCNT").val(0);
			}else{
				
				commonUtil.msgBox("VALID_M0005", null, null, function () { //조회된 데이터가 없습니다.
					$('#STKNUM').focus();  
				});
			}
			
		}else if(gridId == "gridList" && dataLength > 0){
			
			PlaySound("s");
			
			for(var i=0; i < dataLength; i++){
				
				if(gridList.getColData(gridId, i, "FCKCOM") == "V"){
					gridList.setRowCheck(gridId, i, true);
					gridList.setRowReadOnly(gridId, i, true, ["rowCheck"]);
				}
				
				if(dataLength == 1 && i == 0 && goFlag == true){
					
					if(gridList.getColData(gridId, i, "FCKCOM") != "V"){
						gridListEventRowDblclick("gridList", 0);
					}
					
				}
								
			}
			
			$('#STKNUM').focus();
		}
		
		
	}

	
	function eventKeydown(event,objId){
		if(event.keyCode == "13" && objId == "STKNUM"){
			if(validate.check("searchArea")){
				
				var key = $.trim($("#STKNUM").val());
				if(key == ""){
					PlaySound("e");					
					commonUtil.msgBox("VALID_M2125", null, null, function () { //지시번호를 입력해주세요.
						$('#STKNUM').focus();            			
					}); 
					return;	
				}
				
				var param = inputList.setRangeParam("searchArea");
				param.put("STKNUM", $("#STKNUM").val());
				param.put("WAREKY", "<%=wareky%>");
				//$("#STKNUM").select();
				goFlag = true;
				
				
				  	var json = netUtil.sendData({
						url : "/mobile/Mobile/json/OrderCheck.data",			
						param : param
					});
					
				  	var msgCheck = 0;
				  	
					if(json && json.data){
						
						if(json.data.CNT == 0){														
							
							msgCheck++;
							
							
							
						}else if(json.data.CNT > 0 && json.data.MSG != 'Y'){
							
							var msgList = json.data.MSG.split("†");
			                var msgTxt = commonUtil.getMsg(msgList[0],(msgList.length > 1 ? msgList[1].split("/") : null));
			                
// 			                commonUtil.msgBox(msgTxt);//출하문서번호 [{0}] 작업상태가 [{1}] 입니다.
// 			                $('#STKNUM').focus();
			                
			                
			                PlaySound("e");					
							commonUtil.msgBox(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null), null, function () { //출하문서번호 [{0}] 작업상태가 [{1}] 입니다.
								$('#STKNUM').focus();            			
							}); 
							
							return;
						}else{
						
							searchList(param);
						
						}																							
						
					}
					
					if(msgCheck > 0){
						PlaySound("e");
						setTimeout(() => {
						commonUtil.msgBox("MOBILE_M0049", null, null, function () {  //존재하지 않는 지시번호입니다.
							
								$('#STKNUM').focus();															  
							return;    			
						}); 
						
						}, 100);
					}
									
			}
		}
	}
	
	function searchStknumList(){
		
		var param = new DataMap();
		
		param.put('WAREKY', '<%=wareky%>');
<%-- 		param.put('PLNTKY', '<%=plntky%>'); --%>
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("STATIT", "FPC");
		
		mobile.linkPopOpen('/mobile/PDPK05_DOC_POP.page', param);
	}
	
	// 팝업 callback
	function DocPopCallback (data) {
		$('#STKNUM').val(data.get('STKNUM'));
		
		var param = new DataMap();
		param.put("TASKKY", data.get('TASKKY'));
		
		goFlag = true;
		searchList(param);
	}
	

	function gridListEventRowCheckAll(gridId, checkType) {
		
		for(var i = 0; i < gridList.getGridData(gridId).length; i++){
			
			if(gridList.getColData(gridId, i, "FCKCOM") == "V"){
				gridList.setRowCheck(gridId, i, true);	
			}
		}
		
	}
</script>
</head>
<body>
	<div class="main_wrap">
		<div class="tem4_content">
			<div class="select_box" id="bindArea">
				<div id="searchArea">
					<table>
						<colgroup>
							<col width="80px" />
							<col width="200px" />
							<col width="*" />
						</colgroup>
						<tbody>
							<tr style="display:none">
								<th CL="STD_OWNRKY" width="100">화주</th>
								<td>
									<input type="hidden" id="selectSKU">
									<!-- <select Combo="WmsMaster_ComboBoxDatas,OWNER" name="OWNRKY" id="OWNRKY"">
									</select> -->
								</td>
							</tr>
							<tr>
								<th CL='STD_STKNUM1'>지시번호</th>
								<td colspan="2">
									<input type="text" class="text" name="STKNUM" id="STKNUM" onfocus="this.select();" onkeydown="eventKeydown(event,this.id)"/>
								</td>
								<td onclick ="searchStknumList()">
								<button class="bt" style="height: 32px;">
									<p CL='BTN_SEARCH'></p>
								</button>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			<div class="tableWrap_search section" >
				<div class="tableHeader">						 
					<table style="width: 100%;">
						<colgroup>
							<col width="40px" />        
<!-- 							<col width="40px" /> -->
							<col width="45px" />        
							<col width="100px" />       
							<col width="85px" />        
							<col width="75px" />        
							<col width="250px" />       
						</colgroup> 
						<thead>
							<tr>
								<th CL="STD_NO">NO</td>
								<th GBtnCheck="true"></th>	
<!-- 								<th CL="STD_FCKCOM">상차완료</th> -->
								<th CL="STD_TASKKY">작업지시번호</td>								
								<th CL="STD_TASSTATDONM">작업상태명</th>
								<th CL="STD_DPTNKY2">납품처</th>
								<th CL="STD_DPTNNM3">납품처명</th>
							</tr>
						</thead>
					</table>
				</div>
				<div class="tableBody">
					<table style="width: 100%;">
						<colgroup>
							<col width="40px" />
							<col width="45px" />
							<col width="100px" />
							<col width="75px" />
							<col width="250px" />
							<col width="85px" />
							<col width="0" />
							<col width="0" />
							<col width="0" />
							<col width="0" />
						</colgroup>
						<tbody id="gridList">
							<tr CGRow="true">
								<td GCol="rownum">NO</td>
								<td GCol="rowCheck">상차완료</td>
								<td GCol="text,TASKKY">작업지시번호</td>
								<td GCol="text,PTNRKY">납품처</td>
								<td GCol="text,PTNRNM">납품처명</td>
								<td GCol="text,STATITNM">완료여부</td>
								
								<td GCol="text,STKNUM" hidden="hidden">지시번호</td>
								<td GCol="text,FCKCOM" hidden="hidden">상차완료</td>
								
								<td GCol="text,SHPOKY" hidden="hidden">출고지시번호</td>
								<td GCol="text,SHPOIT" hidden="hidden">출고지시아이템번호</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			<!-- gridListHidden 데이터만 가지고오기 -->
				<div style="margin-bottom: 0px;display:none;">
					<div class="tableHeader">
						<table> 
							<thead>
								<tr class="thead">
									<th CL="STD_NO">순번</th>
									<th CL="STD_STKNUM">작업지시번호</th>
								</tr>
							</thead>
						</table>
					</div>
					<div class="tableBody">
						<table style="width: 900px">
							<tbody id="gridListHidden">
								<tr CGRow="true">
									<td GCol="text,TOTCOMPCNT">완료건수</td>
									<td GCol="text,NOWCOMPCNT">중 count</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			<div class="select_box">
				<table>
					<colgroup>
						<col width="100px"/>
						<col width="50px"/>
						<col width="50px"/>
						<col width="50px"/>
						<col width="50px"/>
						<col width="50px"/>
						<col width="50px"/>
					</colgroup>
					<tbody>
						<tr>
							<th  CL='STD_COMPCNT'>완료건수</th>
							<td CL='STD_ALL'>전체</td>
							<td>
								<input type="text" class="text gridColInputNumber" name="TOTCOMPCNT" id="TOTCOMPCNT" readonly/>
							</td>
							<td CL='STD_CNT'>count</td>
							<td CL='STD_INCLU'>중</td>
							<td>
								<input type="text" class="text gridColInputNumber" name="NOWCOMPCNT" id="NOWCOMPCNT" readonly/>
							</td>
							<td CL='STD_CNT'>count</td>
						</tr>
					</tbody>
				</table>
			</div>
			<!-- end table_body -->
			<div class="footer_5" style="position:fixed;" >
				<table>
					<tr>
						<td class=f_1 width="30%" onclick="window.top.closePage()">
							<label CL='BTN_CLOSE'></label>
						</td>												
						<td class=f_1 width="30%" onclick="reset()">
							<label CL='BTN_RESET'></label>
						</td>						
						<td class=f_1 width="30%" onclick ="start()" >
							<label CL='BTN_COMPLE'></label>
						</td>
					</tr>
				</table>
			</div><!-- end footer_5 -->	
		</div>
	</div>
</body>