				row.put("TLOTA19",  (row.get("ALOTA19").toString().trim() != "") ? row.get("ALOTA19") : row.get("TLOTA19"));
				row.put("TLOTA20",  (row.get("ALOTA20").toString().trim() != "") ? row.get("ALOTA20") : row.get("TLOTA20"));
			} else if(ifid.equals("WMS_IF_404")) { // WMS_IF_404 저장위치변경정보
				row.put("BWART", "401"); // 오더유형 - 재고저장위치변경
				                                                                              row.put("TLOTA03", row.get("LOTA03")); row.put("TLOTA04", row.get("LOTA04")); row.put("TLOTA05", row.get("LOTA05"));
				row.put("TLOTA06", row.get("LOTA06")); row.put("TLOTA07", row.get("LOTA07")); row.put("TLOTA08", row.get("LOTA08")); row.put("TLOTA09", row.get("LOTA09")); row.put("TLOTA10", row.get("LOTA10"));
				row.put("TLOTA11", row.get("LOTA11")); row.put("TLOTA12", row.get("LOTA12")); row.put("TLOTA13", row.get("LOTA13")); row.put("TLOTA14", row.get("LOTA14")); row.put("TLOTA15", row.get("LOTA15"));
				row.put("TLOTA16", row.get("LOTA16")); row.put("TLOTA17", row.get("LOTA17")); row.put("TLOTA18", row.get("LOTA18")); row.put("TLOTA19", row.get("LOTA19")); row.put("TLOTA20", row.get("LOTA20"));
				
				row.put("TLOTA02",  (row.get("ALOTA02").toString().trim() != "") ? row.get("ALOTA02") : row.get("TLOTA02")); // 플랜트
				row.put("TLOTA01",  (row.get("ALOTA01").toString().trim() != "") ? row.get("ALOTA01") : row.get("TLOTA01")); // 저장위치
				row.put( "TMATNR",  (row.get( "SKUKEY").toString().trim() != "") ? row.get( "SKUKEY") : row.get( "TMATNR")); // 품목코드
				row.put(  "MEINS",  (row.get( "UOMKEY").toString().trim() != "") ? row.get( "UOMKEY") : row.get(  "MEINS")); // 단위
				row.put("DOCDAT", map.get("DOCDAT").toString()); //CREDAT로 INSERT
			} else if(ifid.equals("WMS_IF_405")) { // WMS_IF_405 품목코드 변경 (MTM)
				row.put("BWART", "421"); // 오더유형 - 재고품목변경(MtoM)
				row.put("TLOTA01", row.get("LOTA01")); row.put("TLOTA02", row.get("LOTA02")); row.put("TLOTA03", row.get("LOTA03")); row.put("TLOTA04", row.get("LOTA04")); row.put("TLOTA05", row.get("LOTA05"));
				row.put("TLOTA06", row.get("LOTA06")); row.put("TLOTA07", row.get("LOTA07")); row.put("TLOTA08", row.get("LOTA08")); row.put("TLOTA09", row.get("LOTA09")); row.put("TLOTA10", row.get("LOTA10"));
				row.put("TLOTA11", row.get("LOTA11")); row.put("TLOTA12", row.get("LOTA12")); row.put("TLOTA13", row.get("LOTA13")); row.put("TLOTA14", row.get("ALOTA14")); row.put("TLOTA15", row.get("LOTA15"));
				row.put("TLOTA16", row.get("LOTA16")); row.put("TLOTA17", row.get("LOTA17")); row.put("TLOTA18", row.get("LOTA18")); row.put("TLOTA19", row.get("LOTA19")); row.put("TLOTA20", row.get("LOTA20"));
				
				row.put("TMATNR",  (row.get("ASKUKEY").toString().trim() != "") ? row.get("ASKUKEY") : row.get("TMATNR")); // 품목코드
				row.put( "MEINS",  (row.get("AUOMKEY").toString().trim() != "") ? row.get("AUOMKEY") : row.get( "MEINS")); // 품목코드
			}
			
			row.put("UI", ui);
			
			// 240129 row 데이터를 JSON 형태로 변경
			DataWmsMap wmsMap = util.convertAll(row);
	        String jsonStr = "";
			try {
				jsonStr = util.mapToJson(wmsMap);
			} catch (JsonProcessingException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
	        			
			DataWmsMap ifMap = new DataWmsMap();
			ifMap.setModuleCommand("WmsInventory", "IFWMS223_IF");
			//ifMap.put("P_TYPE", "map");
			ifMap.put("P_JSON_STR", jsonStr);
			ifMap.put("P_ERR_CODE", "");
			ifMap.put("P_ERR_MSG", "");			
			
			//commonDao.getMap(ifMap);
			commonDao.insert(ifMap);
			
			errMsg = ifMap.getString("P_ERR_MSG");
			//commonDao2.insert(row);
			
			System.out.println(ifMap.getString("P_ERR_MSG"));
			System.out.println(ifMap.getString("P_ERR_CODE"));
		}
		
		// 처리결과
		if(!errMsg.equals("SUCCESS")){
			throw new RuntimeException("[ROLLBACK]\n" + errMsg);
		}
		
		return errMsg;
	}

	@Transactional
	public String send_IFWMS223(DataMap map) throws SQLException{
		// WMS_IF_903 MTO/MTS 자동처리
		// WMS_IF_401 재고상태변경정보
		// WMS_IF_402 MTO/MTS변경정보 -- 삭제
		// WMS_IF_403 제조LOT변경정보 -- 삭제
		// WMS_IF_404 저장위치변경정보
		// WMS_IF_405 품목코드 변경 (MTM)
		String errMsg = "SUCCESS";
		String ifid = map.getString("IFID");
		String logseqno = map.getString("LOGSEQNO");
		
		List<DataMap> if223List = new ArrayList<DataMap>();
		DataMap row = new DataMap();
		row.setModuleCommand("Erpif", "IFWMS223");
		row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		row.put("IFID", ifid);
		row.put("LOGSEQNO", logseqno);
		if223List = commonDao.getList(row); 
		
		if(if223List == null || if223List.size() == 0){
			errMsg="전송할 데이터가 없습니다. "+ifid;
			return errMsg;
		}
		
		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		PostRequest postRequest = new PostRequest();
		JSONArray jarr = new JSONArray();
		JSONObject jobj = new JSONObject();
		JSONObject jsend = new JSONObject();

		DataMap smap = new DataMap();
		for(int i=0; i < if223List.size(); i++) {
			smap = if223List.get(i);
			
			jobj = new JSONObject();

			if (ifid.equals("WMS_IF_903") || ifid.equals("WMS_IF_401") || ifid.equals("WMS_IF_402") || ifid.equals("WMS_IF_404") || ifid.equals("WMS_IF_405")) {
				// WMS_IF_903 MTO/MTS 자동처리
				// WMS_IF_401 재고상태변경정보
				// WMS_IF_402 MTO/MTS변경정보
				// WMS_IF_403 제조LOT변경정보 -- 삭제
				// WMS_IF_404 저장위치변경정보
				// WMS_IF_405 품목코드 변경 (MTM)
				for(int icol=0; icol < mpcolList.size(); icol++) {
					if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
						if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
							String commaStr = mpcolList.get(icol).get("SOURCE").toString();
							String[] commaStrList = commaStr.split(",");
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(commaStrList[0]).toString() + smap.get(commaStrList[1]).toString());
						} else {
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(mpcolList.get(icol).get("SOURCE")));
						}
					}
				}
			} else {
				// SAP측 매핑컬림
				jobj.put("BLDAT", smap.get("CREDAT")); 	// 전표 증빙일
				jobj.put("BUDAT", smap.get("CREDAT")); 	// 전표의 전기일
				jobj.put("BKTXT", smap.get("ZDOC_NO").toString() + smap.get("ZDOC_ITEM").toString()); // 전표 헤더 텍스트
				jobj.put("WMSDN", smap.get("ZDOC_NO")); // WMS 문서 헤더
				jobj.put("BWART", smap.get("BWARTSAP")); // 이동 유형(재고 관리)
				jobj.put("MATNR", smap.get("MATNR")); 	// 자재 번호
				jobj.put("WERKS", smap.get("LOTA02")); 	// 플랜트
				jobj.put("LGORT", smap.get("LOTA01")); 	// 저장 위치
				jobj.put("CHARG", smap.get("LOTA15")); 	// 배치 번호
				jobj.put("UMMAT", smap.get("MATNR")); 	// 입고/출고 자재
				jobj.put("UMWRK", smap.get("TLOTA02")); // 입고/출고 플랜트
				jobj.put("UMLGO", smap.get("TLOTA01")); // 입/출고 저장 위치
				jobj.put("UMCHA", smap.get("QTADJU")); 	// 입고/출고 배치
			}
			
			jarr.add(jobj);
		}

		jsend.put("list", jarr);

		// 데이터 전송
		// MES, PTL : RESTFUL
		// SAP : RFC
		DataMap rd = new DataMap();
		DataMap rfcinfo = new DataMap();
		DataMap rfcrst = new DataMap();
		rfcinfo.setModuleCommand("Erpif", "RFCINFO");
		rfcinfo.put("IFID", ifid);
		rfcrst = commonDao.getMap(rfcinfo); 
		
		String rfcfn = rfcrst.get("RFCFN").toString();		// FUNCTION
		String rfctbl = rfcrst.get("RFCTBL").toString();	// IF_RETBL
		String rfcp1 = rfcrst.get("RFCP1").toString();		// IF_RESTR
		String rfcp2 = rfcrst.get("RFCP2").toString();
		
		// SAP
		List<DataMap> sendlist = new ArrayList();
		RfcCallFunction sapConn = new RfcCallFunction();
		
		DataMap xx = new DataMap();
		xx.put("list", getMapFromJsonObject(jsend).get("list"));
//			DataMap xx = getListMapFromJsonArray(jsend);
		
		sendlist.add(xx);

		// param map
		DataMap pMap = new DataMap();
		pMap.put("I_IF_NAM", ifid);
		pMap.put("I_IF_KEY", logseqno);
		
		log.debug("\nRFC SEND4 ("+rfcfn+","+rfctbl+","+rfcp1+","+rfcp2+","+pMap+") --------------\n"+sendlist.toString());
		List<DataMap> resList = new ArrayList();
		try {
			resList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, sendlist);
			// 전송결과 처리
			for (DataMap res : resList) {
				String resultStr = res.getString("TYPE");
				DataMap param = new DataMap();
				param.putAll(res);
				param.put("IFID", ifid);
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				param.setModuleCommand("Erpif", "IFWMS223_FLG"); //전송결과 update
				
				if ("S".equals(resultStr)) {     // 성공 응답 시
					rd.put("result", "SUCCESS");
					
					param.put("PRCFLG", "C");
					commonDao.update(param); // UPDATE IFWMS223
					
					// UPDATE ADJDI
					param.setModuleCommand("Erpif", "IFWMS223_ADJDI");
					commonDao.update(param);
				} else {                         // 실패 응답 시
					errMsg = res.getString("MESSAGE");
					
					if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }

					rd.put("result", errMsg);
					
					param.put("PRCFLG", "E");
					param.put("PRCETX", errMsg);
					commonDao.update(param); // UPDATE IFWMS223
				}
			}
			
//			rd.put("result", "SUCCESS");
		} catch (Exception e) {
			errMsg = e.getMessage();
			if (errMsg != null && errMsg.length() > 200) {
				errMsg = errMsg.substring(0, 200);
				rd.put("result", errMsg.substring(0, 200));
			} else {
				rd.put("result", errMsg);
			}
		}
		
		//log.debug("\nSAP Response: " + resList);

		
		return errMsg;
	}

	@Transactional
	public String receive_IFWMS900(DataMap map) throws SQLException{
		// 재고 수신 (오픈전)
		List<DataMap> list = map.getList("data");
		String errMsg = "SUCCESS";
		
		// interface 등록 : 수신데이터 변형없이 원본 그대로 저장

		String ifid     = map.get("IFID").toString();
		String rfcfn    = map.get("rfcfn").toString();
		String rfctbl   = map.get("rfctbl").toString();
		String rfctbl2  = map.get("rfctbl2").toString();
		String rfcp1    = map.get("rfcp1").toString();
		String rfcp2    = map.get("rfcp2").toString();
		String logseqno = map.get("LOGSEQNO").toString();
		String isExcelUpload = map.get("REMARK").toString();
		String werks = list.get(0).getString("WERKS");
		
		// MULTI INSERT
		List<HashMap> mlist1 = new ArrayList<HashMap>();
		HashMap row = new HashMap();
		try {
			DataMap werksMap = new DataMap();
			werksMap.setModuleCommand("Erpif", "IFWMS900_WERKS");
			werksMap.put("WERKS", werks);
			werksMap.put(CommonConfig.SES_USER_ID_KEY, ifid);
			commonDao.delete(werksMap);
			
			for(int i = 0 ; i < list.size() ; i ++){
				row = list.get(i).getMap("map");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				mlist1.add(row);
	
				if(((i+1) % 100) == 0) {
					commonDao.insert("IFWMS900_MULTI", mlist1);
					mlist1.clear();
				}
			}
			
			if(mlist1.size() > 0) {
				commonDao.insert("IFWMS900_MULTI", mlist1);
				mlist1.clear();
			}
		} catch (Exception e) {
			errMsg = e.getMessage();
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
		}
		// MULTI INSERT
		
		// 통신,인터페이스 FLAG 셋팅
		DataMap comFLG  = new DataMap();
		comFLG.setModuleCommand("Erpif", "IFWMSLOG");
		comFLG.put("IFID", map.get("IFID"));
		comFLG.put("SEQNO", logseqno);
		DataMap setFLG  = new DataMap();
		setFLG.setModuleCommand("Erpif", "IFWMS900_FLG");
		setFLG.put("IFID", map.get("IFID"));
		setFLG.put("LOGSEQNO", logseqno);

		if(!errMsg.equals("SUCCESS")){
			// 통신 에러처리
			comFLG.put("COMSTAT", "E");
			comFLG.put("ERRTXT", errMsg);
			commonDao.update(comFLG);
			// 인터페이스 에러처리
			setFLG.put("ITFFLG", "E");
			setFLG.put("ITFETX", errMsg);
			commonDao.update(setFLG);
		} else {
			// SAP의 RFC를 호출해서 수신받는 경우 IFTABLE까지 정상적으로 등록된후 그 결과를 전송하는 RFC를 다시 호출해줘야함
			// SAP에서는 본 호출을 통해 정상적으로 전송이 되었음을 인지하고 후속처리하도록 해야함
			// 여기까지 프로세스가 진행되었으면 IFTABLE에는 정상적으로 등록된 상태며
			// 이후 SAP에 수신완료 결과를 호출할때 SAP측에서 오류나더라도 패스함
			DataMap rtnRst = new DataMap();
			if(!isExcelUpload.equals("EXCEL")) {
				// 수신완료 R호출 패스
				
				rtnRst.put("TYPE", "S");
				rtnRst.put("MESSAGE", "");
			}
			
			if(rtnRst.get("TYPE").equals("S") || isExcelUpload.equals("EXCEL")) {
				// 통신 완료처리
				comFLG.put("COMSTAT", "R");
			} else {
				comFLG.put("COMSTAT", "E");
				comFLG.put("ERRTXT", rtnRst.get("MESSAGE"));
			}
			commonDao.update(comFLG);

			// 인터페이스 완료처리
			setFLG.put("ITFFLG", "C");
			setFLG.put("ITFETX", "");
			commonDao.update(setFLG);
			// -------------------- 여기까지는 통신완료 처리 --------------------
			
			// 수신결과 R 호출 응답에러가 나더라도 데이터는 정상적으로 수신된것으로 마스터의 경우 일단 진행함
			if(rtnRst.get("TYPE").equals("S") || rtnRst.get("TYPE").equals("E") || isExcelUpload.equals("EXCEL")) {
				// 프로시저 호출전 I 변경
//				setFLG.put("PRCFLG", "I");
//				commonDao.update(setFLG);
//				
//				// procedure 호출 프로시저내에서 작업완료후 플래그 완료처리
//				DataMap procMap = new DataMap();
//				procMap.setModuleCommand("Erpif", "IFWMS900");
//				procMap.put("IFID", ifid);
//				procMap.put("LOGSEQNO", logseqno);
//				procMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
//				procMap.put("result", "");
//				commonDao.getMap(procMap);
////				//log.debug("------------------------------" + procMap.get("result"));
//				if (!procMap.get("result").toString().equals("SUCCESS")) {
//					errMsg = procMap.get("result").toString();
//	
//					// 인터페이스 프로시저 에러처리
//					setFLG.put("PRCFLG", "E");
//					setFLG.put("PRCETX", errMsg);
//					commonDao.update(setFLG);
//	
//					// 통신완료후 발생한 에러처리
//					comFLG.setModuleCommand("Erpif", "IFWMSLOG_INERR");
//					comFLG.put("SEQNO", logseqno);
//					comFLG.put("ERRTXT", errMsg);
//					commonDao.update(comFLG);
//				}
			}
		}
		
		return errMsg;
	}

	/**
	 * JSONArray를 List<Map<String, String>>으로 변환
	 * 
	 * @param jsonArray
	 * @return list
	 */
	public static List<Map<String, Object>> getListMapFromJsonArray(JSONArray jsonArray) {

		List<Map<String, Object>> list = new ArrayList<Map<String, Object>>();

		if (jsonArray != null) {

			int jsonSize = jsonArray.size();

			for (int i = 0; i < jsonSize; i++) {

				Map<String, Object> map = getMapFromJsonObject((JSONObject)jsonArray.get(i));
				list.add(map);
			}
		}

		return list;
	}

	/**
	 * JSONObject를 Map<String, String>으로 변환
	 * 
	 * @param jsonObject
	 * @return map
	 */
	@SuppressWarnings("unchecked")
	public static Map<String, Object> getMapFromJsonObject(JSONObject jsonObject) { 

		Map<String, Object> map = null;
		
		try {

			map = new ObjectMapper().readValue(jsonObject.toJSONString(), Map.class);

		} catch (JsonParseException e) {
			e.printStackTrace();
		} catch (JsonMappingException e) {
			e.printStackTrace();
		} catch (IOException e) {
			e.printStackTrace();
		}
		
		return map;
	}

	@Transactional
	public String send_IFWMS999(DataMap map) throws SQLException{
		// WMS_IF_999 재고검증
		String errMsg = "SUCCESS";
		String ifid = map.getString("IFID");
		String logseqno = map.getString("LOGSEQNO");
		
		List<DataMap> if999List = new ArrayList<DataMap>();
		DataMap row = new DataMap();
		row.setModuleCommand("Erpif", "IFWMS999");
		row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		row.put("IFID", ifid);
		row.put("LOGSEQNO", logseqno);
		if999List = commonDao.getList(row); 
		
		if(if999List == null || if999List.size() == 0){
			errMsg="전송할 데이터가 없습니다. "+ifid;
			return errMsg;
		}
		
		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		PostRequest postRequest = new PostRequest();
		JSONArray jarr = new JSONArray();
		JSONObject jobj = new JSONObject();
		JSONObject jsend = new JSONObject();

		DataMap smap = new DataMap();
		for(int i=0; i < if999List.size(); i++) {
			smap = if999List.get(i);
			
			jobj = new JSONObject();

			if (ifid.equals("WMS_IF_999")) {
				// WMS_IF_999 재고검증
				for(int icol=0; icol < mpcolList.size(); icol++) {
					if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
						if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
							String commaStr = mpcolList.get(icol).get("SOURCE").toString();
							String[] commaStrList = commaStr.split(",");
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(commaStrList[0]).toString() + smap.get(commaStrList[1]).toString());
						} else {
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(mpcolList.get(icol).get("SOURCE")));
						}
					}
				}
			}
			
			jarr.add(jobj);
		}

		jsend.put("list", jarr);

		// 데이터 전송
		// SAP : RFC
		DataMap rd = new DataMap();
		DataMap rfcinfo = new DataMap();
		DataMap rfcrst = new DataMap();
		rfcinfo.setModuleCommand("Erpif", "RFCINFO");
		rfcinfo.put("IFID", ifid);
		rfcrst = commonDao.getMap(rfcinfo); 
		
		String rfcfn = rfcrst.get("RFCFN").toString();		// FUNCTION
		String rfctbl = rfcrst.get("RFCTBL").toString();	// IF_RETBL
		String rfcp1 = rfcrst.get("RFCP1").toString();		// IF_RESTR
		String rfcp2 = rfcrst.get("RFCP2").toString();
		
		// SAP
		List<DataMap> sendlist = new ArrayList();
		RfcCallFunction sapConn = new RfcCallFunction();
		
		DataMap xx = new DataMap();
		xx.put("list", getMapFromJsonObject(jsend).get("list"));
		
		sendlist.add(xx);

		// param map
		DataMap pMap = new DataMap();
		pMap.put("I_IF_NAM", ifid);
		pMap.put("I_IF_KEY", logseqno);
		
		log.debug("\nRFC SEND5 ("+rfcfn+","+rfctbl+","+rfcp1+","+rfcp2+","+pMap+") --------------\n"+sendlist.toString());
		List<DataMap> resList = new ArrayList();
		try {
			resList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, sendlist);
			// 전송결과 처리
			for (DataMap res : resList) {
				String resultStr = res.getString("TYPE");
				DataMap param = new DataMap();
				param.putAll(res);
				param.put("IFID", ifid);
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				param.setModuleCommand("Erpif", "IFWMS999_FLG");
				
				if ("S".equals(resultStr)) {     // 성공 응답 시
					param.put("PRCFLG", "C");
					commonDao.update(param); // UPDATE IFWMS999
				} else {                         // 실패 응답 시
					errMsg = res.getString("MESSAGE");
					param.put("PRCFLG", "E");
					param.put("PRCETX", errMsg);
					commonDao.update(param); // UPDATE IFWMS999
				}
			}
			
			rd.put("result", "SUCCESS");
		} catch (Exception e) {
			errMsg = e.getMessage();
			if (errMsg != null && errMsg.length() > 200) {
				errMsg = errMsg.substring(0, 200);
				rd.put("result", errMsg.substring(0, 200));
			} else {
				rd.put("result", errMsg);
			}
		}
		
		//log.debug("\nSAP Response: " + resList);
		
		return errMsg;
	}

	@Transactional
	public String send_TK_CONTROL(DataMap map) throws SQLException{
		// MAP : list = TKNUM, VBELN, STATUS (C,D)
		// WMS_IF_333 선적문서 통제관리
		String errMsg = "SUCCESS";
		String ifid = "WMS_IF_333";
		String logseqno = "";
		
		try {
			// 로그시퀀스번호 채번
			DataMap logMap = new DataMap();
			logMap.setModuleCommand("Erpif", "IFWMSLOG");			
			logMap.put("IFID", ifid);					
			logMap.put("COMSTAT", "C"); //호출
			logMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			commonDao.insert(logMap);
			logseqno = logMap.get("SEQNO").toString();
			
			// 전송데이터 등록
			List<DataMap> list = map.getList("list");
			DataMap row = new DataMap();
			for(int i = 0 ; i < list.size() ; i ++){
				row = list.get(i).getMap("map");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.setModuleCommand("Erpif", "IFWMS333");
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				commonDao.insert(row);
			}
		} catch (Exception e) {
			errMsg = "[" + logseqno + "] " + e.getMessage();
			if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
			
			return errMsg;
		}

		// 전송데이터 검색
		List<DataMap> ifList = new ArrayList<DataMap>();
		DataMap row = new DataMap();
		row.setModuleCommand("Erpif", "IFWMS333");
		row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		row.put("IFID", ifid);
		row.put("LOGSEQNO", logseqno);
		ifList = commonDao.getList(row); 
		
		if(ifList == null || ifList.size() == 0){
			errMsg = "[" + logseqno + "] " + "전송할 데이터가 없습니다. "+ifid;
			return errMsg;
		}
		
		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		PostRequest postRequest = new PostRequest();
		JSONArray jarr = new JSONArray();
		JSONObject jobj = new JSONObject();
		JSONObject jsend = new JSONObject();

		DataMap smap = new DataMap();
		for(int i=0; i < ifList.size(); i++) {
			smap = ifList.get(i);
			
			jobj = new JSONObject();

			if (ifid.equals("WMS_IF_333")) {
				for(int icol=0; icol < mpcolList.size(); icol++) {
					if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
						if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
							String commaStr = mpcolList.get(icol).get("SOURCE").toString();
							String[] commaStrList = commaStr.split(",");
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(commaStrList[0]).toString() + smap.get(commaStrList[1]).toString());
						} else {
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(mpcolList.get(icol).get("SOURCE")));
						}
					}
				}
			}
			
			jarr.add(jobj);
		}

		jsend.put("list", jarr);

		// 데이터 전송
		// SAP : RFC
		DataMap rd = new DataMap();
		DataMap rfcinfo = new DataMap();
		DataMap rfcrst = new DataMap();
		rfcinfo.setModuleCommand("Erpif", "RFCINFO");
		rfcinfo.put("IFID", ifid);
		rfcrst = commonDao.getMap(rfcinfo); 
		
		String rfcfn = rfcrst.get("RFCFN").toString();		// FUNCTION
		String rfctbl = rfcrst.get("RFCTBL").toString();	// IF_RETBL
		String rfcp1 = rfcrst.get("RFCP1").toString();		// IF_RESTR
		String rfcp2 = rfcrst.get("RFCP2").toString();
		
		// SAP
		List<DataMap> sendlist = new ArrayList();
		RfcCallFunction sapConn = new RfcCallFunction();
		
		DataMap xx = new DataMap();
		xx.put("list", getMapFromJsonObject(jsend).get("list"));
		
		sendlist.add(xx);

		// param map
		DataMap pMap = new DataMap();
		pMap.put("I_IF_NAM", ifid);
		pMap.put("I_IF_KEY", logseqno);
		
		log.debug("\nRFC SEND6 ("+rfcfn+","+rfctbl+","+rfcp1+","+rfcp2+","+pMap+") --------------\n"+sendlist.toString());
		List<DataMap> resList = new ArrayList();
		try {
			resList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, sendlist);
			// 전송결과 처리
			for (DataMap res : resList) {
				String resultStr = res.getString("TYPE");
				DataMap param = new DataMap();
				param.putAll(res);
				param.put("IFID", ifid);
				param.put("LOGSEQNO", logseqno);
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				param.setModuleCommand("Erpif", "IFWMS333_FLG");
				
				if ("S".equals(resultStr)) {     // 성공 응답 시
					param.put("ITFFLG", "C");
					param.put("PRCFLG", "C");
					commonDao.update(param); // UPDATE IFWMS333
				} else {                         // 실패 응답 시
					errMsg = "[" + logseqno + "] " + res.getString("MESSAGE");
					param.put("ITFFLG", "E");
					param.put("PRCFLG", "E");
					param.put("PRCETX", errMsg);
					commonDao.update(param); // UPDATE IFWMS333
				}
			}
		} catch (Exception e) {
			errMsg = "[" + logseqno + "] " + e.getMessage();
			if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
		}
			
		//log.debug("\nSAP Response: " + resList);
			
		// 통신결과 처리
		DataMap logMap = new DataMap();
		logMap.setModuleCommand("Erpif", "IFWMSLOG");
		logMap.put("IFID", ifid);
		logMap.put("SEQNO", logseqno);
		if(errMsg.equals("SUCCESS")) {
			// 전송성공 S
			logMap.put("COMSTAT", "S");
		} else {
			// 전송에러 E - 에러시 호출로직에서 롤백 처리되기때문에 의미없음
			logMap.put("COMSTAT", "E");
			logMap.put("ERRTXT", errMsg);
		}
		commonDao.update(logMap);
		
		return errMsg;
	}
	
