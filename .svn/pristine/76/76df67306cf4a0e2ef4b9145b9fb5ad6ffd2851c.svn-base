				setFLG.put("PRCFLG", "I");
				commonDao.update(setFLG);
				
				// procedure 호출 (PRDPLN 처리), 프로시저내에서 작업완료후 플래그 완료처리
				DataMap procMap = new DataMap();
				procMap.setModuleCommand("Erpif", "IFWMS100");
				procMap.put("IFID", ifid);
				procMap.put("LOGSEQNO", logseqno);
