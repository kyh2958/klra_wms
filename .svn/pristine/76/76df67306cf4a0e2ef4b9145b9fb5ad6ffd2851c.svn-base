	@Transactional
	public DataMap controlIF(DataMap map) throws SQLException{
		List<DataMap> list = map.getList("list");
		String stat = map.getString("IFSTAT");

		DataMap rsMap = new DataMap();
		rsMap.put("SUCCESS", "OK");

		DataMap row = new DataMap();
		
		for(int i = 0 ; i < list.size() ; i ++){
			row = list.get(i).getMap("map");
			
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			row.setModuleCommand("Erpif", "IF");
			row.put("IFSTAT", stat);
			
			commonDao.update(row);
		}

		return rsMap;
	}
	
	@Transactional
	public DataMap saveIF(DataMap map) throws SQLException{
		List<DataMap> list = map.getMapList("list");

		DataMap rsMap = new DataMap();
		rsMap.put("SUCCESS", "OK");

		DataMap row = new DataMap();
		
		for(int i = 0 ; i < list.size() ; i ++){
			row = list.get(i).getMap("map");
			
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			row.setModuleCommand("Erpif", "IFSTAT");
			
			commonDao.update(row);
		}

		return rsMap;
	}

	@Transactional
	public DataMap receive_START(DataMap map) throws SQLException{
		RfcCallFunction sapConn = new RfcCallFunction();
		List<DataMap> returnList = new ArrayList<DataMap>();
		List<DataMap> returnList2 = new ArrayList<DataMap>();
		DataMap returnMap = new DataMap();
		
		String ifid   = map.get("IFID").toString();
		String rfcfn  = map.get("RFCFN").toString();
		String rfctbl = map.get("RFCTBL").toString();
		String rfctbl2 = "";
		String rfcp1  = map.get("RFCP1").toString();
		String rfcp2  = map.get("RFCP2").toString();
		String logseq = "";
//		String comtyp  = map.get("COMTYP").toString();
		String pWekrs  = map.get("WERKS").toString();
		String pVBELN  = map.get("VBELN").toString();
		String pPOSNR  = map.get("POSNR").toString();
		String pTKNUM  = map.get("TKNUM").toString();
		
		DataMap rsMap = new DataMap();
		DataMap rsMap2 = new DataMap();
		rsMap.put("IFID", ifid);
		rsMap.put("rfcfn", rfcfn);
		rsMap.put("rfctbl", rfctbl);
		rsMap.put("rfctbl2", rfctbl2);
		rsMap.put("rfcp1", rfcp1);
		rsMap.put("rfcp2", rfcp2);
		rsMap2.put("IFID", ifid);
		rsMap2.put("rfcfn", rfcfn);
		rsMap2.put("rfctbl", rfctbl);
		rsMap2.put("rfctbl2", rfctbl2);
		rsMap2.put("rfcp1", rfcp1);
		rsMap2.put("rfcp2", rfcp2);
		
		DataMap logMap = new DataMap();
		String logStep = "";

		if(ifid.equals("WMS_IF_209213")) {
			// ------------- 서비스 호출 -------------------
			// 품질검사결과 상태변경건 자동전송
			//log.debug("품질검사결과 상태변경건 자동전송");
			
			// 전송대상 데이터 검색 (IFWMS223 등록시 IFID가 'WMS_IF_209','WMS_IF_213' 인 대상만 검색)
			DataMap qSeqMap = new DataMap();
			List<DataMap> qSeqList = new ArrayList<DataMap>();
			qSeqMap.setModuleCommand("Erpif", "IFWMS223_AUTO");
			qSeqList = commonDao.getList(qSeqMap);
			
			DataMap qMap = new DataMap();
			DataMap errMap = new DataMap();
			String result = "";
			
			for(int i=0; i < qSeqList.size(); i++) {
				// 통신로그
				logStep = "통신로그 및 SEQNO 채번";
				logMap.setModuleCommand("Erpif", "IFWMSLOG");
				logMap.put("IFID", ifid);
				logMap.put("COMSTAT", "C"); //호출
				commonDao.insert(logMap);

				logseq = qSeqList.get(i).get("LOGSEQNO").toString();
				
				qMap.put("IFID", "WMS_IF_401");
				qMap.put("LOGSEQNO", logseq);

				// LOGSEQNO 단위 SEQNO ASC 순으로 데이터 전송
				result = send_IFWMS223(qMap);

				if(result.equals("SUCCESS")) {
					// 통신로그 수정
					logStep = "통신로그 수정";
					logMap.put("COMSTAT", "S");
					logMap.put("REMARK", "LOGSEQNO[" + logseq + "]건"); //
				} else {
					// 오류시 상태복원후 CHKRST=QR로 변경해서 GR14 품질검사결과관리 화면에서 처리되도록
					// CHKRSTG : 정상SAP처리결과, CHKRSTB : 보류(불량)SAP처리결과
					errMap.setModuleCommand("Erpif", "IFWMS109_CHKRST");
					errMap.put("IFID", ifid);
					errMap.put("CHKRST", "QR");
					errMap.put("IF_KEY", logseq);
					errMap.put("SADJKY", qSeqList.get(i).get("SADJKY").toString());
//					errMap.put("VGBEL", qSeqList.get(i).get("ZDOC_NO").toString());
//					errMap.put("VGPOS", qSeqList.get(i).get("ZDOC_ITEM").toString());
					commonDao.update(errMap);
					
					// 상태원복
					DataMap rbStatus = new DataMap();
					rbStatus.put("SES_USER_ID", ifid);
					
					List<DataMap> headList = new ArrayList<>();
					
					DataMap head = new DataMap();
					head.put("DOCCAT", "400");
					head.put("DOCUTY", "402");
					head.put("SADJKY", qSeqList.get(i).get("SADJKY").toString());
					head.put("WAREKY", qSeqList.get(i).get("WAREKY").toString());
					head.put("DOCDAT", qSeqList.get(i).get("DOCDAT").toString());
					
					headList.add(head);
					rbStatus.put("headList", headList);
					
					String rs = "";
					try {
						rs = inventoryService.cancelAdjustWMSONLY(rbStatus);
					} catch (Exception e) {
						rs = e.getMessage();
						if(rs != null && rs.length() > 200) { rs = rs.substring(0, 200); }
					}
					
					// 상태원복 오류시 방법없음
					logMap.put("COMSTAT", "E");
					logMap.put("ERRTXT", "LOGSEQNO[" + logseq + "]건 처리에러 : " + result + ", 재고상태원복결과 : " + rs); //
				}
				commonDao.update(logMap);
			}
		} else if (ifid.equals("WMS_IF_000")) {
			// ------------- 서비스 호출 -------------------
			//log.debug("송신오류건 재처리");
			
			// 전송대상 데이터 검색 (IFWMS2XX PRCFLG = 'E', 5 >= ITFCNT 인 대상만 검색)
			DataMap pMap = new DataMap();
			pMap.setModuleCommand("Erpif", "IFWMS000_AUTO");
			List<DataMap> qSeqList = commonDao.getList(pMap);
			
			String result = "";
			
			// LOGSEQNO단위 ASC 순으로 데이터 전송
			for (int i = 0; i < qSeqList.size(); i++) {
				DataMap qMap = qSeqList.get(i);
				// IFWMS2XX.ITFCNT += 1
				qMap.setModuleCommand("Erpif", "IFWMS000_COUNT");
				commonDao.update(qMap);
				
				// SAP 전송
				if(qMap.get("TBL").equals("IFWMS203")) {
					result = send_IFWMS203(qMap);
				} else if(qMap.get("TBL").equals("IFWMS209")) {
					result = send_IFWMS209(qMap);
				} else if(qMap.get("TBL").equals("IFWMS213")) {
					result = send_IFWMS213(qMap);
				} else if(qMap.get("TBL").equals("IFWMS223")) {
					result = send_IFWMS223(qMap);
				}
				//log.debug("WMS_IF_000 Result: " + result);
			}
		} else if(ifid.equals("WMS_IF_901") || ifid.equals("WMS_IF_902") || ifid.equals("WMS_IF_220") || ifid.equals("WMS_IF_903") || ifid.equals("WMS_IF_888")) {
			// ------------- 프로시저,서비스 호출 -------------------
			DataMap pMap = new DataMap();
			
			if (ifid.equals("WMS_IF_901")) {
				// WMS_IF_901 사용자정보
				pMap.setModuleCommand("Erpif", "WMS_IF_901");
				pMap.put("result", "");
				commonDao.getMap(pMap);

				logMap.setModuleCommand("Erpif", "IFWMSLOG");
				logMap.put("IFID", ifid);
				logMap.put("COMSTAT", "C"); //호출
				commonDao.insert(logMap);
			} else if (ifid.equals("WMS_IF_902")) {
				// WMS_IF_902 0 재고 삭제
				pMap.setModuleCommand("Erpif", "WMS_IF_902");
				pMap.put("result", "");
				commonDao.getMap(pMap);

				logMap.setModuleCommand("Erpif", "IFWMSLOG");
				logMap.put("IFID", ifid);
				logMap.put("COMSTAT", "C"); //호출
				commonDao.insert(logMap);
			} else if (ifid.equals("WMS_IF_903")) {
				// WMS_IF_903 MTO - 1일 1회 (08:00) → 1일 2회 수행 (07:05, 19:05)

				// 프로시저 호출
				pMap.setModuleCommand("Erpif", "WMS_IF_903");
				commonDao.getMap(pMap);
				
				String rstIFID = pMap.get("ifid").toString();
				String rstLOGSEQNO = pMap.get("logseqno").toString();

				// 실적 송신할 자료가 있으면 로그 생성 (logseqno 가 존재한다면)
				if(!rstLOGSEQNO.equals(" ")) {
					// 통신로그
					logStep = "통신로그";
					logMap.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
					logMap.put("IFID", ifid);
					logMap.put("COMSTAT", "C"); //호출
					logMap.put("SEQNO", rstLOGSEQNO); //호출
					commonDao.insert(logMap);
					
					DataMap sm = new DataMap();
					sm.put("IFID", rstIFID);
					sm.put("LOGSEQNO", rstLOGSEQNO);
					
					// 재고상태 변경 실적 SAP 전송
					String res = send_IFWMS223(sm);
					
					if(res.equals("SUCCESS")) {
						// 통신로그 수정
						logStep = "통신로그 수정";
						logMap.put("COMSTAT", "S");
						commonDao.update(logMap);
					} else {
						pMap.setModuleCommand("Erpif", "WMS_IF_903_CANCEL");
						commonDao.getMap(pMap);
						logMap.setModuleCommand("Erpif", "IFWMSLOG");
						logMap.put("COMSTAT", "E");
						logMap.put("ERRTXT", res);
						commonDao.update(logMap);
					}
				}
			} else if (ifid.equals("WMS_IF_220")) {
				// WMS_IF_220 입고처리(고지/펄프)

				// 통신로그 및 SEQNO 채번
				logStep = "통신로그 및 SEQNO 채번";
				logMap.setModuleCommand("Erpif", "IFWMSLOG");
				logMap.put("IFID", ifid);
				logMap.put("COMSTAT", "C"); //호출
				commonDao.insert(logMap);
				logseq = logMap.get("SEQNO").toString();
				
				// 프로시저 호출
				pMap.setModuleCommand("Erpif", "WMS_IF_220_316");
				pMap.put("P_INOUT_TYPE", "IN"); // 입고 IN, 출고 OUT
				pMap.put("P_LOGSEQNO", logseq);
				commonDao.getMap(pMap);

				if(pMap.get("result").equals("SUCCESS")) {
					// 통신로그 수정
					logStep = "통신로그 수정";
					logMap.put("COMSTAT", "R");
					commonDao.update(logMap);
				}
			} else if (ifid.equals("WMS_IF_888")) {
				// WMS_IF_888 재고 백업
				pMap.setModuleCommand("Erpif", "WMS_IF_888");
				pMap.put("result", "");
				commonDao.getMap(pMap);

				logMap.setModuleCommand("Erpif", "IFWMSLOG");
				logMap.put("IFID", ifid);
				logMap.put("COMSTAT", "C"); //호출
				commonDao.insert(logMap);
			}
		} else if (ifid.equals("WMS_IF_202")) {
			// ------------- 프로시저 호출 -------------------
			DataMap pMap = new DataMap();
			
			// WMS_IF_202 입고예정정보(자재,상품)-PORTAL

			// 통신로그 및 SEQNO 채번
			logStep = "통신로그 및 SEQNO 채번";
			logMap.setModuleCommand("Erpif", "IFWMSLOG");
			logMap.put("IFID", ifid);
			logMap.put("COMSTAT", "C"); //호출
			commonDao.insert(logMap);
			logseq = logMap.get("SEQNO").toString();
			
			// 프로시저 호출
			pMap.setModuleCommand("Erpif", "WMS_IF_202214");
			pMap.put("P_INOUT_TYPE", "IN"); // 입고 IN, 실적 OUT
			pMap.put("P_LOGSEQNO", logseq);
			commonDao.getMap(pMap);

			if(pMap.get("result").equals("SUCCESS")) {
				// 통신로그 수정
				logStep = "통신로그 수정";
				logMap.put("COMSTAT", "R");
				commonDao.update(logMap);
			}
		} else if(ifid.equals("WMS_IF_999")) {
			// 재고검증
			DataMap pMap = new DataMap();
			
			// 프로시저 호출
			pMap.setModuleCommand("Erpif", "IFWMS999");
			commonDao.getMap(pMap);
			
			String rstIFID = pMap.get("ifid").toString();
			String rstLOGSEQNO = pMap.get("logseqno").toString();

			if(!rstLOGSEQNO.equals(" ")) {
				// 통신로그
				logStep = "통신로그";
				logMap.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
				logMap.put("IFID", ifid);
				logMap.put("COMSTAT", "C"); //호출
				logMap.put("SEQNO", rstLOGSEQNO); //호출
				commonDao.insert(logMap);
				
				DataMap sm = new DataMap();
				sm.put("IFID", rstIFID);
				sm.put("LOGSEQNO", rstLOGSEQNO);
				
				//SAP 전송
				String res = send_IFWMS999(sm);
				
				if(res.equals("SUCCESS")) {
					// 통신로그 수정
					logStep = "통신로그 수정";
					logMap.put("COMSTAT", "S");
					commonDao.update(logMap);
				}
			}
		} else if (ifid.equals("ROH_IF_220")) {
			
			DataMap pMap = new DataMap();
			List<DataMap> tableList = new ArrayList();
			
			String i_bedat = LocalDate.now().minusDays(90).format(DateTimeFormatter.ofPattern("yyyyMMdd"));
			String i_endat = LocalDate.now().format(DateTimeFormatter.ofPattern("yyyyMMdd"));
			
			pMap.put("I_BEDAT", i_bedat);
			pMap.put("I_ENDAT", i_endat);
			pMap.put("I_GRSTA", "N");
			rfcp1 = "O_TABLE";
			
			//log.debug("[ROH_IF_220 통신시작] " + ifid + " : " + rfcfn + "," + rfctbl + "," + rfcp1 + "," + rfcp2 + "," + pMap + "," + tableList.toString());
			//returnList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, tableList);
			returnList = sapConn.SimpleImportTableRfc(rfcfn, rfctbl, rfcp1, pMap, tableList);
			
			rsMap.put("row_count", returnList.size());
			rsMap.put("data", returnList);
		} else if (ifid.equals("WMS_IF_AMANO20C") || ifid.equals("WMS_IF_AMANO20U")) {

		    returnList = new ArrayList<DataMap>();

		    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyyMMddHHmmss");

			 // 현재시간
			 LocalDateTime now = LocalDateTime.now();
	
			 // 조회 시작시간 (기본 갱신목적 24시간 전 모든차량 호출)
			 LocalDateTime before60Min = now.minusMinutes(60*24);
			 
			 // 신규입차 조회 (5분단위 호출, 12시간전 이력 조회)
			 if (ifid.equals("WMS_IF_AMANO20C")) {
				 before60Min = now.minusMinutes(60*12);
			 }
	
			 // 조회 종료시간 (오늘 23:59:59)
			 LocalDateTime endOfDay = LocalDate.now().atTime(23, 59, 59);
	
			 String startDtm = before60Min.format(formatter);
			 String endDtm   = endOfDay.format(formatter);

			 //startDtm = "20260701000000";
			 //endDtm = "20260710235959";
		    log.debug("AMANO API START :" + startDtm + " / " + endDtm);

		    try {
				returnList = getParkingList(startDtm, endDtm);
			} catch (Exception e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}

		    //----------------------------------------------------
		    // DB SAVE
		    //----------------------------------------------------

		    List<HashMap> mlist = new ArrayList<HashMap>();

		    HashMap row = new HashMap();

		    for(int i=0;i<returnList.size();i++){

		        row = returnList.get(i).getMap("map");

		        mlist.add(row);

		        if(((i+1)%100)==0){
		            commonDao.update("TB_CARINOUT_MERGE", mlist);

		            mlist.clear();
		        }
		    }

		    if(!mlist.isEmpty()){
		    	commonDao.update("TB_CARINOUT_MERGE", mlist);

		        mlist.clear();
		    }

		    rsMap.put("row_count", returnList.size());
		    rsMap.put("data", returnList);

		    log.debug("AMANO API RESULT COUNT : " + returnList.size());
		}else {
			try {
				// 통신로그 및 SEQNO 채번
				logStep = "통신로그 및 SEQNO 채번";
				logMap.setModuleCommand("Erpif", "IFWMSLOG");
				logMap.put("IFID", ifid);
				logMap.put("COMSTAT", "C"); //호출
				commonDao.insert(logMap);
				logseq = logMap.get("SEQNO").toString();
				
				// param map
				DataMap pMap = new DataMap();
				
				// table row
				DataMap tRow = new DataMap();
				List<DataMap> tableList = new ArrayList();

				// 공통
				pMap.put("I_IF_NAM", ifid);
				pMap.put("I_IF_KEY", logseq);

				if(ifid.equals("WMS_IF_781")) {
					// 자재가격평가
					pMap.put("I_GUBUN", rfcp2);
				} else if(ifid.equals("WMS_IF_101")) {
					// 품목,단위구성
					pMap.put("I_GUBUN", rfcp2);
					
					// WMS_IF_102 단위구성정보의 대상 테이블 검색
					DataMap itfma = new DataMap();
					DataMap itfmaRst = new DataMap();
					itfma.setModuleCommand("Erpif", "RFCINFO");
					itfma.put("IFID", "WMS_IF_102");
					itfmaRst = commonDao.getMap(itfma);
					rfctbl2 = itfmaRst.get("RFCTBL").toString();
				} else if(ifid.equals("WMS_IF_104")) {
					// 납품처
					pMap.put("I_GUBUN", rfcp2);
					pMap.put("I_PARVW", "WE");
				} else if(ifid.equals("WMS_IF_109")) {
					// 판매처
					pMap.put("I_GUBUN", rfcp2);
					pMap.put("I_PARVW", "AG");
				/*
				} else if(ifid.equals("WMS_IF_301") || ifid.equals("WMS_IF_302") || ifid.equals("WMS_IF_206")) { 
					pMap.put("I_GUBUN", "A");
					pMap.put("I_KOQUK", "A");
					if(ifid.equals("WMS_IF_301")) {
						// 출고예정-주문
						pMap.put("I_ZTYPE", "3");
					} else if(ifid.equals("WMS_IF_302")) { ////WMS_IF_302 코드를 새로 만듬..
						// 출고예정-이송
						pMap.put("I_ZTYPE", "2");
					} else if(ifid.equals("WMS_IF_206")) {
						// 반품입고
						pMap.put("I_ZTYPE", "1");
					}
				*/
				//출고예정-주문
				} else if(ifid.equals("WMS_IFC301") || ifid.equals("WMS_IFB301") || ifid.equals("WMS_IFS301") || ifid.equals("WMS_IFZ301")) {
					if(ifid.equals("WMS_IFC301")) {
						pMap.put("I_GUBUN", "C");
					} else if(ifid.equals("WMS_IFB301")) {
						pMap.put("I_GUBUN", "B");
					} else if(ifid.equals("WMS_IFS301")) {
						String st = map.get("GUBUN").toString();
						if(st.equals("T")) {
							pMap.put("I_GUBUN", "T");
							pMap.put("I_TKNUM", pTKNUM);
						}else {
							pMap.put("I_GUBUN", "S");
							// 자재문서 셋팅 I_VBELN
							pMap.put("I_VBELN", pVBELN);
						}
					}else if(ifid.equals("WMS_IFZ301")) {
						// 수출완료 변경수신건 (컨테이너ID, SEAL.NO)
						pMap.put("I_GUBUN", "Z");
					} 
					pMap.put("I_KOQUK", "A");
					pMap.put("I_ZTYPE", "3");
				//출고예정-이송
				} else if(ifid.equals("WMS_IFC302") || ifid.equals("WMS_IFB302") || ifid.equals("WMS_IFS302")) {
					if(ifid.equals("WMS_IFC302")) {
						pMap.put("I_GUBUN", "C");
					} else if(ifid.equals("WMS_IFB302")) {
						pMap.put("I_GUBUN", "B");
					} else if(ifid.equals("WMS_IFS302")) {
						String st = map.get("GUBUN").toString();
						if(st.equals("T")) {
							pMap.put("I_GUBUN", "T");
							pMap.put("I_TKNUM", pTKNUM);
						}else {
							pMap.put("I_GUBUN", "S");
							// 자재문서 셋팅 I_VBELN
							pMap.put("I_VBELN", pVBELN);
						}
						//pMap.put("I_TKNUM", pSTKNUM); //선적번호기준으로 호출 예정
					}
					pMap.put("I_KOQUK", "A"); //900으로 시작하는 POSNR은 안받는다..?
					pMap.put("I_ZTYPE", "2");
				// 반품입고
				} else if(ifid.equals("WMS_IFC206") || ifid.equals("WMS_IFB206") || ifid.equals("WMS_IFS206")) {
					if(ifid.equals("WMS_IFC206")) {
						pMap.put("I_GUBUN", "C");
					} else if(ifid.equals("WMS_IFB206")) {
						pMap.put("I_GUBUN", "B");
					} else if(ifid.equals("WMS_IFS206")) {
						pMap.put("I_GUBUN", "S");
						// 자재문서 셋팅 I_VBELN
						pMap.put("I_VBELN", pVBELN);
					}
					pMap.put("I_KOQUK", "A");
					pMap.put("I_ZTYPE", "1");		
					
				} else if(ifid.equals("WMS_IF_204")) {
					// 이송입고 예정정보
					pMap.put("I_GUBUN", "A");
				} else if(ifid.equals("WMS_IF_120") || ifid.equals("WMS_IF_201")) {
					// WMS_IF_120 ROLL LIST
					// WMS_IF_201 생산계획정보
					pMap.put("I_GUBUN", rfcp2);
				} else if(ifid.equals("WMS_IF_316")) {
					// WMS_IF_316 생산투입정보(고지/펄프)
					pMap.put("I_GUBUN", "A");
				} else if(ifid.equals("WMS_IF_318")) {
					// WMS_IF_318 반품출고예정정보(자재,상품)		
					pMap.put("I_GUBUN", "C");
				} else if(ifid.equals("WMS_IF_900")) {
					// WMS_IF_900 SAP재고수신		
//					pMap.put("I_WERKS", "P100");
				} else if (ifid.equals("WMS_IF_2041")) {
					// 임가공 입고 테스트기간 동안 현재일자 입력 조회하기
					String today = new SimpleDateFormat("yyyyMMdd").format(new Date());
					
					if ("WMS_IF_2041".equals(ifid)) {
						//pMap.put("I_AEDAT", today);
					}
				} else if (ifid.equals("WMS_IF_2162")) {
					// 미사용 컬럼 제거
					pMap.remove("I_IF_NAM");
					pMap.remove("I_IF_KEY");
					pMap.put("I_MODE", "N");

					tRow.put("VBELN", pVBELN);
					tRow.put("POSNR", pPOSNR);
					tableList.add(tRow);
				}
				
				// SAP RFC 호출 시작
				// param : function, table, STRUCTURE NAME, ifid, seq, null-수신 List<DataMap> list-결과송신
				logStep = "RFC CALL";
				if(ifid.equals("WMS_IF_101")) {
					log.debug("[통신시작] " + ifid + " : " + rfcfn + "," + rfctbl + "," + rfctbl2 + "," + rfcp1 + "," + rfcp2 + "," + pMap);
					returnMap = sapConn.RfcCallTableMulti(rfcfn, rfctbl, rfctbl2, rfcp1, pMap, null);
					returnList = returnMap.getList(rfctbl);
					returnList2 = returnMap.getList(rfctbl2);
				} else if(ifid.equals("WMS_IF_900")) {
//					String pWekrs = "P100";
					returnMap = sapConn.RfcCallTableSapStock(rfcfn, rfctbl, pMap, pWekrs);
					returnList = returnMap.getList(rfctbl);
				} else if(ifid.equals("WMS_IF_2162")) {
					log.debug("[통신시작] " + ifid + " : " + rfcfn + "," + rfctbl + "," + rfcp1 + "," + rfcp2 + "," + pMap + "," + tableList.toString());
					//returnList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, tableList);
					returnList = sapConn.SimpleImportTableRfc(rfcfn, rfctbl, rfcp1, pMap, tableList);
					
					System.out.println("returnList >>" + returnList.toString());
				}else {
					log.debug("[통신시작] " + ifid + " : " + rfcfn + "," + rfctbl + "," + rfcp1 + "," + rfcp2 + "," + pMap);
					returnList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, null);
				}
				
				if((returnList.size() > 0 || returnList2.size() > 0) && !returnList.get(0).get("ERRMSG").equals("")) {
					// 통신에러 로그처리
					String errMsg = returnList.get(0).get("ERRMSG").toString();
					if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
					
					logMap.put("COMSTAT", "E");
					logMap.put("ERRTXT", errMsg);
					commonDao.update(logMap);
					
					rsMap.put("ERRMSG", errMsg);
				} else {
					if(returnList.size() > 0 || returnList2.size() > 0) {
//						//log.debug("[수신데이터] returnList:"+returnList+", returnList2:"+returnList2);
						log.debug("[수신데이터] " + ifid + " returnList:"+returnList.size()+", returnList2:"+returnList2.size());
						logStep = "수신데이터 등록처리";
						if(ifid.equals("WMS_IF_101")) {
							if(returnList.size() > 0) {
								logStep = "수신데이터 등록처리-품목 정보";
								rsMap.put("data", returnList);
								rsMap.put("row_count", returnList.size());
								rsMap.put("IFID", ifid);
								rsMap.put("LOGSEQNO", logseq);
								// 품목 정보
								receive_IF(rsMap);
							}
							
							if(returnList2.size() > 0) {
								logStep = "수신데이터 등록처리-단위구성 정보";
								rsMap2.put("data", returnList2);
								rsMap2.put("row_count", returnList2.size());
								rsMap2.put("IFID", "WMS_IF_102"); // WMS_IF_101에서 수신되기때문에 102로 다시정의하여 IFTBL에 등록되도록 변경하여 처리
								rsMap2.put("LOGSEQNO", logseq);
								// 단위구성 정보
								receive_IF(rsMap2);
							}
						} else {
							rsMap.put("data", returnList);
							rsMap.put("row_count", returnList.size());
							rsMap.put("LOGSEQNO", logseq);
							// 수신데이터 등록처리
							receive_IF(rsMap);
						}
						
						// 통신로그 수정
	//					logStep = "통신로그 수정";
	//					logMap.put("COMSTAT", "R");
	//					commonDao.update(logMap);
					} else {
						//log.debug("[수신결과] " + ifid + " : 없음");
						rsMap.put("data", returnList);
						rsMap.put("row_count", returnList.size());
						// 수신데이터 없을경우 통신로그 패스 (호출방식으로 없는경우가 많음)
					}
				}
			} catch (Exception e) {
				//log.debug("[통신에러] " + ifid + " : " + e);
				String errMsg = e.getMessage();
				if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }

				// 통신에러 로그처리
				logMap.put("COMSTAT", "E");
				logMap.put("ERRTXT", errMsg);
				commonDao.update(logMap);
				
				rsMap.put("ERRMSG", errMsg);
			}
		}
		
		return rsMap;
	}

	@Transactional
	public String receiveRESTFUL(HttpServletRequest request, DataMap map) throws SQLException{
		String ifid = map.getString("IFID");
		String logseqno = map.getString("LOGSEQNO");
		String errMsg = "";
		String data = null;
		String x1;
		
		try {
			x1 = request.getReader().lines().collect(Collectors.toList()).toString();
//			JSONParser prs = new JSONParser();
//			JSONArray ja = (JSONArray) prs.parse(x1);
//			JSONObject jo = (JSONObject) ja.get(0);
			
			//////////////////////////////////////////////////////////////////////////////////////////////
			DataMap paramMap = new DataMap();
			List<DataMap> rsList = new ArrayList();
			// convert JSON string to Map 
			ObjectMapper mapper = new ObjectMapper();
			
			List<Map<String, String>> parseList = mapper.readValue(x1, List.class);
			List<Map<String, String>> parseDtList = new ArrayList();
			
			DataMap rsMap = new DataMap();
			
			for(Map p1Map : parseList ) {
				
				parseDtList = (List<Map<String, String>>) p1Map.get("list");
				rsList.clear();
				
				for(Map p2Map : parseDtList ) {
					rsMap = new DataMap();
					rsMap.putAll(p2Map);
					
					rsList.add(rsMap);
				}
			}
			
			paramMap.put("data", rsList);
			paramMap.put("IFID", ifid);
			paramMap.put("LOGSEQNO", logseqno);
			//////////////////////////////////////////////////////////////////////////////////////////////
			
			//log.debug("\n\n[RESTFUL 수신결과] "+ paramMap + "\n");
			
			// 파싱 테스트 start
//			Map<String, Object> xx = new ObjectMapper().readValue(jo.toJSONString(), Map.class) ;
//			//log.debug("\n\n[RESTFUL 수신결과] "+ifid+"\n\n"+xx+"\n\nhead : "+xx.get("head")+"\n\nlist : "+xx.get("list")+"\n\n");
//			List<Map<String, Object>> listhead = new ArrayList<Map<String, Object>>();
//			List<Map<String, Object>> listitem = new ArrayList<Map<String, Object>>();
//			if(xx.get("head") != null) {
//				listhead = (List<Map<String, Object>>) xx.get("head");
//				//log.debug("\nparsing head : "+listhead.get(0).get("H1"));
//			}
//			if(xx.get("list") != null) {
//				listitem = (List<Map<String, Object>>) xx.get("list");
//				//log.debug("\nparsing list : "+listitem.get(0).get("LOTA01"));
//			}
			// 파싱 테스트 end
			
//			jo.put("IFID", ifid);
//			jo.put("LOGSEQNO", logseqno);
			
			if (ifid.equals("WMS_IF_202") || ifid.equals("WMS_IF_205") || ifid.equals("WMS_IF_207")) {
				// WMS_IF_202 입고예정정보(자재,상품)-PORTAL
				// WMS_IF_205 입고예정정보(제품)
				// WMS_IF_207 반납입고예정정보
				data = receive_IFWMS103_RESTFUL(paramMap);
			} else if (ifid.equals("WMS_IF_208") || ifid.equals("WMS_IF_209")
					|| ifid.equals("WMS_IF_212") || ifid.equals("WMS_IF_213")) {
				// WMS_IF_208,212 자체 테스트용
				// WMS_IF_209,213 mes->wms 품질검사결과 수신
				if ( ifid.equals("WMS_IF_208")) { 
					ifid = "WMS_IF_209";
				} else if(ifid.equals("WMS_IF_212")) { 
					ifid = "WMS_IF_213";
				}
				data = receive_IFWMS109_RESTFUL(paramMap);
			} else if (ifid.equals("WMS_IF_223")) {
				// WMS_IF_223 순회품질검사결과
				data = receive_IFWMS108_RESTFUL(paramMap);
			} else if (ifid.equals("WMS_IF_303") || ifid.equals("WMS_IF_305")) {
				// WMS_IF_303 출고예정정보(자재,수입밀롤)
				// WMS_IF_305 생산투입불출정보
				data = receive_IFWMS113_RESTFUL(paramMap);
			}
		} catch (Exception e) {
			//log.debug(e);
			errMsg = e.getMessage();
			
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
			
			data = "FAIL : "+ifid+" 수신"+errMsg;
		}
		
		return data;
	}

	@Transactional
	public String receive_IF(DataMap map) throws SQLException{
		String ifid = map.getString("IFID");
		String data = null;

		if        (ifid.equals("WMS_IF_781")) { // 자재평가가격
			data = receive_IFWMS000(map);
		} else if (ifid.equals("WMS_IF_101")) { // 품목
			data = receive_IFWMS001(map);
		} else if (ifid.equals("WMS_IF_102")) { // 단위구성
			data = receive_IFWMS005(map);
		} else if (ifid.equals("WMS_IF_103") // 공급처
				|| ifid.equals("WMS_IF_104") // 납품처
				|| ifid.equals("WMS_IF_109") // 판매처
				  ) { 
			data = receive_IFWMS002(map);
		} else if (ifid.equals("WMS_IF_105")) { // 저장위치
			data = receive_IFWMS006(map);
		} else if (ifid.equals("WMS_IF_108")) { // 호기
			data = receive_IFWMS008(map);
		} else if (ifid.equals("WMS_IF_110")) { // 평량별 림 마스터
			data = receive_IFWMS009(map);
		} else if (ifid.equals("WMS_IF_120")) { // ROLL LIST
			data = receive_IFWMS010(map);
		} else if (ifid.equals("WMS_IF_201")) { // 생산계획
			data = receive_IFWMS100(map);
		} else if (ifid.equals("WMS_IF_204") // 입고예정정보(이송)
				
				|| ifid.equals("WMS_IF_2041") // 입고예정정보(임가공) 
				|| ifid.equals("WMS_IF_206") // 반품입고예정정보 
				|| ifid.equals("WMS_IFC206") // 반품입고예정정보 : 신규
				|| ifid.equals("WMS_IFB206") // 반품입고예정정보 : 변경
				|| ifid.equals("WMS_IFS206") // 반품입고예정정보 : 선택
				
				|| ifid.equals("WMS_IF_220") // 입고처리(고지/펄프)
				|| ifid.equals("WMS_IF_202") // EXCEL - 입고예정정보(자재,상품)-PORTAL
				|| ifid.equals("WMS_IF_205") // EXCEL - 입고예정정보(제품)
				|| ifid.equals("WMS_IF_207") // EXCEL - 반납입고예정정보
				  ) { 
			data = receive_IFWMS103(map);
		} else if (ifid.equals("WMS_IF_209") || ifid.equals("WMS_IF_213") ) { // EXCEL - 품질검사결과
			data = receive_IFWMS109_RESTFUL(map);
		} else if (ifid.equals("WMS_IF_223")) { // EXCEL - 순회품질검사결과
			data = receive_IFWMS108_RESTFUL(map);
		} else if (ifid.equals("WMS_IF_318") // 반품출고예정정보(자재,상품)
				|| ifid.equals("WMS_IF_316") // 생산투입정보(고지/펄프)
				|| ifid.equals("WMS_IF_303") // EXCEL - 출고예정정보(자재,수입밀롤)
				|| ifid.equals("WMS_IF_305") // EXCEL - 생산투입불출정보
				
				|| ifid.equals("WMS_IF_301") // 출고예정정보(주문)-판매,수출,무상
				|| ifid.equals("WMS_IFC301") // 출고예정정보(주문)-판매,수출,무상 : 신규
				|| ifid.equals("WMS_IFB301") // 출고예정정보(주문)-판매,수출,무상 : 변경
				|| ifid.equals("WMS_IFS301") // 출고예정정보(주문)-판매,수출,무상 : 선택
				|| ifid.equals("WMS_IFZ301") // 수출완료변경정보(주문)-수출	    : 변경(일 1회 수집)
				
				|| ifid.equals("WMS_IF_302") // 출고예정정보(이송)
				|| ifid.equals("WMS_IFC302") // 출고예정정보(이송)-판매,수출,무상 : 신규
				|| ifid.equals("WMS_IFB302") // 출고예정정보(이송)-판매,수출,무상 : 변경
				|| ifid.equals("WMS_IFS302") // 출고예정정보(이송)-판매,수출,무상 : 선택
				  ) { 
			data = receive_IFWMS113(map);
		} else if (ifid.equals("WMS_IF_900")) { // 재고 수신 (오픈전)
			data = receive_IFWMS900(map);
		} else {
			data = "[처리불가] receive_IF() 인터페이스ID : "+ifid;
		}
		
		return data;
	}

	@Transactional
	public String receive_IFWMS000(DataMap map) throws SQLException{
		// 자재평가가격
		List<DataMap> list = map.getList("data");
		String errMsg = "SUCCESS";
		
		// interface 등록 : 수신데이터 변형없이 원본 그대로 저장

		String ifid     = map.get("IFID").toString();
		String rfcfn    = map.get("rfcfn").toString();
		String rfctbl   = map.get("rfctbl").toString();
		String rfctbl2  = map.get("rfctbl2").toString();
		String rfcp1    = map.get("rfcp1").toString();
		String rfcp2    = map.get("rfcp2").toString();
		String logseqno = map.get("LOGSEQNO").toString();
		String isExcelUpload = map.get("REMARK").toString();
		
		// MULTI INSERT
		List<HashMap> mlist1 = new ArrayList<HashMap>();
		HashMap row = new HashMap();
		try {
			for(int i = 0 ; i < list.size() ; i ++){
				row = list.get(i).getMap("map");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				mlist1.add(row);
	
				if(((i+1) % 100) == 0) {
					commonDao.insert("IFWMS000_MULTI", mlist1);
					mlist1.clear();
				}
			}
			
			if(mlist1.size() > 0) {
				commonDao.insert("IFWMS000_MULTI", mlist1);
				mlist1.clear();
			}
		} catch (Exception e) {
			errMsg = e.getMessage();
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
		}
		// MULTI INSERT
		
		// 통신,인터페이스 FLAG 셋팅
		DataMap comFLG  = new DataMap();
		comFLG.setModuleCommand("Erpif", "IFWMSLOG");
		comFLG.put("IFID", map.get("IFID"));
		comFLG.put("SEQNO", logseqno);
		DataMap setFLG  = new DataMap();
		setFLG.setModuleCommand("Erpif", "IFWMS000_FLG");
		setFLG.put("IFID", map.get("IFID"));
		setFLG.put("LOGSEQNO", logseqno);

		if(!errMsg.equals("SUCCESS")){
			// 통신 에러처리
			comFLG.put("COMSTAT", "E");
			comFLG.put("ERRTXT", errMsg);
			commonDao.update(comFLG);
			// 인터페이스 에러처리
			setFLG.put("ITFFLG", "E");
			setFLG.put("ITFETX", errMsg);
			commonDao.update(setFLG);
		} else {
			// SAP의 RFC를 호출해서 수신받는 경우 IFTABLE까지 정상적으로 등록된후 그 결과를 전송하는 RFC를 다시 호출해줘야함
			// SAP에서는 본 호출을 통해 정상적으로 전송이 되었음을 인지하고 후속처리하도록 해야함
			// 여기까지 프로세스가 진행되었으면 IFTABLE에는 정상적으로 등록된 상태며
			// 이후 SAP에 수신완료 결과를 호출할때 SAP측에서 오류나더라도 패스함
			DataMap rtnRst = new DataMap();
//			if(!isExcelUpload.equals("EXCEL")) {
//				DataMap pMap = new DataMap();
//				
//				pMap.put("I_IF_NAM", ifid);
//				pMap.put("I_IF_KEY", logseqno);
//				pMap.put("I_GUBUN", "R");
//				
//				try {
//					List<DataMap> returnList = new ArrayList<DataMap>();
//					RfcCallFunction sapConn = new RfcCallFunction();
//					returnList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, null);
//					
//					JCoStructure returnStructure = (JCoStructure) returnList.get(0).get("E_RETURN");
//					
//					rtnRst.put("TYPE", returnStructure.getValue("TYPE"));
//					rtnRst.put("MESSAGE", returnStructure.getValue("MESSAGE"));
//				} catch (Exception e) {
//					rtnRst.put("TYPE", "E");
//					rtnRst.put("MESSAGE", "수신결과 R 호출 응답에러");
//				}
//			}
			
//			if(rtnRst.get("TYPE").equals("S") || isExcelUpload.equals("EXCEL")) {
			
				// 통신 완료처리
				comFLG.put("COMSTAT", "R");

				// R호출은 SAP에서 처리안하기때문에 성공으로 처리
				rtnRst.put("TYPE","S");
				
//			} else {
//				comFLG.put("COMSTAT", "E");
//				comFLG.put("ERRTXT", rtnRst.get("MESSAGE"));
//			}
			commonDao.update(comFLG);

			// 인터페이스 완료처리
			setFLG.put("ITFFLG", "C");
			setFLG.put("ITFETX", "");
			commonDao.update(setFLG);
			// -------------------- 여기까지는 통신완료 처리 --------------------
			
			// 수신결과 R 호출 응답에러가 나더라도 데이터는 정상적으로 수신된것으로 마스터의 경우 일단 진행함
			if(rtnRst.get("TYPE").equals("S") || rtnRst.get("TYPE").equals("E") || isExcelUpload.equals("EXCEL")) {
				// 프로시저 호출전 I 변경
				setFLG.put("PRCFLG", "I");
				commonDao.update(setFLG);
				
				// procedure 호출 (UNITMA 처리), 프로시저내에서 작업완료후 플래그 완료처리
				DataMap procMap = new DataMap();
				procMap.setModuleCommand("Erpif", "IFWMS000");
				procMap.put("IFID", ifid);
				procMap.put("LOGSEQNO", logseqno);
				procMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				procMap.put("result", "");
				commonDao.getMap(procMap);
//				//log.debug("------------------------------" + procMap.get("result"));
				if (!procMap.get("result").toString().equals("SUCCESS")) {
					errMsg = procMap.get("result").toString();
	
					// 인터페이스 프로시저 에러처리
					setFLG.put("PRCFLG", "E");
					setFLG.put("PRCETX", errMsg);
					commonDao.update(setFLG);
	
					// 통신완료후 발생한 에러처리
					comFLG.setModuleCommand("Erpif", "IFWMSLOG_INERR");
					comFLG.put("SEQNO", logseqno);
					comFLG.put("ERRTXT", errMsg);
					commonDao.update(comFLG);
				}
			}
		}
		
		return errMsg;
	}

	@Transactional
	public String receive_IFWMS001(DataMap map) throws SQLException{
		// 품목
		List<DataMap> list = map.getList("data");
		String errMsg = "SUCCESS";
		
		// interface 등록 : 수신데이터 변형없이 원본 그대로 저장

		String ifid     = map.get("IFID").toString();
		String rfcfn    = map.get("rfcfn").toString();
		String rfctbl   = map.get("rfctbl").toString();
		String rfctbl2  = map.get("rfctbl2").toString();
		String rfcp1    = map.get("rfcp1").toString();
//		String rfcp2    = map.get("rfcp2").toString();
		String logseqno = map.get("LOGSEQNO").toString();
		String isExcelUpload = map.get("REMARK").toString();
		
		// MULTI INSERT
		List<HashMap> mlist1 = new ArrayList<HashMap>();
		HashMap row = new HashMap();
		try {
			for(int i = 0 ; i < list.size() ; i ++){
				row = list.get(i).getMap("map");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				mlist1.add(row);
	
				if(((i+1) % 100) == 0) {
					commonDao.insert("IFWMS001_MULTI", mlist1);
					mlist1.clear();
				}
			}
			
			if(mlist1.size() > 0) {
				commonDao.insert("IFWMS001_MULTI", mlist1);
				mlist1.clear();
			}
		} catch (Exception e) {
			errMsg = e.getMessage();
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
		}
		// MULTI INSERT
		
		// 통신,인터페이스 FLAG 셋팅
		DataMap comFLG  = new DataMap();
		comFLG.setModuleCommand("Erpif", "IFWMSLOG");
		comFLG.put("IFID", map.get("IFID"));
		comFLG.put("SEQNO", logseqno);
		DataMap setFLG  = new DataMap();
		setFLG.setModuleCommand("Erpif", "IFWMS001_FLG");
		setFLG.put("IFID", map.get("IFID"));
		setFLG.put("LOGSEQNO", logseqno);
		
		if(!errMsg.equals("SUCCESS")){
			// 통신 에러처리
			comFLG.put("COMSTAT", "E");
			comFLG.put("ERRTXT", errMsg);
			commonDao.update(comFLG);
			// 인터페이스 에러처리
			setFLG.put("ITFFLG", "E");
			setFLG.put("ITFETX", errMsg);
			commonDao.update(setFLG);
		} else {
			// SAP의 RFC를 호출해서 수신받는 경우 IFTABLE까지 정상적으로 등록된후 그 결과를 전송하는 RFC를 다시 호출해줘야함
			// SAP에서는 본 호출을 통해 정상적으로 전송이 되었음을 인지하고 후속처리하도록 해야함
			// 여기까지 프로세스가 진행되었으면 IFTABLE에는 정상적으로 등록된 상태며
			// 이후 SAP에 수신완료 결과를 호출할때 SAP측에서 오류나더라도 패스함
			DataMap rtnRst = new DataMap();
			if(!isExcelUpload.equals("EXCEL")) {
				// 처리결과 정보 송신 : 단위구성에서는 제외
				DataMap pMap = new DataMap();
				
				pMap.put("I_IF_NAM", ifid);
				pMap.put("I_IF_KEY", logseqno);
				pMap.put("I_GUBUN", "R");
				
				try {
					List<DataMap> returnList = new ArrayList<DataMap>();
//					//log.debug("RFC RESULT SEND ("+rfcfn+","+rfctbl+","+rfctbl2+","+rfcp1+","+pMap+")");
					RfcCallFunction sapConn = new RfcCallFunction();
					returnList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, null);
//					//log.debug("RFC RESULT : "+returnList);
	
					rtnRst.put("TYPE", returnList.get(0).get("EV_CODE"));
					rtnRst.put("MESSAGE", returnList.get(0).get("EV_MSG"));
				} catch (Exception e) {
					rtnRst.put("TYPE", "E");
					rtnRst.put("MESSAGE", "수신결과 R 호출 응답에러");
				}
			}
			
			if(rtnRst.get("TYPE").equals("S") || isExcelUpload.equals("EXCEL")) {
				// 통신 완료처리
				comFLG.put("COMSTAT", "R");
			} else {
				comFLG.put("COMSTAT", "E");
				comFLG.put("ERRTXT", rtnRst.get("MESSAGE"));
			}
			commonDao.update(comFLG);

			// 인터페이스 완료처리
			setFLG.put("ITFFLG", "C");
			setFLG.put("ITFETX", "");
			commonDao.update(setFLG);
			// -------------------- 여기까지는 통신완료 처리 --------------------
			
			// 수신결과 R 호출 응답에러가 나더라도 데이터는 정상적으로 수신된것으로 마스터의 경우 일단 진행함
			if(rtnRst.get("TYPE").equals("S") || rtnRst.get("TYPE").equals("E") || isExcelUpload.equals("EXCEL")) {
				// 프로시저 호출전 I 변경
				setFLG.put("PRCFLG", "I");
				commonDao.update(setFLG);
				
				// procedure 호출 (SKUMA, SKUWC 처리), 프로시저내에서 작업완료후 플래그 완료처리
				DataMap procMap = new DataMap();
				procMap.setModuleCommand("Erpif", "IFWMS001");
				procMap.put("IFID", ifid);
				procMap.put("LOGSEQNO", logseqno);
				procMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				procMap.put("result", "");
				commonDao.getMap(procMap);
//				//log.debug("------------------------------" + procMap.get("result"));
				if (!procMap.get("result").toString().equals("SUCCESS")) {
					errMsg = procMap.get("result").toString();
	
					// 인터페이스 프로시저 에러처리
					setFLG.put("PRCFLG", "E");
					setFLG.put("PRCETX", errMsg);
					commonDao.update(setFLG);
	
					// 통신완료후 발생한 에러처리
					comFLG.setModuleCommand("Erpif", "IFWMSLOG_INERR");
					comFLG.put("SEQNO", logseqno);
					comFLG.put("ERRTXT", errMsg);
					commonDao.update(comFLG);
				}
			}
		}
		
		return errMsg;
	}
	
