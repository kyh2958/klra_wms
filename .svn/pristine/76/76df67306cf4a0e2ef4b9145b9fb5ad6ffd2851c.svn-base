	    //log.debug("result: " + result);
	    //log.debug("------------------------------------------------------------");

	    return result;
	}

	// OMS 출고요청 목록조회
	@Transactional
	public DataMap getWmsGIList(DataMap map) {
//call P_AIRWMS_PICKING_CANCEL( '3006613685', '000010'
		DataMap result = new DataMap();
	    String ifid = map.getString("IFID");
	    String type = map.getString("I_GUBUN");
	    //String svbeln = map.getString("SEBELN");
	    String stknum = map.getString("STKNUM");

	    DataMap param = new DataMap();
	    param.put("BWART", ifid);
	    param.put("I_GUBUN", type);
	    //param.put("SVBELN", svbeln);
	    param.put("STKNUM", stknum);
	    param.put("OWNRKY", "KN");
	    param.put("WAREKY", "6000");
	    param.put(CommonConfig.SES_USER_WHAREHOUSE_KEY, "6000");	// 상차에서 사용

	    //param.put("WERKS", "P100");
	    param.put(CommonConfig.SES_USER_ID_KEY, "OMSAPI");

	    List<DataMap> resultList = new ArrayList<>();

	    try {
	        /* ==============================
	           ① 출고 처리 (I_GUBUN = C)
	           ============================== */
	        if ("C".equals(type)) {

	            // 1) 출고 대상 조회
	            param.put("PROGID", "DL041");
	            param.put("STAT01", "V");
	            param.setModuleCommand("DL042", "DL042_HEAD");
	            resultList = commonDao.getList(param);

	            if (resultList == null || resultList.isEmpty()) {
	                throw new SQLException("① 출고 대상 데이터가 존재하지 않습니다.");
	            }
	            param.put("head", resultList);

	            // 2) 출고 할당
	            //DataMap assignResult = outboundService.AssignDL04_2(param);
	            DataMap assignResult = DL042outboundService.assignDL042_2(param);	//실제 할당 처리 로직
	            System.out.println("▶ [출고 할당 결과]");
	            System.out.println(assignResult);

	            if (assignResult == null) {
	                throw new SQLException("② 출고 할당 실패: 결과값이 NULL입니다.");
	            }
	            /*
	            String assignMsg = assignResult.getString("MSG");
	            if (!"1".equals(assignResult.getString("CNT")) &&
	                !"OK".equalsIgnoreCase(assignMsg)) {
	                throw new SQLException("② 출고 할당 실패: " + assignResult);
	            }
	            */

	            // 3) 피킹 대상 조회
	            param.put("PROGID", "DL061");
	            param.put("STAT01", "V");
	            param.setModuleCommand("WmsTask", "DL061HEAD");
	            List<DataMap> pickingHead = commonDao.getList(param);
	            if (pickingHead == null || pickingHead.isEmpty()) {
	                throw new SQLException("③ 피킹 대상 데이터가 존재하지 않습니다.");
	            }

	            param.put("head", pickingHead);
	            
	            String taskKey = pickingHead.get(0).getMap("map").getString("TASKKY");	// KYH_TODO 사용유무 확인필
	            param.put("TASKKY", taskKey);											// KYH_TODO 사용유무 확인필
	            param.setModuleCommand("WmsTask", "DL061DETAIL");
	            List<DataMap> pickingDetail = commonDao.getList(param);
	            if (pickingDetail == null || pickingDetail.isEmpty()) {
	                throw new SQLException("④ 피킹 상세 데이터가 존재하지 않습니다.");
	            }

	            param.put("list", pickingDetail);

	            // 4) 피킹 완료
	            System.out.println("4) 피킹 완료");
	            System.out.println(param.toString());
	            Object pickResult = taskService.DL061SaveEnd(param);
	            System.out.println("▶ [피킹 완료 결과]");
	            System.out.println(pickResult);

	            if (pickResult == null) {
	                throw new SQLException("⑤ 피킹 완료 실패: 결과값이 NULL입니다.");
	            }
	            if (pickResult instanceof DataMap) {
	                DataMap r = (DataMap) pickResult;
	                String msg = r.getString("MSG");
	                int cnt = getIntSafe(r, "CNT");
	                if (cnt <= 0) {
	                    throw new SQLException("⑤ 피킹 완료 실패: MSG=" + msg + ", CNT=" + cnt);
	                }
	            } else if (!pickResult.toString().toUpperCase().contains("OK")) {
	                throw new SQLException("⑤ 피킹 완료 실패: " + pickResult);
	            }

	            // 5) 상차 완료
	            Object loadResult = outboundService.saveDL211(param);
	            System.out.println("▶ [상차 완료 결과]");
	            System.out.println(loadResult);

	            if (loadResult == null) {
	                throw new SQLException("⑥ 상차 완료 실패: 결과값이 NULL입니다.");
	            }
	            if (loadResult instanceof DataMap) {
	                DataMap r = (DataMap) loadResult;
	                String msg = r.getString("MSG");
	                if (!"OK".equalsIgnoreCase(msg)) {
	                    throw new SQLException("⑥ 상차 완료 실패: MSG=" + msg);
	                }
	            } else if (!loadResult.toString().toUpperCase().contains("OK")) {
	                throw new SQLException("⑥ 상차 완료 실패: " + loadResult);
	            }

	            // 6) 출고 완료 + ERP 전송
	            param.put("PROGID", "DL082");
	            param.put("STAT04", "V");
	            //param.put("WAREKY", "1100");
	            param.setModuleCommand("WmsOutboundDL082", "DL081");
	            List<DataMap> outboundList = commonDao.getList(param);
	            if (outboundList == null || outboundList.isEmpty()) {
	                throw new SQLException("⑦ 출고 완료 데이터가 존재하지 않습니다.");
	            }

	            param.put("loopHeadList", outboundList);
	            System.out.println("▶ [출고 완료 ERP 전송 파라미터]");
	            System.out.println(param);

	            Object erpResult = outboundServiceDL082.sendEcmsDL081Bundle(param);
	            System.out.println("▶ [출고 완료 ERP 전송 결과]");
	            System.out.println(erpResult);

	            if (erpResult == null) {
	                throw new SQLException("⑧ ERP 전송 실패: 결과값이 NULL입니다.");
	            }
	            if (erpResult instanceof DataMap) {
	                DataMap r = (DataMap) erpResult;
	                int success = getIntSafe(r, "sucessCnt");
	                int error = getIntSafe(r, "errorCnt");
	                if (success <= 0 || error > 0) {
	                    throw new SQLException("⑧ ERP 전송 실패: sucessCnt=" + success + ", errorCnt=" + error);
	                }
	            } else if (!erpResult.toString().toUpperCase().contains("SUCESSCNT=1")) {
	                throw new SQLException("⑧ ERP 전송 실패: " + erpResult);
	            }

	            result.put("result", "SUCCESS");
		        result.put("MSG", "출고처리 요청이 완료 되었습니다.");
	        /* ==============================
	           ② 출고 취소 (I_GUBUN = D)
	           ============================== */
	        } else if ("D".equals(type)) {
	        	param.put("STATDO", "FRV");
	        	param.put("STAT06", "V");
	        	param.put("PROGID", "DL082"); // ✅ 변경: WmsInbound → WmsOutbound, PROGID 명확화
	        	param.setModuleCommand("WmsOutboundDL082", "DL081"); 
	        	System.out.println("param.toString()");
	        	System.out.println(param.toString());
	        	resultList = commonDao.getList(param);
	        	
	            if (resultList == null || resultList.isEmpty()) {
	                throw new SQLException("출고취소 대상 데이터가 존재하지 않습니다.");
	            }

	            param.put("headList", resultList);
	            Object erpResult = outboundServiceDL082.cancelDL081(param);
	            // erpResult = {MSG= , sucessCnt=1, errorCnt=0}
	            
	            System.out.println("▶ [출고 취소 ERP 전송 결과]");
	            System.out.println(erpResult.toString());
	            
	            if (erpResult == null) {
	                throw new SQLException("⑧ ERP 전송 실패: 결과값이 NULL입니다.");
	            }
	            if (erpResult instanceof DataMap) {
	                DataMap r = (DataMap) erpResult;
	                int success = getIntSafe(r, "sucessCnt");
	                int error = getIntSafe(r, "errorCnt");
	                if (success <= 0 || error > 0) {
	                    throw new SQLException("⑧ ERP 전송 실패: sucessCnt=" + success + ", errorCnt=" + error);
	                }
	            } else if (!erpResult.toString().toUpperCase().contains("SUCESSCNT=1")) {
	                throw new SQLException("⑧ ERP 전송 실패: " + erpResult);
	            }
	            
	            // 피킹취소 
	            param.put("PROGID", "DL061");
	            param.put("STAT03", "V");
	            param.setModuleCommand("WmsTask", "DL061HEAD");
	            List<DataMap> pickingHead = commonDao.getList(param);
	            if (pickingHead == null || pickingHead.isEmpty()) {
	                throw new SQLException("③ 피킹 대상 데이터가 존재하지 않습니다.");
	            }
	            
	            param.put("OLDLOC", "V");
	            param.put("head", pickingHead);
	            
	            String pickCancelResult = outboundService.PickingCancelDL061(param);
	            System.out.println("pickCancelResult.toString()");
	            System.out.println(pickCancelResult.toString());
	            
	            // 할당취소             
	            param.put("PROGID", "DL041");
	            param.put("STAT02", "V");
	            param.setModuleCommand("DL042", "DL042_HEAD");
	            resultList = commonDao.getList(param);

	            if (resultList == null || resultList.isEmpty()) {
	                throw new SQLException("① 할당취소 대상 데이터가 존재하지 않습니다.");
	            }
	            param.put("head", resultList);

	            // 2) 할당취소
	            DataMap alloCancelResult = DL042outboundService.unallocateDL042(param);
	            System.out.println("▶ [할당 취소 결과]");
	            System.out.println(alloCancelResult.toString());

	            result.put("result", "SUCCESS");
		        result.put("MSG", "출고취소 요청이 완료 되었습니다.");
	        } else {
	            throw new SQLException("유효하지 않은 I_GUBUN 값입니다: " + type);
	        }

	    } catch (Exception e) {
	    	// 예외 발생 시 JSON 응답용 형식 세팅
	        result.clear();
	        result.put("result", "FAIL");
	        result.put("MSG", e.getMessage());

	        // 로그 남기고 그대로 반환 (throw 하지 않음)
	        System.out.println("▶ [예외 발생 - JSON 응답]");
	        System.out.println(result.toString());
	    }

	    System.out.println("------------------------------------------------------------");
	    System.out.println("▶ [출고 처리 완료]");
	    System.out.println("결과 건수 : " + (resultList != null ? resultList.size() : 0));
	    System.out.println("------------------------------------------------------------");

	    return result;
	}

	/* ===========================================================
	   안전한 숫자 변환 유틸 (DataMap → int 변환)
	   =========================================================== */
	private int getIntSafe(DataMap map, String key) {
	    Object val = map.get(key);
	    if (val == null) return 0;
	    try {
	        return Integer.parseInt(val.toString().trim());
	    } catch (NumberFormatException e) {
	        return 0;
	    }
	}

	public List<DataMap> getParkingList(String startDtm, String endDtm) throws Exception {

		List<DataMap> list = new ArrayList<DataMap>();

	    HttpURLConnection conn = null;
	    BufferedReader reader = null;

	    try {

	        String targetUrl ="http://192.1.21.77:9948/interop/getSearchCarList.do";


	        URL url = new URL(targetUrl);

	        conn = (HttpURLConnection) url.openConnection();

	        conn.setRequestMethod("POST");

	        conn.setConnectTimeout(30000);
	        conn.setReadTimeout(30000);

	        conn.setDoInput(true);
	        conn.setDoOutput(true);

	        conn.setUseCaches(false);

	        conn.setRequestProperty("Content-Type", "application/json;charset=UTF-8");

	        //----------------------------------------------------
	        // Basic Auth
	        //----------------------------------------------------

	        String auth = "kleannara:kleannara123!";

	        String auth64 = Base64.getEncoder().encodeToString(auth.getBytes("UTF-8"));

	        conn.setRequestProperty("Authorization", "Basic " + auth64);

	        //----------------------------------------------------
	        // Request JSON
	        //----------------------------------------------------

	        JSONObject req = new JSONObject();

	        req.put("lotAreaNo",20);
	        req.put("startDtm",startDtm);
	        req.put("endDtm",endDtm);
	        req.put("searchType",0);
	        req.put("carNo","");

	        String requestBody = req.toString();

	        log.debug("REQUEST : {}" + requestBody);

	        OutputStream os = conn.getOutputStream();

	        os.write(requestBody.getBytes("UTF-8"));

	        os.flush();

	        os.close();

	        //----------------------------------------------------
	        // Response
	        //----------------------------------------------------

	        int status = conn.getResponseCode();

	        //log.debug("HTTP STATUS : {}" + status);

	        InputStream is;

	        if(status == HttpURLConnection.HTTP_OK){

	            is = conn.getInputStream();

	        }else{

	            is = conn.getErrorStream();

	        }

	        reader = new BufferedReader(new InputStreamReader(is,"UTF-8"));

	        StringBuilder sb = new StringBuilder();

	        String line;

	        while((line=reader.readLine())!=null){

	            sb.append(line);

	        }

	        String response = sb.toString();

	        //log.debug("RESPONSE : {}" + response);

	        //----------------------------------------------------
	        // JSON Parsing
	        //----------------------------------------------------

	        JSONParser parser = new JSONParser();
	        JSONObject result = (JSONObject) parser.parse(response);

	        JSONObject data = (JSONObject) result.get("data");

	        if (data == null) {

	            log.error("Response data 없음.");

	            return list;
	        }

	        // list 존재 여부
	        if (!data.containsKey("list")) {

	            log.error("Response data.list 없음.");

	            return list;
	        }

	        // list 가져오기
	        JSONArray arr = (JSONArray) data.get("list");

	        //log.debug("API ROW COUNT : {}", arr.length());

	        //----------------------------------------------------
	        // SAP RFC 구조 동일 생성
	        //----------------------------------------------------

	        for (int i = 0; i < arr.size(); i++) {

	            JSONObject obj = (JSONObject) arr.get(i);

	            DataMap map = new DataMap();

	            Iterator<?> it = obj.keySet().iterator();

	            while (it.hasNext()) {

	                String key = (String) it.next();

	                map.put(key, obj.get(key));
	            }

	            DataMap row = new DataMap();
	            row.put("map", map);

	            list.add(row);
	        }

	        //log.debug("RETURN COUNT : {}", list.size());

	    }
	    catch(Exception e){

	        log.error("AMANO API ERROR",e);

	        throw e;

	    }
	    finally{

	        try{

	            if(reader!=null){

	                reader.close();

	            }

	        }catch(Exception e){}

	        try{

	            if(conn!=null){

	                conn.disconnect();

	            }

	        }catch(Exception e){}

	    }

	    return list;

	}


}