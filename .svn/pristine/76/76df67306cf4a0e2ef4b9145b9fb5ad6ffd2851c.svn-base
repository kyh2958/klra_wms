				|| ifid.equals("WMS_IF_215") // 입고실적정보(수입자재,수입상품)
				|| ifid.equals("WMS_IF_216") // 입고실적정보(이송)
				|| ifid.equals("WMS_IF_222") // 입고실적정보(제품) MES
				|| ifid.equals("WMS_IF_221") // 입고실적정보(제품) SAP
				|| ifid.equals("WMS_IF_217") // 반품입고실적정보 SAP
				|| ifid.equals("WMS_IF_218") // 반납입고실적정보 MES
				|| ifid.equals("WMS_IF_224") // 반납입고실적정보(자재)
				|| ifid.equals("WMS_IF_219") // 재고조정입고
				  ) {
			// 입고실적 등록
			data = insert_IFWMS203(map);
		} else if (ifid.equals("WMS_IF_401") // 재고상태변경정보
				|| ifid.equals("WMS_IF_402") // MTO/MTS변경정보
				|| ifid.equals("WMS_IF_403") // 제조LOT변경정보
				|| ifid.equals("WMS_IF_404") // 저장위치변경정보
				|| ifid.equals("WMS_IF_405") // 품목코드 변경 (MTM)
				  ) {
			// 재고조정내역 등록
			data = insert_IFWMS223(map);
		} else if
		*/
		
		if (ifid.equals("WMS_IF_317") // 생산투입불출실적정보
				|| ifid.equals("WMS_IF_307") // 출고실적정보(주문)
				|| ifid.equals("WMS_IF_308") // 출고실적정보(이송)
				|| ifid.equals("WMS_IF_309") // 자재불출실적정보 mes
				|| ifid.equals("WMS_IF_320") // 자재불출실적정보 sap
				|| ifid.equals("WMS_IF_310") // 즉시불출실적정보 mes
				|| ifid.equals("WMS_IF_321") // 즉시불출실적정보 sap
				|| ifid.equals("WMS_IF_311") // 반품출고실적정보(자재,상품)
				|| ifid.equals("WMS_IF_313") // 폐기출고실적정보 TASDH
				|| ifid.equals("WMS_IF_314") // 재고조정출고 TASDH
				|| ifid.equals("WMS_IF_315") // 무상출고실적정보
				|| ifid.equals("WMS_IF_322") // 생산직불출실적정보 mes
				|| ifid.equals("WMS_IF_323") // 생산직불출실적정보 sap TASDH
				|| ifid.equals("WMS_IF_324") // 생산투입불출실적정보-MES
				|| ifid.equals("WMS_IF_780") // 팔레트출고실적-SAP
				) {
			if(recallYn != "" && recallYn != null) {
				// 출고 실적 등록
				data = insert_IFWMS213_DL082(map);
			}else {
				// 출고취소 실적 등록
				data = insert_IFWMS213_CANCEL_DL082(map);
			}
		}
		return data;
	}
	
	//231122 재처리 전용
	/*
	 * 1. 출고취소 중 출고완료 호출
	 * 2. 출고완료 화면 내 MES 재처리 시
	 * */
	@Transactional
	public String insert_IFWMS213_DL082(DataMap map) throws SQLException{
		// WMS_IF_317 생산투입불출실적정보
		// WMS_IF_307 출고실적정보(주문)
		// WMS_IF_308 출고실적정보(이송)
		// WMS_IF_309 자재불출실적정보 mes
		// WMS_IF_320 자재불출실적정보 sap
		// WMS_IF_310 즉시불출실적정보 mes
		// WMS_IF_321 즉시불출실적정보 sap
		// WMS_IF_311 반품출고실적정보(자재,상품)
		// WMS_IF_313 폐기출고실적정보
		// WMS_IF_314 재고조정출고
		// WMS_IF_315 무상출고실적정보
		// WMS_IF_780 팔레트출고실적
		List<DataMap> list = map.getList("list");
		String errMsg = "SUCCESS";
		
		String ifid = "";
		String iftbl = "";
		String recptty = ""; //문서유형
		String rfctype = "";//SAP MES 구분
		String cnlYn = "";
		
		// RECVKY문서번호 기준으로 SHPDI에서 SELECT INSERT 처리
		// 문서유형까지 조건포함 검토필요...
		DataMap row = new DataMap();
		for(int i = 0 ; i < list.size() ; i ++){
			row = list.get(i).getMap("map");
			
			ifid    = map.get("IFID").toString();
			recptty = map.get("RCPTTY").toString();
			rfctype = map.get("RFCTYPE").toString();
			cnlYn   = map.get("CNLYN").toString();
			
			row.put("IFID", ifid);
			row.put("LOGSEQNO", map.get("LOGSEQNO"));
			row.put("OWNRKY", map.get("ownrky"));
			row.put("UI", map.get("menuId"));
			row.put("WADAT", map.get("WADAT"));
			
			/*
			if (ifid.equals("WMS_IF_313") // 폐기출고실적정보
			 || ifid.equals("WMS_IF_314") // 재고조정출고
			 || ifid.equals("WMS_IF_324") // 생산투입불출실적정보-MES
			 || (ifid.equals("WMS_IF_310") && recptty.equals("354") && cnlYn.equals("V")) // 즉시불출-MES			 
			 || (ifid.equals("WMS_IF_320") && (recptty.equals("353") || recptty.equals("356"))) // 자재불출실적정보(생산투입불출 or 생산직불출)
			 || ifid.equals("WMS_IF_322") // 생산직불출실적정보
			   ) {
				iftbl = "IFWMS213_TAS";
			} else if (ifid.equals("WMS_IF_780")) {
				iftbl = "IFWMS213_PAL"; // 팔레트출고실적
			} else {
				
				if(rfctype.equals("SAP")) {
					iftbl = "IFWMS213_SAP_DUPL";
				}else{
					iftbl = "IFWMS213_MES_DUPL";
				}
			}
			*/
			
			if(rfctype.equals("SAP")) {
				iftbl = "IFWMS213_SAP_DUPL";
			}else{
				iftbl = "IFWMS213_MES_DUPL";
			}
						
			row.setModuleCommand("WmsOutboundDL082", iftbl);

			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			commonDao.insert(row);
		}
		
		// 처리결과
		if(!errMsg.equals("SUCCESS")){
			throw new RuntimeException("[ROLLBACK]\n" + errMsg);
		}
		
		return errMsg;
	}
	
	//231122 출고취소전용
	@Transactional
	public String insert_IFWMS213_CANCEL_DL082(DataMap map) throws SQLException{
		// WMS_IF_317 생산투입불출실적정보
		// WMS_IF_307 출고실적정보(주문)
		// WMS_IF_308 출고실적정보(이송)
		// WMS_IF_309 자재불출실적정보 mes
		// WMS_IF_320 자재불출실적정보 sap
		// WMS_IF_310 즉시불출실적정보 mes
		// WMS_IF_321 즉시불출실적정보 sap
		// WMS_IF_311 반품출고실적정보(자재,상품)
		// WMS_IF_313 폐기출고실적정보
		// WMS_IF_314 재고조정출고
		// WMS_IF_315 무상출고실적정보
		// WMS_IF_780 팔레트출고실적
		List<DataMap> list = map.getList("list");
		String errMsg = "SUCCESS";
		
		String ifid = "";
		String iftbl = "";
		String recptty = ""; //문서유형
		String rfctype = "";//SAP MES 구분
		String cnlYn = "";
		String recallYn = "";
		
		// RECVKY문서번호 기준으로 SHPDI에서 SELECT INSERT 처리
		// 문서유형까지 조건포함 검토필요...
		DataMap row = new DataMap();
		for(int i = 0 ; i < list.size() ; i ++){
			row = list.get(i).getMap("map");
			
			ifid    = map.get("IFID").toString();
			recptty = map.get("RCPTTY").toString();
			rfctype = map.get("RFCTYPE").toString();
			cnlYn   = map.get("CNLYN").toString();
			recallYn= map.get("RECYN").toString();
			
			row.put("IFID", ifid);
			row.put("LOGSEQNO", map.get("LOGSEQNO"));
			row.put("OWNRKY", map.get("ownrky"));
			row.put("UI", map.get("menuId"));
			
			if (ifid.equals("WMS_IF_313") // 폐기출고실적정보
			 || ifid.equals("WMS_IF_314") // 재고조정출고
			 || ifid.equals("WMS_IF_324") // 생산투입불출실적정보-MES
			 || (ifid.equals("WMS_IF_310") && recptty.equals("354") && cnlYn.equals("V")) // 즉시불출-MES			 
			 || (ifid.equals("WMS_IF_320") && (recptty.equals("353") || recptty.equals("356"))) // 자재불출실적정보(생산투입불출 or 생산직불출)
			 || ifid.equals("WMS_IF_322") // 생산직불출실적정보
			   ) {
				iftbl = "IFWMS213_TAS_BEF_CANCEL";
			} else if (ifid.equals("WMS_IF_780")) {
				iftbl = "IFWMS213_PAL"; // 팔레트출고실적
			} else {
				if(rfctype.equals("SAP")) {
						iftbl = "IFWMS213_SAP_BEF_CANCEL"; //WMS 프로시저 호출 전(취소전용) 
				}else{
						iftbl = "IFWMS213_MES_BEF_CANCEL";
				}
			}
			
			/* 해당 테이블은 출고완료 전용으로 SD07은 제외
			String menuId = map.get("menuId").toString();
			if(menuId.equals("SD07")) {
				DataMap listRow = map.getMap("row");
				DataMap rowMap =listRow.getMap("map");
				row.putAll(rowMap);
				iftbl = "IFWMS213_SD";
			}
			*/
			row.setModuleCommand("WmsOutboundDL082", iftbl);

			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			commonDao.insert(row);
		}
		
		// 처리결과
		if(!errMsg.equals("SUCCESS")){
			throw new RuntimeException("[ROLLBACK]\n" + errMsg);
		}
		
		return errMsg;
	}
	
	// OMS 입고요청(임가공) 목록조회
	@Transactional(rollbackFor = Exception.class)
	public DataMap getWmsGRTollPList(DataMap map) {

		DataMap result = new DataMap();
	    String ifid = map.getString("IFID");
	    String type = map.getString("I_GUBUN");
	    String sebeln = map.getString("EBELN");

	 // 파라미터 설정
	    DataMap param = new DataMap();
	    param.put("BWART", ifid);
	    param.put("I_GUBUN", type);
	    param.put("SEBELN", sebeln);
	    param.put("headSebeln", sebeln);
	    param.put("OWNRKY", "KN");
	    param.put(CommonConfig.SES_USER_ID_KEY, "OMSAPI");

	    List<DataMap> resultHeadList = null;
	    List<DataMap> resultItemList = null;
	    List<DataMap> grItemList =  new ArrayList<>();
	    List<DataMap> mergedList = null;
	    List<DataMap> tkList = null;
	    DataMap palletizingList = new DataMap();
	    DataMap rsMap = null;
	    Object dataMapObj = null;
	    
	    Set<String> addedEbelpSet = new HashSet<>();
	    Map<String, DataMap> mergedMap = new LinkedHashMap<>();

	    try {
	        // ① 입고 대상 / 헤더조회 (오더번호 조건)
	        if ("C".equals(type)) {
	        	param.put("WAREKY", "6000");
	            param.put("RCPTTY", "122");
	            param.put("PROGID", "GR02");
	            param.put("STTNEW", "V");
	            param.setModuleCommand("WmsInbound", "GR02");
	        } else {
	            throw new SQLException("유효하지 않은 TYPE 요청입니다: " + type);
	        }

	        // ② 데이터 조회 (헤더)
	        resultHeadList = commonDao.getList(param);
	        if (resultHeadList == null || resultHeadList.isEmpty()) {
	            throw new SQLException("요청 대상 데이터가 존재하지 않습니다.");
	        }
	        
	        param.put("head", resultHeadList);

	        // 데이터 조회 (아이템)
	        param.put("RCPTTY", "122");
            param.put("PROGID", "GR02");
            param.put("STTNEW", "V");
            param.setModuleCommand("WmsInbound", "GR02Sub");
            
            resultItemList = commonDao.getList(param);

            String ebelp = "";     // 현재 반복중인 오더순번
            String lota14Key = ""; // LOTA14_00010 같은 Key 이름
            String palqtyKey = ""; // PALQTY_00010 같은 Key 이름
            String lota15 = "";    // 완제품 배치번호 누적 저장용
	        
	        // 임가공 아이템의 경우 구성품기준 목록 결과 생성되어 완제품단위로 데이터 처리 
	        for (DataMap row : resultItemList) {
	        	
	        	// ★ 반드시 초기화해줘야 이전 EBELP 값이 남지 않는다
	            row.put("LOTA14_LIST", "");
	            row.put("PALQTY", "");
	            
	        	// 현재 row 의 EBELP 값을 가져옴P25C030263
	            if (!ebelp.equals(row.getString("EBELP"))) {
	                ebelp = row.getString("EBELP").trim();
	            }

	            // ------------------------------------------------------------
	            // ▶ 새 규칙에 따라 LOTA14_00010 형식으로 전달된 바코드 처리
	            // ------------------------------------------------------------
	            
	            palqtyKey = "PALQTY_" + ebelp;
	            Object palqtyObj = map.get(palqtyKey);   // String, List, null 모두 가능
	            
	            if (palqtyObj != null && !palqtyObj.toString().trim().isEmpty()) {
	            	row.put("PALQTY", palqtyObj.toString().trim());
	            }
	            
	            //lota14Key = "LOTA14_" + ebelp;
	            lota14Key = "LOTA14_LIST";
	            Object lota14Obj = map.get(lota14Key);   // String, List, null 모두 가능
	            String lota14Merged = "";  // 최종 문자열

	            if (lota14Obj != null) {

	            	// 1) List 로 들어온 경우 (예: [test0001, test0002])
	                if (lota14Obj instanceof java.util.List<?>) {
	                    java.util.List<?> list = (java.util.List<?>) lota14Obj;

	                    lota14Merged = list.stream()
	                            .filter(java.util.Objects::nonNull)
	                            .map(Object::toString)        // 요소를 무조건 String 으로 변환
	                            .collect(java.util.stream.Collectors.joining(","));  // "a,b,c"
	                }
	                // 2) 배열로 들어온 경우도 방어적으로 처리 (String[] 등)
	                else if (lota14Obj.getClass().isArray()) {
	                    Object[] arr = (Object[]) lota14Obj;

	                    lota14Merged = java.util.Arrays.stream(arr)
	                            .filter(java.util.Objects::nonNull)
	                            .map(Object::toString)
	                            .collect(java.util.stream.Collectors.joining(","));
	                }
	                // 3) 그 외에는 그냥 문자열로 사용 (Postman 처럼 단일 String)
	                else {
	                    lota14Merged = lota14Obj.toString();
	                }
	            }

	            // 값이 없으면 skip
	            if (lota14Merged != null && !lota14Merged.trim().isEmpty()) {

	                // 공백 제거해서 쉼표 split
	                String[] parts = lota14Merged.split(",");

	                // '' 감싸고 join
	                String inClause = Arrays.stream(parts)
	                        .map(String::trim)
	                        .filter(s -> !s.isEmpty())
	                        .map(s -> "'" + s + "'")
	                        .collect(Collectors.joining(","));

	                row.put("LOTA14_LIST", inClause);

	                //log.debug("LOTA14 매칭 결과 EBELP=" + ebelp + " / " + inClause);
	            }

	            // 조정출고 및 구성품 배치 채번
	            if (true) {	            	
	            	String wareky  = row.getString("WAREKY");	// 거점 6000
	                String flota01 = row.getString("FLOTA01");	// 구성품 저장위치
	                String c00102  = row.getString("C00102");	// 구성품 품목
	                String n00102  = row.getString("N00102");	// 구성품 수량
	                String lota14_list  = row.getString("LOTA14_LIST");	// 개별바코드 목록
	                //String c00103  = row.getString("C00103");	// 구성품 배치 조회해서 설정하기
	                String c00103  = "";	// 구성품 배치 조회해서 설정하기

	                // 구성품 출고 설정(헤더)
	                param.put("PROGID", "TK02");
	                param.put("DOCUTY", "399");	// 구성품출고 (임가공)
	                param.put("WAREKY", wareky);
	                param.setModuleCommand("WmsTask", "TK01");

	                tkList = commonDao.getList(param);
	                
	                if (!tkList.isEmpty()) {
	                    DataMap head = tkList.get(0);
	                    head.put("SAPIFYN", "X"); // 조정출고 SAP 인터페이스 여부를 'X'로 변경
	                    param.put("head", head);
	                } else {
	                	throw new SQLException("조정출고(미연동) WmsTask.TK01 결과가 존재하지 않습니다.");
	                }

	                // TK01Sub(아이템) 구성품 재고 조회
	                if (lota14_list != null && !lota14_list.trim().isEmpty()) {
	                    param.put("LOTA14_LIST", lota14_list);
	                }
	                
	                param.put("SKUKEY", c00102);
	                param.put("LOTA01", flota01);
	                param.setModuleCommand("WmsTask", "TK01Sub");	

	                tkList = commonDao.getList(param);
	                //log.debug("TK01Sub >>> " + tkList);

	                if (tkList == null || tkList.isEmpty()) {
	                    throw new SQLException(
	                        "구성품 출고 대상 재고(TK01Sub)가 존재하지 않습니다. " +
	                        "[SKUKEY=" + c00102 + ", LOTA01=" + flota01 + "]"
	                    );
	                }
	                
	                // ------------------------------------------------------------
	                // ■ 구성품 재고에서 필요한 수량만큼 출고 처리
	                // ------------------------------------------------------------
	                BigDecimal remainQty = new BigDecimal(n00102);
	                List<DataMap> loopList = new ArrayList<>();

	                // 재고 출고수량만큼 처리
	                for (DataMap tkRow : tkList) {
	                	if (remainQty.compareTo(BigDecimal.ZERO) <= 0) break;

	                	BigDecimal stockQty = BigDecimal.ZERO;
	                	
	                	Object useqtyObj = tkRow.get("USEQTY");
	                	
	                	if (useqtyObj instanceof Number) {
	                        stockQty = new BigDecimal(((Number) useqtyObj).toString());
	                    } else if (useqtyObj != null && !useqtyObj.toString().trim().isEmpty()) {
	                        stockQty = new BigDecimal(useqtyObj.toString().trim());
	                    }

	                	// 출고수량 = remainQty 와 stockQty 중 작은값
	                    BigDecimal outQtyBD = remainQty.min(stockQty);
	                    double outQty = outQtyBD.doubleValue(); // 기존 로직 호환용 double

	                    tkRow.put("QTTAOR", outQty);
	                    tkRow.put("SVBELN", sebeln);	// 구성품출고 바코드 추적을 위한 KEY 설정
	                    tkRow.put("SPOSNR", ebelp);
	                	
	                	// 구성품 조정출고대상
	                	loopList.add(tkRow);

	                	// 구성품 출고 재고정보
	                	String sku = tkRow.getString("SKUKEY");
	                	String lot = tkRow.getString("LOTA15");
	                	String lota01 = tkRow.getString("LOTA01");
	                	String lota02 = tkRow.getString("LOTA02");
	                	String uomkey = tkRow.getString("UOMKEY");
	                	String key = ebelp + "_" + sku + "_" + lot; // 그룹키

	                	// 완제품, WMS입고 배치번호
	                	if ("".equals(lota15)) {
	                		lota15 = lot;
	                	}
	 
	                	// 이미 같은 ebelp + SKUKEY + LOTA15 그룹이 있을 경우 → 수량 누적
	                	if (mergedMap.containsKey(key)) {
	                	    DataMap exist = mergedMap.get(key);

	                	    // 기존 C_MENGE 읽고 누적
	                	    double prevQty = Double.parseDouble(exist.getString("C_MENGE"));
	                	    exist.put("C_MENGE", prevQty + outQty);

	                	} else {

	                	    DataMap grouped = new DataMap();

	                	    for (Object keyObj : row.keySet()) {
	                	        String rowKey = keyObj.toString();
	                	        grouped.put(rowKey, row.get(rowKey));
	                	    }

	                	    grouped.put("C_MATNR", sku);
	                	    grouped.put("C_CHARG", lot);

	                	    // ★ 최초값 설정: 이번 outQty로 시작
	                	    grouped.put("C_MENGE", outQty);

	                	    grouped.put("C_WERKS", lota02);
	                	    grouped.put("C_LGORT", lota01);
	                	    grouped.put("C_MEINS", uomkey);

	                	    grouped.put("EBELN", row.getString("EBELN"));
	                	    grouped.put("EBELP", row.getString("EBELP"));
	                	    grouped.put("F_MENGE", row.getString("MENGE"));
	                	    grouped.put("F_LGORT", row.getString("LOTA01"));
	                	    grouped.put("F_CHARG", lota15);	// 입고된 배치로 완제품 배치 변경

	                	    mergedMap.put(key, grouped);
	                	}


	                	System.out.printf(
	                		"출고처리: STOKKY=%s / SKUKEY=%s / LOTA15=%s / USEQTY=%.3f / OUTQTY=%.3f%n",
	                		tkRow.getString("STOKKY"),
	                		sku,
	                		lot,
	                		stockQty,
	                		outQty
	                	);

	                	//System.out.println("tkRow.toString() >> ");
	                	System.out.println(tkRow.toString());

	                	// 구성품 배치정보 설정
	                	row.put("C00103", tkRow.get("LOTA15")); 
	                	remainQty = remainQty.subtract(outQtyBD);
	                }

	                // 최종 병합 리스트
	                mergedList = new ArrayList<>(mergedMap.values());

	                // ★ 최종 결과 확인
	                // 재고 수량이 부족한경우 예외처리 발생하기 KYH_TODO
	                // 조정 출고 처리 (미연동)
	                param.put("loopHeadList", loopList);
	                DataMap rsTkMap = taskService.saveTK(param);
	                ////log.debug("rsTkMap >> " + rsTkMap);
	            }
	            
	            // SAP/WMS 입고되는 완제품 배치번호 처음 
	            row.put("LOTA15", lota15);
        		//grItemList.add(row);
        		
        		// ★ EBELP 기준 WMS완제품 입고 중복 방지
        		if (!addedEbelpSet.contains(ebelp)) {
        		    grItemList.add(row);
        		    addedEbelpSet.add(ebelp);
        		}
	        }
	        
	        //log.debug("==== 최종 병합 결과 ====");
            for (DataMap m : mergedList) {
            	//log.debug(m);
            }

	        param.put("head", resultHeadList);
	        //log.debug("param resultHeadList>>> " + param);

	        
	        // ③ 입고처리
	        if ("C".equals(type)) {

	            // 파레트라이징 처리
	            String lota14 = resultItemList.get(0).getMap("map").getString("LOTA14");
	            if (lota14 == null || lota14.trim().isEmpty()) {
	            	//log.debug("6251 - 파레트라이징 처리 시작");
	                try {
	                	param.put("list", grItemList);
	                    //param.put("list", resultItemList);
	                    palletizingList = inboundService.getPalletizingJsonList(param);
	                } catch (Exception e) {
	                    throw new SQLException("파레트라이징 처리 실패: " + e.getMessage());
	                }
	            }

	            // 완제품 파레트라이징 결과 처리
	            if (palletizingList != null && palletizingList.get("list") != null) {
	            	//log.debug("6261 - 파레트라이징 결과 변환");
	                List<DataMap> convertedList = new ArrayList<>();

	                for (Object obj : (List<?>) palletizingList.get("list")) {
	                    if (obj instanceof DataMap) convertedList.add((DataMap) obj);
	                    else if (obj instanceof Map) convertedList.add(new DataMap((Map<String, Object>) obj));
	                }

	                param.put("list", convertedList);
	            } else {
	            	// 파레트 처리안되면 오류 리턴하기
	            }

	            // 입고처리
	            // param.put("head", new ArrayList<>(mergedMap.values()));
	            param.put("mergedList", mergedList);
	            //log.debug("param saveGr02New>>> " + param);
	            
	            // SAP I/F 발생되는 데이터 
	            rsMap = inboundService.saveGr02New(param);		// WMS/SAP 입고처리
	            //rsMap = inboundService.saveGr02New_X(param);	// WMS 자체입고처리

	            //log.debug("▶ [입고처리 결과]");
	            //log.debug(rsMap);

	            if (rsMap == null || !"S".equals(rsMap.get("ifRsCode"))) {
	                //throw new SQLException("입고처리 실패: " + (rsMap != null ? rsMap.toString() : "결과 NULL"));
	            	//result.put("result", "FAIL");
	                //result.put("MSG", "입고처리 실패: " + (rsMap != null ? rsMap.toString() : "결과 NULL"));
	                //return result;
	                
	                throw new RuntimeException("입고처리 실패: " + rsMap.toString());
	            }

	            // ④ 구성품 재고 출고처리 (헤더 반복문에서 생성된 재고로 출고처리 하기)
	            if (false) {
	            	
	            }
	            result.put("result", "SUCCESS");
	            result.put("MSG", "입고처리 요청이 완료되었습니다.");
	            result.put("IFID", ifid);
	        }

	    } catch (Exception e) {
	        System.err.println("▶ [입고 처리 중 오류 발생]");
	        e.printStackTrace();
	        //result.clear();
	        //result.put("result", "FAIL");
	        //result.put("MSG", e.getMessage());
	        //result.put("IFID", ifid);
	        
	        throw new RuntimeException(e.getMessage(), e);
	    }

	    // 로그 출력
	    //log.debug("▶ [입고 조회 결과]");
	    //log.debug(param);
	    //log.debug("결과 건수: " + (resultItemList != null ? resultItemList.size() : 0));
	    //log.debug("result: " + result);
	    //log.debug("------------------------------------------------------------");

	    return result;
	}

	// OMS 입고요청 목록조회
	@Transactional
	public DataMap getWmsGRList(DataMap map) throws SQLException {

	    DataMap result = new DataMap();
	    String ifid = map.getString("IFID");
	    String type = map.getString("I_GUBUN");
	    String sebeln = map.getString("SEBELN");
	    String docdat = map.getString("DOCDAT");	// 사용자 입력 전기일 (로직 적용필요)

	    // 파라미터 설정
	    DataMap param = new DataMap();
	    param.put("BWART", ifid);
	    param.put("I_GUBUN", type);
	    param.put("SEBELN", sebeln);
	    param.put("headSebeln", sebeln);
	    param.put("RCPTTY", "121");	// 이송, 판매 쿼리 달라져서 입고유형 세팅필요 (헤더조회 쿼리결과 넣을까?)
	    param.put("OWNRKY", "KN");
	    param.put("DOCDAT", docdat);
	    param.put(CommonConfig.SES_USER_ID_KEY, "OMSAPI");

	    List<DataMap> resultHeadList = null;
	    List<DataMap> resultItemList = null;

	    //List<DataMap> tkList = null;
	    DataMap palletizingList = new DataMap();
	    DataMap rsMap = null;
	    Object dataMapObj = null;
	    
	    Map<String, DataMap> mergedMap = new LinkedHashMap<>();

	    try {
	        // ① 입고 대상 / 헤더조회 (오더번호 조건)
	    	param.put("WAREKY", "6000");
	        if ("C".equals(type)) {
	            //param.put("RCPTTY", "121");
	            param.put("PROGID", "GR02");
	            param.put("STTNEW", "V");
	            param.setModuleCommand("WmsInbound", "GR02");
	        } else if ("D".equals(type)) {
	        	param.put("PROGID", "GR09");
	        	param.put("STATDO", "FRV");
	        	param.setModuleCommand("WmsInbound", "GR09");
	        } else {
	            throw new SQLException("유효하지 않은 TYPE 요청입니다: " + type);
	        }

	        // ② 데이터 조회 (헤더)
	        resultHeadList = commonDao.getList(param);
	        if (resultHeadList == null || resultHeadList.isEmpty()) {
	            throw new SQLException("요청 대상 데이터가 존재하지 않습니다.");
	        }
	        
	        param.put("head", resultHeadList);
	        
	        // ③ 입고처리
	        if ("C".equals(type)) {

		        // 데이터 조회 (아이템)
	            param.put("PROGID", "GR02");
	            param.put("STTNEW", "V");
	            param.setModuleCommand("WmsInbound", "GR02Sub");
	            
	            resultItemList = commonDao.getList(param);

		        param.put("list", resultItemList);
		        //log.debug("param resultHeadList>>> " + param);

	        	// LOTA14_EMPTY_YN
	            // 파레트라이징 처리
	            String lota14 = resultItemList.get(0).getMap("map").getString("LOTA14");
	            //String lota14_empty_yn = resultHeadList.get(0).getMap("map").getString("LOTA14_EMPTY_YN");
	            /*
	            if ("N".equals(lota14_empty_yn) && lota14 == null || lota14.trim().isEmpty()) {
	            	//log.debug("6251 - 파레트라이징 처리 시작");
	                try {
	                    //param.put("list", resultItemList);
	                    palletizingList = inboundService.getPalletizingJsonList(param);
	                } catch (Exception e) {
	                    throw new SQLException("파레트라이징 처리 실패: " + e.getMessage());
	                }
	            }
	            */

	            // 완제품 파레트라이징 결과 처리
	            if (palletizingList != null  && palletizingList.containsKey("list") && palletizingList.get("list") != null) {
	            	//log.debug("6261 - 파레트라이징 결과 변환");
