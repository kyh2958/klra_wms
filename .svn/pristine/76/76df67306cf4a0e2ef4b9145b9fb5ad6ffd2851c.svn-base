	// 240201 HNW I/F 이력 유지를 위한 로직 수정
	@Transactional
	public String insert_IFWMS203(DataMap map) throws SQLException{
		// WMS_IF_214 입고실적정보(자재,상품)			-PORTAL
		// WMS_IF_215 입고실적정보(수입자재,수입상품) 	-SAP
		// WMS_IF_216 입고실적정보(이송)				-SAP
		// WMS_IF_222 입고실적정보(제품)				-MES
		// WMS_IF_221 입고실적정보(제품)				-SAP
		// WMS_IF_217 반품입고실적정보					-SAP
		// WMS_IF_218 반납입고실적정보					-MES
		// WMS_IF_224 반납입고실적정보(자재)			-SAP
		// WMS_IF_219 재고조정입고						-SAP
		List<DataMap> list = map.getList("list");
		String errMsg = "SUCCESS";
		String errCode = "S";
		
		// RECVKY문서번호 기준으로 RECDI에서 품질검사대상만 SELECT INSERT 처리
		DataMap row = new DataMap();
		DataMap ifMap = new DataMap();		// 240201 신규 추가
		
		if (map.get("IFID").equals("WMS_IF_2161")) {
			//list = map.getList("mergedList");
		}
		
		for(int i = 0 ; i < list.size() ; i ++){
			row = list.get(i).getMap("map");
			row.put("IFID", map.get("IFID"));
			row.put("LOGSEQNO", map.get("LOGSEQNO"));
			row.put("OWNRKY", map.get("ownrky"));
			
			if(map.get("IFID").equals("WMS_IF_215")||map.get("IFID").equals("WMS_IF_216")||map.get("IFID").equals("WMS_IF_2161")
			 ||map.get("IFID").equals("WMS_IF_221")||map.get("IFID").equals("WMS_IF_217")
			 ||map.get("IFID").equals("WMS_IF_224")||map.get("IFID").equals("WMS_IF_219")) 
			{
				row.setModuleCommand("Erpif", "IFWMS203SAP_IF");
				row.put("P_TYPE", "IFWMS203SAP");
			} else {
				row.setModuleCommand("Erpif", "IFWMS203_IF");
				row.put("P_TYPE", "IFWMS203");
			}
			
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
 			String menuId = map.get("menuId").toString();
			if(menuId.equals("SD07")) {
				DataMap listRow = map.getMap("row");
				DataMap rowMap =listRow.getMap("map");
				row.putAll(rowMap);
				row.setModuleCommand("Erpif", "IFWMS203_SD_IF");
				row.put("P_TYPE", "IFWMS203_SD");
			}
			
			// 240201 HNW insert 대신 select로 변경			
			//log.debug("IFService.insert_IFWMS203 입고 인터페이스 데이터 생성 시작 - LOGSEQNO : " + map.get("LOGSEQNO"));
			
			// 240201 HNW IFWMS203 생성 대상 조회
			List<DataMap> if203List = new ArrayList<DataMap>();
			if203List = commonDao.getList(row);
			
			// 240201 HNW IFWMS203 이력 별도 저장처리
			// 프로시저 호출 시점에는 데이터가 반영되지 않은 상태이므로, 현재 트랜잭션에서 조회한 데이터를 전송하는 방식으로 변경
			if(if203List == null || if203List.size() == 0){
				errMsg = "전송할 데이터가 없습니다. "+row.getString("IFID");
				return errMsg;
			}
			
			//log.debug("IFService.insert_IFWMS203 입고 인터페이스 데이터 저장 쿼리 호출 시작");
			DataMap sRow = new DataMap();
			for(int j=0; j < if203List.size(); j++) {
				sRow = if203List.get(j);
				
				//240201 JSON으로 변경
				DataWmsMap wmsMap = util.convertAll(sRow);
				String jsonStr = "";
				try {
					jsonStr = util.mapToJson(wmsMap);
				} catch (JsonProcessingException e) {
					//log.debug("IFService.insert_IFWMS203 인터페이스 데이터 JSON 변환 실패" + wmsMap + "  / msg = " + e.getMessage());
					//e.printStackTrace();
					throw new SQLException(e.getMessage());
				}
				
				DataWmsMap if203Map = new DataWmsMap();
				if203Map.setModuleCommand("Erpif", "IFWMS203_IF");
				if203Map.put("P_TYPE", row.getString("P_TYPE"));
				if203Map.put("P_JSON_STR", jsonStr);
				if203Map.put("P_ERR_CODE", "");
				if203Map.put("P_ERR_MSG", "");
								
				commonDao.insert(if203Map);
								
				errCode = if203Map.getString("P_ERR_CODE"); 
				errMsg = if203Map.getString("P_ERR_MSG");
			}
			
			//log.debug("IFService.insert_IFWMS203 입고 인터페이스 데이터 저장 쿼리 호출 종료");
		}
		
		// 처리결과
		if(!errMsg.equals("SUCCESS")){
			errCode = "E";
			throw new RuntimeException("[ROLLBACK]\n" + errMsg);
		}
		
		return errMsg;
	}
	
	@Transactional
	public String send_IFWMS203(DataMap map) throws SQLException{
		// WMS_IF_214 입고실적정보(자재,상품)			- PORTAL
		// WMS_IF_215 입고실적정보(수입자재,수입상품)	- SAP : head item 방식으로 본 로직 미사용
		// WMS_IF_216 입고실적정보(이송)				- SAP
		// WMS_IF_2161 입고실적정보(임가공)				- SAP
		// WMS_IF_222 입고실적정보(제품)				- MES
		// WMS_IF_221 입고실적정보(제품)				- SAP
		// WMS_IF_217 반품입고실적정보					- SAP
		// WMS_IF_218 반납입고실적정보					- MES
		// WMS_IF_224 반납입고실적정보(자재)			- SAP
		// WMS_IF_219 재고조정입고						- SAP
		String errMsg = "SUCCESS";
		String ifid = map.getString("IFID");
		String logseqno = map.getString("LOGSEQNO");
		String today = new SimpleDateFormat("yyyyMMdd").format(new Date());
		
		// SAP에 부분실적으로 송신해도 되는지 확인필요, 안된다면 UI 및 PDA에서 입고처리시 입고완료후 입고마감(실적전송) 단계가 추가되어야함. 
		List<DataMap> if203List = new ArrayList<DataMap>();
		DataMap row = new DataMap();
		
		System.out.println("send_IFWMS203");
		System.out.println(map.toString());
		row.setModuleCommand("Erpif", "IFWMS203");
		row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));

		row.put("IFID", ifid);
		row.put("LOGSEQNO", logseqno);
		if203List = commonDao.getList(row); 
		
		if(if203List == null || if203List.size() == 0){
			errMsg="전송할 데이터가 없습니다. "+ifid;
			return errMsg;
		}

		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		PostRequest postRequest = new PostRequest();
		JSONArray jarr = new JSONArray();
		JSONObject jobj = new JSONObject();
		JSONObject jsend = new JSONObject();

		DataMap smap = new DataMap();
		String wmsdn = "";
		
		for(int i=0; i < if203List.size(); i++) {
			smap = if203List.get(i);
			wmsdn = smap.get("ZDOC_NO").toString();
			
			jobj = new JSONObject();
			
			if(ifid.equals("WMS_IF_214") || ifid.equals("WMS_IF_215") || ifid.equals("WMS_IF_216") || ifid.equals("WMS_IF_2161") || ifid.equals("WMS_IF_222") || ifid.equals("WMS_IF_221")
			|| ifid.equals("WMS_IF_217") || ifid.equals("WMS_IF_218") || ifid.equals("WMS_IF_224") || ifid.equals("WMS_IF_219")) {
				// WMS_IF_214 입고실적정보(자재,상품)			- PORTAL
				// WMS_IF_215 입고실적정보(수입자재,수입상품)	- SAP : head item 방식으로 본 로직 미사용
				// WMS_IF_216 입고실적정보(이송)				- SAP
				// WMS_IF_2161 입고실적정보(임가공)				- SAP
				// WMS_IF_222 입고실적정보(제품)				- MES
				// WMS_IF_221 입고실적정보(제품)				- SAP
				// WMS_IF_217 반품입고실적정보					- SAP
				// WMS_IF_218 반납입고실적정보					- MES
				// WMS_IF_224 반납입고실적정보(자재)			- SAP
				// WMS_IF_219 재고조정입고						- SAP
				for(int icol=0; icol < mpcolList.size(); icol++) {
					if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
						if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
							String commaStr = mpcolList.get(icol).get("SOURCE").toString();
							String[] commaStrList = commaStr.split(",");
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(commaStrList[0]).toString() + smap.get(commaStrList[1]).toString());
						} else {
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(mpcolList.get(icol).get("SOURCE")));
						}
					}
				}
			} else {
				jobj.put("EBELN", smap.get("EBELN"));
				jobj.put("EBELP", smap.get("EBELP"));
				jobj.put("LIFNR", smap.get("LIFNR"));
				jobj.put("BWART", smap.get("BWART"));
				jobj.put("MATNR", smap.get("MATNR"));
				jobj.put("MENGE", smap.get("MENGE"));
				jobj.put("MEINS", smap.get("MEINS"));
				jobj.put("WERKS", smap.get("WERKS"));
				jobj.put("EINDT", smap.get("EINDT"));
				jobj.put("VGBEL", smap.get("VGBEL"));
				jobj.put("VGPOS", smap.get("VGPOS"));
				jobj.put("WAREKY", smap.get("WAREKY"));
				jobj.put("SKUKEY", smap.get("SKUKEY"));
				jobj.put("ORDCAT", smap.get("ORDCAT"));
				jobj.put("LOTA01", smap.get("LOTA01"));
				jobj.put("LOTA02", smap.get("LOTA02"));
				jobj.put("LOTA03", smap.get("LOTA03"));
				jobj.put("LOTA04", smap.get("LOTA04"));
				jobj.put("LOTA05", smap.get("LOTA05"));
				jobj.put("LOTA06", smap.get("LOTA06"));
				jobj.put("LOTA07", smap.get("LOTA07"));
				jobj.put("LOTA08", smap.get("LOTA08"));
				jobj.put("LOTA09", smap.get("LOTA09"));
				jobj.put("LOTA10", smap.get("LOTA10"));
				jobj.put("LOTA11", smap.get("LOTA11"));
				jobj.put("LOTA12", smap.get("LOTA12"));
				jobj.put("LOTA13", smap.get("LOTA13"));
				jobj.put("LOTA14", smap.get("LOTA14"));
				jobj.put("LOTA15", smap.get("LOTA15"));
				jobj.put("LOTA16", smap.get("LOTA16"));
				jobj.put("LOTA17", smap.get("LOTA17"));
				jobj.put("LOTA18", smap.get("LOTA18"));
				jobj.put("LOTA19", smap.get("LOTA19"));
				jobj.put("LOTA20", smap.get("LOTA20"));
			}

			
			// 임가공 SAP I/F시 맵핑컬럼 강제할당 처리 
			// IFWMS203 테이블 INSERT 결과 SELECT후 처리되도록 수정 필요 KYH_TODO
			if ("WMS_IF_2161".equals(map.get("IFID"))) {
				
				if (i > 0) {
					continue;
				}
				
				// 필요한 키 목록 정의
				List<String> requiredKeys = Arrays.asList(
				    "EBELN", "C_MATNR", "C_MEINS", "C_MENGE", "C_LGORT",
				    "F_MENGE", "EBELP", "C_WERKS", "WMSDN",
				    "F_CHARG", "C_CHARG", "F_LGORT"
				);
				
				// 1) mergedList 가져오기
				List<DataMap> mergedList = map.getList("mergedList");

				// 2) 중복 제거를 위한 Set
				Set<String> dedupSet = new HashSet<>();

				for (DataMap item : mergedList) {

				    // ✔ 중복 Key 생성 규칙(정확한 구성품 식별 기준!)
				    String dedupKey =
				        item.getString("EBELN") + "_" +
				        item.getString("EBELP") + "_" +
				        item.getString("C_MATNR") + "_" +
				        item.getString("C_CHARG");

				    if (dedupSet.contains(dedupKey)) {
				        continue; // 중복이면 skip
				    }
				    dedupSet.add(dedupKey);

				    // ✔ 필요한 key만 담기
				    DataMap filtered = new DataMap();
				    for (String key : requiredKeys) {

				        // 존재하는 key만 처리
				        if (!item.containsKey(key)) continue;

				        Object val = item.get(key);

				        // ▣ C_MENGE / F_MENGE 소수 2자리 반올림 (round2 메소드 없이 직접 구현)
				        if ("C_MENGE".equals(key) || "F_MENGE".equals(key)) {

				            if (val == null || val.toString().trim().isEmpty()) {
				                // 값이 없으면 0.00 처리
				                val = "0.00";
				            } else {
				                // BigDecimal 로 변환 → 소수점 2자리 → HALF_UP 반올림
				                BigDecimal bd = new BigDecimal(val.toString());
				                bd = bd.setScale(2, RoundingMode.HALF_UP);
				                val = bd.toString();
				            }
				        }

				        filtered.put(key, val);
				    }

				    // ✔ WMSDN 추가
				    filtered.put("WMSDN", wmsdn);

				    // 결과 추가
				    jarr.add(filtered);
				}

			} else {
				jarr.add(jobj);
			}
		}

		jsend.put("list", jarr);

		// 데이터 전송
		// MES, PTL : RESTFUL
		// SAP : RFC
		DataMap rd = new DataMap();
		DataMap rfcinfo = new DataMap();
		DataMap rfcrst = new DataMap();
		rfcinfo.setModuleCommand("Erpif", "RFCINFO");
		rfcinfo.put("IFID", ifid);
		rfcrst = commonDao.getMap(rfcinfo); 
		
		String rfcfn  = rfcrst.get("RFCFN").toString();
		String rfctbl = rfcrst.get("RFCTBL").toString();
		String rfcp1  = rfcrst.get("RFCP1").toString();
		String rfcp2  = rfcrst.get("RFCP2").toString();
		
		//log.debug("\n send : " + jsend);
		if(ifid.equals("WMS_IF_214")) {
			// WMS_IF_214 입고실적정보(자재,상품)			- PORTAL
			// 프로시저 호출
			DataMap pMap = new DataMap();
			
			pMap.setModuleCommand("Erpif", "WMS_IF_202214");
			pMap.put("P_INOUT_TYPE", "OUT"); // 입고 IN, 실적 OUT
			pMap.put("P_LOGSEQNO", logseqno);
			commonDao.getMap(pMap);
			
			// 전송결과 처리
			row = new DataMap();
			row.setModuleCommand("Erpif", "IFWMS203_FLG");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			row.put("IFID", ifid);
			row.put("LOGSEQNO", logseqno);

			if(pMap.get("result").equals("SUCCESS")) {
				row.put("ITFFLG", "C");
				row.put("PRCFLG", "C");
			} else {
				
				errMsg = pMap.get("result").toString();
				if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
				
				row.put("PRCFLG", "E");
				row.put("PRCETX", errMsg);
			}

			//log.debug("\n Response: " + row);
			
			commonDao.update(row);
			
		/* 231228 주석처리(생산입고 분기 처리)
		} else if (ifid.equals("WMS_IF_222") || ifid.equals("WMS_IF_218")) {
			// WMS_IF_222 입고실적정보(제품)				- MES
			// WMS_IF_218 반납입고실적정보					- MES
			try {
				rd = postRequest.jsonPost(rfcfn, jsend.toJSONString());

				if(rd.get("result").equals("SUCCESS")) {
					rd.put("PRCETX", "SUCCESS");
				} else {
					errMsg = rd.get("result").toString(); //result에 errMsg 가지고 옴..
					if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
					
					rd.put("PRCETX", errMsg);
				}
			} catch (Exception e) {
				errMsg = e.getMessage();
				if (errMsg != null && errMsg.length() > 200) {
					errMsg = errMsg.substring(0, 200);
					rd.put("result", errMsg.substring(0, 200));
				} else {
					rd.put("result", errMsg);
				}
			}

			// 전송결과 처리
			row = new DataMap();
			row.setModuleCommand("Erpif", "IFWMS203_FLG");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			row.put("IFID", ifid);
			row.put("LOGSEQNO", logseqno);

			if(errMsg.equals("SUCCESS")) { 
				row.put("ITFFLG", "C");
				row.put("PRCFLG", "C");
			} else {
				row.put("PRCFLG", "E");
				row.put("PRCETX", rd.get("PRCETX"));
			}

			//log.debug("\n Response: " + row);
			
			commonDao.update(row);
		}
		*/
			
		} else if (ifid.equals("WMS_IF_222")) {	//231227 MES 프로시저 직접 호출
			// WMS_IF_222 입고실적정보(제품)				- MES
			try {
				String jsStr = "";
				jsStr = jsend.toJSONString().replace("\"", "^");	//mybatis로 json 데이터 송신 시 "가 모두 제거됨. 이를 방지하고자 치환
				
				//프로시저 호출(MES DBLINK)
				DataMap prodMap = new DataMap();
				prodMap.setModuleCommand("Erpif", "WMS_IFRWM006");
				prodMap.put("P_STR", jsStr);
				prodMap.put("RES_CD", "");
				prodMap.put("RES_MSG", "");
				commonDao.getMap(prodMap);	// 해당 getMap 호출 시, RES_CD, RES_MSG로 각각 ReturnData 설정됨
				
				System.out.println("rtnData = " + prodMap);
				
				if(prodMap.get("RES_CD").equals("S")) {
					errMsg = "SUCCESS";
					rd.put("PRCETX", "SUCCESS");
				} else {
					errMsg = prodMap.get("RES_MSG").toString(); //result에 errMsg 가지고 옴..
					
					if (errMsg != null && errMsg.length() > 200) {
						errMsg = errMsg.substring(0, 200); 
					}
					
					rd.put("PRCETX", errMsg);
				}
			} catch (Exception e) {
				errMsg = e.getMessage();
				if (errMsg != null && errMsg.length() > 200) {
					errMsg = errMsg.substring(0, 200);
					rd.put("result", errMsg.substring(0, 200));
				} else {
					rd.put("result", errMsg);
				}
			}

			// 전송결과 처리
			row = new DataMap();
			row.setModuleCommand("Erpif", "IFWMS203_FLG");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			row.put("IFID", ifid);
			row.put("LOGSEQNO", logseqno);

			if(errMsg.equals("SUCCESS")) { 
				row.put("ITFFLG", "C");
				row.put("PRCFLG", "C");
			} else {
				row.put("PRCFLG", "E");
				row.put("PRCETX", rd.get("PRCETX"));
			}

			//log.debug("\n Response: " + row);
			
			commonDao.update(row);
		} else if (ifid.equals("WMS_IF_218")) {
			// WMS_IF_218 반납입고실적정보					- MES
			try {
				rd = postRequest.jsonPost(rfcfn, jsend.toJSONString());

				if(rd.get("result").equals("SUCCESS")) {
					rd.put("PRCETX", "SUCCESS");
				} else {
					errMsg = rd.get("result").toString(); //result에 errMsg 가지고 옴..
					if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
					
					rd.put("PRCETX", errMsg);
				}
			} catch (Exception e) {
				errMsg = e.getMessage();
				if (errMsg != null && errMsg.length() > 200) {
					errMsg = errMsg.substring(0, 200);
					rd.put("result", errMsg.substring(0, 200));
				} else {
					rd.put("result", errMsg);
				}
			}

			// 전송결과 처리
			row = new DataMap();
			row.setModuleCommand("Erpif", "IFWMS203_FLG");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			row.put("IFID", ifid);
			row.put("LOGSEQNO", logseqno);

			if(errMsg.equals("SUCCESS")) { 
				row.put("ITFFLG", "C");
				row.put("PRCFLG", "C");
			} else {
				row.put("PRCFLG", "E");
				row.put("PRCETX", rd.get("PRCETX"));
			}

			//log.debug("\n Response: " + row);
			
			commonDao.update(row);
		} else {
			// WMS_IF_215 입고실적정보(수입자재,수입상품)	- SAP : head item 방식으로 본 로직 미사용
			// WMS_IF_216 입고실적정보(이송)				- SAP
			// WMS_IF_2161 입고실적정보(임가공)			- SAP
			// WMS_IF_221 입고실적정보(제품)				- SAP
			// WMS_IF_217 반품입고실적정보			    - SAP
			// WMS_IF_224 반납입고실적정보(자재)			- SAP
			// WMS_IF_219 재고조정입고					- SAP
			List<DataMap> result = new ArrayList();
			List<DataMap> sendlist = new ArrayList();
			RfcCallFunction sapConn = new RfcCallFunction();
			
			//log.debug("\n------------------\n"+getMapFromJsonObject(jsend));
			DataMap xx = new DataMap();
			xx.put("list", getMapFromJsonObject(jsend).get("list"));
//			DataMap xx = getListMapFromJsonArray(jsend);
			
			sendlist.add(xx);
			
			// param map
			DataMap pMap = new DataMap();
			pMap.put("I_IF_NAM", ifid);
			pMap.put("I_IF_KEY", logseqno);
			
			// 임가공 전기일 당일 설정
			if ("WMS_IF_2161".equals(ifid)) {
				pMap.put("I_BLDAT", map.getString("WMS_IF_2161_BUDAT"));
				pMap.put("I_BUDAT", map.getString("WMS_IF_2161_BUDAT"));
			}
			
			log.debug("\nRFC SEND1 ("+rfcfn+","+rfctbl+","+rfcp1+","+rfcp2+","+pMap+") --------------\n"+sendlist.toString());
			List<DataMap> resList = new ArrayList();
			try {
				resList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, sendlist);
				//System.out.println("resList");
				//System.out.println(resList);
				// 전송결과 처리
				for (DataMap res : resList) {
					String resultSTR = res.getString("TYPE");
					String resultMSG = res.getString("MESSAGE");
					String resultBWART = res.getString("BWART");
					String resultWMSDN = res.getString("WMSDN");
					String resultOMBLNR = res.getString("O_MBLNR");
					DataMap param = new DataMap();
					param.putAll(res);
					param.put("IFID", ifid);
					param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					param.setModuleCommand("Erpif", "IFWMS203SAP_FLG");
					param.put("IFID", ifid);
					param.put("LOGSEQNO", logseqno);
					
					if ("WMS_IF_2161".equals(ifid)) {
						param.put("MBLNR", resultOMBLNR);
					}
					
					if ("S".equals(resultSTR)) {     // 성공 응답 시
						rd.put("result", "SUCCESS");

						param.put("ITFFLG", "C");
						param.put("PRCFLG", "C");
						commonDao.update(param);
						
						// UPDATE RECDI
						param.setModuleCommand("Erpif", "IFWMS203_RECDI");
						commonDao.update(param);	
						
					} else {                         // 실패 응답 시
						errMsg = resultMSG;
						if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
						
						rd.put("result", errMsg);
						
						param.put("PRCFLG", "E");
						param.put("PRCETX", errMsg);
						param.put("BWART", resultBWART);
						param.put("WMSDN", resultWMSDN);
						commonDao.update(param);
					}
				}
				
			} catch (Exception e) {
				errMsg = e.getMessage();
				if (errMsg != null && errMsg.length() > 200) {
					errMsg = errMsg.substring(0, 200);
					rd.put("result", errMsg.substring(0, 200));
				} else {
					rd.put("result", errMsg);
				}
			}
			
			//log.debug("\nSAP Response: " + resList);
		}
		
		//return rd.getString("result"); //errMsg는 catch를 안타면 누락되는 경우가 있음.. rfcCall에 대한 return 값을 받아서 던져야함.
		return errMsg; 
	}

	@Transactional
	public String insert_IFWMS213(DataMap map) throws SQLException{
		// WMS_IF_317 생산투입불출실적정보
		// WMS_IF_307 출고실적정보(주문)
		// WMS_IF_308 출고실적정보(이송)
		// WMS_IF_309 자재불출실적정보 mes
		// WMS_IF_320 자재불출실적정보 sap
		// WMS_IF_310 즉시불출실적정보 mes
		// WMS_IF_321 즉시불출실적정보 sap
		// WMS_IF_311 반품출고실적정보(자재,상품)
		// WMS_IF_313 폐기출고실적정보
		// WMS_IF_314 재고조정출고
		// WMS_IF_315 무상출고실적정보
		// WMS_IF_780 팔레트출고실적
		List<DataMap> list = map.getList("list");
		String errMsg = "SUCCESS";
		
		String ifid = "";
		String iftbl = "";
		String recptty = ""; //문서유형
		String rfctype = "";//SAP MES 구분
		String cnlYn = "";
		
		// RECVKY문서번호 기준으로 SHPDI에서 SELECT INSERT 처리
		// 문서유형까지 조건포함 검토필요...
		DataMap row = new DataMap();
		for(int i = 0 ; i < list.size() ; i ++){
			row = list.get(i).getMap("map");
			
			ifid    = map.get("IFID").toString();
			recptty = map.get("RCPTTY").toString();
			rfctype = map.get("RFCTYPE").toString();
			cnlYn   = map.get("CNLYN").toString();
			
			row.put("IFID", ifid);
			row.put("LOGSEQNO", map.get("LOGSEQNO"));
			row.put("OWNRKY", map.get("ownrky"));
			row.put("UI", map.get("menuId"));
			
			if (ifid.equals("WMS_IF_313") // 폐기출고실적정보
			 || ifid.equals("WMS_IF_314") // 재고조정출고
			 || ifid.equals("WMS_IF_324") // 생산투입불출실적정보-MES
			 || (ifid.equals("WMS_IF_310") && recptty.equals("354") && cnlYn.equals("V")) // 즉시불출-MES			 
			 || (ifid.equals("WMS_IF_320") && (recptty.equals("353") || recptty.equals("356"))) // 자재불출실적정보(생산투입불출 or 생산직불출)
			 || ifid.equals("WMS_IF_322") // 생산직불출실적정보
			   ) {
				iftbl = "IFWMS213_TAS";
			} else if (ifid.equals("WMS_IF_780") || ifid.equals("WMS_IF_CARNO")) {
				iftbl = "IFWMS213_PAL"; // 팔레트출고실적, 차량정보 (번호, 자종, 톤수, 이름, 연락처)
			} else {
				
				if(rfctype.equals("SAP")) {
					iftbl = "IFWMS213_SAP";
				}else{
					iftbl = "IFWMS213_MES";
				}
			}
			String menuId = map.get("menuId").toString();
			if(menuId.equals("SD07")) {
				DataMap listRow = map.getMap("row");
				DataMap rowMap =listRow.getMap("map");
				row.putAll(rowMap);
				iftbl = "IFWMS213_SD";
			}
			
			row.setModuleCommand("Erpif", iftbl);

			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			commonDao.insert(row);
		}
		
		// 처리결과
		if(!errMsg.equals("SUCCESS")){
			throw new RuntimeException("[ROLLBACK]\n" + errMsg);
		}
				
		return errMsg;
	}
	
	@Transactional
	public String send_IFWMS213(DataMap map) throws SQLException{
		// WMS_IF_317 생산투입불출실적정보 ***** 삭제
		// WMS_IF_307 출고실적정보(주문)
		// WMS_IF_308 출고실적정보(이송)
		// WMS_IF_309 자재불출실적정보 mes
		// WMS_IF_320 자재불출실적정보 sap
		// WMS_IF_310 즉시불출실적정보 mes
		// WMS_IF_321 즉시불출실적정보 sap ***** 삭제
		// WMS_IF_311 반품출고실적정보(자재,상품)
		// WMS_IF_313 폐기출고실적정보
		// WMS_IF_314 재고조정출고
		// WMS_IF_315 무상출고실적정보 *** 삭제 307통합
		// WMS_IF_322 생산직불출실적정보 mes
		// WMS_IF_324 생산투입불출실적정보 mes
		// WMS_IF_780 팔레트출고실적 SAP
		String errMsg = "SUCCESS";
		String ifid = map.getString("IFID");
		String logseqno = map.getString("LOGSEQNO");
		String recptty = map.get("RCPTTY").toString(); //WMS 문서유형 		
		String state = map.getString("STATE");
		
		
		List<DataMap> if213List = new ArrayList<DataMap>();
		DataMap row = new DataMap();
		row.setModuleCommand("Erpif", "IFWMS213");
		row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		row.put("IFID", ifid);
		row.put("LOGSEQNO", logseqno);
		if213List = commonDao.getList(row);
		
		if(if213List == null || if213List.size() == 0){
			errMsg="전송할 데이터가 없습니다. "+ifid;
			return errMsg;
		}	
		
		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		PostRequest postRequest = new PostRequest();
		JSONArray jarr = new JSONArray();
		JSONObject jobj = new JSONObject();
		JSONObject jsend = new JSONObject();

		DataMap smap = new DataMap();
		for(int i=0; i < if213List.size(); i++) {
			smap = if213List.get(i);
			
			jobj = new JSONObject();
			
			if (ifid.equals("WMS_IF_307") || ifid.equals("WMS_IF_308") || ifid.equals("WMS_IF_309") || ifid.equals("WMS_IF_320") || ifid.equals("WMS_IF_310")
			 || ifid.equals("WMS_IF_311") || ifid.equals("WMS_IF_313") || ifid.equals("WMS_IF_314") || ifid.equals("WMS_IF_322") || ifid.equals("WMS_IF_324")
			 || ifid.equals("WMS_IF_780") || ifid.equals("WMS_IF_CARNO") ) {
				// WMS_IF_307 출고실적정보(주문)
				// WMS_IF_308 출고실적정보(이송)
				// WMS_IF_309 자재불출실적정보 mes
				// WMS_IF_320 자재불출실적정보 sap
				// WMS_IF_310 즉시불출실적정보 mes
				// WMS_IF_311 반품출고실적정보(자재,상품)
				// WMS_IF_313 폐기출고실적정보
				// WMS_IF_314 재고조정출고
				// WMS_IF_322 생산직불출실적정보 mes
				// WMS_IF_324 생산투입불출실적정보 mes
				// WMS_IF_780 팔레트출고실적 SAP
				for(int icol=0; icol < mpcolList.size(); icol++) {
					if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
						if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
							String commaStr = mpcolList.get(icol).get("SOURCE").toString();
							String[] commaStrList = commaStr.split(",");
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(commaStrList[0]).toString() + smap.get(commaStrList[1]).toString());
						} else {
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(mpcolList.get(icol).get("SOURCE")));
						}
					}
				}
			} else {
				jobj.put("VBELN", smap.get("VBELN"));
				jobj.put("POSNR", smap.get("POSNR"));
				jobj.put("WADAT", smap.get("WADAT"));
				jobj.put("KUNAG", smap.get("KUNAG"));
				jobj.put("MATNR", smap.get("MATNR"));
				jobj.put("MEINS", smap.get("MEINS"));
				jobj.put("ZQTSACT", smap.get("ZQTSACT"));
				jobj.put("QTSHP", smap.get("QTSHP"));
				jobj.put("ORDCAT", smap.get("ORDCAT"));
				jobj.put("LOTA01", smap.get("LOTA01"));
				jobj.put("LOTA02", smap.get("LOTA02"));
				jobj.put("LOTA03", smap.get("LOTA03"));
				jobj.put("LOTA04", smap.get("LOTA04"));
				jobj.put("LOTA05", smap.get("LOTA05"));
				jobj.put("LOTA06", smap.get("LOTA06"));
				jobj.put("LOTA07", smap.get("LOTA07"));
				jobj.put("LOTA08", smap.get("LOTA08"));
				jobj.put("LOTA09", smap.get("LOTA09"));
				jobj.put("LOTA10", smap.get("LOTA10"));
				jobj.put("LOTA11", smap.get("LOTA11"));
				jobj.put("LOTA12", smap.get("LOTA12"));
				jobj.put("LOTA13", smap.get("LOTA13"));
				jobj.put("LOTA14", smap.get("LOTA14"));
				jobj.put("LOTA15", smap.get("LOTA15"));
				jobj.put("LOTA16", smap.get("LOTA16"));
				jobj.put("LOTA17", smap.get("LOTA17"));
				jobj.put("LOTA18", smap.get("LOTA18"));
				jobj.put("LOTA19", smap.get("LOTA19"));
				jobj.put("LOTA20", smap.get("LOTA20"));
			}

			jarr.add(jobj);
		}

		jsend.put("list", jarr);

		// 데이터 전송
		// MES, PTL : RESTFUL
		// SAP : RFC
		DataMap rd = new DataMap();
		DataMap rfcinfo = new DataMap();
		DataMap rfcrst = new DataMap();
		rfcinfo.setModuleCommand("Erpif", "RFCINFO");
		rfcinfo.put("IFID", ifid);
		rfcrst = commonDao.getMap(rfcinfo); 
		
		String rfcfn = rfcrst.get("RFCFN").toString();
		String rfctbl = rfcrst.get("RFCTBL").toString();
		String rfcp1 = rfcrst.get("RFCP1").toString();		// IF_RESTR
		String rfcp2 = rfcrst.get("RFCP2").toString();
		
		//log.debug("\n send : " + jsend);
		if(ifid.equals("WMS_IF_309") || ifid.equals("WMS_IF_310") || ifid.equals("WMS_IF_322") || ifid.equals("WMS_IF_324")) {
			// MES
			// WMS_IF_309 자재불출실적정보 mes
			// WMS_IF_310 즉시불출실적정보 mes
			// WMS_IF_322 생산직불출실적정보 mes
			
			errMsg = "SUCCESS";
			
			try {
				rd = postRequest.jsonPost(rfcfn, jsend.toJSONString());

				if(!rd.get("result").equals("SUCCESS")) {
					// 실패응답시
					errMsg = rd.get("result").toString();
					if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
				}
			} catch (Exception e) {
				errMsg = e.getMessage();
				if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
			}		
			
			// 전송결과 처리
			row = new DataMap();
			row.setModuleCommand("Erpif", "IFWMS213_FLG");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			row.put("IFID", ifid);
			row.put("LOGSEQNO", logseqno);

			if(errMsg.equals("SUCCESS")) {
				row.put("PRCFLG", "C");
			} else {
				row.put("PRCFLG", "E");
				row.put("PRCETX", errMsg);
			}
			
			commonDao.update(row);
			
			//log.debug("MES전송결과 : " + rd);
			
		} else {
			// SAP
			// WMS_IF_307 출고실적정보(주문)
			// WMS_IF_308 출고실적정보(이송)
			// WMS_IF_320 자재불출실적정보 sap
			// WMS_IF_311 반품출고실적정보(자재,상품)
			// WMS_IF_313 폐기출고실적정보
			// WMS_IF_314 재고조정출고
			// WMS_IF_780 팔레트출고실적
			
			errMsg = "SUCCESS";
			
			List<DataMap> sendlist = new ArrayList();
			RfcCallFunction sapConn = new RfcCallFunction();
			
//			//log.debug("\n------------------\n"+getMapFromJsonObject(jsend));
			DataMap xx = new DataMap();
			xx.put("list", getMapFromJsonObject(jsend).get("list"));
			
			sendlist.add(xx);
			
			DataMap pMap = new DataMap();
			pMap.put("I_IF_NAM", ifid);
			pMap.put("I_IF_KEY", logseqno);
			
			if(ifid.equals("WMS_IF_780")) {
				pMap.put("I_GUBUN", state);
			}
			
			log.debug("\nRFC SEND2 ("+rfcfn+","+rfctbl+","+rfcp1+","+rfcp2+","+pMap+") --------------\n"+sendlist.toString());
			List<DataMap> resList = new ArrayList();
			try {
				
				resList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, sendlist);
				
				// 전송결과 처리
				int resFailCnt = 0;
				String resFailLastMsg = "";
				
				for (DataMap res : resList) {
					String resultStr = res.getString("TYPE");
					String resultEvStr = res.getString("EV_CODE");
					
					String resultStatus = res.getString("STATUS");	// 선적차량 갱신시 수신되는 코드
					
					DataMap param = new DataMap();
					param.putAll(res);
					param.put("IFID", ifid);
					param.put("LOGSEQNO", logseqno);
					param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					if(ifid.equals("WMS_IF_780") || ifid.equals("WMS_IF_CARNO")) {
						param.setModuleCommand("Erpif", "IFWMS213_FLG");
					}else {
						param.setModuleCommand("Erpif", "IFWMS213multi_FLG");
					}
					
					
					if ("S".equals(resultStr) || "S".equals(resultEvStr) || "S".equals(resultStatus)) {     // 성공 응답 시
						param.put("PRCFLG", "C");
						commonDao.update(param); // UPDATE IFWMS213

						if(ifid.equals("WMS_IF_307") || ifid.equals("WMS_IF_308") || (ifid.equals("WMS_IF_320") && recptty.equals("205"))|| ifid.equals("WMS_IF_311")) {
							// 팔레트출고실적은 처리안함
							// UPDATE SHPDI
							if(!resultEvStr.equals("") && !resultEvStr.equals(" ") && !resultEvStr.equals(null)) {
								param.put("MBLNR", res.getString("EV_MBLNR"));
								param.put("WMSDN", res.getString("EV_GR_NO"));
							}
							
							param.setModuleCommand("Erpif", "IFWMS213_SHPDI");
							commonDao.update(param);	
						}else if (ifid.equals("WMS_IF_CARNO")) {
							param.put("CARNO", res.getString("CARNO"));
							param.put("STKNUM", res.getString("TKNUM"));
							param.put("CARTON", res.getString("ADD01"));
							param.put("CARART", res.getString("ADD02"));
							param.put("DRIVER", res.getString("DRIVER"));
							param.put("DRIVERCEL", res.getString("DRIVERCEL"));
							
							param.setModuleCommand("Erpif", "IFWMS213_SHPDH_CARNO");
							commonDao.update(param);	
						}else {
							// UPDATE TASDI
							param.setModuleCommand("Erpif", "IFWMS213_TASDI");
							commonDao.update(param);
						}

					} else {   // 실패 응답 시
						param.put("PRCFLG", "E");
						param.put("PRCETX", res.get("MESSAGE"));
						commonDao.update(param); // UPDATE IFWMS213
						resFailCnt++;
						resFailLastMsg = res.get("MESSAGE").toString();
					}
				}
				
				if(resFailCnt > 0) {
					errMsg = "실패:"+resFailCnt+"건 - "+resFailLastMsg+"...";
					if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
				}
			} catch (RuntimeException e) {
				//231019 JYH 로그메시지에 JCO가 포함될 경우, 해당 테이블 상태를 임의 갱신
				//JCOException 발생시, RuntimeException으로 전달함.
				//param - if213List, map, ifid, logseqno, errmsg
				errMsg = e.getMessage();
				if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
				
				if(resList != null) {					
					System.out.println(resList.size());
				}else {
					System.out.println(resList);
				}
								
				IFWMS213_ERR_SET(if213List, map, ifid, logseqno, errMsg);
				
			} catch (Exception e) {
				errMsg = e.getMessage();
				if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
				
				if(resList != null) {					
					System.out.println(resList.size());
				}else {
					System.out.println(resList);
				}
			}
			
			//log.debug("\nSAP Response: " + resList);

		}
		
//		//log.debug("\n result : " + rd);
		
		// 전송결과 처리
//		row = new DataMap();
//		row.setModuleCommand("Erpif", "IFWMS213_FLG");
//		row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
//		row.put("IFID", ifid);
//		row.put("LOGSEQNO", logseqno);
//
//		if(errMsg.equals("SUCCESS")) {
//			row.put("PRCFLG", "C");
//		} else {
//			row.put("PRCFLG", "E");
//			row.put("PRCETX", errMsg);
//		}
//
//		commonDao.update(row); 
		
//		errMsg = rd.get("result").toString();
		
		return errMsg;
	}
	
	@Transactional
	public String send_IFWMS_HEADITEM(DataMap map) throws SQLException{
		// WMS_IF_311 반품출고실적정보(자재,상품)
		// WMS_IF_215 입고실적정보(자재,상품)
		String errMsg = "SUCCESS";
		String ifid = map.getString("IFID");
		String logseqno = map.getString("LOGSEQNO");
		String recptty = map.get("RCPTTY").toString(); //WMS 문서유형 
			
		List<DataMap> if213ListH = new ArrayList<DataMap>();
		List<DataMap> if213ListI = new ArrayList<DataMap>();
		DataMap rowH = new DataMap();
		DataMap rowI = new DataMap();
		
		if("WMS_IF_215".equals(ifid)) {
			rowH.setModuleCommand("Erpif", "IFWMS203_HEAD");
		}else {
			rowH.setModuleCommand("Erpif", "IFWMS213_HEAD");
		}
		rowH.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		rowH.put("IFID", ifid);
		rowH.put("LOGSEQNO", logseqno);
		if213ListH = commonDao.getList(rowH);
		
		if("WMS_IF_215".equals(ifid)) {
			rowI.setModuleCommand("Erpif", "IFWMS203_ITEM");
		}else {
			rowI.setModuleCommand("Erpif", "IFWMS213_ITEM");
		}
		rowI.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		rowI.put("IFID", ifid);
		rowI.put("LOGSEQNO", logseqno);
		if213ListI = commonDao.getList(rowI);

		if(if213ListH == null || if213ListH.size() == 0){
			errMsg="전송할 데이터가 없습니다. "+ifid;
			return errMsg;
		}
		
		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		PostRequest postRequest = new PostRequest();
		JSONArray jarrH = new JSONArray();
		JSONArray jarrI = new JSONArray();
		JSONObject jobH = new JSONObject();
		JSONObject jobI = new JSONObject();
		JSONObject jsend = new JSONObject();

		DataMap smapH = new DataMap();
		for(int i=0; i < if213ListH.size(); i++) {
			smapH = if213ListH.get(i);
			
			jobH = new JSONObject();
			
			if (ifid.equals("WMS_IF_311") || ifid.equals("WMS_IF_215") ) {
				// HEAD
				jobH.put("EBELN",		smapH.get("VBELN"));
				jobH.put("GR_DATE",		smapH.get("WADAT"));
				jobH.put("VD_CD",		smapH.get("KUNAG"));
				jobH.put("GR_PROG_STS",	smapH.get("STATUS"));
				jobH.put("GR_CRE_DATE",	smapH.get("WADAT"));
				jobH.put("PO_NO",		smapH.get("PO_NO"));
				jobH.put("PO_REV",		smapH.get("PO_REV"));
				jobH.put("GR_CHR_ID",	smapH.get("CREUSR"));
				jobH.put("GR_NO",		smapH.get("ZDOC_NO"));
				//jobH.put("GR_REV",		smapH.get("ZDOC_ITEM"));
			}

			jarrH.add(jobH);
		}
		jsend.put("HEAD", jarrH);
		
		DataMap smapI = new DataMap();
		for(int i=0; i < if213ListI.size(); i++) {
			smapI = if213ListI.get(i);
			
			jobI = new JSONObject();
			
			if (ifid.equals("WMS_IF_311") || ifid.equals("WMS_IF_215")) {
				// ITEM
				jobI.put("ITEM_CD",		smapI.get("MATNR"));
				jobI.put("UNIT_CD",		smapI.get("MEINS"));
				jobI.put("GR_QTY",		smapI.get("ZQTSACT"));
				jobI.put("WH_CD",		smapI.get("LOTA01"));
				jobI.put("PLT_CD",		smapI.get("LOTA02"));				
				
				jobI.put("ZVPRDDAT",	smapI.get("LOTA11"));
				jobI.put("ZEXPDAT",		smapI.get("LOTA13"));
				jobI.put("CHARG",		smapI.get("LOTA15"));
				jobI.put("PO_LNO",		smapI.get("PO_LNO"));		

				jobI.put("GR_NO",		smapI.get("ZDOC_NO"));
				jobI.put("GR_REV",		smapI.get("ZDOC_ITEM"));
				jobI.put("PO_NO",		smapI.get("PO_NO"));
				jobI.put("ITEM_NM",		smapI.get("DESC01"));
				jobI.put("EBELN",		smapI.get("VBELN"));
			}
			
			if(ifid.equals("WMS_IF_311")) {
				jobI.put("STCK_TYPE",	smapI.get("LOTA06"));	
			}
			
			if (ifid.equals("WMS_IF_215")) {
				jobI.put("STCK_TYPE",	smapI.get("STCK_TYPE"));
			}
			
			jarrI.add(jobI);
		}
		jsend.put("ITEM", jarrI);

		// 데이터 전송
		// MES, PTL : RESTFUL
		// SAP : RFC
		DataMap rd = new DataMap();
		DataMap rfcinfo = new DataMap();
		DataMap rfcrst = new DataMap();
		rfcinfo.setModuleCommand("Erpif", "RFCINFO");
		rfcinfo.put("IFID", ifid);
		rfcrst = commonDao.getMap(rfcinfo); 
		
		String rfcfn  = rfcrst.get("RFCFN").toString();
		String rfctbl = rfcrst.get("RFCTBL").toString();
		String rfcp1  = rfcrst.get("RFCP1").toString();		// IF_RESTR
		String rfcp2  = rfcrst.get("RFCP2").toString();
		
		String mblnr = ""; // MBLNR
		
		//log.debug("\n send : " + jsend);
		if(ifid.equals("WMS_IF_311") || ifid.equals("WMS_IF_215")) {
			// SAP
			// WMS_IF_311 반품출고실적정보(자재,상품)
			
			List<DataMap> sendlist = new ArrayList();
			RfcCallFunction sapConn = new RfcCallFunction();
			
			//log.debug("\n------------------\n"+getMapFromJsonObject(jsend));
			DataMap xx = new DataMap();
			xx.put("HEAD", getMapFromJsonObject(jsend).get("HEAD"));
			xx.put("ITEM", getMapFromJsonObject(jsend).get("ITEM"));
			
			sendlist.add(xx);
			
			DataMap pMap = new DataMap();
			pMap.put("I_IF_NAM", ifid);
			pMap.put("I_IF_KEY", logseqno);

			log.debug("\nRFC SEND3 ("+rfcfn+","+rfctbl+","+rfcp1+","+rfcp2+","+pMap+") --------------\n"+sendlist.toString());
			List<DataMap> resList = new ArrayList();
			try {
				resList = sapConn.RfcCallTableHEADITEM(rfcfn, "IS_HEADER", "IT_ITEM", rfcp1, pMap, sendlist);
				// 전송결과 처리
				for (DataMap res : resList) {
					String resultStr = res.getString("TYPE");
					String resultEvStr = res.getString("EV_CODE");
					
					DataMap param = new DataMap();
					param.putAll(res);
					param.put("IFID", ifid);
					param.put("LOGSEQNO", logseqno);
					param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					if ("S".equals(resultStr) || "S".equals(resultEvStr)) {     // 성공 응답 시
						rd.put("result", "SUCCESS");

						if(ifid.equals("WMS_IF_311") ) {
							// UPDATE SHPDI
							if("S".equals(resultEvStr)) {
								param.put("MBLNR", res.get("EV_MBLNR"));
								param.put("WMSDN", res.get("EV_GR_NO"));
								
								mblnr = res.getString("EV_MBLNR");
							}
							
							param.setModuleCommand("Erpif", "IFWMS213_SHPDI");
							commonDao.update(param);
						}else if(ifid.equals("WMS_IF_215") ) {
							
							if("S".equals(resultEvStr)) {
								param.put("MBLNR", res.get("EV_MBLNR"));
								param.put("WMSDN", res.get("EV_GR_NO"));
								
								mblnr = res.getString("EV_MBLNR");
							}
							
							param.setModuleCommand("Erpif", "IFWMS203_RECDI");
							commonDao.update(param);
						}
						
					} else {                         // 실패 응답 시
								
						if("E".equals(res.get("EV_CODE"))) {
							errMsg = res.get("EV_MSG").toString();	
						}else {
							errMsg = res.get("MESSAGE").toString();
						}
						
						rd.put("result", errMsg);
					}
				}
				
//				rd.put("result", "SUCCESS");
			} catch (RuntimeException e) {
				errMsg = e.getMessage();
				if (errMsg != null && errMsg.length() > 200) {
					errMsg = errMsg.substring(0, 200);
					rd.put("result", errMsg.substring(0, 200));
				} else {
					rd.put("result", errMsg);
				}
				
				//231107 강제 E처리
				IFWMS213_ERR_SET(if213ListH, map, ifid, logseqno, errMsg);
				
			} catch (Exception e) {
				errMsg = e.getMessage();
				if (errMsg != null && errMsg.length() > 200) {
					errMsg = errMsg.substring(0, 200);
					rd.put("result", errMsg.substring(0, 200));
				} else {
					rd.put("result", errMsg);
				}
				
			}
			
			//log.debug("\nSAP Response: " + resList);

		}
		
		//log.debug("\n result : " + rd);
		
		// 전송결과 처리
		DataMap row = new DataMap();
		
		if("WMS_IF_215".equals(ifid)) {
			row.setModuleCommand("Erpif", "IFWMS203_FLG");
		}else {
			row.setModuleCommand("Erpif", "IFWMS213_FLG");
		}
		row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		row.put("IFID", ifid);
		row.put("LOGSEQNO", logseqno);
		
		row.put("MBLNR", mblnr);

		if(errMsg.equals("SUCCESS")) {
			row.put("PRCFLG", "C");
		} else {
			row.put("PRCFLG", "E");
			row.put("PRCETX", errMsg);
		}

		commonDao.update(row); 
				
		
		return errMsg;
	}
	
	@Transactional
	public String insert_IFWMS223(DataMap map) throws SQLException{
		// WMS_IF_401 재고상태변경정보
