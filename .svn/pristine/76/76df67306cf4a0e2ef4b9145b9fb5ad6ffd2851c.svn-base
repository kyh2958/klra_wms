    public static boolean checkDate(String checkDate, String fmt) {
        try {
        	// fmt : yyyyMMdd 등
            SimpleDateFormat dateFormatParser = new SimpleDateFormat(fmt);
            dateFormatParser.setLenient(false);
            dateFormatParser.parse(checkDate);
            return true;
        } catch (Exception e) {
            return false;
        }
    }
    
    //@Transactional runtimeException 발생 시, 'I' 고정값을 강제로 'E' 업데이트
	public void IFWMS213_ERR_SET(List<DataMap> wmsLst, DataMap map, String ifid, String logseqno, String errMsg) throws SQLException{

		try {
			
			for (DataMap res : wmsLst) {
				
				DataMap param = new DataMap();

				// 전송결과 처리
				param.putAll(res);
				param.put("IFID", ifid);
				param.put("LOGSEQNO", logseqno);
				param.put("WMSDN", res.get("ZDOC_NO"));
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				if(ifid.equals("WMS_IF_780")) {
					param.setModuleCommand("Erpif", "IFWMS213_FLG");
				}else {
					param.setModuleCommand("Erpif", "IFWMS213multi_FLG");
				}
				
				param.put("PRCFLG", "E");
				param.put("PRCETX", errMsg);
				commonDao.update(param); // UPDATE IFWMS213
				//resFailCnt++;
				//resFailLastMsg = res.get("MESSAGE").toString();
				
				/*
				if(resFailCnt > 0) {
					errMsg = "실패:"+resFailCnt+"건 - "+resFailLastMsg+"...";
					if (errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
				}
				*/
				
				//System.out.println("강제 ERROR 업데이트 처리 - " + ifid + "       " + logseqno);
			}
		} catch (Exception e) {
			//log.debug(e.getMessage());
		}	
	}
	
