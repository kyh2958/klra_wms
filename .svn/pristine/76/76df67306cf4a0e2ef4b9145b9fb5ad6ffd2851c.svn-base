			row.put("IFID"    , ifid);
			row.put("LOGSEQNO", logseqno);
//			row.put("OWNRKY", map.get("ownrky"));
			row.setModuleCommand("Erpif", "IFWMS223");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			// 공통
			row.put("MANDT",  "100"); // SAP 운영
			row.put("ORDCAT", "400"); // 오더카테고리 400
			row.put("WERKS",  row.get("OWNRKY")); // 화주
			// UI에서 호출시 SKUKEY,  데이터전송(엑셀업로드)시 MATNR 상이함
			row.put("MATNR",  (row.get("SKUKEY").toString().trim() != "") ? row.get("SKUKEY") : row.get("MATNR")); // 품목코드
			
			if(ifid.equals("WMS_IF_401")) { // WMS_IF_401 재고상태변경정보
				row.put("BWART", "402"); // 오더유형 - 재고상태변경
				                                       row.put("TLOTA02", row.get("LOTA02")); row.put("TLOTA03", row.get("LOTA03")); row.put("TLOTA04", row.get("LOTA04")); row.put("TLOTA05", row.get("LOTA05"));
				                                       row.put("TLOTA07", row.get("LOTA07")); row.put("TLOTA08", row.get("LOTA08")); row.put("TLOTA09", row.get("LOTA09")); row.put("TLOTA10", row.get("LOTA10"));
				row.put("TLOTA11", row.get("LOTA11")); row.put("TLOTA12", row.get("LOTA12")); row.put("TLOTA13", row.get("LOTA13")); row.put("TLOTA14", row.get("LOTA14")); row.put("TLOTA15", row.get("LOTA15"));
				row.put("TLOTA16", row.get("LOTA16")); row.put("TLOTA17", row.get("LOTA17")); row.put("TLOTA18", row.get("LOTA18")); row.put("TLOTA19", row.get("LOTA19")); row.put("TLOTA20", row.get("LOTA20"));

				// UI에서 호출시 ALOTAXX,  데이터전송(엑셀업로드)시 TLOTAXX 상이함
				row.put("TLOTA01",  (row.get("ALOTA01").toString().trim() != "") ? row.get("ALOTA01") : row.get("TLOTA01")); // 재고상태
				row.put("TLOTA06",  (row.get("ALOTA06").toString().trim() != "") ? row.get("ALOTA06") : row.get("TLOTA06")); // 재고상태
				row.put("DOCDAT", map.get("DOCDAT").toString()); //CREDAT로 INSERT
			} else if(ifid.equals("WMS_IF_402")) { // WMS_IF_402 MTO/MTS변경정보
				row.put("BWART", "423"); // 오더유형 - 재고MTO변경

				row.put("TLOTA01", row.get("LOTA01")); row.put("TLOTA02", row.get("LOTA02")); row.put("TLOTA03", row.get("LOTA03")); row.put("TLOTA04", row.get("LOTA04")); row.put("TLOTA05", row.get("LOTA05"));
				row.put("TLOTA06", row.get("LOTA06"));                                        row.put("TLOTA08", row.get("LOTA08"));                                        row.put("TLOTA10", row.get("LOTA10"));
				row.put("TLOTA11", row.get("LOTA11")); row.put("TLOTA12", row.get("LOTA12")); row.put("TLOTA13", row.get("LOTA13")); row.put("TLOTA14", row.get("LOTA14")); row.put("TLOTA15", row.get("LOTA15"));
				row.put("TLOTA16", row.get("LOTA16")); row.put("TLOTA17", row.get("LOTA17")); row.put("TLOTA18", row.get("LOTA18")); row.put("TLOTA19", row.get("LOTA19")); row.put("TLOTA20", row.get("LOTA20"));
				
