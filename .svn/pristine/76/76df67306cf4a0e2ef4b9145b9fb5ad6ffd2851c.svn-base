					comFLG.put("SEQNO", logseqno);
					comFLG.put("ERRTXT", errMsg);
					commonDao.update(comFLG);
				}
			}
		}
		
		return errMsg;
	}

	@Transactional
	public String receive_IFWMS103(DataMap map) throws SQLException{
		// WMS_IF_204 입고예정정보(임가공)           - SAP
		// WMS_IF_204 입고예정정보(이송)            - SAP
		// WMS_IF_206 반품입고예정정보              - SAP
		// WMS_IF_220 입고처리(고지/펄프)           - KLOGI
		// EXCEL WMS_IF_202 입고예정정보(자재,상품) - PORTAL
		// EXCEL WMS_IF_205 입고예정정보(제품)      - MES
		// EXCEL WMS_IF_207 반납입고예정정보        - MES
		List<DataMap> list = map.getList("data");
		String errMsg = "SUCCESS";
		
		// interface 등록 : 수신데이터 변형없이 원본 그대로 저장

		String ifid     = map.get("IFID").toString();
		String rfcfn    = map.get("rfcfn").toString();
		String rfctbl   = map.get("rfctbl").toString();
		String rfctbl2  = map.get("rfctbl2").toString();
		String rfcp1    = map.get("rfcp1").toString();
		String rfcp2    = map.get("rfcp2").toString();
		String logseqno = map.get("LOGSEQNO").toString();
		String isExcelUpload = map.get("REMARK").toString();

		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		// MULTI INSERT
		List<HashMap> mlist1 = new ArrayList<HashMap>();
		HashMap row = new HashMap();
		HashMap mprow;
		try {
			for(int i = 0 ; i < list.size() ; i ++){
				mprow = new HashMap();
				row = list.get(i).getMap("map");

				mprow.put("IFID", ifid);
				mprow.put("LOGSEQNO", logseqno);
				mprow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				if (ifid.equals("WMS_IF_204") || ifid.equals("WMS_IF_206") || ifid.equals("WMS_IF_220")
				 || ifid.equals("WMS_IF_202") || ifid.equals("WMS_IF_205") || ifid.equals("WMS_IF_207")
				 || ifid.equals("WMS_IFC206") || ifid.equals("WMS_IFB206") || ifid.equals("WMS_IFS206") 
				 || ifid.equals("WMS_IF_2041")
				 ) {
					// WMS_IF_204 입고예정정보(이송)            - SAP
					// WMS_IF_2041 입고예정정보(임가공)            - SAP
					// WMS_IF_206 반품입고예정정보              	   - SAP
					// WMS_IF_220 입고처리(고지/펄프)           - KLOGI
					// EXCEL WMS_IF_202 입고예정정보(자재,상품)  - PORTAL
					// EXCEL WMS_IF_205 입고예정정보(제품)      - MES
					// EXCEL WMS_IF_207 반납입고예정정보        	   - MES
					for(int icol=0; icol < mpcolList.size(); icol++) {
						if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
							if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
								String commaStr = mpcolList.get(icol).get("SOURCE").toString();
								String[] commaStrList = commaStr.split(",");
								mprow.put(mpcolList.get(icol).get("TARGET"),row.get(commaStrList[0]).toString() + row.get(commaStrList[1]).toString());
							} else {
								if(ifid.equals("WMS_IF_205") || ifid.equals("WMS_IF_207")) {
									mprow.put(mpcolList.get(icol).get("TARGET"),row.get(mpcolList.get(icol).get("TARGET")));
								} else {
									mprow.put(mpcolList.get(icol).get("TARGET"),row.get(mpcolList.get(icol).get("SOURCE")));
								}
							}
						}
					}
				}
				
				if (i == 0) {
					System.out.println("receive_IFWMS103 toString");
					System.out.println(row.toString());
				}
				
				mlist1.add(mprow);
	
				if(((i+1) % 100) == 0) {
					commonDao.insert("IFWMS103_MULTI", mlist1);
					mlist1.clear();
				}
			}
			
			if(mlist1.size() > 0) {
				commonDao.insert("IFWMS103_MULTI", mlist1);
				mlist1.clear();
			}
			
		} catch (Exception e) {
			// 수신되는 데이터를 변형없이 그대로 저장해야하는 이유 - 버그 발생 최소화
			// 대량의 데이터를 처리하기때문에 에러정보를 저장관리하는것은 상당히 비효율적이며
			// 여기서는 대부분이 프로그램 버그(시스템간 컬럼 type,size상이 및 매칭오류)에 기인함으로 프로그램 수정후 배포되어야함
			errMsg = e.getMessage();
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
		}
		// MULTI INSERT
		
		// 통신,인터페이스 FLAG 셋팅
		DataMap comFLG  = new DataMap();
		comFLG.setModuleCommand("Erpif", "IFWMSLOG");
		comFLG.put("IFID", map.get("IFID"));
		comFLG.put("SEQNO", logseqno);
		DataMap setFLG  = new DataMap();
		setFLG.setModuleCommand("Erpif", "IFWMS103_FLG");
		setFLG.put("IFID", map.get("IFID"));
		setFLG.put("LOGSEQNO", logseqno);
		
		if(!errMsg.equals("SUCCESS")){
			// 통신 에러처리
			comFLG.put("COMSTAT", "E");
			comFLG.put("ERRTXT", errMsg);
			commonDao.update(comFLG);
			// 인터페이스 에러처리
			setFLG.put("ITFFLG", "E");
			setFLG.put("ITFETX", errMsg);
			setFLG.put("PRCFLG", "E");
			setFLG.put("PRCETX", errMsg);
			commonDao.update(setFLG);
		} else {
			// SAP의 RFC를 호출해서 수신받는 경우 IFTABLE까지 정상적으로 등록된후 그 결과를 전송하는 RFC를 다시 호출해줘야함
			// SAP에서는 본 호출을 통해 정상적으로 전송이 되었음을 인지하고 후속처리하도록 해야함
			// 여기까지 프로세스가 진행되었으면 IFTABLE에는 정상적으로 등록된 상태며
			// 이후 SAP에 수신완료 결과를 호출할때 SAP측에서 오류나더라도 패스함
			// 임가공은 응답처리 구현이 안되있어 SUCCESS 인 경우 성공처리 기록
			DataMap rtnRst = new DataMap();
			if(!isExcelUpload.equals("EXCEL")) {
				DataMap pMap = new DataMap();
				
				pMap.put("I_IF_NAM", ifid);
				pMap.put("I_IF_KEY", logseqno);
				pMap.put("I_GUBUN", "R");
				
				try {
					List<DataMap> returnList = new ArrayList<DataMap>();
					RfcCallFunction sapConn = new RfcCallFunction();
					returnList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, null);
					
					JCoStructure returnStructure = (JCoStructure) returnList.get(0).get("E_RETURN");
					
					rtnRst.put("TYPE", returnStructure.getValue("TYPE"));
					rtnRst.put("MESSAGE", returnStructure.getValue("MESSAGE"));
				} catch (Exception e) {
					
					if ("WMS_IF_2041".equals(ifid)) {
						rtnRst.put("TYPE", "S");
						rtnRst.put("MESSAGE", " ");
					} else {
						rtnRst.put("TYPE", "E");
						rtnRst.put("MESSAGE", "수신결과 R 호출 응답에러");
					}
				}
				
				System.out.println(rtnRst.toString());
			}
			
			if(rtnRst.get("TYPE").equals("S") || isExcelUpload.equals("EXCEL")) {
				// 통신 완료처리
				comFLG.put("COMSTAT", "R");
			} else {
				comFLG.put("COMSTAT", "E");
				comFLG.put("ERRTXT", rtnRst.get("MESSAGE"));
			}
			commonDao.update(comFLG);

			// 통신 완료처리 후 현재 LOGSEQNO 대상건을 기준으로 이전건의 UD처리 필요
			if (ifid.equals("WMS_IF_2041") || ifid.equals("WMS_IF_204") || ifid.equals("WMS_IFC206") || ifid.equals("WMS_IFB206") || ifid.equals("WMS_IFS206") || ifid.equals("WMS_IF_206")) {
				String chkStatus = "";
				DataMap chkP103 = new DataMap();
				DataMap chkD103 = new DataMap();
	            chkP103.put("LOGSEQNO", logseqno);
	            // SAP에서 특정아이템만 삭제 D 될경우에는 삭제된건은 송신안하며 그 이외건만 수정 U 로 전송함
	            // 전체 삭제일경우에는 전체 D로 전송함
	            // 그렇다면..... WMS는 어찌?
	            // 일단 수신된 오더에 대하여 기존 진행중이던 아니던간에 해당 오더 삭제 처리 - STATUS = 'D' 로 업데이트
	            // 스캔중이던 담당자 입고처리시 에러유도
	            
	            
	            // STEP 1 : 기존 진행여부 상관없이 오더기준 삭제처리
	            chkP103.setModuleCommand("Erpif", "IFWMS103_SAP_UD");
	            //commonDao.update(chkP103);
	
	            // STEP 1.5 : 기존 진행여부  오더기준 삭제처리 (중복이긴하지만 일단 임시로 프로시저 호출)
	    		DataMap seqMap = new DataMap();
	    		seqMap.put("LOGSEQNO", logseqno);
	    		seqMap.setModuleCommand("Erpif", "IFWMS204_IFSEQ");
	    		commonDao.getMap(seqMap);

	            // STEP 2 : 입고처리 진행여부 체크 - 오더기준
	            // 무시하고 변경오더 알림 및 에러유도 (UI 체크 필요)
//	            chkD103 = new DataMap();
//	            chkP103.setModuleCommand("Erpif", "IFWMS103_CHK");
//	            chkD103 = commonDao.getMap(chkP103);
//	            
//	            if(chkD103!=null && !"".equals(chkD103.getString("SEQNO").trim()) ) {
//	            	// STEP 2-1 : 입고처리중일 경우 에러 리턴
////	            	errMsg = "[처리불가] 입고진행건 EBELN : " + row.get("EBELN") + ", EBELP : " + row.get("EBELP");
//	            	errMsg = "[처리불가] 입고진행건 EBELN : " + row.get("EBELN");
//	            	
//	            	// 내부처리에러 로그
//					comFLG.put("INERRAT", "E");
//					comFLG.put("INERRTXT", errMsg);
//					commonDao.update(comFLG);
//	            }
			}

			// 인터페이스 완료처리
			setFLG.put("ITFFLG", "C");
			setFLG.put("PRCFLG", "C");
			setFLG.put("ITFETX", "");
			commonDao.update(setFLG);
			
			// 임가공 삭제된 오더 삭제처리 (P_AIRWMS_IFWMS204_SEQNO 수행시 다른 i/f에 의해 삭제처리 발생)
            if (ifid.equals("WMS_IF_2041")) {
            	DataMap chkP103 = new DataMap();
	            chkP103.put("LOGSEQNO", logseqno);
            	chkP103.setModuleCommand("Erpif", "IFWMS103_2041_UD");
            	commonDao.update(chkP103);
            } 
		}
		
		return errMsg;
	}

	@Transactional
    public String receive_IFWMS103_RESTFUL(DataMap map) throws SQLException{
      // WMS_IF_202 입고예정정보(자재,상품)  - PORTAL은 DBTODB방식으로 변경되어 본 로직으로 발생되지 않음
      // WMS_IF_205 입고예정정보(제품)      - MES
      // WMS_IF_207 반납입고예정정보              - MES
		
	  long startTime = System.currentTimeMillis();
      String errMsg = "PROCCESS";
      String ifid = map.get("IFID").toString();
      String logseqno = map.get("LOGSEQNO").toString();
      DataMap row = new DataMap();

      // 매핑컬럼 조회
      List<DataMap> mpcolList = new ArrayList<DataMap>();
      DataMap pcol = new DataMap();
      pcol.setModuleCommand("Erpif", "IFCOL");
      pcol.put("IFID", ifid);
      mpcolList = commonDao.getList(pcol);

      try {
         List<DataMap> listx = map.getList("data");
         Map<String, Object> jod = new DataMap();

         String chkStatus = "";
         DataMap chkP103 = new DataMap(); //Processing Map
         DataMap chkD103 = new DataMap();
         DataMap chkE103 = new DataMap();
         
         for(int i=0; i < listx.size(); i++) {
            jod = listx.get(i).getMap("map");
            
            if (ifid.equals("WMS_IF_202") || ifid.equals("WMS_IF_205") || ifid.equals("WMS_IF_207")) {
               // WMS_IF_202 입고예정정보(자재,상품)  - PORTAL은 DBTODB방식으로 변경되어 본 로직으로 발생되지 않음
               // WMS_IF_205 입고예정정보(제품)      - MES
               // WMS_IF_207 반납입고예정정보              - MES
               for(int icol=0; icol < mpcolList.size(); icol++) {
                  if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
                     // MES와의 통신시 수신측 컬럼으로 정의
                     row.put(mpcolList.get(icol).get("TARGET"),jod.get(mpcolList.get(icol).get("TARGET")));
                  }
               }
            }
            
            if (ifid.equals("WMS_IF_205")) {
            	 //log.debug("[WMS_IF_205] : " + jod.toString() ); 
            }
            
            // CUD 분기처리
            chkP103.put("EBELN", row.get("EBELN"));
            chkP103.put("EBELP", row.get("EBELP"));
            chkP103.put("LOTA14", row.get("LOTA14"));
            chkP103.put("LOTA15", row.get("LOTA15"));
            chkP103.put("IFID", ifid);

            // STEP 0 : 삭제요청건 기존 오더존재 체크  
            if(row.getString("STATUS").equals("D")) {
            	chkE103 = new DataMap();
            	chkP103.setModuleCommand("Erpif", "IFWMS103_EXIST");
                chkE103 = commonDao.getMap(chkP103);
            	if(chkE103 == null || "".equals(chkE103.getString("SEQNO").trim()) ) {
                    // STEP 0-1 : 기존 오더 없을경우 에러
                    errMsg = "[삭제불가] 처리할 오더,아이템번호가 없습니다. EBELN : " + row.get("EBELN") + ", EBELP : " + row.get("EBELP");
                    break;
            	}
            }

            // STEP 1 : 기존 미진행건 삭제처리
            chkP103.setModuleCommand("Erpif", "IFWMS103_UD");  
            commonDao.update(chkP103);

            // STEP 1-1 : 개별바코드 중복 체크
            chkD103 = new DataMap();
            chkP103.setModuleCommand("Erpif", "IFWMS103_LOTA14_CHK");
            chkD103 = commonDao.getMap(chkP103);
            
            // 생산입고만 개별바코드 중복 체크
            if(ifid.equals("WMS_IF_205") && chkD103 != null && !"".equals(chkD103.getString("SEQNO").trim()) ) {
                // STEP 1-1-1 : 개별바코드 중복일 경우 에러 리턴
                errMsg = "[처리불가] 개별바코드중복건 LOTA14 : " + row.get("LOTA14") + ", 이전오더 : " + chkD103.getString("EBELN");
                break;
            }
            // STEP 1-2 : 제조일자 유무 체크
            /*
            if (ifid.equals("WMS_IF_205") && "".equals(row.get("LOTA11").toString().trim()) ) {
            	errMsg = "[처리불가] 제조일자 누락 : "+ row.get("LOTA14");
            	break;
            }
            */
            // STEP 2 : 입고처리 진행여부 체크
            chkD103 = new DataMap();
            chkP103.setModuleCommand("Erpif", "IFWMS103_CHK");
            chkD103 = commonDao.getMap(chkP103);
            
            if(ifid.equals("WMS_IF_205") && chkD103 != null && !"".equals(chkD103.getString("SEQNO").trim()) ) {
               // STEP 2-1 : 입고처리중일 경우 에러 리턴
               errMsg = "[처리불가] 입고진행건 EBELN : " + row.get("EBELN") + ", EBELP : " + row.get("EBELP");
               break;
            } else {
               // STEP 2-2 : 신규건 등록
               row.setModuleCommand("Erpif", "IFWMS103");
               row.put("IFID", ifid);
               row.put("LOGSEQNO", logseqno);
               row.put(CommonConfig.SES_USER_ID_KEY, ifid);
               commonDao.insert(row);
               
               long endTime = System.currentTimeMillis();
               
               long secDiffTime = (startTime - endTime) /1000; 
               
               //log.debug("시간차이(s) : "+secDiffTime);
               
               if (secDiffTime <= 4 ) {
            	   errMsg = "SUCCESS";
               } else {
            	   errMsg = "[처리불가] 요청시간 경과 EBELN : " + row.get("EBELN") + ", EBELP : " + row.get("EBELP");
            	   break;
               }
            }

            if(ifid.equals("WMS_IF_205") || ifid.equals("WMS_IF_207")) {
            	if(!row.get("STATUS").toString().equals("D")) {
		            // BEDAT 날짜형식체크
		            if(errMsg.equals("SUCCESS") && !checkDate(row.get("BEDAT").toString(), "yyyyMMdd")) {
		                errMsg = "[처리불가] BEDAT 날짜형식(yyyyMMdd) 에러 : EBELN : " + row.get("EBELN") + ", EBELP : " + row.get("EBELP") + ", BEDAT : " + row.get("BEDAT");
		            }
		            // EINDT 날짜형식체크
		            if(errMsg.equals("SUCCESS") && !checkDate(row.get("EINDT").toString(), "yyyyMMdd")) {
		                errMsg = "[처리불가] EINDT 날짜형식(yyyyMMdd) 에러 : EBELN : " + row.get("EBELN") + ", EBELP : " + row.get("EBELP") + ", EINDT : " + row.get("EINDT");
		            }
            	}
            }

            if(ifid.equals("WMS_IF_205")) {
            	if(!row.get("STATUS").toString().equals("D")) {
		            // LOTA07 자리수 체크
		            if(errMsg.equals("SUCCESS") && row.get("LOTA07").toString().trim().length() > 0) {
		            	if(row.get("LOTA07").toString().trim().length() != 16) {
		            		errMsg = "[처리불가] LOTA07 특별재고 판매문서(10)+항목번호(6) 자리수 에러 : EBELN : " + row.get("EBELN") + ", EBELP : " + row.get("EBELP") + ", LOTA07 : " + row.get("LOTA07");
		            	}
		            }
            	}
            }
         } 
      } catch (Exception e) {
         //log.debug("receive_IFWMS103_RESTFUL Error : " + e.getMessage());
         e.printStackTrace();
         errMsg = e.getMessage();
         try {
            if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
         }catch (Exception ex) {
            //log.debug("receive_IFWMS103_RESTFUL - errMsg.substring Error : " + ex.getMessage());
            ex.printStackTrace();
            errMsg = "errMsg.substring Error";
         }
      }
      
      //log.debug("receive_IFWMS103_RESTFUL.errMsg : " + errMsg);
      
      // 통신,인터페이스 FLAG 셋팅
      DataMap comFLG  = new DataMap();
      comFLG.setModuleCommand("Erpif", "IFWMSLOG");
      comFLG.put("IFID", ifid);
      comFLG.put("SEQNO", logseqno);
      DataMap setFLG  = new DataMap();
      setFLG.setModuleCommand("Erpif", "IFWMS103_FLG");
      setFLG.put("IFID", ifid);
      setFLG.put("LOGSEQNO", logseqno);
      
      if(!errMsg.equals("SUCCESS")){
         // 통신 에러처리
         comFLG.put("COMSTAT", "E");
         comFLG.put("ERRTXT", errMsg);
         commonDao.update(comFLG);
         // 인터페이스 에러처리
         setFLG.put("ITFFLG", "E");
         setFLG.put("ITFETX", errMsg);
         setFLG.put("PRCFLG", "E");
         setFLG.put("PRCETX", errMsg);
         commonDao.update(setFLG);
      } else {
         // 통신 수신완료 처리
         comFLG.put("COMSTAT", "R");
         commonDao.update(comFLG);
         // 인터페이스 완료처리
         setFLG.put("ITFFLG", "C");
         setFLG.put("PRCFLG", "C");
         commonDao.update(setFLG );
      }
      
      return errMsg;
    }
	
	@Transactional
	public String receive_IFWMS109_RESTFUL(DataMap map) throws SQLException{
		// WMS_IF_209 입고실적정보(자재)-품질검사결과		- MES
		// WMS_IF_211 입고실적정보(수입자재)-품질검사결과	- MES *** 삭제
		// WMS_IF_213 반품입고실적정보-품질검사결과			- MES
		String errMsg = "SUCCESS";
		String ifid = map.get("IFID").toString();
		String logseqno = map.get("LOGSEQNO").toString();
		DataMap row = new DataMap();
		List<DataMap> chk = new ArrayList<DataMap>();

		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);

		try {
			List<DataMap> listx = map.getList("data");
			DataMap jod = new DataMap();

			for(int i=0; i < listx.size(); i++) {
				jod = listx.get(i).getMap("map");
				
				if (ifid.equals("WMS_IF_209") || ifid.equals("WMS_IF_213")) {
					// WMS_IF_209 입고실적정보(자재)-품질검사결과		- MES
					// WMS_IF_211 입고실적정보(수입자재)-품질검사결과	- MES *** 삭제
					// WMS_IF_213 반품입고실적정보-품질검사결과			- MES
					for(int icol=0; icol < mpcolList.size(); icol++) {
						if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
//							if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
//								String commaStr = mpcolList.get(icol).get("SOURCE").toString();
//								String[] commaStrList = commaStr.split(",");
//								row.put(mpcolList.get(icol).get("TARGET"),jod.get(commaStrList[0]).toString() + jod.get(commaStrList[1]).toString());
//							} else {
//								row.put(mpcolList.get(icol).get("TARGET"),jod.get(mpcolList.get(icol).get("SOURCE")));
//							}
								
							// MES와의 통신시 수신측 컬럼으로 정의
							row.put(mpcolList.get(icol).get("TARGET"),jod.get(mpcolList.get(icol).get("TARGET")));
						}
					}
				}
				
				// 기 처리건 여부체크, 취소건체크
				row.setModuleCommand("Erpif", "IFWMS109_CHKQR");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, ifid);
				chk = commonDao.getList(row);
				
				if( chk!=null && chk.size()>0 ) {
					errMsg = "[기처리] 이미 처리된 건입니다 : "
				            +row.get("EBELN").toString()+":"+row.get("EBELP").toString()+":"+row.get("VGBEL").toString()+":"+row.get("VGPOS").toString();
					break;
				}
				
				// MES에서 기 전송건 수정으로 다시 보낼경우 : 프로시저에서 품질변경, 수정건 등록처리 프로세스로 해결되면 아래 로직은 주석으로 처리
//				if(chk.size() > 0) {
//					for(int j=0; j<chk.size(); j++) {
//						// 기존 수신건
//						if(chk.get(j).get("CHKRST").equals("QF")) {
//							errMsg = "[처리불가] 이미 상태변경처리된 건입니다! "+row.get("EBELN").toString()+":"+row.get("EBELP").toString()+":"+row.get("VGBEL").toString()+":"+row.get("VGPOS").toString();
//							break;
//							
//						} else {
//							// IFWMS109 품질검사결과 기존 등록건 삭제 update (ITFFLG = 'D', PRCFLG = 'D')
//							row.setModuleCommand("Erpif", "IFWMS109_FLG");
//							row.put("SEQNO", chk.get(j).get("SEQNO"));
//							row.put("LOGSEQNO", chk.get(j).get("LOGSEQNO"));
//							row.put("IFID", ifid);
//							row.put("ITFFLG", "D");
//							row.put("ITFETX", "변경,취소 수신건으로 삭제처리");
//							row.put("PRCFLG", "D");
//							row.put("PRCETX", "변경,취소 수신건으로 삭제처리");
//							row.put(CommonConfig.SES_USER_ID_KEY, ifid);
//							commonDao.update(row);
//						}
//					}
//				}
				
				if( "".equals(row.getString("LOTNUM").trim()) ) {
					errMsg = "[필수값 누락] LOTNUM은 필수 입니다.: "
					        +row.get("EBELN").toString()+":"+row.get("EBELP").toString()+":"+row.get("VGBEL").toString()+":"+row.get("VGPOS").toString()+":"+row.get("LOTNUM").toString();
					break;
				}
				
				// 수량체크 입고수량 = 정상 + 불량
				if(Integer.parseInt(nvl(row.get("MENGE"),"0")) != Integer.parseInt(nvl(row.get("QTYGOD"),"0")) + Integer.parseInt(nvl(row.get("QTYBAD"),"0"))) {
					errMsg = "[검수수량 불일치] 입고수량("+nvl(row.get("MENGE"),"0")+") != 정상("+nvl(row.get("QTYGOD"),"0")+")+불량("+nvl(row.get("QTYBAD"),"0")+") 건입니다 : "
				            +row.get("EBELN").toString()+":"+row.get("EBELP").toString()+":"+row.get("VGBEL").toString()+":"+row.get("VGPOS").toString();
					break;
				}

				// IFWMS109 품질검사결과 등록
				row.setModuleCommand("Erpif", "IFWMS109");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, ifid);
				commonDao.insert(row);
			}
			
			if(!errMsg.equals("SUCCESS")) {
				// IFWMS109 품질검사결과 현재 등록된 LOGSEQNO 기준으로 전체 삭제 delete
				row.setModuleCommand("Erpif", "IFWMS109_CHKQR");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, ifid);
				commonDao.delete(row);
			}
			
		} catch (Exception e) {
			errMsg = "FAIL : IFWMS109 품질검사결과 등록 "+e.getMessage();
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
		}
		
		// 통신,인터페이스 FLAG 셋팅
		DataMap comFLG  = new DataMap();
		comFLG.setModuleCommand("Erpif", "IFWMSLOG");
		comFLG.put("IFID", ifid);
		comFLG.put("SEQNO", logseqno);
		DataMap setFLG = new DataMap();
		setFLG.setModuleCommand("Erpif", "IFWMS109_FLG");
		setFLG.put("IFID", ifid);
		setFLG.put("LOGSEQNO", logseqno);
		
		if(!errMsg.equals("SUCCESS")){
			// 통신 에러처리
			comFLG.put("COMSTAT", "E");
			comFLG.put("ERRTXT", errMsg);
			commonDao.update(comFLG);
			// 인터페이스 에러처리
			setFLG.put("ITFFLG", "E");
			setFLG.put("ITFETX", errMsg);
			setFLG.put("PRCFLG", "E");
			setFLG.put("PRCETX", errMsg);
			commonDao.update(setFLG);
		} else {
			// 통신 수신완료 처리
			comFLG.put("COMSTAT", "R");
			commonDao.update(comFLG);
			// 인터페이스 완료처리
			setFLG.put("ITFFLG", "C");
			setFLG.put("PRCFLG", "N");
			commonDao.update(setFLG );

			// 검사결과 자동처리 프로시저 호출 P_AIRWMS_AUTO_QUALITY
			row.setModuleCommand("Erpif", "IFWMS109");
			row.put("IFID", ifid);
			row.put("LOGSEQNO", logseqno);
			row.put("result", "");
			commonDao.getMap(row);

			errMsg = row.get("result").toString();
			//log.debug("IFService.receive_IFWMS109_RESTFUL - P_AIRWMS_AUTO_QUALITY - result : " + errMsg);
			
			if( !"SUCCESS".equals(errMsg)) {
				
				if( errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
				
				// 통신완료후 발생한 에러처리
				comFLG.setModuleCommand("Erpif", "IFWMSLOG_INERR");
				comFLG.put("SEQNO", logseqno);
				comFLG.put("ERRTXT", errMsg);
				commonDao.update(comFLG);
				
			}
		}
		
		return errMsg;
	}
	
	public static String nvl(Object str, String defaultStr) {
		String r = "";
		try {
			r = (str == null || str.equals("")) ? defaultStr : str.toString();
		} catch (Exception e) {
			r = "0";
		}
		return r;
	}
	
	@Transactional
	public String receive_IFWMS108_RESTFUL(DataMap  map) throws SQLException{
		// WMS_IF_223 순회품질검사결과	- MES
		String errMsg = "SUCCESS";
		String ifid = map.get("IFID").toString();
		String logseqno = map.get("LOGSEQNO").toString();
		DataMap row = new DataMap();
		List<DataMap> chk = new ArrayList<DataMap>();

		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);

		try {
			List<DataMap> listx = map.getList("data");
			Map<String, Object> jod = new DataMap();

			for(int i=0; i < listx.size(); i++) {
				jod = listx.get(i).getMap("map");
				
				if (ifid.equals("WMS_IF_223")) {
					// WMS_IF_223 순회품질검사결과	- MES
					for(int icol=0; icol < mpcolList.size(); icol++) {
						if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
//							if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
//								String commaStr = mpcolList.get(icol).get("SOURCE").toString();
//								String[] commaStrList = commaStr.split(",");
//								row.put(mpcolList.get(icol).get("TARGET"),jod.get(commaStrList[0]).toString() + jod.get(commaStrList[1]).toString());
//							} else {
//								row.put(mpcolList.get(icol).get("TARGET"),jod.get(mpcolList.get(icol).get("SOURCE")));
//							}
								
							// MES와의 통신시 수신측 컬럼으로 정의
							row.put(mpcolList.get(icol).get("TARGET"),jod.get(mpcolList.get(icol).get("TARGET")));
						}
					}
				}
				
				// 기 처리건 여부체크, 취소건체크
				row.setModuleCommand("Erpif", "IFWMS108_CHKQR");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, ifid);
				chk = commonDao.getList(row);
				
				if( chk!=null && chk.size()>0 ) {
					errMsg = "[순회기처리] 이미 처리된 건입니다 : "
							+row.get("EBELN").toString()+":"+row.get("EBELP").toString()+":"+row.get("VGBEL").toString()+":"+row.get("VGPOS").toString();
					break;
				}
				
				if( "".equals(row.getString("LOTNUM").trim()) ) {
					errMsg = "[순회 필수값 누락] LOTNUM은 필수 입니다.: "
							+row.get("EBELN").toString()+":"+row.get("EBELP").toString()+":"+row.get("LOTNUM").toString();
					break;
				}
				
				// 수량체크 입고수량 = 정상 + 불량
				if(Integer.parseInt(nvl(row.get("MENGE"),"0")) != Integer.parseInt(nvl(row.get("QTYGOD"),"0")) + Integer.parseInt(nvl(row.get("QTYBAD"),"0"))) {
					errMsg = "[순회검수수량 불일치] 입고수량("+nvl(row.get("MENGE"),"0")+") != 정상("+nvl(row.get("QTYGOD"),"0")+")+불량("+nvl(row.get("QTYBAD"),"0")+") 건입니다 : "
							+row.get("EBELN").toString()+":"+row.get("EBELP").toString()+":"+row.get("VGBEL").toString()+":"+row.get("VGPOS").toString();
					break;
				}
				
				// IFWMS108 순회품질검사결과 등록
				row.setModuleCommand("Erpif", "IFWMS108");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, ifid);
				commonDao.insert(row);
			}
			
			
			if(!errMsg.equals("SUCCESS")) {
				// IFWMS109 품질검사결과 현재 등록된 LOGSEQNO 기준으로 전체 삭제 delete
				row.setModuleCommand("Erpif", "IFWMS108_CHKQR");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, ifid);
				commonDao.delete(row);
			}
			
		} catch (Exception e) {
			errMsg = "FAIL : IFWMS108 순회품질검사결과 등록 "+e.getMessage();
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
		}
		
		// 통신,인터페이스 FLAG 셋팅
		DataMap comFLG  = new DataMap();
		comFLG.setModuleCommand("Erpif", "IFWMSLOG");
		comFLG.put("IFID", ifid);
		comFLG.put("SEQNO", logseqno);
		DataMap setFLG  = new DataMap();
		setFLG.setModuleCommand("Erpif", "IFWMS108_FLG");
		setFLG.put("IFID", ifid);
		setFLG.put("LOGSEQNO", logseqno);
		
		//log.debug("IFService.receive_IFWMS108_RESTFUL : " + errMsg);
		
		if(!errMsg.equals("SUCCESS")){
			// 통신 에러처리
			comFLG.put("COMSTAT", "E");
			comFLG.put("ERRTXT", errMsg);
			commonDao.update(comFLG);
			// 인터페이스 에러처리
			setFLG.put("ITFFLG", "E");
			setFLG.put("ITFETX", errMsg);
			setFLG.put("PRCFLG", "E");
			setFLG.put("PRCETX", errMsg);
			commonDao.update(setFLG);
		} else {
			// 통신 수신완료 처리
			comFLG.put("COMSTAT", "R");
			commonDao.update(comFLG);
			// 인터페이스 완료처리
			setFLG.put("ITFFLG", "C");
			setFLG.put("PRCFLG", "C");
			commonDao.update(setFLG );
		}
		
		return errMsg;
	}
	
	@Transactional
	public String receive_IFWMS113_RESTFUL(DataMap map) throws SQLException{
		// WMS_IF_303 출고예정정보(자재,수입밀롤)	- MES
		// WMS_IF_305 생산투입불출정보				- MES
		String errMsg = "SUCCESS";
		String ifid = map.get("IFID").toString();
		String logseqno = map.get("LOGSEQNO").toString();
		DataMap row = new DataMap();

		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		try {
			List<DataMap> listx = map.getList("data");
			Map<String, Object> jod = new DataMap();

			for(int i=0; i < listx.size(); i++) {
				jod = listx.get(i).getMap("map");
				
				if(ifid.equals("WMS_IF_303") || ifid.equals("WMS_IF_305")) {
					// WMS_IF_303 출고예정정보(자재,수입밀롤)	- MES
					// WMS_IF_305 생산투입불출정보				- MES
					for(int icol=0; icol < mpcolList.size(); icol++) {
						if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
//							if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
//								String commaStr = mpcolList.get(icol).get("SOURCE").toString();
//								String[] commaStrList = commaStr.split(",");
//								row.put(mpcolList.get(icol).get("TARGET"),jod.get(commaStrList[0]).toString() + jod.get(commaStrList[1]).toString());
//							} else {
//								row.put(mpcolList.get(icol).get("TARGET"),jod.get(mpcolList.get(icol).get("SOURCE")));
//							}
							
							// MES와의 통신시 수신측 컬럼으로 정의
							row.put(mpcolList.get(icol).get("TARGET"),jod.get(mpcolList.get(icol).get("TARGET")));
						}
					}
				}
				
				row.setModuleCommand("Erpif", "IFWMS113");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put(CommonConfig.SES_USER_ID_KEY, ifid);
				commonDao.insert(row);
				
	            if(ifid.equals("WMS_IF_303")) {
	            	if(!row.get("STATUS").toString().equals("D")) {
			            // LOTA07 자리수 체크
			            if(errMsg.equals("SUCCESS") && row.get("LOTA07").toString().trim().length() > 0) {
			            	if(row.get("LOTA07").toString().trim().length() != 16) {
			            		errMsg = "[처리불가] LOTA07 특별재고 판매문서(10)+항목번호(6) 자리수 에러 : VBELN : " + row.get("VBELN") + ", POSNR : " + row.get("POSNR") + ", LOTA07 : " + row.get("LOTA07");
			            	}
			            }
	            	}
	            }
			}
			
			if(listx.size() == 0) {
				errMsg = "처리할 데이터가 없습니다.";
			}
		} catch (Exception e) {
			errMsg = e.getMessage();
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
		}
		
		// 통신,인터페이스 FLAG 셋팅
		DataMap comFLG  = new DataMap();
		comFLG.setModuleCommand("Erpif", "IFWMSLOG");
		comFLG.put("IFID", ifid);
		comFLG.put("SEQNO", logseqno);
		DataMap setFLG  = new DataMap();
		setFLG.setModuleCommand("Erpif", "IFWMS113_FLG");
		setFLG.put("IFID", ifid);
		setFLG.put("LOGSEQNO", logseqno);
		
		if(!errMsg.equals("SUCCESS")){
			// 통신 에러처리
			comFLG.put("COMSTAT", "E");
			comFLG.put("ERRTXT", errMsg);
			commonDao.update(comFLG);
			// 인터페이스 에러처리
			setFLG.put("ITFFLG", "E");
			setFLG.put("ITFETX", errMsg);
			setFLG.put("PRCFLG", "E");
			setFLG.put("PRCETX", errMsg);
			commonDao.update(setFLG);
		} else {
			// 통신 수신완료 처리
			comFLG.put("COMSTAT", "R");
			commonDao.update(comFLG);
			// 인터페이스 완료처리
			setFLG.put("ITFFLG", "C");
			setFLG.put("PRCFLG", "N");
			commonDao.update(setFLG );

			if(ifid.equals("WMS_IF_305")) {
				// 불출실적 등록 프로시저 호출 P_AIRWMS_PROD_INPUT
				row.setModuleCommand("Erpif", "IFWMS113_PROD");
				row.put("IFID", ifid);
				row.put("LOGSEQNO", logseqno);
				row.put("result", "");
				commonDao.getMap(row);
				
				errMsg = row.get("result").toString();
				
				String SAPLOGSEQ = row.get("SAPLOGSEQ").toString();
				String MESLOGSEQ = row.get("MESLOGSEQ").toString();
				
				String errMsg1 = "";
				String errMsg2 = "";
				
				if(errMsg.equals("SUCCESS")) {
					// 프로시저 성공이면
					// 불출실적 전송 - SAP : WMS_IF_320, MES : WMS_IF_324 
					DataMap sMap;

					// SAP : WMS_IF_320 자재불출실적정보
					sMap = new DataMap();
					sMap.put("IFID", "WMS_IF_320");
					sMap.put("LOGSEQNO", SAPLOGSEQ);
					sMap.put(CommonConfig.SES_USER_ID_KEY, ifid);

					// SAP통신 시작로그
					comFLG.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
					comFLG.put("COMSTAT", "C");
					comFLG.put("IFID", "WMS_IF_320");
					comFLG.put("SEQNO", SAPLOGSEQ);
					commonDao.insert(comFLG);
					
					errMsg1 = send_IFWMS213(sMap);
					errMsg = errMsg1;
					
					if(errMsg1.equals("SUCCESS")) {
						// SAP통신 송신완료 처리
						comFLG.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
						comFLG.put("IFID", "WMS_IF_320");
						comFLG.put("SEQNO", SAPLOGSEQ);
						comFLG.put("COMSTAT", "S");
						commonDao.update(comFLG);

						// MES : WMS_IF_324 생산투입불출실적정보-MES
						sMap = new DataMap();
						sMap.put("IFID", "WMS_IF_324");
						sMap.put("LOGSEQNO", MESLOGSEQ);
						sMap.put(CommonConfig.SES_USER_ID_KEY, ifid);

						// MES통신 시작로그
						comFLG.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
						comFLG.put("COMSTAT", "C");
						comFLG.put("IFID", "WMS_IF_324");
						comFLG.put("SEQNO", MESLOGSEQ);
						commonDao.insert(comFLG);

						errMsg2 = send_IFWMS213(sMap);
						errMsg = errMsg2;
						
						if(errMsg2.equals("SUCCESS")) {
							// MES통신 송신완료 처리
							comFLG.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
							comFLG.put("IFID", "WMS_IF_324");
							comFLG.put("SEQNO", MESLOGSEQ);
							comFLG.put("COMSTAT", "S");
							commonDao.update(comFLG);
						} else {
							// MES통신 송신에러 처리
							comFLG.setModuleCommand("Erpif", "IFWMSLOG");
							comFLG.put("IFID", "WMS_IF_324");
							comFLG.put("SEQNO", MESLOGSEQ);
							comFLG.put("COMSTAT", "E");
							comFLG.put("ERRTXT", errMsg);
							commonDao.update(comFLG);
						}
					} else {
						// SAP통신 송신에러 처리
						comFLG.setModuleCommand("Erpif", "IFWMSLOG");
						comFLG.put("IFID", "WMS_IF_320");
						comFLG.put("SEQNO", SAPLOGSEQ);
						comFLG.put("COMSTAT", "E");
						comFLG.put("ERRTXT", errMsg);
						commonDao.update(comFLG);
						
						// 출고취소 처리 (WMS만)
						row.setModuleCommand("Erpif", "IFWMS113_PROD_CANCEL");
						row.put("IFID", ifid);
						row.put("LOGSEQNO", SAPLOGSEQ);
						row.put("result", "");
						commonDao.getMap(row);
					}
				}
			} else {
				// WMS_IF_303 출고예정정보(자재,수입밀롤)	- MES
				// P_AIRWMS_IFWMS113_PROC 호출
				DataMap param = new DataMap();
				param.setModuleCommand("Erpif", "IFWMS113");
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				param.put("LOGSEQNO", logseqno);
				param.put("result", "");
				commonDao.getMap(param);

				errMsg = param.get("result").toString();
				if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
			}

			if( !ifid.equals("WMS_IF_305") && !errMsg.equals("SUCCESS") ) {
				if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
				// 통신완료후 발생한 에러처리
				comFLG.setModuleCommand("Erpif", "IFWMSLOG_INERR");
				comFLG.put("SEQNO", logseqno);
				comFLG.put("ERRTXT", errMsg);
				commonDao.update(comFLG);
			}
		}
		
		return errMsg;
	}

	@Transactional
	public String receive_IFWMS113(DataMap map) throws SQLException{
		// WMS_IF_301 출고예정정보(주문)-판매,수출,무상	- SAP
		// WMS_IF_302 출고예정정보(이송)				- SAP
		// WMS_IF_303 출고예정정보(자재,수입밀롤)		- EXCEL MES
		// WMS_IF_305 생산투입불출정보				- EXCEL MES
		// WMS_IF_318 반품출고예정정보(자재,상품)		- SAP
		// WMS_IF_316 생산투입정보(고지/펄프)			- SAP
		
		List<DataMap> list = map.getList("data");
		String errMsg = "SUCCESS";
		
		// interface 등록 : 수신데이터 변형없이 원본 그대로 저장
		
		String ifid     = map.get("IFID").toString();
		String rfcfn    = map.get("rfcfn").toString();
		String rfctbl   = map.get("rfctbl").toString();
		String rfctbl2  = map.get("rfctbl2").toString();
		String rfcp1    = map.get("rfcp1").toString();
		String rfcp2    = map.get("rfcp2").toString();
		String logseqno = map.get("LOGSEQNO").toString();
		String isExcelUpload = map.get("REMARK").toString();

		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		// MULTI INSERT
		List<HashMap> mlist1 = new ArrayList<HashMap>();
		HashMap row = new HashMap();
		HashMap mprow;
		
		try {
			for(int i = 0 ; i < list.size() ; i ++){
				mprow = new HashMap();
				
				row = list.get(i).getMap("map");
				
				mprow.put("IFID", ifid);
				mprow.put("LOGSEQNO", logseqno);
				mprow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				if ( ifid.equals("WMS_IF_318") || ifid.equals("WMS_IF_316")
				  || ifid.equals("WMS_IF_303") || ifid.equals("WMS_IF_305")
				  || ifid.equals("WMS_IF_301") || ifid.equals("WMS_IFC301") || ifid.equals("WMS_IFB301") || ifid.equals("WMS_IFS301") || ifid.equals("WMS_IFZ301")
				  || ifid.equals("WMS_IF_302") || ifid.equals("WMS_IFC302") || ifid.equals("WMS_IFB302") || ifid.equals("WMS_IFS302")
				 ) {
					// WMS_IF_301 출고예정정보(주문)-판매,수출,무상	- SAP
					// WMS_IF_302 출고예정정보(이송)				- SAP
					// WMS_IF_303 출고예정정보(자재,수입밀롤)		- EXCEL MES
					// WMS_IF_305 생산투입불출정보				- EXCEL MES
					// WMS_IF_318 반품출고예정정보(자재,상품)		- SAP
					// WMS_IF_316 생산투입정보(고지/펄프)			- SAP
					for(int icol=0; icol < mpcolList.size(); icol++) {
						if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
							if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
								String commaStr = mpcolList.get(icol).get("SOURCE").toString();
								String[] commaStrList = commaStr.split(",");
								mprow.put(mpcolList.get(icol).get("TARGET"), row.get(commaStrList[0]).toString() + row.get(commaStrList[1]).toString());
							} else {
//								if (ifid.contains("301") || ifid.contains("302")) {
//									if("POSNR".equals(mpcolList.get(icol).get("TARGET")) ) {
//										if( row.get(mpcolList.get(icol).get("SOURCE")).toString().startsWith("9") ) {
//											throw new SQLException("["+ row.get(mpcolList.get(icol).get("SOURCE")).toString() + "] 올바르지 않은 품목 코드입니다.");
//										}
//									}
//								}
								mprow.put(mpcolList.get(icol).get("TARGET"), row.get(mpcolList.get(icol).get("SOURCE")));
							}
						}
					}
				}
				
				mlist1.add(mprow);

				if(((i+1) % 100) == 0) {
					commonDao.insert("IFWMS113_MULTI", mlist1);
					mlist1.clear();
				}
			}
			
			if(mlist1.size() > 0) {
				commonDao.insert("IFWMS113_MULTI", mlist1);
				mlist1.clear();
			}
		} catch (Exception e) {
			errMsg = e.getMessage();
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
		}
		
		// 통신,인터페이스 FLAG 셋팅
		DataMap comFLG  = new DataMap();
		comFLG.setModuleCommand("Erpif", "IFWMSLOG");
		comFLG.put("IFID", map.get("IFID"));
		comFLG.put("SEQNO", logseqno);
		DataMap setFLG  = new DataMap();
		setFLG.setModuleCommand("Erpif", "IFWMS113_FLG");
		setFLG.put("IFID", map.get("IFID"));
		setFLG.put("LOGSEQNO", logseqno);
		
		if(!errMsg.equals("SUCCESS")){
			// 통신 에러처리
			comFLG.put("COMSTAT", "E");
			comFLG.put("ERRTXT", errMsg);
			commonDao.update(comFLG);
			// 인터페이스 에러처리
			setFLG.put("ITFFLG", "E");
			setFLG.put("ITFETX", errMsg);
			setFLG.put("PRCFLG", "E");
			setFLG.put("PRCETX", errMsg);
			commonDao.update(setFLG);
		} else {
			// SAP의 RFC를 호출해서 수신받는 경우 IFTABLE까지 정상적으로 등록된후 그 결과를 전송하는 RFC를 다시 호출해줘야함
			// SAP에서는 본 호출을 통해 정상적으로 전송이 되었음을 인지하고 후속처리하도록 해야함
			// 여기까지 프로세스가 진행되었으면 IFTABLE에는 정상적으로 등록된 상태며
			// 이후 SAP에 수신완료 결과를 호출할때 SAP측에서 오류나더라도 패스함
			DataMap rtnRst = new DataMap();
//			if("1".equals("2") && !isExcelUpload.equals("EXCEL")) {
			if(!isExcelUpload.equals("EXCEL")) {
				DataMap pMap = new DataMap();
				
				pMap.put("I_IF_NAM", ifid);
				pMap.put("I_IF_KEY", logseqno);
				pMap.put("I_GUBUN", "R");
				
//				rfctbl = "E_RETURN";
				
				List<DataMap> returnList = new ArrayList<DataMap>();
				//log.debug("RFC RESULT SEND ("+rfcfn+","+rfctbl+","+rfctbl2+","+rfcp1+","+pMap+")");
				RfcCallFunction sapConn = new RfcCallFunction();
				returnList = sapConn.RfcCallTable(rfcfn, rfctbl, rfcp1, pMap, null);
				//log.debug("RFC RESULT : "+returnList);
				
				//rtnRst.put("TYPE", returnList.get(0).get("TYPE"));
				//rtnRst.put("MESSAGE", returnList.get(0).get("MESSAGE"));
			}
						
			// 통신 완료처리
			comFLG.put("COMSTAT", "R");
			
			commonDao.update(comFLG);
			
			// procedure 호출 - P_AIRWMS_IFWMS113_PROC
			DataMap param = new DataMap();

			if(ifid.equals("WMS_IF_316")) {
				// WMS_IF_316 생산투입정보(고지/펄프)			- SAP
				param.setModuleCommand("Erpif", "WMS_IF_220_316"); // 입고/출고 프로시저 동일호출
				param.put("P_INOUT_TYPE", "OUT"); // 입고 IN, 출고 OUT
				param.put("P_LOGSEQNO", logseqno);
				commonDao.getMap(param);
			} else if(ifid.equals("WMS_IF_305")) {
				// WMS_IF_305 생산투입불출정보					- EXCEL MES
				param.setModuleCommand("Erpif", "IFWMS113_PROD"); // 입고/출고 프로시저 동일호출
				param.put("IFID", ifid);
				param.put("LOGSEQNO", logseqno);
				param.put("result", "");
				param.put("SAPLOGSEQ", "");
				param.put("MESLOGSEQ", "");
				commonDao.getMap(param);
			} else if (ifid.equals("WMS_IF_303") || ifid.equals("WMS_IF_318") || 
					ifid.equals("WMS_IFC301") || ifid.equals("WMS_IFB301") || ifid.equals("WMS_IFS301") || 
					ifid.equals("WMS_IFC302") || ifid.equals("WMS_IFB302") || ifid.equals("WMS_IFS302")){
				// WMS_IF_301 출고예정정보(주문)-판매,수출,무상	- SAP : oracle 배치에서 처리 (2분주기) → 2024.07.03 실시간 변경 + oracle스케쥴러 (10분주기)
				// WMS_IF_302 출고예정정보(이송)				- SAP : oracle 배치에서 처리 (2분주기) → 2024.07.03 실시간 변경 + oracle스케쥴러 (10분주기)
				// WMS_IF_318 반품출고예정정보(자재,상품)		- SAP
				param.setModuleCommand("Erpif", "IFWMS113");
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				param.put("LOGSEQNO", logseqno);
				param.put("result", "");
				commonDao.getMap(param);

			} else if (false && ifid.equals("TMS_납품리스트")) {
				//CALL P_AIRWMS_IFWMS113_PROC 프로시져 복사하여 SHPDH, SHPDI 처리로직을 TMSSH (SHPDH), TMSSI (SHPDI) 처리 적용하기
				// TMSSH, TMSSI 인덱스 생성 검토하기
				param.setModuleCommand("Erpif", "IFTMS113");
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				param.put("LOGSEQNO", logseqno);
				param.put("result", "");
				//commonDao.getMap(param);

				
			} if (ifid.equals("WMS_IFZ301")) {
				// 출고오더 컨테이너, SEAL.NO 갱신 (SHPDH, SHPDI 갱신 X, 출고완료건의 경우 피킹상태로 변경발생)
				param.setModuleCommand("Erpif", "IFWMS113_IFZ301");
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				param.put("LOGSEQNO", logseqno);
				commonDao.update(param);
			}

			errMsg = param.get("result").toString();
			if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
			
			// 인터페이스 완료처리
			setFLG.put("ITFFLG", "C");
//			if(!ifid.equals("WMS_IF_316") && !ifid.equals("WMS_IF_305")) {
//				if(errMsg.equals("SUCCESS")) {
//					setFLG.put("PRCFLG", "C");
//				} else {
//					setFLG.put("PRCFLG", "E");
//					setFLG.put("PRCETX", errMsg);
//				}
//			}
			commonDao.update(setFLG);
		}
		
		return errMsg;
	}
	
	@Transactional
    public String receive_CANCEL_RESTFUL(DataMap map) throws SQLException{
      String errMsg = "SUCCESS";
      String ifid = map.get("IFID").toString();
      String logseqno = map.get("LOGSEQNO").toString();
      String taskky = map.get("TASKKY").toString();
       
      DataMap row = new DataMap();

      // 매핑컬럼 조회
      List<DataMap> mpcolList = new ArrayList<DataMap>();
      DataMap pcol = new DataMap();
      pcol.setModuleCommand("Erpif", "IFCOL"); //mapping 조회..
      pcol.put("IFID", ifid);
      mpcolList = commonDao.getList(pcol);

      try {
         List<DataMap> listx = map.getList("data");
         Map<String, Object> jod = new DataMap();
         
         for(int i=0; i < listx.size(); i++) {
            jod = listx.get(i).getMap("map");
           
            if (ifid.equals("WMS_IF_353C")) {
            	DataMap pMap = new DataMap();
    			DataMap logMap = new DataMap();

    			// 프로시저 호출
    			pMap.setModuleCommand("Erpif", "WMS_IF_353C");
    			pMap.put("WAREKY", taskky);
    			pMap.put("OWNRKY", taskky);
    			pMap.put("TASKKY", taskky);
    			pMap.put("SES_USER_ID", "WMS_IF_353C");
    			commonDao.getMap(pMap);
    			
    			if(pMap.get("result").equals("SUCCESS")) {
    				// 통신로그 수정
//    				logMap.put("COMSTAT", "R");
    				commonDao.update(logMap);
    			}
            }
         } 
      } catch (Exception e) {
         //log.debug("receive_IFWMS103_RESTFUL Error : " + e.getMessage());
         e.printStackTrace();
         errMsg = e.getMessage();
         try {
            if(errMsg != null && errMsg.length() > 200) { errMsg = errMsg.substring(0, 200); }
         }catch (Exception ex) {
            //log.debug("receive_IFWMS103_RESTFUL - errMsg.substring Error : " + ex.getMessage());
            ex.printStackTrace();
            errMsg = "errMsg.substring Error";
         }
      }
      
      //log.debug("receive_IFWMS103_RESTFUL.errMsg : " + errMsg);
      
      // 통신,인터페이스 FLAG 셋팅
      DataMap comFLG  = new DataMap();
      comFLG.setModuleCommand("Erpif", "IFWMSLOG");
      comFLG.put("IFID", ifid);
      comFLG.put("SEQNO", logseqno);
      DataMap setFLG  = new DataMap();
      setFLG.setModuleCommand("Erpif", "IFWMS103_FLG");
      setFLG.put("IFID", ifid);
      setFLG.put("LOGSEQNO", logseqno);
      
      if(!errMsg.equals("SUCCESS")){
         // 통신 에러처리
         comFLG.put("COMSTAT", "E");
         comFLG.put("ERRTXT", errMsg);
         commonDao.update(comFLG);
         // 인터페이스 에러처리
         setFLG.put("ITFFLG", "E");
         setFLG.put("ITFETX", errMsg);
         setFLG.put("PRCFLG", "E");
         setFLG.put("PRCETX", errMsg);
         commonDao.update(setFLG);
      } else {
         // 통신 수신완료 처리
         comFLG.put("COMSTAT", "R");
         commonDao.update(comFLG);
         // 인터페이스 완료처리
         setFLG.put("ITFFLG", "C");
         setFLG.put("PRCFLG", "C");
         commonDao.update(setFLG );
      }
      
      return errMsg;
    }	

	@Transactional
	public String dataInsertIF(DataMap map) throws SQLException{
		String ifid = map.getString("IFID");
		String data = null;
		
		if        (ifid.equals("WMS_IF_208") // 입고실적정보(자재)-품질검사대상
				|| ifid.equals("WMS_IF_210") // 입고실적정보(수입자재)-품질검사대상
				|| ifid.equals("WMS_IF_212") // 반품입고실적정보-품질검사대상
				  ) { 
			// 품질검사대상 등록
			data = insert_IFWMS209(map);
		} else if (ifid.equals("WMS_IF_214") // 입고실적정보(자재,상품)
				|| ifid.equals("WMS_IF_215") // 입고실적정보(수입자재,수입상품)
				|| ifid.equals("WMS_IF_216") // 입고실적정보(이송)
				|| ifid.equals("WMS_IF_2161") // 입고실적정보(임가공)
				|| ifid.equals("WMS_IF_222") // 입고실적정보(제품) MES
				|| ifid.equals("WMS_IF_221") // 입고실적정보(제품) SAP
				|| ifid.equals("WMS_IF_217") // 반품입고실적정보 SAP
				|| ifid.equals("WMS_IF_218") // 반납입고실적정보 MES
				|| ifid.equals("WMS_IF_224") // 반납입고실적정보(자재)
				|| ifid.equals("WMS_IF_219") // 재고조정입고
				  ) {
			// 입고실적 등록
			data = insert_IFWMS203(map);
		} else if (ifid.equals("WMS_IF_317") // 생산투입불출실적정보
				|| ifid.equals("WMS_IF_307") // 출고실적정보(주문)
				|| ifid.equals("WMS_IF_308") // 출고실적정보(이송)
				|| ifid.equals("WMS_IF_309") // 자재불출실적정보 mes
				|| ifid.equals("WMS_IF_320") // 자재불출실적정보 sap
				|| ifid.equals("WMS_IF_310") // 즉시불출실적정보 mes
				|| ifid.equals("WMS_IF_321") // 즉시불출실적정보 sap
				|| ifid.equals("WMS_IF_311") // 반품출고실적정보(자재,상품)
				|| ifid.equals("WMS_IF_313") // 폐기출고실적정보 TASDH
				|| ifid.equals("WMS_IF_314") // 재고조정출고 TASDH
				|| ifid.equals("WMS_IF_315") // 무상출고실적정보
				|| ifid.equals("WMS_IF_322") // 생산직불출실적정보 mes
				|| ifid.equals("WMS_IF_323") // 생산직불출실적정보 sap TASDH
				|| ifid.equals("WMS_IF_324") // 생산투입불출실적정보-MES
				|| ifid.equals("WMS_IF_780") // 팔레트출고실적-SAP
				|| ifid.equals("WMS_IF_CARNO") // 차량번호갱신-SAP
				  ) {
			// 출고실적 등록
			data = insert_IFWMS213(map);
		} else if (
				//   ifid.equals("WMS_IF_401") // 재고상태변경정보
				//|| ifid.equals("WMS_IF_402") // MTO/MTS변경정보
				ifid.equals("WMS_IF_402") // MTO/MTS변경정보
				|| ifid.equals("WMS_IF_403") // 제조LOT변경정보
				|| ifid.equals("WMS_IF_404") // 저장위치변경정보
				|| ifid.equals("WMS_IF_405") // 품목코드 변경 (MTM)
				  ) {
			// 재고조정내역 등록
			data = insert_IFWMS223(map);
		}else if(ifid.equals("WMS_IF_401")) // 재고상태변경정보 240125 402 유형 분리
		{
			data = insert_IFWMS223_402(map);
		}
		
		return data;
	}

	@Transactional
	public String sendIF(DataMap map) throws SQLException{
		String ifid = map.getString("IFID");
		String logseqno = map.getString("LOGSEQNO");
		String retryYN  = map.getString("RETRYYN");
		String data = "5회 이상 전송시도로 재전송처리가 불가합니다.";

		// LOG 호출등록
		DataMap logMap = new DataMap();
		logMap.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
		logMap.put("IFID", ifid);
		logMap.put("COMSTAT", "C");
		logMap.put("SEQNO", logseqno);
		logMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		if(!"Y".equals(retryYN)) {
			commonDao.insert(logMap);
		} else {
			commonDao.update(logMap);
		}
		
		String TABLE = "";
		if        (ifid.equals("WMS_IF_208") // 입고실적정보(자재)-품질검사대상
				|| ifid.equals("WMS_IF_210") // 입고실적정보(수입자재)-품질검사대상
				|| ifid.equals("WMS_IF_212") // 반품입고실적정보-품질검사대상
				  ) { 
			TABLE = "IFWMS209";
		} else if (ifid.equals("WMS_IF_214") // 입고실적정보(자재,상품)
				|| ifid.equals("WMS_IF_215") // 입고실적정보(수입자재,수입상품)
				|| ifid.equals("WMS_IF_216") // 입고실적정보(이송)
				|| ifid.equals("WMS_IF_2161") // 입고실적정보(임가공)
				|| ifid.equals("WMS_IF_222") // 입고실적정보(제품) MES
				|| ifid.equals("WMS_IF_221") // 입고실적정보(제품) SAP
				|| ifid.equals("WMS_IF_217") // 반품입고실적정보 SAP
				|| ifid.equals("WMS_IF_218") // 반납입고실적정보 MES
				|| ifid.equals("WMS_IF_224") // 반납입고실적정보(자재)
				|| ifid.equals("WMS_IF_219") // 재고조정입고
				  ) {
			TABLE = "IFWMS203";
		} else if (ifid.equals("WMS_IF_317") // 생산투입불출실적정보
				|| ifid.equals("WMS_IF_307") // 출고실적정보(주문)
				|| ifid.equals("WMS_IF_308") // 출고실적정보(이송)
				|| ifid.equals("WMS_IF_309") // 자재불출실적정보 mes
				|| ifid.equals("WMS_IF_320") // 자재불출실적정보 sap
				|| ifid.equals("WMS_IF_310") // 즉시불출실적정보 mes
				|| ifid.equals("WMS_IF_321") // 즉시불출실적정보 sap
				|| ifid.equals("WMS_IF_311") // 반품출고실적정보(자재,상품)
				|| ifid.equals("WMS_IF_313") // 폐기출고실적정보
				|| ifid.equals("WMS_IF_314") // 재고조정출고
				|| ifid.equals("WMS_IF_315") // 무상출고실적정보
				|| ifid.equals("WMS_IF_322") // 생산직불출실적정보 mes
				|| ifid.equals("WMS_IF_324") // 생산투입불출실적정보-MES
				|| ifid.equals("WMS_IF_780") // 팔레트출고실적-SAP
				|| ifid.equals("WMS_IF_CARNO") // 차량번호갱신-SAP
				  ) { 
			TABLE = "IFWMS213";
		} else if (ifid.equals("WMS_IF_401") // 재고상태변경정보
				|| ifid.equals("WMS_IF_402") // MTO/MTS변경정보
				|| ifid.equals("WMS_IF_403") // 제조LOT변경정보
				|| ifid.equals("WMS_IF_404") // 저장위치변경정보
				|| ifid.equals("WMS_IF_405") // 품목코드 변경 (MTM)
				|| ifid.equals("WMS_IF_209213") // 209213
				  ) {
			TABLE = "IFWMS223";
		} else {
			data = "존재하지 않는 IFID입니다.";
		}
		
		int UDTRST = "Y".equals(retryYN) ? 0 : 1; // 재전송 여부에 따라 값 세팅
		if (UDTRST == 0) {
			/* 재전송인 경우 ITFCNT + 1 */
			logMap.setModuleCommand("Erpif", "RETRY_FLG");
			logMap.put("TBL", TABLE);
			UDTRST = commonDao.update(logMap); // 0인 경우 재전송 대상 없음.
		}
		
		if (UDTRST > 0) { // 재전송이 아니거나 재전송 대상이 있는 경우
			     if ("IFWMS209".equals(TABLE)) { data = send_IFWMS209(map); } // 품질검사대상 전송
			else if ("IFWMS203".equals(TABLE)) { 
				
				if(ifid.equals("WMS_IF_215")) {
					data = send_IFWMS_HEADITEM(map); // 입고 실적
				} else {
					data = send_IFWMS203(map);
				}
			} // 입고실적 전송
			else if ("IFWMS213".equals(TABLE)) {
				if(ifid.equals("WMS_IF_311")) {
					data = send_IFWMS_HEADITEM(map); // 반품출고 실적
				} else {
					data = send_IFWMS213(map); //receive Error Message
				}
			} // 출고실적 전송
			else if ("IFWMS223".equals(TABLE)) {
				data = send_IFWMS223(map);
			} // 재고조정내역 전송
		}

		// LOG 결과처리
		logMap.setModuleCommand("Erpif", "IFWMSLOG");
		if(data.equals("SUCCESS")) {
			logMap.put("COMSTAT", "S");
		} else {
			logMap.put("COMSTAT", "E");
			logMap.put("ERRTXT", data);
		}
		commonDao.update(logMap);
		
		return data;
	}
	
	@Transactional
	public String insert_IFWMS209(DataMap map) throws SQLException{
		// WMS_IF_208 입고실적정보(자재)-품질검사대상
		// WMS_IF_210 입고실적정보(수입자재)-품질검사대상
		// WMS_IF_212 반품입고실적정보-품질검사대상
		List<DataMap> list = map.getList("list");
		String errMsg = "SUCCESS";
		
		// RECVKY문서번호 기준으로 RECDI에서 품질검사대상만 SELECT INSERT 처리
		DataMap row = new DataMap();
		for(int i = 0 ; i < list.size() ; i ++){
			row = list.get(i).getMap("map");
			row.put("IFID", map.get("IFID"));
			row.put("LOGSEQNO", map.get("LOGSEQNO"));
			row.put("OWNRKY", map.get("ownrky"));
			row.setModuleCommand("Erpif", "IFWMS209");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			commonDao.insert(row);
		}
		
		// 처리결과
		if(!errMsg.equals("SUCCESS")){
			throw new RuntimeException("[ROLLBACK]\n" + errMsg);
		}
		
		return errMsg;
	}

	@Transactional
	public String send_IFWMS209(DataMap map) throws SQLException{
		// WMS_IF_208 입고실적정보(자재)-품질검사대상
		// WMS_IF_210 입고실적정보(수입자재)-품질검사대상
		// WMS_IF_212 반품입고실적정보-품질검사대상
		String errMsg = "SUCCESS";
		String ifid = map.getString("IFID");
		String logseqno = map.getString("LOGSEQNO");
		
		List<DataMap> if209List = new ArrayList<DataMap>();
		DataMap row = new DataMap();
		row.setModuleCommand("Erpif", "IFWMS209");
		row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		row.put("IFID", ifid);
		row.put("LOGSEQNO", logseqno);
		if209List = commonDao.getList(row); 
		
		if(if209List == null || if209List.size() == 0){
			errMsg="전송할 데이터가 없습니다. "+ifid;
			return errMsg;
		}

		// 매핑컬럼 조회
		List<DataMap> mpcolList = new ArrayList<DataMap>();
		DataMap pcol = new DataMap();
		pcol.setModuleCommand("Erpif", "IFCOL");
		pcol.put("IFID", ifid);
		mpcolList = commonDao.getList(pcol);
		
		PostRequest postRequest = new PostRequest();
		JSONArray jarr = new JSONArray();
		JSONObject jobj = new JSONObject();
		JSONObject jsend = new JSONObject();

		DataMap smap = new DataMap();
		for(int i=0; i < if209List.size(); i++) {
			smap = if209List.get(i);
			
			jobj = new JSONObject();
			
			if (ifid.equals("WMS_IF_208") || ifid.equals("WMS_IF_210") || ifid.equals("WMS_IF_212")) {
				// WMS_IF_208 입고실적정보(자재)-품질검사대상
				// WMS_IF_210 입고실적정보(수입자재)-품질검사대상
				// WMS_IF_212 반품입고실적정보-품질검사대상
				for(int icol=0; icol < mpcolList.size(); icol++) {
					if(mpcolList.get(icol).get("IFAT").toString().equals("V")) {
						if(mpcolList.get(icol).get("SOURCE").toString().indexOf(",") > -1) {
							String commaStr = mpcolList.get(icol).get("SOURCE").toString();
							String[] commaStrList = commaStr.split(",");
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(commaStrList[0]).toString() + smap.get(commaStrList[1]).toString());
						} else {
							jobj.put(mpcolList.get(icol).get("TARGET"),smap.get(mpcolList.get(icol).get("SOURCE")));
						}
					}
				}
				// 테스트 end
			} else {
				jobj.put("EBELN", smap.get("EBELN"));
				jobj.put("EBELP", smap.get("EBELP"));
				jobj.put("LIFNR", smap.get("LIFNR"));
				jobj.put("BWART", smap.get("BWART"));
				jobj.put("MATNR", smap.get("MATNR"));
				jobj.put("MENGE", smap.get("MENGE"));
				jobj.put("MEINS", smap.get("MEINS"));
				jobj.put("WERKS", smap.get("WERKS"));
				jobj.put("VGBEL", smap.get("VGBEL"));
				jobj.put("VGPOS", smap.get("VGPOS"));
				jobj.put("WAREKY", smap.get("WAREKY"));
				jobj.put("SKUKEY", smap.get("SKUKEY"));
				jobj.put("ORDCAT", smap.get("ORDCAT"));
				jobj.put("STOKKY", smap.get("STOKKY"));
				jobj.put("LOTA01", smap.get("LOTA01"));
				jobj.put("LOTA02", smap.get("LOTA02"));
				jobj.put("LOTA03", smap.get("LOTA03"));
				jobj.put("LOTA04", smap.get("LOTA04"));
				jobj.put("LOTA05", smap.get("LOTA05"));
				jobj.put("LOTA06", smap.get("LOTA06"));
				jobj.put("LOTA07", smap.get("LOTA07"));
				jobj.put("LOTA08", smap.get("LOTA08"));
				jobj.put("LOTA09", smap.get("LOTA09"));
				jobj.put("LOTA10", smap.get("LOTA10"));
				jobj.put("LOTA11", smap.get("LOTA11"));
				jobj.put("LOTA12", smap.get("LOTA12"));
				jobj.put("LOTA13", smap.get("LOTA13"));
				jobj.put("LOTA14", smap.get("LOTA14"));
				jobj.put("LOTA15", smap.get("LOTA15"));
				jobj.put("LOTA16", smap.get("LOTA16"));
				jobj.put("LOTA17", smap.get("LOTA17"));
				jobj.put("LOTA18", smap.get("LOTA18"));
				jobj.put("LOTA19", smap.get("LOTA19"));
				jobj.put("LOTA20", smap.get("LOTA20"));
			}

			jarr.add(jobj);
		}

		jsend.put("list", jarr);

		// 데이터 전송
		// MES, PTL : RESTFUL
		// SAP : RFC
		DataMap rd = new DataMap();
		DataMap rfcinfo = new DataMap();
		DataMap rfcrst = new DataMap();
		rfcinfo.setModuleCommand("Erpif", "RFCINFO");
		rfcinfo.put("IFID", ifid);
		rfcrst = commonDao.getMap(rfcinfo); 
		
		String rfcfn = rfcrst.get("RFCFN").toString();

		// 데이터 전송
		try {
			//log.debug("\n send : " + jsend);
			rd = postRequest.jsonPost(rfcfn, jsend.toJSONString());
			//log.debug("\n result : " + rd);
		} catch (Exception e) {
			errMsg = e.getMessage();
			if (errMsg != null && errMsg.length() > 200) {
				errMsg = errMsg.substring(0, 200);
				rd.put("result", errMsg.substring(0, 200));
			} else {
				rd.put("result", errMsg);
			}
		}

		// 전송결과
		row = new DataMap();
		row.setModuleCommand("Erpif", "IFWMS209_FLG");
		row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		row.put("IFID", ifid);
		row.put("LOGSEQNO", logseqno);

		if(rd.get("result").equals("SUCCESS")) {
			row.put("PRCFLG", "C");
		} else {
			row.put("PRCFLG", "E");
			row.put("PRCETX", rd.get("result"));
		}

		commonDao.update(row); 
		
		errMsg = rd.get("result").toString();
		
		return errMsg;
	}
	
