	            //rsMap = inboundService.saveGr02New_X(param);	// WMS 자체입고처리

	            //log.debug("▶ [입고처리 결과]");
	            //log.debug(rsMap);

	            if (rsMap == null || !"S".equals(rsMap.get("ifRsCode"))) {
	                //throw new SQLException("입고처리 실패: " + (rsMap != null ? rsMap.toString() : "결과 NULL"));
