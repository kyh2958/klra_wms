			DataMap rtnRst = new DataMap();
			if(!isExcelUpload.equals("EXCEL")) {
				// 처리결과 송신제외 - 품목정보에서 처리하기때문에 여기서는 제외함 
				// 수신완료 R호출 패스
				
				rtnRst.put("TYPE", "S");
				rtnRst.put("MESSAGE", "");
