				// 프로시저 호출전 I 변경
				setFLG.put("PRCFLG", "I");
				commonDao.update(setFLG);
				
				// procedure 호출 (MEASH, MEASI 처리), 프로시저내에서 작업완료후 플래그 완료처리
				DataMap procMap = new DataMap();
				procMap.setModuleCommand("Erpif", "IFWMS005");
				procMap.put("IFID", ifid);
				procMap.put("LOGSEQNO", logseqno);
				procMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				procMap.put("result", "");
				commonDao.getMap(procMap);
