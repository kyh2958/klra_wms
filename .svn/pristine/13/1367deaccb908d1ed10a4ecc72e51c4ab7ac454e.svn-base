<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%
	String BARCOD = request.getParameter("BARCOD");
%>
<!doctype html>
<head>
<style type="text/css">
button{ vertical-align: bottom; height: 37px; }
input:read-only{ background-color: #e2e2e2; }
select:DISABLED{ background-color: #e2e2e2; }
.tem5_content .tableWrap_search{ overflow: hidden; }
</style>
<meta charset="utf-8">
<meta name="viewport" content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width, target-densitydpi=medium-dpi" />
<meta name="format-detection" content="telephone=no" />
<title>WMS</title>
<%@ include file="/mobile/include/head.jsp" %>
<script>

var ymd = new Date();
	ymd.setDate(ymd.getDate() - 31)
var year = ymd.getFullYear();
var month = ("0"+(ymd.getMonth()+1)).slice(-2);
var date = ("0"+ymd.getDate()).slice(-2);


	$(document).ready(function () {
		init();
		
		// 재고실사 일자조건 변경 (= → >=)
		$("#DOCDAT").val(year + "." + month + "." + date);
		
		gridList.setGrid({
			id             : "gridList",
			module         : "WmsInventory",
			command        : "PDPC01_DOC",
			gridMobileType : true,
			editable       : false
		});
		
		searchList();
	})
	
	var selectedRowNum = 0;
	
	function init() {
		selectedRowNum = 0;
	}
	
	function searchList() {
		var param = inputList.setRangeParam("searchArea");
		param.put('WAREKY', '<%=wareky%>');
		
		gridList.resetGrid('gridList');
		
		gridList.gridList({
			id : "gridList",
			param : param
		});
	}
	
	// 더블클릭 이벤트
	function gridListEventRowDblclick(gridId, rowNum) {
		var data = gridList.getRowData("gridList", rowNum);
		callback(data);
	}
	
	// 선택버튼 클릭 이벤트
	function onClickChooseBtn() {
		var data = gridList.getRowData("gridList", selectedRowNum);
		callback(data);
	}
	
	// 그리드 클릭 시 rowNum 변수 저장
	function gridListEventRowClick(gridId, rowNum) {
		selectedRowNum = rowNum;
	}
	
	function callback (data) {
		if(!data.isEmpty()) {
			data.put('param', mobile.getLinkPopData());
			// GRowState, GRowNum 미삭제 시 appendJson 호출 시 데이터 바인딩 이상하게 됨.
			data.remove("GRowState");
			data.remove("GRowNum");
			window.opener.DocPopCallback(data);
			self.close();
		}
	}
	
	function fn_onfocus(objId){
		$("#"+objId).select();
	}
</script>
</head>
<body>
	<div id="menu-container">
		<div class="menu-item"></div>
	</div>
	<div class="main_wrap" id="paramArea">
		<div class="tem4_content">
			<div class="select_box" id="searchArea">
				<table>
					<tbody>
						<tr>
							<th CL='STD_PHYDAT'>재고조사일자</th>
							<td>
								<input type="text" class="text" name="DOCDAT" id="DOCDAT" UIFormat="C N" onchange="searchList()" onfocus="fn_onfocus(this.id)" style="text-align: center; width: 80%;"/>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="tableWrap_search section">
				<div class="tableHeader">
					<table style="width: 100%">
						<colgroup>
							<col width="80px" />
							<col width="80px" />
							<col width="50px" />
							<col width="160px" />
						</colgroup>
						<thead>
							<tr class="thead">
								<th CL='STD_PHYIKY'>재고실사번호</th>
								<th CL='STD_PHYDAT'>지시일자</th>
								<th CL='STD_INDDCL'>완료여부</th>
								<th CL='STD_DOCTXT'>문서명</th>
							</tr>
						</thead>
					</table>
				</div>
				<div class="tableBody">
					<table style="width: 100%">
						<colgroup>
							<col width="80px" />
							<col width="80px" />
							<col width="50px" />
							<col width="160px" />
						</colgroup>
						<tbody id="gridList">
							<tr CGRow="true">
								<td GCol="text,PHYIKY"></td>
 								<td GCol="text,DOCDAT"></td>
 								<td GCol="text,INDDCL"></td>
 								<td GCol="text,DOCTXT"></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			<!-- end table_body -->
			<div class="footer_5" style="position:fixed;">
				<table>
					<tr>
						<td class=f_1 width="50%" onclick="self.close()">
							<label CL='BTN_CLOSE'></label>
						</td>
						<td class=f_1 width="50%" onclick ="onClickChooseBtn()" >
							<label CL='BTN_CHOOSE'></label>
						</td>
					</tr>
				</table>
			</div>
			<!-- end footer_5 -->
		</div>
	</div>
</body>