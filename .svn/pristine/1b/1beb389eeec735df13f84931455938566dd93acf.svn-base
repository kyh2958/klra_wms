	@Transactional
	public DataMap PDPK05StockValidation(DataMap map) throws SQLException {
				
        
		List<DataMap> head = map.getList("head");		
		List<DataMap> saveItemList = new ArrayList<DataMap>();
		List<DataMap> shpdiInfoList = new ArrayList<DataMap>();
		DataMap rsMap = new DataMap();
		
		map.setModuleCommand("WmsMobileOutboundPicking", "PDPK05StockValidation");
		saveItemList = commonDao.getList(map);
		
		if(saveItemList.size() <=0){
			rsMap.put("MSG", "OUT_M0235"); //가용수량이 존재하지 않습니다.
			return rsMap;
		}
			
		
		SimpleDateFormat fmDate = new SimpleDateFormat("yyyyMMdd", Locale.KOREA);
		String date = fmDate.format(new Date());
		SimpleDateFormat fmTime = new SimpleDateFormat("HHmmss", Locale.KOREA);
		String time = fmTime.format(new Date());	
		
		String svbeln = "";
		String sposnr = "";
		String stknum = "";
		String stpnum = "";
		String ssornu = "";
		String ssorit = "";		
		String shpmty = "";
						
		
		int taskit;		
		
		String shpoky = map.getString("SHPOKY");		
		String taskky = map.getString("TASKKY");
		String locasr = map.getString("LOCASR");
		String SAMETYPE = map.getString("SAMETYPE");
		
		int a=0;
		
		double totqttaor = Double.parseDouble(map.getString("TOTQTTAOR").replace(",", ""));
		double totalcomp = Double.parseDouble(map.getString("TOTQTCOMP").replace(",", ""));
		
		double qtsput= 0;
		
		
		String minusQtyStr = String.format("%.3f", (totqttaor - totalcomp));
	    
		
	    double minusQty = Double.parseDouble(minusQtyStr);
	      
		//double plusQty = Double.parseDouble(saveItemList.get(0).getString("P_QTY"));
		
		//BigDecimal totqty = new BigDecimal(totqttaor - totalcomp);
		
	    //할당된 출하정보 조회 
	    map.setModuleCommand("WmsMobileOutboundPicking", "PDPK05_SHPDI_INFO");
		shpdiInfoList = commonDao.getList(map);
		
		for(DataMap validMap : shpdiInfoList) {						
			
			//DataMap rsValidMap = new DataMap();
			List<DataMap> rsValidList;
			
			//할당된 주문의 제조일자와 바코드 스캔한 재고의 제조일자와 비교
			if(map.getString("ETCLOTA14").isEmpty() || !map.getString("ETCLOTA14").equals("Y")) {
				validMap.setModuleCommand("WmsMobileOutboundPicking", "PDPK05StockLota11Validation");
				rsValidList = commonDao.getList(validMap);
			}else {
				validMap.setModuleCommand("WmsMobileOutboundPicking", "PDPK05StockEtcLota11Validation");
				validMap.put("BARCOD", map.getString("BARCOD"));
				rsValidList = commonDao.getList(validMap);
			}
			
			
			for(DataMap rsValidMap : rsValidList) {
				if(rsValidMap.getString("CHECK_LOTA11").equals("N")) {
					
					rsMap.put("MSG", "OUT_M0242"); //출고할 제조일자와 맞지 않습니다.			
					return rsMap;
				}
			}
			
		}
		
		
		if(saveItemList.size() > 0 && SAMETYPE.equals("Y")) {
			return saveItemList.get(0);
		}else {
				
			
			  
			  for(int d = 0; d < saveItemList.size(); d++) {
				  
			  qtsput = Double.parseDouble(saveItemList.get(d).getString("QTSPUT"));
			  
			  String plusQtyStr = String.format("%.3f", (totalcomp + qtsput)); 
			  double  plusQty = Double.parseDouble(plusQtyStr);			  			 
			  
			  if(minusQty <= 0) {
				  continue;
			  }
			  
			  //피킹수량 체크 
			  if(minusQty > qtsput) {
				  
				  totalcomp = qtsput;
				  saveItemList.get(d).put("QTSPUT", totalcomp);
			  }else { 
				  
				  qtsput = minusQty;
				  saveItemList.get(d).put("QTSPUT", qtsput);
			  }
			  
			  saveItemList.get(d).put("QTCOMP", qtsput);
			  
			  
			  if(totalcomp > totqttaor) {
				  rsMap.put("MSG", "MOBILE_M0041");
				  return rsMap; 
			  }
			  
			  
			  map.put("SAMETYPE", "N");
			  
			  map.setModuleCommand("WmsOutbound", "SEARCHSHPDH"); 
			  DataMap shpdhMap = commonDao.getMap(map); 
			  			  
			  map.setModuleCommand("WmsOutbound", "SEARCHSHPDI");
			  DataMap shpdiMap = commonDao.getMap(map);
			  
			  String shpoit = shpdiMap.getString("SHPOIT");
			  
			  svbeln = shpdiMap.getString("SVBELN"); sposnr = shpdiMap.getString("SPOSNR");
			  stknum = shpdiMap.getString("STKNUM"); stpnum = shpdiMap.getString("STPNUM");
			  ssornu = shpdiMap.getString("SSORNU"); ssorit = shpdiMap.getString("SSORIT");
			  shpmty = shpdhMap.getString("SHPMTY");
			  
			  
			  // 재고 셀렉트 
			  map.setModuleCommand("WmsOutbound","MANUALALLOCATE_AVAILABLE_STOCK");
			  
			  map.put("SHPMTY", shpdhMap.get("SHPMTY"));
			  
			  map.put("BARCOD", saveItemList.get(d).get("LOTA14")); 
			  map.put("OWNRKY", saveItemList.get(d).get("OWNRKY")); 
			  map.put("WAREKY", saveItemList.get(d).get("WAREKY")); 
			  map.put("AREAKY", saveItemList.get(d).get("AREAKY"));
			  map.put("LOCAKY", saveItemList.get(d).get("LOCAKY"));
			  map.put("SKUKEY", saveItemList.get(d).get("SKUKEY"));
			  map.put("TRNUID", saveItemList.get(d).get("TRNUID"));
			  map.put("PACKID", saveItemList.get(d).get("PACKID"));
			  map.put("LOTNUM", saveItemList.get(d).get("LOTNUM"));			  
			  map.put("STOKKY", saveItemList.get(d).get("STOKKY"));
			  			  			  
			  
			  List<DataMap> stockMapList = commonDao.getList(map);
			  
			  
			  map.setModuleCommand("WmsOutbound", "SEARCHMAXTASDH");
			  
			  map.put("WAREKY", saveItemList.get(d).getString("WAREKY"));
			  
			  List<DataMap> tasdhList = commonDao.getList(map);
			  
			  taskit = Integer.parseInt(tasdhList.get(0).getString("TASKIT"));
			  
			  taskit += 10;
			  
			  saveItemList.get(d).put("TASKKY", taskky); 
			  saveItemList.get(d).put("TASKIT", leftPad((taskit)+"", "0", 6));
			  saveItemList.get(d).put("SHPOKY", shpoky);
			  saveItemList.get(d).put("SHPOIT", shpoit);
			  
			  
			  map.put("TASKKY", taskky); 
			  map.put("TASKIT", leftPad((taskit)+"", "0", 6));
			  map.put("TASKTY", "PK"); 
			  map.put("RSNCOD", "330"); 
			  map.put("STATIT", "NEW");
