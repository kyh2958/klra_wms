	@Transactional
	public DataMap PDLD21SaveEnd(DataMap map) throws SQLException {
		List<DataMap> head = map.getList("head");
		DataMap itemRow;
		DataMap row;		
		List shpokyList = new ArrayList();
		DataMap validMap = new DataMap();		
		DataMap totalQtyMap = new DataMap();
		int validationCount = 0;
		
		DataMap rsRowMap = new DataMap();
		DataMap rsMap = new DataMap();
		DataMap rqMap = new DataMap();
		
		int count=0;
		
		for(int i = 0 ; i < head.size() ; i ++){
			itemRow = head.get(i).getMap("map");
			
			itemRow.put("WAREKY", map.getString("WAREKY"));
			itemRow.put("OWNRKY", map.getString("OWNRKY"));
			itemRow.put("PLNTKY", map.getString("PLNTKY"));
			
			if(itemRow.get("FCKCOM").equals("V")){
				continue;
			}
			
			String shpokyNum = head.get(i).getMap("map").getString("SHPOKY");			
			
			if( !shpokyNum.isEmpty() && !shpokyNum.equals("")) {
					
					//SHPDH I/F CHECK 
					for(int j=0;j<head.size();j++){
							rsRowMap = head.get(j).getMap("map");
							rsRowMap.put("SHOPKY", shpokyNum);
							
							rsMap.setModuleCommand("WmsTask", "VALIDATION_SHPDH");
							rsMap.put("SHPOKY", rsRowMap.get("SHPOKY"));
							rqMap = commonDao.getMap(rsMap);
							
							if(rsRowMap.get("FCKCOM").equals("V")){
								continue;
							}
							
							if(rqMap != null && !rqMap.getString("SHPOKY").equals(" ")) {
								rsMap.put("SHPOKY", rqMap.getString("SHPOKY"));
								
								return rsMap;
							}
							
					}
					
					//validation					
					validMap = commonDao.getMap("WmsMobileOutboundPicking.PDLD21Validation1", itemRow);
					
					String validMsg = validMap.getString("MSG");
					
					if("OK".equals(validMsg)){
						
						itemRow.put("QTSHPC", Double.parseDouble((String)itemRow.get("QTCOMP")));
						itemRow.put("LSTTFL", "V");
						itemRow.put(CommonConfig.SES_USER_ID_KEY,	map.get(CommonConfig.SES_USER_ID_KEY));
						itemRow.put("PLNTKY",	map.getString("PLNTKY"));
						itemRow.put("SES_MTYPE",	map.getString("SES_MTYPE"));
								
						commonDao.update("WmsMobileOutboundPicking.PDLD21Sub", itemRow);
														
						totalQtyMap = commonDao.getMap("WmsMobileOutboundPicking.TOTAL_QTCOMP", itemRow);
						itemRow.put("QTSHPC", totalQtyMap.get("QTCOMP"));
						commonDao.update("WmsOutbound.DL05Sub", itemRow);
						
						rsMap.put("MSG", validMsg);
						
						count++;
						
					}else{
						rsMap.put("MSG", validMsg);
						validationCount++;
						break;
					}
			
			
			}else {
				
				List<DataMap> selectList = new ArrayList<>();
				itemRow.put("SES_MTYPE",	map.getString("SES_MTYPE"));
				//SHPDH, SHPDI SELECT				
				itemRow.setModuleCommand("WmsMobileOutboundPicking", "PDLD21SUB");
				selectList = commonDao.getList(itemRow);
				
				//SHPDH I/F CHECK 
				for(int j=0;j<selectList.size();j++){
						rsRowMap = selectList.get(j).getMap("map");
						rsMap.setModuleCommand("WmsTask", "VALIDATION_SHPDH");
						rsMap.put("SHPOKY", rsRowMap.get("SHPOKY"));
						rqMap = commonDao.getMap(rsMap);
						
						if(rsRowMap.get("FCKCOM").equals("V")){
							continue;
						}
						
						if(rqMap != null && !rqMap.getString("SHPOKY").equals(" ")) {
							rsMap.put("SHPOKY", rqMap.getString("SHPOKY"));
							
							return rsMap;
						}
						
				}
					
				
				for(int j=0; j < selectList.size(); j++){
					
					row =selectList.get(j);
					
					//validation
					row.put("WAREKY", map.getString("WAREKY"));
					row.put("OWNRKY", map.getString("OWNRKY"));
					row.put("PLNTKY", map.getString("PLNTKY"));
					validMap = commonDao.getMap("WmsMobileOutboundPicking.PDLD21Validation1", itemRow);
					
					String validMsg = validMap.getString("MSG");
					
					if("OK".equals(validMsg)) {
												
						row.put("LSTTFL", "V");
						row.put(CommonConfig.SES_USER_WHAREHOUSE_KEY, map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY));
						row.put(CommonConfig.SES_USER_ID_KEY, 		  map.get(CommonConfig.SES_USER_ID_KEY));
						row.put("SES_MTYPE",	map.getString("SES_MTYPE"));

						commonDao.update("WmsMobileOutboundPicking.PDLD21Sub", row);
						
						totalQtyMap = commonDao.getMap("WmsMobileOutboundPicking.TOTAL_QTCOMP", row);
						row.put("QTSHPC", Double.parseDouble((String)totalQtyMap.get("QTCOMP")));
						
						commonDao.update("WmsOutbound.DL05Sub", row);
						
						count++;
						
					}else{
						rsMap.put("MSG", validMsg);
						validationCount++;
						break;
					}
				
				}
				
			}
					
			StringBuilder sb = new StringBuilder();
			
			for(int k = 0 ; k < shpokyList.size() ; k ++){
				if(k != 0){
					sb.append(",");
				}
				sb.append("'").append(shpokyList.get(k)).append("'");
			}
			
			rsMap.put("SHPOKY", sb.toString());
			rsMap.put("CNT", count);
			
		}

		return rsMap;
	}
	
	//@Transactional(rollbackFor = Exception.class)
	public DataMap savePDTK10(DataMap map) throws SQLException {	
		
		
        
		List<DataMap> list = map.getList("list");
		
		DataMap rsMap = new DataMap();		
		DataMap head = new DataMap();
		DataMap ptnMap = new DataMap();
		
		String MSG = "OK";
		int count = 1;
		
		DataMap row;
		DataMap headRow;
		
		String snum;
		String inum;
		
		SimpleDateFormat fmDate = new SimpleDateFormat("yyyyMMdd", Locale.KOREA);
		String date = fmDate.format(new Date());
		SimpleDateFormat fmTime = new SimpleDateFormat("HHmmss", Locale.KOREA);
		String time = fmTime.format(new Date());	
		
				
		
		List<DataMap> selectList = new ArrayList<>();
		
		
		List gridRowNumList = new ArrayList<>();
		
		head.setModuleCommand("WmsMobileOutboundPicking", "PDTK10");		
		head.put("PROGID", map.getString("PROGID"));
		head.put("WAREKY", map.getString("WAREKY"));
		head.put("OWNRKY", map.getString("OWNRKY"));
		head.put("LANGKY", map.getString("LANGKY"));
		
		
		selectList = commonDao.getList(head);		//헤더문서 조회
		headRow = selectList.get(0).getMap("map");
		
		
		
		for(int i=0;i<list.size();i++){
			
			TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
	        TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
	        
			int itemCount = 0;
			
			row = list.get(i).getMap("map");
			
			int gridRowNum = row.getInt("GRowNum");
			
			if(row.getString("GRowState").equals("D")) {
				continue;
			}
			
			head.setModuleCommand("WmsTask", "NUMOBJ");		
			head.put("DOCUTY", headRow.get("DOCUTY"));
			String numobj = commonDao.getMap(head).getString("NUMOBJ");
			
			head.setModuleCommand("WmsTask", "FN_NROBJ");
			head.put("NUMOBJ", numobj);
			String seq = (String)commonDao.getObj(head); // taskky 만들기	
			
			
			row.setModuleCommand("WmsTask", "TK36_PTNRKY");	
			row.put("PTNRTY", "CT");
			row.put("PTNRKY", row.getString("LOTA02").concat(row.getString("TOWAREKY")));
			ptnMap = commonDao.getMap(row); 
			
					
			//새로운 taskky 번호 채번
			headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			headRow.put("TASKKY", seq);
			headRow.put("WARETG", headRow.get("WAREKY"));
			headRow.put("TASOTY", headRow.get("DOCUTY"));
			headRow.put("PTNRKY", ptnMap.get("PTNRKY"));		
			headRow.put("PTNRNM", ptnMap.get("NAME01"));
			headRow.put("PTNRTY", "CT");
			headRow.put("STATDO", "FSH");
			
			
			headRow.setModuleCommand("WmsTask", "TASDH");
			commonDao.insert(headRow);
			
			
			row.put("TASOTY", head.get("DOCUTY"));
			
			row.setModuleCommand("WmsMobileOutboundPicking", "PDTK10_AVAILABLE_STOCK");
			List<DataMap> stockMapList = commonDao.getList(row);
			
			double totalShpqty = Utils.parseDouble(row.getString("SHPQTY"));
			
			for(int j=0; j < stockMapList.size(); j++) {
				
			itemCount += 10;
			totalShpqty -= Utils.parseDouble(stockMapList.get(j).getString("QTSIWH"));
			
			double shpqty = Utils.parseDouble(stockMapList.get(j).getString("QTSIWH"));
			
			if(totalShpqty <= 0) {
				
				shpqty = totalShpqty + shpqty;
				
			}
			
			row.put("TASKKY", seq);
			row.setModuleCommand("WmsTask", "TASDIEND");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			snum = String.valueOf(itemCount);
			inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
			
			row.put("TASKTY", "356"); //생산직불출 출고
			
			row.put("TASKIT", inum);
			row.put("STATIT", "FSH");
