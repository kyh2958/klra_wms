<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!doctype html>

<head>

<meta charset="utf-8">
<meta name="viewport" content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width, target-densitydpi=medium-dpi" />
<meta name="format-detection" content="telephone=no" />
<title>Smile Mobile WMS</title>
<%@ include file="/mobile/include/head.jsp" %>

<style type="text/css">
button{ vertical-align: bottom; height: 37px; }
input:read-only{ background-color: #e2e2e2; }
select:disabled{ background-color: #e2e2e2; }
.tem5_content .tableWrap_search  { overflow: hidden; }
.tem4_content .select_box table  { width  : 98% !important; margin: auto; }
.tem4_content .select_box .text  { padding: unset !important; margin: unset !important; }
.tem4_content table th           { padding: 3px !important; }
.tem4_content table td           { padding: 3px !important; }
.number { text-align: right }

/* --- 키오스크 리파인 스타일 --- */
#kioskq {
	font-family: "Pretendard","Noto Sans KR","Malgun Gothic",sans-serif;
	color: #1f1f29;
	background: linear-gradient(135deg,#f6f8ff,#fdf6f2);
	min-height: 100vh;
}
#kioskq .kiosk-wrapper {
	max-width: 1280px;
	margin: 0 auto;
	padding: 36px 48px 120px;
	display: flex;
	flex-direction: column;
	gap: 32px;
}
#kioskq .kiosk-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 28px;
	background: #fff;
	border-radius: 24px;
	padding: 22px 28px;
	border: 1px solid rgba(37,61,126,0.12);
	box-shadow: 0 18px 28px rgba(27,46,106,0.12);
}
#kioskq .kiosk-header { overflow: visible; }

#kioskq .time-box { 
  box-sizing: border-box;
  min-height: 76px;          /* 2줄 텍스트 안전 높이 */
}

#kioskq .time-box span {
    display: block;
    white-space: nowrap;
    line-height: 1.25;
}
#kioskq #currentDate {
    font-size: clamp(16px, 1.7vw, 20px);
}

#kioskq #currentTime {
    font-size: clamp(22px, 2.4vw, 28px);
    letter-spacing: 0.03em;
}
#kioskq .header-left { display:flex; align-items:center; gap:24px; }
#kioskq .brand-logo { width:158px; height:auto; }
#kioskq .brand { margin:0; font-size: clamp(28px,3vw,34px); font-weight:700; }
#kioskq .tagline { margin:4px 0 0; font-size: clamp(18px,2vw,22px); color:#5d647a; }

#kioskq .search-panel {
	background:#fff;
	border-radius:24px;
	padding:28px 30px;
	border:1px solid rgba(37,61,126,0.1);
	box-shadow:0 16px 26px rgba(27,46,106,0.1);
}



#kioskq .input_carNo {
    height: 100%;
    font-size: clamp(22px, 2.5vw, 28px);
    padding: 0 22px;
    border-radius: 18px;
    border: 1px solid #c7cce7;
    background: #fbfcff;
    text-align: center;
    letter-spacing: 0.12em;
}

#kioskq .input_carNo::placeholder { color:#9aa0bd; letter-spacing:0; }
#kioskq .btn-kiosk {
    height: 100%;
    border-radius: 18px;
    border: none;
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 24px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: filter .2s ease, transform .15s ease;
}
#kioskq .btn-kiosk.primary {
	background: linear-gradient(135deg,#3f59d8,#2742c3);
	color:#fff;
	box-shadow:0 16px 26px rgba(39,66,195,0.24);
}
#kioskq .btn-kiosk.neutral {
	background:#f4f6ff;
	color:#2742c3;
	border:1px solid #c7cce7;
}
#kioskq .btn-kiosk:hover { filter:brightness(1.05); }
#kioskq .btn-kiosk:active { transform:translateY(2px); }
#kioskq .input-hint {
    margin: 10px 0 0;
    padding-left: 4px;                 /* 입력칸과 라인 맞춤 */
    font-size: clamp(16px, 1.8vw, 20px);
    color: #666e88;
    text-align: left;
}

#kioskq .result-panel {
	background:#fff;
	border-radius:24px;
	padding:28px 30px 34px;
	border:1px solid rgba(37,61,126,0.1);
	box-shadow:0 16px 26px rgba(27,46,106,0.1);
}
#kioskq .result-title { margin:0 0 16px; font-size: clamp(26px,3vw,32px); }
#kioskq .tableWrap_search {
	border-radius:18px;
	border:1px solid #cbd2ec;
	/* overflow:hidden; */
}
#kioskq .tableHeader table thead th {
	background:#32436d !important;
	color:#fff !important;
	padding:14px 12px !important;
	font-size: clamp(18px,2vw,22px);
	white-space:nowrap;
}
#kioskq .tableBody table tbody td {
	font-size: clamp(20px,2.2vw,24px);
	padding:16px 12px !important;
	border-bottom:1px solid #dde2f3 !important;
}
#kioskq .tableBody table tbody tr:nth-child(even) td { background:#f6f8ff; }
#kioskq .tableBody table tbody tr:hover td { background:rgba(63,89,216,0.08); }



/* 하단 고정 버튼 */
#kioskq .footer_5 {
	background:#1e2a44;
	padding:12px 48px 20px;
}
#kioskq .footer_5 .f_1 {
	display:block;
	border-radius:16px;
	font-size: clamp(22px,2.4vw,28px);
	padding:18px 0;
	font-weight:700;
	text-align:center;
	background:#2d3a5f;
	color:#fff;
}
#kioskq .footer_5 .f_1:nth-child(2) { background:#3663ff; }

/* 반응형 */
@media (max-width: 960px) {
	#kioskq .kiosk-wrapper { padding:28px 24px 110px; }
	#kioskq .search-inline {
		grid-template-columns:minmax(0,1fr);
	}
	#kioskq .btn-kiosk { width:100%; }
}





#kioskq .footer_5 {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: #1e2a44;
    padding: 12px 48px 20px;
}

#kioskq .footer_5 table { width: 100%; }

#kioskq .footer_5 .f_1 {
    border-radius: 16px;
    font-size: clamp(22px, 2.4vw, 28px);
    padding: 18px 0;
    font-weight: 700;
    text-align: center;
    color: #fff;
    cursor: pointer;
    transition: filter .2s ease;
}

#kioskq .footer_5 .f_1.--secondary { background: #2d3a5f; }
#kioskq .footer_5 .f_1.--primary  { background: #3663ff; }
#kioskq .footer_5 .f_1:hover { filter: brightness(1.05); }

/* --- 검색 행 정렬 --- */
#kioskq .search-panel table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
}

#kioskq .search-panel colgroup col:first-child { width: 140px !important; }
#kioskq .search-panel colgroup col:last-child  { width: auto !important; }


#kioskq .search-inline {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
}


#kioskq .search-inline .input_carNo {
    flex: 1 1 auto;
    min-width: 0;
    height: clamp(56px, 7vw, 66px);
    font-size: clamp(22px, 2.5vw, 28px);
    padding: 0 22px;
    border-radius: 18px;
    border: 1px solid #c7cce7;
    background: #fbfcff;
    text-align: center;
    letter-spacing: 0.12em;
}

#kioskq .search-inline .btn-kiosk {
    flex: 0 0 165px;
    height: clamp(56px, 7vw, 66px);
    border-radius: 18px;
    font-size: clamp(20px, 2.2vw, 24px);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
}
/* 안내 문구를 입력칸 시작선에 맞춘다 */
#kioskq .input-hint {
    margin: 12px 0 0;
    padding-left: 4px;
    text-align: left;
    font-size: clamp(16px, 1.8vw, 20px);
    color: #666e88;
}

#kioskq .search-panel th {
    width: 120px;                         /* 라벨과 입력칸 간격 축소 */
    padding: 0 12px 0 6px;                /* 오른쪽 여백 최소화 */
    display: table-cell;  
    vertical-align: middle; 
    justify-content: flex-start;
    font-size: clamp(22px, 2.4vw, 26px);  /* 버튼과 동일한 크기 */
    font-weight: 700;
    color: #1f1f29;
      top: 800px;
}

#kioskq input[type=checkbox] {

zoom: 3.5;

}

</style>

<script type="text/javascript" src="/common/js/ezgencontrol.js"></script>

<script>

//✅ 선적번호 동일 체크 동기화용 전역 플래그
var __stkSyncFlag = "Y";

// ✅ gridList row check 이벤트 (반드시 전역에 있어야 함)
function gridListEventRowCheck(gridId, rowNum, checkType){

    if (gridId !== "gridList") return;

    if (__stkSyncFlag !== "Y") return;
    __stkSyncFlag = "N";

    try {
        var baseStk = gridList.getColData("gridList", rowNum, "STKNUM");
        if (!baseStk) return;

        var dataList = gridList.getGridData("gridList");
        for (var i = 0; i < dataList.length; i++) {
            var stk = gridList.getColData("gridList", i, "STKNUM");
            if (stk === baseStk) {
                gridList.setRowCheck("gridList", i, checkType);
            }
        }
    } finally {
        __stkSyncFlag = "Y";
    }
}


$(document).ready(function(){
	gridList.setGrid({
		id : "gridList",
		editable : true,
		module : "WmsMobileOutboundPicking_COPY",					  
		command : "KIOSK_INVOICEPRT",
		gridMobileType : true,
		emptyMsgType:false
	});
}); 



//추가
function searchVehinoPop() {
  var param = new DataMap();

  var vehino = ($("#VEHINO").val() || "").trim();
  if (vehino) {
    param.put("VEHINO", vehino);
    param.put("SCHMODE", /^\d{4}$/.test(vehino) ? "LAST4" : "CONTAINS");
  }

  param.put("WAREKY", "<%=wareky%>");
  param.put("OWNRKY", "<%=ownrky%>");
  param.put("LANGKY", "<%=langky%>");

  // ✅ param을 querystring으로(프로젝트에 util 있으면 그걸 쓰고)
  var qs = encodeURIComponent(JSON.stringify(param.map)); // 예시(프로젝트 규칙에 맞게 변경)
  window.open(
    '/mobile/KIOSKQ_CARNO_POP.page?POP_PARAM=' + qs,
    'KIOSKQ_CARNO_POP',
    'width=520,height=420,left=300,top=120,resizable=yes,scrollbars=yes'
  );
}



function vehinoPopCallback(data) {
  $("#VEHINO").val(data.get("VEHINO"));
  searchList();
}


 function ShpPrintList() {
	/* alert("printUnShppingPop called"); */
    var chkItemList = gridList.getSelectData("gridList");

    if (!chkItemList || chkItemList.length === 0) {
        commonUtil.msgBox("출력할 선적정보가 없습니다.");
        return;
    }

    var row = chkItemList[0];

    var wareky = "<%=wareky%>";
    var ownrky = "<%=ownrky%>";

    var where =
        "AND SH.WAREKY='" + wareky + "'" +
        " AND SH.OWNRKY='" + ownrky + "'" +
        " AND SH.STATDO IN ('NEW','FPC')" +  
        " AND SI.STKNUM='" + row.get("STKNUM") + "'";

 

    WriteEZgenElement(
        "출고지시서(미할당)_선적단위.ezg?ver=0.65",
        where,
        "",
        "<%=langky%>",
        new DataMap(),
        1300,
        950
    );
}

function printUnShppingPop(list) {

	   if (!list || list.length === 0) {
	        commonUtil.msgBox("출력할 선적정보가 없습니다.");
	        return;
	    }


	    var wareky = "<%=wareky%>";
	    var ownrky = "<%=ownrky%>";
	    // 선택된 STKNUM들을 IN으로 묶기
	    var stkArr = [];
	    for (var i = 0; i < list.length; i++) {
	        var stk = list[i].get("STKNUM");
	        if (stk) stkArr.push("'" + stk + "'");
	    }

	    if (stkArr.length === 0) {
	        commonUtil.msgBox("출력할 선적정보가 없습니다.");
	        return;
	    }

	    var stkWhere = stkArr.join(",");

	    var where =
	        "AND SH.WAREKY='" + wareky + "'" +
	        " AND SH.OWNRKY='" + ownrky + "'" +
	        " AND SH.STATDO IN ('NEW','FPC')" +  
	        " AND SI.STKNUM IN (" + stkWhere + ")";

	    /* var where =
	        "AND SH.WAREKY='" + wareky + "'" +
	        " AND SH.OWNRKY='" + ownrky + "'" +
	        " AND SI.STKNUM='" + popData.get("STKNUM") + "'"; */

	   

	    WriteEZgenElement(
	        "출고지시서(미할당)_선적단위.ezg?ver=0.65",
	        where,
	        "",
	        "<%=langky%>",
	        new DataMap(),
	        1300,
	        950
	    );
	}

//프린트 대상 조회
function getPrintTargetYn(stkWhere) {

    var wareky = "<%=wareky%>";
    var ownrky = "<%=ownrky%>";

    var param = new DataMap();
    param.put("WAREKY", wareky);
    param.put("OWNRKY", ownrky);
    param.put("STKNUM", stkWhere);   

    
    var json = netUtil.sendData({
        module : "WmsMobileOutboundPicking_COPY",
        command : "KIOSK_PRINT_TARGET_CHECK",
        param : param
    });

   
    var row = null;
    if (json) {
        if (json.data && json.data.length > 0) row = json.data[0];
        else if (json.data) row = json.data;
    }

    if (!row) {
        return { INVOICE_YN: "N", LINER_YN: "N", MOVE_YN: "N" };
    }

    return {
        INVOICE_YN : (row.INVOICE_YN || "N"),
        LINER_YN   : (row.LINER_YN   || "N"),
        MOVE_YN    : (row.MOVE_YN    || "N")
    };
}

function InvoicePrtList(type){

    var list = gridList.getSelectData("gridList");

    if (!list || list.length === 0) {
        commonUtil.msgBox("VALID_M0006");
        return;
    }

    if (type === '') {
        type = null;
    }

    /* ===============================
     * 1) 상태 기준 분기 판단
     * - NEW/FPC : 미작업(미상차) → 출고지시서(미할당)
     * - FCK     : 상차완료       → 거래명세서/이송명세서/원지/이동전표
     * =============================== */
    var isAllUnloaded = true;  // NEW/FPC만 있는지
    var isAllLoaded   = true;  // FCK만 있는지

    for (var i = 0; i < list.length; i++) {
        var statit = list[i].get("STATIT");

        if (statit === "NEW" || statit === "FPC") {
            isAllLoaded = false;
        } else if (statit === "FCK") {
            isAllUnloaded = false;
        } else {
            isAllUnloaded = false;
            isAllLoaded = false;
        }
    }

/*     if (!isAllUnloaded && !isAllLoaded) {
        commonUtil.msgBox("상태가 다른 건은 함께 출력할 수 없습니다.");
        return;
    } */

    /* ===============================
     * 2) 미상차건 → 출고지시서(미할당)
     * =============================== */

     if (isAllUnloaded) {

    	 for (var x = 0; x < list.length; x++) {
    	        if (!list[x].get("WAREKY")) list[x].put("WAREKY", "<%=wareky%>");
    	        if (!list[x].get("OWNRKY")) list[x].put("OWNRKY", "<%=ownrky%>");
    	    }
    	 
    	    var unloadPrintParam = new DataMap();
    	    unloadPrintParam.put("list", list);
    	    unloadPrintParam.put("columnList", "WAREKY,SHPOKY,STKNUM");
    	    unloadPrintParam.put("PRTTYP", "PK_LIST");
    	    unloadPrintParam.put("OWNRKY", "<%=ownrky%>");

    	    var unloadPrintJson = netUtil.sendData({
    	        url : "/wms/admin/json/commonPrint.data",
    	        param : unloadPrintParam
    	    });

    	  

    	    bindPrintSeq(list, unloadPrintJson);
    	    savePrintLog(list, "1");   // 1: 출고지시서

    	    printUnShppingPop(list);
    	    return;
    	}
    /* ===============================
     * 3) 상차완료(FCK) 상태 검증
     * =============================== */
    for (var j = 0; j < list.length; j++) {
        if (list[j].get("STATNM") != "출고완료"
         && list[j].get("STATNM") != "부분출고"
         && list[j].get("STATNM") != "상차완료") {
            commonUtil.msgBox("OUT_M0222");
            gridList.setRowFocus("gridList", list[j].get("GRowNum"));
            return;
        }
    }

    /* ===============================
     * 4) 문서유형별 출력대상 분류
     * - 거래명세서: 201/206/208/231
     * - 이송명세서: 221
     * =============================== */
    var wareky = "<%=wareky%>";
    var ownrky = "<%=ownrky%>";

    var allStkArr = [];
    var invoiceStkArr = [];
    var transferStkArr = [];

    var invoiceList = [];
    var transferList = [];

    for (var k = 0; k < list.length; k++) {
        var row = list[k];
        var stk = row.get("STKNUM");
        var shpmty = row.get("SHPMTY") || "";

        if (!stk) continue;

        allStkArr.push(stk);

        // 거래명세서 대상
        if (shpmty.indexOf("201") > -1 ||
            shpmty.indexOf("206") > -1 ||
            shpmty.indexOf("208") > -1 ||
            shpmty.indexOf("231") > -1) {
            invoiceStkArr.push(stk);
            invoiceList.push(row);
        }

        // 이송명세서 대상
        if (shpmty.indexOf("221") > -1) {
            transferStkArr.push(stk);
            transferList.push(row);
        }
    }

    if (allStkArr.length === 0) {
        commonUtil.msgBox("출력할 문서가 없습니다.");
        return;
    }

    var allStkWhere      = makeStknumInWhere(allStkArr);
    var invoiceStkWhere  = makeStknumInWhere(invoiceStkArr);
    var transferStkWhere = makeStknumInWhere(transferStkArr);

    /* ===============================
     * 5) 공통 출력 대상 체크
     * - 원지 / 이동전표는 전체 선택건 기준
     * =============================== */
    var yn = getPrintTargetYn(allStkWhere);

     /* ===============================
      * 6) 거래명세서용 DEALKY 생성 + commonPrint.data
      * =============================== */
     var dealky = null;

     if (yn.INVOICE_YN === "Y" && invoiceList.length > 0) {

         var dealParam = new DataMap();
         dealParam.put("list", invoiceList);

         var dealJson = netUtil.sendData({
             url : "/wms/outbound/json/DL081PrintTS.data",
             param : dealParam
         });

         if (!dealJson || !dealJson.data || !dealJson.data["DEALKY"]) {
             yn.INVOICE_YN = "N";
         } else {
             dealky = dealJson.data["DEALKY"];
             for (var x = 0; x < invoiceList.length; x++) {
                 if (!invoiceList[x].get("WAREKY")) invoiceList[x].put("WAREKY", "<%=wareky%>");
                 if (!invoiceList[x].get("OWNRKY")) invoiceList[x].put("OWNRKY", "<%=ownrky%>");
             }
             
             var printParam = new DataMap();
             printParam.put("list", invoiceList);
             printParam.put("columnList", "WAREKY,SHPOKY,STKNUM");
             printParam.put("PRTTYP", "PK_LIST");
             printParam.put("OWNRKY", "<%=ownrky%>");

             var printJson = netUtil.sendData({
                 url : "/wms/admin/json/commonPrint.data",
                 param : printParam
             });

            

             bindPrintSeq(invoiceList, printJson);
         }
     }

     /* ===============================
      * 7) 최종 출력 가능 여부 판단
      * =============================== */
     var canInvoice  = (yn.INVOICE_YN === "Y" && invoiceStkArr.length > 0 && dealky);
     var canTransfer = (transferStkArr.length > 0);
     var canLiner    = (yn.LINER_YN === "Y");
     var canMove     = (yn.MOVE_YN === "Y");

     if (!canInvoice && !canTransfer && !canLiner && !canMove) {
         commonUtil.msgBox("출력할 문서가 없습니다.");
         return;
     }

     /* ===============================
      * 8) 거래명세서 출력
      * =============================== */
     if (canInvoice) {
         savePrintLog(invoiceList, "2");   // 2: 거래명세서

         var dealWhere =
             "AND SH.WAREKY='" + wareky + "'" +
             " AND SH.OWNRKY='" + ownrky + "'" +
             " AND SH.STATDO IN ('PSH','FSH','FCK')" +
             " AND SH.SHPMTY IN ('201','206','208','231')" +
             " AND SI.STKNUM IN (" + invoiceStkWhere + ")";

         var invoicePrintMap = new DataMap();
         invoicePrintMap.put("DEALKY", dealky);
         invoicePrintMap.put("i_type", type);

         WriteEZgenElement(
             "거래명세서.ezg?ver=0.41",
             dealWhere,
             "",
             "<%=langky%>",
             invoicePrintMap,
             1000,
             900
         );
     }

    /* ===============================
     * 9) 원지 출력
     * =============================== */
    
        

        	if (canLiner) {
        		  for (var x = 0; x < list.length; x++) {
                      if (!list[x].get("WAREKY")) list[x].put("WAREKY", "<%=wareky%>");
                      if (!list[x].get("OWNRKY")) list[x].put("OWNRKY", "<%=ownrky%>");
                  }

        	    var linerPrintParam = new DataMap();
        	    linerPrintParam.put("list", list);
        	    linerPrintParam.put("columnList", "WAREKY,SHPOKY,STKNUM");
        	    linerPrintParam.put("PRTTYP", "PK_LIST");
        	    linerPrintParam.put("OWNRKY", "<%=ownrky%>");

        	    var linerPrintJson = netUtil.sendData({
        	        url : "/wms/admin/json/commonPrint.data",
        	        param : linerPrintParam
        	    });

        	    bindPrintSeq(list, linerPrintJson);
        	    savePrintLog(list, "3");   // 3: 원지출력물

        	    setTimeout(function () {

        	        var linerWhere =
        	            "AND SH.WAREKY='" + wareky + "'" +
        	            " AND SH.OWNRKY='" + ownrky + "'" +
        	            " AND SH.STATDO IN ('FPC','PSH','FSH','FCK')" +
        	            " AND SI.STKNUM IN (" + allStkWhere + ")";

        	        WriteEZgenElement(
        	            "원지출고지시서_선적단위.ezg?ver=2.46",
        	            linerWhere,
        	            "",
        	            "<%=langky%>",
        	            new DataMap(),
        	            1000,
        	            900
        	        );

        	    }, 3000);
        	}

    /* ===============================
     * 10) 이송명세서 출력
     * =============================== */
     if (canTransfer) {
    	    for (var x = 0; x < transferList.length; x++) {
                if (!transferList[x].get("WAREKY")) transferList[x].put("WAREKY", "<%=wareky%>");
                if (!transferList[x].get("OWNRKY")) transferList[x].put("OWNRKY", "<%=ownrky%>");
            }
    	    var transferPrintParam = new DataMap();
    	    transferPrintParam.put("list", transferList);
    	    transferPrintParam.put("columnList", "WAREKY,SHPOKY,STKNUM");
    	    transferPrintParam.put("PRTTYP", "PK_LIST");
    	    transferPrintParam.put("OWNRKY", "<%=ownrky%>");

    	    var transferPrintJson = netUtil.sendData({
    	        url : "/wms/admin/json/commonPrint.data",
    	        param : transferPrintParam
    	    });

    	    bindPrintSeq(transferList, transferPrintJson);
    	    savePrintLog(transferList, "4");   // 4: 이송명세서

    	    setTimeout(function () {

    	        var transferWhere =
    	            "AND SH.WAREKY='" + wareky + "'" +
    	            " AND (";

    	        for (var t = 0; t < transferStkArr.length; t++) {
    	            transferWhere += "SI.STKNUM='" + transferStkArr[t] + "'";
    	            if (t !== transferStkArr.length - 1) {
    	                transferWhere += " OR ";
    	            }
    	        }

    	        transferWhere += ")";

    	        WriteEZgenElement(
    	            "이송명세서_선적단위.ezg?ver=0.06",
    	            transferWhere,
    	            "",
    	            "<%=langky%>",
    	            new DataMap(),
    	            1000,
    	            1000
    	        );

    	    }, 3200);
    	}

    /* ===============================
     * 11) 이동전표 팝업
     * =============================== */
    if (canMove) {
    	savePrintLog(list, "5");   // 5: 이동전표
        setTimeout(function () {
            openMoveSlipPrintPop(list);
        }, 3500);
    }
}
function makeStknumInWhere(list){
    var arr = [];
    for (var i = 0; i < list.length; i++) {
        var v = (list[i] || "").toString().trim();
        if (v) arr.push("'" + v + "'");
    }
    return arr.join(",");
}




function searchList(){
	  if(!validate.check("searchArea")){
	    $("#VEHINO").focus();
	    return;
	  }

	  var param = inputList.setRangeParam("searchArea");
	  param.put("WAREKY", "<%=wareky%>");
	  param.put("OWNRKY", "<%=ownrky%>");
	  param.put("LANGKY", "<%=langky%>");

	  gridList.gridList({
	    id : "gridList",
	    param : param
	  });
 
	}


function fn_onfocus(objId){
    $("#" + objId).select();
}

function bindPrintSeq(list, printJson) {
    if (!list || list.length === 0) {
        return;
    }
    

    var data = printJson.data;

   

    // 0) data 자체가 단건 문자열/숫자 PRTSEQ 인 경우
    if (typeof data === "string" || typeof data === "number") {
        var singlePrtseq = String(data);

        for (var i = 0; i < list.length; i++) {
            list[i].put("PRTSEQ", singlePrtseq);
        }

        
        return;
    }

    // 1) 단건 객체 PRTSEQ
    if (data.PRTSEQ) {
        for (var j = 0; j < list.length; j++) {
            list[j].put("PRTSEQ", data.PRTSEQ);
        }

        
        return;
    }

    // 2) data.list 형태
    if (data.list && $.isArray(data.list)) {
        var seqMap1 = {};

        for (var k = 0; k < data.list.length; k++) {
            var row1 = data.list[k];
            if (row1.SHPOKY && row1.PRTSEQ) {
                seqMap1[row1.SHPOKY] = row1.PRTSEQ;
            }
        }

        for (var m = 0; m < list.length; m++) {
            var shpoky1 = list[m].get("SHPOKY");
            if (shpoky1 && seqMap1[shpoky1]) {
                list[m].put("PRTSEQ", seqMap1[shpoky1]);
            }
        }

        
        return;
    }

    // 3) 배열 자체
    if ($.isArray(data)) {
        var seqMap2 = {};

        for (var n = 0; n < data.length; n++) {
            var row2 = data[n];
            if (row2.SHPOKY && row2.PRTSEQ) {
                seqMap2[row2.SHPOKY] = row2.PRTSEQ;
            }
        }

        for (var p = 0; p < list.length; p++) {
            var shpoky2 = list[p].get("SHPOKY");
            if (shpoky2 && seqMap2[shpoky2]) {
                list[p].put("PRTSEQ", seqMap2[shpoky2]);
            }
        }

       
        return;
    }

   
}


/* 출력물 INSERT 공통 */
function savePrintLog(list, docCd) {
    if (!list || list.length === 0) {
        return;
    }


    for (var i = 0; i < list.length; i++) {
        var row = list[i];
    }
    
    var param = new DataMap();
    param.put("list", list);
    param.put("DOC_CD", docCd);
    param.put("WAREKY", "<%=wareky%>");
    param.put("OWNRKY", "<%=ownrky%>");
    
   

    var json = netUtil.sendData({
        url : "/wms/outbound/json/saveKioskPrintLog.data",
        param : param
    });
    
  
}

function openMoveSlipPrintPop(list){
    if (!list || list.length === 0) {
        commonUtil.msgBox("출력할 문서가 없습니다.");
        return;
    }

    var stkArr = [];
    for (var i = 0; i < list.length; i++) {
        var stk = list[i].get("STKNUM");
        if (stk) stkArr.push(stk);
    }

    if (stkArr.length === 0) {
        commonUtil.msgBox("출력할 문서가 없습니다.");
        return;
    }

    var stkCsv = stkArr.join(",");

    var url = "<%=request.getContextPath()%>/mobile/KIOSKQPRT.page"
            + "?isMobile=true"
            + "&STKNUM=" + encodeURIComponent(stkCsv)
            + "&_ts=" + new Date().getTime();

    window.open(
        url,
        "MOVE_SLIP_PRINT",
        "width=1100,height=900,left=200,top=80,resizable=yes,scrollbars=yes"
    );
}

</script>
</head>
<body id='kioskq'>
<div class="kiosk-wrapper">

<div class="kiosk-header">
    <div class="header-left">
        <img src="/common/theme/webdek/images/kleannara_logo.png" alt="깨끗한나라 로고" class="brand-logo">
        <div class="brand-text">
            <p class="brand">배차 안내 키오스크</p>
            
        </div>
    </div>
</div>
    <div class="tem4_content">
        <section class="search-panel">
            <table>
                <colgroup>
                    <col width="20%" />
                    <col width="80%" />
                </colgroup>
                <tbody id="searchArea">
                <tr>
                    <th CL="STD_VEHINO">차량번호</th>
                    <td>
				    <div class="search-inline">
				        <input type="tel" class="text input_carNo"
				               id="VEHINO" name="VEHINO"
				               maxlength="4" inputmode="numeric" pattern="[0-9]*"
				               placeholder="차량번호는 숫자 4자리만 입력해 주세요. (예: 1234)"
				               onfocus="fn_onfocus(this.id)"
				               oninput="this.value = this.value.replace(/[^0-9]/g,'').slice(0,4);"
				              
				               validate="required" />
				
				        <button type="button" class="btn-kiosk neutral" onclick="searchVehinoPop()">
				            차량검색
				        </button>
				
				        <!-- <button type="button" class="btn-kiosk primary" onclick="searchList()">
				            조회
				        </button> -->
				    </div>
				</td>

                </tr>
                </tbody>
            </table>
        </section>

        <section class="result-panel">
            <h2 class="result-title">조회 결과</h2>
            <div class="result-card">
                <div class="tableWrap_search section kiosk-grid-limit">
                    <div class="tableHeader" id='tableHeader'>
                    <%
                        if(mtype.equals("P")){
                    %>
                        <jsp:include page="./KIOSK_CARLIST_PS.jsp" flush="false"/>
                    <%
                        } else {
                    %>
                        <jsp:include page="./KIOSK_CARLIST_ELSE.jsp" flush="false"/>
                    <%
                        }
                    %>
                    </div>
                </div>

                <!-- 도면 이미지 -->
               <!--  <div id="mapArea" class="map-wrap">
                    <img src="/common/theme/webdek/images/dashboard.png" alt="상차 지점 안내도">
                    <p>상차 위치 안내도</p>
                </div> -->
                
            </div>
        </section>
    </div>
</div>

<div class="footer_5">
    <table>
        <tr>
            <!-- <td class="f_1 --secondary" onclick="searchList()">
                <label CL='BTN_SEARCH'>조회</label>
            </td> -->
            <td class="f_1 --primary" onclick="InvoicePrtList()">
                <label CL="BTN_INVPRINT">출력</label>
            </td>
        </tr>
    </table>
</div>
