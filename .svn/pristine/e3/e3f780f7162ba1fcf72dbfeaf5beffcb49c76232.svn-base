	//Total 피킹생성
	function TotalPickingCreate(){
	    var taskky;
	    var shpoky;
	    var head = gridList.getSelectData("gridList");
	    
	    var chkRowCnt = gridList.getSelectRowNumList("gridList").length;
		if(chkRowCnt < 1) {
			commonUtil.msgBox("VALID_M0006");
			return;
		}			
		
		var list = gridList.getSelectData("gridList");
		var param = new DataMap();
		param.put("list", list);
		
		for(var i=0; i< list.length; i++){
			if(list[i].get("STATDO") != "PAL" && list[i].get("STATDO") != "FAL"){			
			
				commonUtil.msgBox("OUT_M0217");//상태값이 부분할당 또는 할당완료가 아닙니다.
				gridList.setColFocus("gridList", i, "STATDO");
			 return;
			}
		}
		
		if(!commonUtil.msgConfirm("OUT_M0187")){ //피킹생성 하시겠습니까?
			return;
		} 
		
		var json = netUtil.sendData({
			url: "/wms/outbound/json/totalPickingCreate.data",
			param: param
		});
		
		if(json && json.data) {
			
			if(json.data == "OK" || json.data > 0 || !json.data.RESULT_VALUE) {
				commonUtil.msg(commonUtil.getMsg(configData.MSG_SYSTEM_SAVEOK));
				searchList();				
			} else {
				commonUtil.msgBox("OUT_M0218",json.data.RESULT_VALUE); //문서번호 [{0}]는 이미 피킹생성된 문서입니다.		
			}
		}
	}
	
