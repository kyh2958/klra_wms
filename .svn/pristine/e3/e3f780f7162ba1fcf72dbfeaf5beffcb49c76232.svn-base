	//할당피킹지시서 출력
	function printPlShpping(){
		var list = gridList.getSelectData("gridList");
		
		if (list.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		} 
		
		var param = new DataMap();
		param.put("list",list);
		param.put("columnList", "WAREKY,SHPOKY");
		param.put("PRTTYP","PK_LIST");
		param.put("OWNRKY", "<%=ownrky%>");
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		
		var url = "KN_shipment_list3.ezg?ver=0.10";
		var wareky  = "<%=wareky%>";
		var ownrky  = "<%=ownrky%>";
		var where = "AND SH.WAREKY='"+wareky+"' AND SH.OWNRKY='"+ownrky+"' AND (";
		for(var i=0; i<list.length; i++){
			var row = list[i];
			var key = row.get("SHPOKY");
			//var STATDO = row.get("STATDO");
			var prtchk = row.get("PRTCHK");
			
			var param2 = new DataMap();
			
			param2.put("SHPOKY",key);
			var json = netUtil.sendData({
				module : "WmsOutbound",
				command : "ALLCATIONVAL",
				sendType : "map",
				param : param2
			});
			
			statdo = json.data["STATDO"];
			
			if(statdo == "PAL" || statdo == "FAL"){
				flag = true;
			}else{
				commonUtil.msgBox("할당된 정보만 출력가능합니다.");   //할당된 정보만 출력가능합니다.
		        return;
			}
			
			where += "SH.SHPOKY='"+key+"'";
			if(i==list.length-1) break;
			where += " OR ";	
		}
		where += ")"; 
		
		var json2 = netUtil.sendData({
			url: "/wms/outbound/json/PrtUpdateDL04.data",
			param : param
		});
		
		var map = new DataMap();
		map.put("WAREKY", "<%=wareky%>");
		
		WriteEZgenElement(url, where, "", '<%=langky%>', map, 1300, 950);
	}
	
