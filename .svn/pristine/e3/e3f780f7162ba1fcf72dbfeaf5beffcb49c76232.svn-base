<script type="text/javascript">
	var dblIdx = 0;
	var subIdx = 0;
	var searchType = 0;
	var paramH = new DataMap();
	var menuky = configData.MENU_ID;
	
	$(document).ready(function(){
	    //setTopSize(300);
	    
	    gridList.setGrid({
	        id : "gridList",
	        module : "WmsOutbound",
	        editable : true,
	        command : "DL04",
	        itemGrid : "gridListSub",
	        itemSearch : true
	    });
	    gridList.setGrid({
	        id : "gridListSub",
	        module : "WmsOutbound",
	        command : "DL04Sub"
	    });
	    
	    var headList = page.getLinkPageData("DL04");
	    if(headList){
	        linkSetParam(headList);
	        searchList(headList);
	    }
	     
      <%if(plant.equals("")){%>
        $('select[name="SI.LOTA02"]').multipleSelect('checkAll');
      <%}else{%>
        $('select[name="SI.LOTA02"]').multipleSelect('setSelects', ['<%=plant%>']);
      <%}%>
	     	  
      /* 출고유형 전체선택 */
      var $selRCPTTY = $('select[id="RCPTTY"]');
      $selRCPTTY.multipleSelect('checkAll');
      
      gridList.setReadOnly("gridListSub", true, ["CHGFLG", "STATUS_NEW", "STATUS_ALO", "STATUS_PCK", "STATUS_SHP", "APPOINTPICKING"]);
      
	});
	
	function linkSetParam(headList){
	    var param = inputList.setRangeParam("searchArea");
	    if(headList && headList.length>0){
	        var mangeMap = new DataMap();
	        var rangeList = new Array();
	
	        var rowMap;
	        for(var i=0; i<headList.length; i++){
	            rowMap = headList[i];
	            mangeMap = new DataMap();
	            mangeMap.put("OPER", "E");
	            mangeMap.put("DATA", rowMap.get("SHPOKY")); 
	            rangeList.push(mangeMap);
	        }
	        inputList.setRangeData("SH.SHPOKY", configData.INPUT_RANGE_TYPE_SINGLE, rangeList);
	    }
	}
	
	function linkPageOpenEvent(headList){
	    linkSetParam(headList);
	    searchList(headList);
	}
	
	
