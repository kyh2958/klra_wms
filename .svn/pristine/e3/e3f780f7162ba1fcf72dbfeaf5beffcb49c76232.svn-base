	//할당 전략키 반영
	function setAlstky(){
		var alstky = $("#ALSTKY").val();
		var selectNumList = gridList.getSelectRowNumList("gridListSub");
		
		
		if(selectNumList.length < 1){
			commonUtil.msgBox("OUT_M0219"); //할당전략키를 적용할 레코드를 선택해주세요.
			return;
		}						
        
		if(alstky){
			for(var i=0;i<selectNumList.length;i++){
				var rowNum = selectNumList[i];
				gridList.setColValue("gridListSub", rowNum, "ALSTKY", alstky);
			}
			gridList.setColFocus("gridListSub", rowNum, "ALSTKY");
		}
	}
	
	//할당 전략키 저장
	function subsaveData(){
		var chkRowCnt = gridList.getSelectRowNumList("gridList").length;
		if(chkRowCnt < 1) {
			commonUtil.msgBox("VALID_M0006");
			return;
		}
		
		var modifyRowCnt = gridList.getModifyRowCount("gridListSub");
		if(modifyRowCnt < 1) {
			commonUtil.msgBox("VALID_M1573"); //변경된 데이터가 없습니다.
			return;
		}
		
		if(!commonUtil.msgConfirm("HHT_T0007")){ //저장하시겠습니까?
			return;
		} 
		
		//할당전력키 문서번호 조회
	    var param = new DataMap();
	    
	    var ListRowNum = gridList.getFocusRowNum("gridList");
	    var ListSubRowNum = gridList.getFocusRowNum("gridListSub");
	    
	    var alstky = gridList.getColData("gridListSub", ListSubRowNum, "ALSTKY");
	    
	    param.put("WAREKY", "<%=wareky%>");
        param.put("ALSTKY", alstky);
        
        /* var json = netUtil.sendData({
            module : "WmsOutbound",
            command : "ALCUSval",
            sendType : "map",
            param : param
        });

        if(json.data["DOCUTY"] !=" "){
        	
			if(gridList.getColData("gridList", ListRowNum, "SHPMTY") != json.data["DOCUTY"]){
				alert("할당전략키의 문서번호가 맞지 않습니다.");
				gridList.setColFocus("gridList", ListRowNum, "SHPMTY");
				return;
			}
			
        } */
        
		var list = gridList.getSelectData("gridListSub");
		var param = new DataMap();
		param.put("list", list);
		
		var json = netUtil.sendData({
			url: "/wms/outbound/json/saveDL04Sub.data",
			param: param
		});
		
		if(json && json.data) {
			if(json.data == "OK" || json.data > 0) {
				searchList();
				alert(commonUtil.getMsg(configData.MSG_SYSTEM_SAVEOK));
			} else {
				alert(commonUtil.getMsg(configData.MSG_SYSTEM_SAVEFAIL) + " [" + json.data + "]");
			}
		}
	}
	
	function comboEventDataBindeBefore(comboAtt){
		if(comboAtt == "WmsOrder,RCPTTYCOMBO"){
            var param = new DataMap();
            param.put("PROGID", configData.MENU_ID);
            return param;
        }else if(comboAtt == "Wms,PLNTKYCOMBO"){
	        var param = new DataMap();
	        param.put("WAREKYS", "'<%= wareky%>'");
	        param.put("OWNRKY", "<%=ownrky%>");
	        param.put("LANGKY", "<%=langky%>");
	        
	        return param;
	    }else if(comboAtt == "WmsTask,COMMON_ALSTH"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,DEPTID"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,VTXTK"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,KVGR"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}
	}
	
	//search 전체 체크박스 클릭
	function searchCheckBoxAll(obj) {
		
		if($(obj).prop("checked") == true){
			$(obj).parent('dd').children('input').prop("checked", true);
		}else{
			$(obj).parent('dd').children('input').prop("checked", false);
		}
	}
	
	
    //거래명세서
    function PePrintList(){
		var list = gridList.getSelectData("gridList");
		
		if (list.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		} 
		
		/* 납품처코드, 선적번호 기준으로 SAP에서 데이터 호출. */
		var param = new DataMap();
		param.put("list", list);
		
		
		for(var j=0; j<list.length; j++){
// 			if(list[j].get("STATDO") != "FSH" && list[j].get("STATDO") != "PSH"){				
// 				commonUtil.msgBox("OUT_M0222"); //부분출고 또는 출고완료 상태인 문서만 출력 가능합니다.
// 				gridList.setRowFocus("gridList", list[j].get("GRowNum"));
// 				return;
// 			} 
			
			if (list[j].get("SHPMTY") != "201" &&
				list[j].get("SHPMTY") != "206" &&
				list[j].get("SHPMTY") != "208" &&
				list[j].get("SHPMTY") != "231"){
				commonUtil.msgBox("OUT_M0227"); //거래가 있는 문서를 출력할 수 있습니다.
				gridList.setRowFocus("gridList", list[j].get("GRowNum"));
				return;
			}
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		}
		
		var json = netUtil.sendData({
			url : "/wms/outbound/json/DL08PrintTS.data",
			param : param
		});
		var dealky = json.data['DEALKY'];
		
		var param = new DataMap();
		param.put("list",list);
		param.put("columnList", "WAREKY,SHPOKY,STKNUM");
		param.put("PRTTYP","PK_LIST");
		param.put("OWNRKY", "<%=ownrky%>");
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		
		var url = "거래명세서.ezg?ver=0.11";
		var wareky  = "<%=wareky%>";
		var ownrky  = "<%=ownrky%>";
		var where = "AND SH.WAREKY='"+wareky+"' AND SH.OWNRKY='"+ownrky+"' AND (";
		for(var i=0; i<list.length; i++){
			var row = list[i];
			var key = row.get("SHPOKY");
			
			where += "SI.SHPOKY='"+key+"'";
			if(i==list.length-1) break;
			where += " OR ";	
		}
		where += ")"; 
		
		var map = new DataMap();
		
		map.put("DEALKY", dealky);
		WriteEZgenElement(url, where, "", '<%=langky%>', map, 1000, 900);
		
    }
    
	var goFlag = "Y"; 
	function gridListEventRowCheck(gridId, rowNum, checkType){
		
		if(gridId == "gridList" && checkType == true && goFlag == "Y"){
			var stknum = gridList.getColData(gridId, rowNum, "STKNUM");
			
			goFlag = "N";
			
			var head = gridList.getGridData(gridId);
			for (var i = 0; i < head.length; i++) {
				if (stknum == gridList.getColData(gridId, i, "STKNUM") && stknum != " "){
					gridList.setRowCheck(gridId, i, true);
				}
			}
			goFlag = "Y";
		}
	}
	
function UnStknum(){
		
		var head = gridList.getSelectData("gridList");
        
        
        if(head.length == 0){
            commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
            return;
        }

        if(!commonUtil.msgConfirm("OUT_M0259")){ //선적제한해제 하시겠습니까??
            return;
        }

        var headSelectList = gridList.getSelectRowNumList("gridList");
        for(var i=0;i<headSelectList.length;i++){
            var statdo = gridList.getColData("gridList", headSelectList[i], "STATDO");  //Head상태
            var shpoky = gridList.getColData("gridList", headSelectList[i], "SHPOKY");  //Head상태
           
            //Head 미작업 상태이면 밸리데이션 check
            if(statdo != "NEW"){
            	
            	
			    commonUtil.msgBox("OUT_M0260", shpoky);   //출하문서 [{0}]는 미작업 상태가 아닙니다.
                gridList.setColFocus("gridList", headSelectList[i], "STATDO");
                return;
            }
            
        }
        

        var param = new DataMap(); 
        param.put("head", head);
    
        
        var vjson = netUtil.sendData({
			url : "/wms/outbound/json/sendDL04StknumInfo.data",			
			param : param
		});
		
		if(vjson && vjson.data){
			
			if(vjson.data["MSG"] && vjson.data["MSG"] != "SUCCESS"){
				commonUtil.msgBox(vjson.data["MSG"], null, null, function () { 
					          			
				}); 
				
			}else{
				//선적제한해제가 완료 되었습니다.
				commonUtil.msgBox("OUT_M0261", null, null, function () { 
					reSearchList();
				}); 
			}
		}
    
	}
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
	<div class="content_inner">
		<%@ include file="/common/include/webdek/title.jsp" %>
		<div class="content_serch" id="searchArea">
			<div class="btn_wrap">
				<div class="fl_l">
				</div>
				<div class="fl_r">
					<input type="button" CB="Search SEARCH BTN_DISPLAY" />
			        <!-- <input type="button" CB="Save SAVE STD_SAVE" /> -->
			        <input type="button" CB="Allocate ALLOCATE BTN_ALLOCATE" />
			        <input type="button" CB="Wcancle WCANCLE BTN_UNALLO" />
			        <input type="button" CB="printPlShpping PRINT BTN_PRINT27" />
			        <input type="button" CB="printAlShpping PRINT BTN_PRINT26" />
			        <input type="button" CB="printShpping PRINT BTN_PRINT24" />
			        <input type="button" CB="printUnShpping PRINT BTN_PRINT25" />
			        <input type="button" CB="TotalPickingCreate CREATE BTN_TOTPICKCREATE" />
			        <input type="button" CB="TotalPickingList SEARCH BTN_TOTPICKLIST" />
			        <input type="button" CB="PePrint PRINT BTN_PEPRINT"/><!-- 거래명세서 -->
			        <input type="button" CB="RcvSap PRINT BTN_RCVSAP"/><!-- SAP FUNC 호출 -->
<!--   			        <input type="button"  CB="RcvStk PRINT BTN_RCVSTK" />SAP 선적수신 호출 -->
			        <input type="button" CB="UnStknum UNSTKNUM BTN_UNSTKNUM" />
				</div>
			</div>
			
			<div class="search_inner">
				<div class="search_wrap ">
					<input type="hidden" class="input" name="OWNRKY" value="<%=ownrky %>" />
					<dl>
						<dt CL="STD_WAREKY">거점</dt>
						<dd>
							<input type="text" class="input" name="WAREKY" name="WAREKY"  value="<%=wareky%>" readonly="readonly" validate="required" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA02">플랜트</dt>
						<dd>
							<select type="text" class="input" Combo="Wms,PLNTKYCOMBO" name="SI.LOTA02" id="PLNTKY" ComboType="MS" style="width: 160px;" validate="required">
							</select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA01">저장위치</dt>
						<dd>
							<input type="text" class="input" name="SI.LOTA01" UIInput="R,SHSTLMAP" />
						</dd>
					</dl>
										
					<dl>
                        <dt CL="STD_RQSHPD">출하요청일자</dt>
                        <dd>
                            <input type="text" class="input" name="SH.RQSHPD" UIFormat="C -7 7" UIInput="R"/> 
                        </dd>
                    </dl>
                    
                    <dl>
						<dt CL="STD_STATDO">문서상태</dt>
						<dd style="width: 800px;">
							<input type="checkbox" class="input" id="STAT00" name="STAT00" value="V" onclick="searchCheckBoxAll(this)"/>
							<label CL="STD_ALL" for="STAT00">전체</label>
							<input type="checkbox" class="input" id="STAT01" name="STAT01" value="V" checked="checked"/>
							<label CL="STD_EMPTYTRAN" for="STAT01">미작업</label>
							<input type="checkbox" class="input" id="STAT02" name="STAT02" value="V" checked="checked"/>
							<label CL="STD_PALLOC" for="STAT02">부분할당</label>
							<input type="checkbox" class="input" id="STAT03" name="STAT03" value="V"/>
							<label CL="STD_ALLOCA" for="STAT03">할당완료</label>
							<input type="checkbox" class="input" id="STAT04" name="STAT04" value="V"/>
							<label CL="STD_PPICKYN" for="STAT04">부분피킹</label>
							<input type="checkbox" class="input" id="STAT05" name="STAT05" value="V"/>
							<label CL="STD_PICKED" for="STAT05">피킹완료</label>
							<input type="checkbox" class="input" id="STAT06" name="STAT06" value="V"/>
							<label CL="STD_PCK" for="STAT06">부분상차</label>
							<input type="checkbox" class="input" id="STAT07" name="STAT07" value="V"/>
							<label CL="STD_FCKCOM" for="STAT07">상차완료</label>
							<input type="checkbox" class="input" id="STAT08" name="STAT08" value="V"/>
							<label CL="STD_PSHPCOM" for="STAT08">부분출고</label>
							<input type="checkbox" class="input" id="STAT09" name="STAT09" value="V"/>
							<label CL="STD_SHPCOM" for="STAT09">출고완료</label>							 
						</dd>
					</dl>
					
					 <dl>
                        <dt CL="STD_STKNUM">선적번호</dt>
                        <dd>
                            <input type="text" class="input" name="SI.STKNUM" UIInput="SR"/>
                        </dd>
                    </dl>
                    
                    
                    <dl>
                        <dt CL="STD_SSHTYP">출고유형</dt>
                        <dd style="width: 160px;">
                            <select type="text" class="input" Combo="WmsOrder,RCPTTYCOMBO" name="SH.SHPMTY" id="RCPTTY" ComboType="MS" validate="required">
                            </select>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_SHPOKY">출고문서번호</dt>
                        <dd>
                            <input type="text" class="input" name="SH.SHPOKY" UIInput="SR"/>
                        </dd>
                    </dl>                                        
					
                    <dl>
                        <dt CL="STD_SVBELN">출고오더번호</dt>
                        <dd>
                            <input type="text" class="input" name="SI.SVBELN" UIInput="SR"/>
                        </dd>
                    </dl>
                                      
                    <dl>
                        <dt CL="STD_TOTPICKNUM">TOTAL 피킹번호</dt>
                        <dd>
                            <input type="text" class="input" name="TP.STKNUM" UIInput="SR"/>
                        </dd>	
                    </dl>
                    
                    <dl>
                        <dt CL="STD_SAP2">항차번호</dt>
                        <dd>
                            <input type="text" class="input" name="SH.SAP2" UIInput="SR" />
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_DPTNKY2">납품처</dt>
                        <dd>
                            <input type="text" class="input" name="SH.DPTNKY" UIInput="SR,SHBZPTN"/>
                        </dd>	
                    </dl>
                    
                    <dl>
                        <dt CL="STD_DPTNNM3">납품처명</dt>
                        <dd>
                            <input type="text" class="input" name="CT.NAME01" UIInput="SR" />
                        </dd>
                    </dl>
                    <dl>
                        <dt CL="STD_SKUKEY">품목코드</dt>
                        <dd>
                            <input type="text" class="input" name="SI.SKUKEY" UIInput="SR" UIFormat="U"/>
                        </dd>
                    </dl> 
                    
                    <dl>
						<dt CL="STD_SKUG01">품목유형</dt>
						<dd>
							<select class="input" name="SKUG01" Combo="WmsInventory,SKUG01COMBO"><option value=""/></select>
						</dd>
					</dl>
					
                    <dl>
                        <dt CL="STD_SKUL01">품목구분</dt>
                        <dd>
                            <select type="text" class="input" CommonCombo="SKUL01" name="SKUL01" id="SKUL01" style="width: 160px;">
                              <option value=""></option>
                            </select>
                        </dd>
                    </dl>
                    
                    
                    <dl>
                        <dt CL="STD_BNAME">영업사원명</dt>
                        <dd>
                            <input type="text" class="input" name="SH.UNAME1" UIInput="SR"/>
                        </dd>
                    </dl>
                    <dl>
                        <dt CL="STD_USRID1">영업사원ID</dt>
                        <dd>
                            <input type="text" class="input" name="SH.USRID1" UIInput="SR"/>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_DEPTID5">사업장ID</dt>
                        <dd>
                            <select type="text" class="input" Combo="Wms,DEPTID" name="SH.DEPTID1" id="DEPTID" ComboType="MS">
                            </select>
                        </dd>
                    </dl>                    
                    <dl>
                        <dt CL="STD_KDGRP">고객그룹</dt>
                        <dd>
