	function gridListEventItemGridSearch(gridId, rowNum, itemGridList){
	    if(gridId == "gridList"){
	        var param = getItemSearchParam(rowNum);
	
	        gridList.gridList({
	            id : "gridListSub",
	            param : param
	        });
	        dblIdx = rowNum;
	        subIdx = rowNum;
	    }
	}
	
	function getItemSearchParam(rowNum){
	    var rowData = gridList.getRowData("gridList", rowNum);
	    var param = inputList.setRangeParam("searchArea");
	    param.putAll(rowData);
	
	    return param;
	}
	
	function gridListEventDataBindEnd(gridId, dataLength){
	    if(gridId == "gridList" && dataLength > 0){
	        headFocusNum = 0;
	        
	        if(searchType == 1){
	            getItemSearchParam(0);
	            gridList.checkAll('gridList',true);
	        }else if(searchType == 2){
	            searchSubItemList(0);
	        }
	    }else if(gridId == "gridListSub" && dataLength > 0){
	        for (var i = 0; i < dataLength; i++) {
	            var statit =  gridList.getColData(gridId,i,"STATIT");
	            if(statit == 'FPC' || statit == 'PCK'){
	                //gridList.setRowReadOnly(gridId, i, "rowCheck");
	            }
	        }
	    }
	}
	
	function searchSubItemList(rowNum){
	    gridList.resetGrid("gridListSub");
	    
	    var shpoky = gridList.getColData("gridList", rowNum, "SHPOKY");
	    
	    var param = inputList.setRangeParam("searchArea");
	    param.put("SHPOKY", shpoky);
	
	    gridList.gridList({
	        id : "gridListSub",
	        command : "DL04I",
	        param : param
	    });
	
	    headFocusNum = rowNum;
	    dblIdx = rowNum;
	    subIdx = rowNum;
	}
	
	function searchList(){
	    if(validate.check("searchArea")){
	        var param = inputList.setRangeParam("searchArea");
	        searchType = 1;
	        param.put("PROGID", menuky);
	        
	        gridList.resetGrid("gridList");
	        gridList.resetGrid("gridListSub");
	        
	        gridList.gridList({
	            id : "gridList",
	            url : "/wms/outbound/json/DL04HEAD.data",
	            param : param
	        });
	        
	        gridList.setReadOnly("gridList", false);
	        gridList.setReadOnly("gridList", true, ["PRTCHK"]);
	    }		        

	}
	
	function gridExcelDownloadEventBefore(gridId){
	    if(gridId == "gridList"){
	        var param = inputList.setRangeParam("searchArea");
	        param.put("PROGID", menuky);
	        return param;
	    }else if(gridId == "gridListSub"){
	        var rowNum = gridList.getSearchRowNum("gridList");
	        if(rowNum == -1){
	            return false;
	        }else{
	            var param = getItemSearchParam(rowNum);
	            return param;
	        }
	    }
	}
	
	
	//할당
	function allocate(){
	    if(gridList.validationCheck("gridList", "select") && gridList.validationCheck("gridListSub", "data")){
	        var head = gridList.getSelectData("gridList");
	        var list = gridList.getGridData("gridListSub");
	        var param = new DataMap();
	        
	        if(head.length == 0){
	            commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
	            return;
	        }
	        
	        if(list.length == 0){
	            commonUtil.msgBox("OUT_M0045"); //처리를 위한 아이템이 존재하지 않습니다.
	            return;
	        }
	        
	        if(!commonUtil.msgConfirm("OUT_M0081")){ //할당 작업을 하시겠습니까?
	            return;
	        }
	
	        var headSelectList = gridList.getSelectRowNumList("gridList");
	        for(var i=0;i<headSelectList.length;i++){
	            var statdo = gridList.getColData("gridList", headSelectList[i], "STATDO");  //Head상태
	            
	            if(dblIdx == headSelectList[i]){
	                param.put("headModifyIndex", i);
	            }
	            //Head 할당완료 상태이면 밸리데이션 check
	            if(statdo == "FAL"){
	            	
	            	var list = gridList.getGridData("gridList");
	            	
	    			for(var j=0; j < list.length; j++) {
	    				
	    				var STATDO = list[j].get("STATDO");
	    				
	    				if(STATDO=="FAL" && gridList.getColData("gridList", j, "INDCHK") == "V"){
	    					
	    					    commonUtil.msgBox("OUT_M0204", j+1);   //[{0}]번째 행은 이미 할당완료 상태입니다.
	    		                gridList.setColFocus("gridList", j, "STATDO");
	    		                return;
	    				}
	    			}
	    			
	            }else if(statdo == "FSH" || statdo == "PSH"){ //Head 부분출고 또는 출고완료 상태이면 밸리데이션 
	            	commonUtil.msgBox("OUT_M0205");   //부분출고 또는 출고완료 상태이면 할당이 불가능합니다.
	                gridList.setColFocus("gridList", j, "STATDO");
	                return;
	            	
	            }
	            
	        }
	        
	        var headChkLen = gridList.getSelectRowNumList("gridList").length;
	        if(headChkLen > 0 && dblIdx == subIdx){
	            var HeadGridSvbeln = gridList.getColData("gridList", dblIdx, "SVBELN");
	            var HeadGridShpoky = gridList.getColData("gridList", dblIdx, "SHPOKY");
	        }
	        
	        param.put("head", head);
	        param.put("list", list);
	        param.put("HeadGridSvbeln", HeadGridSvbeln);
	        param.put("HeadGridShpoky", HeadGridShpoky);
	        
	        var json = netUtil.send({
	            url : "/wms/outbound/json/AssignDL04.data",
	            param : param,
	            successFunction : "allocateSuccess"
	        });
	    }
	    
	    
	}
	
	function allocateSuccess(json){
	    if(json && json.data){
	    	
	    	if(!json.data.CNT && json.data.SHPOKY){
	    		commonUtil.msgBox("OUT_M0195", json.data.SHPOKY); 
	    	}else{
	    		
	    		var resultCnt = new Number(json.data.RESULT);
	   			
	    		if(resultCnt > 0){
		    		//commonUtil.msgBox("OUT_M0150"); // 할당 완료되었습니다.
		    		commonUtil.msgBox("OUT_M0228",resultCnt); // 할당이 [{0}]건 처리되었습니다.
			        paramH =  inputList.setRangeParam("searchArea");
			        paramH.put("SHPOKY", json.data["SHPOKY"]);
			        
			        gridList.resetGrid("gridList");
			        gridList.resetGrid("gridListSub");
			        
			        searchType = 2;
			        reSearchList();
	    		}else{
	    			commonUtil.msgBox("OUT_M0229"); //할당처리가 되지 않았습니다.
	    		}
	    		
	    		
	    	}
	    		        	        	        
	    }
	}
	
	//할당취소
 	function unallocate(unalType){
	    var head = gridList.getSelectData("gridList");
	    var list;
	    
	    
	    if(unalType == "PCN"){ //부분 할당취소
	    	list = gridList.getSelectData("gridListSub");
	    }else{ //할당취소
	    	list = gridList.getGridData("gridListSub");
	    }
	    
		
	    if(head.length == 0){
	        commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 업습니다.
	        return;
	    }
	
	    if(list.length == 0){
	        commonUtil.msgBox("OUT_M0045");  //처리를 위한 아이템이 존재하지 않습니다.
	        return;
	    }
		
	    if(unalType != "PCN"){ 
	    		    
		  //할당완료된 데이터만 할당취소 가능(HEAD기준)
		    var SelectList = gridList.getSelectRowNumList("gridList");
		    for(var i=0; i< SelectList.length; i++){
		        var statdo = gridList.getColData("gridList", SelectList[i], "STATDO"); //HEAD상태
		        var statdo = gridList.getColData("gridList", SelectList[i], "STATDO"); //HEAD상태
		        
		        if(statdo != "FAL" && statdo != "PAL"){
		            commonUtil.msgBox("OUT_M0184"); //출고문서 상태가 할당완료or부분할당일 경우에만 취소 가능합니다.
		            return;
		        }
		    } 
	    }else{
	    	
			    
			    //할당완료된 데이터만 할당취소 가능(item기준)
			    var itemSelectList = gridList.getSelectRowNumList("gridListSub");
			    for(var i=0; i<list.length; i++){
			        var statit = gridList.getColData("gridListSub", itemSelectList[i], "STATIT"); //item상태
			        var statnm = gridList.getColData("gridListSub", itemSelectList[i], "STATNM"); //item상태명
			        var shpoky = gridList.getColData("gridListSub", itemSelectList[i], "SHPOKY"); //출하문서번호
			        var shpoit = gridList.getColData("gridListSub", itemSelectList[i], "SHPOIT"); //출하문서순번
			        var qttaor = gridList.getColData("gridListSub", itemSelectList[i], "QTTAOR"); //출하문서순번
			        
			        
			        if((statit == "NEW" && qttaor < 0) || statit == "PPC" || statit == "PCK"){
			            commonUtil.msgBox("VALID_M0024",[shpoky,shpoit,statnm]); //[출하문서번호:{0}, 출하문서순번: {1}]는 {2}상태로 할당취소 대상이 아닙니다.
			            return;
			        }
			    } 
	    }
	    
	    
	    if(!commonUtil.msgConfirm("OUT_M0153")){ //할당 취소하시겠습니까?
	        return;
	    }

	    var headChkLen = gridList.getSelectRowNumList("gridList").length;
	    if(headChkLen > 0 && dblIdx == subIdx){
	        var HeadGridShpoky = gridList.getColData("gridList", dblIdx, "SHPOKY");
	    }
	    
	    var param = new DataMap();
	    param.put("head", head);
	    param.put("list", list);
	    param.put("HeadGridShpoky", HeadGridShpoky);
	    param.put("unalType", unalType);
	    
	    var json = netUtil.sendData({
	        url : "/wms/outbound/json/UnallocateDL04.data",
	        param : param
	    });
	
	    if(json && json.data){
	        var errormsg = json.data["ERRMSG"];
	 
	        if(errormsg != "OK"){
	            commonUtil.msgBox("OUT_M0184"); //출고문서 상태가 할당완료or부분할당일 경우에만 취소 가능합니다.
	            return;
	        }
	        
	        if(json.data["MSG"] && json.data["MSG"] != "SUCCESS"){
	            commonUtil.msgBox(json.data["MSG"]);	            
	        }else{	        
	        	commonUtil.msgBox("OUT_M0154"); //할당 취소되었습니다.
	        }
	        gridList.resetGrid("gridList");
	        gridList.resetGrid("gridListSub");
			
	        
	        dblIdx = 0;
	        searchType = 2;
	
	        paramH =  inputList.setRangeParam("searchArea");
	        paramH.put("SHPOKY", json.data["SHPOKY"]);
	        reSearchList();
	
	    }
	}
	
	//할당전략키 validation
	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
	    if(gridId == "gridListSub" && colName == "ALSTKY"){
	    	
	        if(colValue != ""){
	            var param = new DataMap();
	            
	            param.put("ALSTKY", colValue);
	            param.put("WAREKY", "<%=wareky%>");
	            
	            var json = netUtil.sendData({
	                module : "WmsOutbound",
	                command : "ALSTKYval",
	                sendType : "map",
	                param : param
	            });
	            
	            if (json.data["CNT"] < 1) {
	                commonUtil.msgBox("VALID_M0211", colValue);
	                
	                gridList.setColValue("gridListSub", rowNum, "ALSTKY", "");
	                gridList.setColFocus(gridId, rowNum, colName);
	            }
	        } 
	    }
	}
	
	function inputListEventRangeDataChange(rangeName, singleData, rangeData){
	    if(rangeName == "SH.SHPOKY" || rangeName == "SI.SVBELN" || rangeName == "SI.SEBELN" || rangeName == "SI.SKUKEY"){
	        var dataCount = inputList.getDataCount("SH.SHPOKY")
	                      + inputList.getDataCount("SI.SVBELN")
	                      + inputList.getDataCount("SI.SEBELN")
	                      + inputList.getDataCount("SI.SKUKEY");
	        if(dataCount == 0){
	            var now = new Date();
	            now.setDate(now.getDate());
	            var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
	            $("#searchArea").find("[name=RQSHPD]").val(tmpValue);
	            inputList.addValidation("RQSHPD", "required");
	        }else{
	            $("#searchArea").find("[name=RQSHPD]").val("");
	            inputList.removeValidation("RQSHPD", "required");
	        }
	    }
	}
	
	function linkPopCloseEvent(){
	    //searchList();
	    searchType = 3;
	    headFocusNum = gridList.getFocusRowNum("gridList"); 
	    
	    searchSubItemList(headFocusNum);
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType, $inputObj){
	    var param = new DataMap();
	    if(searchCode == "SHCMCDV"){
	        param.put("CMCDKY", "STATDO");
	        return param;
	    }else if(searchCode == "SHSTLMAP"){
	    	
	    	var PLNTKY = $('select[name="SI.LOTA02"]').val();
			
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("PLNTKY", PLNTKY);
	    	
	    	return param;
	    }else if(searchCode == "SHBZPTN"){
			param.put("PTNRTY", "CT");
			param.put("OWNRKY", "<%=ownrky%>");			
			return param;
		}
	    
	}
	
	function commonBtnClick(btnName){
		
	    if(btnName == "Search"){
	        searchList();
	    }else if(btnName == "SubSave"){
			subsaveData(); 
		}else if(btnName == "Allocate"){
	        allocate();
	    }else if(btnName == "Wcancle"){
	        unallocate("FCN");
	    }else if(btnName == "SubWcancle"){
	    	unallocate("PCN");
	    }else if(btnName == "printPlShpping"){
	    	printPlShpping();
	    }else if(btnName == "printAlShpping"){
	    	printAlShpping();
	    }else if(btnName == "printShpping"){
	    	printShpping();
	    }else if(btnName == "printUnShpping"){
	    	printUnShpping();
	    }else if(btnName == "TotalPickingCreate"){
	        TotalPickingCreate();
	    }else if(btnName == "TotalPickingList"){
	    	TotalPickingList();
	    }else if(btnName == "ReflectAlstky"){
			setAlstky();
        }else if(btnName == "PePrint"){
            PePrintList();
		}else if(btnName == "RcvSap") {
			callSapFunc();
		}else if(btnName == "UnStknum"){
			UnStknum();
		}else if(btnName == "RcvStk"){
			callStkFunc();
		}
	    /* 
	    else if(btnName == "Save"){
	        saveData();
	     }
	    */
	    
	}
	function LocPopCallback(data) {
		
		var STKNUM = data.get("STKNUM");
		var type = data.get("SSHTYP");
		
		var sCnt = 0;
		var fCnt = 0;
		var fArr = new Array();
		var ifid = "";
		
		if(type == "221"){ //이송출고
 			ifid = "WMS_IFS302";
		}else{ // 판매출고
			ifid = "WMS_IFS301";
		}
		
		var param = new DataMap();
		param.put("IFID", ifid );
		param.put("IFTBL", "IFWMS113");
		param.put("BWART", "");
		param.put("RFCFN", "Z_WMS_DELIVERY_TYPE_INFO_2");
		param.put("RFCTBL", "T_DELINFO");
		param.put("RFCP1", "");
		param.put("RFCP2", "");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("WERKS", ""); // SAP재고 수신 : 플랜트 셋팅
		param.put("GUBUN", "T");	
		param.put("TKNUM", STKNUM);	

		var json = netUtil.sendData({
			url : "/rfc/json/rfcCall.data",
			param : param,
		});	
			
		if (json.row_count > 0) { 
			sCnt++;
		} else {
			fArr.push(STKNUM);
			fCnt++;
		}
		
        if (sCnt + fCnt > 0) { 	
        	commonUtil.msgBox("수신 ["+sCnt+"]건, 미수신 ["+fCnt+"]건" + (fCnt > 0 ? " ("+fArr.toString()+")": "" ));
        } else {
        	commonUtil.msgBox("ITF_M0036");
        }

	}
	
	function callStkFunc() {
		page.linkPopOpen("/wms/outbound/DL04STKPOP.page",'', "height=200,width=500,resizable=yes");
	}
	
	function callSapFunc() {
		
		var chkHeadList = gridList.getSelectData("gridList");
		var chkHeadLeng = chkHeadList.length;
		
	 	if( chkHeadLeng <= 0 ){
        	commonUtil.msgBox("VALID_M0006"); // 선택된 아이템이 없습니다.
            return;
        } else {
	   		//출고완료 건 return 처리
			for ( var i = 0 ; i < chkHeadLeng ; i++) {
		 		var param = new DataMap();
       			param.put("SHPOKY", chkHeadList[i].get("SHPOKY"));
       			
	   			var json = netUtil.sendData({
					module : "Erpif",
					command : "WMS_IFS301_STATDO",
					sendType : "map",
					param : param
				});
	   			
				if (json && json.data) { // 할당하고 NEW
					if ( json.data["STATDO"] != "NEW" )  //미작업이나 할당완료가 아니면 RETURN
					 {
						alert("출하문서번호 [" + chkHeadList[i].get("SHPOKY") + "]는 출고진행중입니다. \n미작업 상태에서 변경 수신이 가능합니다.");
	   					return;
					}
				}
		 	}

    		// 데이터 수신요청
   			// LOOP START
			var sCnt = 0;
			var fCnt = 0;
			var fArr = new Array();
			var ifid = "";
			
   	        for ( var i = 0 ; i < chkHeadLeng ; i++) {
       			var param = new DataMap();///이송은 221(302)판매출고 201()
       			if(chkHeadList[i].get("DOCUTY") == "221" ) {
       				ifid = "WMS_IFS302";
       			} else if (chkHeadList[i].get("DOCUTY") == "201") {
       				ifid = "WMS_IFS301";
       			} else {
       				ifid = " ";
       				break;
       			}
       				
       			param.put("IFID", ifid );
       			param.put("IFTBL", "IFWMS113");
       			param.put("BWART", "");
       			param.put("RFCFN", "Z_WMS_DELIVERY_TYPE_INFO_2");
       			param.put("RFCTBL", "T_DELINFO");
       			param.put("RFCP1", "");
       			param.put("RFCP2", "");
       			param.put("OWNRKY", "<%=ownrky%>");
       			param.put("WERKS", ""); // SAP재고 수신 : 플랜트 셋팅
   	    		param.put("VBELN", chkHeadList[i].get("SVBELN")); // 출고예정정보 실시간 수신 : 납품문서 셋팅
       			param.put("GUBUN", "S");	
	   			
	    		var json = netUtil.sendData({
	    			url : "/rfc/json/rfcCall.data",
	    			param : param,
	    		});	
       			
				if (json.row_count > 0) { 
					sCnt++;
				} else {
					fArr.push(chkHeadList[i].get("SHPOKY"));
					fCnt++;
				}

	        } //LOOP END 
	        
   	        if (sCnt + fCnt > 0) { 	
   	        	commonUtil.msgBox("수신 ["+sCnt+"]건, 미수신 ["+fCnt+"]건" + (fCnt > 0 ? " ("+fArr.toString()+")": "" ));
   	        } else {
   	        	commonUtil.msgBox("ITF_M0036");
   	        }
	        
		}
		
	}
	
	
