											<td GH="100 STD_USEQTY" GCol="text,USEQTY" GF="N 20,3">가용수량</td>
											<td GH="100 STD_QTTAOR" GCol="input,QTTAOR" GF="N 20,3" validate="required gt(0)">작업수량</td>
											<td GH="100 STD_UOMKEY" GCol="text,UOMKEY">단위</td>
											<!-- 사유코드 -->
											<td GH="100 STD_RSNCOD" GCol="select,RSNCOD">
												<select Combo="WmsTask,TK01_RSNCD_SET" >
													<option value=" "></option>
