	function mkRollListReqFieldArr(){
		
		var reqFieldArr = new Array();
		var reqFieldMap = new DataMap();
		
		reqFieldMap.put("id","BARCNO");
		reqFieldMap.put("label","STD_BARCNO");
		reqFieldArr.push(reqFieldMap);
		
		reqFieldMap = new DataMap();
