			param.put("WAREKY", "<%= wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
			return param;
		}
		
	}
	
	function commonBtnClick(btnName){
		
		if(btnName == "Search"){
			searchList();
		}else if(btnName == "Save"){
			saveData();
		}else if(btnName == "Print"){
			reportPrint();
		}else if(btnName == "inboundAdd"){
			fnInboundAdd();
		}else if(btnName == "Reflect"){
			setSTLKY();
		}else if(btnName == "Wcancle"){
			deleteData();
		}
		
	}
	
	function saveData(){
		
		var headGridId = "gridList";
		var itemGridId = "gridConfirmList";
		var subGridId  = "gridListSub";
		
		var skuGrpMengeList = new Array(); // 품목별 전체 오더수량 합계 목록
		var chkHeadList = new Array();
		
		if(gridList.validationCheck(itemGridId, "select")){
			
			/*
			var chkItemIdx = gridList.getSelectRowNumList(itemGridId);
			var chkItemLen = chkItemIdx.length;	
			if( chkItemLen == 0 ){
				commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
				return;
			}
			*/
			var chkItemList = gridList.getGridData(itemGridId); // 입고리스트 체크 목록
			if( chkItemList.length == 0 ){
				commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
				return;
			}
			
			var headRowNum = gridList.getFocusRowNum(headGridId);
	        var headRowdata = gridList.getRowData(headGridId, headRowNum);
	        
	        var sebeln = headRowdata.get("SEBELN");
	        
	        chkHeadList.push(headRowdata);
			
			var BEDAT = headRowdata.get("BEDAT");
	        if($.trim(BEDAT)==""){
		        gridList.setColFocus(headGridId, headRowNum, "BEDAT");
				var STD_ORDDAT = commonLabel.getLabel("STD_ORDDAT", 1);
				commonUtil.msgBox("VALID_required",[STD_ORDDAT]); // {0} 은(는) 필수 입력항목입니다.
				return false;
	        }
	        
	        var statdo = headRowdata.get("STATDO");
	        if("NEW"!=statdo){
	        	commonUtil.msgBox("VALID_M2090");// 입고완료 문서는 입고할수없습니다.
				return;
	        }
	        
			//var chkItemList = gridList.getGridData(itemGridId); // 입고리스트 체크 목록 
			
			skuGrpMengeList = getSkukeyGrpMengeList(); // 품목별 오더수량 합계 리스트
			
			// 품목별 입고수량 계산 
			for(var i=0;i<skuGrpMengeList.length;i++){
				
				var skuRowData   = skuGrpMengeList[i];
				var skuSkukey    = skuRowData["SKUKEY"]; // 품목키
				var skuMenge     = skuRowData["MENGE"];   // 오더수량
				var skuQtyrcvSum = 0;
				var focusGRowNum = -1;
			
				for(var j=0;j<chkItemList.length;j++){
					var conRowData = chkItemList[j];
					var conSkukey = conRowData.get("SKUKEY");
					var conQtyrcv = conRowData.get("QTYRCV");
					var conGRowNum = conRowData.get("GRowNum");
					
					if(skuSkukey==conSkukey){
						skuQtyrcvSum = skuQtyrcvSum + Number(conQtyrcv);
						if(focusGRowNum==-1){
							focusGRowNum = conGRowNum;
						}
					}
				}
				//skuRowData["QTYRCV_SUM"] = skuQtyrcvSum;
				//console.log(i + " - skuSkukey : " + skuSkukey + " - skuMenge : " + skuMenge + " - skuQtyrcvSum : " + skuQtyrcvSum);
				
				if(Number(skuMenge) < Number(skuQtyrcvSum) ){
					commonUtil.msgBox("VALID_M0964",[skuSkukey,comma(skuMenge),comma(skuQtyrcvSum)]); // 품목[{0}]의 오더수량[{1}]보다 입고수량[{2}]이 많을 수없습니다.
					gridList.setColFocus(itemGridId, focusGRowNum, "QTYRCV");
					return;
				}
				
			}
			
			for(var i=0;i<chkItemList.length;i++){
				var rowData = chkItemList[i];
				var rowNum = rowData.get("GRowNum");
				
				var QTYRCV = new Number(rowData.get("QTYRCV")); //입고수량
				if(QTYRCV <= 0){
					commonUtil.msgBox("IN_M0062");		// * 입고수량을 입력하여 주세요
					gridList.setColFocus(itemGridId, rowNum, "QTYRCV");
					return;
				}
				
				var LOTA14 = rowData.get("LOTA14"); // 개별바코드
				if(LOTA14==""||LOTA14==" "){
					gridList.setColFocus(itemGridId, rowNum, "LOTA14");
	            	commonUtil.msgBox("VALID_M2063");// 개별바코드가 없는 문서가 존재하여 입고를 할 수 없습니다.
	                return;
	            }
				
				var NETWT = new Number(rowData.get("NETWT")); // Net Weight_중량
				if(NETWT <= 0){
					var STD_NETWT = commonLabel.getLabel("NETWT", 1);
					commonUtil.msgBox("VALID_M0956", [STD_NETWT]); // [{0}] 수량을 입력하여 주세요
					gridList.setColFocus(itemGridId, rowNum, "NETWT");
					return;
				}
				
				var WGTMUL = new Number(rowData.get("WGTMUL")); // 중량배수
				if(WGTMUL <= 0){
					var STD_WGTMUL = commonLabel.getLabel("WGTMUL", 1);
					commonUtil.msgBox("VALID_M0956", [STD_WGTMUL]); // [{0}] 수량을 입력하여 주세요
					gridList.setColFocus(itemGridId, rowNum, "WGTMUL");
					return;
				}
				
				var QTYRCV1 = new Number(rowData.get("QTYRCV1")); //입고가능수량
				if(QTYRCV1 <= 0){
					var STD_QTYRCV1 = commonLabel.getLabel("QTYRCV1", 1);
					commonUtil.msgBox("VALID_M0956", [STD_QTYRCV1]); // [{0}] 수량을 입력하여 주세요
					gridList.setColFocus(itemGridId, rowNum, "QTYRCV1");
					return;
				}
				
				if(QTYRCV>QTYRCV1){
					commonUtil.msgBox("IN_M0078");      //입고수량은 입고가능수량보다 클 수 없습니다.
					gridList.setColFocus(itemGridId, rowNum, "QTYRCV");
					return;
				}
				
			}
			
			var rollMaCntMap = getRollMaCountMap(sebeln);
			//console.log("rollMaCntMap : " + JSON.stringify(rollMaCntMap));
			var cnt = rollMaCntMap.CNT;
			if(cnt!=chkItemList.length ){
				commonUtil.msgBox("VALID_M2114");  // 전체 데이터를 입고처리 해주세요.
				return;
			}
			
			//저장하시겠습니까?
			if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){
				return;
			}
			
			var head = new Array();
			headSebeln = headRowdata.get("SEBELN");
			head.push(headRowdata);
			var list = gridList.getSelectData("gridConfirmList");
			
			//console.log("headSebeln : " + headSebeln);
			//console.log("head : " + JSON.stringify(head));
			//console.log("list : " + JSON.stringify(list));
			
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("head", head); 
			param.put("list", list);
			param.put("headSebeln", headSebeln);
			param.put("PROGID", configData.MENU_ID);
			param.put("QTYCHKYN", "N");  // 이송입고일경우 wms 관리대상 체크하는데 제외 플래그
			param.put("ROLLYN", "Y");    // 수입미롤 여부
			
			
			param.put("headList", head);
			param.put("messageOption", {
				total_count : param.map.headList.length,
                current_count : 1,
                message   : commonUtil.getMsg("IN_M0153")//"입고 진행중입니다."
            })
            
            sucCount = 0;
        	errCount = 0;
        	msgHtml = "";
			var json = sendSave(param);
			
			
			
			return;
			
			var json = netUtil.sendData({
				//url : "/wms/inbound/json/SaveGR02.data",
				url : "/wms/inbound/json/SaveGR02New.data",
				param : param
			});
			
			if(!json.data){
				commonUtil.msgBox("SYSTEM_SAVEFAIL");
				return;
			}
			
			if(json.data && json.data.RESULTMSG ){
				var msgList = json.data.RESULTMSG.split("†");
				var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
				commonUtil.msg(msgTxt);
				return;
			}
			
			if(json && json.data){
				
				dblIdx = -1;
				
				var inRsCode = json.data.inRsCode; // 입고저장 결과코드
                var inRsMsg = json.data.inRsMsg;   // 입고저장 결과 메시지
				
				var ifRsCode = json.data.ifRsCode; // 인터페이스 전송 결과코드
                var ifRsMsg = json.data.ifRsMsg;   // 인터페이스 전송 결과 메시지
                
                var totCnt = json.data.totCnt;     // 입고 전체 건수
                var sucCnt = json.data.sucCnt;     // 입고 성공 건수
                var failCnt = json.data.failCnt;   // 입고 실패 건수 
                
                var sucList = json.data.sucList;   // 입고 성공 오더목록 ( 부분입고 여부 확인 불가 )
                
                console.log("전체 : " + totCnt + " - 성공 : " + sucCnt + " - 실패 : " + failCnt);
            	console.log("inRsCode : " + inRsCode);
            	console.log("ifRsCode : " + ifRsCode);
            	console.log("sucList : " + sucList);
            	
            	if(inRsCode != "S" && ifRsCode != "S"){
            		console.log("inRsMsg : " + inRsMsg);
            		console.log("ifRsMsg : " + ifRsMsg);
            		//commonUtil.msgBox("VALID_M0950"); // 입고 저장에 실패하였습니다.
            		//commonUtil.msgBox("VALID_M0953",[totCnt,sucCnt,failCnt]); // 저장 및 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            		var msgTxt = commonUtil.getMsg("VALID_M0953",[totCnt,sucCnt,failCnt]); // 저장 및 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            		alert(msgTxt + "\n" + inRsMsg + "" + ifRsMsg);
            		saveRsReadonly(sucList,chkHeadList,headSebeln);
            	}else if(inRsCode != "S"){
                	console.log("inRsMsg : " + inRsMsg);
                	//commonUtil.msgBox("VALID_M0950"); // 입고 저장에 실패하였습니다.
                	//commonUtil.msgBox("VALID_M0951",[totCnt,sucCnt,failCnt]); // 입고 저장에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
                	var msgTxt = commonUtil.getMsg("VALID_M0951",[totCnt,sucCnt,failCnt]); // 입고 저장에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
                	alert(msgTxt + "\n" + inRsMsg);
                	saveRsReadonly(sucList,chkHeadList,headSebeln);
            	}else if(ifRsCode != "S"){
                	console.log("ifRsMsg : " + ifRsMsg);
                	//commonUtil.msgBox("VALID_M0942"); // 인터페이스 전송에 실패하였습니다.
                	//commonUtil.msgBox("VALID_M0952",[totCnt,sucCnt,failCnt]); // 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
                	var msgTxt = commonUtil.getMsg("VALID_M0952",[totCnt,sucCnt,failCnt]); // 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
                	alert(msgTxt + "\n" + ifRsMsg);
                	saveRsReadonly(sucList,chkHeadList,headSebeln);
                }else{
                	//commonUtil.msgBox("MASTER_M0564"); // 저장 완료되었습니다.
                	commonUtil.msgBox("VALID_M0954",[totCnt,sucCnt,failCnt]); // 저장 완료되었습니다. 전체[{0}] 성공[{1}] 실패[{2}]
                	/*
                	gridList.resetGrid("gridList");
    				gridList.resetGrid("gridListSub");
    				searchList();
    				*/
    				saveRsReadonly(sucList,chkHeadList,headSebeln);
    				
                }
				
            	/*
				var ifRsCode = json.ifRsCode; // 인터페이스 전송 결과코드
                var ifRsMsg = json.ifRsMsg;   // 인터페이스 전송 결과 메시지
            	console.log("ifRsCode : " + ifRsCode);            	
                if(ifRsCode != "S"){
                	console.log("ifRsMsg : " + ifRsMsg);
                	commonUtil.msgBox("VALID_M0942"); // 인터페이스 전송에 실패하였습니다.
                }else{
                	commonUtil.msgBox("MASTER_M0564");
                }
                */
                /*
				gridList.resetGrid("gridList");
				gridList.resetGrid("gridConfirmList");
				searchList();
				*/
			}
		}
	}
	
	
	var sucCount = 0;
    var errCount = 0;
    var msgHtml = "";
    // 20220907 저장방식 변경됨.
	function sendSave(param, recall){
        
		var current_count = param.map.messageOption.current_count;
		var total_count = param.map.messageOption.total_count;
		
    	if(total_count == 1){
    		sucCount = 0; 
    	    errCount = 0;
    	    msgHtml = "";
    	}
		
		if(param.map.messageOption){
        	netUtil.processMessage(param);
	    }
		
		var loopHeadList = new Array();
		loopHeadList.push(param.map.headList[current_count-1]);
		param.put("head", loopHeadList);
		
        var json;
		
        setTimeout(function(){
        	json = netUtil.sendData({
                url : "/wms/inbound/json/SaveGR02New.data",
                param : param,
                async : true,       // 응답없는 메시지 제거를위해 비동기 처리
                loading : true,     // 전체완료될때까지 로딩 유지
                recall : recall,    // 로딩이미지 적용을위해 재귀호출시 필요
                callBackFunction : function(returnData){
                	
                	var inRsCode = returnData.data.inRsCode; // 입고저장 결과코드
                    var inRsMsg = returnData.data.inRsMsg;   // 입고저장 결과 메시지
    				
    				var ifRsCode = returnData.data.ifRsCode; // 인터페이스 전송 결과코드
                    var ifRsMsg = returnData.data.ifRsMsg;   // 인터페이스 전송 결과 메시지
                    
                    var totCnt = returnData.data.totCnt;     // 입고 전체 건수
                    var sucCnt = returnData.data.sucCnt;     // 입고 성공 건수
                    var failCnt = returnData.data.failCnt;   // 입고 실패 건수
                    
                    console.log("전체 : " + totCnt + " - 성공 : " + sucCnt + " - 실패 : " + failCnt);
                	console.log("inRsCode : " + inRsCode);
                	console.log("ifRsCode : " + ifRsCode);
                	console.log("inRsMsg : " + inRsMsg);
                	console.log("ifRsMsg : " + ifRsMsg);
                	//console.log("sucList : " + sucList);
                	
                	if(inRsCode != "S" && ifRsCode != "S"){
                		msgHtml += "\n" + inRsMsg + "" + ifRsMsg;
                		errCount++;
                	}else if(inRsCode != "S"){
                    	msgHtml += "\n" + inRsMsg;
                    	errCount++;
                	}else if(ifRsCode != "S"){
                    	msgHtml += "\n" + ifRsMsg;
                    	errCount++;
                    }else{
                    	sucCount++;
                    }
                	
                	if(total_count > current_count){
                		sendSave(param, true);
                    }else{
                    	netUtil.processMessageOff();
                        commonUtil.msgBox("실패:"+errCount +", 성공:"+sucCount+msgHtml); //관리자에게 문의 바랍니다.
                        
                    	searchList();
                    }
                }
            });
        }, 100);
    }
    
	
	function getSkukeyGrpMengeList(){
		
		var headGridId = "gridList";
		var headRowNum = gridList.getFocusRowNum(headGridId);
		var headRowdata = gridList.getRowData(headGridId, headRowNum);
		var headSebeln = headRowdata.get("SEBELN");
		
		var skuGrpMengeList = new Array();
		
		var param = new DataMap();
		param.put("SEBELN", headSebeln);
		param.put("WAREKY", "<%= wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
	
		// 품목별 오더수량 합계 조회
		var json = netUtil.sendData({
			module : "WmsInbound",
			command : "GR40_SKUKEY_GRP",
			sendType : "list",
			param : param
		});
		//console.log("getLotaInfo : " + JSON.stringify(json));
		if (json.data){
			skuGrpMengeList = json.data;
		}
		return skuGrpMengeList;
	}
	
	// 콤마찍기
    function comma(str) {
        str = String(str);
        return str.replace(/(\d)(?=(?:\d{3})+(?!\d))/g, '$1,');
    }
	
  	// 콤마풀기
    function uncomma(str) {
        str = String(str);
        return str.replace(/[^\d]+/g, '');
    }
	
	function setStlmInfo(gridId, rowNum){
		
		var param = new DataMap();
		
		var SEBELN = gridList.getColData(gridId, rowNum, "SEBELN");
		var SEBELP = gridList.getColData(gridId, rowNum, "SEBELP");
		var SKUKEY = gridList.getColData(gridId, rowNum, "SKUKEY");
		var LOTA01 = gridList.getColData(gridId, rowNum, "LOTA01");
		var LOTA02 = gridList.getColData(gridId, rowNum, "LOTA02");
		
		
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		
		param.put("SEBELN", SEBELN);
		param.put("SEBELP", SEBELP);
		param.put("SKUKEY", SKUKEY);
		
		param.put("LOTA01", LOTA01);
		param.put("LOTA02", LOTA02);
		
		param.put("PROGID", configData.MENU_ID);
		
		var json = netUtil.sendData({
			module : "WmsInbound",
			command : "GR40_STLM",
			sendType : "map",
			param : param
		});
		
		if(json.data){
			$.each(json.data, function(key, value) {
			    gridList.setColValue(gridId, rowNum, key, value);
			});
			
		}
		
	}
	
	function setUOMInfo(gridId, rowNum){
		
		var param = new DataMap();
		
		var SKUKEY = gridList.getColData(gridId, rowNum, "SKUKEY");
		var UOMKEY = gridList.getColData(gridId, rowNum, "UOMKEY");
		var QTYRCV = gridList.getColData(gridId, rowNum, "QTYRCV");
		
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("WAREKY", "<%=wareky%>");
		param.put("SKUKEY", SKUKEY);
		param.put("QTY", QTYRCV);
		param.put("UOMKEY", UOMKEY);
		
		var json = getUOMQTYInfo(gridId, rowNum, param)
		
		var UOMQTY = json.data["UOMQTY"];
		
		var TOT = json.data["TOT"];
		var BAG = json.data["BAG"];
		var BOX = json.data["BOX"];
		var PLT = json.data["PLT"];
		var SOK = json.data["SOK"];
		var EA = json.data["EA"];
		var MUOMKEY = json.data["MUOMKEY"];
		
		gridList.setColValue(gridId, rowNum, "UOMQTY", UOMQTY);
		gridList.setColValue(gridId, rowNum, "TOT", TOT);
		gridList.setColValue(gridId, rowNum, "BAG", BAG);
		gridList.setColValue(gridId, rowNum, "BOX", BOX);
		gridList.setColValue(gridId, rowNum, "PLT", PLT);
		gridList.setColValue(gridId, rowNum, "SOK", SOK);
		gridList.setColValue(gridId, rowNum, "EA", EA);
		//gridList.setColValue(gridId, rowNum, "MUOMKEY", MUOMKEY);
		
	}
	
	function getUOMQTYInfo(gridId, rowNum, param){
		
		var json = netUtil.sendData({
			module : "WmsInbound",
			command : "UOMQTYval",
			sendType : "map",
			param : param
		});
		
		return json;		
	}
	
	function fnInboundAdd(){
		
		var subGridId = "gridListSub";
		var rollGridId = "gridListSubRoll";
		var confirmGridid = "gridConfirmList";
		
		// 상세리스트 목록
	    var subRowNum = gridList.getFocusRowNum(subGridId);
	    var subItemData = gridList.getRowData(subGridId, subRowNum);
		
	 	// 롤리스트 목록
		var rollList = gridList.getGridData(rollGridId);
	    
		// 입고 목록
        var confirmList = gridList.getGridData(confirmGridid);
		
		var procYn = false; // 진행여부
		var subLota11 = subItemData.get("LOTA11"); // 제조일자
		
	 	// 현재 상세 목록 추가 여부 확인
		for(var i=0;i<rollList.length;i++){
			
			var rollRowData = rollList[i];
	        var rollRowNum = rollRowData.get("GRowNum");
	        var rollBarcno = rollRowData.get("BARCNO");
	        
	        var duplYn = false;
	        
			for(var j=0; j < confirmList.length; j++) {
	        	var confirmRowData = confirmList[j];
	        	var clota15 = confirmRowData.get("LOTA15");
	        	if(rollBarcno==clota15){
	        		duplYn = true;
	        		break;
	        	}
	        }
			//console.log(i + " - duplYn : " + duplYn);
			if(duplYn==false){
				
				if( procYn==false && $.trim(subLota11)==""){
			        if(!commonUtil.msgConfirm("VALID_M2087")){ // 제조일자가 미입력 상태입니다. 계속 진행하시겠습니까?
			        	gridList.setColFocus(subGridId, subRowNum, "LOTA11");
			        	return;
					}
		        }
				procYn=true;
				
				var newData = new DataMap();
				newData.putAll(subItemData);
		        newData.putAll(rollRowData);
		        
		        var netwt = rollRowData.get("NETWT");      // 중량
		        var wgtmul = rollRowData.get("WGTMUL");    // 중량배수
		        var qtyrcv = Number(netwt)*Number(wgtmul); // 입고가량
		        var barcno = rollRowData.get("BARCNO");    // 바코드
				
		        newData.put("LOTA14", barcno);     // BARCODE No
		        newData.put("LOTA15", barcno);     // BARCODE No
		        newData.put("LOTA15_ORG", barcno); // BARCODE No
		        
		        newData.put("LOTA41", rollRowData.get("CONTNO")); // 컨테이너 No
		        newData.put("LOTA42", rollRowData.get("PTNRKY")); // 공급업체 PO
		        
		        newData.put("QTYRCV1", qtyrcv); // 입고가능수량
		        newData.put("QTYRCV", qtyrcv);  // 입고가량
		        
		        // 기본단위 수량 계산
		        var param = new DataMap();
				param.put("OWNRKY", "<%=ownrky%>");
				param.put("WAREKY", "<%=wareky%>");
				param.put("SKUKEY", newData.get("SKUKEY"));
				param.put("QTY",    qtyrcv);
				param.put("UOMKEY", newData.get("UOMKEY"));
				
				var json = getUOMQTYInfo(rollGridId, rollRowNum, param)
				newData.put("UOMQTY", json.data["UOMQTY"]);
				newData.put("TOT",    json.data["TOT"]);
				newData.put("BAG",    json.data["BAG"]);
				newData.put("BOX",    json.data["BOX"]);
				newData.put("PLT",    json.data["PLT"]);
				newData.put("SOK",    json.data["SOK"]);
				newData.put("EA",     json.data["EA"]);
				
				// 필수값 체크
				var reqFieldArr = mkRollListReqFieldArr();
				
				for(var j=0;j<reqFieldArr.length;j++){
					var chkMap = reqFieldArr[j];
					var chkId = chkMap.get("id");
					var chkLabel = chkMap.get("label");
					var chkVal = rollRowData.get(chkId);
			        if($.trim(chkVal)==""){
				        gridList.setColFocus(rollGridId, rollRowNum, chkId);
						var STD_LABEL = commonLabel.getLabel(chkLabel, 1);
						commonUtil.msgBox("VALID_required",[STD_LABEL]); // {0} 은(는) 필수 입력항목입니다.
						return false;
			        }
				}
				
				gridList.addNewRow("gridConfirmList",newData);
				
				gridList.setRowCheck(rollGridId, rollRowNum, false);
		        gridList.setRowReadOnly(rollGridId, rollRowNum, true, ['BARCNO']);
		        setRollGridReadOnlyYN(rollGridId, rollRowNum, true);
				
			}
			
		}
		
		if(procYn==false){
			commonUtil.msgBox("VALID_M2113");// 입고리스트 추가 가능한 데이터가 없습니다.
	        return;
		}else{
			selTab = 2;
		    $('#tabSub2').click();	
		}
		
	 	
	 	
		
		return;
		///////////////////////////////////////////////////////
		var chkItemIdx = gridList.getSelectRowNumList(gridId);
	    var chkItemLen = chkItemIdx.length; 
	       
	    if( chkItemLen == 0 ){
	    	commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
	        return;
	    }
	    
	    // 상세리스트 목록
	    var subRowNum = gridList.getFocusRowNum("gridListSub");
	    var itemData = gridList.getRowData("gridListSub", subRowNum);
	    
	    var lota11 = itemData.get("LOTA11"); // 제조일자
        if($.trim(lota11)==""){
	        if(!commonUtil.msgConfirm("VALID_M2087")){ // 제조일자가 미입력 상태입니다. 계속 진행하시겠습니까?
				return;
			}
        }
	    
	    var chkItemList = gridList.getSelectData(gridId);
	    for(var i=0;i<chkItemList.length;i++){
	    
	    	var rowData = chkItemList[i];
	        var rowNum = rowData.get("GRowNum");
	        
	        var newData = new DataMap(); 
	        
	        //newData = itemData;
	        newData.putAll(itemData);
	        newData.putAll(rowData);
	        
	        newData.put("LOTA14", rowData.get("BARCNO")); // BARCODE No
	        newData.put("LOTA15", rowData.get("BARCNO")); // BARCODE No
	        newData.put("LOTA15_ORG", rowData.get("BARCNO")); // BARCODE No
	        
	        newData.put("LOTA41", rowData.get("CONTNO")); // 컨테이너 No
	        newData.put("LOTA42", rowData.get("PTNRPO")); // 공급업체 PO
	        
	        var netwt = rowData.get("NETWT"); // 중량
	        var wgtmul = rowData.get("WGTMUL"); // 중량배수
	        var qtyrcv = Number(netwt)*Number(wgtmul); // 입고가량
	        var barcno = rowData.get("BARCNO"); // 바코드
	        
	        newData.put("QTYRCV1", qtyrcv); // 입고가능수량
	        newData.put("QTYRCV", qtyrcv);  // 입고가량
	        
	        // 기본단위 수량 계산
	        var param = new DataMap();
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("WAREKY", "<%=wareky%>");
			param.put("SKUKEY", newData.get("SKUKEY"));
			param.put("QTY",    qtyrcv);
			param.put("UOMKEY", newData.get("UOMKEY"));
			
			//newData.put("TOT",    qtyrcv);
			
			var json = getUOMQTYInfo(gridId, rowNum, param)
			newData.put("UOMQTY", json.data["UOMQTY"]);
			newData.put("TOT",    json.data["TOT"]);
			newData.put("BAG",    json.data["BAG"]);
			newData.put("BOX",    json.data["BOX"]);
			newData.put("PLT",    json.data["PLT"]);
			newData.put("SOK",    json.data["SOK"]);
			newData.put("EA",     json.data["EA"]);
	        
			/*
			var lota11 = newData.get("LOTA11"); // 제조일자
	        if($.trim(lota11)==""){
		        if(!commonUtil.msgConfirm("VALID_M2087")){ // 제조일자가 미입력 상태입니다. 계속 진행하시겠습니까?
					return;
				}
	        }
			*/
			
			// 필수값 체크
			var reqFieldArr = mkRollListReqFieldArr();
			
			for(var j=0;j<reqFieldArr.length;j++){
				var chkMap = reqFieldArr[j];
				var chkId = chkMap.get("id");
				var chkLabel = chkMap.get("label");
				var chkVal = rowData.get(chkId);
		        if($.trim(chkVal)==""){
			        gridList.setColFocus(gridId, rowNum, chkId);
					var STD_LABEL = commonLabel.getLabel(chkLabel, 1);
					commonUtil.msgBox("VALID_required",[STD_LABEL]); // {0} 은(는) 필수 입력항목입니다.
					return false;
		        }
			}
			
			/*
	        var BARCNO = rowData.get("BARCNO");
	        if($.trim(BARCNO)==""){
		        gridList.setColFocus(gridId, rowNum, "BARCNO");
				var STD_BARCNO = commonLabel.getLabel("STD_BARCNO", 1);
				commonUtil.msgBox("VALID_required",[STD_BARCNO]); // {0} 은(는) 필수 입력항목입니다.
				return false;
	        }
	        */
	        
	        var confirmGridid = "gridConfirmList";
	        var confirmList = gridList.getGridData(confirmGridid);
	        
	        for(var j=0; j < confirmList.length; j++) {
	        	
	        	var confirmRowData = confirmList[j];
	        	var confirmCowNum = confirmList[j].get("GRowNum");
	        	var clota15 = confirmRowData.get("LOTA15");
	        	
	        	if(barcno==clota15){
	        		gridList.setColFocus(gridId, rowNum, "BARCNO");
					commonUtil.msgBox("VALID_M2095"); // 바코드 번호는 중복 입력 할 수 없습니다.
					return false;
	        	}
	        	
	        }
	        
	        /*
	        var vparam = new DataMap();
	        vparam.put("SEBELN", newData.get("SEBELN"));
	        vparam.put("LOTA41", newData.get("SIGNI"));
	        vparam.put("LOTA14", rowData.get("BARCNO"));
	        
			var contnoJson = netUtil.sendData({
				module : "WmsInbound",
				command : "GR40_CONTNO_ITEMCNT",
				sendType : "count",
				param : vparam
			});
			if(contnoJson.data > 0){
				gridList.setColFocus(gridId, rowNum, "BARCNO");
				commonUtil.msgBox("VALID_M2095"); // 바코드 번호는 중복 입력 할 수 없습니다.
				return false;
			}
