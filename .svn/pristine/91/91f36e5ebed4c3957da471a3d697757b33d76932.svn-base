	function fnInboundDel(gridId, rowNum){
	
		if(gridId != "gridConfirmList"){
			return false;
		}
		
		var list = new Array();
		var rowData = gridList.getRowData(gridId, rowNum);
		list.push(rowData);
		
		var param = new DataMap();
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("list", list);
		
		var json = netUtil.sendData({
			url : "/wms/inbound/json/deleteTmpGR40.data",
			param : param
		});
		
		if(json.data && json.data.RESULTMSG ){
			var msgList = json.data.RESULTMSG.split("†");
			var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
			commonUtil.msg(msgTxt);
			return;
		}
		
	}
	
	function setStlkyInfo(gridId, rowNum){
		
		var param = new DataMap();
		
		var LOTA01 = gridList.getColData(gridId, rowNum, "LOTA01");
		var LOTA02 = gridList.getColData(gridId, rowNum, "LOTA02");
		
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("LOTA02", LOTA02);
		param.put("LOTA01", LOTA01);
		
		if(LOTA01==""){
			gridList.setColValue(gridId, rowNum, "LOTA01NM", "");
		}else{
			var json = netUtil.sendData({
				module : "WmsInbound",
				command : "GR99_STLKYINFO",
				sendType : "map",
				param : param
			});
			
			if(json && json.data){
				gridList.setColValue(gridId, rowNum, "LOTA01NM", json.data["STLNM"]);
			} else {
				commonUtil.msgBox("VALID_M2084"); // 존재하지 않는 저장소입니다.
				gridList.setColValue(gridId, rowNum, "LOTA01", "");
				gridList.setColValue(gridId, rowNum, "LOTA01NM", "");
			}
		}
	}
	
	function setSTLKY(){
		
		var gridid = "gridListSub";
		if(selTab!=1){
			gridid = "gridConfirmList";
		}
		var toStlky = $("#TOSTLKY").val();		
		var stlkyList = new Array();
		
		if(gridList.getSelectData(gridid).length < 1) {
			commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
			return;
		}
		
		var param = new DataMap();
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("STLKY",toStlky);
		
		// 저장소정보 조회
		var json = netUtil.sendData({
			module : "WmsInbound",
			command : "STLKY_INFO",
			sendType : "list",
			param : param
		});
		
		if (json.data && json.data.length>0){
			stlkyList = json.data;
		}else{
			commonUtil.msgBox("VALID_M2085", toStlky);	// 저장소 [{0}]가 이 유효하지 않습니다.
			return false;
		}
		
		var selectNumList = gridList.getSelectRowNumList(gridid);
		
		for(var i=0;i<selectNumList.length;i++){
			var rowNum = selectNumList[i];
			var lota02 = gridList.getColData(gridid, rowNum, "LOTA02");
			var sameLota02YN = false;
			for(var j=0;j<stlkyList.length;j++){
				var item = stlkyList[0];
				var plntky = item.PLNTKY;
				if(lota02==plntky){
					sameLota02YN=true;
					break;
				}
			}
			if(!sameLota02YN){
				gridList.setColFocus(gridid, rowNum, "LOTA01");
				commonUtil.msgBox("VALID_M2086");	// 동일한 플랜트 내 저장소만 변경 가능합니다.
				return;
			}
		}
		
		for(var i=0;i<selectNumList.length;i++){
			var rowNum = selectNumList[i];
			for(var j=0;j<stlkyList.length;j++){
				var item = stlkyList[0];
				var plntky = item.PLNTKY;
				var stlnm = item.STLNM;
				if(lota02==plntky){
					gridList.setColValue(gridid, rowNum, "LOTA01", toStlky);
					gridList.setColValue(gridid, rowNum, "LOTA01NM", stlnm);
					break;
				}
			}
		}
		
		commonUtil.msgBox("TASK_M0700");	// 반영되었습니다.
	}
	
	
	function deleteData(){
		
		var headGridId = "gridList";
		var itemGridId = "gridConfirmList";
		var headRowNum = gridList.getFocusRowNum(headGridId);
        var headRowdata = gridList.getRowData(headGridId, headRowNum);
		
        var headListCnt = gridList.getGridDataCount(headGridId);
		if(headListCnt == 0){
			commonUtil.msgBox("VALID_M2067");// 선택된 아이템이 없습니다.
			return;
		}
        
        var statdo = headRowdata.get("STATDO");
        if("FRV"!=statdo){
        	commonUtil.msgBox("VALID_M2089");// 미입고 문서는 취소할수없습니다.
			return;
        }
		
        var headRecvky = headRowdata.get("RECVKY");
        
        var head = new Array();
        head.push(headRowdata);
        var list = gridList.getGridData(itemGridId);

        var vparam = new DataMap();
		vparam.put("head", head);
		vparam.put("list", list);
		vparam.put("headRecvky", headRecvky);
		
		var json = netUtil.sendData({
			url : "/wms/inbound/json/validationGR09.data",
			param : vparam
		});
		//console.log("json : " + JSON.stringify(json));
		if(json.data != "OK"){
			var msgList = json.data.split(" ");
			var msgParam = new Array();
			if(msgList.length > 1){
				for(var i=1;i<msgList.length;i++){
					msgParam.push(msgList[i]);
				}
			}
			//var msgTxt = commonUtil.getMsg(msgList[0], msgList.pop());
			var msgTxt = commonUtil.getMsg(msgList[0], msgParam);
			commonUtil.msg(msgTxt);
			return false;
		}
		
		// 아이템 취소여부 확인
		for(var i=0;i<list.length;i++){
			
			var rowData = list[i];
			var GRowNum = rowData.get("GRowNum");
			var STATIT = rowData.get("STATIT");
			var INDRCN = rowData.get("INDRCN");
			
			if( $.trim(INDRCN)!="" || STATIT=="FCV" ){
				commonUtil.msgBox("MASTER_M0690");
				gridList.setColFocus("gridListSub", GRowNum, "rowCheck");
				return;
			}
			
		}
        
		//console.log("head : " + JSON.stringify(head));
		if(!commonUtil.msgConfirm("COMMON_M0026")){ //삭제하시겠습니까?
			return;
		}
		
		var param = new DataMap();
		param.put("head", head);
		param.put("list", list);
		param.put("headRecvky", headRecvky);
		param.put("PROGID", configData.MENU_ID);
		
		var json = netUtil.sendData({
			//url : "/wms/inbound/json/deleteGR40New.data",
			url : "/wms/inbound/json/deleteGR09New.data",
			param : param
		});  
		
	
		if(json.data && json.data.RESULTMSG ){
			var msgList = json.data.RESULTMSG.split("†");
			var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
			commonUtil.msg(msgTxt);
			return;
		}
		
		if(json && json.data){
			
			dblIdx = -1;
			
			var inRsCode = json.data.inRsCode; // 입고저장 결과코드
            var inRsMsg = json.data.inRsMsg;   // 입고저장 결과 메시지
			
			var ifRsCode = json.data.ifRsCode; // 인터페이스 전송 결과코드
            var ifRsMsg = json.data.ifRsMsg;   // 인터페이스 전송 결과 메시지
            
            var totCnt = json.data.totCnt;     // 입고 전체 건수
            var sucCnt = json.data.sucCnt;     // 입고 성공 건수
            var failCnt = json.data.failCnt;   // 입고 실패 건수 
            
            //var sucList = json.data.sucList;   // 입고 성공 오더목록 ( 부분입고 여부 확인 불가 )
            
            console.log("전체 : " + totCnt + " - 성공 : " + sucCnt + " - 실패 : " + failCnt);
        	console.log("inRsCode : " + inRsCode);
        	console.log("ifRsCode : " + ifRsCode);
        	//console.log("sucList : " + sucList);
        	
        	if(inRsCode != "S" && ifRsCode != "S"){
        		console.log("inRsMsg : " + inRsMsg);
        		console.log("ifRsMsg : " + ifRsMsg);
        		var msgTxt = commonUtil.getMsg("VALID_M0953",[totCnt,sucCnt,failCnt]); // 저장 및 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
        		alert(msgTxt + "\n" + inRsMsg + "" + ifRsMsg);
        		//saveRsReadonly(sucList,chkHeadList,headSebeln);
        	}else if(inRsCode != "S"){
            	console.log("inRsMsg : " + inRsMsg);
            	var msgTxt = commonUtil.getMsg("VALID_M0951",[totCnt,sucCnt,failCnt]); // 입고 저장에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            	alert(msgTxt + "\n" + inRsMsg);
            	//saveRsReadonly(sucList,chkHeadList,headSebeln);
        	}else if(ifRsCode != "S"){
            	console.log("ifRsMsg : " + ifRsMsg);
            	var msgTxt = commonUtil.getMsg("VALID_M0952",[totCnt,sucCnt,failCnt]); // 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            	alert(msgTxt + "\n" + ifRsMsg);
            	//saveRsReadonly(sucList,chkHeadList,headSebeln);
            }else{
            	//commonUtil.msgBox("MASTER_M0564"); // 저장 완료되었습니다.
            	commonUtil.msgBox("VALID_M0955",[totCnt,sucCnt,failCnt]); // 입고가 취소되었습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            	/*
            	gridList.resetGrid("gridList");
				gridList.resetGrid("gridListSub");
				searchList();
				*/
            }
		
        	searchList();
		}
		
		
		
		/*
		if(json && json.data){
			// 입고가 취소되었습니다.
		   commonUtil.msgBox("VALID_M1560");
		   searchList();
		}else{
			// 입고취소가 실패하였습니다.
			commonUtil.msgBox("VALID_M1561");
		}
		*/
        
	}
	
	function saveRsReadonly(sucList,chkHeadList,headSebeln){
		
		if(sucList!=undefined && sucList.length > 0){
    		// 완료된 데이터 잠금
    		for(i=0;i<sucList.length;i++){
    			var sucRow = sucList[i];
    			var sebeln = sucRow.SEBELN; 
    			//console.log(i + " - sucList - sebeln : " + sebeln + " - chkHeadList.length : " + chkHeadList.length);
    			
    			for(var j=0;j<chkHeadList.length;j++){
                	var rowData = chkHeadList[j];
                	var rowNum = rowData.get("GRowNum");
                	var hSebeln = rowData.get("SEBELN");
                	//console.log(j + " - chkHeadList - hSebeln : " + hSebeln);
                    if(sebeln==hSebeln){
                    	//console.log(j + " - chkHeadList matching - hSebeln : " + hSebeln);
                    	gridList.setRowCheck("gridList", rowNum, false);
                    	
                    	var recvky = getRcvky(sebeln);
                    	gridList.setColValue("gridList", rowNum, "RECVKY", recvky);                    	
                    	gridList.setColValue("gridList", rowNum, "STATDO", "FRV");
                    	gridList.setColValue("gridList", rowNum, "STATDONM", "입고완료");
                    	gridList.setColValue("gridList", rowNum, "SAPETC", "V");
                    	gridList.setRowReadOnly("gridList", rowNum, true, ['rowCheck',"DOCDAT","DOCTXT"]);
                    	gridList.setRowState("gridList", configData.GRID_ROW_STATE_READ, rowNum) ;
                    	gridList.reloadAll("gridList");
                    	
                    	if(headSebeln!="" && headSebeln==hSebeln){
                    		gridList.resetGrid("gridListSub");
                    		gridList.resetGrid("gridConfirmList");
                    		gridListEventItemGridSearch("gridList", rowNum);
                    	}
                    	
                    	break;
                    }
                }
    			
    		}
    		
    	}
		
	}
		
	function getRcvky(sebeln){
		
		var recvky = "";
		
		// 입고 키 조회
		var param = new DataMap();
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("WAREKY", "<%=wareky%>");
		param.put("SEBELN", sebeln);
		
		var json = netUtil.sendData({
			module : "WmsInbound",
			command : "GR40_RECVKY",
			sendType : "map",
			param : param
		});
		
		if (json.data){
			recvky = json.data.RECVKY;
		}
		
		return recvky;
	}
	
	function getRollMaCountMap(sebeln){
		
		var rollMaCntMap = new DataMap();
		
		// 입고 키 조회
		var param = new DataMap();
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("WAREKY", "<%=wareky%>");
		param.put("SEBELN", sebeln);
		
		var json = netUtil.sendData({
			module : "WmsInbound",
			command : "GR40_ROLL",
			sendType : "map",
			param : param
		});
		
		if (json.data){
			rollMaCntMap = json.data;
		}
		
		return rollMaCntMap;
	}
	
	
	function tabChange(tabNo){
        $("[id^=tab2_btn]").hide();
        $("#"+tabNo).show();
        
        if(tabNo=="tab2_btn_01"){
        	selTab=1;
        }else if(tabNo=="tab2_btn_02"){
        	selTab=2;
        }
    }
	
	function setRollGridReadOnlyYN(gridId, rowNum, readOnlyYN){
		//gridList.setRowReadOnly(gridId, rowNum, readOnlyYN, ['rowCheck','BARCNO',"ROLLID","DESCRI","MRGSM","LENGTH","NETWT","WGTMUL","COREDI","MATNR","KUNIT","CPCOD","WEIGHT","RBRGEW","LUNIT","RMK1","RMK2","RMK3","RMK4","RMK5"]);
		gridList.setRowReadOnly(gridId, rowNum, readOnlyYN, ['rowCheck',"ROLLID","DESCRI","MRGSM","LENGTH","NETWT","WGTMUL","COREDI","KUNIT","CPCOD","WEIGHT","RBRGEW","LUNIT","RMK1","RMK2","RMK3","RMK4","RMK5"]);
	}
	
	function reportPrint(){
		var url = "";
		var ebeln = "";
		var listcnt = gridList.getGridDataCount("gridList");
		
		if(listcnt < 1){
			commonUtil.msgBox("VALID_M0006");
			return;
		}

		var where =   "AND EBELN IN (" ;
		for(var i=0 ; i<listcnt ; i++){
			ebeln = gridList.getColData("gridList", i, "EBELN");		
			if(i>0){
				where += ", "
			}
			where += "'" + ebeln +"'";
		}
		where += ")";
		url = "/ezgen/ebeln_s.ezg";
				
		var map = new DataMap();
		WriteEZgenElement(url, where, "", '<%= langky%>', map, 650, 350);	
		
	}
	
	//search 전체 체크박스 클릭
	function searchCheckBoxAll(obj) {
		
		if($(obj).prop("checked") == true){
			$(obj).parent('dd').children('input').prop("checked", true);
		}else{
			$(obj).parent('dd').children('input').prop("checked", false);
		}
	}
	
	
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
	<div class="content_inner">
		<%@ include file="/common/include/webdek/title.jsp" %>
		<div class="content_serch" id="searchArea">
			<div class="btn_wrap">
				<div class="fl_l">
				</div>
				<div class="fl_r">
					<input type="button" CB="Search SEARCH BTN_DISPLAY" /><!--조회-->
					<input type="button" CB="Save SAVE STD_INBOUND" /><!--입고-->
					<input type="button" CB="Wcancle WCANCLE BTN_CANCELRCV" />
			<!-- 		<input type="button" CB="Print PRINT BTN_IBLBPRINT">입고라벨출력</input> -->
			<!-- 		<input type="button" CB="DeleteAsn DELETE STD_DELASN">입고예정삭제</input> -->
			<!-- 		<input type="button" CB="PrintRTN PRINT BTN_PRINT9,3">반품지시서출력</input> -->
				</div>
			</div>
			<div class="search_inner">
				<div class="search_wrap ">
					<dl>
						<dt CL="STD_WAREKY">거점</dt>
						<dd>
							<input type="text" class="input" name="WAREKY" name="WAREKY"  value="<%=wareky%>" readonly="readonly" validate="required" />
						</dd>
					</dl>
					<dl style="display:none;">
						<dt CL="STD_OWNRKY">화주</dt>
						<dd>
							<!-- <select type="text" class="input" Combo="WmsOrder,OWNRKYCOMBO" name="OWNRKY" id="OWNRKY" STYLE="width: 150px;">
							</select> -->
							<input type="text" class="input" name="OWNRKY" value="<%=ownrky %>" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA02">플랜트</dt>
						<dd>
							<select type="text" class="input" Combo="Wms,PLNTKYCOMBO" name="PO.LOTA02" id="PLNTKY" ComboType="MS" validate="required">
							</select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA01">저장위치</dt>
						<dd>
							<input type="text" class="input" name="PO.LOTA01" UIInput="R,SHSTLMAP" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_ORDDAT">오더일자</dt>
						<dd>
							<input type="text" class="input" name="PO.BEDAT" UIInput="R" UIFormat="C 0" validate="required" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_RCPTTY">입고유형</dt>
						<dd>
<!-- 							<select Combo="WmsOrder,RCPTTYCOMBO" name="RCPTTY" id="RCPTTY" STYLE="width: 160px;" validate="required(STD_RCPTTY)"> -->
<!-- 								<option value=""></option> -->
<!-- 							</select> -->
							<select type="text" class="input" Combo="WmsOrder,RCPTTYCOMBO" name="PO.BWART" id="RCPTTY" ComboType="MS" validate="required">
							</select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_PRODLOT">개별바코드</dt>
						<dd>
							<input type="text" class="input" name="PO.LOTA14" UIInput="R" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_SIGNI">컨테이너 No</dt>
						<dd>
							<input type="text" class="input" name="PO.SIGNI" UIInput="R" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_EBELN">오더번호</dt>
						<dd>
							<input type="text" class="input" name="PO.EBELN" UIInput="R" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_RCVDAT">입고예정일자</dt>
						<dd>
