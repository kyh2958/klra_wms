	        gridList.addNewRow("gridConfirmList",newData);
			//gridList.setAddRow("gridConfirmList",newData);
	        //console.log(i + " - barcno : " +barcno );
			
	        gridList.setRowCheck(gridId, rowNum, false);
	        gridList.setRowReadOnly(gridId, rowNum, true, ['BARCNO']);
	        setRollGridReadOnlyYN(gridId, rowNum, true);
	        
	    }
	    
	    selTab = 2;
	    $('#tabSub2').click();
	    
	}
	
