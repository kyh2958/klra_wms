<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>WMS</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<%@ page import="project.common.airfw.*"%>
<link rel="stylesheet" type="text/css" href="/common/theme/webdek/css/demo_layout.css">
<script type="text/javascript" src="/common/js/ezgencontrol.js"></script>
<style>
	input[type="checkbox"]{height:unset;}
</style>
<%
	User user = (User)request.getSession().getAttribute(CommonConfig.SES_USER_OBJECT_KEY);
%>
<script type="text/javascript">
	
	var dblIdx = -1;
	var subIdx = 0;
	var headSebeln = "";
	var headRownum = "";
	var searchFlag = 1;
	var paramH = new DataMap();
	
	var selTab = 1;
	
	$(document).ready(function(){
		
		gridList.setGrid({
			id : "gridList",
			module : "WmsInbound",
			command : "GR40",
			itemGrid : "gridListSub,gridListSubRoll,gridConfirmList",
			itemSearch : true
		});
		
		gridList.setGrid({
			id : "gridListSub",
			module : "WmsInbound",
			command : "GR40Sub",
			itemGrid : "gridListSubRoll",
 			itemSearch : true,
			emptyMsgType : false
		});
		
		gridList.setGrid({
			id : "gridListSubRoll",
			module : "WmsInbound",
			command : "GR40SubRoll",
			emptyMsgType : false
		});
		
		gridList.setGrid({
            id : "gridConfirmList",
            module : "WmsInbound",
			command : "GR40Confirm",
			emptyMsgType : false
        });
		
		initSearchArea();
		
		gridList.setReadOnly("gridListSub", true, ['LOTA02', 'LOTA04','LOTA06','LOTA08']);
		gridList.setReadOnly("gridConfirmList", true, ['LOTA02', 'LOTA04','LOTA06','LOTA08']);
	});
	
	function initSearchArea() {
  	  // 플랜트
      <%if(null!=plant && plant.trim().equals("")){%>
        $('select[id="PLNTKY"]').multipleSelect('checkAll');
      <%}else{%>
        $('select[id="PLNTKY"]').multipleSelect('setSelects', ['<%=plant%>']);
      <%}%>
      // 입고유형
  	  var $selRCPTTY = $('select[id="RCPTTY"]');
  	  $selRCPTTY.multipleSelect('checkAll');
        
    }
	
	function searchList(){
		if(validate.check("searchArea")){
			var param = inputList.setRangeParam("searchArea");
			param.put("PROGID", configData.MENU_ID);
			gridList.resetGrid("gridList");
			gridList.resetGrid("gridListSub");
			gridList.resetGrid("gridListSubRoll");
			gridList.resetGrid("gridConfirmList");
			
			$('#tabSub1').click();
			
			gridList.gridList({
		    	id : "gridList",
		    	param : param
		    });
		}
	}
	
	function searchSubRollList(){
		
		gridList.resetGrid("gridListSubRoll");
		$('#tabSub1').click();
		
		var rowNum =  gridList.getFocusRowNum("gridListSub");
		var param = getItemSearchSubParam(rowNum);
		gridList.gridList({
           id : "gridListSubRoll",
           param : param,
        });
	}
	
	function searchSubConfirmList(){
		
		var rowNum =  gridList.getFocusRowNum("gridList");
		var param = getItemSearchParam(rowNum);
		$('#tabSub2').click();
		
		var param = getItemSearchSubParam(rowNum);
		gridList.gridList({
           id : "gridConfirmList",
           param : param,
        });
	}
	
	
	function getItemSearchParam(rowNum){
 		var rowData = gridList.getRowData("gridList", rowNum);
        var param = inputList.setRangeParam("searchArea");
        param.put("PROGID", configData.MENU_ID);
        param.putAll(rowData);
        
        param.put("LANGKY", "<%=langky%>");
        
        return param;
 	}
	
	function getItemSearchSubParam(rowNum){
 		var rowData = gridList.getRowData("gridListSub", rowNum);
        var param = inputList.setRangeParam("searchArea");
        param.put("PROGID", configData.MENU_ID);
        param.putAll(rowData);
        
        param.put("LANGKY", "<%=langky%>");
        
        return param;
 	}
	
	function gridListEventItemGridSearch(gridId, rowNum, itemGridList){
		
		if(gridId == "gridList"){
	        var param = getItemSearchParam(rowNum);
	        
	        gridList.gridList({
	           id : "gridListSub",
	           param : param,
	        });
	        
	        gridList.gridList({
	           id : "gridConfirmList",
	           param : param,
	        });
	        
	        dblIdx = rowNum;
			subIdx = rowNum;
		}else if(gridId == "gridListSub"){
			
			var param = getItemSearchSubParam(rowNum);
			
			gridList.gridList({
	           id : "gridListSubRoll",
	           param : param,
	        });
			
		}
		
	}
	
	function gridListEventDataBindEnd(gridId, dataLength){
		
		if(gridId == "gridList"){
			var list = gridList.getGridData(gridId);
			for(var i=0; i < list.length; i++) {
				var STATDO = list[i].get("STATDO");
				if(STATDO!="NEW"){
					gridList.setRowReadOnly(gridId, i, true, ['rowCheck','DOCDAT','DOCTXT']);
				}
			}
		}else if(gridId == "gridListSub"){
			
			var list = gridList.getGridData(gridId);
			for(var i=0; i < list.length; i++) {
				var QTYRCV1 = list[i].get("QTYRCV1");
				var IFFLG = list[i].get("IFFLG");
				gridList.setRowReadOnly(gridId, i, true, ['SKUKEY','LOTA02', 'LOTA04','LOTA06','LOTA08','LOTA09']);
				if( QTYRCV1<=0 || IFFLG=="Y"){
					//gridList.setRowReadOnly(gridId, i, true, ['rowCheck','QTYRCV','LOTA01','LOTA11','LOTA14']);
					gridList.setRowReadOnly(gridId, i, true, ['LOTA01','LOTA11','LOTA12','LOTA13','LOTA14']);
				}
			}
			
		}else if(gridId == "gridListSubRoll"){
		
			var confirmGridid = "gridConfirmList";
			var list = gridList.getGridData(gridId);
			var confirmList = gridList.getGridData(confirmGridid);
			
			var headRowNum = gridList.getFocusRowNum("gridList");
			var headRowData = gridList.getRowData("gridList", headRowNum);
			var statdo = headRowData.get("STATDO");
			
			for(var i=0; i < list.length; i++) {
				var rowData = list[i];
		        var rowNum = rowData.get("GRowNum");
		        var prcflg = rowData.get("PRCFLG");
		        var barcno = rowData.get("BARCNO");
		        var addYn = false;
		        
		        for(var j=0; j < confirmList.length; j++) {
		        	var lota15 = confirmList[j].get("LOTA15_ORG");
		        	var confirmCowNum = confirmList[j].get("GRowNum");
		        	if(barcno==lota15){
		        		addYn = true;
		        		break;
		        	}
		        }
		        
				if(addYn == true){
					gridList.setRowReadOnly(gridId, rowNum, true, ['BARCNO']);
					setRollGridReadOnlyYN(gridId, rowNum, true);
				}else if("X"==prcflg){
					gridList.setRowReadOnly(gridId, rowNum, true, ['BARCNO']);
					setRollGridReadOnlyYN(gridId, rowNum, false);
				}else{
		        	gridList.setRowReadOnly(gridId, rowNum, true, ['BARCNO']);
				}
				
				if($.trim(statdo) != "NEW"){
					gridList.setRowReadOnly(gridId, rowNum, true);
				}
				
			}
			
		}else if(gridId == "gridConfirmList"){
			
			var rollGrid = "gridListSubRoll";
			var list = gridList.getGridData(gridId);
			var rollList = gridList.getGridData(rollGrid);
			
			var headRowNum = gridList.getFocusRowNum("gridList");
			var headRowData = gridList.getRowData("gridList", headRowNum);
			var statdo = headRowData.get("STATDO");
			
			for(var i=0; i < list.length; i++) {
				var rowData = list[i];
		        var lota15 = rowData.get("LOTA15");
		        var rowNum = rowData.get("GRowNum");
		        
		        gridList.setRowCheck(gridId, rowNum, true);
		        
		        for(var j=0; j < rollList.length; j++) {
		        	var rollRowData = rollList[j];
		        	var barcno = rollRowData.get("BARCNO");
		        	var rollRowNum = rollRowData.get("GRowNum");
		        	if(barcno==lota15){
		        		gridList.setRowCheck(rollGrid, rollRowNum, false);
		        		gridList.setRowReadOnly(rollGrid, rollRowNum, true, ['rowCheck']);
		        		break;
		        	}
		        	
		        }
		        
		        if($.trim(statdo) != "NEW"){
		        	gridList.setRowCheck(gridId, rowNum, false);
		        	gridList.setRowReadOnly(gridId, rowNum, true);
				}
				
			}
			
		}
	}
	
	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
		
		//alert("gridId : " + gridId + "\nrowNum : " + rowNum + "\ncolName : " + colName + "\ncolValue : " + colValue);
		if (gridId == "gridList") {
			if (colName == "DOCDAT") {
				var rowData = gridList.getRowData(gridId, rowNum);
				var asndat = rowData.get("ASNDAT");
				var docdat = rowData.get("DOCDAT");
				var asndate = asndat-1;
				var now = new Date();
				now.setDate(now.getDate());
				var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
				var todayValue = tmpValue.replace(".","").replace(".","");
				
				if(docdat < asndate){
					//commonUtil.msgBox("IN_M0139"); // 과거일자로 입고하실 수 없습니다."
					//gridList.setColValue(gridId, rowNum, "DOCDAT", tmpValue);
				}else if(docdat>todayValue){
// 					commonUtil.msgBox("VALID_M2133"); // 미래일자로 입력하실 수 없습니다.
// 					gridList.setColValue(gridId, rowNum, "DOCDAT", tmpValue);
				}
			}
		}else if (gridId == "gridListSub"){
			
			if (colName == "QTYRCV") {

				setUOMInfo(gridId, rowNum);
				
			}else if(colName == "LOTA01") {
				
				setStlkyInfo(gridId, rowNum);
				setStlmInfo(gridId, rowNum);
				
			}else if(colName == "LOTA02") {
				
				gridList.setColValue("gridListSub", rowNum, "LOTA01", "");
				gridList.setColValue("gridListSub", rowNum, "LOTA01NM", "");
				
				setStlmInfo(gridId, rowNum);
			}else if (colName == "LOTA11") {
				var lota11 = gridList.getColData(gridId, rowNum, "LOTA11");
				var now = new Date();
				var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
				var todayValue = tmpValue.replace(".","").replace(".","");
				if(lota11>todayValue){
					commonUtil.msgBox("VALID_M2133"); // 미래일자로 입력하실 수 없습니다.
					gridList.setColValue(gridId, rowNum, colName, "");
				}
			}else if (colName == "LOTA12") {
				var lota12 = gridList.getColData(gridId, rowNum, "LOTA12");
				var now = new Date();
				var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
				var todayValue = tmpValue.replace(".","").replace(".","");
				if(lota12>todayValue){
					commonUtil.msgBox("VALID_M2133"); // 미래일자로 입력하실 수 없습니다.
					gridList.setColValue(gridId, rowNum, colName, "");
				}
			}
			
		}else if (gridId == "gridListSubRoll"){
		
			if(colName == "PTNRKY") {
				
				if(colValue.length > 0 && colValue != " ") {
					var param = new DataMap();
					param.put("OWNRKY", "<%=ownrky%>");
					param.put("DPTNKY", colValue);
					param.put("PTNRTY", "VD");
					
					var json = netUtil.sendData({
						module: "WmsInbound",
						command: "GR99_DPTNKYNM",
						sendType: "map",
						param: param
					});
					if(json && json.data) {
						gridList.setColValue(gridId, rowNum, "PTNRKYNM", json.data["DPTNKYNM"]);
					} else {
						commonUtil.msgBox("VALID_M2080", [colValue]); // 공급사[{0}]가 존재하지 않습니다.
						gridList.setColFocus(gridId, rowNum, "PTNRKY");
						gridList.setColValue(gridId, rowNum, "PTNRKY", " ");
						gridList.setColValue(gridId, rowNum, "PTNRKYNM", "");
					}
				} else {
					gridList.setColValue(gridId, rowNum, "PTNRKY", " ");
					gridList.setColValue(gridId, rowNum, "PTNRKYNM", "");
				}
			}
			
		}else if (gridId == "gridConfirmList"){
			
			if (colName == "QTYRCV") {

				setUOMInfo(gridId, rowNum);
				
			}else if(colName == "LOTA01") {
				
				setStlkyInfo(gridId, rowNum);
				setStlmInfo(gridId, rowNum);
				
			}else if(colName == "LOTA02") {
				
				gridList.setColValue("gridListSub", rowNum, "LOTA01", "");
				gridList.setColValue("gridListSub", rowNum, "LOTA01NM", "");
				
				setStlmInfo(gridId, rowNum);
			}else if(colName == "LOTA14") {
				gridList.setColValue(gridId, rowNum, "LOTA15", colValue);
			}else if(colName == "PTNRKY") {
				
				if(colValue.length > 0 && colValue != " ") {
					var param = new DataMap();
					param.put("OWNRKY", "<%=ownrky%>");
					param.put("DPTNKY", colValue);
					param.put("PTNRTY", "VD");
					
					var json = netUtil.sendData({
						module: "WmsInbound",
						command: "GR99_DPTNKYNM",
						sendType: "map",
						param: param
					});
					if(json && json.data) {
						gridList.setColValue(gridId, rowNum, "PTNRKYNM", json.data["DPTNKYNM"]);
					} else {
						commonUtil.msgBox("VALID_M2080", [colValue]); // 공급사[{0}]가 존재하지 않습니다.
						gridList.setColFocus(gridId, rowNum, "PTNRKY");
						gridList.setColValue(gridId, rowNum, "PTNRKY", " ");
						gridList.setColValue(gridId, rowNum, "PTNRKYNM", "");
					}
				} else {
					gridList.setColValue(gridId, rowNum, "PTNRKY", " ");
					gridList.setColValue(gridId, rowNum, "PTNRKYNM", "");
				}
			
			}else if(colName == "NETWT" || colName == "WGTMUL") {
				getCalcQTYRCV1(gridId, rowNum);
			}else if (colName == "LOTA11") {
				var lota11 = gridList.getColData(gridId, rowNum, "LOTA11");
				var now = new Date();
				var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
				var todayValue = tmpValue.replace(".","").replace(".","");
				if(lota11>todayValue){
					commonUtil.msgBox("VALID_M2133"); // 미래일자로 입력하실 수 없습니다.
					gridList.setColValue(gridId, rowNum, colName, "");
				}
			}else if (colName == "LOTA12") {
				var lota12 = gridList.getColData(gridId, rowNum, "LOTA12");
				var now = new Date();
				var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
				var todayValue = tmpValue.replace(".","").replace(".","");
				if(lota12>todayValue){
					commonUtil.msgBox("VALID_M2133"); // 미래일자로 입력하실 수 없습니다.
					gridList.setColValue(gridId, rowNum, colName, "");
				}
			}
			
		}
		
	}
	
	function getCalcQTYRCV1(gridId, rowNum){
		// 입고가능수량 재계산
		var NETWT = gridList.getColData(gridId, rowNum, "NETWT");     // Net Weight_중량
		var WGTMUL = gridList.getColData(gridId, rowNum, "WGTMUL");   // 중량배수
		var QTYRCV1 = 0;
		QTYRCV1 = Number(NETWT) * Number(WGTMUL);
		gridList.setColValue(gridId, rowNum, "QTYRCV1", QTYRCV1);
	}
	
	function gridListEventRowClick(gridId, rowNum, colName){
		if(gridId == "gridList"){
			
			if(dblIdx!=rowNum){
	            var chkItemIdx = gridList.getSelectRowNumList("gridListSub");
	            var itemGrdViewYn = gridList.getItemGridViewCheck("gridList");
	            if(chkItemIdx==0 && itemGrdViewYn==false ){
	            	dblIdx=-1;
	            }
    		}
			
		}
	}
	
	function gridListEventRowDblclick(gridId, rowNum, colName, colValue){
		if(gridId == "gridList"){
			dblIdx=rowNum;
			
			gridList.resetGrid("gridListSub");
			gridList.resetGrid("gridListSubRoll");
			gridList.resetGrid("gridConfirmList");
			$('#tabSub1').click();
		}
	}
	
	function gridListEventRowAddBefore(gridId, rowNum) {
		
		if(gridId == "gridListSubRoll"){
			var newData = new DataMap();
			
			var itemGrdViewYn = gridList.getItemGridViewCheck("gridList");
			if(!itemGrdViewYn){
				commonUtil.msgBox("VALID_M2061");// 현재 진행중인 데이터의 헤더 체크박스를 선택하여주세요.
				return false;
			}
			
			//gridList.setRowReadOnly(gridId, rowNum, false, ['PTNRKY','BARCNO', 'PTNRPO','INVONO','ROLLID','DESCRI','MRGSM','LENGTH','WEIGHT','WGTMUL','COREDI']);
			gridList.setRowReadOnly(gridId, rowNum, false, ['BARCNO']);
			
			//var headRowNum = gridList.getFocusRowNum("gridList");
			//var headRowData = gridList.getRowData("gridList", headRowNum);
			
			var subRowNum = gridList.getFocusRowNum("gridListSub");
			newData = gridList.getRowData("gridListSub", subRowNum);
			//console.log("newData : " + JSON.stringify(newData));
			newData.put("CONTNO", newData.get("SIGNI"));
			newData.put("MATNR", newData.get("SKUKEY"));
			
			newData.put("WGTMUL", "1");
			newData.put("KUNIT", "KG");
			
			newData.put("ITFCNT", "0");
			newData.put("ITFFLG", "N");
			newData.put("PRCCNT", "0");
			newData.put("PRCFLG", "X");
			
			var PTNRKY = "";
			var PTNRKYNM = "";
			
			// ROLLMA_PTNRKY Info
			var param = new DataMap();
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("SEBELN", newData.get("SEBELN"));
			var json = netUtil.sendData({
				module : "WmsInbound",
				command : "GR40_ROLLMA_PTNRKY",
				sendType : "map",
				param : param
			});
			if(json && json.data){
				var PTNRKY = json.data["PTNRKY"];
				var PTNRKYNM = json.data["PTNRKYNM"];
				var DESCRI = json.data["DESCRI"];
				newData.put("PTNRKY", PTNRKY);
				newData.put("PTNRKYNM", PTNRKYNM);
				newData.put("DESCRI", DESCRI);
			}
			
			newData.put("PTNRKY", PTNRKY);
			newData.put("PTNRKYNM", PTNRKYNM);
			
			// SKUMA Info
			var param = new DataMap();
			param.put("SKUKEY", newData.get("SKUKEY"));
			param.put("OWNRKY", "<%=ownrky%>");
			var json = netUtil.sendData({
				module : "WmsInbound",
				command : "GR99_SKUINFO",
				sendType : "map",
				param : param
			});
			if(json && json.data){
				var ASKL02 = json.data["ASKL02"];
				var ASKL03 = json.data["ASKL03"];
				
				newData.put("WEIGHT", ASKL03);
			}
			
			return newData;
		}
		
	}
	
	function gridListEventRowAddAfter(gridId, rowNum) {
		if(gridId == "gridConfirmList"){
			gridList.setRowCheck(gridId, rowNum, true);
		}
	}
	
	function gridListEventRowRemove(gridId, rowNum) {
		console.log("gridListEventRowRemove - gridId : " + gridId);
		if(gridId == "gridListSubRoll"){
			var newData = new DataMap();
			var headGridId = "gridList";
			var rowState = gridList.getRowState(gridId, rowNum);
			var adddat = gridList.getColData(gridId, rowNum, "ADDDAT"); // ROLLMA USER ADD YN
			var barcno = gridList.getColData(gridId, rowNum, "BARCNO");
			
			var headRowNum = gridList.getFocusRowNum(headGridId);
			var headRowdata = gridList.getRowData(headGridId, headRowNum);
			
			var statdo = headRowdata.get("STATDO");
	        if("NEW"!=statdo){
	        	commonUtil.msgBox("VALID_M2097");// 입고완료된 데이터는 삭제 할 수 없습니다.
				return;
	        }
	        
	        if("V"!=adddat){	
				commonUtil.msgBox("VALID_M2081");// 신규로 추가한 데이터만 삭제 가능합니다.
				return false;
			}
			
			var confirmGridid = "gridConfirmList";
			var confirmList = gridList.getGridData(confirmGridid);
			var addYn = false;
		    
	        for(var j=0; j < confirmList.length; j++) {
	        	var lota15 = confirmList[j].get("LOTA15_ORG");
	        	if(barcno==lota15){
	        		addYn = true;
	        		break;
	        	}
	        }
	        
			if(addYn == true){
				commonUtil.msgBox("VALID_M2096");// 입고리스트에 있는 데이터는 삭제 할 수 없습니다.
				return false;
			}
			
			var list = new Array();
			var rowData = gridList.getRowData(gridId, rowNum);
			list.push(rowData);
			
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("list", list);
			
			var json = netUtil.sendData({
				url : "/wms/inbound/json/deleteTmpRollmaGR40.data",
				param : param
			});
			
			if(json.data && json.data.RESULTMSG ){
				var msgList = json.data.RESULTMSG.split("†");
				var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
				commonUtil.msg(msgTxt);
				return;
			}else{
				
			}
			
			
		}else if(gridId == "gridConfirmList"){
			
			var headGridId = "gridList";
			var headRowNum = gridList.getFocusRowNum(headGridId);
			var headRowdata = gridList.getRowData(headGridId, headRowNum);
			
			var statdo = headRowdata.get("STATDO");
	        if("NEW"!=statdo){
	        	commonUtil.msgBox("VALID_M2097");// 입고완료된 데이터는 삭제 할 수 없습니다.
				return;
	        }
	        
			fnInboundDel(gridId, rowNum);
		}
		
	}
	
	function gridListEventRowRemoveAfter(gridId, rowNum) {
		console.log("gridListEventRowRemoveAfter - gridId : " + gridId);
		
		if(gridId == "gridListSubRoll"){
			searchSubRollList();
		}else if(gridId == "gridConfirmList"){
			
			var subRollGridid = "gridListSubRoll";
			var rowData = gridList.getRowData(gridId, rowNum);			
			var lota15 = rowData.get("LOTA15");
			var skukey = rowData.get("SKUKEY");
			
			var list = gridList.getGridData(subRollGridid);
			//console.log("skukey : " + skukey);
			for(var i=0; i < list.length; i++) {
				var rowNum = list[i].get("GRowNum");
				var barcno = list[i].get("BARCNO");
				var adddat = list[i].get("ADDDAT");  // 사용자 추가 데이터 'V'
				var matnr = list[i].get("MATNR");    // 품목
				//console.log("matnr : " + matnr);
				//var rowState = gridList.getRowState(subRollGridid, rowNum);
				
				if(barcno==lota15 && skukey==matnr){
					
					//console.log("skukey : " + skukey + " - matnr : " + matnr + " - adddat : " + adddat);
					if(adddat=="V"){
						gridList.setRowReadOnly(subRollGridid, rowNum, false, ['BARCNO']);
					}
					setRollGridReadOnlyYN(subRollGridid, rowNum, false);
					gridList.setRowReadOnly(subRollGridid, rowNum, false, ['rowCheck']);
					break;
				}
			}
				
			//searchSubConfirmList();
			
		}
		
	}
	
	function gridExcelDownloadEventBefore(gridId){
		var param = new DataMap();
		if(gridId == "gridList"){
			param = inputList.setRangeParam("searchArea");
			param.put("dataGridExcel", "수입밀롤입고_리스트");
		}else if(gridId == "gridListSub"){
			 
			var rowNum = gridList.getSearchRowNum("gridList");
			if(rowNum == -1){
				 return false;
			}else{
				 param = getItemSearchParam(rowNum);
			}
			param.put("dataGridExcel", "수입밀롤입고_상세_리스트");
		}else if(gridId == "gridListSubRoll"){
			param.put("dataGridExcel", "수입밀롤입고_롤_리스트");
		}else if(gridId == "gridConfirmList"){
			param.put("dataGridExcel", "수입밀롤입고_입고_리스트");
		}
		return param;
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType, obj, rowNum){
		
		var param = new DataMap();
		if(searchCode == "SHSKUMA"){
			param.put("LANGKY", "<%=langky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(searchCode == "SHBZPTN"){
			param.put("LANGKY", "<%=langky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("WAREKY", "<%=wareky%>");
			param.put("PTNRTY", "VD");
			return param;
		}else if(searchCode == "SHLOTAT"){
			param.put("LANGKY", "<%=langky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(searchCode == "SHSTLMAP"){
			var PLNTKY = $('select[id="PLNTKY"]').val();
        	param.put("LANGKY", "<%=langky%>");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("WAREKY", "<%=wareky%>");
            
            param.put("PLNTKY", PLNTKY);
            if(PLNTKY==null || $.trim(PLNTKY)==""){
            	return false;
            }
            
            return param;
		}else if(searchCode == "SHSKUKEYGR40"){
			param.put("LANGKY", "<%=langky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("WAREKY", "<%=wareky%>");
			
			var SEBELN = gridList.getColData("gridList", dblIdx, "SEBELN");
			param.put("SEBELN", SEBELN);
			
			return param;
		}else if(searchCode == "SHSTLMAP2"){
			param.put("LANGKY", "<%=langky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("WAREKY", "<%=wareky%>");
			var gridid = "gridListSub";
			if(selTab!=1){
				gridid = "gridConfirmList";
			}
			var lota02 = gridList.getColData(gridid, rowNum, "LOTA02");
			param.put("PLNTKY", lota02);
			
			if($.trim(lota02)==""){
				commonUtil.msgBox("VALID_M2002", ["플랜트"]); // {0}를 먼저 입력하여 주세요.
				gridList.setColFocus("gridListSub", rowNum, "LOTA02");
				return false;
			}
			
			return param;
		}
		
	}
	
	function comboEventDataBindeBefore(comboAtt){
		
		if(comboAtt == "WmsOrder,RCPTTYCOMBO"){
			var param = new DataMap();
			param.put("DOCCAT", "100");
			param.put("PROGID", configData.MENU_ID);
			return param;
		}else if(comboAtt == "Wms,PLNTKYCOMBO"){
