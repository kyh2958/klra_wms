<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="WmsMobileOutboundPicking_COPY">
	<!--
		Sorry, I can`t migrate	DataMap
		See console output for further details 
	-->
	<!--
		Sorry, I can`t migrate	StringMap
		See console output for further details 
	-->
	
	<!-- ================================================================================================== -->
	<!-- PDPK01 상품별 피킹 : BEGIN-->
	<!-- ================================================================================================== -->
	<select id="PDPK01_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY AS TASKKY
		     , TI.TASKIT AS TASKIT
		     , LM.LOCAKY AS LOCAKY
		     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),' ') AS STATIT
		     , TI.SKUKEY AS SKUKEY
		     , SM.DESC01 AS DESC01
		     , SM.EANCOD AS EANCOD
		     , TI.QTTAOR AS QTTAOR
		     , TI.QTCOMP AS QTCOMP
		     , SM.DUOMKY AS UOMKEY
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
		                          AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND TI.STATIT = 'NEW'
		<if test="TASKKY != null and TASKKY != ''">
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		</if>
		<if test="BARCOD != null and BARCOD != ''">
		   AND (TI.SKUKEY = #{BARCOD} OR TI.TRNUSR = #{BARCOD} OR TI.LOCASR = #{BARCOD})
		</if>
		 ORDER BY TH.TASKKY, TI.TASKIT, LM.OBROUT, LM.LOCAKY
	</select>
	
	<select id="PDPK01SKU_RE_LIST" parameterType="Map" resultType="DataMap">
		SELECT ROW_NUMBER() OVER(ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT) AS RNUM
			 , CASE WHEN TI.STATIT = 'NEW' THEN 'O'
					ELSE 'X'
			   END AS SAVE_ENABLE
			 , TH.TASKKY, TI.TASKIT
			 , TI.STATIT, NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),0) AS STATITNM
			 , TI.LOCASR AS LOCAKY
			 , LM.OBROUT
			 , TI.OWNRKY, TI.SKUKEY, SM.DESC01, SM.EANCOD
			 , TI.QTTAOR
			 , SM.DUOMKY AS UOMKEY
			 , TI.QTCOMP AS QTCOMP
			 , SM.DUOMKY AS UOMKEY2
			 , TI.SHPOKY
			 , TI.SHPOIT
			 , TI.LOCATG AS LOCATG
			 , TI.TRNUTG AS TRNUTG
			 , TI.SECTTG AS SECTTG
			 , (CASE WHEN TI.ACTCDT = '00000000' THEN TI.PAIDTG
									ELSE TI.PAIDAC END) AS PAIDAC
			 , (CASE WHEN TI.ACTCDT = '00000000' THEN TI.TTRUTY
									ELSE TI.ATRUTY END) AS ATRUTY
			 , TI.TMEAKY AS TMEAKY
			 , TI.TUOMKY AS TUOMKY
			 , TI.QTTPUM AS QTTPUM
			 , TI.TDUOKY AS TDUOKY
			 , TI.QTTDUM AS QTTDUM
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = TH.WAREKY AND SW.OWNRKY = TI.OWNRKY AND SW.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND TI.STATIT = 'NEW'
		<if test="TASKKY != null and TASKKY != ''">
		   AND TH.TASKKY = #{TASKKY}
		</if>
		<if test="BARCOD != null and BARCOD != ''">
		   AND (TI.SKUKEY = #{BARCOD} OR TI.TRNUSR = #{BARCOD} OR TI.LOCASR = #{BARCOD})
		</if>
		 ORDER BY TH.TASKKY, TI.TASKIT, LM.OBROUT, LM.LOCAKY
	</select>
	
	<select id="PDPK01SKU_LIST" parameterType="Map" resultType="DataMap">
		SELECT ROW_NUMBER() OVER(ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT) AS RNUM
			 , CASE WHEN TI.STATIT = 'NEW' THEN 'O'
					ELSE 'X'
			   END AS SAVE_ENABLE
			 , TH.TASKKY, TI.TASKIT
			 , TI.STATIT, NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),0) AS STATITNM
			 , TI.LOCASR AS LOCAKY
			 , LM.OBROUT
			 , TI.OWNRKY, TI.SKUKEY, SM.DESC01, SM.EANCOD
			 , TI.QTTAOR
			 , SM.DUOMKY AS UOMKEY
			 , TI.QTCOMP AS QTCOMP
			 , SM.DUOMKY AS UOMKEY2
			 , TI.SHPOKY
			 , TI.SHPOIT
			 , TI.LOCATG AS LOCATG
			 , TI.TRNUTG AS TRNUTG
			 , TI.SECTTG AS SECTTG
			 , (CASE WHEN TI.ACTCDT = '00000000' THEN TI.PAIDTG
									ELSE TI.PAIDAC END) AS PAIDAC
			 , (CASE WHEN TI.ACTCDT = '00000000' THEN TI.TTRUTY
									ELSE TI.ATRUTY END) AS ATRUTY
			 , TI.TMEAKY AS TMEAKY
			 , TI.TUOMKY AS TUOMKY
			 , TI.QTTPUM AS QTTPUM
			 , TI.TDUOKY AS TDUOKY
			 , TI.QTTDUM AS QTTDUM
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = TH.WAREKY AND SW.OWNRKY = TI.OWNRKY AND SW.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND TI.STATIT = 'NEW'
		   AND TH.TASKKY = #{TASKKY} 
		   AND TI.TASKIT = #{TASKIT}
		   <if test="BARCOD != null and BARCOD != ''">
		   AND (TI.SKUKEY = #{BARCOD} OR TI.TRNUSR = #{BARCOD} OR TI.LOCASR = #{BARCOD})
		</if>
		 ORDER BY TH.TASKKY, TI.TASKIT, LM.OBROUT, LM.LOCAKY
	</select>
	
	<select id="PDPK01SKUCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS CNT
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = TH.WAREKY AND SW.OWNRKY = TI.OWNRKY AND SW.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND TI.STATIT = 'NEW'
		<if test="TASKKY != null and TASKKY != ''">
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		</if>
		<if test="BARCOD != null and BARCOD != ''">
		   AND (TI.SKUKEY = #{BARCOD} OR TI.TRNUSR = #{BARCOD} OR TI.LOCASR = #{BARCOD})
		</if>
	</select>
	
	<select id="PDPK01LOCCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT CASE WHEN S.AREAKY = 'SHP' THEN 0
			   ELSE SUM(S.QTSIWH-S.QTSBLK-GREATEST(S.QTSALO,S.QTSPMO)) - (CASE WHEN S.LOTA06 IN ('00') OR SUM(S.QTSPMO) &gt; 0 THEN 0 ELSE SUM(S.QTSIWH) END)
			   END AS USEQTY
			 , S.LOCAKY
			 , S.AREAKY
			 , S.ZONEKY
		  FROM STKKY S, SKUMA M, SKUWC W
		 WHERE S.SKUKEY = M.SKUKEY
		   AND S.OWNRKY = M.OWNRKY
		   AND S.SKUKEY = W.SKUKEY
		   AND S.WAREKY = W.WAREKY
		   AND S.OWNRKY = W.OWNRKY
		   AND ( S.QTSIWH &gt; 0 OR S.QTSPMI &gt;0 )
		   AND S.WAREKY = 'WH01'
		   AND S.OWNRKY = 'HNW'
		   AND S.LOCAKY = #{LOCAKY2}
		   AND S.SKUKEY = #{SKUKEY}
		 GROUP BY S.OWNRKY, S.WAREKY, S.AREAKY, S.ZONEKY, S.LOCAKY, 
				  S.SKUKEY, M.DESC01, M.SKUG01, M.SKUG04, M.SKUG05,
				  S.ASKU01, M.DESC02, S.TRNUID, S.LOTA06
	</select>
	
	<select id="PDPK01ALSTKY_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.DBFILD
			 , A.RNGVMI 
		  FROM RLRRI A
		 WHERE 1 = 1
		   AND A.LOTRKY = (SELECT ALFTKY
							 FROM ALSTI
							WHERE 1 = 1
							  AND WAREKY = 'WH01'
							  AND ALSTKY =(SELECT ALSTKY 
											 FROM SHPDI
											WHERE SHPOKY = #{SHPOKY}
											  AND SHPOIT = #{SHPOIT}))
		   AND A.WAREKY = #{WAREKY}
	</select>
	
	<select id="PDPK01_MAP" parameterType="Map" resultType="DataMap">
		 { call P_AIRWMS_PICKING_COMPLETE( #{TASKKY}, #{TASKIT}, 'SHPLOC', ' ', #{QTCOMP}, #{SES_USER_ID} ) }
	</select>
	
	<select id="PDPK01CNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS CNT
		     , SUM(TI.QTTAOR) AS QTTAOR
		     , SUM(TI.QTCOMP) AS QTCOMP
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
		                          AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND TI.STATIT = 'NEW'
		<if test="TASKKY != null and TASKKY != ''">
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		</if>
		<if test="BARCOD != null and BARCOD != ''">
		   AND (TI.SKUKEY = #{BARCOD} OR TI.TRNUSR = #{BARCOD} OR TI.LOCASR = #{BARCOD})
		</if>
		 ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT
	</select>

	<select id="PDPK01SUBCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) CNT
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND TI.STATIT = 'NEW'
		<if test="TASKKY != null and TASKKY != ''">
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		</if>
		<if test="BARCOD != null and BARCOD != ''">
		   AND (TI.SKUKEY = #{BARCOD} OR TI.TRNUSR = #{BARCOD} OR TI.LOCASR = #{BARCOD})
		</if>
	</select>	
		   
	<select id="PDPK01UOM_MAP" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT SM.DUOMKY AS UOMKEY
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
		                          AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		<if test="TASKKY != null and TASKKY != ''">
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		</if>
		<if test="BARCOD != null and BARCOD != ''">
		   AND (TI.SKUKEY = #{BARCOD} OR TI.TRNUSR = #{BARCOD} OR TI.LOCASR = #{BARCOD})
		</if>
	</select>
	
	<select id="PDPK01_SAVE_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY AS WAREKY,
		       B.TASKKY AS TASKKY,
		       B.TASKIT AS TASKIT,
		       B.TASKTY AS TASKTY,
		       B.RSNCOD AS RSNCOD,
		       B.TASRSN AS TASRSN,
		       B.STATIT AS STATIT,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = B.STATIT) AS STATITNM,
		       B.QTTAOR AS QTTAOR,
		       B.QTTAOR AS QTCOMP,
		       B.OWNRKY AS OWNRKY,
		       B.SKUKEY AS SKUKEY,
		       B.LOTNUM AS LOTNUM,
		       B.ACTCDT AS ACTCDT,
		       B.ACTCTI AS ACTCTI,
		       B.QTYUOM AS QTYUOM,
		       B.TKFLKY AS TKFLKY,
		       B.STEPNO AS STEPNO,
		       B.LSTTFL AS LSTTFL,
		       B.LOCASR AS LOCASR,
		       B.SECTSR AS SECTSR,
		       B.PAIDSR AS PAIDSR,
		       B.TRNUSR AS TRNUSR,
		       B.STRUTY AS STRUTY,
		       B.SMEAKY AS SMEAKY,
		       B.SUOMKY AS SUOMKY,
		       B.QTSPUM AS QTSPUM,
		       B.SDUOKY AS SDUOKY,
		       B.QTSDUM AS QTSDUM,
		       B.LOCATG AS LOCATG,
		       B.SECTTG AS SECTTG,
		       B.PAIDTG AS PAIDTG,
		       B.TRNUTG AS TRNUTG,
		       B.TTRUTY AS TTRUTY,
		       B.TMEAKY AS TMEAKY,
		       B.TUOMKY AS TUOMKY,
		       B.QTTPUM AS QTTPUM,
		       B.TDUOKY AS TDUOKY,
		       B.QTTDUM AS QTTDUM,
		       B.LOCATG AS LOCAAC,
		       B.SECTTG AS SECTAC,
		       B.PAIDTG AS PAIDAC,
		       B.TRNUTG AS TRNUAC,
		       B.TTRUTY AS ATRUTY,
		       B.TMEAKY AS AMEAKY,
		       B.TUOMKY AS AUOMKY,
		       B.QTTPUM AS QTAPUM,
		       B.TDUOKY AS ADUOKY,
		       B.QTTDUM AS QTADUM,
		       B.REFDKY AS REFDKY,
		       B.REFDIT AS REFDIT,
		       B.REFCAT AS REFCAT,
		       B.REFDAT AS REFDAT,
		       B.PURCKY AS PURCKY,
		       B.PURCIT AS PURCIT,
		       B.ASNDKY AS ASNDKY,
		       B.ASNDIT AS ASNDIT,
		       B.RECVKY AS RECVKY,
		       B.RECVIT AS RECVIT,
		       B.SHPOKY AS SHPOKY,
		       B.SHPOIT AS SHPOIT,
		       B.GRPOKY AS GRPOKY,
		       B.GRPOIT AS GRPOIT,
		       B.SADJKY AS SADJKY,
		       B.SADJIT AS SADJIT,
		       B.SDIFKY AS SDIFKY,
		       B.SDIFIT AS SDIFIT,
		       B.PHYIKY AS PHYIKY,
		       B.PHYIIT AS PHYIIT,
		       B.DROPID AS DROPID,
		       B.DESC01 AS DESC01,
		       B.DESC02 AS DESC02,
		       B.ASKU01 AS ASKU01,
		       B.ASKU02 AS ASKU02,
		       B.ASKU03 AS ASKU03,
		       B.ASKU04 AS ASKU04,
		       B.ASKU05 AS ASKU05,
		       B.EANCOD AS EANCOD,
		       B.GTINCD AS GTINCD,
		       B.SKUG01 AS SKUG01,
		       B.SKUG02 AS SKUG02,
		       B.SKUG03 AS SKUG03,
		       B.SKUG04 AS SKUG04,
		       B.SKUG05 AS SKUG05,
		       B.GRSWGT AS GRSWGT,
		       B.NETWGT AS NETWGT,
		       B.WGTUNT AS WGTUNT,
		       B.LENGTH AS LENGTH,
		       B.WIDTHW AS WIDTHW,
		       B.HEIGHT AS HEIGHT,
		       B.CUBICM AS CUBICM,
		       B.CAPACT AS CAPACT,
		       B.WORKID AS WORKID,
		       B.WORKNM AS WORKNM,
		       B.HHTTID AS HHTTID,
		       B.AREAKY AS AREAKY,
		       B.LOTA01 AS LOTA01,
		       B.LOTA02 AS LOTA02,
		       B.LOTA03 AS LOTA03,
		       B.LOTA04 AS LOTA04,
		       B.LOTA05 AS LOTA05,
		       B.LOTA06 AS LOTA06,
		       B.LOTA07 AS LOTA07,
		       B.LOTA08 AS LOTA08,
		       B.LOTA09 AS LOTA09,
		       B.LOTA10 AS LOTA10,
		       B.LOTA11 AS LOTA11,
		       B.LOTA12 AS LOTA12,
		       B.LOTA13 AS LOTA13,
		       B.LOTA14 AS LOTA14,
		       B.LOTA15 AS LOTA15,
		       B.LOTA16 AS LOTA16,
		       B.LOTA17 AS LOTA17,
		       B.LOTA18 AS LOTA18,
		       B.LOTA19 AS LOTA19,
		       B.LOTA20 AS LOTA20,
		       B.AWMSNO AS AWMSNO,
		       B.AWMSTS AS AWMSTS,
		       B.SMANDT AS SMANDT,
		       B.SEBELN AS SEBELN,
		       B.SEBELP AS SEBELP,
		       B.SZMBLNO AS SZMBLNO,
		       B.SZMIPNO AS SZMIPNO,
		       B.STRAID AS STRAID,
		       B.SVBELN AS SVBELN,
		       B.SPOSNR AS SPOSNR,
		       B.STKNUM AS STKNUM,
		       B.STPNUM AS STPNUM,
		       B.SWERKS AS SWERKS,
		       B.SLGORT AS SLGORT,
		       B.SDATBG AS SDATBG,
		       B.STDLNR AS STDLNR,
		       B.SSORNU AS SSORNU,
		       B.SSORIT AS SSORIT,
		       B.SMBLNR AS SMBLNR,
		       B.SZEILE AS SZEILE,
		       B.SMJAHR AS SMJAHR,
		       B.SXBLNR AS SXBLNR,
		       B.SAPSTS AS SAPSTS,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       C.AUTLOC AS AUTLOC,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK
		  FROM TASDH A,
		       TASDI B,
		       LOCMA C
		 WHERE A.TASKKY = B.TASKKY
		   AND A.WAREKY = C.WAREKY
		   AND B.LOCASR = C.LOCAKY
		   AND A.TASKKY = #{TASKKY}
		   AND B.TASKIT = #{TASKIT}
		   AND B.STATIT = 'NEW'
		 ORDER BY B.TASKKY, B.TASKIT
	</select>	
	
	<!-- ================================================================================================== -->
	<!-- PDPK01 상품별 피킹 : END-->
	<!-- ================================================================================================== -->
	
	
	
	
	
	<!-- ================================================================================================== -->
	<!-- PDPK02 팔레트별 피킹 : BEGIN-->
	<!-- ================================================================================================== -->
	<select id="PDPK02_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY AS TASKKY
		     , TI.TASKIT AS TASKIT
		     , TI.TRNUSR AS TRNUSR
		     , LM.LOCAKY AS LOCAKY
		     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),' ') AS STATIT
		     , TI.SKUKEY AS SKUKEY
		     , SM.DESC01 AS DESC01
		     , SM.EANCOD AS EANCOD
		     , TI.QTTAOR AS QTTAOR
		     , TI.QTCOMP AS QTCOMP
		     , SM.DUOMKY AS UOMKEY
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
		                          AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		 ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT
	</select>
	
	<select id="PDPK02SKU_LIST" parameterType="Map" resultType="DataMap">
		SELECT ROW_NUMBER() OVER(ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT) AS RNUM
		     , CASE WHEN TI.STATIT = 'NEW' THEN 'O'
		            ELSE 'X'
		       END AS SAVE_ENABLE
		     , TH.TASKKY, TI.TASKIT
		     , TI.STATIT, NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),0) AS STATITNM
		     , TI.LOCASR AS LOCAKY
		     , LM.OBROUT
		     , TI.OWNRKY, TI.SKUKEY, SM.DESC01, SM.EANCOD
		     , TI.QTTAOR
		     , SM.DUOMKY AS UOMKEY
		     , TI.QTCOMP AS QTCOMP
		     , SM.DUOMKY AS UOMKEY2
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = TH.WAREKY AND SW.OWNRKY = TI.OWNRKY AND SW.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		 ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT
	</select>
	
	<select id="PDPK02SKUCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS CNT
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = TH.WAREKY AND SW.OWNRKY = TI.OWNRKY AND SW.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
	</select>
	
	<select id="PDPK02_MAP" parameterType="Map" resultType="DataMap">
		 { call P_AIRWMS_PICKING_COMPLETE( #{TASKKY}, #{TASKIT}, 'SHPLOC', #{TRNUAC}, #{QTCOMP}, #{SES_USER_ID} ) }
	</select>
	
	<select id="PDPK02CNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS CNT
		     , SUM(TI.QTTAOR) AS QTTAOR
		     , SUM(TI.QTCOMP) AS QTCOMP
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
		                          AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		 ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT
	</select>

	<select id="PDPK02SUBCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) CNT
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND TI.STATIT = 'NEW'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
	</select>	
		   
	<select id="PDPK02UOM_MAP" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT SM.DUOMKY AS UOMKEY
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
		                          AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
	</select>
	<!-- ================================================================================================== -->
	<!-- PDPK02 팔레트별 피킹 : END-->
	<!-- ================================================================================================== -->
	
		<!-- ================================================================================================== -->
	<!-- PDPKRM01 라이판뮐러 팔레트별 피킹 : BEGIN-->
	<!-- ================================================================================================== -->
	<select id="PDPKRM01_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY AS TASKKY
		     , TI.TASKIT AS TASKIT
		     , TI.TRNUSR AS TRNUSR
		     , LM.LOCAKY AS LOCAKY
		     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),' ') AS STATIT
		     , TI.SKUKEY AS SKUKEY
		     , SM.DESC01 AS DESC01
		     , SM.EANCOD AS EANCOD
		     , TI.QTTAOR AS QTTAOR
		     , TI.QTCOMP AS QTCOMP
		     , SM.DUOMKY AS UOMKEY
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
		                          AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		 ORDER BY TH.TASKKY, TI.TASKIT
	</select>
	
	<select id="PDPKRM01SKUCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS CNT
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = TH.WAREKY AND SW.OWNRKY = TI.OWNRKY AND SW.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
	</select>
	
	<select id="PDPKRM01CNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS CNT
		     , SUM(TI.QTTAOR) AS QTTAOR
		     , SUM(TI.QTCOMP) AS QTCOMP
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
		                          AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		 ORDER BY TH.TASKKY, TI.TASKIT
	</select>
	
	<select id="PDPKRM01SUBCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) CNT
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND TI.STATIT = 'NEW'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
	</select>	
	
	<select id="PDPKRM01UOM_MAP" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT SM.DUOMKY AS UOMKEY
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
		                          AND SM.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
	</select>
	
	<select id="PDPKRM01_MAP" parameterType="Map" resultType="DataMap">
		 { call P_AIRWMS_PICKING_COMPLETE( #{TASKKY}, #{TASKIT}, 'SHPLOC', #{TRNUAC}, #{QTCOMP}, #{SES_USER_ID} ) }
	</select>
	
	<select id="PDPKRM01SKU_LIST" parameterType="Map" resultType="DataMap">
		SELECT ROW_NUMBER() OVER(ORDER BY LM.OBROUT, LM.LOCAKY, TH.TASKKY, TI.TASKIT) AS RNUM
		     , CASE WHEN TI.STATIT = 'NEW' THEN 'O'
		            ELSE 'X'
		       END AS SAVE_ENABLE
		     , TH.TASKKY
		     , TI.TASKIT
		     , TI.STATIT
		     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),0) AS STATITNM
		     , TI.SKUKEY AS SKUKEY
		     , TI.LOTNUM AS LOTNUM
		     , TI.LOCASR AS LOCAKY
		     , TI.TRNUSR AS TRNUSR
		     , LM.OBROUT AS OBROUT
		     , TI.OWNRKY AS OWNRKY
		     , TI.SKUKEY AS SKUKEY
		     , SM.DESC01 AS DESC01
		     , TI.QTTAOR AS QTTAOR
		     , SM.DUOMKY AS UOMKEY
		     , TI.QTCOMP AS QTCOMP
		     , SM.DUOMKY AS UOMKEY2
		     , TI.PTLT12 AS PTLT12
		     , TI.PTLT11 AS PTLT11
		  FROM TASDH TH
		       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		       INNER JOIN SKUWC SW ON SW.WAREKY = TH.WAREKY AND SW.OWNRKY = TI.OWNRKY AND SW.SKUKEY = TI.SKUKEY
		 WHERE 1 = 1
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASOTY = '330'
		   AND (TH.TASKKY = #{TASKKY} OR TH.TASKKY || TI.TASKIT = #{TASKKY})
		 ORDER BY TH.TASKKY, TI.TASKIT
	</select>
	
	
	<select id="PDPKRM01_QTSWRK_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) AS CNT
		     , SUM(QTSIWH) AS QTSIWH
		  FROM STKKY
		 WHERE WAREKY = #{WAREKY}
		   AND LOTNUM = #{LOTNUM}
		   AND LOCAKY = #{LOCAKY2}
		   AND TRNUID = #{TRNUAC}
		   AND QTSALO = 0
	</select>
	
	<select id="PDPKRM01_QTSAVB_MAP" parameterType="Map" resultType="DataMap">
		SELECT SUM(CASE WHEN (STD.LOTNUM || STD.LOCAKY || STD.TRNUID) = STD.CHKKEY 
		                THEN DECODE( SIGN(NVL(SUM(S.QTSIWH),0)),-1,0,(NVL(SUM(S.QTSIWH),0))-(STD.QTSWRK-STD.SUBQTT)) 
		                ELSE DECODE( SIGN(NVL(SUM(S.QTSIWH),0)-NVL(MAX(STD.QTSWRK),0)), -1, 0, (NVL(SUM(S.QTSIWH),0)-NVL(MAX(STD.QTSWRK),0)) ) 
		           END) AS QTSAVB
		  FROM STKKY S, LOCMA L ,( ${APPEND_QUERY}) STD 
		 WHERE S.WAREKY = #{WAREKY}
		   AND S.OWNRKY = #{OWNRKY}
		   AND S.SKUKEY = #{SKUKEY}
		   AND S.WAREKY = L.WAREKY 
		   AND S.LOCAKY = L.LOCAKY
		   AND S.AREAKY NOT IN ('SYS','SHP')
		   AND L.INDUPK = 'V'
		   AND ((S.QTSIWH &gt; 0 AND S.QTSPMO = 0) OR
		       (S.TASKKY = #{TASKKY} AND S.QTSPMO &gt; 0))
		   AND S.LOTNUM = STD.LOTNUM(+)
		   AND S.LOCAKY = STD.LOCAKY(+)
		   AND S.TRNUID = STD.TRNUID(+)
		   AND S.LOTNUM = #{LOTNUM}
		   AND S.LOCAKY = #{LOCAKY}
		   AND S.TRNUID = #{TRNUID}
		 GROUP BY S.LOTNUM, S.LOCAKY, S.TRNUID, STD.CHKKEY, STD.LOTNUM, STD.LOCAKY, STD.TRNUID, STD.QTSWRK, STD.SUBQTT
		HAVING (CASE WHEN (STD.LOTNUM || STD.LOCAKY || STD.TRNUID) = STD.CHKKEY 
		             THEN DECODE( SIGN(NVL(SUM(S.QTSIWH),0)),-1,0,(NVL(SUM(S.QTSIWH),0))-(STD.QTSWRK-STD.SUBQTT)) 
		             ELSE DECODE( SIGN(NVL(SUM(S.QTSIWH),0)-NVL(MAX(STD.QTSWRK),0)), -1, 0, (NVL(SUM(S.QTSIWH),0)-NVL(MAX(STD.QTSWRK),0)) ) 
		        END) &gt;0
	</select>	
	
	<select id="PDPKRM01_SHPINFO_MAP" parameterType="Map" resultType="DataMap">
		SELECT SI.SHPOKY AS SHPOKY
		     , SI.SHPOIT AS SHPOIT
		  FROM TASDH TH 
		       INNER JOIN TASDI TI ON TH.TASKKY = TI.TASKKY
		       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		       INNER JOIN SHPDI SI ON TI.SHPOIT = SI.SHPOIT AND TI.SHPOKY = SI.SHPOKY
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TH.TASKKY = #{TASKKY}
		   AND TI.TASKIT = #{TASKIT}
		   AND TI.STATIT = 'NEW'
	</select> 
	
	<select id="PDPKRM01_QTUALOCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT (I.QTSHPO-I.QTALOC) AS QTUALO
		  FROM SHPDI I 
		       INNER JOIN SHPDH H ON H.SHPOKY = I.SHPOKY
		 WHERE I.SHPOKY = H.SHPOKY 
		   AND I.SHPOKY = #{SHPOKY}
		   AND I.SHPOIT = #{SHPOIT}
	</select>
	
	
	
