               S.LOTA06  AS "LOTA06",
               S.LOTA07  AS "LOTA07",
               S.LOTA08  AS "LOTA08",
               S.LOTA09  AS "LOTA09",
               S.LOTA10  AS "LOTA10",
               S.LOTA11  AS "LOTA11",
               S.LOTA12  AS "LOTA12",
               S.LOTA13  AS "LOTA13",
               S.LOTA14  AS "LOTA14",
               S.LOTA15  AS "LOTA15",
               S.LOTA16  AS "LOTA16",
               S.LOTA17  AS "LOTA17",
               S.LOTA18  AS "LOTA18",
               S.LOTA19  AS "LOTA19",
               S.LOTA20  AS "LOTA20",
               S.AWMSNO  AS "AWMSNO",
               S.DESC01  AS "DESC01",
               S.DESC02  AS "DESC02",
               S.ASKU01  AS "ASKU01",
               S.ASKU02  AS "ASKU02",
               S.ASKU03  AS "ASKU03",
               S.ASKU04  AS "ASKU04",
               S.ASKU05  AS "ASKU05",
               S.EANCOD  AS "EANCOD",
               S.GTINCD  AS "GTINCD",
               S.SKUG01  AS "SKUG01",
               S.SKUG02  AS "SKUG02",
               S.SKUG03  AS "SKUG03",
               S.SKUG04  AS "SKUG04",
               S.SKUG05  AS "SKUG05",
               S.GRSWGT  AS "GRSWGT",
               S.NETWGT  AS "NETWGT",
               S.WGTUNT  AS "WGTUNT",
               S.LENGTH  AS "LENGTH",
               S.WIDTHW  AS "WIDTHW",
               S.HEIGHT  AS "HEIGHT",
               S.CUBICM  AS "CUBICM",
               S.CAPACT  AS "CAPACT",
               S.ZONEKY  AS "ZONEKY",
               S.TKZONE  AS "TKZONE",
               S.AREAKY  AS "AREAKY",
               S.SMANDT  AS "SMANDT",
               S.SEBELN  AS "SEBELN",
               S.SEBELP  AS "SEBELP",
               S.SZMBLNO AS "SZMBLNO",
               S.SZMIPNO AS "SZMIPNO",
               S.STRAID  AS "STRAID",
               S.SVBELN  AS "SVBELN",
               S.SPOSNR  AS "SPOSNR",
               S.STKNUM  AS "STKNUM",
               S.STPNUM  AS "STPNUM",
               S.SWERKS  AS "SWERKS",
               S.SLGORT  AS "SLGORT",
               S.SDATBG  AS "SDATBG",
               S.STDLNR  AS "STDLNR",
               S.SSORNU  AS "SSORNU",
               S.SSORIT  AS "SSORIT",
               S.SMBLNR  AS "SMBLNR",
               S.SZEILE  AS "SZEILE",
               S.SMJAHR  AS "SMJAHR",
               S.SXBLNR  AS "SXBLNR",
               S.SAPSTS  AS "SAPSTS",
               S.SBKTXT  AS "SBKTXT",
               S.CREDAT  AS "CREDAT",
               S.CRETIM  AS "CRETIM",
               S.CREUSR  AS "CREUSR",
               S.LMODAT  AS "LMODAT",
               S.LMOTIM  AS "LMOTIM",
               S.LMOUSR  AS "LMOUSR",
               NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = #{SHPMTY}), ' ') AS "LOCATG",
               CASE WHEN S.AREAKY = 'SHP' THEN 0
							ELSE S.QTSIWH - S.QTSBLK
										  - GREATEST(S.QTSALO, S.QTSPMO)
										  - (CASE WHEN S.LOTA06 IN ('00') OR S.QTSPMO > 0 THEN 0
												  ELSE S.QTSIWH
											 END)
					   END								 AS USEQTY
          FROM STKKY S
               INNER JOIN LOCMA L
                       ON L.WAREKY = S.WAREKY
                      AND L.LOCAKY = S.LOCAKY
         WHERE S.OWNRKY = #{OWNRKY}
           AND S.WAREKY = #{WAREKY}
           <if test="SKUKEY != null and SKUKEY != ''">         
           AND S.SKUKEY = NVL(TRIM(#{SKUKEY}), ' ')
           </if>
           <if test="STOKKY != null and STOKKY != ''">         
            AND S.STOKKY = #{STOKKY}
           </if>
           <if test="LOCAKY != null and LOCAKY != ''">         
            AND S.LOCAKY = #{LOCAKY}
           </if>
           <if test="BARCOD != null and BARCOD != ''">         
            AND S.LOTA14 = #{BARCOD}
           </if>
            AND S.LOTA07 = NVL(#{LOTA07}, ' ')
           AND S.AREAKY NOT IN ('SYS', 'SHP')
           AND S.QTSIWH &gt; 0
           AND S.QTSALO = 0
           AND S.QTSPMO = 0
           AND S.QTSPMI = 0
           AND S.QTSBLK = 0
           AND S.LOTA06 = '00'
           AND L.INDUPK = 'V'
           AND L.STATUS = '00'
         ORDER BY S.STOKKY
    </select>
    
	<!-- ================================================================================================== -->
	<!-- PDDL05 WAVE별 출고검수 : START-->
	<!-- ================================================================================================== -->
	<!-- PDDL05 WAVE별 출고검수 조회-->
	<select id="PDDL05_LIST" parameterType="Map" resultType="DataMap">
		SELECT SI.SHPOKY AS SHPOKY
				, SI.SHPOIT AS SHPOIT
				, SH.WAREKY AS WAREKY
				, SH.OWNRKY AS OWNRKY
				, SI.QTYORG AS QTYORG
				, SI.QTSHPO AS QTSHPO
				, (SI.QTSHPO-SI.QTALOC) AS QTUALO
				, SI.QTALOC AS QTALOC
				, SI.QTSHPD AS QTSHPD
				, SI.QTSHPC AS QTSHPC
				, SI.QTJCMP AS QTJCMP
				, SI.SKUKEY AS SKUKEY
				, SI.DESC01 AS DESC01
				, CT.NAME01 AS PTNRNM
				, SI.STATIT AS STATIT
				, NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = SI.STATIT),' ') AS STATNM
                , SI.ESHPKY AS ESHPKY
                , SI.ESHPIT AS ESHPIT				
		  FROM SHPDI SI
			INNER JOIN SHPDH SH ON SH.SHPOKY = SI.SHPOKY
			LEFT OUTER JOIN BZPTN CT ON CT.PTNRKY = SH.DPTNKY AND CT.PTNRTY = 'CT' AND CT.OWNRKY = SH.OWNRKY
		 WHERE SI.SHPOKY = #{SHPOKY}
		<if test="SKUKEY != null and SKUKEY != ''">
		   AND SI.SKUKEY = #{SKUKEY}
		</if>
	</select>
	
	<!-- 분배우선순위 쿼리 -->
	<select id="PDDL05SEQ_LIST" parameterType="Map" resultType="DataMap">
		SELECT SEQCUS
		 FROM SHPDH SH
			LEFT OUTER JOIN ALCUS AL ON AL.WAREKY = #{SES_WAREKY} AND AL.DOCUTY = SH.SHPMTY
		WHERE SH.WAREKY = #{SES_WAREKY}
		  AND SHPOKY = #{SHPOKY}
	</select>
	
	<!-- 분배 조회 -->
	<select id="PDDL05Detail_LIST" parameterType="Map" resultType="DataMap">
		SELECT SI.ESHPKY --그룹오더번호
			 , SI.ESHPIT
			 , SI.SHPOKY --출하문서번호
			 , SI.SHPOIT
			 , IFW.KUNAG AS PTNRKY  --거래처
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'CT' AND PTNRKY = IFW.KUNAG AND ROWNUM = 1) AS PTNRNM
			 , SM.SKUKEY
			 , SM.DESC01
			 , SM.DESC02
			 , SI.QTYORG
			 , SI.QTSHPO
			 , SI.QTJCMP
			 , SI.QTSHPC
		 FROM SHPDH SH
			LEFT OUTER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
			LEFT OUTER JOIN SKUMA SM ON SM.SKUKEY = SI.SKUKEY AND SM.OWNRKY = SH.OWNRKY
			LEFT OUTER JOIN IFWMS113 IFW ON IFW.VBELN = SI.REFDKY AND IFW.SKUKEY = SI.SKUKEY AND IFW.WAREKY = SH.WAREKY
		WHERE SI.ESHPKY = #{S_SHPOKY}
		  AND SM.SKUKEY = #{S_SKUKEY}
	</select>
	
	<!-- 저장시 검수수량 update -->
	<update id="PDDL05_UPDATE" parameterType="Map">
		UPDATE SHPDI
		   SET QTSHPC = #{QTSHPC}
			 , STATIT = #{STATIT}
			 , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		 WHERE SHPOKY = #{SHPOKY}
		   AND SHPOIT = #{SHPOIT}
	</update>
	<!-- ================================================================================================== -->
	<!-- PDDL05 WAVE별 출고검수 : END -->
	<!-- ================================================================================================== -->
	
	
	<!-- ================================================================================================== -->
	<!-- PDPK05 지시번호별 피킹 : END-->
	<!-- ================================================================================================== -->
	<select id="PDPK05_DOC_LIST" parameterType="Map" resultType="DataMap">
	SELECT STKNUM , STKNUM_STATUS, (SELECT CDESC1         
                FROM CMCDV WHERE CMCDKY = 'STATDO' 
                AND CMCDVL = STATDO
                ) AS STATDONM
	
	FROM (
        
		SELECT STKNUM , CASE WHEN STKNUM_STATUS = 'O' THEN '오더번호'
                             WHEN STKNUM_STATUS = 'S' THEN '선적번호'   
                             WHEN STKNUM_STATUS = 'T' THEN '토탈피킹번호'
                        END STKNUM_STATUS
                       ,CASE WHEN STATDO LIKE '%FPC%' AND STATDO LIKE '%PPC%'
							                         THEN 'PPC'					                       					                                                                
		                                           WHEN STATDO LIKE '%FPC%'
							                         THEN 'FPC'					                       					                                                                       
		                                           WHEN STATDO LIKE '%PPC%'
							                         THEN 'PPC'					                       					                                                                         
		                                           WHEN STATDO LIKE '%NEW%'
							                         THEN 'NEW'					                       					                                                                           
							                  	  ELSE STATDO  
		                 END STATDO
		FROM (
		
				SELECT NVL(TRIM(SI.STKNUM), SI.SVBELN) AS STKNUM, DECODE(TRIM(SI.STKNUM), '', 'O', 'S') STKNUM_STATUS, SI.STATIT, LISTAGG(SI.STATIT,',') WITHIN GROUP (ORDER BY NULL) OVER (PARTITION BY  SI.STKNUM) AS STATDO	
				  FROM SHPDH SH INNER JOIN SHPDI SI			  
				                ON SI.SHPOKY = SH.SHPOKY
				               AND SI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY}  AND MTYPE LIKE #{SES_MTYPE})
			        	   	   AND SI.STATIT IN('NEW', 'PAL', 'FAL', 'PPC', 'FPC') 	
				             WHERE SH.WAREKY = #{WAREKY}             
				               AND SH.DOCDAT = #{ORDDAT}							
				   ) 
   
		) GROUP BY STKNUM, STKNUM_STATUS,STATDO
	
	
	</select>
	
	<select id="PDPK05_DOC2_LIST" parameterType="Map" resultType="DataMap">
	
		SELECT C.STKNUM, C.TASKKY,
			   (SELECT CDESC1         
                FROM CMCDV WHERE CMCDKY = 'STATDO' 
                AND CMCDVL = C.STATDO
                ) AS STATDONM
        FROM (       
			    SELECT   DISTINCT    A.STKNUM,
                                     A.TASKKY,
                                     <if test="STATIT != 'FPC'">
				        	  	 	  CASE WHEN A.STATDO LIKE '%${STATIT}%'
					                         THEN #{STATIT}					                       					                                                                
					                  	  ELSE A.STATDO
				        			 </if>
				        			 <if test="STATIT == 'FPC'">
				        	  	 	  CASE WHEN A.STATDO LIKE '%FPC%' AND A.STATDO LIKE '%PPC%'
					                         THEN 'PPC'					                       					                                                                
                                           WHEN A.STATDO LIKE '%FPC%'
					                         THEN 'FPC'					                       					                                                                       
                                           WHEN A.STATDO LIKE '%PPC%'
					                         THEN 'PPC'					                       					                                                                         
					                  	  ELSE A.STATDO
				        			 </if>
					                      
					                 END AS STATDO
		     	FROM ( SELECT  
				               NVL(TRIM(TI.STKNUM), '') AS STKNUM,
				               TI.SHPOKY,
				               TI.SHPOIT,
                               TI.TASKKY,
				               LISTAGG(TI.STATIT,',') WITHIN GROUP (ORDER BY NULL) OVER (PARTITION BY  TI.STKNUM) AS STATDO		       
				        FROM  TASDH TH                                       
				        INNER JOIN TASDI TI
				              ON TI.TASKKY = TH.TASKKY
				               AND TI.TASKTY IN ('PK')
				               AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
				               
				        <if test="STATIT != 'FPC'">
				        	  AND TI.STATIT IN(#{STATIT}) 	
				        </if>
				        <if test="STATIT == 'FPC'">
				         INNER JOIN SHPDI  SI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT				         
				        	  AND TI.STATIT IN('FPC', 'PPC') 	
                              AND SI.STATIT IN('FPC', 'PPC', 'PCK')				        	   
				        </if>	                    
						WHERE TH.WAREKY = #{WAREKY}
						AND TI.TASKTY IN ('PK')	
			            <if test="ORDDAT != null and ORDDAT != ''">
						AND TH.DOCDAT = #{ORDDAT}
						</if>
				     ) A  
				        
				
						      
		 )    C	 
		 
		 ORDER BY C.TASKKY ASC
	</select>
	
	<select id="PDPK05_LIST" parameterType="Map" resultType="DataMap">    
		SELECT BZPTN.PTNRKY
		     , BZPTN.NAME01 AS PTNRNM
		     , #{STKNUM} AS STKNUM
		     , MIN(CASE WHEN STATDO IN ('NEW', 'FAL', 'PAL', 'PPC') THEN 'N' ELSE 'Y' END) AS CMPYN
		     , 'N' AS TPYN
		  FROM SHPDH
		 LEFT JOIN BZPTN
		    ON SHPDH.DPTNKY = BZPTN.PTNRKY
		   AND BZPTN.PTNRTY = 'CT'
         WHERE SHPOKY IN (  SELECT SHPOKY
                              FROM SHPDI
                             WHERE STKNUM = #{STKNUM}
                               AND STATIT != ' ')
         GROUP BY BZPTN.PTNRKY, BZPTN.NAME01
    </select>
            		
	
	<select id="PDPK05_COUNT_LIST" parameterType="Map" resultType="DataMap">
		SELECT SUM(CASE WHEN STATDO IN ('NEW', 'FAL', 'PAL', 'PPC') THEN 1 ELSE 0 END) AS NOWCOMPCNT
		     , COUNT(SHPOKY) AS TOTCOMPCNT 
		  FROM SHPDH
		 WHERE SHPOKY IN (  SELECT SHPOKY
		                      FROM SHPDI
		                     WHERE STKNUM = #{STKNUM}
		                       AND STATIT != ' ')
	</select>	
	
	<select id="PDPK06HL_DETAIL_LIST" parameterType="Map" resultType="DataMap">

	SELECT 	  A.SKUKEY
			, A.DESC01
			, SUM(A.QTSHPO) AS QTSHPO
			, SUM(A.QTJCMP) AS QTJCMP
			, A.DUOMKY
			, SUM(A.QTYORG) AS QTYORG
			, A.UOMKEY
			, A.STKNUM
			, A.LOTA07
			, A.LOTA01
			, A.LOTA02
			, LISTAGG(DISTINCT(A.STATIT), ',') AS STATIT
	FROM(
		
		SELECT    SI.SKUKEY
				, SM.DESC01
				, SI.QTSHPO
				, SI.QTJCMP
				, SI.DUOMKY
				, NVL(SI.QTYORG,0) AS QTYORG
				, SI.UOMKEY
				, SI.STATIT
				, NVL(TRIM(SI.STKNUM), SI.SVBELN) AS STKNUM
				, SI.LOTA07
				, SI.LOTA01
				, SI.LOTA02
		FROM SHPDH SH
		INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
		INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY
		WHERE SH.WAREKY = #{WAREKY}
		AND SI.STATIT IN ('NEW', 'FAL', 'PAL', 'PPC', 'FPC')

		<if test="STKNUM != null and STKNUM != ''">
			AND (SI.STKNUM = #{STKNUM})
		</if>
		<if test="DPTNKY != null and DPTNKY != ''">
			AND SH.DPTNKY = #{DPTNKY}
		</if>
	) A
	GROUP BY  A.SKUKEY
			, A.DESC01
			, A.DUOMKY
			, A.UOMKEY
			, A.STKNUM
			, A.LOTA07
			, A.LOTA01
			, A.LOTA02 
	ORDER BY DECODE(LISTAGG(DISTINCT(A.STATIT), ','), 'FPC', 1, 0) ASC, A.SKUKEY
      
	</select>
	<select id="PDPK05_DETAIL_LIST" parameterType="Map" resultType="DataMap">

	SELECT 	  A.SKUKEY
			, A.DESC01
			, SUM(A.QTSHPO) AS QTSHPO
			, SUM(A.QTSHPOBOX) AS QTSHPOBOX -- 지시수량
			, SUM(A.QTJCMP) AS QTJCMP
			, SUM(A.QTJCMPBOX) AS QTJCMPBOX --피킹수량
			, A.DUOMKY
			, SUM(A.QTYORG) AS QTYORG
			, SUM(A.QTYORGBOX) AS QTYORGBOX  --오더수량
			, A.UOMKEY
			, A.STKNUM
			, A.LOTA07
			, LISTAGG(DISTINCT(A.STATIT), ',') AS STATIT 
			, A.USARG2 AS SKU_ORDER
	FROM(
		<choose>
		 	<!-- AND (SI.STKNUM = #{STKNUM} OR SI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) OR SI.SVBELN = #{STKNUM}) 조건 UNION 분리 -->
			<when test="STKNUM != null and STKNUM != ''">
				SELECT    SI.SKUKEY
						, SM.DESC01
						, SI.QTSHPO
						, SI.QTJCMP
						, SI.DUOMKY
						, NVL(SI.QTYORG,0) AS QTYORG
						, SI.UOMKEY
						, SI.STATIT
						, NVL(TRIM(SI.STKNUM), SI.SVBELN) AS STKNUM
						, SI.LOTA07
						, SI.SVBELN
					    , CASE WHEN SI.QTSHPO = 0 OR SI.DUOMKY != 'BAG' THEN 0 
					           ELSE SI.QTSHPO/ NVL((TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTSHPO, SI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTSHPO, SI.UOMKEY, 'BOX'))),'0') END AS QTSHPOBOX --지시수량
                        , CASE WHEN SI.QTJCMP = 0 OR SI.DUOMKY != 'BAG' THEN 0 
					           ELSE SI.QTJCMP/ NVL((TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTJCMP, SI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTJCMP, SI.UOMKEY, 'BOX'))),'0') END AS QTJCMPBOX --피킹수량		
						, CASE WHEN  NVL(SI.QTYORG,0) = 0 OR SI.DUOMKY != 'BAG' THEN 0 
					           ELSE  NVL(SI.QTYORG,0)/ NVL((TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY,  NVL(SI.QTYORG,0), SI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY,  NVL(SI.QTYORG,0), SI.UOMKEY, 'BOX'))),'0') END AS QTYORGBOX --오더수량		
						, CM.USARG2 
				FROM SHPDH SH
				INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
				INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY 
				LEFT JOIN CMCDV CM ON SM.SKUL01 = CM.CMCDVL AND CM.CMCDKY = 'SKUL01'
				WHERE SH.WAREKY = #{WAREKY}
				AND SI.STATIT IN ('NEW', 'FAL', 'PAL', 'PPC', 'FPC')
				AND SI.STKNUM = #{STKNUM}
				<if test="DPTNKY != null and DPTNKY != ''">
					AND SH.DPTNKY = #{DPTNKY}
				</if>
			</when>
			<otherwise>
				SELECT    SI.SKUKEY
						, SM.DESC01
						, SI.QTSHPO
						, SI.QTJCMP
						, SI.DUOMKY
						, NVL(SI.QTYORG,0) AS QTYORG
						, SI.UOMKEY
						, SI.STATIT
						, NVL(TRIM(SI.STKNUM), SI.SVBELN) AS STKNUM
						, SI.LOTA07
						, CASE WHEN SI.QTSHPO = 0 OR SI.DUOMKY != 'BAG' THEN 0 
					           ELSE SI.QTSHPO/ NVL((TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTSHPO, SI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTSHPO, SI.UOMKEY, 'BOX'))),'0') END AS QTSHPOBOX --지시수량
                        , CASE WHEN SI.QTJCMP = 0 OR SI.DUOMKY != 'BAG' THEN 0 
					           ELSE SI.QTJCMP/ NVL((TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTJCMP, SI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTJCMP, SI.UOMKEY, 'BOX'))),'0') END AS QTJCMPBOX --피킹수량		
						, CASE WHEN  NVL(SI.QTYORG,0) = 0 OR SI.DUOMKY != 'BAG' THEN 0 
					           ELSE  NVL(SI.QTYORG,0)/ NVL((TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY,  NVL(SI.QTYORG,0), SI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY,  NVL(SI.QTYORG,0), SI.UOMKEY, 'BOX'))),'0') END AS QTYORGBOX --오더수량		
						, CM.USARG2 
				FROM SHPDH SH
				INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
				INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY 
				LEFT JOIN CMCDV CM ON SM.SKUL01 = CM.CMCDVL AND CM.CMCDKY = 'SKUL01' 
				WHERE SH.WAREKY = #{WAREKY}
				AND SI.STATIT IN ('NEW', 'FAL', 'PAL', 'PPC', 'FPC')
				<if test="DPTNKY != null and DPTNKY != ''">
					AND SH.DPTNKY = #{DPTNKY}
				</if>
			</otherwise>
		</choose>	
	) A
	GROUP BY  A.SKUKEY
			, A.DESC01
			, A.DUOMKY
			, A.UOMKEY
			, A.STKNUM
			, A.LOTA07 
			, A.USARG2 
	ORDER BY DECODE(LISTAGG(DISTINCT(A.STATIT), ','), 'FPC', 1, 0) ASC, SKU_ORDER,  A.SKUKEY
	</select>
	
	<select id="PDPK05_DETAIL2_LIST" parameterType="Map" resultType="DataMap">
    SELECT Z.LOCAKY,
           Z.SKUKEY,
           Z.STKNUM,
           Z.DESC01,
           SUM(Z.QTTAOR) QTTAOR,
           Z.EANCOD,
		   Z.GTINCD, 
           Z.STATDONM,
           SUM(Z.QTCOMP) QTCOMP, 
           Z.LOTA01,
           Z.LOTA02,
           Z.LOTA07,
           Z.TASKKY,
           Z.UOMKEY,
           Z.DUOMKY,
           Z.QTYORG,
           Z.SHPOKY
	FROM
	(
    
    	SELECT A.LOCAKY,
           A.SKUKEY,
           A.STKNUM,
           A.DESC01,
           A.QTTAOR,
           A.EANCOD,
		   A.GTINCD, 
           A.STATDONM,
           A.QTCOMP, 
           A.LOTA01,
           A.LOTA02,
           A.LOTA07,
           A.TASKKY,
           A.UOMKEY,
           A.DUOMKY,
           A.QTYORG,
           A.SHPOKY
   		FROM (   

    	   SELECT DISTINCT
    	   				B.TASKKY, 
    	   				B.LOCAKY,
		                B.SKUKEY,
		                B.STKNUM,
		                B.DESC01,
		                B.QTTAOR,
		                B.QTCOMP,
		                B.EANCOD,
					    B.GTINCD,
					    B.LOTA01,
				        B.LOTA02,
				        B.LOTA07,
		                (SELECT CDESC1         
		                 FROM CMCDV WHERE CMCDKY = 'STATDO' 
		                	   AND CMCDVL =  CASE  WHEN B.STATDO LIKE '%PPC%' AND B.STATDO LIKE '%NEW%'
							                         THEN 'PPC'
		                                           WHEN B.STATDO LIKE '%FPC%' AND B.STATDO LIKE '%NEW%'
							                         THEN 'PPC'  
							                       WHEN B.STATDO LIKE '%PPC%'
							                         THEN 'PPC'                                             
							                       WHEN B.STATDO LIKE '%FPC%'
							                         THEN 'FPC'
							                       WHEN B.STATDO NOT LIKE '%PPC%' AND B.STATDO NOT LIKE '%FPC%' AND B.STATDO LIKE '%NEW%'
							                         THEN 'NEW'                            					                           
							                  	  ELSE B.STATDO    
							                 END 
		                ) AS STATDONM,  
		                B.UOMKEY,
			            B.DUOMKY,
			            B.QTYORG,
			            B.SHPOKY
		                                   
           FROM(

					SELECT       
						   TH.TASKKY AS TASKKY
						 , LM.LOCAKY AS LOCAKY                             
						 , SI.SKUKEY AS SKUKEY
						 , SI.STKNUM AS STKNUM
						 , SM.DESC01 AS DESC01
						 , SUM(NVL(TI.QTTAOR,0)) OVER (PARTITION BY    TI.SKUKEY, LM.LOCAKY) AS QTTAOR
						 , SUM(NVL(TI.QTCOMP,0)) OVER (PARTITION BY    TI.SKUKEY, LM.LOCAKY) AS QTCOMP
						 , SM.EANCOD AS EANCOD
						 , SM.GTINCD AS GTINCD
						 , TI.LOTA01
			           	 , TI.LOTA02
			           	 , TI.LOTA07
						 , LISTAGG(TI.STATIT,',') WITHIN GROUP (ORDER BY NULL) OVER (PARTITION BY  TI.TASKKY, TI.SHPOKY, TI.SHPOIT, TI.SKUKEY, LM.LOCAKY) AS STATDO
						 , SI.UOMKEY
				         , SI.DUOMKY
				         , SUM(NVL(SI.QTYORG, 0)) OVER (PARTITION BY    TI.SKUKEY, NVL(TRIM(TI.ASKU01), TI.LOCASR)) AS QTYORG				         
				         , SH.SHPOKY
					FROM SHPDH SH
						   INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
						   INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
						   INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
						   INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
						   INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY
						                      AND SM.SKUKEY = SI.SKUKEY
					WHERE 1 = 1
			               AND TH.WAREKY = #{WAREKY}
			               AND TH.TASOTY = '330'
		                   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		                   AND SM.MTYPE LIKE #{SES_MTYPE}               
			               AND TI.STATIT IN('NEW', 'PPC', 'FPC')
			               AND TI.TASKTY IN ('PK')
			               <if test="STKNUM != null and STKNUM != ''">
			               AND (TI.STKNUM = #{STKNUM})
			               </if>             
			               <if test="DPTNKY != null and DPTNKY != ''">
							AND TH.PTNRKY = #{DPTNKY}
						   </if>
					   
			) B
			
         )A                  
         
         )Z
         
       GROUP BY    Z.LOCAKY,
                   Z.SKUKEY,
                   Z.STKNUM,
                   Z.DESC01,
                   Z.EANCOD,
                   Z.GTINCD, 
                   Z.STATDONM,
                   Z.LOTA01,
                   Z.LOTA02,
                   Z.LOTA07,
                   Z.TASKKY,
                   Z.UOMKEY,
                   Z.DUOMKY,
                   Z.QTYORG,
                   Z.SHPOKY
                   
                   
        ORDER BY  Z.TASKKY, Z.SKUKEY, Z.LOCAKY ASC
         
	</select>
	
	<select id="PDPK05_DETAIL_SUB_LIST" parameterType="Map" resultType="DataMap">
	SELECT TH.TASKKY
					 , TI.TASKIT
				     , LM.LOCAKY AS LOCAKY
				     , TI.SKUKEY AS SKUKEY
				     , #{STKNUM} AS STKNUM
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA07 AS LOTA07
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.EANCOD AS EANCOD
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY
				     , TI.STATIT AS STATIT    		
				     , TI.SHPOKY AS SHPOKY		     
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
		           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		           AND SM.MTYPE LIKE #{SES_MTYPE}               
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN('NEW', 'PPC', 'FPC')
				<if test="STKNUM != null and STKNUM != ''">   	  
				   AND (TI.STKNUM = #{STKNUM})
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})	
				</if>
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				<if test="TASKKY != null and TASKKY != ''">
					AND TH.TASKKY = #{TASKKY}
				</if>
			 	ORDER BY  LM.LOCAKY, TI.SKUKEY DESC
	</select>
			 	
	<select id="PDPK05DETAILCNT_MAP" parameterType="Map" resultType="DataMap">
        SELECT COUNT(*) CNT
        	 , SUM(CASE WHEN B.QTSHPO = B.QTJCMP THEN 1 ELSE 0 END) AS COMPCNT2
        FROM (	 
	        SELECT 	  
        		A.SKUKEY
				, A.DESC01
				, SUM(A.QTSHPO) AS QTSHPO
				, SUM(A.QTJCMP) AS QTJCMP
				, A.DUOMKY
				, SUM(A.QTYORG) AS QTYORG
				, A.UOMKEY
				, A.STKNUM
			FROM(
				SELECT    SI.SKUKEY
						, SM.DESC01
						, SI.QTSHPO
						, SI.QTJCMP
						, SI.DUOMKY
						, NVL(SI.QTYORG,0) AS QTYORG
						, SI.UOMKEY
						, SI.STATIT
						, NVL(TRIM(SI.STKNUM), SI.SVBELN) AS STKNUM 
						, SI.SVBELN 
				FROM SHPDH SH
				INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
				INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY
				WHERE SH.WAREKY = #{WAREKY}
				AND SI.STATIT IN ('NEW', 'FAL', 'PAL', 'PPC', 'FPC')
				AND SI.STKNUM = #{STKNUM}
				<if test="DPTNKY != null and DPTNKY != ''">
					AND SH.DPTNKY = #{DPTNKY}
				</if>
				) A
				GROUP BY  A.SKUKEY
						, A.DESC01
						, A.DUOMKY
						, A.UOMKEY
						, A.STKNUM 
				ORDER BY A.SKUKEY
	      ) B   
	</select>
	
	<select id="PDPK05DETAIL02HEAD_MAP" parameterType="Map" resultType="DataMap">
			SELECT 	  A.SKUKEY
					, A.DESC01
					, SUM(A.QTSHPO) AS QTSHPO
					, SUM(A.QTJCMP) AS QTJCMP
					, A.DUOMKY
					, SUM(A.QTYORG) AS QTYORG
					, A.UOMKEY
					, A.BUOMKY AS BUOMKY
		     		, NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, A.SKUKEY, SUM(A.QTSHPO), A.DUOMKY, 'BOX')), '0') AS BQTSHPO
		     		, NVL(TRIM(SZF_GET_CONVERT_QTY(A.WAREKY, A.SKUKEY, SUM(A.QTJCMP), A.DUOMKY, 'BOX')), '0') AS BQTJCMP					
					, A.STKNUM
					, MAX(A.BUOMKEY) AS BUOMKEY 
					, MAX(NVL(A.QTPUOM, 0)) AS QTPUOM
					, NVL(MAX(A.LOTA01), ' ') AS LOTA01
					, NVL(MAX(A.LOTA02), ' ') AS LOTA02
					, NVL(MAX(A.LOTA07), ' ') AS LOTA07
					, A.MTYPE 
					, CASE 
						WHEN MIPBOX.QTPUOM = 0 THEN 0 
						ELSE NVL((MIPPAL.QTPUOM / MIPBOX.QTPUOM),'0') 
					  END AS BOXPAL 
			FROM(
					SELECT    SH.WAREKY
							, SI.SKUKEY
							, SM.DESC01
							, SI.QTSHPO
							, SI.QTJCMP
							, SI.DUOMKY
							, NVL(SI.QTYORG,0) AS QTYORG
							, SI.UOMKEY
							, MS.UOMKEY AS BUOMKY
							, SI.STATIT
							, NVL(TRIM(SI.STKNUM), SI.SVBELN) AS STKNUM
							, MS.UOMKEY AS BUOMKEY
                            , MS.QTPUOM AS QTPUOM
                            , SI.LOTA01
                            , SI.LOTA02
                            , SI.LOTA07
                            , SM.MTYPE
                            , SI.SVBELN
					FROM SHPDH SH
					INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
					INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY 
					LEFT JOIN MEASI MS ON MS.WAREKY = SH.WAREKY AND MS.MEASKY = SI.SKUKEY AND MS.UOMKEY = 'BOX'			 
					WHERE SH.WAREKY = #{WAREKY}
					AND SI.STATIT IN ('NEW', 'FAL', 'PAL', 'PPC', 'FPC')
					AND SI.STKNUM = #{STKNUM}
					AND SI.LOTA07 = NVL(#{LOTA07}, ' ')
					<if test="SKUKEY != null and SKUKEY != ''">
					   AND SI.SKUKEY = #{SKUKEY}
					</if>
					<if test="DPTNKY != null and DPTNKY != ''">
						AND SH.DPTNKY = #{DPTNKY}
					</if> 
			) A 
			LEFT JOIN MEASI MIPBOX ON (A.SKUKEY = MIPBOX.MEASKY AND MIPBOX.UOMKEY = 'BOX' AND MIPBOX.WAREKY = '1100'  ) 
			LEFT JOIN MEASI MIPPAL ON (A.SKUKEY = MIPPAL.MEASKY AND MIPPAL.UOMKEY = 'PAL' AND MIPPAL.WAREKY = '1100'  ) 
				GROUP BY  A.SKUKEY
						, A.DESC01
						, A.DUOMKY
						, A.UOMKEY
						, A.STKNUM
						, A.WAREKY
						, A.BUOMKY
						, A.MTYPE
						, CASE 
							WHEN MIPBOX.QTPUOM = 0 THEN 0 
							ELSE NVL((MIPPAL.QTPUOM / MIPBOX.QTPUOM),'0') 
						END 
		
	</select>
	
	<select id="PDPK05DETAIL02CNT_LIST" parameterType="Map" resultType="DataMap">
	  SELECT          SUM(NVL(QTTAOR,0)) AS QTCOMP_L7141
		            , SUM(NVL(QTCOMP,0)) AS QTCOMP_L7141_2
		            , MAX(SKUKEY) AS SKUKEY
		            , MAX(DESC01) AS DESC01
		            , MAX(UOMKEY) AS UOMKEY2
		            , MAX(UOMKEY) AS UOMKEY3
		            , MAX(LOCASR) AS LOCASR            
    	FROM (
     
				 SELECT TH.TASKKY AS TASKKY
					     , TI.TASKIT AS TASKIT
					     , LM.LOCAKY AS LOCASR
					     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),' ') AS STATIT
					     , TI.SKUKEY AS SKUKEY
					     , SM.DESC01 AS DESC01
					     , SM.EANCOD AS EANCOD
					     , SM.GTINCD AS GTINCD
					     , TI.QTTAOR AS QTTAOR
					     , TI.QTCOMP AS QTCOMP
					     , SM.DUOMKY AS UOMKEY		   
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
				   AND SM.MTYPE LIKE #{SES_MTYPE}               
				   AND TH.TASOTY = '330'
				   AND TI.STATIT IN('NEW', 'PPC', 'FPC', 'FIN')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM})
				</if>   
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="SHPOKY != null and SHPOKY != ''">
				   AND TI.SHPOKY = #{SHPOKY}
				</if>   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})
				</if>				
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			)				
	</select>
	
	<select id="PDPK05_DETAIL02_LIST" parameterType="Map" resultType="DataMap">
		 SELECT   LOCAKY	        
		        , SKUKEY 		        
		        , QTCOMP    		       
		        , LOTA01 
		        , LOTA02 
		        , MAX(LOTA07) AS LOTA07			        
		        , LOTA11	
		        , LOTA14	
		        , DUOMKY 
		        , SUM(QTJCMPBOX) AS QTJCMPBOX --피킹수량BOX       
		FROM            
	        (
	        	<choose>
	        		<when test="STKNUM != null and STKNUM != ''">
	        			SELECT
					       LM.LOCAKY AS LOCAKY		         
					     , TI.SKUKEY AS SKUKEY
			             , SM.DESC01 AS DESC01
					     , SUM(NVL(TI.QTTAOR,0)) OVER (PARTITION BY  LM.LOCAKY, TI.SKUKEY, TI.LOTA14) AS QTTAOR
	            		 , SUM(NVL(TI.QTCOMP ,0)) OVER (PARTITION BY  LM.LOCAKY, TI.SKUKEY, TI.LOTA14) AS QTCOMP
	            		 , SUM(NVL(TI.QTCOMP ,0)) OVER (PARTITION BY  LM.LOCAKY, TI.SKUKEY, TI.LOTA14) AS DQTCOMP		     
					     , TI.LOTA01 AS LOTA01
			             , TI.LOTA02 AS LOTA02
			             , TI.LOTA03 AS LOTA03
			             , TI.LOTA07 AS LOTA07
			             , TI.LOTA09 AS LOTA09
			             , TI.LOTA11 AS LOTA11
			             , TI.LOTA12 AS LOTA12
			             , TI.LOTA13 AS LOTA13
			             , TI.LOTA14 AS LOTA14		             		    
			             , SM.GTINCD AS GTINCD
					     , '' AS PACKID
					     , '' AS TRNUID
					     , #{STKNUM} AS STKNUM
					     , #{WAREKY} AS WAREKY
					     , #{DPTNKY} AS DPTNKY				     
					     , #{BARCOD} AS BARCOD
					     , SI.UOMKEY AS UOMKEY
	                     , SI.DUOMKY AS DUOMKY                     
	                     , NVL(TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, TI.QTTAOR, SI.DUOMKY, SI.UOMKEY)),'0') AS QTYORG		
					     , SZF_GET_ORDER_ALSTKY_LASTOB(SH.WAREKY, SH.OWNRKY, SH.KVGR1, SH.DPTNKY, ' ', ' ', SH.DOCUTY, ' ', SI.ALSTKY) AS LASTOB
					     , TRIM(SM.SKUG05) || TRIM(SM.SKUL01) AS ALOTPCK
					     , ( SELECT USARG1 FROM CMCDV CM
			                         WHERE CMCDKY = 'ALOTPCK'
			                         AND TRIM(SM.SKUG05) || TRIM(SM.SKUL01) = CM.CMCDVL
			               )AS ALOTPCK_YN		
			             , 0 AS CHKQTCOMP   
			             , NVL(TRIM(TI.ASKU01), ' ') ASKU01 
			             , SI.SVBELN 
			             , CASE WHEN TI.QTTAOR = 0 OR SI.DUOMKY != 'BAG' THEN 0 
					           ELSE TI.QTTAOR/ NVL((TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, TI.SKUKEY, TI.QTTAOR, SI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, TI.SKUKEY, TI.QTTAOR, SI.UOMKEY, 'BOX'))),'0') END AS QTJCMPBOX --피킹수량		
					  FROM TASDH TH
					       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
					       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
					       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
					       INNER JOIN SHPDH SH ON SH.SHPOKY = TI.SHPOKY
	                       INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY AND SI.SHPOKY = TI.SHPOKY AND SI.SHPOIT = TI.SHPOIT AND SI.SKUKEY = TI.SKUKEY                
					 WHERE 1 = 1
					   AND TH.WAREKY = #{WAREKY}
					   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
					   AND SM.MTYPE LIKE #{SES_MTYPE}              
					   AND TH.TASOTY = '330'
					   AND TI.STATIT IN('PPC', 'FPC') AND TI.TASKTY IN ('PK')	
					   AND TI.LOTA07= NVL(TRIM(#{LOTA07}), ' ')
					   AND TI.STKNUM = #{STKNUM}
						<if test="DPTNKY != null and DPTNKY != ''">
						   AND TH.PTNRKY = #{DPTNKY}
						</if>				    
						<if test="LOCAKY != null and LOCAKY != ''">
						   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
						   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})
						</if>
						<if test="BARCOD != null and BARCOD != ''">
						   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
						</if>
						<if test="SKUKEY != null and SKUKEY != ''">
						   AND TI.SKUKEY= #{SKUKEY}
						</if>
	        		</when>
	        		<otherwise>
	        			SELECT
					       LM.LOCAKY AS LOCAKY		         
					     , TI.SKUKEY AS SKUKEY
			             , SM.DESC01 AS DESC01
					     , SUM(NVL(TI.QTTAOR,0)) OVER (PARTITION BY  LM.LOCAKY, TI.SKUKEY, TI.LOTA14) AS QTTAOR
	            		 , SUM(NVL(TI.QTCOMP ,0)) OVER (PARTITION BY  LM.LOCAKY, TI.SKUKEY, TI.LOTA14) AS QTCOMP
	            		 , SUM(NVL(TI.QTCOMP ,0)) OVER (PARTITION BY  LM.LOCAKY, TI.SKUKEY, TI.LOTA14) AS DQTCOMP		     
					     , TI.LOTA01 AS LOTA01
			             , TI.LOTA02 AS LOTA02
			             , TI.LOTA03 AS LOTA03
			             , TI.LOTA07 AS LOTA07
			             , TI.LOTA09 AS LOTA09
			             , TI.LOTA11 AS LOTA11
			             , TI.LOTA12 AS LOTA12
			             , TI.LOTA13 AS LOTA13
			             , TI.LOTA14 AS LOTA14		             		    
			             , SM.GTINCD AS GTINCD
					     , '' AS PACKID
					     , '' AS TRNUID
					     , #{STKNUM} AS STKNUM
					     , #{WAREKY} AS WAREKY
					     , #{DPTNKY} AS DPTNKY				     
					     , #{BARCOD} AS BARCOD
					     , SI.UOMKEY AS UOMKEY
	                     , SI.DUOMKY AS DUOMKY                     
	                     , NVL(TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, TI.QTTAOR, SI.DUOMKY, SI.UOMKEY)),'0') AS QTYORG		
					     , SZF_GET_ORDER_ALSTKY_LASTOB(SH.WAREKY, SH.OWNRKY, SH.KVGR1, SH.DPTNKY, ' ', ' ', SH.DOCUTY, ' ', SI.ALSTKY) AS LASTOB
					     , TRIM(SM.SKUG05) || TRIM(SM.SKUL01) AS ALOTPCK
					     , ( SELECT USARG1 FROM CMCDV CM
			                         WHERE CMCDKY = 'ALOTPCK'
			                         AND TRIM(SM.SKUG05) || TRIM(SM.SKUL01) = CM.CMCDVL
			               )AS ALOTPCK_YN		
			             , 0 AS CHKQTCOMP   
			             , NVL(TRIM(TI.ASKU01), ' ') ASKU01    
			             , CASE WHEN SI.QTJCMP = 0 OR SI.DUOMKY != 'BAG' THEN 0 
					           ELSE SI.QTJCMP/ NVL((TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTJCMP, SI.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, SI.QTJCMP, SI.UOMKEY, 'BOX'))),'0') END AS QTJCMPBOX --피킹수량		
					  FROM TASDH TH
					       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
					       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
					       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
					       INNER JOIN SHPDH SH ON SH.SHPOKY = TI.SHPOKY
	                       INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY AND SI.SHPOKY = TI.SHPOKY AND SI.SHPOIT = TI.SHPOIT AND SI.SKUKEY = TI.SKUKEY                    
					 WHERE 1 = 1
					   AND TH.WAREKY = #{WAREKY}
					   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
					   AND SM.MTYPE LIKE #{SES_MTYPE}              
					   AND TH.TASOTY = '330'
					   AND TI.STATIT IN('PPC', 'FPC') AND TI.TASKTY IN ('PK')
					   AND TI.LOTA07= NVL(TRIM(#{LOTA07}), ' ')
						<if test="DPTNKY != null and DPTNKY != ''">
						   AND TH.PTNRKY = #{DPTNKY}
						</if>				    
						<if test="LOCAKY != null and LOCAKY != ''">
						   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
						   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})
						</if>
						<if test="BARCOD != null and BARCOD != ''">
						   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
						</if>
						<if test="SKUKEY != null and SKUKEY != ''">
						   AND TI.SKUKEY= #{SKUKEY}
						</if>
	        		</otherwise>
	        	</choose>
			)  GROUP BY   LOCAKY 		            
				        , SKUKEY   
				        , QTCOMP    
				        , LOTA01 
				        , LOTA02 
				        , LOTA11
				        , LOTA14
				        , DUOMKY	
				        , QTTAOR
			ORDER BY CASE WHEN QTTAOR = 0 THEN 1 ELSE 0 END, LOTA14 ASC      
				         	
	</select>
		
	<select id="PDPK05_DETAIL02_SUB_LIST" parameterType="Map" resultType="DataMap">

				SELECT TH.TASKKY
					 , TI.TASKIT
					 , TI.SHPOKY
					 , TI.SHPOIT
				     , NVL(TRIM(TI.ASKU01), TI.LOCASR) AS LOCASR
				     , TI.LOCASR AS LOCAKY
				     , TI.ASKU01
				     , TI.SKUKEY AS SKUKEY
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY 
				     , TI.STATIT				      
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				   AND SM.MTYPE LIKE #{SES_MTYPE} 
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN ('NEW', 'FPC', 'PPC', 'FIN') 
				   AND TI.TASKTY IN ('PK')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM})
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})
				</if>
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				   AND TI.LOTA07= NVL(#{LOTA07}, ' ')
				   
			 	ORDER BY TI.LOTA14 ASC
			
	</select>
	
	<select id="PDPK05_DETAIL02_TASKINFO_LIST" parameterType="Map" resultType="DataMap">
 		SELECT  TASKKY, TASKIT, QTTAOR
 		  FROM(
				SELECT TH.TASKKY
					 , TI.TASKIT
					 , TI.SHPOKY
					 , TI.SHPOIT
				     , LM.LOCAKY AS LOCASR
				     , TI.SKUKEY AS SKUKEY
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY 
				     , TI.STATIT				      
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				   AND SM.MTYPE LIKE #{SES_MTYPE} 
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN ('NEW', 'FPC', 'PPC') 
				   AND TI.TASKTY IN ('PK')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM})
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})	
				</if>
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			 	ORDER BY TI.LOTA14 ASC
			) GROUP BY TASKKY, TASKIT, QTTAOR			
	</select>
	
	<select id="PDPK05_DETAIL02_TASKKY_LIST" parameterType="Map" resultType="DataMap">
 		SELECT  TASKKY
 		  FROM(
				SELECT TH.TASKKY
					 , TI.TASKIT
					 , TI.SHPOKY
					 , TI.SHPOIT
				     , LM.LOCAKY AS LOCASR
				     , TI.SKUKEY AS SKUKEY
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY 
				     , TI.STATIT				      
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				   AND SM.MTYPE LIKE #{SES_MTYPE} 
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN ('NEW', 'FPC', 'PPC') 
				   AND TI.TASKTY IN ('PK')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM})
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})	
				</if>
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			 	ORDER BY TI.LOTA14 ASC
			) GROUP BY TASKKY	
	</select>
	
	<select id="PDPK05_SAVE_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY AS WAREKY,
		       B.TASKKY AS TASKKY,
		       B.TASKIT AS TASKIT,
		       B.TASKTY AS TASKTY,
		       B.RSNCOD AS RSNCOD,
		       B.TASRSN AS TASRSN,
		       B.STATIT AS STATIT,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = B.STATIT) AS STATITNM,
		       B.QTTAOR AS QTTAOR,
		       B.QTCOMP AS QTCOMP,
		       B.OWNRKY AS OWNRKY,
		       B.SKUKEY AS SKUKEY,
		       B.LOTNUM AS LOTNUM,
		       B.ACTCDT AS ACTCDT,
		       B.ACTCTI AS ACTCTI,
		       B.QTYUOM AS QTYUOM,
		       B.TKFLKY AS TKFLKY,
		       B.STEPNO AS STEPNO,
		       B.LSTTFL AS LSTTFL,
		       B.LOCASR AS LOCASR,
		       B.SECTSR AS SECTSR,
		       B.PAIDSR AS PAIDSR,
		       B.TRNUSR AS TRNUSR,
		       B.STRUTY AS STRUTY,
		       B.SMEAKY AS SMEAKY,
		       B.SUOMKY AS SUOMKY,
		       B.QTSPUM AS QTSPUM,
		       B.SDUOKY AS SDUOKY,
		       B.QTSDUM AS QTSDUM,
		       B.LOCATG AS LOCATG,
		       B.SECTTG AS SECTTG,
		       B.PAIDTG AS PAIDTG,
		       B.TRNUTG AS TRNUTG,
		       B.TTRUTY AS TTRUTY,
		       B.TMEAKY AS TMEAKY,
		       B.TUOMKY AS TUOMKY,
		       B.QTTPUM AS QTTPUM,
		       B.TDUOKY AS TDUOKY,
		       B.QTTDUM AS QTTDUM,
		       B.LOCATG AS LOCAAC,
		       B.SECTTG AS SECTAC,
		       B.PAIDTG AS PAIDAC,
		       B.TRNUTG AS TRNUAC,
		       B.TTRUTY AS ATRUTY,
		       B.TMEAKY AS AMEAKY,
		       B.TUOMKY AS AUOMKY,
		       B.QTTPUM AS QTAPUM,
		       B.TDUOKY AS ADUOKY,
		       B.QTTDUM AS QTADUM,
		       B.REFDKY AS REFDKY,
		       B.REFDIT AS REFDIT,
		       B.REFCAT AS REFCAT,
		       B.REFDAT AS REFDAT,
		       B.PURCKY AS PURCKY,
		       B.PURCIT AS PURCIT,
		       B.ASNDKY AS ASNDKY,
		       B.ASNDIT AS ASNDIT,
		       B.RECVKY AS RECVKY,
		       B.RECVIT AS RECVIT,
		       B.SHPOKY AS SHPOKY,
		       B.SHPOIT AS SHPOIT,
		       B.GRPOKY AS GRPOKY,
		       B.GRPOIT AS GRPOIT,
		       B.SADJKY AS SADJKY,
		       B.SADJIT AS SADJIT,
		       B.SDIFKY AS SDIFKY,
		       B.SDIFIT AS SDIFIT,
		       B.PHYIKY AS PHYIKY,
		       B.PHYIIT AS PHYIIT,
		       B.DROPID AS DROPID,
		       B.DESC01 AS DESC01,
		       B.DESC02 AS DESC02,
		       B.ASKU01 AS ASKU01,
		       B.ASKU02 AS ASKU02,
		       B.ASKU03 AS ASKU03,
		       B.ASKU04 AS ASKU04,
		       B.ASKU05 AS ASKU05,
		       B.EANCOD AS EANCOD,
		       B.GTINCD AS GTINCD,
		       B.SKUG01 AS SKUG01,
		       B.SKUG02 AS SKUG02,
		       B.SKUG03 AS SKUG03,
		       B.SKUG04 AS SKUG04,
		       B.SKUG05 AS SKUG05,
		       B.GRSWGT AS GRSWGT,
		       B.NETWGT AS NETWGT,
		       B.WGTUNT AS WGTUNT,
		       B.LENGTH AS LENGTH,
		       B.WIDTHW AS WIDTHW,
		       B.HEIGHT AS HEIGHT,
		       B.CUBICM AS CUBICM,
		       B.CAPACT AS CAPACT,
		       B.WORKID AS WORKID,
		       B.WORKNM AS WORKNM,
		       B.HHTTID AS HHTTID,
		       B.AREAKY AS AREAKY,
		       B.LOTA01 AS LOTA01,
		       B.LOTA02 AS LOTA02,
		       B.LOTA03 AS LOTA03,
		       B.LOTA04 AS LOTA04,
		       B.LOTA05 AS LOTA05,
		       B.LOTA06 AS LOTA06,
		       B.LOTA07 AS LOTA07,
		       B.LOTA08 AS LOTA08,
		       B.LOTA09 AS LOTA09,
		       B.LOTA10 AS LOTA10,
		       B.LOTA11 AS LOTA11,
		       B.LOTA12 AS LOTA12,
		       B.LOTA13 AS LOTA13,
		       B.LOTA14 AS LOTA14,
		       B.LOTA15 AS LOTA15,
		       B.LOTA16 AS LOTA16,
		       B.LOTA17 AS LOTA17,
		       B.LOTA18 AS LOTA18,
		       B.LOTA19 AS LOTA19,
		       B.LOTA20 AS LOTA20,
		       B.AWMSNO AS AWMSNO,
		       B.AWMSTS AS AWMSTS,
		       B.SMANDT AS SMANDT,
		       B.SEBELN AS SEBELN,
		       B.SEBELP AS SEBELP,
		       B.SZMBLNO AS SZMBLNO,
		       B.SZMIPNO AS SZMIPNO,
		       B.STRAID AS STRAID,
		       B.SVBELN AS SVBELN,
		       B.SPOSNR AS SPOSNR,
		       B.STKNUM AS STKNUM,
		       B.STPNUM AS STPNUM,
		       B.SWERKS AS SWERKS,
		       B.SLGORT AS SLGORT,
		       B.SDATBG AS SDATBG,
		       B.STDLNR AS STDLNR,
		       B.SSORNU AS SSORNU,
		       B.SSORIT AS SSORIT,
		       B.SMBLNR AS SMBLNR,
		       B.SZEILE AS SZEILE,
		       B.SMJAHR AS SMJAHR,
		       B.SXBLNR AS SXBLNR,
		       B.SAPSTS AS SAPSTS,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       C.AUTLOC AS AUTLOC,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK,
		       C.LOCAKY AS LOCAKY
		  FROM TASDH A,
		       TASDI B,
		       LOCMA C
		 WHERE 1 = 1
		   AND A.TASKKY = B.TASKKY
           AND A.WAREKY = C.WAREKY
		   AND B.LOCASR = C.LOCAKY
		   AND A.WAREKY = #{WAREKY}
		   AND B.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
		   AND A.TASOTY = '330'	
		   AND B.STATIT IN ('NEW', 'FPC', 'PPC', 'FIN') 
		   AND B.TASKTY IN ('PK')
		<if test="STKNUM != null and STKNUM != ''">   
		   AND (B.STKNUM = #{STKNUM})
		</if>    
		<if test="DPTNKY != null and DPTNKY != ''">
		   AND A.PTNRKY = #{DPTNKY}
		</if>				   
		<if test="LOCAKY != null and LOCAKY != ''">
		   AND (B.LOCASR = #{LOCAKY} OR B.ASKU01 = #{LOCAKY} )		   
		   AND #{LOCAKY} = NVL(TRIM(B.ASKU01), #{LOCAKY})	
		</if>
		<if test="SKUKEY != null and SKUKEY != ''">
		   AND B.SKUKEY= #{SKUKEY}
		</if>
		<if test="TASKKY != null and TASKKY != ''">
		   AND B.TASKKY= #{TASKKY}
		</if>
		<if test="TASKIT != null and TASKIT != ''">
		   AND B.TASKIT= #{TASKIT}
		</if>
		 ORDER BY B.TASKKY, B.TASKIT
	</select>
	
	<select id="PDPK05StockValidation_LIST" parameterType="Map" resultType="DataMap">
	
		SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
			 , TB.LOTNUM
			 , TB.SKUKEY
			 , TB.DESC01
			 , TB.UOMKEY
			 , SUM(TB.QTSIWH) AS QTSIWH
			 , SUM(TB.USEQTY) AS USEQTY
			 , SUM(TB.QTSCNU) AS QTSCNU
			 , SUM(TB.QTSIQT) AS QTSIQT
			 , SUM(TB.QTSWQT) AS QTSWQT
			 , SUM(TB.QTSHQT) AS QTSHQT
			 , SUM(TB.QTSALO) AS QTSALO
			 , SUM(TB.QTSPMO) AS QTSPMO
			 , SUM(TB.QTSPMI) AS QTSPMI
			 , SUM(TB.QTSBLK) AS QTSBLK
			 , SUM(TB.USEQTY) AS USEQTY   																			 /* 가용수량 */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'KG')), 0) AS TOT /* 총중량		  */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'BAG')), 0) AS BAG /* EA/BAG		*/
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'BOX')), 0) AS BOX /* BAG/BOX	   */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'PAL')), 0) AS PLT /* BOX/Pallet	*/
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'SOK')), 0) AS SOK /* 속(개/BALE)	*/
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'EA' )), 0) AS EA/* 매(sheet/속)   */
			 , TB.WAREKY
			 , (SELECT NAME01 FROM WAHMA WHERE WAREKY = TB.WAREKY) AS WARENM
			 , TB.LOTA01
			 , TB.LOTA02
			 , TB.LOTA03
             , TB.LOTA04
             , TB.LOTA05
             , TB.LOTA06
             , TB.LOTA07
             , TB.LOTA08
			 , TB.LOTA09
             , TB.LOTA10
			 , TB.LOTA11
			 , TB.LOTA12
			 , TB.LOTA13
			 , TB.LOTA14
			 , TB.LOTA15			 
             , TB.LOTA16
             , TB.LOTA17
             , TB.LOTA18
             , TB.LOTA19
             , TB.LOTA20             			
             , TB.LOCAKY
             , TB.OWNRKY
             , TB.PACKID
             , TB.TRNUID             
             <!-- , CASE WHEN (TB.LIMITQT &lt; = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) AND TB.LIMITQT &lt;&gt; 0  AND MOD(TB.LIMITQT + TB.INPUTQTY, TB.LIMITQT) = 0 ) AND  TB.INPUTQTY = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) THEN TB.LIMITQT
                    WHEN (TB.LIMITQT &gt; (SUM(TB.QTSALO) - MAX(TB.QTSPUT))  AND TB.LIMITQT &lt;&gt; 0 AND  TB.INPUTQTY = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) )  OR TB.INPUTQTY = 0 THEN (SUM(TB.QTSALO) - MAX(TB.QTSPUT))                    
                    WHEN  MOD(TB.LIMITQT + TB.INPUTQTY, TB.LIMITQT) &lt;&gt; 0  OR TB.LIMITQT = 0 THEN TB.INPUTQTY                    
               END AS  QTSPUT -->
             , CASE WHEN (TB.LIMITQT &lt; = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) AND TB.LIMITQT &lt;&gt; 0  AND MOD(TB.LIMITQT + TB.INPUTQTY, TB.LIMITQT) = 0 ) AND  TB.INPUTQTY = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) THEN TB.LIMITQT
                    <!-- WHEN (TB.LIMITQT &gt; (SUM(TB.QTSALO) - MAX(TB.QTSPUT))  AND TB.LIMITQT &lt;&gt; 0 AND  TB.INPUTQTY = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) )  THEN (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) -->                                        
                   <choose>
					<when test='SAMETYPE == "Y"'> 
						WHEN TB.INPUTQTY =0 AND TB.LIMITQT = 0 AND  TB.INPUTQTY  &lt;&gt;(SUM(TB.QTSALO) - MAX(TB.QTSPUT))   THEN (SUM(TB.QTSALO) - MAX(TB.QTSPUT))                   
					</when>
					<otherwise>
						WHEN (TB.INPUTQTY = 0 AND TB.LIMITQT = 0) OR TB.USEQTY &lt; TB.INPUTQTY THEN TB.USEQTY
					</otherwise> 	
					</choose>	                                       
                    WHEN  MOD(TB.LIMITQT + TB.INPUTQTY, TB.LIMITQT) &lt;&gt; 0  OR TB.LIMITQT = 0 THEN TB.INPUTQTY
               END AS  QTSPUT         
             , TB.ALOTPCK
			 , TB.ALOTPCK_YN  
			 , TB.AREAKY 
			 , (SELECT SUM (CASE WHEN S2.AREAKY = 'SHP' THEN 0
							ELSE S2.QTSIWH - S2.QTSBLK
										  - GREATEST(S2.QTSALO, S2.QTSPMO)
										  - (CASE WHEN S2.LOTA06 IN ('00') OR S2.QTSPMO > 0 THEN 0
												  ELSE S2.QTSIWH
											 END)
					   END ) FROM STKKY S2 WHERE 1=1
                       AND S2.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
                          AND S2.QTSIWH > 0                           
                          AND S2.SKUKEY = #{SKUKEY}
                          AND S2.LOCAKY = #{LOCAKY}                                                               
                          AND S2.LOTA14 = #{BARCOD}) AS USEQTY2
					                         
		  FROM (
				SELECT  
					  S.WAREKY							AS WAREKY
					 , M.SKUL01							AS SKUL01
					 , S.LOTNUM  					   
					 , S.SKUKEY							AS SKUKEY
					 , M.DESC01							AS DESC01
					 , S.UOMKEY							AS UOMKEY
					 , S.LOTA01
					 , S.LOTA02
					 , S.LOTA03
		             , S.LOTA04
		             , S.LOTA05
		             , S.LOTA06
		             , S.LOTA07
		             , S.LOTA08
					 , S.LOTA09
		             , S.LOTA10
					 , S.LOTA11
					 , S.LOTA12
					 , S.LOTA13
					 , S.LOTA14
					 , S.LOTA15			 
		             , S.LOTA16
		             , S.LOTA17
		             , S.LOTA18
		             , S.LOTA19
		             , S.LOTA20
					 , S.QTSIWH							AS QTSIWH
					 , S.QTSALO							AS QTSALO					 
					 , S.QTSPMI							AS QTSPMI
					 , S.QTSPMO							AS QTSPMO
					 , DECODE(S.LOTA06, '05', S.QTSIWH, 0) AS QTSIQT /* 품질 : Inspection QuanTity */
					 , DECODE(S.LOTA06, '10', S.QTSIWH, 0) AS QTSHQT /* 보류 : Hold	   QuanTity */
					 , DECODE(S.LOTA06, '30', S.QTSIWH, 0) AS QTSCNU /* 불용 : Can Not Use		 */
					 , DECODE(S.LOTA06, '50', S.QTSIWH, 0) AS QTSWQT /* 폐기 : Wasted	 QuanTity */
					 , CASE WHEN S.LOTA06 IN ('00', '05', '10', '30', '50') THEN 0
							ELSE S.QTSIWH
					   END								 AS QTSBLK
					 , CASE WHEN S.AREAKY = 'SHP' THEN S.QTSIWH
							ELSE 0
					   END								 AS QTSOUT
					 , CASE WHEN S.AREAKY = 'SHP' THEN 0
							ELSE S.QTSIWH - S.QTSBLK
										  - GREATEST(S.QTSALO, S.QTSPMO)
										  - (CASE WHEN S.LOTA06 IN ('00') OR S.QTSPMO > 0 THEN 0
												  ELSE S.QTSIWH
											 END)
					   END								 AS USEQTY
					 , S.AREAKY							AS AREAKY
					 , S.ZONEKY							AS ZONEKY
					 , S.LOCAKY							AS LOCAKY
					 , S.OWNRKY							AS OWNRKY
					 , S.TRNUID							AS TRNUID
					 , S.PACKID							AS PACKID
					 , NVL((SELECT DECODE(SUM(QTTAOR)  OVER (PARTITION BY  TASKKY, TASKIT),0,0,SUM(QTCOMP)  OVER (PARTITION BY  TASKKY, TASKIT)) FROM TASDI WHERE TASKKY=S.TASKKY AND TASKIT=S.TASKIT AND STATIT NOT IN('FCN')),0)  AS QTSPUT
                     , NVL(DECODE(S.SKUG05, '10', ZP.PALCNT, 0), 0) AS LIMITQT                     
                     , TO_NUMBER(NVL(TRIM(#{INPUTQTY}), 0)) AS INPUTQTY
                     , TRIM(M.SKUG05) || TRIM(M.SKUL01) AS ALOTPCK
		             , ( SELECT USARG1 FROM CMCDV CM
		                         WHERE CMCDKY = 'ALOTPCK'
		                         AND TRIM(M.SKUG05) || TRIM(M.SKUL01) = CM.CMCDVL
		               )AS ALOTPCK_YN 
				FROM STKKY S
					INNER JOIN SKUMA M ON M.OWNRKY = S.OWNRKY AND M.SKUKEY = S.SKUKEY	
					LEFT JOIN ZPPTM  ZP ON S.LOTA02 = ZP.LOTA02 AND S.LOTA03 = ZP.LOTA03 AND S.LOTA09 = ZP.LOTA09 AND S.LOTA16 = ZP.LOTA16 AND S.LOTA17 = ZP.LOTA17							
				WHERE 1=1
				  AND S.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				  AND M.MTYPE LIKE #{SES_MTYPE} 
				  AND S.QTSIWH &gt; 0
				  <if test="SKUKEY != null and SKUKEY != ''">
				  AND S.SKUKEY = #{SKUKEY}
				  </if>
				  <if test="LOTA01 != null and LOTA01 != ''">
				  AND S.LOTA01 = #{LOTA01}
				  </if>	
				  <if test="LOTA02 != null and LOTA02 != ''">
				  AND S.LOTA02 = #{LOTA02}
				  </if>		
				  <if test="LOTA07 != null and LOTA07 != ''">
				  AND S.LOTA07 = #{LOTA07}
				  </if>
				  <if test="LOTA09 != null and LOTA09 != ''">
				  AND S.LOTA09 = #{LOTA09}
				  </if>			  
				  <if test="LOCAKY != null and LOCAKY != ''">
				  AND S.LOCAKY = #{LOCAKY}
				  </if>			
				  <if test="BARCOD != null and BARCOD != ''">
				  AND S.LOTA14 = #{BARCOD}
				  </if>		
				  
				  <if test="LASTOB == &quot;V&quot;">
				  AND S.LOTA11 &gt;= #{LLOTA11}
				  </if>
				  				  		  			
				  <if test="SAMETYPE != null and SAMETYPE != ''">
					  <if test="STKNUM != null and STKNUM != ''">
					  AND S.QTSALO &gt; 0
					  AND S.QTSPMO &gt; 0
					  AND (S.STKNUM = #{STKNUM})
					  <!-- AND NVL(TRIM(S.TASKKY), ' ') = ' ' -->
					  </if>	
			  
				  </if>
				
			) TB
		WHERE 1=1
				<if test="SAMETYPE == null or SAMETYPE == ''">
				 AND TB.USEQTY &gt; 0
				</if>	
		GROUP BY TB.SKUL01
			   , TB.LOTNUM
			   , TB.SKUKEY
			   , TB.DESC01
			   , TB.UOMKEY
			   , TB.WAREKY
			   , TB.LOTA01
			   , TB.LOTA02
			   , TB.LOTA03
               , TB.LOTA04
               , TB.LOTA05
               , TB.LOTA06
               , TB.LOTA07
               , TB.LOTA08
			   , TB.LOTA09
               , TB.LOTA10
			   , TB.LOTA11
			   , TB.LOTA12
			   , TB.LOTA13
			   , TB.LOTA14
			   , TB.LOTA15			 
               , TB.LOTA16
               , TB.LOTA17
               , TB.LOTA18
               , TB.LOTA19
               , TB.LOTA20		 
		       , TB.LOCAKY
		       , TB.OWNRKY
		       , TB.TRNUID
		       , TB.PACKID
			   , TB.LIMITQT
			   , TB.INPUTQTY
			   , TB.ALOTPCK
			   , TB.ALOTPCK_YN
			   , TB.AREAKY
			   , TB.USEQTY
	</select>
	
	<select id="PDPK05_SHPDI_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY
					 , TI.TASKIT
					 , TI.SHPOKY
					 , TI.SHPOIT
				     , NVL(TRIM(TI.ASKU01), TI.LOCASR) AS LOCASR
				     , TI.SKUKEY AS SKUKEY
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY 
				     , TI.STATIT
				     , TH.WAREKY
				     , SI.ALSTKY		
				     , NVL(TRIM(#{STKNUM}), ' ') AS STKNUM		      
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN SHPDI SI ON SI.SHPOKY = TI.SHPOKY AND SI.SHPOIT = TI.SHPOIT
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				   AND SM.MTYPE LIKE #{SES_MTYPE} 
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN ('NEW', 'FPC', 'PPC', 'FIN') 
				   AND TI.TASKTY IN ('PK')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM})
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})
				</if>
				<if test="BARCOD != null and BARCOD != '' and ETCLOTA14 != &quot;Y&quot;">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			 	ORDER BY TI.LOTA14 ASC
	
	</select>
	
	<select id="PDPK05_COPY_SHPDI_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT 	  SH.WAREKY
				, SH.DPTNKY
				, SH.SHPMTY
				, CT.PTNRKY
				, CT.PTNRTY
				, CT.NAME01				
				, SI.SHPOKY
				, SI.SHPOIT
				, SI.STATIT
				, SI.SKUKEY
				, SI.QTYORG
				, SI.QTSHPO
				, SI.QTALOC
				, SI.QTJCMP
				, SI.QTSHPD
				, SI.QTSHPC
				, SI.QTYUOM
				, NVL((SI.QTSHPO - SI.QTALOC), 0) AS NEEDQTY
				, SI.SVBELN
				, SI.SPOSNR
				, SI.STKNUM
				, SI.STPNUM
				, SI.SSORNU
				, SI.SSORIT
				, SI.LOTA01
				, SI.LOTA02
				, SI.LOTA07
				, SI.SVBELN 
				, SM.SKUL01 -- 품목구분 (SN: 생리대, WT:물티슈, 그외)
				, NVL(SUBSTR(LISTAGG(DISTINCT(S.ZONEKY), ',' ON OVERFLOW TRUNCATE) WITHIN GROUP (ORDER BY S.LOTA11 ASC, S.SHPOKY DESC), 0, INSTR(LISTAGG(DISTINCT(S.ZONEKY), ',' ON OVERFLOW TRUNCATE) WITHIN GROUP (ORDER BY S.LOTA11 ASC, S.SHPOKY DESC), ',') - 1), ' ') ZONEKY
				, NVL(SUBSTR(LISTAGG(DISTINCT(S.AREAKY), ',' ON OVERFLOW TRUNCATE) WITHIN GROUP (ORDER BY S.LOTA11 ASC, S.SHPOKY DESC), 0, INSTR(LISTAGG(DISTINCT(S.AREAKY), ',' ON OVERFLOW TRUNCATE) WITHIN GROUP (ORDER BY S.LOTA11 ASC, S.SHPOKY DESC), ',') - 1), ' ') AREAKY
				, NVL(SUBSTR(LISTAGG(DISTINCT(S.LOCAKY), ',' ON OVERFLOW TRUNCATE) WITHIN GROUP (ORDER BY S.LOTA11 ASC, S.SHPOKY DESC), 0, INSTR(LISTAGG(DISTINCT(S.LOCAKY), ',' ON OVERFLOW TRUNCATE) WITHIN GROUP (ORDER BY S.LOTA11 ASC, S.SHPOKY DESC), ',') - 1), ' ') LOCAKY
				, NVL(MIN(S.LOTA11), ' ') LOTA11
				, NVL(SUBSTR(LISTAGG(DISTINCT(S.LOTA14), ',' ON OVERFLOW TRUNCATE) WITHIN GROUP (ORDER BY S.LOTA11 ASC, S.SHPOKY DESC), 0, INSTR(LISTAGG(DISTINCT(S.LOTA14), ',' ON OVERFLOW TRUNCATE) WITHIN GROUP (ORDER BY S.LOTA11 ASC, S.SHPOKY DESC), ',') - 1), ' ') LOTA14

			 FROM SHPDH SH 
			    INNER JOIN SHPDI SI ON SH.SHPOKY = SI.SHPOKY
			    INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY
			    LEFT OUTER JOIN BZPTN CT ON CT.PTNRKY = SH.DPTNKY AND CT.PTNRTY = 'CT' AND CT.OWNRKY = SH.OWNRKY 
			    LEFT JOIN STKKY S ON (S.WAREKY = SH.WAREKY AND S.SKUKEY = SI.SKUKEY AND S.QTSIWH > 0 AND S.LOTA06 = '00' AND S.AREAKY NOT IN('SYS', 'SHP')) 
		    WHERE 1 = 1 
		    	AND SI.STATIT IN ('NEW', 'FAL', 'PAL', 'PPC') 
		    	AND SH.WAREKY = #{WAREKY} 
		    	AND SI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
		    	AND SUBSTR(SI.SHPOIT,0,1) != 1
		    	AND SI.LOTA07= NVL(#{LOTA07}, ' ')
				 <if test="STKNUM != null and STKNUM != ''">   
				    AND SI.STKNUM = #{STKNUM}
				</if>
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND SH.DPTNKY = #{DPTNKY}
				</if>				   								
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND SI.SKUKEY= #{SKUKEY}
				</if>
			GROUP BY 
				  SH.WAREKY
				, SH.DPTNKY
				, SH.SHPMTY
				, CT.PTNRKY
				, CT.PTNRTY
				, CT.NAME01				
				, SI.SHPOKY
				, SI.SHPOIT
				, SI.STATIT
				, SI.SKUKEY
				, SI.QTYORG
				, SI.QTSHPO
				, SI.QTALOC
				, SI.QTJCMP
				, SI.QTSHPD
				, SI.QTSHPC
				, SI.QTYUOM
				, NVL((SI.QTSHPO - SI.QTALOC), 0) 
				, SI.SVBELN
				, SI.SPOSNR
				, SI.STKNUM
				, SI.STPNUM
				, SI.SSORNU
				, SI.SSORIT
				, SI.LOTA01
				, SI.LOTA02
				, SI.LOTA07
				, SM.SKUL01
			ORDER BY 
				SHPOKY DESC, SHPOIT ASC
	</select>
	
	
	<select id="PDPK05StockLota11Validation_LIST" parameterType="Map" resultType="DataMap">
	 SELECT
			    B.*,
			    CASE
			        WHEN RNGVOP = 'LS' THEN
			                CASE
			                    WHEN A.LOTA11 LIKE TO_CHAR(ADD_MONTHS(SYSDATE, - 12), 'YYYY')
			                                       || '%' THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        WHEN RNGVOP = 'TS' THEN
			                CASE
			                    WHEN A.LOTA11 LIKE TO_CHAR(SYSDATE, 'YYYY')
			                                       || '%' THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        WHEN RNGVOP = 'GT' THEN
			                CASE
			                    WHEN A.LOTA11 >= TO_CHAR(SYSDATE - RNGVMI, 'YYYYMMDD') THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        ELSE
			            'Y'
			    END AS CHECK_LOTA11
			FROM
			         STKKY A
			    INNER JOIN SHPDI SI ON SI.SHPOKY = A.SHPOKY
			                           AND SI.SHPOIT = A.SHPOIT
			    LEFT OUTER JOIN (
			        SELECT
			            RNGVOP,
			            NVL(RNGVMI, 0) AS RNGVMI
			        FROM
			            RLRRI
			        WHERE
			                WAREKY = #{WAREKY}
			            AND LOTRKY = #{ALSTKY}
			            AND DBFILD = 'LOTA11'
			    )     B ON 1 = 1
			WHERE
			        SI.STKNUM = #{STKNUM}
			    AND SI.SKUKEY = #{SKUKEY}
			    AND A.LOTA14 = #{LOTA14}
		        <if test="SHPOKY != null and SHPOKY != ''">	 
			    AND SI.SHPOKY = #{SHPOKY}
			    AND SI.SHPOIT = #{SHPOIT}
			    </if>
			    AND A.QTSIWH > 0
			    AND A.QTSALO > 0
			    AND A.QTSIWH = A.QTSALO
				
	</select>
	
	<select id="PDPK05StockEtcLota11Validation_LIST" parameterType="Map" resultType="DataMap">
	 SELECT
			    B.*,
			    CASE
			        WHEN RNGVOP = 'LS' THEN
			                CASE
			                    WHEN A.LOTA11 LIKE TO_CHAR(ADD_MONTHS(SYSDATE, - 12), 'YYYY')
			                                       || '%' THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        WHEN RNGVOP = 'TS' THEN
			                CASE
			                    WHEN A.LOTA11 LIKE TO_CHAR(SYSDATE, 'YYYY')
			                                       || '%' THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        WHEN RNGVOP = 'GT' THEN
			                CASE
			                    WHEN A.LOTA11 >= TO_CHAR(SYSDATE - RNGVMI, 'YYYYMMDD') THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        ELSE
			            'Y'
			    END AS CHECK_LOTA11
			FROM
			         STKKY A
			    LEFT OUTER JOIN (
			        SELECT
			            RNGVOP,
			            NVL(RNGVMI, 0) AS RNGVMI
			        FROM
			            RLRRI
			        WHERE
			                WAREKY = #{WAREKY}
			            AND LOTRKY = #{ALSTKY}
			            AND DBFILD = 'LOTA11'
			    )     B ON 1 = 1
			WHERE A.LOTA14 = #{BARCOD}		       				
	</select>
	
	<!-- ================================================================================================== -->
	<!-- PDPK05 지시번호별 피킹 : END-->
	<!-- ================================================================================================== -->
	
	
	<!-- ================================================================================================== -->
	<!-- PDLD21 지시번호별 피킹 : START-->
	<!-- ================================================================================================== -->
	<select id="STKNUM_ORDER_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT * FROM
		
		(	    
			SELECT CASE WHEN COUNT(*) = 0   THEN 'N'
			            WHEN COUNT(CASE WHEN KEEPIT = 'V' THEN 1 END) > 0 THEN 'OUT_M0195†' || SHPOKY 			
		            	WHEN STATDO NOT IN ('FPC', 'PPC') THEN 'MOBILE_M0048†' || SHPOKY || '/' || STATDONM
		            	WHEN SHPMTY IN ('205') THEN 'MOBILE_M0060†' || STKNUM
		           		ELSE 'Y'
		        	END MSGRESULT
	        	FROM (
	        	
                 SELECT   SH.SHPOKY
                        , SH.STATDO
                        , (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATDO' AND X.CMCDVL = SH.STATDO) AS STATDONM
                        , SI.STKNUM
                        , SI.KEEPIT
                        , SH.SHPMTY 
                   FROM SHPDH  SH 
                  INNER JOIN SHPDI  SI ON SH.SHPOKY = SI.SHPOKY 
                  WHERE SH.WAREKY = #{WAREKY}
		           	AND SH.OWNRKY = #{OWNRKY}  
		            AND SI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})  				   	
		           	AND SH.STATDO NOT IN('OCN') 		            	
		           	AND (SI.STKNUM = #{STKNUM} OR SI.STLNUM = #{STKNUM})
	           	)	            
    		GROUP BY SHPOKY, STATDO, STATDONM, STKNUM, SHPMTY ORDER BY MSGRESULT DESC 
   		) WHERE ROWNUM = 1
                  
		   
    </select>
	
	<select id="PDLD21_LIST" parameterType="Map" resultType="DataMap">    
	 SELECT    A.PTNRKY
                , A.PTNRNM
                , A.STKNUM
                , A.TASKKY                
                , CASE WHEN   A.TOTQTSHPC = A.TOTQTCOMP THEN 'FCK'
		                	   WHEN SUM(A.QTSHPC) = 0 THEN 'FPC'
		                       ELSE 'PCK' 
                  END AS STATIT
                , (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = 
                	(CASE WHEN A.TOTQTSHPC = A.TOTQTCOMP THEN 'FCK'
                    	  WHEN A.TOTQTSHPC =0 THEN 'FPC'
                		  ELSE 'PCK' 
                	END)) AS STATITNM
                , CASE WHEN A.TOTQTSHPC = A.TOTQTCOMP THEN 'V' 
                    ELSE ' '
                  END  AS FCKCOM
    	FROM (
                 SELECT   TH.PTNRKY, TH.PTNRNM, #{STKNUM} AS STKNUM		      	
                        , TH.TASKKY
                        , SUM(TI.QTCOMP) OVER (PARTITION BY   TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT) AS QTCOMP
                        , SUM(CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP ELSE 0 END) OVER (PARTITION BY   TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT)   AS QTSHPC
                        , SUM(TI.QTCOMP) OVER (PARTITION BY SI.SHPOKY) AS TOTQTCOMP
                        , SH.QTSHPC AS TOTQTSHPC
                        , TI.LSTTFL   
                 FROM TASDH  TH
                      INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY  AND TI.TASKTY IN ('PK')                       
                      INNER JOIN SHPDH  SH ON SH.SHPOKY = TI.SHPOKY
                      INNER JOIN SHPDI  SI ON SH.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT                     
                 WHERE TH.WAREKY = #{WAREKY}
		           	AND TI.OWNRKY = #{OWNRKY}  
		            AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})  
				   	AND TI.STATIT IN('FPC', 'PPC', 'PCK', 'FCK')          		     
		           	AND SH.STATDO IN('FPC', 'PPC', 'PCK', 'FCK') 
		           <if test="STKNUM != null and STKNUM != ''">	 
		           	AND (TI.STKNUM = #{STKNUM})
		           </if>
		           <if test="TASKKY != null and TASKKY != ''">
				    AND TH.TASKKY = #{TASKKY}
				   </if> 
			             
           ) A
           
          GROUP BY A.PTNRKY, A.PTNRNM, A.STKNUM, A.TASKKY, A.TOTQTSHPC, A.TOTQTCOMP        
    </select>
    
    <select id="PDLD21SUB_LIST" parameterType="Map" resultType="DataMap">    
		
		SELECT    TH.TASKKY                
                , TI.TASKIT
                , TI.SHPOKY
                , TI.SHPOIT
                , #{STKNUM} AS STKNUM      
        FROM TASDH  TH
              INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY                         
              INNER JOIN SHPDH  SH ON SH.SHPOKY = TI.SHPOKY
              INNER JOIN SHPDI  SI ON SH.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT                                                            
         WHERE TH.WAREKY = #{WAREKY}
           AND TI.OWNRKY = #{OWNRKY}       
		   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})            
		   AND TI.STATIT IN('FPC', 'PPC')  AND TI.TASKTY IN ('PK') 
		   AND SH.STATDO IN('FPC', 'PPC', 'FCK', 'PCK')      		     
           AND SI.STATIT IN('FPC', 'PPC', 'FCK', 'PCK')             
           AND TI.LSTTFL != 'V'
           <if test="STKNUM != null and STKNUM != ''">
		   AND (TI.STKNUM = #{STKNUM})
           </if>
           <if test="TASKKY != null and TASKKY != ''">
		    AND TH.TASKKY = #{TASKKY}
		   </if>  
		   <if test="LOTA14 != null and LOTA14 != ''">
			AND TI.LOTA14= #{LOTA14}
		   </if>                  		
    </select>
    
    <select id="PDLD21_COUNT_LIST" parameterType="Map" resultType="DataMap">
		 SELECT   COUNT(CASE WHEN STATIT = 'FCK' THEN 1 END) AS NOWCOMPCNT
			 	 ,COUNT(*) AS TOTCOMPCNT 
		  FROM 
			  (
			  	SELECT    A.PTNRKY
		                , A.PTNRNM
		                , A.STKNUM
		                , A.TASKKY                
		                , CASE WHEN SUM(A.QTCOMP) = SUM(A.QTSHPC) THEN 'FCK'
		                	   WHEN SUM(A.QTSHPC) = 0 THEN 'FPC'
		                       ELSE 'PCK' 
		                  END AS STATIT
		                , (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = 
		                	(CASE WHEN A.TOTQTSHPC = A.TOTQTCOMP THEN 'FCK'
		                    	  WHEN A.TOTQTSHPC =0 THEN 'FPC'
		                		  ELSE 'PCK' 
		                	END)) AS STATITNM
		                , ' ' AS FCKCOM
		    	FROM (
		                 SELECT   TH.PTNRKY, TH.PTNRNM, #{STKNUM} AS STKNUM		      	
		                        , TH.TASKKY
		                        , SUM(TI.QTCOMP) OVER (PARTITION BY   TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT) AS QTCOMP
		                        , SUM(CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP ELSE 0 END) OVER (PARTITION BY   TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT)   AS QTSHPC
                        		, SUM(TI.QTCOMP) OVER (PARTITION BY SI.SHPOKY) AS TOTQTCOMP
		                        , SH.QTSHPC TOTQTSHPC
		                        , TI.LSTTFL
		                 FROM TASDH  TH
		                      INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY   AND TI.TASKTY IN ('PK')                      
		                      INNER JOIN SHPDH  SH ON SH.SHPOKY = TI.SHPOKY
		                      INNER JOIN SHPDI  SI ON SH.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT                                                           		                                              
		                 WHERE TH.WAREKY = #{WAREKY}
					           AND TI.OWNRKY = #{OWNRKY}
	           				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 					                
							   AND TI.STATIT IN('FPC', 'PPC')          		     
					           AND SI.STATIT IN('FPC', 'PPC', 'FCK', 'PCK')  
					           <if test="STKNUM != null and STKNUM != ''">
		  					   AND (TI.STKNUM = #{STKNUM})
					           </if>
					           <if test="TASKKY != null and TASKKY != ''">
							    AND TH.TASKKY = #{TASKKY}
							   </if>
		           ) A
		           
		          GROUP BY A.PTNRKY, A.PTNRNM, A.STKNUM, A.TASKKY, A.TOTQTCOMP, A.TOTQTSHPC
			  )
	</select>
	
	<select id="PDLD21_DETAIL_LIST" parameterType="Map" resultType="DataMap">
     SELECT    CASE WHEN COUNT(*) = COUNT(CASE WHEN A.FCKCOM ='V' THEN 1 END) THEN 'V'
               		ELSE ' ' 
               END AS FCKCOM
             , A.SKUKEY   
             , SUM(A.QTCOMP) QTCOMP
             , A.DESC01 
             , SUM(A.QTSHPC) QTSHPC
             , A.UOMKEY
             , SUM(A.BOX) BOX
             , A.LOTA01 AS LOTA01
			 , A.LOTA02 AS LOTA02
			 , A.LOTA03 AS LOTA03			 
			 , A.LOTA09 AS LOTA09
			 , A.LOTA11 AS LOTA11
			 , A.LOTA12 AS LOTA12
			 , A.LOTA13 AS LOTA13
			 , A.LOTA14 AS LOTA14
			 , A.LOTA15 AS LOTA15
			 , A.STKNUM AS STKNUM            
             , A.SHPOKY AS SHPOKY             
             , A.SHPOIT AS SHPOIT  
             , A.TASKKY AS TASKKY
             , A.TASKIT AS TASKIT         	 		  				
            
          FROM   (

				SELECT 
		               TI.SKUKEY   
		             , TI.QTCOMP
		             , SZF_GET_SKU_DESC01_TEXT('KR', TI.OWNRKY, TI.SKUKEY) AS DESC01 
		             , CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP 
		                ELSE 0
		                END AS QTSHPC 
		             , TI.SUOMKY AS UOMKEY
		             , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTCOMP, TI.SUOMKY, 'BOX')),'0') AS BOX
		             , TI.LOTA01 AS LOTA01
					 , TI.LOTA02 AS LOTA02
					 , TI.LOTA03 AS LOTA03			 
					 , TI.LOTA09 AS LOTA09
					 , TI.LOTA11 AS LOTA11
					 , TI.LOTA12 AS LOTA12
					 , TI.LOTA13 AS LOTA13
					 , TI.LOTA14 AS LOTA14
					 , TI.LOTA15 AS LOTA15
					 , TI.SHPOKY AS SHPOKY	 		  					
		             , TI.SHPOIT AS SHPOIT
		             , TI.LSTTFL AS FCKCOM
		             , #{STKNUM} AS STKNUM	
		             , TI.TASKKY AS TASKKY
                     , TI.TASKIT AS TASKIT 		  					 
		        FROM SHPDH SH
		               INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
		               INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT AND TI.TASKTY IN ('PK')
		               INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY 
				WHERE 1 = 1
								
					AND TH.WAREKY = #{WAREKY}		
				    AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 						
	                AND TI.STATIT IN('PPC', 'FPC')
	               <if test="STKNUM != null and STKNUM != ''"> 
 					   AND (TI.STKNUM = #{STKNUM})
	               </if>           
   				   <if test="DPTNKY != null and DPTNKY != ''">
					AND TH.PTNRKY = #{DPTNKY}
				   </if>
				   <if test="TASKKY != null and TASKKY != ''">
					AND TH.TASKKY = #{TASKKY}
				   </if>
							   
                 ) A 
                 
                 	<if test="checkFck != null and checkFck != ''">
						WHERE A.FCKCOM ='V'
				    </if>
                        
        GROUP BY     A.SKUKEY, A.DESC01, A.UOMKEY, A.LOTA01, 
                     A.LOTA02, A.LOTA03, A.LOTA09, A.LOTA11, A.LOTA12, 
                     A.LOTA13, A.LOTA14, A.LOTA15, A.STKNUM, A.SHPOKY, A.SHPOIT, A.TASKKY, A.TASKIT   
	</select>
	
	<select id="PDLD21DETAILCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT        COUNT(*) AS CNT
		            , COUNT(CASE WHEN NVL(QTCOMP, 0) = NVL(QTSHPC, 0) THEN 1 END) AS COMPCNT2              
		            , NVL(SUM(NVL(QTCOMP,0)), 0) AS QTCOMP
		            , NVL(SUM(NVL(QTSHPC,0)), 0)AS QTSHPC
		            , NVL(MAX(UOMKEY), 'PAL') AS UOMKEY           
    	FROM (
     
			SELECT    CASE WHEN COUNT(*) = COUNT(CASE WHEN A.FCKCOM ='V' THEN 1 END) THEN 'V'
		               		ELSE ' ' 
		               END AS FCKCOM
		             , A.SKUKEY   
		             , SUM(A.QTCOMP) QTCOMP
		             , A.DESC01 
		             , SUM(A.QTSHPC) QTSHPC
		             , A.UOMKEY
		             , A.LOTA01 AS LOTA01
					 , A.LOTA02 AS LOTA02
					 , A.LOTA03 AS LOTA03			 
					 , A.LOTA09 AS LOTA09
					 , A.LOTA11 AS LOTA11
					 , A.LOTA12 AS LOTA12
					 , A.LOTA13 AS LOTA13
					 , A.LOTA14 AS LOTA14
					 , A.LOTA15 AS LOTA15
		             , A.STKNUM AS STKNUM
		             , A.TASKKY AS TASKKY	 		  					
            
          FROM   (

				SELECT 
		               TI.SKUKEY   
		             , TI.QTCOMP
		             , SZF_GET_SKU_DESC01_TEXT('KR', TI.OWNRKY, TI.SKUKEY) AS DESC01 
		             , CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP 
		                ELSE 0
		                END AS QTSHPC 
		             , TI.SUOMKY AS UOMKEY
		             , TI.LOTA01 AS LOTA01
					 , TI.LOTA02 AS LOTA02
					 , TI.LOTA03 AS LOTA03			 
					 , TI.LOTA09 AS LOTA09
					 , TI.LOTA11 AS LOTA11
					 , TI.LOTA12 AS LOTA12
					 , TI.LOTA13 AS LOTA13
					 , TI.LOTA14 AS LOTA14
					 , TI.LOTA15 AS LOTA15
					 , TI.SHPOKY AS SHPOKY	 		  					
		             , TI.SHPOIT AS SHPOIT
		             , TI.TASKKY AS TASKKY	 		  					
		             , TI.TASKIT AS TASKIT  
		             , TI.LSTTFL AS FCKCOM	
		             , #{STKNUM} AS STKNUM 		  					 
		        FROM SHPDH SH
		               INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
		               INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT AND TI.TASKTY IN ('PK')
		               INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY               
				WHERE 1 = 1
					
					AND TH.WAREKY = #{WAREKY}
				    AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})								
	                AND TI.STATIT IN('PPC', 'FPC')
	                <if test="STKNUM != null and STKNUM != ''">
 					    AND (TI.STKNUM = #{STKNUM})
	                </if>
   				    <if test="DPTNKY != null and DPTNKY != ''">
					AND TH.PTNRKY = #{DPTNKY}
				    </if>
				    <if test="TASKKY != null and TASKKY != ''">
					AND TH.TASKKY = #{TASKKY}
				    </if>
							   
                 ) A 
                        
	        GROUP BY     A.SKUKEY, A.DESC01, A.UOMKEY, A.LOTA01, 
	                     A.LOTA02, A.LOTA03, A.LOTA09, A.LOTA11, A.LOTA12, 
	                     A.LOTA13, A.LOTA14, A.LOTA15, A.STKNUM, A.TASKKY 	
			)		
	</select>
	
	<!-- PDLD21 검수 밸리데이션 -->
	<select id="PDLD21Validation1_MAP" parameterType="Map" resultType="DataMap">
		SELECT NVL(MAX(TI.SHPOKY), 'OK') AS MSG
		  FROM TASDH TH
                    INNER JOIN TASDI TI
		  	   		   ON TI.TASKKY = TH.TASKKY        
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TI.SHPOKY = #{SHPOKY}
		   AND TI.SHPOIT = #{SHPOIT}		
		   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})   
           AND TI.STATIT NOT IN ('FPC', 'PPC')
           AND TI.TASKTY IN ('PK')       
          AND (TI.QTTAOR &gt; TI.QTCOMP OR TI.QTTAOR = 0 OR TI.QTCOMP = 0)
	</select>
	
	
	<!-- 검수완료시 TASDI에 검수여부 업데이트-->
	<update id="PDLD21Sub_UPDATE" parameterType="Map">
		UPDATE TASDI
		   SET LSTTFL = #{LSTTFL}
			 , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		 WHERE SHPOKY = #{SHPOKY}
		   AND SHPOIT = #{SHPOIT}
		   AND TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}
		   AND STATIT IN ('FPC', 'PPC')
		   AND TASKTY IN ('PK')
		   
	</update>
	
	<!-- 검수수량 합산-->
	<select id="TOTAL_QTCOMP_MAP" parameterType="Map" resultType="DataMap">
		SELECT NVL(SUM(NVL(QTCOMP, 0)),0) AS QTCOMP
		FROM TASDI
		WHERE 1=1
		   AND LSTTFL = 'V'
		   AND STATIT IN('FPC', 'PPC')
		   AND TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}	
		   AND TASKTY IN ('PK')
		   AND LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})		   
	</select>
	
	<select id="PDLD21LISTValidation_LIST" parameterType="Map" resultType="DataMap">
     SELECT 
               CASE WHEN TI.LSTTFL = 'V' THEN 'Y'
                    ELSE 'N' END AS LOADYN
             , TI.SKUKEY   
             , TI.QTCOMP
             , SZF_GET_SKU_DESC01_TEXT(#{LANGKY}, TI.OWNRKY, TI.SKUKEY) AS DESC01 
             , CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP 
                ELSE 0
                END AS QTSHPC 
             , TI.SUOMKY AS UOMKEY
             , TI.LOTA01 AS LOTA01
			 , TI.LOTA02 AS LOTA02
			 , TI.LOTA03 AS LOTA03			 
			 , TI.LOTA09 AS LOTA09
			 , TI.LOTA11 AS LOTA11
			 , TI.LOTA12 AS LOTA12
			 , TI.LOTA13 AS LOTA13
			 , TI.LOTA14 AS LOTA14
			 , TI.LOTA15 AS LOTA15
             , TI.SHPOKY AS SHPOKY	 		  					
             , TI.SHPOIT AS SHPOIT
             , TI.TASKKY AS TASKKY	 		  					
             , TI.TASKIT AS TASKIT 
        FROM SHPDH SH
               INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
               INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT AND TI.TASKTY IN ('PK')
               INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY               

					WHERE 1 = 1
						AND TH.WAREKY = #{WAREKY}		
						AND TI.LSTTFL != 'V' 
						AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		                AND TI.STATIT IN('PPC', 'FPC')
		                AND TI.TASKTY IN ('PK')
		                <if test="STKNUM != null and STKNUM != ''">
		                AND (TI.STKNUM = #{STKNUM})               
		                </if>
    				   <if test="DPTNKY != null and DPTNKY != ''">
						AND TH.PTNRKY = #{DPTNKY}
					   </if>
					   <if test="BARCOD != null and BARCOD != ''">
						AND TI.LOTA14= #{BARCOD}
					   </if>					


		ORDER BY TI.LMODAT, TI.LMOTIM ASC			   
	</select>
	
	<update id="PDPK05_DETAIL_UPDATE" parameterType="Map">
		UPDATE TASDI
		SET QTCOMP = #{QTCOMP}	
		WHERE TASKKY = #{TASKKY}
			AND TASKIT = #{TASKIT}
	</update>
	
	
	<delete id="PDPK05_DETAIL_DELETE" parameterType="Map">
		DELETE TASDI		
		WHERE TASKKY = #{TASKKY}
			AND TASKIT = #{TASKIT}
	</delete>
	
	<!-- 저장위치 콤보 리스트 조회 -->
    <select id="LOTA01COMBO_LIST" parameterType="Map" resultType="DataMap">   
    	SELECT 
			  STLKY AS VALUE_COL
			, STLNM AS TEXT_COL			
		FROM STLMA
		WHERE 1=1 
			AND WAREKY = #{WAREKY}  
			AND OWNRKY = #{OWNRKY} 
			AND PLNTKY = #{PLNTKY}
			<choose>
				<when test='PLNTKY == "P100" and STLKY == "2400" and FIRSTSKUKEY == "S"'>
				AND STLKY = #{STLKY}
				ORDER BY DECODE(STLKY, '2400', 1) ASC, STLKY ASC
				</when>
				<otherwise>
				AND WMSMAK = #{WMSMAK}
				ORDER BY DECODE(STLKY, '3100', 1) ASC, STLKY ASC
				</otherwise>
			</choose>					
		
	</select>
	
	<select id="PDTK10_LIST" parameterType="Map" resultType="DataMap">
		WITH PDTK10 AS (
			SELECT T1.PROGID
			     , T1.DOCCAT 
			     , T1.DOCUTY 
			FROM DOCPG T1
			WHERE T1.PROGID=#{PROGID}
			  AND ROWNUM=1
		)
		SELECT ' ' AS SHPOKY
			 , #{WAREKY} AS WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM
			 , NVL(#{OWNRKY},' ') AS OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = NVL(#{OWNRKY},' ')),' ') AS OWNRNM
			 , TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT
			 , (SELECT X.DOCCAT FROM PDTK10 X) AS DOCCAT
			 , SZF_GET_DOCCAT_TEXT(#{LANGKY}, (SELECT X.DOCCAT FROM PDTK10 X)) AS DOCCATNM
			 , (SELECT X.DOCUTY FROM PDTK10 X) AS DOCUTY
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, (SELECT X.DOCUTY FROM PDTK10 X)) AS DOCUTYNM
			 , 'NEW' AS STATDO
			 ,(SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', 'NEW') FROM DUAL) AS STATDONM
			 , ' ' AS DOCTXT
			 , ' ' AS PTNRTY
			 , ' ' AS DPTNKY
		     , ' ' AS DPTNKYNM
		     , ' ' AS LOTA01
		     , ' ' AS LOTA01NM
		     , 'V' AS SAPIFYN
		     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS ASNDAT
		     , 'WMS_IF_320,WMS_IF_322' AS IFID
		FROM DUAL
	</select>
	
	<select id="PDTK10StockValidation_LIST" parameterType="Map" resultType="DataMap">  
	SELECT  
			A.LOCASR,
			A.AREAKY,
        	A.ZONEKY,
	        A.SKUKEY,
	        A.DESC01,
	        SUM(A.QTSIWH) AS QTSIWH,
	        A.UOMKEY,
	        A.LOTA01,
	        A.LOTA02,
	        A.LOTA14,
	        A.TOWAREKY,
	        A.LIMITQT,
	        CASE   WHEN A.LIMITQT &lt; = SUM(A.SHPQTY) AND A.LIMITQT &lt;&gt; 0 THEN A.LIMITQT
                   WHEN (A.LIMITQT &gt; SUM(A.SHPQTY)  AND A.LIMITQT &lt;&gt; 0 ) OR A.LIMITQT = 0 THEN SUM(A.SHPQTY)                                                           
            END AS  SHPQTY,
            NVL(TRIM(SUBSTR(A.SKUKEY, 0 , 1)), ' ') AS FIRSTSKUKEY,
            A.LOTA01 AS STLKY                 
	FROM (
	
			SELECT     B.STOKKY
			 	   	 , B.WAREKY	  		 
			  		 , B.AREAKY  
					 , B.ZONEKY  
					 , B.LOTNUM  
					 , B.LOCASR 
					 , B.LOCAKY 
					 , B.TRNUSR  
			  		 , B.LOCATG
			  		 , B.TRNUTG 
			  		 , B.LOCAAC
			  		 , B.TRNUAC	
			  		 , B.OWNRKY 
					 , B.SKUKEY 
			  		 , B.DESC01
			  		 , B.DESC02
			  		 , B.QTSIWH
			  		 , B.QTABLE
			  		 , B.SHPQTY
			  		 , B.QTSPUT
			  		 , B.QTSWQT
			  		 , B.UOMKEY
					 , B.SHPOKY
					 , B.SHPOIT
					 , B.DROPID
			  		 , B.LOTA01
					 , B.LOTA02
					 , B.LOTA03
					 , B.LOTA04
					 , B.LOTA05
					 , B.LOTA06
					 , B.LOTA06NM     
					 , B.LOTA07
					 , B.LOTA08
					 , B.LOTA09
					 , B.LOTA10
					 , B.LOTA11
					 , B.LOTA12
					 , B.LOTA13
					 , B.LOTA14
					 , B.LOTA15
					 , B.LOTA16
					 , B.LOTA17
					 , B.LOTA18
					 , B.LOTA19
					 , B.LOTA20
			  		 , B.RSNCOD
			  		 , B.RSNTXT
			  		 , B.SKUL01	
					 , B.TOT   
					 , B.BAG  
					 , B.BOX  
					 , B.PLT  
					 , B.SOK  
					 , B.EA	
					 , B.USEQTY  
					 , B.TOWAREKY
					 , B.LIMITQT
			 FROM(
			 
					WITH PDTK10 AS (
						SELECT T1.PROGID
						     , T1.DOCCAT 
						     , T1.DOCUTY 
						FROM DOCPG T1
						WHERE T1.DOCUTY = #{TASOTY}
						  AND ROWNUM=1
					)
					
					SELECT ST.STOKKY AS STOKKY
					     , ST.WAREKY AS WAREKY
					     , ST.AREAKY AS AREAKY
					     , ST.ZONEKY AS ZONEKY
					     , ST.LOTNUM AS LOTNUM
					     , ST.LOCAKY AS LOCASR
					     , ST.LOCAKY AS LOCAKY
					     , ST.TRNUID AS TRNUSR
					     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM PDTK10 X)),' ') AS LOCATG
					     , ' ' AS TRNUTG
					     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM PDTK10 X)),' ') AS LOCAAC
					     , ' ' AS TRNUAC
					     , ST.OWNRKY AS OWNRKY
					     , ST.SKUKEY AS SKUKEY
					     , SZF_GET_SKU_DESC01_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC01
					     , SZF_GET_SKU_DESC02_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC02
					     , ST.QTSIWH AS QTSIWH
					     , ((ST.QTSIWH) - GREATEST((ST.QTSALO),(ST.QTSPMO)) - (ST.QTSBLK)) AS QTABLE
					     , ST.QTSIWH AS SHPQTY
					     , ST.QTSIWH AS QTSPUT
					     , DECODE(ST.LOTA06, '50', ST.QTSIWH, 0) AS QTSWQT /* 폐기 : Wasted     QuanTity */
					     , SM.DUOMKY AS UOMKEY		     
					     , ST.SHPOKY AS SHPOKY
					     , ST.SHPOIT AS SHPOIT
					     , ' ' AS DROPID
					     , CASE WHEN ST.LOTA01 = '2400' AND ST.LOTA02 = 'P100' AND NVL(TRIM(SUBSTR(ST.SKUKEY, 0, 1)), ' ') = 'S' THEN '2400'
					            ELSE '3100' 
					       END  AS TOWAREKY
					     , ST.LOTA01 AS LOTA01
					     , ST.LOTA02 AS LOTA02
					     , ST.LOTA03 AS LOTA03
					     , ST.LOTA04 AS LOTA04
					     , ST.LOTA05 AS LOTA05
					     , ST.LOTA06
					     , (SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', ST.LOTA06) FROM DUAL) AS LOTA06NM
					     , ST.LOTA07 AS LOTA07
					     , ST.LOTA08 AS LOTA08
					     , ST.LOTA09 AS LOTA09
					     , ST.LOTA10 AS LOTA10
					     , ST.LOTA11 AS LOTA11
					     , ST.LOTA12 AS LOTA12
					     , ST.LOTA13 AS LOTA13
					     , ST.LOTA14 AS LOTA14
					     , ST.LOTA15 AS LOTA15
					     , ST.LOTA16 AS LOTA16
					     , ST.LOTA17 AS LOTA17
					     , ST.LOTA18 AS LOTA18
					     , ST.LOTA19 AS LOTA19
					     , ST.LOTA20 AS LOTA20	
					     , ' ' AS RSNCOD
					     , ' ' AS RSNTXT
					     , NVL((SELECT SKUL01 FROM SKUMA WHERE SKUKEY = ST.SKUKEY AND OWNRKY = #{OWNRKY}),' ') AS SKUL01			 
						 , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'KG')),'0') AS TOT
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BAG')),'0') AS BAG
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BOX')),'0') AS BOX
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'PAL')),'0') AS PLT
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'SOK')),'0') AS SOK
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'EA')),'0') AS EA
			             , CASE WHEN ST.AREAKY = 'SHP' THEN 0
							ELSE ST.QTSIWH - ST.QTSBLK
										  - GREATEST(ST.QTSALO, ST.QTSPMO)
										  - (CASE WHEN ST.LOTA06 IN ('00') OR ST.QTSPMO > 0 THEN 0
												  ELSE ST.QTSIWH
											 END)
					   		END AS USEQTY
					   	 , NVL((SELECT MEAS.QTPUOM FROM MEASI MEAS WHERE MEAS.MEASKY = ST.SKUKEY AND MEAS.WAREKY= #{WAREKY} AND MEAS.UOMKEY = 'PAL'), 0) AS LIMITQT   
					  FROM STKKY ST
					       INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY
					                          AND SM.SKUKEY = ST.SKUKEY
					 WHERE 1 = 1
					   AND ST.QTSIWH > 0
					   AND ST.QTSPMO = 0
					   AND ST.QTSBLK = 0
					   AND ST.AREAKY NOT IN ('SYS', 'SHP','CRT','RTS')
					   AND ST.LOCAKY NOT IN ('RTNLOC','SCRLOC')
					   AND ST.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
					   <if test="WAREKY != null and WAREKY != ''"> 
					   AND ST.WAREKY = #{WAREKY}
					   </if>
					   <if test="OWNRKY != null and OWNRKY != ''"> 
					   AND ST.OWNRKY = #{OWNRKY}
					   </if>					   
					   <if test="BARCOD != null and BARCOD != ''"> 
					   AND ST.LOTA14 = #{BARCOD}
					   </if>	
					) B 
		) A
            GROUP BY A.LOCASR,A.AREAKY, A.ZONEKY, A.SKUKEY, A.DESC01,  A.UOMKEY, A.LOTA01, A.LOTA02, A.LOTA14, A.TOWAREKY, A.LIMITQT
            ORDER BY A.LOCASR,A.AREAKY, A.ZONEKY
	</select>
	
	<select id="PDTK10_AVAILABLE_STOCK_LIST" parameterType="Map" resultType="DataMap">
	SELECT     ST.STOKKY  AS "STOKKY",
		       ST.WAREKY  AS "WAREKY",
		       ST.LOTNUM  AS "LOTNUM",
		       ST.LOCAKY  AS "LOCAKY",
		       ST.TRNUID  AS "TRNUID",
		       ST.SECTID  AS "SECTID",
		       ST.PACKID  AS "PACKID",
		       ST.QTSIWH  AS "QTSIWH",
		       ST.QTSALO  AS "QTSALO",
		       ST.QTSPMO  AS "QTSPMO",
		       ST.QTSPMI  AS "QTSPMI",
		       ST.QTSBLK  AS "QTSBLK",
		       ST.QTYUOM  AS "QTYUOM",
		       ST.TRUNTY  AS "TRUNTY",
		       ST.MEASKY  AS "MEASKY",
		       ST.UOMKEY  AS "UOMKEY",
		       ST.QTPUOM  AS "QTPUOM",
		       ST.DUOMKY  AS "DUOMKY",
		       ST.QTDUOM  AS "QTDUOM",
		       ST.TKFLKY  AS "TKFLKY",
		       ST.STEPNO  AS "STEPNO",
		       ST.LSTTFL  AS "LSTTFL",
		       ST.SRCSKY  AS "SRCSKY",
		       ST.UOMDOC  AS "UOMDOC",
		       ST.CNTBSK  AS "CNTBSK",
		       ST.NUPDPS  AS "NUPDPS",
		       ST.REFDKY  AS "REFDKY",
		       ST.REFDIT  AS "REFDIT",
		       ST.REFCAT  AS "REFCAT",
		       ST.REFDAT  AS "REFDAT",
		       ST.PURCKY  AS "PURCKY",
		       ST.PURCIT  AS "PURCIT",
		       ST.ASNDKY  AS "ASNDKY",
		       ST.ASNDIT  AS "ASNDIT",
		       ST.RECVKY  AS "RECVKY",
		       ST.RECVIT  AS "RECVIT",
		       ST.SHPOKY  AS "SHPOKY",
		       ST.SHPOIT  AS "SHPOIT",
		       ST.GRPOKY  AS "GRPOKY",
		       ST.GRPOIT  AS "GRPOIT",
		       ST.TASKKY  AS "TASKKY",
		       ST.TASKIT  AS "TASKIT",
		       ST.SADJKY  AS "SADJKY",
		       ST.SADJIT  AS "SADJIT",
		       ST.SDIFKY  AS "SDIFKY",
		       ST.SDIFIT  AS "SDIFIT",
		       ST.PHYIKY  AS "PHYIKY",
		       ST.PHYIIT  AS "PHYIIT",
		       ST.OWNRKY  AS "OWNRKY",
		       ST.SKUKEY  AS "SKUKEY",
		       ST.LOTA01  AS "LOTA01",
		       ST.LOTA02  AS "LOTA02",
		       ST.LOTA03  AS "LOTA03",
		       ST.LOTA04  AS "LOTA04",
		       ST.LOTA05  AS "LOTA05",
		       ST.LOTA06  AS "LOTA06",
		       ST.LOTA07  AS "LOTA07",
		       ST.LOTA08  AS "LOTA08",
		       ST.LOTA09  AS "LOTA09",
		       ST.LOTA10  AS "LOTA10",
		       ST.LOTA11  AS "LOTA11",
		       ST.LOTA12  AS "LOTA12",
		       ST.LOTA13  AS "LOTA13",
		       ST.LOTA14  AS "LOTA14",
		       ST.LOTA15  AS "LOTA15",
		       ST.LOTA16  AS "LOTA16",
		       ST.LOTA17  AS "LOTA17",
		       ST.LOTA18  AS "LOTA18",
		       ST.LOTA19  AS "LOTA19",
		       ST.LOTA20  AS "LOTA20",
		       ST.AWMSNO  AS "AWMSNO",
		       ST.DESC01  AS "DESC01",
		       ST.DESC02  AS "DESC02",
		       ST.ASKU01  AS "ASKU01",
		       ST.ASKU02  AS "ASKU02",
		       ST.ASKU03  AS "ASKU03",
		       ST.ASKU04  AS "ASKU04",
		       ST.ASKU05  AS "ASKU05",
		       ST.EANCOD  AS "EANCOD",
		       ST.GTINCD  AS "GTINCD",
		       ST.SKUG01  AS "SKUG01",
		       ST.SKUG02  AS "SKUG02",
		       ST.SKUG03  AS "SKUG03",
		       ST.SKUG04  AS "SKUG04",
		       ST.SKUG05  AS "SKUG05",
		       ST.GRSWGT  AS "GRSWGT",
		       ST.NETWGT  AS "NETWGT",
		       ST.WGTUNT  AS "WGTUNT",
		       ST.LENGTH  AS "LENGTH",
		       ST.WIDTHW  AS "WIDTHW",
		       ST.HEIGHT  AS "HEIGHT",
		       ST.CUBICM  AS "CUBICM",
		       ST.CAPACT  AS "CAPACT",
		       ST.ZONEKY  AS "ZONEKY",
		       ST.TKZONE  AS "TKZONE",
		       ST.AREAKY  AS "AREAKY",
		       ST.SMANDT  AS "SMANDT",
		       ST.SEBELN  AS "SEBELN",
		       ST.SEBELP  AS "SEBELP",
		       ST.SZMBLNO AS "SZMBLNO",
		       ST.SZMIPNO AS "SZMIPNO",
		       ST.STRAID  AS "STRAID",
		       ST.SVBELN  AS "SVBELN",
		       ST.SPOSNR  AS "SPOSNR",
		       ST.STKNUM  AS "STKNUM",
		       ST.STPNUM  AS "STPNUM",
		       ST.SWERKS  AS "SWERKS",
		       ST.SLGORT  AS "SLGORT",
		       ST.SDATBG  AS "SDATBG",
		       ST.STDLNR  AS "STDLNR",
		       ST.SSORNU  AS "SSORNU",
		       ST.SSORIT  AS "SSORIT",
		       ST.SMBLNR  AS "SMBLNR",
		       ST.SZEILE  AS "SZEILE",
		       ST.SMJAHR  AS "SMJAHR",
		       ST.SXBLNR  AS "SXBLNR",
		       ST.SAPSTS  AS "SAPSTS",
		       ST.SBKTXT  AS "SBKTXT",
		       ST.CREDAT  AS "CREDAT",
		       ST.CRETIM  AS "CRETIM",
		       ST.CREUSR  AS "CREUSR",
		       ST.LMODAT  AS "LMODAT",
		       ST.LMOTIM  AS "LMOTIM",
		       ST.LMOUSR  AS "LMOUSR",
		       NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = #{TASOTY}), ' ') AS "LOCATG"
		  FROM STKKY ST
		       INNER JOIN LOCMA L
		               ON L.WAREKY = ST.WAREKY
		              AND L.LOCAKY = ST.LOCAKY
		 WHERE 1 = 1
			   AND ST.QTSIWH > 0
			   AND ST.QTSPMO = 0
			   AND ST.QTSBLK = 0
			  
			   <if test="WAREKY != null and WAREKY != ''"> 
			   AND ST.WAREKY = #{WAREKY}
			   </if>
			   <if test="OWNRKY != null and OWNRKY != ''"> 
			   AND ST.OWNRKY = #{OWNRKY}
			   </if>		   
			   <if test="STOKKY != null and STOKKY != ''">		   
				AND ST.STOKKY = #{STOKKY}
			   </if>
			   <if test="LOTA01 != null and LOTA01 != ''">		   
				AND ST.LOTA01 = #{LOTA01}
			   </if>
			   <if test="LOTA02 != null and LOTA02 != ''">		   
				AND ST.LOTA02 = #{LOTA02}
			   </if>
			   <if test="LOTA14 != null and LOTA14 != ''">		   
				AND ST.LOTA14 = #{LOTA14}
			   </if>
			   <if test="LOCASR != null and LOCASR != ''">		   
				AND ST.LOCAKY = #{LOCASR}
			   </if>
			   <if test="AREAKY != null and AREAKY != ''">		   
				AND ST.AREAKY = #{AREAKY}
			   </if>
			   <if test="ZONEKY != null and ZONEKY != ''">		   
				AND ST.ZONEKY = #{ZONEKY}
			   </if>
			   <if test="SKUKEY != null and SKUKEY != ''">		   
				AND ST.SKUKEY = #{SKUKEY}
			   </if>
			   
		   
		 ORDER BY ST.LOCAKY, ST.AREAKY, ST.ZONEKY
	</select>
	
	<select id="BARCOD_CHECK_MAP" parameterType="Map" resultType="DataMap">
			
			SELECT 
				CASE 
					WHEN MAX(S.LOTA14) IS NULL THEN 
						CASE 
							WHEN COUNT((SELECT COUNT(LOTA14) FROM STKKY WHERE WAREKY = #{WAREKY} AND LOTA14 = #{BARCOD})) IS NULL THEN 'MOBILE_M0057'	-- 실물만 존재하는 CASE
							ELSE 'MOBILE_M0052' 
						END
		            WHEN SUM(DECODE(S.LOTA06, '00', 0, 1)) = COUNT(*) THEN 'MOBILE_M0053'
					WHEN MAX(S.LOTA14) IS NULL THEN 'MOBILE_M0052' 
		            WHEN SUM(DECODE(S.LOTA06, '00', 0, 1)) = COUNT(*) THEN 'MOBILE_M0053'
		            WHEN SUM(DECODE(S.AREAKY, 'SHP', 1, 0)) = COUNT(*) THEN 'MOBILE_M0045'
		            WHEN MAX(S.SKUKEY) != #{SKUKEY} THEN 'MOBILE_M0054'		            		            
		            WHEN SUM(S.QTSIWH) - GREATEST(SUM(S.QTSALO),SUM(S.QTSPMO)) = 0 THEN 'OUT_M0235'		          
		            ELSE ' '
		        END AS MSG
		        , COUNT(S.LOTA14) AS LOCCNT
		  FROM STKKY S
		 WHERE S.WAREKY = #{WAREKY}  
		   AND S.LOTA14 = #{BARCOD}  
		   AND S.QTSIWH > 0
		   AND S.QTSALO = 0
		   AND S.QTSPMO = 0
	       AND S.QTSPMI = 0
	       AND S.QTSBLK = 0
		   AND S.AREAKY NOT IN('SYS')		   	
	</select>	
	<select id="BARCOD_CHECK_HL_MAP" parameterType="Map" resultType="DataMap">
			
			SELECT 
				CASE 
					WHEN MAX(S.LOTA14) IS NULL THEN 'MOBILE_M0052' 
		            WHEN SUM(DECODE(S.LOTA06, '00', 0, 1)) = COUNT(*) THEN 'MOBILE_M0053'
		            WHEN SUM(DECODE(S.AREAKY, 'SHP', 1, 0)) = COUNT(*) THEN 'MOBILE_M0045'
		            WHEN MAX(S.SKUKEY) != #{SKUKEY} THEN 'MOBILE_M0054'		            		            
		            WHEN SUM(S.QTSIWH) - GREATEST(SUM(S.QTSALO),SUM(S.QTSPMO)) = 0 THEN 'OUT_M0235'		          
		            ELSE ' '
		        END AS MSG
		        , COUNT(S.LOTA14) AS LOCCNT
		  FROM STKKY S
		 WHERE S.WAREKY = #{WAREKY}  
		   AND S.LOTA14 = #{BARCOD}  
		   AND S.LOTA01 = #{LOTA01}  
		   AND S.LOTA02 = #{LOTA02}  
		   AND S.QTSIWH > 0
		   AND S.QTSALO = 0
		   AND S.QTSPMO = 0
	       AND S.QTSPMI = 0
	       AND S.QTSBLK = 0
		   AND S.AREAKY NOT IN('SYS')		   	
	</select>	
	
	<select id="SKUKEY_CHECK_HL_MAP" parameterType="Map" resultType="DataMap">
			
			SELECT 
				CASE 
		            WHEN MAX(S.SKUKEY) != #{SKUKEY} THEN 'MOBILE_M0054'		            		            
					ELSE ' '
		        END AS MSG
		        , COUNT(S.LOTA14) AS LOCCNT
		  FROM STKKY S
		 WHERE S.WAREKY = #{WAREKY}  
		   AND S.LOTA14 = #{BARCOD}  	
	</select>	
	
	<select id="TASDI_LOCK_INFO_LIST" parameterType="Map" resultType="DataMap">
				SELECT TH.TASKKY
					 , TI.TASKIT
				     , CASE WHEN NVL(TRIM(TI.PAIDSR), ' ') != ' ' AND TI.PAIDSR = #{SES_USER_ID} THEN ' '
							WHEN NVL(TRIM(TI.PAIDSR), ' ') != ' ' AND TI.PAIDSR != #{SES_USER_ID} THEN TI.PAIDSR
						    ELSE ' '
					   END AS PAIDSR				          
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
		           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN('NEW', 'PPC', 'FPC')
				<if test="STKNUM != null and STKNUM != ''">   	  
				   AND TI.STKNUM = #{STKNUM} 
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
			 	ORDER BY  TASKKY DESC, TASKIT ASC
	</select>
	
	<update id="TASDI_LOCK_INFO_UPDATE" parameterType="Map">
				UPDATE TASDI
				   SET PAIDSR = CASE WHEN #{INOUTCHK} = 'IN' THEN #{SES_USER_ID}
				   					 WHEN #{INOUTCHK} = 'OUT' THEN ' '
				   					 ELSE ' '
				   				END	
				 WHERE TASKKY = #{TASKKY}
				   AND TASKIT = #{TASKIT} 
				   <if test="INOUTCHK == &quot;RESET&quot;">
				   AND PAIDSR = #{SES_USER_ID}
				   </if>
	</update>
	
	<select id="SHPDI_STKNUM_INFO_LIST" parameterType="Map" resultType="DataMap">
				SELECT SI.STKNUM AS TKNUM
					 , SI.SVBELN AS VBELN
					 , #{WAREKY} AS WAREKY	
					 , #{STATUS} AS STATUS					 				          	
				  FROM SHPDH SH
                 INNER JOIN SHPDI SI ON SH.SHPOKY = SI.SHPOKY				       
				 WHERE 1 = 1
				   AND SH.WAREKY = #{WAREKY}
		           AND SI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})				   
				   AND SI.STKNUM = #{STKNUM}
				   AND SUBSTR(SI.SHPOIT, 0, 1) != 1 
				   AND SI.STATIT IN('NEW', 'PAL', 'FAL', 'PPC', 'FPC')                 
			   	   AND NVL(TRIM(SI.SAPSTS), NULL) IS NOT NULL
			   <if test="DPTNKY != null and DPTNKY != ''">
				   AND SH.DPTNKY = #{DPTNKY}
			   </if>
			   GROUP BY SI.STKNUM, SI.SVBELN 								   				
	</select>
	
	<select id="PDPK05_PDA_PICKING_MAP" parameterType="Map" resultType="DataMap">
		 { call P_PDA_PICKING_COMPLETE( #{STKNUM}, #{SKUKEY}, #{LOCAKY}, #{DPTNKY}, #{SES_USER_ID}) }
	</select>
	
	<select id="GR_CURDATE_MAP" parameterType="Map" resultType="DataMap">
		SELECT F_SET_DATE(SYSDATE) AS DOCDAT
			 , TO_CHAR(SYSDATE,'YYYYMMDD') AS ORDDAT
		     , TO_CHAR(SYSDATE,'YYYY.MM.DD') AS DOCDAT_DOT
		     , TO_CHAR(SYSDATE,'YYYY') AS DOCDAT_YYYY
		     , TO_CHAR(SYSDATE,'MM') AS DOCDAT_MM
		     , TO_CHAR(SYSDATE,'DD') AS DOCDAT_DD
		FROM DUAL
	</select>
	
	<select id="TASDH_INFO_LIST" parameterType="Map" resultType="DataMap">
				SELECT MAX(TI.TASKKY) TASKKY
					 , MAX(TI.TASKIT) TASKIT
                  FROM TASDI TI
                 WHERE TI.SHPOKY = #{SHPOKY}
                   AND TI.TASKTY = 'PK'
                    
	</select>
	
	<select id="TASDR_MAXINFO_LIST" parameterType="Map" resultType="DataMap">
				SELECT MAX(TR.TASKKY) TASKKY
					 , MAX(TR.TASKIT) TASKIT
                  FROM TASDR TR
                 WHERE TR.TASKKY = #{TASKKY}
                   
                    
	</select>
	
	<update id="APPOINTPICKINGFLAG_UPDATE" parameterType="Map">
				UPDATE SHPDI
				   SET APPOINTPICKING = 'V'
				 WHERE SHPOKY = #{SHPOKY}
				   AND SHPOIT = #{SHPOIT}
				   AND SKUKEY = #{SKUKEY}
	</update>
	
	
	<!-- 검수완료시 TASDI에 검수여부 업데이트-->
	<update id="PDPK05_DL21Sub_UPDATE" parameterType="Map">
		UPDATE TASDI
		   SET LSTTFL = #{LSTTFL}
			 , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		 WHERE TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}		   
	</update>
	
	
	<!-- 저장시 검수수량 update -->
	<update id="PDPK05_DL05Sub_UPDATE" parameterType="Map">
		UPDATE SHPDI
		   SET QTSHPC = QTSHPC + #{QTSHPC}
			 , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		 WHERE SHPOKY = #{SHPOKY}
		   AND SHPOIT = #{SHPOIT}
	</update>
	
	<select id="PDPK05_TASDI_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT, TI.STATIT
		  FROM TASDI TI 
		  INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TI.TASKTY = 'PK'
		   AND TI.STATIT IN ('FPC', 'NEW')
		   AND TI.STKNUM = #{STKNUM}
		   AND TI.SKUKEY = #{SKUKEY}
		   AND TI.LOCASR = #{LOCAKY}
		   AND TI.LOTA14 = #{BARCOD}
		   AND TI.LOTA07 = NVL(#{LOTA07}, ' ')
		
           		  
		   						   				
	</select>
	
	<select id="PDPK05_DELETE_TASDI_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT, TI.STATIT
		  FROM TASDI TI 
		  INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
		  INNER JOIN SHPDI SI ON TI.SHPOKY = SI.SHPOKY
		  					 AND TI.SHPOIT = SI.SHPOIT
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TI.TASKTY = 'PK'
		   AND TI.STATIT IN ('FPC', 'NEW')
		   AND SI.QTSHPD = 0
		   AND SI.QTSHPC = 0
		   AND TI.STKNUM = #{STKNUM}
	   <if test="DPTNKY != null and DPTNKY != ''">
		   AND TH.PTNRKY = #{DPTNKY}
		</if>
		   AND TI.SKUKEY = #{SKUKEY}
		   AND TI.LOCASR = #{LOCAKY}
		   AND TI.LOTA14 = #{BARCOD}	
           AND TI.LOTA07 = NVL(#{LOTA07}, ' ')
	</select>
	
	<delete id="PDPK05_TASDIDEL_DELETE" parameterType="Map">
		DELETE FROM TASDI
		 WHERE TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}	
	</delete>
	
	<delete id="PDPK05_TASDRDEL_DELETE" parameterType="Map">
		DELETE FROM TASDR
		 WHERE TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}
	</delete>
	
	
	<select id="PDPK05_ALL_TASDI_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT TI.TASKKY, TI.TASKIT, TI.STATIT
		  FROM TASDI TI 
		  INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TI.TASKTY = 'PK'
		   AND TI.STATIT IN ('NEW', 'FCN')
		   AND TI.STKNUM = #{STKNUM}
	   <if test="DPTNKY != null and DPTNKY != ''">
		   AND TH.PTNRKY = #{DPTNKY}
		</if>
		   AND TI.SKUKEY = #{SKUKEY}
		   AND TI.LOCASR = #{LOCAKY}
		   AND TI.LOTA14 = #{BARCOD}
           AND TI.LOTA07 = NVL(#{LOTA07}, ' ')
		   						   				
	</select>
	
	
	<!-- PDLOC -->
	<select id="PDPK05_DETAIL02_POP_LIST" parameterType="Map" resultType="DataMap">
		SELECT  S.LOCAKY,
				S.AREAKY,
				S.ZONEKY, 
				S.LOTA02, 
				S.LOTA01, 
				S.LOTA11 
		  FROM STKKY S
		 WHERE S.WAREKY = #{WAREKY}
		   AND S.LOTA14 = #{BARCOD}
		   AND S.SKUKEY = #{SKUKEY}				
	    <!-- PS의 경우 저장위치 없는 품목 처리를 위한 IF문처리 -->
	   	<if test="LOTA01 != null and LOTA01 != ''">
		   AND S.LOTA01 = #{LOTA01}
		</if>
		   AND S.LOTA02 = #{LOTA02}				
		   AND S.QTSIWH > 0
		   AND S.QTSALO = 0
		   AND S.QTSPMO = 0
		   AND S.QTSPMI = 0
		   AND S.QTSBLK = 0
		   AND S.AREAKY NOT IN('SYS', 'SHP')
           GROUP BY S.LOCAKY, S.AREAKY, S.ZONEKY, S.LOTA02, S.LOTA01, S.LOTA11  
	</select>
	<!-- PDPK06HL_PDLOC -->
	<!-- 지정피킹HL 대체바코드 생산일이(LOTA11) 빠르며 수량이(QTSIWH) 적은 리스트 1개 노출 (변경 전: 리스트 모두노출) -->
	<!-- 재고상태(LOTA06) 조건추가 (정상만 노출) -->
	<select id="PDPK06HL_DETAIL02_POP_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			T1.*
		FROM (
			SELECT S.LOCAKY,
				   S.AREAKY,
				   S.ZONEKY,
				   S.LOTA14,
				   S.LOTA11,
				   S.QTSIWH
			  FROM STKKY S 
			 INNER JOIN LOCMA L ON L.WAREKY = S.WAREKY AND L.LOCAKY = S.LOCAKY
			 WHERE S.WAREKY = #{WAREKY}
				   AND S.SKUKEY = #{SKUKEY}				
				   AND S.LOTA01 = #{LOTA01}				
				   AND S.LOTA02 = #{LOTA02}				
				   AND S.QTSIWH > 0
				   AND S.QTSALO = 0
				   AND S.QTSPMO = 0
				   AND S.QTSPMI = 0
				   AND S.QTSBLK = 0
				   AND S.AREAKY NOT IN('SYS', 'SHP')
				   AND S.LOTA14 != ' '
	   			   AND S.LOTA06 = '00' 
	   			   AND L.INDUPK = 'V'
           		   AND L.STATUS = '00' 
		   	 ORDER BY LOTA11 ASC, QTSIWH ASC 
		) T1 
		WHERE ROWNUM &lt; 2
	</select>
	
	<!-- mto/mts확인 -->
	<select id="PDPK05_DETAIL02_MTOPOP_LIST" parameterType="Map" resultType="DataMap">
		SELECT NVL((SELECT SUM(NVL(QTSIWH, 0) - NVL(QTSALO, 0))
			      FROM STKKY S1
			     WHERE S1.WAREKY = #{WAREKY}
		           AND S1.LOTA14 = #{BARCOD}
		           AND S1.SKUKEY = #{SKUKEY} 
		           AND S1.LOCAKY = #{LOCAKY}
		           AND S1.LOTA07 = NVL(#{LOTA07}, ' ')
                   AND S1.AREAKY NOT IN('SYS', 'SHP')
			   ), 0) AS USEQTY
             , SUM(NVL(QTSIWH, 0) - NVL(QTSALO, 0)) AS QTSIWH
             , S.LOTA07
             , S.UOMKEY
             , TO_NUMBER(REPLACE(#{QTSHPO}, ',')) - TO_NUMBER(REPLACE(#{QTJCMP}, ',')) AS NXTPIC
		  FROM STKKY S
		 WHERE S.WAREKY = #{WAREKY}
		   AND S.LOTA14 = #{BARCOD}
		   AND S.SKUKEY = #{SKUKEY}	
		   AND S.LOCAKY = #{LOCAKY}
		   AND S.LOTA07 != NVL(#{LOTA07}, ' ')			
		   AND S.QTSIWH - S.QTSALO > 0
		   AND S.AREAKY NOT IN('SYS', 'SHP')
         GROUP BY S.LOTA07, S.UOMKEY
         ORDER BY S.LOTA07
	</select>

	
	<insert id="ADJDH_INSERT" parameterType="Map">
	   <selectKey order="BEFORE" keyProperty="SADJKY" resultType="String">
	       SELECT SZF_GETDOCNUMBER('423') AS SADJKY
             FROM DUAL
	   </selectKey>
	    INSERT INTO ADJDH (
	         SADJKY,WAREKY,ADJUTY,DOCDAT,DOCCAT,ADJUCA,DOCTXT
	        ,CREDAT,CRETIM,CREUSR
	        ,LMODAT,LMOTIM,LMOUSR
	        ,ADJFLG
	        ,REFCKY,REFCDT
	        ,SAPIFYN
	    ) VALUES (
	         #{SADJKY}, #{WAREKY}, '423', TO_CHAR(SYSDATE, 'YYYYMMDD'), '400', '423', '지정피킹 변경'
	        ,TO_CHAR(SYSDATE, 'YYYYMMDD'),  TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
	        ,TO_CHAR(SYSDATE, 'YYYYMMDD'),  TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
	        ,NVL('M', ' ')
	        ,' ',DECODE(NVL('', ' '), ' ', ' ', TO_CHAR(SYSDATE, 'YYYYMMDD'))
	        ,' '
	    )
	</insert>
		
	<select id="selectMtoMtsStkky_LIST" parameterType="Map" resultType="DataMap">
        SELECT STOKKY, (QTSIWH - QTSALO) AS QTSIWH
             , LOTA01,LOTA02,LOTA03,LOTA04,LOTA05,LOTA06,LOTA07,LOTA08,LOTA09,LOTA10
             , LOTA11,LOTA12,LOTA13,LOTA14,LOTA15,LOTA16,LOTA17,LOTA18,LOTA19,LOTA20
             , ASKU01,ASKU02,ASKU03,ASKU04,ASKU05,SKUG01,SKUG02,SKUG03,SKUG04,SKUG05
             , LOTNUM,LOCAKY,TRNUID,SECTID,PACKID
             , TRUNTY,MEASKY,UOMKEY,QTPUOM,DUOMKY,QTDUOM
             , REFDKY,REFDIT,REFCAT,OWNRKY,SKUKEY,DESC01,DESC02
             , AWMSNO,AREAKY,EANCOD,GTINCD,GRSWGT,NETWGT,WGTUNT,LENGTH,WIDTHW,HEIGHT,CUBICM,CAPACT
             , SMANDT,SEBELN,SEBELP,SZMBLNO,SZMIPNO,STRAID,SVBELN,SPOSNR,STKNUM
             , STPNUM,SWERKS,SLGORT,SDATBG,STDLNR,SSORNU,SSORIT,SMBLNR,SZEILE
          FROM STKKY  S
         WHERE S.WAREKY = #{WAREKY}
           AND S.LOTA14 = #{BARCOD}
           AND S.SKUKEY = #{SKUKEY} 
           AND S.LOCAKY = #{LOCAKY}
           AND S.LOTA07 != NVL(#{LOTA07}, ' ')            
           AND S.QTSIWH - S.QTSALO > 0
           AND S.AREAKY NOT IN('SYS', 'SHP')
         ORDER BY S.LOTA07
	</select>
	
	<insert id="insertMtoMtsChange_INSERT" parameterType="Map">
        INSERT INTO ADJDI (
             SADJKY,SADJIT
            ,LOTA01,LOTA02,LOTA03,LOTA04,LOTA05,LOTA06,LOTA07,LOTA08,LOTA09,LOTA10
            ,LOTA11,LOTA12,LOTA13,LOTA14,LOTA15,LOTA16,LOTA17,LOTA18,LOTA19,LOTA20
            ,ASKU01,ASKU02,ASKU03,ASKU04,ASKU05,SKUG01,SKUG02,SKUG03,SKUG04,SKUG05
            ,RSNADJ,STOKKY,LOTNUM,LOCAKY,TRNUID,SECTID,PACKID
            ,QTADJU,QTYUOM,TRUNTY,MEASKY,UOMKEY,QTPUOM,DUOMKY,QTDUOM
            ,REFDKY,REFDIT,REFCAT,OWNRKY,SKUKEY,DESC01,DESC02
            ,AWMSNO,AREAKY,EANCOD,GTINCD,GRSWGT,NETWGT,WGTUNT,LENGTH,WIDTHW,HEIGHT,CUBICM,CAPACT
            ,SMANDT,SEBELN,SEBELP,SZMBLNO,SZMIPNO,STRAID,SVBELN,SPOSNR,STKNUM
            ,STPNUM,SWERKS,SLGORT,SDATBG,STDLNR,SSORNU,SSORIT,SMBLNR,SZEILE
            ,SMJAHR,SXBLNR,SAPSTS,ADJRSN,RELRSN,RELDAT,RELUSR
            ,CREDAT,CRETIM,CREUSR
            ,LMODAT,LMOTIM,LMOUSR
            ,REFSTK
        )
        SELECT   #{SADJKY}, LPAD(${SADJIT} + (B.LV * 10), 6, '0')
                ,V_STK.LOTA01,V_STK.LOTA02,V_STK.LOTA03,V_STK.LOTA04,V_STK.LOTA05,V_STK.LOTA06
                ,CASE WHEN B.LV = 1 THEN V_STK.LOTA07 ELSE NVL(#{LOTA07_TO}, ' ') END
                ,V_STK.LOTA08,V_STK.LOTA09,V_STK.LOTA10
                ,V_STK.LOTA11,V_STK.LOTA12,V_STK.LOTA13,V_STK.LOTA14,V_STK.LOTA15,V_STK.LOTA16,V_STK.LOTA17,V_STK.LOTA18,V_STK.LOTA19,V_STK.LOTA20
                ,V_STK.ASKU01,V_STK.ASKU02,V_STK.ASKU03,V_STK.ASKU04,V_STK.ASKU05,V_STK.SKUG01,V_STK.SKUG02,V_STK.SKUG03,V_STK.SKUG04,V_STK.SKUG05
                ,'999'
                ,CASE WHEN B.LV = 1 THEN V_STK.STOKKY ELSE ' ' END
                ,CASE WHEN B.LV = 1 THEN V_STK.LOTNUM ELSE ' ' END
                ,V_STK.LOCAKY,V_STK.TRNUID,V_STK.SECTID,V_STK.PACKID
                , CASE WHEN B.LV = 1 THEN ROUND(TO_NUMBER(REPLACE(#{MTOQTY}, ',')), 3) * -1 ELSE ROUND(TO_NUMBER(REPLACE(#{MTOQTY},',')),3) END
                , CASE WHEN B.LV = 1 THEN ROUND(TO_NUMBER(REPLACE(#{MTOQTY}, ',')), 3) * -1 ELSE ROUND(TO_NUMBER(REPLACE(#{MTOQTY},',')),3) END
                ,V_STK.TRUNTY,V_STK.MEASKY,V_STK.UOMKEY,V_STK.QTPUOM,V_STK.DUOMKY,V_STK.QTDUOM
                ,V_STK.REFDKY,V_STK.REFDIT,V_STK.REFCAT,V_STK.OWNRKY,V_STK.SKUKEY,V_STK.DESC01,V_STK.DESC02
                ,V_STK.AWMSNO,V_STK.AREAKY,V_STK.EANCOD,V_STK.GTINCD,V_STK.GRSWGT,V_STK.NETWGT,V_STK.WGTUNT,V_STK.LENGTH,V_STK.WIDTHW,V_STK.HEIGHT,V_STK.CUBICM,V_STK.CAPACT
                ,V_STK.SMANDT,V_STK.SEBELN,V_STK.SEBELP,V_STK.SZMBLNO,V_STK.SZMIPNO,V_STK.STRAID,V_STK.SVBELN,V_STK.SPOSNR,V_STK.STKNUM
                ,V_STK.STPNUM,V_STK.SWERKS,V_STK.SLGORT,V_STK.SDATBG,V_STK.STDLNR,V_STK.SSORNU,V_STK.SSORIT,V_STK.SMBLNR,V_STK.SZEILE
                ,' ',' ','413',' ',' ',TO_CHAR(SYSDATE, 'YYYYMMDD'),NVL('', ' ')
                ,TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
                ,TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
                ,NVL(V_STK.STOKKY,' ')
          FROM STKKY V_STK
         INNER JOIN (SELECT LEVEL AS LV FROM DUAL CONNECT BY LEVEL  <![CDATA[<=]]>  2) B
            ON 1 = 1
         WHERE STOKKY = #{STOKKY}
	</insert>
	
	<select id="selectLogseqno_MAP" parameterType="Map" resultType="DataMap">
	   SELECT 'W' || TRIM(TO_CHAR(SEQ_IFCOMMLOG.NEXTVAL, '00000000000000000000000000000')) AS LOGSEQNO
	     FROM DUAL
	</select>
	
	<insert id="insertMtoMts_IFWMS223_INSERT" parameterType="Map">
		INSERT INTO IFWMS223 (
		       MANDT
		     , SEQNO
		     , SADJKY
		     , SADJIT
		     , ORDCAT
		     , BWART
		     , WERKS
		     , MATNR
		     , QTADJU
		     , TMATNR
		     , MEINS
		     , VGBEL
		     , VGPOS
		     , STATUS
		     , WAREKY
		     ,  LOTA01,  LOTA02,  LOTA03,  LOTA04,  LOTA05
		     ,  LOTA06,  LOTA07,  LOTA08,  LOTA09,  LOTA10
		     ,  LOTA11,  LOTA12,  LOTA13,  LOTA14,  LOTA15
		     ,  LOTA16,  LOTA17,  LOTA18,  LOTA19,  LOTA20
		     , TLOTA01, TLOTA02, TLOTA03, TLOTA04, TLOTA05
		     , TLOTA06, TLOTA07, TLOTA08, TLOTA09, TLOTA10
		     , TLOTA11, TLOTA12, TLOTA13, TLOTA14, TLOTA15
		     , TLOTA16, TLOTA17, TLOTA18, TLOTA19, TLOTA20
		     , CDATE
		     , CREDAT
		     , CRETIM
		     , CREUSR
		     , IFID
		     , IFFLG
		     , ITFFLG
		     , ITFDAT
		     , ITFTIM
		     , PRCFLG
		     , LOGSEQNO
		     , BWARTSAP
		)
		SELECT '100'                                                               AS MANDT
		     , SEQ_IFWMS223.NEXTVAL                                                AS SEQNO
		     , #{SADJKY}                                                           AS SADJKY
		     , LPAD(TO_NUMBER(${SADJIT} + 20), 6, '0')                             AS SADJIT
		     , '400'                                                               AS ORDCAT
		     , '423'                                                               AS BWART -- 재고MTO변경
		     , 'KN'                                                                AS WERKS
		     , NVL(ST.SKUKEY,' ')                                                  AS MATNR -- 품목코드
		     , NVL(ROUND(TO_NUMBER(REPLACE(#{MTOQTY},',')), 3), 0 )                                                  AS QTADJU
		     , NVL(ST.SKUKEY,' ')                                                  AS TMATNR
		     , ST.UOMKEY                                                           AS MEINS
		     , ' '                                                                 AS VGBEL
		     , ' '                                                                 AS VGPOS
		     , 'C'                                                                 AS STATUS
		     , ST.WAREKY                                                           AS WAREKY
		     , ST.LOTA01, ST.LOTA02, ST.LOTA03, ST.LOTA04, ST.LOTA05
		     , ST.LOTA06, ST.LOTA07, ST.LOTA08, ST.LOTA09, ST.LOTA10
		     , ST.LOTA11, ST.LOTA12, ST.LOTA13, ST.LOTA14, ST.LOTA15
		     , ST.LOTA16, ST.LOTA17, ST.LOTA18, ST.LOTA19, ST.LOTA20
		     , ST.LOTA01 AS TLOTA01, ST.LOTA02 AS TLOTA02, ST.LOTA03 AS TLOTA03, ST.LOTA04 AS TLOTA04, ST.LOTA05 AS TLOTA05
		     , ST.LOTA06 AS TLOTA06, NVL(#{LOTA07_TO}, ' ') AS TLOTA07, ST.LOTA08 AS TLOTA08, ' '       AS TLOTA09, ST.LOTA10 AS TLOTA10
		     , ST.LOTA11 AS TLOTA11, ST.LOTA12 AS TLOTA12, ST.LOTA13 AS TLOTA13, ST.LOTA14 AS TLOTA14, ST.LOTA15 AS TLOTA15
		     , ST.LOTA16 AS TLOTA16, ST.LOTA17 AS TLOTA17, ST.LOTA18 AS TLOTA18, ST.LOTA19 AS TLOTA19, ST.LOTA20 AS TLOTA20
		     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS')           AS CDATE
		     , TO_CHAR(SYSDATE, 'YYYYMMDD')                   AS CREDAT
		     , TO_CHAR(SYSDATE, 'HH24MISS')                   AS CRETIM
		     , NVL(TRIM(#{SES_USER_ID}), 'WMS_IF_402')        AS CREUSR
		     , 'WMS_IF_402'                                   AS IFID
		     , 'N'                                            AS IFFLG
		     , 'I'                                            AS ITFFLG
		     , TO_CHAR(SYSDATE, 'YYYYMMDD')                   AS ITFDAT
		     , TO_CHAR(SYSDATE, 'HH24MISS')                   AS ITFTIM
		     , 'I'                                            AS PRCFLG
		     , #{LOGSEQNO}                                    AS LOGSEQNO
		     , CASE WHEN NVL(#{LOTA07_TO}, ' ') = ' ' THEN '411' ELSE '413' END    AS BWARTSAP
		FROM STKKY ST
		INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY AND SM.SKUKEY = ST.SKUKEY
		WHERE 1=1
		  AND ST.STOKKY = #{STOKKY}
	</insert>
	
	<select id="UNALLOCATE_TARGET_LIST" parameterType="Map" resultType="DataMap">
		SELECT SH.DPTNKY, SI.STKNUM, SI.SHPOKY, SI.SHPOIT , SH.STATDO, TI.LOTA14 
         FROM SHPDH SH
         INNER JOIN SHPDI SI ON (SH.SHPOKY = SI.SHPOKY) 
         INNER JOIN TASDI TI ON SI.SHPOKY = TI.SHPOKY AND SI.SHPOIT = TI.SHPOIT 
         WHERE SH.WAREKY = #{WAREKY}
	         AND SI.SKUKEY = #{SKUKEY}
        	 AND SH.STATDO IN ('PPC', 'PAL', 'FAL')	-- 부분피킹, 부분할당, 할당완료
        	 AND TI.TASKTY = 'PK' 
        	 
        	 <choose>
        	 	<!-- 선적 + 납품처 + 품목 할당취소 (PDPK05StockValidation 메소드에서 호출) -->
        	 	<when test="METHOD != null and 'PDPK05StockValidation'.equals(METHOD) and STKNUM != null and STKNUM != ''">
        	 		AND SI.STKNUM = #{STKNUM} 
        	 		<if test="DPTNKY != null and DPTNKY != ''">
        	 			AND SH.DPTNKY = #{DPTNKY}
				   </if> 
        	 	</when>
        	 	<!-- 품목 + 스캔한바코드 할당취소 (barcodCheck 메소드에서 호출) -->
        	 	<otherwise>
        	 		<if test="METHOD != null and 'barcodCheck'.equals(METHOD) and BARCOD != null and BARCOD != ''">
					   AND TI.LOTA14 = #{BARCOD}
				   </if>  
        	 	</otherwise>
        	 </choose>
       	 ORDER BY SI.SHPOKY, SI.SHPOIT	-- 재할당시 출하문서번호 조건비교를 위해 정렬 적용
	</select>
	
	<select id="StockFIFOValidation_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			CV.CMCDVL
			, CV.CDESC1
			, CV.USARG1	AS LOTA11_LAST 
			, CV.USARG2 AS LOTA11_PRE
		FROM CMCDV CV 
		WHERE EXISTS (
			SELECT 
				* 
			FROM CMCDV 
			WHERE CMCDKY = 'DPTNKY_FIFO_GROUP'
			AND CMCDVL = #{DPTNKY}
			AND USARG1 = 'Y'
		) 
		AND CMCDKY = 'DPTNKY_FIFO_LIST' 
		AND CMCDVL = #{DPTNKY_SKUKEY}
	</select>
</mapper>