	<delete id="TASDIDEL_DELETE" parameterType="Map">
		DELETE FROM TASDI
		 WHERE TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}
	</delete>
	
	<!-- TASKKY 채번 -->
	<select id="TASKKY_MAP" parameterType="Map" resultType="DataMap">
		SELECT SZF_GETDOCNUMBER('330') AS TASKKY
	         FROM DUAL  
	</select>
	
	
	<insert id="TASDHEND_INSERT" parameterType="Map">	   
	   INSERT INTO TASDH(
                    TASKKY,
                    WAREKY,
                    TASOTY,
                    DOCDAT,
                    DOCCAT,
                    DRELIN,
                    STATDO,
                    QTTAOR,
                    QTCOMP,
                    TSPKEY,
                    DOORKY,
                    WARETG,
                    PTNRKY,
                    PTNRTY,
                    PTNRNM,
                    USRID1,
                    UNAME1,
                    DEPTID1,
                    DNAME1,
                    USRID2,
                    UNAME2,
                    DEPTID2,
                    DNAME2,
                    USRID3,
                    UNAME3,
                    DEPTID3,
                    DNAME3,
                    USRID4,
                    UNAME4,
                    DEPTID4,
                    DNAME4,
                    DOCTXT,
                    CREDAT,
                    CRETIM,
                    CREUSR,
                    LMODAT,
                    LMOTIM,
                    LMOUSR,
                    INDBZL,
                    INDARC,
                    UPDCHK,
                    KEEPTS
                )VALUES(
                    #{TASKKY},
                    NVL(#{WAREKY}, ' '),
                    NVL(#{TASOTY}, '330'),
                    NVL(REPLACE(#{DOCDAT},'-',''), TO_CHAR(SYSDATE, 'YYYYMMDD')),
                    NVL(#{DOCCAT}, '300'),
                    ' ',
                    NVL(#{STATDO}, ' '),
                    0,
                    0,
                    NVL(#{TSPKEY}, ' '),
                    NVL(#{AREATG}, ' '),
                    NVL(#{WARETG}, ' '),
                    NVL(#{PTNRKY}, ' '),
                    NVL(#{PTNRTY}, ' '),
                    NVL(#{PTNRNM}, ' '),
                    NVL(#{USRID1}, ' '),
                    NVL(#{UNAME1}, ' '),
                    NVL(#{DEPTID1}, ' '),
                    NVL(#{DNAME1}, ' '),
                    NVL(#{USRID2}, ' '),
                    NVL(#{UNAME2}, ' '),
                    NVL(#{DEPTID2}, ' '),
                    NVL(#{DNAME2}, ' '),
                    NVL(#{USRID3}, ' '),
                    NVL(#{UNAME3}, ' '),
                    NVL(#{DEPTID3}, ' '),
                    NVL(#{DNAME3}, ' '),
                    NVL(#{USRID4}, ' '),
                    NVL(#{UNAME4}, ' '),
                    NVL(#{DEPTID4}, ' '),
                    NVL(#{DNAME4}, ' '),
                    NVL(#{DOCTXT}, ' '),
                    TO_CHAR(SYSDATE, 'YYYYMMDD'),
