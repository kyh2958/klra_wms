                    TO_CHAR(SYSDATE, 'HH24MISS'),
                    #{SES_USER_ID},
                    NVL(#{INDBZL}, ' '),
                    NVL(#{INDARC}, ' '),
                    TO_NUMBER(NVL(TRIM(#{UPDCHK}), 0)),
                    NVL(#{KEEPTS}, ' ')
                )
	</insert>
	
