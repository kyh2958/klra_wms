 	function clearText(data){
		if(data!=null||data!=""){
	    	data.value="";
	    }
	}
 	
 	function setBarcod(){
 		
 		var BARCOD = $.trim($("#BARCOD").val());
 		
 		if(BARCOD==""){
 			$("#BARCOD").val("");
 			PlaySound('e');
 			commonUtil.msgBox("VALID_M2050",null,null,function(){ $("#BARCOD").focus(); }); // 바코드를 입력하여주세요.
 			return;
 		}
 		
 		var gridId = "gridList";
 		
 		// 입고수량 체크
		var sumQty = 0;
		var chkItemList = gridList.getSelectData(gridId);
		for(var i=0; i < chkItemList.length; i++) {
			var QTYRCV = chkItemList[i].get("QTYRCV");
			sumQty = Number(sumQty) + Number(QTYRCV);
		}
 		
		// 동일 바코드 확인
 		var list = gridList.getGridData(gridId);
 		var existsYN = false;
		for(var i=0; i < list.length; i++) {
			
			var rowData = list[i];
        	var GRowNum = rowData.get("GRowNum");
			
			var LOTA14 = rowData.get("LOTA14");
			var LOTA02 = rowData.get("LOTA02");
			var LOTA11 = rowData.get("LOTA11");
			var SKUKEY = rowData.get("SKUKEY");
			var UOMKEY = rowData.get("UOMKEY");
			
			if(BARCOD==LOTA14){
				
				var QTYRCV = rowData.get("QTYRCV");
				var QTYRCV1 = rowData.get("QTYRCV1");
				
				var rowCheck = gridList.getSelectType(gridId, GRowNum);
				if(rowCheck){
					PlaySound('e');
					commonUtil.msgBox("MOBILE_M0030",null,null,function(){ $("#BARCOD").select(); }); // 이미 스캔한 바코드입니다.
					return;
				}else{
					
					var rsMap = getQtyuom(SKUKEY, UOMKEY, QTYRCV1);
					var UOMQTY = rsMap.get("UOMQTY");
					var BOX = rsMap.get("BOX");
					
					gridList.setColFocus(gridId, GRowNum, "QTYRCV");
					gridList.setColValue(gridId, GRowNum, "QTYRCV", QTYRCV1);
					gridList.setColValue(gridId, GRowNum, "BOX", BOX);
					gridList.setRowCheck(gridId, GRowNum, true);
					existsYN=true;
					$("#BARCOD").focus();
					
					var retLotaMap = getLotaInfo(LOTA02, SKUG01, LOTA11, BARCOD)
					var retLOTA11 = retLotaMap.get("LOTA11");
					gridList.setColValue(gridId, GRowNum, "LOTA11", retLOTA11);
					
					// 20220817 입고 오더 데이터 변경 VALIDATION
					var validationList = new Array();
					validationList.push(rowData);
					validationOrderGr02(validationList);
					
					return;
				}
				
			}
			
		}
		
		if(!existsYN){
			
			var gcnt = gridList.getGridDataCount(gridId);
			
			var totQTYRCV1 = $("#QTYRCV1").val().replace(/,/gi, "");
			//console.log("totQTYRCV1 : " + totQTYRCV1);
			//console.log("sumQty : " + sumQty);
			if(Number(totQTYRCV1) <= Number(sumQty)){
				PlaySound('e');
				commonUtil.msgBox("VALID_M2004",null,null,function(){ $("#BARCOD").select(); });	// 입고수량이 초과 하였습니다.
				return;
			}
			
			if(sumQty==undefined || isNaN(sumQty)){
				sumQty=0;
			}
			//console.log("sumQty : " + sumQty);

			if(gcnt==0){
				var LOTA02 = "<%=lota02%>";
		 		var LOTA11 = " ";
				getLotaInfoList(LOTA02, SKUG01, LOTA11, BARCOD, sumQty);
				gridList.setRowReadOnly(gridId, 0, false, ['LOTA14']);
				
				
			}else{
		 		
				var newData = new DataMap();
				
				var LOTA02 = "<%=lota02%>";
		 		var LOTA11 = " ";
		 		var retLotaMap = getLotaInfo(LOTA02, SKUG01, LOTA11, BARCOD);
		 		
		 		var mapData = retLotaMap.get("data");
		 		
		 		var SEBELN = mapData["SEBELN"];
				if(""==SEBELN){
					PlaySound('e');
					
					// 20221007 입고 완료된 바코드 여부  VALIDATION
					if(!validationCompleteBarcod("<%=ebeln%>", BARCOD)){
						return;
					}
					//commonUtil.msgBox("VALID_M2005",null,null,function(){ $("#BARCOD").select(); });	// 개별바코드가 없는 데이터가 없습니다.
					// 존재하지 않는 바코드[{0}] 입니다.
					commonUtil.msgBox("VALID_M2141",[BARCOD],null,function(){ $("#BARCOD").focus(); });
					return;
				}
				
				newData.putObject(structuredClone(mapData));
				
		 		var retLOTA11 = mapData["LOTA11"];
		 		var retPALQTY = mapData["PALQTY"];
		 		var retMUOMKEY = mapData["MUOMKEY"];
		 		var retUOMQTY = mapData["UOMQTY"];
				var retREUOMQTY = mapData["REUOMQTY"];
				var retBAUOMQTY = mapData["BAUOMQTY"];
				
		 		
		 		//console.log("retREUOMQTY : " + retREUOMQTY);
		 		var vQTYRCV = "";
		 		var QTYRCV1 = $("#QTYRCV1").val().replace(/,/gi, "");
		 		
		 		var dfQTYRCV = Number(QTYRCV1) - Number(sumQty);
		 		if(dfQTYRCV<0)dfQTYRCV=0;
		 		//console.log("retPALQTY : " + retPALQTY);
		 		//console.log("dfQTYRCV : " + dfQTYRCV);
		 		
		 		if(""!=retPALQTY && "0"!=retPALQTY){
		 			/*
		 			if( Number(dfQTYRCV)<Number(retBAUOMQTY) ){
			 			if(Number(retREUOMQTY)<Number(retBAUOMQTY)){
			 				vQTYRCV = retREUOMQTY;
			 			}else{
			 				vQTYRCV = dfQTYRCV;
			 			}
		 			}else{
		 				vQTYRCV = dfQTYRCV;
		 			}
		 			*/
		 			if(Number(dfQTYRCV)>Number(retREUOMQTY)){
		 				vQTYRCV = retREUOMQTY;
		 			}else{
		 				vQTYRCV = dfQTYRCV;
		 			}
		 			
		 		}else{
		 			vQTYRCV = dfQTYRCV;
		 			retPALQTY = QTYRCV1;
		 		}
		 		//console.log("vQTYRCV : " + vQTYRCV);
		 		if(vQTYRCV==undefined || isNaN(vQTYRCV)){
		 			vQTYRCV=0;
				}
		 		
		 		newData.put("QTYRCV", vQTYRCV);
				newData.put("QTYRCV1", vQTYRCV);
				
				newData.put("MUOMKEY", retMUOMKEY);
				newData.put("LOTA11", retLOTA11);
				newData.put("LOTA14", BARCOD);
		 		
				//var UOMQTY = getQtyuom("<%=skukey%>", $("#UOMKEY").val(), vQTYRCV);		 		
		 		var rsMap = getQtyuom("<%=skukey%>", $("#UOMKEY").val(), vQTYRCV);
				var UOMQTY = rsMap.get("UOMQTY");
				var BOX = rsMap.get("BOX");
		 		
		 		newData.put("UOMQTY", UOMQTY);
		 		newData.put("BOX", BOX);
		 		
		 		//newData.put("rowCheck", "V");
		 		//gridList.setRowCheck("gridList", rowNum, false);
		 		gridList.addNewRow("gridList",newData);
		 		
		 		var rowNum = gridList.getFocusRowNum("gridList");
		 		gridList.setRowCheck("gridList", rowNum, true);
		 		
			}
	 		
		}
		
		$("#BARCOD").select();
		PlaySound('s');
		
 	}
 	
	function getLotaInfo(I_LOTA02, I_SKUG01, I_LOTA11, I_BARCOD){
		
		var rsMap = new DataMap();
		
		var param = new DataMap();
		param.put("LOTA02", I_LOTA02);
		param.put("SKUG01", I_SKUG01);
		param.put("LOTA11", I_LOTA11);
		param.put("BARCOD", I_BARCOD);
		param.put("WAREKY", "<%= wareky%>");
		param.put("SKUKEY", "<%=skukey%>");
		
		param.put("WAREKY", "<%= wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("LANGKY", "<%=langky%>");
		param.put("PROGID", "<%=parMenuId%>");
		param.put("SEBELN", "<%=ebeln%>");
		param.put("LOTA01", "<%=lota01%>");
		param.put("LOTA06", "<%=lota06%>");
		param.put("BWART", "<%=bwart%>");
		param.put("RCPTTY", "<%=bwart%>");
		
		param.put("PTNRKY", "<%=ptnrky%>");
		param.put("PTNRTY", "<%=ptnrty%>");
		
		// 제조일자
		var json = netUtil.sendData({
			module : "WmsMobileInboundGoodsReceipt",
			command : "GET_LOTA_INFO",
			sendType : "list",
			param : param
		});
		//console.log("getLotaInfo : " + JSON.stringify(json));
		if (json.data){
			
			var palqty = json.data[0]["PALQTY"];
			var lota11 = json.data[0]["LOTA11"];
			var muomkey = json.data[0]["MUOMKEY"];
			
			rsMap.put("LOTA11", lota11);
			rsMap.put("PALQTY", palqty);
			rsMap.put("MUOMKEY", muomkey);
			rsMap.put("data", json.data[0]);
			
		}
		
		return rsMap;
		
	}
	
	function getLotaInfoList(I_LOTA02, I_SKUG01, I_LOTA11, I_BARCOD, I_SUMQTY){
		//console.log("I_SUMQTY : " + I_SUMQTY);
		var param = new DataMap();
		param.put("LOTA02", I_LOTA02);
		param.put("SKUG01", I_SKUG01);
		param.put("LOTA11", I_LOTA11);
		param.put("BARCOD", I_BARCOD);
		param.put("WAREKY", "<%= wareky%>");
		param.put("SKUKEY", "<%=skukey%>");
		
		param.put("WAREKY", "<%= wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("LANGKY", "<%=langky%>");
		param.put("PROGID", "<%=parMenuId%>");
		param.put("SEBELN", "<%=ebeln%>");
		param.put("LOTA01", "<%=lota01%>");
		param.put("LOTA06", "<%=lota06%>");
		param.put("BWART", "<%=bwart%>");
		
		param.put("PTNRKY", "<%=ptnrky%>");
		param.put("PTNRTY", "<%=ptnrty%>");
		
		var json = netUtil.sendData({
			module : "WmsMobileInboundGoodsReceipt",
			command : "GET_LOTA_INFO",
			sendType : "list",
			param : param
		});
		
		//console.log("getLotaInfoList : " + JSON.stringify(json));
		gridList.resetGrid("gridList");
		gridList.appendJson('gridList', json);
		
		if (json.data){
			
			var newData = new DataMap();
			newData = gridList.getRowData("gridList", 0);
			
			var PALQTY = json.data[0]["PALQTY"];
			var LOTA11 = json.data[0]["LOTA11"];
			var MUOMKEY = json.data[0]["MUOMKEY"];
			var UOMQTY = json.data[0]["UOMQTY"];
			var REUOMQTY = json.data[0]["REUOMQTY"];
			var BAUOMQTY = json.data[0]["BAUOMQTY"];
			
			var vQTYRCV = "";
			var QTYRCV1 = $("#QTYRCV1").val().replace(/,/gi, "");
	 		
	 		var dfQTYRCV = Number(QTYRCV1) - Number(I_SUMQTY);
	 		if(dfQTYRCV<0)dfQTYRCV=0;
	 		
	 		if(""!=PALQTY && "0"!=PALQTY){
	 			
	 			if(Number(dfQTYRCV)>Number(REUOMQTY)){
	 				vQTYRCV = REUOMQTY;
	 			}else{
	 				vQTYRCV = dfQTYRCV;
	 			}
	 			
	 		}else{
	 			vQTYRCV = QTYRCV1;
	 		}
	 		
	 		gridList.setColValue('gridList', 0, "QTYRCV", vQTYRCV);
	 		gridList.setColValue('gridList', 0, "QTYRCV1", vQTYRCV);
			gridList.setColValue('gridList', 0, "MUOMKEY", MUOMKEY);
			gridList.setColValue('gridList', 0, "LOTA11", LOTA11);
			gridList.setColValue('gridList', 0, "LOTA14", I_BARCOD);
	 		
	 		//var UOMQTY = getQtyuom("<%=skukey%>", $("#UOMKEY").val(), vQTYRCV);
	 		var rsMap = getQtyuom("<%=skukey%>", $("#UOMKEY").val(), vQTYRCV);
	 		//var rsMap = getQtyuom(SKUKEY, UOMKEY, vQTYRCV);
			var UOMQTY = rsMap.get("UOMQTY");
			var BOX = rsMap.get("BOX");
			
	 		gridList.setColValue('gridList', 0, "UOMQTY", UOMQTY);
	 		gridList.setColValue('gridList', 0, "BOX", BOX);
	 		
	 		gridList.setRowCheck('gridList', 0, true);
		}
		
		//gridList.setRowState('gridList', "C", 0);
	}
	
