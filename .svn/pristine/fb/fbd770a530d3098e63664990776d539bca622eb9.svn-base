	function closePop(){
 		
 		var list = gridList.getGridData("gridList");
 		var modifyCnt = gridList.getModifyRowCount("gridList"); 		
 		var checkCnt = gridList.getSelectData("gridList").length;
 		//console.log("closePop - list.length : " + list.length + " - modifyCnt : " + modifyCnt + " - checkCnt : " + checkCnt);
 		if( list.length>0 && (modifyCnt!=0 || checkCnt!=0) ){
 			
 			// 작업중인 내역이 존재합니다. 이전으로 돌아가시겠습니까?
 			commonUtil.msgConfirm("VALID_M2094", null
		            			, function(){
					 				var paramStr = "FLAG=N&EBELN=<%=ebeln%>&DOCDAT=<%=docdat%>&BARCOD=<%=barcod%>";
					 	 			location.href="/mobile/PDGR01.page?"+paramStr;	
 					  			  }
					 			, function(){
									  $("#BARCOD").focus();
								  }
 							
 			);
 			
 		}else{
 			var paramStr = "FLAG=N&EBELN=<%=ebeln%>&DOCDAT=<%=docdat%>&BARCOD=<%=barcod%>";
 			location.href="/mobile/PDGR01.page?"+paramStr;	
 		}
 		
 	}
 	
