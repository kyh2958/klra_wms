<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%
	
	String skukey = request.getParameter("SKUKEY");
	String lota01 = request.getParameter("LOTA01");
	String lota02 = request.getParameter("LOTA02");
	String lota06 = request.getParameter("LOTA06");
	String ebeln = request.getParameter("EBELN");
	String docdat = request.getParameter("DOCDAT");
	String parMenuId = request.getParameter("PAR_MENUID");
	String qtyrcv1 = request.getParameter("QTYRCV1");
	String barcod = request.getParameter("BARCOD");
	String bwart = request.getParameter("BWART");
	String ptnrky = request.getParameter("PTNRKY");
	String ptnrty = request.getParameter("PTNRTY");
	
%>
<!doctype html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width, target-densitydpi=medium-dpi" />
<meta name="format-detection" content="telephone=no" />
<title>WMS</title>

<style type="text/css">
.tem5_content .tableWrap_search select	{width:172px;  height:25px; }
.tem5_content .tableWrap_search .text_2{width:90%; margin-right:3px;height:22px;border:#b8b8b8;}

.select-editable { position:relative; background-color:white; border:solid 1px #b8b8b8; width:172px; height:25px; }
.select-editable select { top:0px; left:0px; width:172px; height:25px; font-size:14px;  border:none;  }
.select-editable input { position:absolute; top:0px; left:0px; width:90%; height:23px; font-size:12px;  border:none;   }
.select-editable select:focus, .select-editable input:focus { outline:none; }

.select-editable { position:relative; background-color:white; border:solid 1px #d5d5d5; width:100%; height:35px; }
.select-editable select { position:absolute; top:0px; left:0px; width:100%; height:35px; font-size:14px;  border:none;  }
.select-editable input { position:absolute; top:0px; left:0px; width:90%; height:33px; font-size:12px;  border:none;   }
.select-editable select:focus, .select-editable input:focus { outline:none; }

</style>

<%@ include file="/mobile/include/head.jsp" %>
<script>
	//var data = new DataMap();
// 	var QTYRCV1 = 0;
	var SKUG01 = "";
	
	$(document).ready(function(){
		
		gridList.setGrid({
	    	id : "gridList",
			editable : true,
			module : "WmsMobileInboundGoodsReceipt",
			command : "PDGR01_POP",
			gridMobileType : true,
			emptyMsgType : false
	    });
		
		setDetail();
		searchList();
		
		if($.trim("<%=barcod %>") != ""){
			setBarcod();
		}
		
		$("#BARCOD").focus();
	});
	
	function setDetail(){
		
		var param = new DataMap();
		param.put("WAREKY", "<%= wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("LANGKY", "<%=langky%>");
		param.put("PROGID", "<%=parMenuId%>");
		param.put("SKUKEY", "<%=skukey%>");
		param.put("LOTA01", "<%=lota01%>");
		param.put("MTYPE", "<%=mtype%>");
		param.put("LOTA06", "<%=lota06%>");
		param.put("SEBELN", "<%=ebeln%>");
		param.put("BWART", "<%=bwart%>");
		param.put("RCPTTY", "<%=bwart%>");
		/* 보노아 하드코딩을 위한 변수 추가*/
		param.put("DPTNKY", "<%=ptnrky%>");
		
		var json = netUtil.sendData({
			module : "WmsMobileInboundGoodsReceipt",
			command : "PDGR01_POP",
			sendType : "map",
			param : param
		});
		
		if(json.data){
			var SKUKEY = json.data["SKUKEY"]; 
			var SKUKEYNM = json.data["DESC01"];
			var MEINS = json.data["MEINS"];
			var QTYRCV1 = json.data["QTYRCV1"];
			SKUG01 = json.data["PTNL01"];
			
			var PRCPYN = json.data["PRCPYN"]; // 입고 가능한 입고 예정 정보 존재 유무 
			
			// 20220715 "10"으로 하드코딩 요청으로 하드코딩함.
			SKUG01 = "10";
			
			$("#SKUKEY").val(SKUKEY);
			$("#DESC01").val(SKUKEYNM);
			$("#UOMKEY").val(MEINS);
			$("#QTYRCV1").val(QTYRCV1);
			$("#QTYRCV1").trigger( "blur" );
			if(PRCPYN!= "Y"){
				gridList.resetGrid("gridList");
				closePop();
			}
			
		}else{
			//closePop();
			directClosePop();
		}
		
	}
	
	function searchList(){
		
		var param = new DataMap();
		param.put("WAREKY", "<%= wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("LANGKY", "<%=langky%>");
		param.put("PROGID", "<%=parMenuId%>");
		param.put("SKUKEY", "<%=skukey%>");
		param.put("LOTA01", "<%=lota01%>");
		param.put("MTYPE", "<%=mtype%>");
		param.put("LOTA06", "<%=lota06%>");
		param.put("SEBELN", "<%=ebeln%>");
		param.put("DOCDAT", "<%=docdat%>");
		param.put("BWART", "<%=bwart%>");
		param.put("RCPTTY", "<%=bwart%>");
		/* 보노아 하드코딩을 위한 변수 추가*/
		param.put("DPTNKY", "<%=ptnrky%>"); 
		/*
		gridList.gridList({
	    	id : "gridList",
	    	param : param
	    });
		*/
		
		var json = netUtil.sendData({
			module : "WmsMobileInboundGoodsReceipt",
			command : "PDGR01_POP",
			param : param
		});
		
		//console.log(JSON.stringify(json));
		gridList.resetGrid("gridList");
		gridList.appendJson('gridList', json);
		
	}
	
	function gridListEventDataBindEnd(gridId, dataLength, excelLoadType){
	 	if(gridId == "gridList" && dataLength > 0){
	 		
			var list = gridList.getGridData(gridId);
			for(var i=0; i < list.length; i++) {
				var rowData = list[i];
				var rowNum = list[i].get("GRowNum");
				var qtyrcv1 = list[i].get("QTYRCV1");				
				var tebeln = list[i].get("TEBELN");
				var bwart = list[i].get("BWART");
				
				if(qtyrcv1==undefined || isNaN(qtyrcv1)){
					qtyrcv1=0;
					gridList.setColValue(gridId, rowNum, "QTYRCV", qtyrcv1);
				}
				
				// 20221006 이송입고 출고지시서에서 가져온 물량은 수량 수정 불가 로직 추가 KJH
				if(bwart=="121" && tebeln!=undefined && $.trim(tebeln)!=""){
					gridList.setRowReadOnly(gridId, i, true, ['QTYRCV']);
				}
				
				gridList.setRowReadOnly(gridId, i, true, ['LOTA14']);
			}
			
			var rowCnt = gridList.getGridDataCount(gridId);
			if(rowCnt>0){
				PlaySound('s');
			}else{
				PlaySound('e');
			}
			
	 	}else{
	 		//PlaySound('e');
	 		//closePop();
	 	}
	}
	
 	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
 		
 		var today = new Date();
		var year = today.getFullYear();
	    var month = today.getMonth()+1;
	    var date = today.getDate();
	    if(month < 10){
	    	month = "0" + month;
	    }
	    if(date < 10){
	    	date = "0" + date;
	    }
		var sysdate = String(year) + String(month) + String(date);
		
 		if(gridId == "gridList" && colName == "LOTA11"&& colValue.trim() != ""){
 			var lota11 = gridList.getColData(gridId, rowNum, "LOTA11");
 			
	 	 	if(lota11 != ""){
				//제조일자 validation
				if(Number(lota11) > Number(sysdate)){
					PlaySound('e');
					commonUtil.msgBox("VALID_M1607",null,null
							          ,function(){  
											gridList.setColValue("gridList", rowNum, "LOTA11", " ");
											gridList.setColFocus("gridList", rowNum, "LOTA11");
					});	//제조일자는 오늘/과거일자만 입력 가능합니다.
					
					return;
				}
 			}
		}else if(gridId == "gridList" && colName == "LOTA13"&& colValue.trim() != ""){
			var lota13 = gridList.getColData(gridId, rowNum, "LOTA13");
	 	 	
	 	 	if(lota13 != ""){	
				//유통기한 validation
				if(lota13 <= sysdate){
					PlaySound('e');
					commonUtil.msgBox("VALID_M1606",null,null
									 ,function(){  
											gridList.setColValue("gridList", rowNum, "LOTA13", " ");
											gridList.setColFocus("gridList", rowNum, "LOTA13");
					});	//유통기한은 미래일자만 입력 가능합니다.
					
					return;
				}
			}
		}else if (gridId == "gridList" && colName == "QTYRCV") {
			
			var param = new DataMap();
			
			var SKUKEY = gridList.getColData("gridList", rowNum, "SKUKEY");
			var UOMKEY = gridList.getColData("gridList", rowNum, "UOMKEY");
			
			//var UOMQTY = getQtyuom(SKUKEY, UOMKEY, colValue);
			var rsMap = getQtyuom(SKUKEY, UOMKEY, colValue);
			var UOMQTY = rsMap.get("UOMQTY");
			var BOX = rsMap.get("BOX");
			gridList.setColValue(gridId, rowNum, "UOMQTY", UOMQTY);
			gridList.setColValue(gridId, rowNum, "BOX", BOX);
			
		}
 		
	}
 	
 	function getQtyuom(SKUKEY, UOMKEY, QTY){
 		
 		var param = new DataMap();
		
		param.put("WAREKY", "<%=wareky%>");
		param.put("SKUKEY", SKUKEY);
		param.put("UOMKEY", UOMKEY);
		param.put("QTY", QTY);
		
		var json = netUtil.sendData({
			module : "WmsInbound",
			command : "UOMQTYval",
			sendType : "map",
			param : param
		});
		
		var UOMQTY = json.data["UOMQTY"];
		var BOX = json.data["BOX"];
		
		var rsMap = new DataMap();
		rsMap.put("UOMQTY",UOMQTY);
		rsMap.put("BOX",BOX);
		
		return rsMap; 
 		
 	}
 	
	function saveData(){
		
		var param = new DataMap();
		
		var gridId = "gridList";
		
		var chkItemIdx = gridList.getSelectRowNumList("gridList");
		var chkItemLen = chkItemIdx.length;	
		
		var sumQty = 0;
		var qtyasn = $("#QTYRCV1").val();
		
		var imib02 = "";     // 즉시불출이아니며 WMS재고비관리대상 여부
        var imib02msg = "";  // 즉시불출이아니며 WMS재고비관리대상 여부 메세지
		
		var afStlky = $('#STLKY').val();    // 변경할 저장위치
// 		var afWmsmak = $('#WMSMAK').val();  // 변경할 저장위치의 wms 관리대상 여부
		
		if( chkItemLen == 0 ){
			PlaySound('e');
			commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
			return;
		}
		
		var chkItemList = gridList.getSelectData(gridId);
		for(var i=0; i < chkItemList.length; i++) {
			
			var rowData = chkItemList[i];
			var rowNum = chkItemList[i].get("GRowNum");
			
			var sebeln = chkItemList[i].get("SEBELN"); // 오더번호
			var sebelp = chkItemList[i].get("SEBELP"); // 오더아이템번호
			var seqno = chkItemList[i].get("SEQNO");  // 오더시퀀스키
			
			var lota14 = rowData.get("LOTA14");  // 개별바코드
			
			var menge = new Number(chkItemList[i].get("MENGE")); //오더수량
            var menge_r = new Number(chkItemList[i].get("MENGE_R")); //기입고수량
			
			var qtyrcv = chkItemList[i].get("QTYRCV");
			sumQty = Number(sumQty) + Number(qtyrcv);
			if(qtyrcv==0){
				var STD_QTYRCV = commonLabel.getLabel("STD_QTYRCV", 1);
				PlaySound('e');
				commonUtil.msgBox("VALID_required",[STD_QTYRCV],null,function(){ gridList.setColFocus("gridList", rowNum, "QTYRCV"); }); // {0} 은(는) 필수 입력항목입니다.
				return;
			}
			
			var lota11 = chkItemList[i].get("LOTA11");
			if($.trim(lota11)==""){
				var STD_LOTA11 = commonLabel.getLabel("STD_LOTA11", 1);
				PlaySound('e');
				commonUtil.msgBox("VALID_required",[STD_LOTA11],null,function(){ gridList.setColFocus("gridList", rowNum, "LOTA11"); } ); // {0} 은(는) 필수 입력항목입니다.
				return;
			}
			
			var lota14 = chkItemList[i].get("LOTA14");
			if($.trim(lota14)==""){
            	PlaySound('e');
            	commonUtil.msgBox("VALID_M2063",null,null,function(){ gridList.setColFocus("gridList", rowNum, "LOTA14"); } );// 개별바코드가 없는 문서가 존재하여 입고를 할 수 없습니다.
                return;
            }
			
			var bwart = chkItemList[i].get("BWART");
			var qtyrcv1 = chkItemList[i].get("QTYRCV1");
			var tebeln = chkItemList[i].get("TEBELN");
			
			if($.trim(tebeln)!="" && bwart=="121" && Number(qtyrcv1)!=Number(qtyrcv)){
            	PlaySound('e');
            	var STD_QTSTOK1 = commonLabel.getLabel("STD_QTSTOK1", 1);//입고가능수량
            	commonUtil.msgBox("VALID_M2130",[lota14,STD_QTSTOK1,qtyrcv1],null,function(){ gridList.setColFocus("gridList", rowNum, "QTYRCV"); });// [{0}]이송입고는 [{1}] 전체[{2}] 을 입고처리 해야 합니다.
                return;
			}
			
			if(bwart=="121" /*&& $.trim(tebeln)!=""*/){
                
				var tQtyRcvSum = 0;
				var tLota14DuplYn = false;
				for(var j=0;j<chkItemList.length;j++){
					var tRowData = chkItemList[j];
					var tRowNum = tRowData.get("GRowNum");
					var tSeqno = tRowData.get("SEQNO");  // 오더시퀀스키
					var tLota14 = tRowData.get("LOTA14");  // 개별바코드
					var tQtyrcv = new Number(tRowData.get("QTYRCV")); //입고수량
					if(seqno==tSeqno){
						tQtyRcvSum = tQtyRcvSum + tQtyrcv;
					}
					// 개별바코드 중복여부 확인
                	if(rowNum!=tRowNum && lota14==tLota14){
                		tLota14DuplYn = true;
                	}
					
				}
				
				if(tQtyRcvSum > menge){
					PlaySound('e');
					commonUtil.msgBox("VALID_M2131",[sebeln,sebelp,(menge),tQtyRcvSum],null,function(){ gridList.setColFocus(gridId, rowNum, "QTYRCV"); });   //[{0}][{1}]오더의 입고가능한 수량[{2}]을 넘겼습니다. 수량[{3}]을 확인해주세요.
					return;
				}
				
				// 20221012 오더순번 별 전량 입고 해야됨.
            	if(tQtyRcvSum != menge){
            		PlaySound('e');
            		commonUtil.msgBox("VALID_M2147",[sebeln,sebelp,(menge),tQtyRcvSum],null,function(){ gridList.setColFocus(gridId, rowNum, "QTYRCV"); });   // 이송입고 [{0}][{1}]오더는 오더 수량[{2}](을)를 전량 입고 하여야 합니다. 수량[{3}]을 확인해주세요.
                    return;
                }
            	// 20221012 개별바코드 중복여부 확인
            	/*
            	if(tLota14DuplYn==true){
            		PlaySound('e');
            		commonUtil.msgBox("VALID_M2148",[lota14],null,function(){ gridList.setColFocus(gridId, rowNum, "LOTA14"); });   // 중복된 개별바코드[{0}]가 있습니다. 확인해주세요.
                    return;
            	}
				*/
			}else{
				if(qtyrcv > (menge-menge_r)){
					PlaySound('e');
					commonUtil.msgBox("VALID_M2131",[sebeln,sebelp,(menge-menge_r),qtyrcv],null,function(){ gridList.setColFocus(gridId, rowNum, "QTYRCV"); });   //[{0}][{1}]오더의 입고가능한 수량[{2}]을 넘겼습니다. 수량[{3}]을 확인해주세요.
					return;
				}
			}
			
			var shtayn = chkItemList[i].get("SHTAYN"); // 즉시불출 여부
			var wmsmak = chkItemList[i].get("WMSMAK"); // WMS재고관리대상 여부
			var lota01 = chkItemList[i].get("LOTA01"); // 저장위치
			var lota02 = chkItemList[i].get("LOTA02"); // 저장위치
			
			if($.trim(afStlky)!=""){
				lota01 = afStlky;
				var wmDataMap = getWmsmak(afStlky, lota02);
				wmsmak = wmDataMap.get("WMSMAK");
				rowData.put("WMSMAK_AF",wmsmak);
			}else{
				var wmDataMap = getWmsmak(lota01, lota02);
				wmsmak = wmDataMap.get("WMSMAK");
				rowData.put("WMSMAK_AF",wmsmak);
			}
			
			if($.trim(wmsmak)==""){
				PlaySound('e');
				commonUtil.msgBox("VALID_M2110",[sebeln,lota01,lota02],null,function(){ gridList.setColFocus("gridList", rowNum, "rowCheck"); });// [{0}] 저장위치 [{1}]가(이) 플랜트 [{2}]에 없습니다.
                return;
			}
			
            if(shtayn=="V" && wmsmak=="V"){
            	PlaySound('e');
            	commonUtil.msgBox("VALID_M2105",[sebeln],null,function(){ gridList.setColFocus("gridList", rowNum, "rowCheck"); });// [{0}] 즉시불출이며, WMS재고대상 인 문서가 존재하여 입고를 할 수 없습니다.
                return;
            }
            
			if(shtayn!="V" && wmsmak!="V"){
            	var imib02Lota01 = chkItemList[i].get("IMIB02_LOTA01");
            	imib02 = chkItemList[i].get("IMIB02");
            	imib02msg = commonUtil.getMsg("VALID_M2106",[sebeln,lota01],null,function(){ gridList.setColFocus("gridList", rowNum, "rowCheck"); }); // [{0}] 저장위치[{1}] 즉시불출이 아니고, WMS재고대상 아닌 문서가 존재합니다. 진행하시겠습니까?
            }
			
		}
		if(sumQty > qtyasn){
			PlaySound('e');
			commonUtil.msgBox("VALID_M1722");	//"PDA로 초과입고 할 수 없습니다.
			return;
		}
		
		
		// 20220817 입고 오더 데이터 변경 VALIDATION
		if(!validationOrderGr02(chkItemList)){
			return;	
		}
		
		/*
		if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){
			return;
		}
		*/
		//alert("2 - headChkLen : " + headChkLen + "\ndblIdx : " + dblIdx + "\nsubIdx : " + subIdx);
		
		/*
		if(imib02==""){
            if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){
                return;
            }
		}else{
			// 즉시불출이아니며 WMS재고비관리대상 =>  [저장위치 : XXXX] WMS재고관리대상이 아닙니다. 계속 진행 하시겠습니까?
			if(!commonUtil.msgConfirm(imib02msg)){
                return;
            }
		}
		*/
		var confirmMsg = configData.MSG_MASTER_SAVE_CONFIRM;
		if(imib02!=""){
			// 즉시불출이아니며 WMS재고비관리대상 =>  [저장위치 : XXXX] WMS재고관리대상이 아닙니다. 계속 진행 하시겠습니까?
			confirmMsg = imib02msg;
		}
		
		// 저장하시겠습니까?
		commonUtil.msgConfirm(confirmMsg, null
				            , function(){
									
									// 저장위치 반영
									if($.trim(afStlky)!=""){
										for(var i=0; i < chkItemList.length; i++) {
											var rowData = chkItemList[i];
											rowData.put("LOTA01",afStlky);
											rowData.put("WMSMAK",rowData.get("WMSMAK_AF"));
										}
									}else{
										for(var i=0; i < chkItemList.length; i++) {
											var rowData = chkItemList[i];
											rowData.put("WMSMAK",rowData.get("WMSMAK_AF"));
										}
									}
									
									var headSebeln="<%=ebeln%>";
									var headList = getHeadList("<%=ebeln%>", "<%=bwart%>");
									
									param.put("OWNRKY", "<%=ownrky%>");
									param.put("headSebeln", headSebeln);
									param.put("head", headList);		
									param.put("list", chkItemList);
									param.put("PROGID", "PDGR01");
									
									var json = netUtil.sendData({
										//url : "/mobile/mobileInboundGoodsReceipt/json/SavePDGR01_POP.data",
										//url : "/wms/inbound/json/SaveGR02.data",
										url : "/wms/inbound/json/SaveGR02New.data",
										param : param
									});
									
									if(json.data && json.data.RESULTMSG ){
										PlaySound('e');
										var msgList = json.data.RESULTMSG.split("†");
										var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
										commonUtil.msg(msgTxt);
										return;
									}
									
									if(json && json.data){
										PlaySound('s');
										
										var inRsCode = json.data.inRsCode; // 입고저장 결과코드
							            var inRsMsg = json.data.inRsMsg;   // 입고저장 결과 메시지
										
										var ifRsCode = json.data.ifRsCode; // 인터페이스 전송 결과코드
							            var ifRsMsg = json.data.ifRsMsg;   // 인터페이스 전송 결과 메시지
							            
							            var totCnt = json.data.totCnt;     // 입고 전체 건수
							            var sucCnt = json.data.sucCnt;     // 입고 성공 건수
							            var failCnt = json.data.failCnt;   // 입고 실패 건수 
							            
							            //var sucList = json.data.sucList;   // 입고 성공 오더목록 ( 부분입고 여부 확인 불가 )
							            
							            console.log("전체 : " + totCnt + " - 성공 : " + sucCnt + " - 실패 : " + failCnt);
							            
							        	console.log("inRsCode : " + inRsCode);
							        	console.log("ifRsCode : " + ifRsCode);
							        	
							        	if(inRsCode != "S" && ifRsCode != "S"){
							        		console.log("inRsMsg : " + inRsMsg);
							        		console.log("ifRsMsg : " + ifRsMsg);
							        		//commonUtil.msgBox("VALID_M0950"); // 입고 저장에 실패하였습니다.
							        		//commonUtil.msgBox("VALID_M0953",[totCnt,sucCnt,failCnt]); // 저장 및 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
							        		var msgTxt = commonUtil.getMsg("VALID_M0953",[totCnt,sucCnt,failCnt]); // 저장 및 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
							        		alert(msgTxt + "\n" + inRsMsg + "" + ifRsMsg);
							        	}else if(inRsCode != "S"){
							            	console.log("inRsMsg : " + inRsMsg);
							            	//commonUtil.msgBox("VALID_M0950"); // 입고 저장에 실패하였습니다.
							            	//commonUtil.msgBox("VALID_M0951",[totCnt,sucCnt,failCnt]); // 입고 저장에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
							            	var msgTxt = commonUtil.getMsg("VALID_M0951",[totCnt,sucCnt,failCnt]); // 입고 저장에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
							            	alert(msgTxt + "\n" + inRsMsg);
							        	}else if(ifRsCode != "S"){
							            	console.log("ifRsMsg : " + ifRsMsg);
							            	//commonUtil.msgBox("VALID_M0942"); // 인터페이스 전송에 실패하였습니다.
							            	//commonUtil.msgBox("VALID_M0952",[totCnt,sucCnt,failCnt]); // 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
							            	var msgTxt = commonUtil.getMsg("VALID_M0952",[totCnt,sucCnt,failCnt]); // 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
							            	alert(msgTxt + "\n" + ifRsMsg);
							            }else{
							            	//commonUtil.msgBox("MASTER_M0564"); // 저장 완료되었습니다.
							            	commonUtil.msgBox("VALID_M0954",[totCnt,sucCnt,failCnt]); // 저장 완료되었습니다. 전체[{0}] 성공[{1}] 실패[{2}]
							            	
							            	setDetail();
							    			searchList();
							            }
							        	
							        	
									}else{
										PlaySound('e');
									}
			
							}
						  , function(){
							  $("#BARCOD").focus();
						  }
		);
		
		
	}
	
