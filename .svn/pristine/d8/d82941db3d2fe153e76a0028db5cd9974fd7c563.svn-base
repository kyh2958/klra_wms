/**
 * basic examples for Java to ABAP communication  
 */
public class RfcCallClient
{
	private static Logger log = Logger.getLogger(RfcCallClient.class);
	
	static String ABAP_AS = "ABAP_AS_WITHOUT_POOL";
    static String ABAP_AS_POOLED = "ABAP_AS_WITH_POOL_WMS";
//	static String ABAP_AS_POOLED = "SAP_SERVER"; //sap 연결명(연결파일명으로 사용됨)
//	static String ABAP_AS_POOLED = "cvkcepvpap01p"; //sap 연결명(연결파일명으로 사용됨)
//	static String ABAP_AS_POOLED = "CEP";  //sap 연결명(연결파일명으로 사용됨)
    
    private void main(DataMap baseMap)
    {
        Properties connectProperties = new Properties();	// 연결프로퍼티 생성
        connectProperties.setProperty(DestinationDataProvider.JCO_ASHOST, baseMap.getString(DestinationDataProvider.JCO_ASHOST));	 // SAP 호스트 정보
        connectProperties.setProperty(DestinationDataProvider.JCO_SYSNR,  baseMap.getString(DestinationDataProvider.JCO_SYSNR));	 // 인스턴스번호
//        connectProperties.setProperty(CommonConfig.SAP_JCO_SYSID,  		  baseMap.getString(CommonConfig.SAP_JCO_SYSID));	 
        connectProperties.setProperty("jco.client.sysid",  		  baseMap.getString("jco.client.sysid"));	 
        
        connectProperties.setProperty(DestinationDataProvider.JCO_CLIENT, baseMap.getString(DestinationDataProvider.JCO_CLIENT));	 // SAP 클라이언트
        connectProperties.setProperty(DestinationDataProvider.JCO_USER,   baseMap.getString(DestinationDataProvider.JCO_USER));	 // SAP유저명
        connectProperties.setProperty(DestinationDataProvider.JCO_PASSWD, baseMap.getString(DestinationDataProvider.JCO_PASSWD));	 // SAP 패스워드
        connectProperties.setProperty(DestinationDataProvider.JCO_LANG,   baseMap.getString(DestinationDataProvider.JCO_LANG));  // 언어
        
//    	connectProperties.setProperty(DestinationDataProvider.JCO_POOL_CAPACITY, jcoProperties.getProperty("sap.pool.capacity"));
//    	connectProperties.setProperty(DestinationDataProvider.JCO_PEAK_LIMIT, jcoProperties.getProperty("sap.pool.limit"));
//    	connectProperties.setProperty(DestinationDataProvider.JCO_POOL_CAPACITY, "1");
//    	connectProperties.setProperty(DestinationDataProvider.JCO_PEAK_LIMIT, "2");
        
        createDestinationDataFile(ABAP_AS_POOLED, connectProperties);        
    }
    
    //sap 연결파일 생성
    private void createDestinationDataFile(String destinationName, Properties connectProperties)
    {
        File destCfg = new File(destinationName+".jcoDestination");
        try
        {
            FileOutputStream fos = new FileOutputStream(destCfg, false);
            connectProperties.store(fos, "for tests only !");
            fos.close();
        }
        catch (Exception e)
        {
            throw new RuntimeException("Unable to create the destination files", e);
        }
    }
    
    /**
     * map 형태로 넘어온 데이터를 처리한다. 결과값 table 형식
     * @param map
     * @return 
     * @throws JCoException
     */
    /*
     * 순서
     * 1. IF_NAME [function name 설정]
     * 2. paramlist 안에  [FLAG 값 셋팅]
     * 3. IF_RETBL 수신받을 값 [table name 설정]
     * 4. table list에 [SECNO 소분류 번호 설정]
     * 5. 결과값 returnList
     */
    @SuppressWarnings("finally")
	public List<DataMap> flagToTableInbound(DataMap basemap, DataMap map) throws JCoException
    {
    	main(basemap);
    	
    	List<DataMap> returnList = new ArrayList();
    	
    	JCoDestination destination = JCoDestinationManager.getDestination(ABAP_AS_POOLED);
    	
        // ... it always has a reference to a metadata repository
        JCoFunction function = destination.getRepository().getFunction(basemap.getString("IF_NAME"));
    
        if(function == null)
            throw new RuntimeException("FUNCTION not found in SAP.");
       // List<HashMap> list = new ArrayList();
	   // HashMap paramMap = new HashMap();
	    
        try
        {
	    	JCoParameterList paramlist = function.getImportParameterList();
	    	if(paramlist != null){
	    		Iterator keys = map.keySet().iterator();
	    		String key = "";
	    		while(keys.hasNext()){
	    			key = (String) keys.next();
	    			paramlist.setValue(key, map.get(key));
	    		}
	    	}
	    
            //execute, i.e. send the function to the ABAP system addressed 
            //by the specified destination, which then returns the function result.
            //All necessary conversions between Java and ABAP data types
            //are done automatically.
            function.execute(destination);
        }
        catch(AbapException e)
        {
        	return returnList;
        }
        
        try 
        {
	        JCoTable returnTable = function.getTableParameterList().getTable(basemap.getString("IF_RETBL"));
			
	        int rfcRowNum = returnTable.getNumRows();
//	        int rfcRowNum = 1;
			for(int j = 0; j < rfcRowNum; j++){
				DataMap returnMap = new DataMap();
//				returnTable.firstRow();
				JCoFieldIterator jrfit = returnTable.getFieldIterator();
				JCoField jField = null;
				while(jrfit.hasNextField()){
					jField = jrfit.nextField();
					returnMap.put(jField.getName(), jField.getValue());
				}
				
				returnMap.put("SECNO", j + 1); // 소분류 번호 설정
				returnList.add(j, returnMap);
//				returnTable.deleteRow(0);
				returnTable.nextRow();
			}

			////log.debug("[수신결과] "+rfcRowNum+"건 : "+returnList);
        } 
        catch (Exception e) {
        	DataMap returnMap = new DataMap();
			e.printStackTrace();
			returnMap.put("ERRMSG", e.toString());
			returnList.add(0, returnMap);
		}
        finally
        {
        	return returnList;
		}
    }
    
    /**
     * SAP 재고 수신
     * @param map
     * @return 
     * @throws JCoException
     */
	@SuppressWarnings("finally")
	public DataMap rfcCallTableSapStock(String pWekrs, DataMap basemap, DataMap map) throws JCoException {
		main(basemap);
		
		JCoDestination destination = JCoDestinationManager.getDestination(ABAP_AS_POOLED);
		
		JCoFunction function = destination.getRepository().getFunction(basemap.getString("RFC_NM"));
		
		if (function == null) {
			throw new RuntimeException("FUNCTION not found in SAP.");
		}
		
		DataMap res = new DataMap();
		
		try {
			JCoParameterList paramlist = function.getImportParameterList();
			if (paramlist != null) {
				Iterator keys = map.keySet().iterator();
				String key = "";
				while (keys.hasNext()) {
					key = (String) keys.next();
					paramlist.setValue(key, map.get(key));
				}
			}
			
			// 수신받을 플랜트 지정
			JCoTable table = function.getTableParameterList().getTable("IT_WERKS");
			table.appendRow();
			table.setValue("WERKS", pWekrs);
			
//			for (DataMap data : list) {
//				data = data.getMap("map");
//				
//				table.appendRow();
//				Iterator listkeys = data.keySet().iterator();
//				String listkey = "";
//				while (listkeys.hasNext()) {
//					listkey = (String) listkeys.next();
//					table.setValue(listkey, data.get(listkey));
//				}
//			}

			function.execute(destination);
			
			JCoTable returnHead = function.getTableParameterList().getTable("ET_DATA");

			JCoFieldIterator jcoIter = null;
			JCoField jField = null;
			DataMap returnMap = null;
			
			List<DataMap> rcvData = new ArrayList<>();
			int headSize = returnHead.getNumRows();
			for (int i = 0; i < headSize; i++) {
				returnMap = new DataMap();
				jcoIter = returnHead.getFieldIterator();
				
				while (jcoIter.hasNextField()) {
					jField = jcoIter.nextField();
					returnMap.put(jField.getName(), jField.getValue());
				}
				
				returnMap.put("SECNO", i + 1); // 소분류 번호 설정
				rcvData.add(i, returnMap);
				returnHead.nextRow();
			}
			
			res.put("ET_DATA" , rcvData);
			
		} catch (Exception e) {
			e.printStackTrace();
			res.put("ERRMSG", e.toString());
		} finally {
			return res;
		}
	}
	
    /**
     * 실적전송건 취소
     * @param map
     * @return 
     * @throws JCoException
     */
	@SuppressWarnings("finally")
	public DataMap rfcCancel(List<DataMap> list, DataMap basemap, DataMap map) throws JCoException {
		main(basemap);
		
		JCoDestination destination = JCoDestinationManager.getDestination(ABAP_AS_POOLED);
		
		JCoFunction function = destination.getRepository().getFunction(basemap.getString("RFC_NM"));
		
		if (function == null) {
			throw new RuntimeException("FUNCTION not found in SAP.");
		}
		
		DataMap res = new DataMap();
		
		try {
			JCoParameterList paramlist = function.getImportParameterList();
			if (paramlist != null) {
				Iterator keys = map.keySet().iterator();
				String key = "";
				while (keys.hasNext()) {
					key = (String) keys.next();
					paramlist.setValue(key, map.get(key));
				}
			}
			
			JCoTable table = function.getTableParameterList().getTable("T_INDATA");
			for (DataMap data : list) {
				data = data.getMap("map");
				
				table.appendRow();
				Iterator listkeys = data.keySet().iterator();
				String listkey = "";
				while (listkeys.hasNext()) {
					listkey = (String) listkeys.next();
					table.setValue(listkey, data.get(listkey));
				}
			}

			function.execute(destination);
			
			JCoTable returnHead = function.getTableParameterList().getTable("O_RETURN");
			
			////log.debug("###########################################################");
			////log.debug("rfcCancel.returnHead : " + returnHead);
			////log.debug("###########################################################");
			
			JCoFieldIterator jcoIter = null;
			JCoField jField = null;
			DataMap returnMap = null;
			
			List<DataMap> headList = new ArrayList<>();
			int headSize = returnHead.getNumRows();
			for (int i = 0; i < headSize; i++) {
				returnMap = new DataMap();
				jcoIter = returnHead.getFieldIterator();
				
				while (jcoIter.hasNextField()) {
					jField = jcoIter.nextField();
					returnMap.put(jField.getName(), jField.getValue());
				}
				
				returnMap.put("SECNO", i + 1); // 소분류 번호 설정
				headList.add(i, returnMap);
				returnHead.nextRow();
			}
			
			
			/********************************************************************************************
			 * 20220809 수입밀롤 RFC 추가 호출을 위해 Z_WMS_DELIVERY_CANCEL MCDATA 객체 파싱 후 Z_WMS_MR_DELIVERY_CANCEL 추가 호출 - START
			 ********************************************************************************************/
			List<DataMap> mcDataList = new ArrayList<>();
			
			JCoListMetaData jcoListMetaData = function.getFunctionTemplate().getTableParameterList();
			//JCoParameterList jcoTableList = function.getTableParameterList();
			
			boolean mcDataYn = false;
			int mcDataSize = 0;
			/*
			for(int i=0;i<jcoTableList.getFieldCount();i++) {
				JCoTable jcoTable = jcoTableList.getTable(i);
				JCoRecordMetaData jmt = jcoTable.getRecordMetaData();
				String tableNm = jmt.getName();
				////log.debug("tableNm : " + tableNm);
				if(tableNm!=null && "ZLES614".equals(tableNm)) {
					mcDataYn=true;
				}				
			}
			*/
			for(int i=0;i<jcoListMetaData.getFieldCount();i++) {
				String tableNm = jcoListMetaData.getName(i);
				if(tableNm!=null && "O_MCDATA".equals(tableNm)) {
					mcDataYn=true;
				}				
			}
			
			if(mcDataYn) {
				JCoFieldIterator mcJcoIter = null;
				JCoField mcJField = null;
				DataMap returnMcMap = null;
				
				JCoTable returnMcdata = function.getTableParameterList().getTable("O_MCDATA");
				
				////log.debug("###########################################################");
				////log.debug("rfcCancel.returnMcdata : " + returnMcdata);
				////log.debug("###########################################################");
				
				mcDataSize = returnMcdata.getNumRows();
				for (int i = 0; i < mcDataSize; i++) {
					returnMcMap = new DataMap();
					mcJcoIter = returnMcdata.getFieldIterator();
					
					while (mcJcoIter.hasNextField()) {
						mcJField = mcJcoIter.nextField();
						returnMcMap.put(mcJField.getName(), mcJField.getValue());
					}
					
					returnMcMap.put("SECNO", i + 1); // 소분류 번호 설정
					mcDataList.add(i, returnMcMap);
					returnMcdata.nextRow();
				}
			}
			/********************************************************************************************
			 * 20220809 수입밀롤 RFC 추가 호출을 위해 Z_WMS_DELIVERY_CANCEL MCDATA 객체 파싱 후 Z_WMS_MR_DELIVERY_CANCEL 추가 호출 - END
			 ********************************************************************************************/
			
			////log.debug("paramlist::"+paramlist);
			////log.debug("table::"+table);
			
			////log.debug("[수신결과 head] " + headSize + "건");
			////log.debug("[수신결과 headList] " + headList + "건");
			
			////log.debug("[수신결과 밀롤 추가 MCDATA size] " + mcDataSize + "건");
			////log.debug("[수신결과 밀롤 추가 MCDATA List] " + mcDataList );
			
			res.put("head" , headList);
			res.put("mcDataList" , mcDataList);
			
		} catch (Exception e) {
			e.printStackTrace();
			res.put("ERRMSG", e.toString());
		} finally {
			return res;
		}
	}
	
	
	/**
     * 20220809 수입밀롤 RFC 추가 호출을 위해 Z_WMS_DELIVERY_CANCEL MCDATA 객체 파싱 후 Z_WMS_MR_DELIVERY_CANCEL 추가 호출
     * 입력 테이블 T_INDATA > I_INDATA 변경됨.
     * @param map
     * @return 
     * @throws JCoException
     */
	@SuppressWarnings("finally")
	public DataMap rfcMrCancel(List<DataMap> list, DataMap basemap, DataMap map) throws JCoException {
		main(basemap);
		
		JCoDestination destination = JCoDestinationManager.getDestination(ABAP_AS_POOLED);
		
		JCoFunction function = destination.getRepository().getFunction(basemap.getString("RFC_NM"));
		
		if (function == null) {
			throw new RuntimeException("FUNCTION not found in SAP.");
		}
		
		DataMap res = new DataMap();
		
		try {
			JCoParameterList paramlist = function.getImportParameterList();
			if (paramlist != null) {
				Iterator keys = map.keySet().iterator();
				String key = "";
				while (keys.hasNext()) {
					key = (String) keys.next();
					paramlist.setValue(key, map.get(key));
				}
			}
			
			
			JCoListMetaData jcoListMetaData = function.getFunctionTemplate().getTableParameterList();
			for(int i=0;i<jcoListMetaData.getFieldCount();i++) {
				String tableNm = jcoListMetaData.getName(i);
				////log.debug("rfcCancel input tableNm : " + tableNm);				
			}
			
			JCoTable table = function.getTableParameterList().getTable("I_INDATA");
			for (DataMap data : list) {
				data = data.getMap("map");
				
				table.appendRow();
				Iterator listkeys = data.keySet().iterator();
				String listkey = "";
				while (listkeys.hasNext()) {
					listkey = (String) listkeys.next();
					table.setValue(listkey, data.get(listkey));
				}
			}

			function.execute(destination);
			
			JCoTable returnHead = function.getTableParameterList().getTable("O_RETURN");
			
			////log.debug("###########################################################");
			////log.debug("rfcCancel.returnHead : " + returnHead);
			////log.debug("###########################################################");
			
			JCoFieldIterator jcoIter = null;
			JCoField jField = null;
			DataMap returnMap = null;
			
			List<DataMap> headList = new ArrayList<>();
			int headSize = returnHead.getNumRows();
			for (int i = 0; i < headSize; i++) {
				returnMap = new DataMap();
				jcoIter = returnHead.getFieldIterator();
				
				while (jcoIter.hasNextField()) {
					jField = jcoIter.nextField();
					returnMap.put(jField.getName(), jField.getValue());
				}
				
				returnMap.put("SECNO", i + 1); // 소분류 번호 설정
				headList.add(i, returnMap);
				returnHead.nextRow();
			}
			
			
			////log.debug("paramlist::"+paramlist);
			////log.debug("table::"+table);
			
			////log.debug("[수신결과 head] " + headSize + "건");
			////log.debug("[수신결과 headList] " + headList + "건");
			
			res.put("head" , headList);
			
		} catch (Exception e) {
			e.printStackTrace();
			res.put("ERRMSG", e.toString());
		} finally {
			return res;
		}
	}
	
    /**
     * [DL08] 출고 완료 - 거래명세서 출력
     * @param map
     * @return 
     * @throws JCoException
     */
    /*
     * 순서
     * 1. IF_NAME [function name 설정]
     * 2. paramlist 안에  [FLAG 값 셋팅]
     * 3. IF_RETBL 수신받을 값 [table name 설정]
     * 4. table list에 [SECNO 소분류 번호 설정]
     * 5. 결과값 returnList
     */
	@SuppressWarnings("finally")
	public DataMap flagToTableDL08(List<DataMap> list, DataMap basemap, DataMap map) throws JCoException {
		main(basemap);
		
		JCoDestination destination = JCoDestinationManager.getDestination(ABAP_AS_POOLED);
		
		// ... it always has a reference to a metadata repository
		JCoFunction function = destination.getRepository().getFunction(basemap.getString("IF_NAME"));
		
		if (function == null) {
			throw new RuntimeException("FUNCTION not found in SAP.");
		}
		
		DataMap res = new DataMap();
		
		try {
			JCoParameterList paramlist = function.getImportParameterList();
			if (paramlist != null) {
				Iterator keys = map.keySet().iterator();
				String key = "";
				while (keys.hasNext()) {
					key = (String) keys.next();
					paramlist.setValue(key, map.get(key));
				}
			}
			
			JCoTable table = function.getTableParameterList().getTable("I_INDATA");
			for (DataMap data : list) {
				data = data.getMap("map");
				
				table.appendRow();
				Iterator listkeys = data.keySet().iterator();
				String listkey = "";
				while (listkeys.hasNext()) {
					listkey = (String) listkeys.next();
					table.setValue(listkey, data.get(listkey));
				}
			}
			
			// execute, i.e. send the function to the ABAP system addressed
			// by the specified destination, which then returns the function result.
			// All necessary conversions between Java and ABAP data types
			// are done automatically.
			function.execute(destination);
			
			JCoTable returnHead = function.getTableParameterList().getTable("O_HEAD");
			JCoTable returnItem = function.getTableParameterList().getTable("O_ITEM");
			JCoTable returnInfo = function.getTableParameterList().getTable("O_ITEM_INFO");
			
			JCoFieldIterator jcoIter = null;
			JCoField jField = null;
			DataMap returnMap = null;
			
			List<DataMap> headList = new ArrayList<>();
			int headSize = returnHead.getNumRows();
			for (int i = 0; i < headSize; i++) {
				returnMap = new DataMap();
				jcoIter = returnHead.getFieldIterator();
				
				while (jcoIter.hasNextField()) {
					jField = jcoIter.nextField();
					returnMap.put(jField.getName(), jField.getValue());
				}
				
				returnMap.put("SECNO", i + 1); // 소분류 번호 설정
				headList.add(i, returnMap);
				returnHead.nextRow();
			}
			
			List<DataMap> itemList = new ArrayList<>();
			int itemSize = returnItem.getNumRows();
			for (int i = 0; i < itemSize; i++) {
				returnMap = new DataMap();
				jcoIter = returnItem.getFieldIterator();
				
				while (jcoIter.hasNextField()) {
					jField = jcoIter.nextField();
					returnMap.put(jField.getName(), jField.getValue());
				}
				
				returnMap.put("SECNO", i + 1); // 소분류 번호 설정
				itemList.add(i, returnMap);
				returnItem.nextRow();
			}
			
			List<DataMap> infoList = new ArrayList<>();
			int infoSize = returnInfo.getNumRows();
			for (int i = 0; i < infoSize; i++) {
				returnMap = new DataMap();
				jcoIter = returnInfo.getFieldIterator();
				
				while (jcoIter.hasNextField()) {
					jField = jcoIter.nextField();
					returnMap.put(jField.getName(), jField.getValue());
				}
				
				returnMap.put("SECNO", i + 1); // 소분류 번호 설정
				infoList.add(i, returnMap);
				returnInfo.nextRow();
			}
			
			////log.debug("[수신결과 head] " + headSize + "건");
			////log.debug("[수신결과 item] " + itemSize + "건");
			////log.debug("[수신결과 info] " + infoSize + "건");
			
			res.put("head" , headList);
			res.put("item" , itemList);
			res.put("info" , infoList);
		} catch (Exception e) {
			e.printStackTrace();
			res.put("ERRMSG", e.toString());
		} finally {
			return res;
		}
	}
    
    /**
     * SAP 호출후 수신데이터 처리가 정상처리되면 그 결과를 SAP에 송신
     * @param map
     * @return 
     * @throws JCoException
     */
    @SuppressWarnings("finally")
	public List<DataMap> flagToTableInboundRTN(DataMap basemap, DataMap map) throws JCoException
    {
    	main(basemap);
    	
    	List<DataMap> returnList = new ArrayList();
    	
    	JCoDestination destination = JCoDestinationManager.getDestination(ABAP_AS_POOLED);
    	
        JCoFunction function = destination.getRepository().getFunction(basemap.getString("IF_NAME"));
    
        if(function == null)
            throw new RuntimeException("FUNCTION not found in SAP.");
	    
        try
        {
	    	JCoParameterList paramlist = function.getImportParameterList();
	    	if(paramlist != null){
	    		Iterator keys = map.keySet().iterator();
	    		String key = "";
	    		while(keys.hasNext()){
	    			key = (String) keys.next();
	    			paramlist.setValue(key, map.get(key));
	    		}
	    	}
	    
            function.execute(destination);
        }
        catch(AbapException e)
        {
        	return returnList;
        }
        
        try 
        {
//	        JCoStructure returnStructure = function.getExportParameterList().getStructure("E_RETURN");
	        
        	JCoParameterList returnStructure = function.getExportParameterList();

        	DataMap returnMapStr = new DataMap();
        	JCoFieldIterator jrfitStr = returnStructure.getFieldIterator();
        	JCoField jFieldStr = null;
        	while(jrfitStr.hasNextField()){
        		jFieldStr = jrfitStr.nextField();
        		returnMapStr.put(jFieldStr.getName(), jFieldStr.getValue());
			}
        	
        	returnList.add(0, returnMapStr);
        } 
        catch (Exception e) {
        	DataMap returnMap = new DataMap();
			e.printStackTrace();
			returnMap.put("ERRMSG", e.toString());
			returnList.add(0, returnMap);
		}
        finally
        {
        	return returnList;
		}
    }
    
    /**
     * map 형태로 넘어온 데이터를 처리한다. 결과값 table 형식
     * @param map
     * @return 
     * @throws JCoException
     */
    /*
     * 순서
     * 1. IF_NAME [function name 설정]
     * 2. paramlist 안에  [FLAG 값 셋팅]
     * 3. IF_RETBL 수신받을 값 [table name 설정]
     * 4. table list에 [SECNO 소분류 번호 설정]
     * 5. 결과값 returnList
     */
    @SuppressWarnings("finally")
	public DataMap flagToTableInboundMulti(DataMap basemap, DataMap map) throws JCoException
    {
    	main(basemap);
    	
    	List<DataMap> returnList = new ArrayList();
    	List<DataMap> returnList2 = new ArrayList();
    	
    	DataMap resultMap = new DataMap();
    	
    	JCoDestination destination = JCoDestinationManager.getDestination(ABAP_AS_POOLED);
    	
        JCoFunction function = destination.getRepository().getFunction(basemap.getString("IF_NAME"));
    
        if(function == null)
            throw new RuntimeException("FUNCTION not found in SAP.");

        try
        {
	    	JCoParameterList paramlist = function.getImportParameterList();
	    	if(paramlist != null){
	    		Iterator keys = map.keySet().iterator();
	    		String key = "";
	    		while(keys.hasNext()){
	    			key = (String) keys.next();
	    			paramlist.setValue(key, map.get(key));
	    		}
	    	}
	    
            function.execute(destination);
        }
        catch(AbapException e)
        {
        	return resultMap;
        }
        
        try 
        {
	        JCoTable returnTable = function.getTableParameterList().getTable(basemap.getString("IF_RETBL"));
			
	        int rfcRowNum = returnTable.getNumRows();

			DataMap returnMap = new DataMap();
			JCoFieldIterator jrfit = null;
			JCoField jField = null;
	        for(int j = 0; j < rfcRowNum; j++){
//				returnTable.firstRow();
	        	returnMap = new DataMap();
				jrfit = returnTable.getFieldIterator();
				while(jrfit.hasNextField()){
					jField = jrfit.nextField();
					returnMap.put(jField.getName(), jField.getValue());
				}
				
				returnMap.put("SECNO", j + 1); // 소분류 번호 설정
				returnList.add(j, returnMap);
//				returnTable.deleteRow(0);
				returnTable.nextRow();
//				////log.debug(j);
			}
        	resultMap.put(basemap.getString("IF_RETBL"),returnList);
        	returnTable.clear();

	        ////log.debug("품목 수신건수 : "+returnList.size());
	        
			JCoTable returnTable2 = function.getTableParameterList().getTable(basemap.getString("IF_RETBL2"));
			
	        int rfcRowNum2 = returnTable2.getNumRows();

			DataMap returnMap2 = new DataMap();
			JCoFieldIterator jrfit2 = null;
			JCoField jField2 = null;
	        for(int j2 = 0; j2 < rfcRowNum2; j2++){
				returnTable2.firstRow();
	        	returnMap2 = new DataMap();
				jrfit2 = returnTable2.getFieldIterator();
				while(jrfit2.hasNextField()){
					jField2 = jrfit2.nextField();
					returnMap2.put(jField2.getName(), jField2.getValue());
				}
				
				returnMap2.put("SECNO", j2 + 1); // 소분류 번호 설정
				returnList2.add(j2, returnMap2);
				returnTable2.deleteRow(0);
//				returnTable2.nextRow();
//				////log.debug(j2);
			}
        	////log.debug("단위구성 수신건수1 : "+returnList2.size());
//        	returnTable2.clear();
        	resultMap.put(basemap.getString("IF_RETBL2"),returnList2);

        	////log.debug("단위구성 수신건수2 : "+returnList2.size());

//        	////log.debug("\n[수신결과 "+basemap.getString("IF_RETBL") +"] "+rfcRowNum +"건 : "+returnList);
//        	////log.debug("\n[수신결과 "+basemap.getString("IF_RETBL2")+"] "+rfcRowNum2+"건 : "+returnList2);

        } 
        catch (Exception e) {
			e.printStackTrace();
			resultMap.put("ERRMSG", e.toString());
		}
        finally
        {
        	return resultMap;
		}
    }
    
