//        	if (returnMapStr.getString("REP_FLAG").equals("E")){
        		
        		// 리턴받을 Table 명 설정
        		JCoTable returnTable = function.getTableParameterList().getTable(map.getString("IF_RESTR"));
//        		JCoTable returnTable = function.getTableParameterList().getTable("O_RETURN");
