	public DataMap callZ_MM_ROH2_GR_FROM_PDA(DataMap baseMap, DataMap importMap)
	        throws JCoException {

	    // 1. Destination 등록 (중요)
	    main(baseMap);

	    DataMap result = new DataMap();

	    // 2. Destination 획득 (POOL 기반)
	    JCoDestination destination =
	            JCoDestinationManager.getDestination(ABAP_AS_POOLED);

	    // 3. RFC Function
	    JCoFunction function =
	            destination.getRepository()
	                       .getFunction(baseMap.getString("IF_NAME"));

	    if (function == null) {
	        throw new RuntimeException(
	            "FUNCTION not found : " + baseMap.getString("IF_NAME")
	        );
	    }

	    /* ===============================
	     * 4. IMPORT 파라미터 세팅
	     * =============================== */
	    JCoParameterList imports = function.getImportParameterList();
	    if (imports != null && importMap != null) {
	        for (Object keyObj : importMap.keySet()) {
	            String key = (String) keyObj;
	            imports.setValue(key, importMap.get(key));
	        }
	    }

	    /* ===============================
	     * 5. RFC 실행
	     * =============================== */
	    function.execute(destination);

	    /* ===============================
	     * 6. EXPORT 파라미터 수신
	     * =============================== */
	    JCoParameterList exports = function.getExportParameterList();
	    if (exports != null) {
	        for (JCoField field : exports) {
	            result.put(field.getName(), field.getValue());
	        }
	    }

	    return result;
	}
	
	// 종이자원 출고 RFC
	public DataMap callZ_MM_ROH2_GI_FROM_PDA(DataMap baseMap, DataMap importMap, List<DataMap> itemList) throws JCoException {

	    main(baseMap);

	    DataMap result = new DataMap();
	    List<DataMap> returnList = new ArrayList<>();

	    JCoDestination destination =
	            JCoDestinationManager.getDestination(ABAP_AS_POOLED);

	    JCoFunction function =
	            destination.getRepository()
	                       .getFunction("Z_MM_ROH2_GI_FROM_PDA");

	    if (function == null) {
	        throw new RuntimeException("FUNCTION not found : Z_MM_ROH2_GI_FROM_PDA");
	    }

	    /* =========================
	     * 1. IMPORT 세팅
	     * ========================= */
	    JCoParameterList imports = function.getImportParameterList();

	    if (imports != null && importMap != null) {
	        for (Object keyObj : importMap.keySet()) {
	            String key = (String) keyObj;
	            imports.setValue(key, importMap.get(key));
	        }
	    }

	    /* =========================
	     * 2. I_TABLE 세팅
	     * ========================= */
	    if (itemList != null && !itemList.isEmpty()) {

	        JCoTable inputTable =
	                function.getTableParameterList().getTable("I_TABLE");

	        for (DataMap row : itemList) {
	            inputTable.appendRow();

	            for (Object keyObj : row.keySet()) {
	                String key = (String) keyObj;
	                inputTable.setValue(key, row.get(key));
	            }
	        }
	    }

	    /* =========================
	     * 3. RFC 실행
	     * ========================= */
	    function.execute(destination);

	    /* =========================
	     * 4. O_RETURN 분석
	     * ========================= */
	    JCoTable returnTable =
	            function.getTableParameterList().getTable("O_RETURN");

	    boolean isError = false;
	    StringBuilder msgBuilder = new StringBuilder();
	    String successDoc = null;

	    int rowCnt = returnTable.getNumRows();

	    for (int i = 0; i < rowCnt; i++) {

	        DataMap rowMap = new DataMap();

	        JCoFieldIterator it = returnTable.getFieldIterator();
	        while (it.hasNextField()) {
	            JCoField field = it.nextField();
	            rowMap.put(field.getName(), field.getValue());
	        }

	        returnList.add(rowMap);

	        String type = rowMap.getString("TYPE");
	        String message = rowMap.getString("MESSAGE");

	        if ("E".equals(type)) {
	            isError = true;
	            msgBuilder.append(message).append(" | ");
	        }

	        if ("S".equals(type) && successDoc == null) {
	            successDoc = message;   // "MBLNR,MJAHR"
	        }

	        returnTable.nextRow();
	    }

	    result.put("O_RETURN", returnList);

	    /* =========================
	     * 5. EV_RCODE / EV_RMSG 생성
	     * ========================= */
	    if (isError) {

	        result.put("EV_RCODE", "E");
	        result.put("EV_RMSG", msgBuilder.toString());

	    } else {

	        result.put("EV_RCODE", "S");
	        result.put("EV_RMSG", successDoc);

	        if (successDoc != null && successDoc.contains(",")) {
	            String[] split = successDoc.split(",");
	            result.put("EV_MBLNR", split[0]);
	            result.put("EV_MJAHR", split[1]);
	        }
	    }

	    return result;
	}



