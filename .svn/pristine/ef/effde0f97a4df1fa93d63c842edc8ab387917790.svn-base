	public static boolean isNull(String value) {
		return (value == null);
	}
	
	public static boolean isEmpty(String value) {
		return (isNull(value) || value.trim().length() == 0);
	}
	
	public static boolean isNotEmpty(String value) {
		return isEmpty(value) ? false : true;
	}
	
	@Transactional
	public DataMap saveAs01(DataMap map) throws SQLException {
		List<DataMap> head = map.getList("head");
		List<DataMap> selectList = new ArrayList<DataMap>();
		if( map.get("list") != null && !map.get("list").equals("")){
			selectList = map.getList("list");
		}
		String headSebeln = map.get("headSebeln").toString();
		
		int count = 0;
		int itemCount = 0;
		
		DataMap row;
		DataMap itemRow;
		
		List docNumList = new ArrayList();
		DataMap rsMap = new DataMap();
		
		for(int i = 0 ; i < head.size() ; i ++){
			if(head.get(i).getMap("map").getString("SEBELN").equals(headSebeln)){
				
				row = head.get(i).getMap("map");
				String docNum = wmsService.getDocSeq("051");
				docNumList.add(docNum);
				
				row.put("ASNDKY", docNum);
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				row.setModuleCommand("WmsInbound", "AS01T");	//INSERT INTO ASNDH
				
				commonDao.update(row);
								
				for(int k = 0 ; k < selectList.size() ; k ++){
					itemRow = selectList.get(k).getMap("map");
					itemRow.put("ASNDKY", docNum);
					itemRow.put("C00101", itemRow.getString("LOTA10")); 
					itemRow.setModuleCommand("WmsInbound", "AS01Sub2");		//INSERT INTO ASNDI
					itemCount += 10;
					String snum = String.valueOf(itemCount);
					String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
					
					itemRow.put("ASNDIT", inum);
					
					commonDao.update(itemRow);
				}
				itemCount = 0;
			}else{
				row = head.get(i).getMap("map");
				map.clonSessionData(row);
				
				String docNum = wmsService.getDocSeq("051");
				docNumList.add(docNum);
				
				row.put("ASNDKY", docNum);
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				row.setModuleCommand("WmsInbound", "AS01T");		//INSERT INTO ASNDH
				commonDao.update(row);

				row.setModuleCommand("WmsInbound", "AS01Sub");
				List<DataMap> list = commonDao.getList(row); 
				
				for(int j = 0 ; j < list.size() ; j ++){
					itemRow = list.get(j);
					itemCount += 10;
					String snum = String.valueOf(itemCount);
					String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;

					itemRow.put("ASNDKY", docNum);
					itemRow.put("ASNDIT", inum);
					itemRow.setModuleCommand("WmsInbound", "AS01Sub2");		//INSERT INTO ASNDI
					commonDao.update(itemRow);
					
				}
				itemCount = 0;
			}

			StringBuilder sb = new StringBuilder();
			for(int k = 0 ; k < docNumList.size() ; k ++){
				if(k != 0){
					sb.append(",");
				}
				sb.append("'").append(docNumList.get(k)).append("'");
			}
			rsMap.put("ASNDKY", sb.toString());
		}
		return rsMap;
	}
	
	@Transactional
	public int deleteAs02(DataMap map) throws SQLException {
		List<DataMap> head = map.getList("head");
		
		int count = 0;
		
		DataMap row;
		DataMap itRow = null;
		
		for(int i = 0 ; i < head.size() ; i ++){
				row = head.get(i).getMap("map");
				row.setModuleCommand("WmsInbound", "AS02Sub");
				List<DataMap> list = commonDao.getList(row); 
				for(int k =0; k < list.size(); k++){
					itRow = new DataMap(list.get(k));
					itRow.setModuleCommand("WmsInbound", "AS02Sub");
					itRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					commonDao.delete(itRow);
				}
				
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				row.setModuleCommand("WmsInbound", "AS02");
				commonDao.delete(row);
				
			count++;
		}
		return count;
	
	}
	
	@Transactional
	public DataMap saveGr02(DataMap map) throws SQLException {
		
		List<DataMap> head = map.getList("head");
		List<DataMap> itemList = new ArrayList<DataMap>();
		List<DataMap> selectList = new ArrayList<DataMap>();
		String headSebeln = map.getString("headSebeln");
			
		int itemCount = 0;
		
		DataMap row;
		DataMap itemRow;
		
		List<String> docNumList = new ArrayList();              // return RECVKY List
		DataMap rsMap = new DataMap();                          // return Map
		
		List<Map> batchHeadList = new ArrayList();              // Batch Insert Header List
		Map batchHeadMap = new HashMap();                       // Batch Insert Header Map
		
		List<Map> batchItemList = new ArrayList();              // Batch Insert Item List
		Map batchItemMap = new HashMap();                       // Batch Insert Item Map
		
		
		List<DataMap> ifidList = new ArrayList<DataMap>();      // IFID : 인터페이스 전송 목록
		
		List<String> rcpttyList = new ArrayList<String>();      // IF 실적 : 입고유형
		DataMap rcpttyMap = new DataMap();                      // IF 실적 : 입고유형별 입고헤더키
		
		List<String> rcQtrList = new ArrayList<String>();       // IF 품질검사 : 입고유형
		DataMap rcQtrMap = new DataMap();                       // IF 품질검사 : 입고유형별 입고헤더키
		DataMap rcStnMap = new DataMap();                       // IF 즉시불출 : 입고유형별 입고헤더키
		
		List<String> rcItmList = new ArrayList<String>();       // IF 수입밀롤 : 입고유형
		DataMap rcItmMap = new DataMap();                       // IF 수입밀롤 : 입고유형별 입고헤더키
		
		String rollYN = map.getString("ROLLYN"); 				// 밀롤 여부
		String eachYN = map.getString("EACHYN"); 				// 개별처리 여부(PDA 생산,반납입고 처리)
		
		for(int i = 0 ; i < head.size() ; i ++){
			
			log.debug("saveGR301 loop i : " + i);
			String sebeln = head.get(i).getMap("map").getString("SEBELN"); // 오더번호
			String hSeqno = head.get(i).getMap("map").getString("SEQNO"); // SEQNO
			
			if( sebeln.equals(headSebeln) || "Y".equals(eachYN) ){
				
				itemList = map.getList("list");
				
				//validation
				if(headSebeln.equals(sebeln) || "Y".equals(eachYN)){
					selectList = itemList;
				}
				
				if(selectList.size() > 0){
					
					// Validation
					StringBuffer sb = new StringBuffer();
					
					List<DataMap> cropList = new ArrayList<DataMap>();
					
					int valLimitCnt = 300;
					int valLoopSize = (selectList.size()/valLimitCnt);
					int valRmSize = (selectList.size()%valLimitCnt);
					
					if( selectList!=null && selectList.size()>0 && valLoopSize==0) {
						valLoopSize=1;
						valRmSize=0;
					}
					
					//log.debug("saveGR301 Validation valLoopSize : " + valLoopSize);
					//log.debug("saveGR301 Validation valRmSize : " + valRmSize);
					
					
					for (int k = 0; k < valLoopSize; k++) {
					
						cropList = new ArrayList<DataMap>();
						sb = new StringBuffer();
						
						if(selectList.size()<valLimitCnt) {
							cropList = selectList.subList( (k*valLimitCnt), selectList.size() );
							log.debug( k + " - batch - start : " + (k*valLimitCnt) + " - end : " + selectList.size() );
						}else {
							cropList = selectList.subList( (k*valLimitCnt), (((k+1)*valLimitCnt)) );
							log.debug( k + " - batch - start : " + (k*valLimitCnt) + " - end : " + (((k+1)*valLimitCnt)) );
						}
						
						if( k==(valLoopSize-1) && valRmSize!=0 ) {
							cropList = selectList.subList( ((k+1)*valLimitCnt), selectList.size() );
							log.debug( k + " - batch last - start : " + ((k+1)*valLimitCnt) + " - end : " + selectList.size() );
						}
						
						for(DataMap item : cropList){
							
							if(sb.length() > 0) sb.append(" UNION ALL\n ");
							
							sb.append(" SELECT '").append(head.get(i).getMap("map").get("SEBELN")).append("' AS SEBELN, ");
							sb.append("        '").append(item.getMap("map").get("SEBELP")).append("' AS SEBELP, ");
							sb.append("        '").append(head.get(i).getMap("map").get("DOCUTY")).append("' AS RCPTTY, ");
							sb.append("        '").append(head.get(i).getMap("map").get("WAREKY")).append("' AS WAREKY, ");
							sb.append("        '").append(head.get(i).getMap("map").get("OWNRKY")).append("' AS OWNRKY, ");
							sb.append("        '").append(head.get(i).getMap("map").get("PTNRTY")).append("' AS PTNRTY, ");
							sb.append("        '").append(head.get(i).getMap("map").get("DPTNKY")).append("' AS DPTNKY, ");
							sb.append("        '").append(item.getMap("map").get("LOCAKY")).append("' AS LOCAKY, ");
							sb.append("        '").append(item.getMap("map").get("SKUKEY")).append("' AS SKUKEY, ");
							sb.append("         ").append(item.getMap("map").get("QTYRCV")).append("  AS QTYRCV, ");
							sb.append("        '").append(item.getMap("map").get("UOMKEY")).append("' AS UOMKEY FROM DUAL ");
						}
						
						map.setModuleCommand("WmsInbound", "GOODS_RECEIPT"); // 쿼리키값 넣을것
						map.put("APPEND_QUERY", sb.toString());
						map.put("RCPTTY", head.get(i).getMap("map").get("DOCUTY"));
						List<DataMap> validList = commonDao.getValidation(map);
						if(validList.size() > 0){
							DataMap valid = validList.get(0);
							
							return valid;
						}
					
					}
					
				}// validation 끝
				
				row = head.get(i).getMap("map");
				//String RCPTTY = (String) row.get("RCPTTY");
				//String docNum = wmsService.getDocSeq(RCPTTY);
				String docNum ="";
				
				//docNumList.add(docNum);
				
				// 20220526 수입밀롤 기존 임시저장 입고 데이터 삭제
				if("Y".equals(rollYN)) {
					
					DataMap recvkyRow = new DataMap();
					recvkyRow.put("SEBELN", row.getString("SEBELN"));
					recvkyRow.setModuleCommand("WmsMobileInboundGoodsReceipt", "PDGR05_RECVKY");
					recvkyRow = commonDao.getMap(recvkyRow);
					
					String recvky = "";
					
					if(recvkyRow!=null) {
						recvky = recvkyRow.getString("RECVKY").trim();
					}
					
					if(!"".equals(recvky)) {
						docNum = recvky;
						
						DataMap tempRow = new DataMap();
						tempRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						
						// 임시저장 입고헤더 상태,전기일자 변경
						tempRow.put("DOCDAT", row.getString("DOCDAT"));
						tempRow.put("RECVKY", recvky);
						tempRow.put("SEBELN", row.getString("SEBELN"));
						tempRow.setModuleCommand("WmsMobileInboundGoodsReceipt", "PDGR05_RECDH_COMPLETE");
						commonDao.update(tempRow);
						
						// 임시저장 아이템이 삭제
						tempRow.put("SEBELN", row.getString("SEBELN"));
						tempRow.setModuleCommand("WmsInbound", "GR40_SEBELN_ITEM_ALL");
						commonDao.delete(tempRow);
						
						// ROLLMA 컨테이너 단위 초기화
						tempRow.put("CONTNO", row.getString("SIGNI"));
						tempRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
						commonDao.update(tempRow);
					}
					
				}
				
				row.put("RECVKY", docNum);
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				row.setModuleCommand("WmsInbound", "GR02");
				
				//commonDao.insert(row);
				
				batchHeadMap = new HashMap();
				batchHeadMap.putAll(row);
				batchHeadList.add(batchHeadMap);
				
				for(int j = 0 ; j < selectList.size() ; j ++){
					
					itemRow = selectList.get(j).getMap("map");
					
					String qrtayn = itemRow.getString("QRTAYN");
					String bwart = itemRow.getString("BWART");
					String ebeln = itemRow.getString("EBELN");
					String seqno = itemRow.getString("SEQNO");
					
					if("Y".equals(eachYN)) {
						// 입고 예정 정보 아이템 개별 처리 일 경우 오더번호 동일 해야 함. 
						if(!sebeln.equals(ebeln) /*|| hSeqno.equals(seqno)*/ ) {
							continue;
						}
					}
					
					itemRow.put("RECVKY", docNum);
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					//itemRow.setModuleCommand("WmsInbound", "GR02Sub");
					
					itemCount += 10;
					String snum = String.valueOf(itemCount);
					String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
					
					itemRow.put("RECVIT", inum);
					//itemRow.put("AREAKY", head.get(i).getMap("map").getString("AREAKY"));
					itemRow.put("ASNDAT", head.get(i).getMap("map").getString("ASNDAT"));
					
					// 품질검사
					if(  (null!=bwart && "131".equals(bwart)) || (null!=qrtayn && "V".equals(qrtayn)) ) {
						itemRow.put("LOTA06", "05");
					}
					
					// LOTA15 LOT번호 없을 경우 신규 채번
					String LOTA15 = itemRow.getString("LOTA15").trim();
					if(StringUtils.isEmpty(LOTA15)) {
						itemRow.put("RCPTTY",row.getString("RCPTTY"));
						itemRow.setModuleCommand("WmsInbound", "GENNOTNO");
						String NW_LOTA15 = (String) commonDao.getObject(itemRow);
						log.debug("LOTA15 : " + LOTA15 + " - NW_LOTA15 : " + NW_LOTA15);
						itemRow.put("LOTA15", NW_LOTA15);
					}
					
					if("Y".equals(rollYN)) {
						itemRow.put("RECYN", "V");
					}
					
					//commonDao.insert(itemRow);
					
					batchItemMap = new HashMap();
					batchItemMap.putAll(itemRow);
					batchItemList.add(batchItemMap);
					
				}
				
				itemCount = 0;
			/*
			}else if("Y".equals(eachYN)) {
				// 아이템 리스트만 있어서 건건히 입고 문서번호 채번해서 입고 처리 
				itemList = map.getList("list");
			*/	
				
			}else{
				
				//if(1==1) return rsMap;
				
				row = head.get(i).getMap("map");
				map.clonSessionData(row);
				
				String RCPTTY = (String) row.get("RCPTTY");
				//String docNum = wmsService.getDocSeq(RCPTTY);
				String docNum ="";
				
				//docNumList.add(docNum);
				row.put("PROGID",map.getString("PROGID"));
				
				row.setModuleCommand("WmsInbound", "GR02SubShort");
				row.put("STTNEW", "V");
				row.put("RCPTTY", RCPTTY);
				
				List<DataMap> list = commonDao.getList(row);
				
				row.put("RECVKY", docNum);
				row.setModuleCommand("WmsInbound", "GR02");
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				//commonDao.insert(row);
				
				batchHeadMap = new HashMap();
				batchHeadMap.putAll(row);
				batchHeadList.add(batchHeadMap);
				
				
				for(int j = 0 ; j < list.size() ; j ++){
					
					itemRow = list.get(j);
					
					String QRTAYN = itemRow.getString("QRTAYN");
					String BWART = itemRow.getString("BWART");
					
					itemRow.put("RECVKY", docNum);
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					//itemRow.setModuleCommand("WmsInbound", "GR02Sub");
					
					itemCount += 10;
					String snum = String.valueOf(itemCount);
					String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
					
					itemRow.put("RECVIT", inum);
					//itemRow.put("AREAKY", head.get(i).getMap("map").getString("AREAKY"));
					itemRow.put("ASNDAT", head.get(i).getMap("map").getString("ASNDAT"));
					
					// 품질검사
					if(  (null!=BWART && "131".equals(BWART)) || (null!=QRTAYN && "V".equals(QRTAYN)) ) {
						itemRow.put("LOTA06", "05");
					}
					
					/*
					// LOTA15 LOT번호 없을 경우 신규 채번 조회 시 SQL로 처리(GR02SubShort)
					String LOTA15 = itemRow.getString("LOTA15").trim();
					if(StringUtils.isEmpty(LOTA15)) {
						itemRow.put("RCPTTY",row.getString("RCPTTY"));
						itemRow.setModuleCommand("WmsInbound", "GENNOTNO");
						String NW_LOTA15 = (String) commonDao.getObject(itemRow);
						log.debug("LOTA15 : " + LOTA15 + " - NW_LOTA15 : " + NW_LOTA15);
						itemRow.put("LOTA15", NW_LOTA15);
					}
					*/
				
					//commonDao.insert(itemRow);
					
					batchItemMap = new HashMap();
					batchItemMap.putAll(itemRow);
					batchItemList.add(batchItemMap);
					
				}
				
				itemCount = 0;
			}
			
		}
		
		// 입고키 생성
		setGr02DocSeqList(batchHeadList, batchItemList, docNumList, rcpttyList, rcpttyMap, rcQtrList, rcQtrMap, rcStnMap, rcItmList, rcItmMap);
		
		// 입고 헤더 데이터 대량 insert
		execBatchList("WmsInbound.GR02Batch", batchHeadList);
		
		// 입고 아이템 데이터 대량 insert
		execBatchList("WmsInbound.GR02SubBatch", batchItemList);
		
		// 20220526 수입밀롤 기존 임시저장 입고 데이터 삭제				
		if("Y".equals(rollYN)) {
			// IFWMS103 수입밀롤 전체 입고 완료 처리
			execBatchList("WmsInbound.GR40_COMPLETE_BATCH", batchItemList);
			// ROLLMA 입고 처리
			execBatchList("WmsInbound.GR40_ROLLMA_MERGE_BATCH", batchItemList);
		}
		
		log.debug("~~ rcpttyList : " + rcpttyList.toString());
		log.debug("~~ rcpttyMap : " + rcpttyMap.toString());
		
		// 실적 인터페이스 저장
		dataInsertIF(map, rcpttyList, rcpttyMap, ifidList);
		
		// 품질 인터페이스 저장
		dataInsertIF(map, rcQtrList, rcQtrMap, ifidList);
		
		// 즉시불출 인터페이스 저장
		dataInsertIFStn(map, rcStnMap, ifidList);
		
		// 20220526 수입밀롤 기존 임시저장 입고 데이터 삭제
		if("Y".equals(rollYN)) {
			// 수입밀롤 인터페이스 저장
			dataInsertIFItm(map, rcItmList, rcItmMap, ifidList);
		}
		
		log.debug("~~ rcQtrList : " + rcQtrList.toString());
		log.debug("~~ rcQtrMap : " + rcQtrMap.toString());
		log.debug("~~ rcStnMap : " + rcStnMap.toString());
		log.debug("~~ rcItmMap : " + rcItmMap.toString());
		
		log.debug("~~ ifidList : " + ifidList.toString());
		
		// 인터페이스 전송 목록
		rsMap.put("ifidList",ifidList);
		
		StringBuilder sb = new StringBuilder();
		for(int k = 0 ; k < docNumList.size() ; k ++){
			if(k != 0){
				sb.append(",");
			}
			sb.append("'").append(docNumList.get(k)).append("'");
		}
		rsMap.put("RECVKY", sb.toString());
		
		//if(1==1) commonDao.rollback();
		
		return rsMap;
	}

	@Transactional
	public DataMap saveSDGR(DataMap map) throws SQLException {
		
		DataMap list = map;
		List<DataMap> itemList = new ArrayList<DataMap>();
		List<DataMap> selectList = new ArrayList<DataMap>();
		String headSebeln = map.getString("headSebeln");
				
		int totCnt = 0;         // 입고 전체 건수
		int sucCnt = 0;         // 입고 성공 건수 
		int failCnt = 0;        // 입고 성공 건수
		
		int errMsgLen = 500;    // 에러메세지 길이
		
		String totInRsCode = "S";    // 입고테이블 insert 결과 코드
		StringBuffer totInRsSbMsg = new StringBuffer(); // 입고테이블 insert 결과 메세지
		
		String totRsCode = "S";    // 인터페이스 결과 코드
