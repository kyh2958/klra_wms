						if ( !"V".equals(shtayn) && null!=bwart && "131".equals(bwart)) {
							// 품질검사 - 반품입고는 품질(05) 상태로 입고처리
							itemRow.put("LOTA06", "05");
							I_QRTAYN   = qrtayn;   		//품질검사여부
						}else if( !"V".equals(shtayn) 												// 즉시불출이 아니고 
								&& (null!=bwart && !"131".equals(bwart) && !"135".equals(bwart)) 	// 반품, 반납입고가 아니고
								&& (null!=qrtayn && "V".equals(qrtayn)) ) { 						// 품질여부가 check 된 것
							// 품질검사 - 반품입고 이외 에는 품질검사여부에 따라 변경
							itemRow.put("LOTA06", "05");
							I_QRTAYN   = qrtayn;     	// 품질검사여부
						}else {
