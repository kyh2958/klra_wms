					sendMap.put("ownrky", I_OWNRKY);
					sendMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					ifRsMsg = iFService.sendIF(sendMap);

					if( ifRsMsg==null || !ifRsMsg.equals("SUCCESS")) {
						ifRsCode = "E";
						ifRsMsg = "[" + sebeln + "] 입고 즉시불출 인터페이스 전송 에러 : " + ifRsMsg;
					}
					
					log.debug("InboundService.saveGr02New 입고 즉시불출 인터페이스 전송 - ifid : " + I_IFID_STN + " - ifRsMsg : " + ifRsMsg );
				} catch(SQLException se) {
					log.error("InboundService.saveGr02New 입고 즉시불출 인터페이스 전송 - ifid : " + I_IFID_STN + " - SQLException Error : " + se.getMessage());
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + sebeln + "] 입고 즉시불출 인터페이스 전송 에러 : " + cutErrMsg;
					
				} catch(BadSqlGrammarException bse) {
					log.error("InboundService.saveGr02New 입고 즉시불출 인터페이스 전송 - ifid : " + I_IFID_STN + " - BadSqlGrammarException Error : " + bse.getMessage());
					ifRsCode = "E";
					try {
