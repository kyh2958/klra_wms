			} catch(SQLException se) {
				log.error("InboundService.saveGr02New 입고 테이블 insert 저장 실패 - sebeln : " + sebeln + " - SQLException Error : " + se.getMessage());
				String errMsg = se.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				
				inRsCode = "E";
				inRsMsg = "[" + sebeln + "] 입고 테이블 insert 저장 실패 : " + cutErrMsg;
				//se.printStackTrace();
			} catch(BadSqlGrammarException bse) {
