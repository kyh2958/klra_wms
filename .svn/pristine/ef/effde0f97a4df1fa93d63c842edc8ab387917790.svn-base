							log.debug("LOTA15 : " + LOTA15 + " - NW_LOTA15 : " + NW_LOTA15);
							itemRow.put("LOTA15", NW_LOTA15);
						}
						
						if("Y".equals(rollYN)) {
							itemRow.put("RECYN", "V"); // ROLLMA.PRCFLG 완료 처리 여부
						}
						
						//commonDao.insert(itemRow);
						
						I_RECVKY   = itemRow.getString("RECVKY");
						I_RCPTTY   = itemRow.getString("RCPTTY");     	// 입고유형
						I_IFID_SAP = itemRow.getString("IFID_SAP");   	// 실적 SAP IF_ID
						I_IFID_QTR = itemRow.getString("IFID_QTR");   	// 품질 IF_ID
						I_IFID_STN = itemRow.getString("IFID_STN");   	// 즉시불출 IF_ID
						
