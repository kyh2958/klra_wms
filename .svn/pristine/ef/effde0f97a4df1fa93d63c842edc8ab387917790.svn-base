			e.printStackTrace();
		}
		
		// 에러 처리
		if("E".equals(inRsCode)) {
			
			failCnt++;
			// 인터페이스 에러 결과 메세지
			totInRsCode = inRsCode;
			totInRsSbMsg.append("\n");
			totInRsSbMsg.append(inRsMsg.toString());
			
			transactionManager.rollback(transactionStatus);
			successYN = false;
			log.debug("InboundService.saveGr14 품질상태변경 테이블 저장 실패 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - docSeqQtygod : " + docSeqQtygod + " - rollback");
		
		}
		
