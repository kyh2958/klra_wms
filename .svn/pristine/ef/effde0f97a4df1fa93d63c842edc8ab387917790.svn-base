						I_RCPTTY   = itemRow.getString("RCPTTY");     	// 입고유형
						I_IFID_SAP = itemRow.getString("IFID_SAP");   	// 실적 SAP IF_ID
						I_IFID_QTR = itemRow.getString("IFID_QTR");   	// 품질 IF_ID
						I_IFID_STN = itemRow.getString("IFID_STN");   	// 즉시불출 IF_ID
						I_IFID_PTL = itemRow.getString("IFID_PTL");   	// 실적 IF_ID(구매포탈)
						I_IFID_MES = itemRow.getString("IFID_MES");   	// 실적 IF_ID(MES)
						
