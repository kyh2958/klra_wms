				sadjky = wmsService.getDocSeq("402");
				head.put("SADJKY", sadjky);
				//head.put("ADJFLG", "M");
				commonDao.update(head);
			}
	
			int itemCount = 0;
			
			for(int i = 0 ; i < itemList.size() ; i ++){
				
				row = new DataMap();
				
				gmRow = new DataMap();
				gpRow = new DataMap();
				bmRow = new DataMap();
				bpRow = new DataMap();
				
				row = itemList.get(i).getMap("map");
				
				gmRow.putAll(row);
				gpRow.putAll(row);
				bmRow.putAll(row);
				bpRow.putAll(row);
				
				float QTYGOD = Float.parseFloat(row.getString("QTYGOD")); // 정상수량
				
				if( !"".equals(hQtyGod) && !"0".equals(hQtyGod) && QTYGOD>0 ) {
					
					gmRow.put("SADJKY", sadjky);
					gmRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					gmRow.setModuleCommand("WmsInventory", "ADJDIOLD");
					itemCount += 10;
					gmRow.put("SADJIT", String.format("%06d", itemCount));
					gmRow.put("QTADJU", String.valueOf(QTYGOD * -1));
					gmRow.put("ALOTA06", "00");
					gmRow.put("ARSNADJ", "110");
					
					// set interface data
					String SAPSTS = inventoryService.getSAPSTS("402", gmRow);
					gmRow.put("SAPSTS", SAPSTS);
					DataMap ifData = inventoryService.setInterfaceData ("402", gmRow);
					
					commonDao.insert(gmRow);
				}
				
				
				if( !"".equals(hQtyGod) && !"0".equals(hQtyGod) && QTYGOD>0 ) {
					
					gpRow.put("SADJKY", sadjky);
					gpRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		
					gpRow.setModuleCommand("WmsInventory", "ADJDI");
					itemCount += 10;
					gpRow.put("SADJIT", String.format("%06d", itemCount));
					
					gpRow.put("QTYUOM", String.valueOf(QTYGOD));
					gpRow.put("QTADJU", String.valueOf(QTYGOD));
					gpRow.put("STOKKY", " ");
					gpRow.put("LOTNUM", " ");
					gpRow.put("ALOTA06", "00");
					gpRow.put("ARSNADJ", "110");
					
					// set interface data
