					log.error("InboundService.saveGr02New 입고 품질검사 인터페이스 전송 - ifid : " + I_IFID_QTR + " - UncategorizedSQLException Error : " + bse.getMessage());
					ifRsCode = "E";
					try {
						SQLException se = bse.getSQLException();
						String errMsg = se.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + sebeln + "] 입고 품질검사 인터페이스 전송 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + sebeln + "] 입고 품질검사 인터페이스 전송 에러  : " + cutErrMsg;
					}
				}catch(Exception e) {
					log.error("InboundService.saveGr02New 입고 품질검사 인터페이스 에러 - ifid : " + I_IFID_QTR + " - Exception Error : " + e.getMessage());
					String errMsg = e.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + sebeln + "] 입고 품질검사 인터페이스 전송 에러 : " + cutErrMsg;
					e.printStackTrace();
				}
				
				// 에러 처리
				if("E".equals(ifRsCode)) {
					// 인터페이스 에러 결과 메세지
					totRsCode = ifRsCode;
					totRsSbMsg.append("\n");
					totRsSbMsg.append(ifRsMsg);
					successYN = false;
					
					/*
						MES로 품질검사 전송 실패시 SAP 취소 RFC CALL을 해야함.
						GR09에서 Grid Head정보로 입고취소를 하고 있음
						SAP만 취소하도록 Head 데이터를 만들어 주는 쿼리를 따로 생성 (GR09CANCEL)
						MES에 취소에 대한 인터페이스 정보는 만들지 않도록 쿼리를 수정
					*/
					row = head.get(i).getMap("map");
					
					DataMap cancelMap = new DataMap();
					//기존 취소 로직에서 I_IFID_MES는 비운 상태로 보내야함..
					cancelMap.setModuleCommand("WmsInbound", "GR09CANCEL");
					cancelMap.put("OWNRKY", row.getString("OWNRKY"));
					cancelMap.put("WAREKY", row.getString("WAREKY"));
					cancelMap.put("EBELN" , row.getString("EBELN"));
					cancelMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					List<DataMap> cancelList = commonDao.getList(cancelMap);
					cancelMap.put("head", cancelList);
					
					deleteGR09New(cancelMap);
				}
			}
			log.debug("~~ 입고 품질검사 인터페이스 전송 rcQtrList : " + rcQtrList.toString());
			log.debug("~~ 입고 품질검사 인터페이스 전송 rcQtrMap : " + rcQtrMap.toString());
			log.debug("~~ 입고 품질검사 인터페이스 전송 ifidQtrList : " + ifidQtrList.toString());
			
			// 즉시불출 인터페이스
			if(null!=I_SHTAYN && "V".equals(I_SHTAYN) && (null!=I_IFID_STN && !"".equals(I_IFID_STN.trim())) && rcStnList!=null && rcStnList.size()>0 ) {
				
