					ifData.put("MEINS", gpRow.getString("MEINSOD"));
					ifData.put("QTADJU", gpRow.getString("QTYGODOD"));
					
					ifData.put("LOGSEQNO", logSeqNo);
					ifList.add(ifData);
				}
				
				float QTYBAD = Float.parseFloat(row.getString("QTYBAD")); // 불량수량
				
				if( !"".equals(hQtyBad) && !"0".equals(hQtyBad) && QTYBAD>0 ) {
					
					bmRow.put("SADJKY", sadjky);
					bmRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		
					bmRow.setModuleCommand("WmsInventory", "ADJDIOLD");
					itemCount += 10;
					bmRow.put("SADJIT", String.format("%06d", itemCount));
					bmRow.put("QTADJU", String.valueOf(QTYBAD * -1));
					bmRow.put("LOTA06", "30");
					bmRow.put("ARSNADJ", "110");
					
					// set interface data
					String SAPSTS = inventoryService.getSAPSTS("402", bmRow);
					bmRow.put("SAPSTS", SAPSTS);
					DataMap ifData = inventoryService.setInterfaceData ("402", bmRow);
					
					commonDao.insert(bmRow);
				}
				
				if( !"".equals(hQtyBad) && !"0".equals(hQtyBad) && QTYBAD>0 ) {
					
					bpRow.put("SADJKY", sadjky);
					bpRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		
					bpRow.setModuleCommand("WmsInventory", "ADJDI");
					itemCount += 10;
					bpRow.put("SADJIT", String.format("%06d", itemCount));
					
					bpRow.put("QTYUOM", String.valueOf(QTYBAD));
					bpRow.put("QTADJU", String.valueOf(QTYBAD));
					bpRow.put("STOKKY", " ");
					bpRow.put("LOTNUM", " ");
					bpRow.put("ALOTA06", "30");
					bpRow.put("ARSNADJ", "110");
					
					/* 2022.06.23 재고상태TO가 10, 30, 50인 경우 제품군에 따라 저장위치 변경 (P400 플랜트 제외) */
					String WAREKY = bpRow.getString("WAREKY");
					String LOTA02 = bpRow.getString("LOTA02");
					String SKUG05 = bpRow.getString("SKUG05");
