						String lota0102 = lota02.trim() + lota01.trim(); // 20221011 반납입고 from 플랜트+저장위치 비교 문자
						
						String uomKey = itemRow.getString("UOMKEY");   // 수량단위
						String muomKey = itemRow.getString("MUOMKEY"); // 기본단위
						Double uomQty = Double.parseDouble(itemRow.getString("UOMQTY")); // 기본단위수량
						
					
						//20221205.선적문서번호 추가
						String stknum = row.getString("STKNUM");
						itemRow.put("STKNUM",stknum);
						
						itemRow.put("RECVKY", docNum);
