						  !"P400".equals( LOTA02) && // P400 플랜트 제외
						  "10".equals("30") || // 보류
						  "30".equals("30") || // 불용
						  "50".equals("30")    // 폐기
					) {
						bpRow.put("ALOTA01", "00".equals(SKUG05) ? "1900" : "3900"); // 1900: 원자재, 3900: 제품/상품/반제품
					}
					
					// set interface data
					String SAPSTS = inventoryService.getSAPSTS("402", bpRow);
					bpRow.put("SAPSTS", SAPSTS);
					DataMap ifData = inventoryService.setInterfaceData ("402", bpRow);
					
					commonDao.insert(bpRow);
					
