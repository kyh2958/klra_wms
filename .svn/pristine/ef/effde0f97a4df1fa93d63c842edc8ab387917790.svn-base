						// Validation
						StringBuffer sb = new StringBuffer();
						
						List<DataMap> cropList = new ArrayList<DataMap>();
						
						int valLimitCnt = 300;
						int valLoopSize = (selectList.size()/valLimitCnt);
						int valRmSize = (selectList.size()%valLimitCnt);
						
						if( selectList!=null && selectList.size()>0 && valLoopSize==0) {
							valLoopSize=1;
							valRmSize=0;
						}
						
						log.debug("saveGR301 Validation valLoopSize : " + valLoopSize);
						log.debug("saveGR301 Validation valRmSize : " + valRmSize);
						
						
						for (int k = 0; k < valLoopSize; k++) {
						
							cropList = new ArrayList<DataMap>();
							sb = new StringBuffer();
							
							if(selectList.size()<valLimitCnt) {
								cropList = selectList.subList( (k*valLimitCnt), selectList.size() );
								log.debug( k + " - batch - start : " + (k*valLimitCnt) + " - end : " + selectList.size() );
							}else {
								cropList = selectList.subList( (k*valLimitCnt), (((k+1)*valLimitCnt)) );
								log.debug( k + " - batch - start : " + (k*valLimitCnt) + " - end : " + (((k+1)*valLimitCnt)) );
							}
							
							if( k==(valLoopSize-1) && valRmSize!=0 ) {
								cropList = selectList.subList( ((k+1)*valLimitCnt), selectList.size() );
								log.debug( k + " - batch last - start : " + ((k+1)*valLimitCnt) + " - end : " + selectList.size() );
							}
							
							for(DataMap item : cropList){
								
								if(sb.length() > 0) sb.append(" UNION ALL\n ");
								
								sb.append(" SELECT '").append(head.get(i).getMap("map").get("SEBELN")).append("' AS SEBELN, ");
								sb.append("        '").append(item.getMap("map").get("SEBELP")).append("' AS SEBELP, ");
								sb.append("        '").append(head.get(i).getMap("map").get("DOCUTY")).append("' AS RCPTTY, ");
								sb.append("        '").append(head.get(i).getMap("map").get("WAREKY")).append("' AS WAREKY, ");
								sb.append("        '").append(head.get(i).getMap("map").get("OWNRKY")).append("' AS OWNRKY, ");
								sb.append("        '").append(head.get(i).getMap("map").get("PTNRTY")).append("' AS PTNRTY, ");
								sb.append("        '").append(head.get(i).getMap("map").get("DPTNKY")).append("' AS DPTNKY, ");
								sb.append("        '").append(item.getMap("map").get("LOCAKY")).append("' AS LOCAKY, ");
								sb.append("        '").append(item.getMap("map").get("SKUKEY")).append("' AS SKUKEY, ");
								sb.append("         ").append(item.getMap("map").get("QTYRCV")).append("  AS QTYRCV, ");
								sb.append("        '").append(item.getMap("map").get("UOMKEY")).append("' AS UOMKEY FROM DUAL ");
							}
							
