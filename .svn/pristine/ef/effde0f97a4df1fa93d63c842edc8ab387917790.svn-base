						ifRsMsg = "[" + I_RECVKY + "] 입고 취소 품질검사 인터페이스 전송 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 입고 취소 품질검사 인터페이스 전송 에러  : " + cutErrMsg;
					}
				}catch(Exception e) {
					log.error("InboundService.deleteGR09New 입고 취소 품질검사 인터페이스 에러 - ifid : " + I_IFID_QTR + " - Exception Error : " + e.getMessage());
					String errMsg = e.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + I_RECVKY + "] 입고 취소 품질검사 인터페이스 전송 에러 : " + cutErrMsg;
					e.printStackTrace();
				}
				
				// 에러 처리
				if("E".equals(ifRsCode)) {
					// 인터페이스 에러 결과 메세지
					totRsCode = ifRsCode;
					totRsSbMsg.append("\n");
					totRsSbMsg.append(ifRsMsg);
					successYN = false;
				}
				
			}
			log.debug("~~ 입고 취소 품질검사 인터페이스 전송 rcQtrList : " + rcQtrList.toString());
			log.debug("~~ 입고 취소 품질검사 인터페이스 전송 rcQtrMap : " + rcQtrMap.toString());
			log.debug("~~ 입고 취소 품질검사 인터페이스 전송 ifidQtrList : " + ifidQtrList.toString());
			/*
			// 즉시불출 인터페이스
			if(null!=I_SHTAYN && "V".equals(I_SHTAYN) && (null!=I_IFID_STN && !"".equals(I_IFID_STN.trim())) && rcStnList!=null && rcStnList.size()>0 && ifStkkyStnList.size()>0 ) {
				
				// IF 즉시불출 인터페이스 전송
				String ifRsCode = "S";
				String ifRsMsg = "";
				
				try {
					
					DataMap sendMap = new DataMap();
					
					sendMap = ifidStnList.get(0);
					
					sendMap.put("ownrky", I_OWNRKY);
					sendMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					ifRsMsg = iFService.sendIF(sendMap);

					if( ifRsMsg==null || !ifRsMsg.equals("SUCCESS")) {
						ifRsCode = "E";
						ifRsMsg = "[" + I_RECVKY + "] 입고 취소 즉시불출 인터페이스 전송 에러 : " + ifRsMsg;
					}
					
					log.debug("InboundService.deleteGR09New 취소 입고 즉시불출 인터페이스 전송 - ifid : " + I_IFID_STN + " - ifRsMsg : " + ifRsMsg );
				} catch(SQLException se) {
					log.error("InboundService.deleteGR09New 취소 입고 즉시불출 인터페이스 전송 - ifid : " + I_IFID_STN + " - SQLException Error : " + se.getMessage());
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + I_RECVKY + "] 입고 취소 즉시불출 인터페이스 전송 에러 : " + cutErrMsg;
					
				} catch(BadSqlGrammarException bse) {
					log.error("InboundService.deleteGR09New 입고 취소 즉시불출 인터페이스 전송 - ifid : " + I_IFID_STN + " - BadSqlGrammarException Error : " + bse.getMessage());
					ifRsCode = "E";
					try {
						SQLException se = bse.getSQLException();
						String errMsg = se.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 입고 취소 즉시불출 인터페이스 전송 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 입고 취소 즉시불출 인터페이스 전송 에러 : " + cutErrMsg;
					}
				} catch(UncategorizedSQLException bse) {
					log.error("InboundService.deleteGR09New 입고 취소 즉시불출 인터페이스 전송 - ifid : " + I_IFID_STN + " - UncategorizedSQLException Error : " + bse.getMessage());
					ifRsCode = "E";
					try {
						SQLException se = bse.getSQLException();
						String errMsg = se.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 입고 취소 즉시불출 인터페이스 전송 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 입고 취소 즉시불출 인터페이스 전송 에러 : " + cutErrMsg;
					}
				}catch(Exception e) {
					log.error("InboundService.deleteGR09New 입고 취소 즉시불출 인터페이스 전송 - ifid : " + I_IFID_STN + " - Exception Error : " + e.getMessage());
					String errMsg = e.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + I_RECVKY + "] 입고 취소 즉시불출 인터페이스 전송 에러 : " + cutErrMsg;
					e.printStackTrace();
				}
				
				// 에러 처리
				if("E".equals(ifRsCode)) {
					// 인터페이스 에러 결과 메세지
					totRsCode = ifRsCode;
					totRsSbMsg.append("\n");
					totRsSbMsg.append(ifRsMsg);
					successYN = false;
				}
				
			}
			log.debug("~~ 입고 취소 즉시불출 인터페이스 전송 rcStnMap : " + rcStnMap.toString());
			log.debug("~~ 입고 취소 즉시불출 인터페이스 전송 ifidStnList : " + ifidStnList.toString());
			
			*/
			/*********************************************************************************
			 * 인터페이스 네트워크 전송  END
			 *********************************************************************************/
			//240216 HNW for문 내 트랜잭션 완료처리
			if(!transactionStatus.isCompleted()) {
				transactionManager.commit(transactionStatus);
			}
						
			if(successYN == true) {
				sucCnt++;
			}else {
				failCnt++;
			}
			
			count ++;
		}
	
		// 입고 저장 결과
		rsMap.put("inRsCode", totInRsCode);
		rsMap.put("inRsMsg", totInRsSbMsg.toString());
		
		// 인터페이스 전송 결과
		rsMap.put("ifRsCode", totRsCode);
		rsMap.put("ifRsMsg", totRsSbMsg.toString());
		
		// 입고 성공/실패 카운트
		rsMap.put("totCnt", totCnt);
		rsMap.put("sucCnt", sucCnt);
		rsMap.put("failCnt", failCnt);
		
		log.debug("~~ deleteGR09New last called");
		
		// 입고취소 성공 목록
		StringBuilder sb2 = new StringBuilder(); // 입고 전체완료 확인 sql
		try {
			for(int k = 0 ; k < recvkyList.size() ; k ++){
				if(k != 0){
					sb2.append(",");
				}
				sb2.append("'").append(recvkyList.get(k)).append("'");
			}
			if("".equals(sb2.toString())) {
				sb2.append("' '");
			}
			
			DataMap completeMap = new DataMap();
			completeMap.put("RECVKYS", sb2.toString());
			completeMap.setModuleCommand("WmsInbound", "GR09_CANCEL");
			sucList = commonDao.getList(completeMap);
		}catch(Exception e) {
			log.debug("~~ deleteGR09New.GR09_CANCEL error : " + e.getMessage() );
			e.printStackTrace();
		}
		// 인터페이스 전송 목록
		rsMap.put("sucList", sucList);
		
		// SAP 실적 인터페이스 실패로그
		try {
			log.debug("~~ deleteGR09New.sapIfErrList.size : " + sapIfErrList.size() );
			if(sapIfErrList!=null && sapIfErrList.size()>0) {
				execBatchList("WmsInbound.GR_IF_SAP_LOG_BATCH", sapIfErrList);
			}
		}catch(Exception e) {
			log.debug("~~ deleteGR09New.GR_IF_SAP_LOG_BATCH error : " + e.getMessage() );
			e.printStackTrace();
		}
		
		rsMap.put("count",count);
		
		return rsMap;
		
	}
	
	public DataMap deleteGR09New_X(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();                         	 // return Map
		
		List<DataMap> head = map.getList("head"); 				 // 입고번호 헤더
		List<DataMap> list = new ArrayList<DataMap>(); 			 // 입고번호 아이템
		
		int count = 0;
		
		List<DataMap> ifidSapList = new ArrayList<DataMap>();    // IFID : SAP 인터페이스 전송 목록
		List<DataMap> ifidQtrList = new ArrayList<DataMap>();    // IFID : 품질검사 인터페이스 전송 목록
		List<DataMap> ifidStnList = new ArrayList<DataMap>();    // IFID : 즉시불출 인터페이스 전송 목록
		
		List<DataMap> ifidPtlList = new ArrayList<DataMap>();    // IFID : 실적(구매포탈)인터페이스 전송 목록
		List<DataMap> ifidMesList = new ArrayList<DataMap>();    // IFID : 실적(MES)인터페이스 전송 목록
		
		
		List<DataMap> ifStkkyStnList = new ArrayList<DataMap>(); // IFID : 즉시불출 재고 인터페이스 전송 목록(입고 취소시 재고 수량 없어지므로 취소전 조회 해야됨.)
		
		List<String> rcpttySapList = new ArrayList<String>();    // IF 실적 : 입고유형 SAP
		DataMap rcpttySapMap = new DataMap();                    // IF 실적 : 입고유형별 입고헤더키 SAP
		
		List<String> rcpttyPtlList = new ArrayList<String>();    // IF 실적 : 입고유형(구매포탈)
		DataMap rcpttyPtlMap = new DataMap();                    // IF 실적 : 입고유형별 입고헤더키(구매포탈)
		
		List<String> rcpttyMesList = new ArrayList<String>();    // IF 실적 : 입고유형(MES)
		DataMap rcpttyMesMap = new DataMap();                    // IF 실적 : 입고유형별 입고헤더키(MES)
		
		
		List<String> rcQtrList = new ArrayList<String>();        // IF 품질검사 : 입고유형
		DataMap rcQtrMap = new DataMap();                        // IF 품질검사 : 입고유형별 입고헤더키
		
		List<String> rcStnList = new ArrayList<String>();        // IF 즉시불출 : 입고유형
		DataMap rcStnMap = new DataMap();                        // IF 즉시불출 : 입고유형별 입고헤더키		
		
		DataMap headRow = new DataMap();
		DataMap itemRow = new DataMap();
		
		List<Map> sapIfErrList = new ArrayList();                // Batch SAP IF ERROR List
		Map sapIfErrMap = new HashMap();                         // Batch SAP IF ERROR Map
		
		List<String> recvkyList = new ArrayList();               // return RECVKY List
		
		List<DataMap> sucList = new ArrayList<DataMap>();        // 입고 취소 성공 목록
		
		int totCnt = 0;         // 입고 전체 건수
		int sucCnt = 0;         // 입고 성공 건수 
		int failCnt = 0;        // 입고 성공 건수
		
		int errMsgLen = 500;    // 에러메세지 길이
		
		String totInRsCode = "S";    					         // 입고테이블 insert 결과 코드
		StringBuffer totInRsSbMsg = new StringBuffer();          // 입고테이블 insert 결과 메세지
		
		String totRsCode = "S";    						         // 인터페이스 결과 코드
		StringBuffer totRsSbMsg = new StringBuffer(); 	         // 인터페이스 결과 메세지
		
		totCnt = head.size();
		
		for(int i=0;i<head.size();i++){
			
			TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
			TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
			
			headRow = head.get(i).getMap("map");
			
			
			// 입고 테이블 insert 결과
			String inRsCode = "S";
			String inRsMsg = "";
			
			String recvky = headRow.getString("RECVKY"); // 입고문서키
			String sebeln = headRow.getString("SEBELN"); // 오더번호
			String mrflg  = headRow.getString("MRFLG");  // 수입밀롤 구분자
			String rcptty = headRow.getString("RCPTTY"); // 입고유형
			String sapetc = headRow.getString("SAPETC"); // 재고조정 SAP 연동여부
			String sapifskip = headRow.getString("SAPIFSKIP"); // 20221012 반납입고 from to 플랜트,저장위치 동일 할 경우 sap 인터페이스 전송 안함 SAP 연동 스킵여부
			//sapetc = "";
			boolean successYN = true;            // 헤더 별 저장 및 인터페이스 전송 성공 여부
			
			recvkyList.add(recvky); 			// 오더별 입고 전체 완료 확인 위해 필요 
			
			/*********************************************************************************
			 * WMS 테이블 입고 취소 START
			 *********************************************************************************/
			try {
			
				// 헤더 단위 입고 취소 가능.
				headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				ifStkkyStnList = new ArrayList<DataMap>(); // IFID : 즉시불출 재고 인터페이스 전송 목록(입고 취소시 재고 수량 없어지므로 취소전 조회 해야됨.)
				if("V".equals(headRow.getString("SHTAYN").trim())) {
					// 즉시불출 재고 인터페이스 전송 목록(입고 취소시 재고 수량 없어지므로 취소전 조회 해야됨.)
					headRow.setModuleCommand("WmsInbound", "GR09_SHTAYN_STKKY");
					ifStkkyStnList = headRow.getList(headRow);
				}
				
				if("S0".equals(mrflg)) {
					// 수입밀롤 삭제
					
					log.debug("InboundService.deleteGR09New 수입밀롤 WMS 테이블 입고 취소 저장 시작 - recvky : " + recvky);
					
					// 아이템이 삭제
					headRow.setModuleCommand("WmsInbound", "GR09DELETE");
					commonDao.update(headRow);
					
					// 아이템이 모두 삭제되면 헤더도 삭제
					headRow.setModuleCommand("WmsInbound", "RECDI_ITEMCNT");
					int cnt = commonDao.getCount(headRow);
					if(cnt == 0) {
						headRow.setModuleCommand("WmsInbound", "GR09DELETEHEADER");
						commonDao.update(headRow);
					}
					
					// 밀롤 입고 예정정보 상태 전체 강제 입고 가능하게 업데이트
					headRow.setModuleCommand("WmsInbound", "GR40_CANCEL");
					commonDao.update(headRow);
					
					// ROLLMA 컨테이너 단위 초기화
					headRow.put("CONTNO", headRow.getString("SIGNI"));
					headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
					commonDao.update(headRow);
					
					// 유저 신규 추가 ROLLMA 데이터 삭제
					headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
					commonDao.delete(headRow);
					
				} else {
				
					log.debug("InboundService.deleteGR09New 일반 WMS 테이블 입고 취소 저장 시작 - recvky : " + recvky);
					
					// 입고 아이템 취소 처리			
					headRow.setModuleCommand("WmsInbound", "GR09DELETE");
					commonDao.update(headRow);
					
					// 아이템이 모두 삭제되면 헤더도 삭제
					headRow.setModuleCommand("WmsInbound", "RECDI_ITEMCNT");
					int cnt = commonDao.getCount(headRow);
					if(cnt == 0) {
						headRow.setModuleCommand("WmsInbound", "GR09DELETEHEADER");
						headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						commonDao.update(headRow);
					}
				
				}
				
				transactionManager.commit(transactionStatus);
				
				log.debug("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 성공 - recvky : " + recvky);
			
			} catch(SQLException se) {
				log.error("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - SQLException Error : " + se.getMessage());
				String errMsg = se.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				
				inRsCode = "E";
				inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				//se.printStackTrace();
			} catch(BadSqlGrammarException bse) {
				log.error("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - BadSqlGrammarException Error : " + bse.getMessage());
				inRsCode = "E";
				//bse.printStackTrace();
				
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}
			} catch(UncategorizedSQLException bse) {
				log.error("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - UncategorizedSQLException Error : " + bse.getMessage());
				inRsCode = "E";
				//bse.printStackTrace();
				
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}
			} catch(Exception e) {
				log.error("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - Exception Error : " + e.getMessage());
				String errMsg = e.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				inRsCode = "E";
				inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				e.printStackTrace();
			}
			
			// 에러 처리
			if("E".equals(inRsCode)) {
				
				failCnt++;
				// 인터페이스 에러 결과 메세지
				totInRsCode = inRsCode;
				totInRsSbMsg.append("\n");
				totInRsSbMsg.append(inRsMsg.toString());
				
				transactionManager.rollback(transactionStatus);
				successYN = false;
				log.debug(i + " - InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - rollback");
				//continue;
				break;
			}
			/*********************************************************************************
			 * WMS 테이블 입고 취소 END
			 *********************************************************************************/
		
			if(successYN == true) {
				sucCnt++;
			}else {
				failCnt++;
			}
			
			count ++;
		}
	
		// 입고 저장 결과
		rsMap.put("inRsCode", totInRsCode);
		rsMap.put("inRsMsg", totInRsSbMsg.toString());
		
		// 인터페이스 전송 결과
		rsMap.put("ifRsCode", totRsCode);
		rsMap.put("ifRsMsg", totRsSbMsg.toString());
		
		// 입고 성공/실패 카운트
		rsMap.put("totCnt", totCnt);
		rsMap.put("sucCnt", sucCnt);
		rsMap.put("failCnt", failCnt);
		
		log.debug("~~ deleteGR09New last called");
		
		// 입고취소 성공 목록
		StringBuilder sb2 = new StringBuilder(); // 입고 전체완료 확인 sql
		try {
			for(int k = 0 ; k < recvkyList.size() ; k ++){
				if(k != 0){
					sb2.append(",");
				}
				sb2.append("'").append(recvkyList.get(k)).append("'");
			}
			if("".equals(sb2.toString())) {
				sb2.append("' '");
			}
			
			DataMap completeMap = new DataMap();
			completeMap.put("RECVKYS", sb2.toString());
			completeMap.setModuleCommand("WmsInbound", "GR09_CANCEL");
			sucList = commonDao.getList(completeMap);
		}catch(Exception e) {
			log.debug("~~ deleteGR09New.GR09_CANCEL error : " + e.getMessage() );
			e.printStackTrace();
		}
		// 인터페이스 전송 목록
		rsMap.put("sucList", sucList);
		
		// SAP 실적 인터페이스 실패로그
		try {
			log.debug("~~ deleteGR09New.sapIfErrList.size : " + sapIfErrList.size() );
			if(sapIfErrList!=null && sapIfErrList.size()>0) {
				execBatchList("WmsInbound.GR_IF_SAP_LOG_BATCH", sapIfErrList);
			}
		}catch(Exception e) {
			log.debug("~~ deleteGR09New.GR_IF_SAP_LOG_BATCH error : " + e.getMessage() );
			e.printStackTrace();
		}
		
		rsMap.put("count",count);
		
		return rsMap;
		
	}
	
	@Transactional
	public String validationGR09(DataMap map) throws SQLException {
		
		String result = "OK";
		
		List<DataMap> head = map.getList("head"); 					// 입고번호 헤더
		List<DataMap> list = map.getList("list"); 					// 입고번호 아이템
		String headRecvky =  map.getString("headRecvky").trim(); 	// 개별선택한 입고번호
		
		DataMap headRow = new DataMap();
		DataMap itemRow = new DataMap();
		
		StringBuffer hsb = new StringBuffer(); 
		StringBuffer isb = new StringBuffer();
		
		int	sqlLimit = 100;
		int	sqlCount = 1;
		int	sqlTotCount = 1;
		
		for(int i=0;i<head.size();i++){
			headRow = head.get(i).getMap("map");
			
			String recvky = headRow.getString("RECVKY").trim();
			
			if(StringUtils.isNotEmpty(headRecvky) && recvky.equals(headRecvky)) {
				
				int	sqlCountItem = 1;
				int	sqlTotCountItem = 1;
				
				for(int j=0;j<list.size();j++){
					itemRow = list.get(j).getMap("map");
					
					if(isb.length() > 0)
						isb.append(" UNION ALL\n ");
					
						isb.append(" SELECT '").append(map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY)).append("' AS WAREKY, ");	
						isb.append("        '").append(itemRow.getMap("map").get("RECVKY")).append("' AS RECVKY, ");
						isb.append("        '").append(itemRow.getMap("map").get("RECVIT")).append("' AS RECVIT, ");
						isb.append("        '").append(itemRow.getMap("map").get("INDRCN")).append("' AS INDRCN ");
						isb.append(" FROM DUAL ");
						
						if ( sqlCountItem == sqlLimit || sqlTotCountItem == list.size() ){
							map.setModuleCommand("WmsInbound", "GR09VAL_ITEM");  
							map.put("VALIDATION_SQL", isb.toString());
						
							List<DataMap> validList = commonDao.getValidation(map);
							if(validList.size() > 0){
								DataMap valid = validList.get(0);
								return valid.getString("RESULTMSG");
							}
							sqlCountItem = 0;
							isb.setLength(0); ;
						}
						sqlCountItem++;
						sqlTotCountItem++;
					
				}
				
				
			} else {
				
				if(hsb.length() > 0) hsb.append(" UNION ALL\n ");
				
				hsb.append(" SELECT '").append(map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY)).append("' AS WAREKY, ");	
				hsb.append("        '").append(headRow.getMap("map").get("RECVKY")).append("' AS RECVKY, ");
				hsb.append("        '").append(headRow.getMap("map").get("INDRCN")).append("' AS INDRCN ");
				hsb.append(" FROM DUAL ");
					
				if ( sqlCount == sqlLimit || sqlTotCount == head.size() ){
					map.setModuleCommand("WmsInbound", "GR09VAL_HEAD");  
					map.put("VALIDATION_SQL", hsb.toString());
					
					List<DataMap> validList = commonDao.getValidation(map);
					if(validList.size() > 0){
						DataMap valid = validList.get(0);
						return valid.getString("RESULTMSG");
					}
					sqlCount = 0;
					hsb.setLength(0); ;
				}
				sqlCount++;
				sqlTotCount++;
				
			}
			
		}
		
		
		/*
		List<DataMap> list = map.getList("list");
		
		String validationSql = "";
		String key = map.get("key").toString();
		if( map.containsKey("key") ){
			validationSql = util.urlCreateValidationSql(map, key);
			map.put(CommonConfig.VALIDATION_SQL_KEY, validationSql);
			map.setModuleCommand("WmsInbound", "GR09VAL");
						
			List<DataMap> vList = commonDao.getValidation(map);
			
			DataMap rsMap = new DataMap();
			
			for(int j = 0; j < vList.size(); j++){
				rsMap = vList.get(j);
				if( !rsMap.getString("MSG").equals("OK") ){
					result = rsMap.getString("MSG");
					break;
				}
			}
		}
		*/
		
		return result;
	}

