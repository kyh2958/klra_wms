	@Transactional
	public int SendSMS(DataMap map) throws SQLException {
		List<DataMap> list = map.getList("list");
		DataMap row;
		int count = 0;
		for(int i=0;i<list.size();i++){
			row = list.get(i).getMap("map");
			map.putAll(row);
			map.setModuleCommand("WmsInbound", "GR02SMS");
			commonDao.getMap(map);
			
			count ++;
		}
		return count;
	}
	
