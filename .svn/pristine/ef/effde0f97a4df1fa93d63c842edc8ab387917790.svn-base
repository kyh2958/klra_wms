				DataMap iRow = new DataMap();
				String ifid     = H_IFID;
				String logseqno = LOGSEQNO;
				String ui 		= map.get(CommonConfig.MENU_ID_KEY).toString();
				
				for(int i = 0 ; i < ifList.size() ; i ++){
					iRow = ifList.get(i).getMap("map");
					iRow.put("IFID"    , ifid);
					iRow.put("LOGSEQNO", logseqno);
//					iRow.put("OWNRKY", map.get("ownrky"));
					iRow.setModuleCommand("Erpif", "IFWMS223");
					iRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					// 공통
					iRow.put("MANDT",  "100"); // SAP 운영
					iRow.put("ORDCAT", "400"); // 오더카테고리 400
					iRow.put("WERKS",  iRow.get("OWNRKY")); // 화주
					// UI에서 호출시 SKUKEY,  데이터전송(엑셀업로드)시 MATNR 상이함
					iRow.put("MATNR",  (iRow.get("SKUKEY").toString().trim() != "") ? iRow.get("SKUKEY") : iRow.get("MATNR")); // 품목코드
					
					// WMS_IF_401 재고상태변경정보
					iRow.put("BWART", "402"); // 오더유형 - 재고상태변경
					iRow.put("TLOTA02", iRow.get("LOTA02")); iRow.put("TLOTA03", iRow.get("LOTA03")); iRow.put("TLOTA04", iRow.get("LOTA04")); iRow.put("TLOTA05", iRow.get("LOTA05"));
					iRow.put("TLOTA07", iRow.get("LOTA07")); iRow.put("TLOTA08", iRow.get("LOTA08")); iRow.put("TLOTA09", iRow.get("LOTA09")); iRow.put("TLOTA10", iRow.get("LOTA10"));
					iRow.put("TLOTA11", iRow.get("LOTA11")); iRow.put("TLOTA12", iRow.get("LOTA12")); iRow.put("TLOTA13", iRow.get("LOTA13")); iRow.put("TLOTA14", iRow.get("LOTA14")); iRow.put("TLOTA15", iRow.get("LOTA15"));
					iRow.put("TLOTA16", iRow.get("LOTA16")); iRow.put("TLOTA17", iRow.get("LOTA17")); iRow.put("TLOTA18", iRow.get("LOTA18")); iRow.put("TLOTA19", iRow.get("LOTA19")); iRow.put("TLOTA20", iRow.get("LOTA20"));

					// UI에서 호출시 ALOTAXX,  데이터전송(엑셀업로드)시 TLOTAXX 상이함
					iRow.put("TLOTA01",  (iRow.get("ALOTA01").toString().trim() != "") ? iRow.get("ALOTA01") : iRow.get("TLOTA01")); // 재고상태
					iRow.put("TLOTA06",  (iRow.get("ALOTA06").toString().trim() != "") ? iRow.get("ALOTA06") : iRow.get("TLOTA06")); // 재고상태
					
					iRow.put("UI", ui);
					commonDao.insert(iRow);
				}
				*/
				
				
				String ifid = "WMS_IF_401";
				
				DataMap ifMap = new DataMap();
				ifMap.put("list", ifList);
				ifMap.put("IFID", ifid);
				ifMap.put("LOGSEQNO", LOGSEQNO);
				ifMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				String insertErrMsg = iFService.dataInsertIF(ifMap);
				log.debug( "saveGR14.dataInsertIF - Msg : " + insertErrMsg );
				
				if(!"SUCCESS".equals(insertErrMsg)) {
					ifRsCode = "E";
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 저장 에러 : " + getExceptionMsgCut(insertErrMsg, errMsgLen);
				}
				
				//ifidMap = new DataMap();
				
				//ifidMap.put("IFID", ifid);          // IFID 목록
				//ifidMap.put("LOGSEQNO", LOGSEQNO);  // IF 호출 유니크 키 생성
				//ifidList.add(ifidMap);
				
				/******************************************************************************
				 * iFService.insert_IFWMS223(ifMap); 내용 카피 END
				 ******************************************************************************/
				
				//log.debug( "saveGR14.saveGr14 - Msg : " + insertErrMsg );
				log.debug("InboundService.saveGr14 품질상태변경 SAP 인터페이스 저장 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - ifRsMsg : " + ifRsMsg );
				
			} catch(SQLException se) {
				log.error("InboundService.saveGr14 품질상태변경 SAP 인터페이스 저장 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - SQLException Error : " + se.getMessage());
				String errMsg = se.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				ifRsCode = "E";
				ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 저장 에러 : " + cutErrMsg;
				//se.printStackTrace();
			} catch(BadSqlGrammarException bse) {
				log.error("InboundService.saveGr14 품질상태변경 SAP 인터페이스 저장 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - BadSqlGrammarException Error : " + bse.getMessage());
				ifRsCode = "E";
				//bse.printStackTrace();
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 저장 에러 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 저장 에러 : " + cutErrMsg;
				}
			} catch(UncategorizedSQLException bse) {
				log.error("InboundService.saveGr14 품질상태변경 SAP 인터페이스 저장 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - UncategorizedSQLException Error : " + bse.getMessage());
				ifRsCode = "E";
				//bse.printStackTrace();
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 저장 에러 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 저장 에러 : " + cutErrMsg;
				}
			} catch(Exception e) {
				log.error("InboundService.saveGr14 품질상태변경 SAP 인터페이스 저장 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - Exception Error : " + e.getMessage());
				String errMsg = e.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				ifRsCode = "E";
				ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 실적 SAP 인터페이스 저장 에러 : " + cutErrMsg;
				e.printStackTrace();
			}
			
			// 에러 처리
			if("E".equals(ifRsCode)) {
				
				failCnt++;
				
				// 인터페이스 에러 결과 메세지
				totRsCode = ifRsCode;
				totRsSbMsg.append("\n");
				totRsSbMsg.append(ifRsMsg);
				
				transactionManager.rollback(transactionStatus);
				successYN = false;
				log.debug("InboundService.saveGr14 품질상태변경 SAP 인터페이스 저장 에러 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - docSeqQtygod : " + docSeqQtygod + " - rollback");
				
			}
			
		}
		/*********************************************************************************
		 * 인터페이스 전송 테이블 저장 END
		 *********************************************************************************/
		
		/*********************************************************************************
		 * 인터페이스 네트워크 전송  START
		 *********************************************************************************/
		if(null!=ifList&&ifList.size()>0 && successYN == true) {
			// 입고실적등록  인터페이스 호출
			
			// 실적 SAP 인터페이스 전송
			String ifRsCode = "S";
			String ifRsMsg = "";
			
			try {
			
				DataMap logMap = new DataMap();
				DataMap qMap = new DataMap();
				String result = "";
				
				// 통신로그
				String logStep = "통신로그 및 SEQNO 채번";
				logMap.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
				logMap.put("IFID", H_IFID);
				logMap.put("COMSTAT", "C"); //호출
				logMap.put("SEQNO", LOGSEQNO);
				commonDao.insert(logMap);
				
				qMap.put("IFID", "WMS_IF_401");
				qMap.put("LOGSEQNO", LOGSEQNO);
				// LOGSEQNO단위 SEQNO ASC 순으로 데이터 전송
				result = iFService.send_IFWMS223(qMap);
	//			log.debug("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"+result);
				if(result.equals("SUCCESS")) {
					// 통신로그 수정
					logStep = "통신로그 수정";
					logMap.put("COMSTAT", "R");
					logMap.put("REMARK", "LOGSEQNO[" + LOGSEQNO + "]건"); //
				} else {
					logMap.put("COMSTAT", "E");
					logMap.put("ERRTXT", "LOGSEQNO[" + LOGSEQNO + "]건 처리에러 : " + result); //
					
					successYN = false;
					ifRsCode = "E";
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "]  품질상태변경 SAP 인터페이스 전송 에러 : " + result;
				}
				commonDao.update(logMap);
				
				if(result.equals("SUCCESS")) {
					transactionManager.commit(transactionStatus);
					log.debug("InboundService.saveGr14 품질상태변경 SAP 인터페이스 전송 - recvky : " + H_RECVKY + " - commit");
				}
			
			log.debug("InboundService.saveGr14 품질상태변경 SAP 인터페이스 전송 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - ifRsMsg : " + ifRsMsg );
			} catch(SQLException se) {
				log.error("InboundService.saveGr14 품질상태변경 SAP 인터페이스 전송 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - SQLException Error : " + se.getMessage());
				String errMsg = se.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				ifRsCode = "E";
				ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "]  품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				//se.printStackTrace();
			} catch(BadSqlGrammarException bse) {
				log.error("InboundService.saveGr14 품질상태변경 SAP 인터페이스 전송 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - BadSqlGrammarException Error : " + bse.getMessage());
				ifRsCode = "E";
				//bse.printStackTrace();
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				}
			} catch(UncategorizedSQLException bse) {
				log.error("InboundService.saveGr14 품질상태변경 SAP 인터페이스 전송 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - UncategorizedSQLException Error : " + bse.getMessage());
				ifRsCode = "E";
				//bse.printStackTrace();
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "]  품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				}	
			} catch(Exception e) {
				log.error("InboundService.saveGr14 품질상태변경 SAP 인터페이스 전송 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - ifid : " + H_IFID + " - Exception Error : " + e.getMessage());
				String errMsg = e.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				ifRsCode = "E";
				ifRsMsg = "recvky[" + H_RECVKY + "] recvit[" + H_RECVIT + "] 품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				//e.printStackTrace();
			}
			
			// 에러 처리
			if("E".equals(ifRsCode)) {
				
				failCnt++;
				
				// 인터페이스 에러 결과 메세지
				totRsCode = ifRsCode;
				totRsSbMsg.append("\n");
				totRsSbMsg.append(ifRsMsg);
				
				if(!transactionStatus.isCompleted()) {
					transactionManager.rollback(transactionStatus);
				}
				successYN = false;
				log.debug("InboundService.saveGr14 품질상태변경 SAP 인터페이스 전송 에러 - recvky : " + H_RECVKY + " - recvit : " + H_RECVIT + " - sebeln : " + docSeqQtygod + " - rollback");
				
				// sap if error log
				sapIfErrMap = new HashMap();
				sapIfErrMap.putAll(head);
				sapIfErrMap.put("ERRTXT",ifRsMsg);
				sapIfErrMap.put("PROGID",map.getString("PROGID"));					
				sapIfErrList.add(sapIfErrMap);
				
			}
			
		}
		
		/*********************************************************************************
		 * 인터페이스 네트워크 전송  END
		 *********************************************************************************/
		
		if(successYN == true) {
			sucCnt++;
			
			// 전체 완료가 되면 품질 상태변경 완료 처리
			head.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			head.setModuleCommand("WmsInbound", "GR14_COMPLETE");
			head.put("CHKRST", "QF");
			
			commonDao.update(head);
			
		}else {
			failCnt++;
		}
		
		// SAP 실적 인터페이스 오류 로그
		try {
			log.debug("~~ saveGr14.sapIfErrList.size : " + sapIfErrList.size() );
			if(sapIfErrList!=null && sapIfErrList.size()>0) {
				execBatchList("WmsInbound.GR_IF_SAP_LOG_BATCH", sapIfErrList);
			}
		}catch(Exception e) {
			log.debug("~~ saveGr14.GR_IF_SAP_LOG_BATCH error : " + e.getMessage() );
			e.printStackTrace();
		}
		
		
		StringBuilder sb = new StringBuilder();
		sb.append("'").append(docSeqQtygod).append("'");
		//sb.append(",'").append(docSeqQtybad).append("'");
		
		rsMap.put("SADJKY", sb.toString());
		//rsMap.put("ifidList",ifidList);
		
		if(successYN==true) {
			rsMap.put("ERRCODE", "S");
			rsMap.put("ERRMSG", "SUCCESS");
		}else {
			rsMap.put("ERRCODE", "E");
			rsMap.put("ERRMSG", totInRsSbMsg.toString() + totRsSbMsg.toString());
		}
		
		return rsMap;
	}
	
	/**************************************************************************
	 * 2022-08-17 품질검사 결과 품질 상태변경 : 오더별 트랜잭션 나눈버전
	 *  - 입고유형별 로 인터페이스 데이터가 그룹으로 나뉘어서 SAP로 인터페이스 전송 되면 롤백 부분 롤백 불가로 
	 *    헤더 기준으로 트랜잭션 나뉘어져야함. 
	 **************************************************************************/
	public DataMap saveGr14New(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();
		
		DataMap head = map.getMap("head").getMap("map");
		
		DataMap godHeadMap = new DataMap();  // 품질 상태 변경 - 정상 헤드
		DataMap badHeadMap = new DataMap();  // 품질 상태 변경 - 불량 헤드
		
		List<DataMap> itemList = map.getList("list");
		
		List<DataMap> ifList = new ArrayList<DataMap>();       // IF 실적 : 실적 인터페이스 목록
		
		DataMap row = new DataMap();
		DataMap gmRow = new DataMap();
		DataMap gpRow = new DataMap();
		DataMap bmRow = new DataMap();
		DataMap bpRow = new DataMap();
		
		String hQtyGod = "";
		String hQtyBad = "";
		String hIfId   = "";
		String hRecvKy = ""; // 입고키
		String hRecvIt = ""; // 입고아이템키
		String hLogSeqNo = ""; // 품질검사결과 수신시 로그번호
		String hSeqno   = "";
		
		String tblNm = ""; // 테이블 이름(IFWMS109:품질검사결과,IFWMS108:순회품질검사결과)
		
		String sadjky = "";  // 재고조정문서 번호
		String logSeqNo = ""; // 신규 전송시 로그번호
		
		String wareky = ""; // 거점 WAREKY
		String docdat = ""; // DOCDAT
		
		int totCnt = 0;         // 입고 전체 건수
		int sucCnt = 0;         // 입고 성공 건수 
		int failCnt = 0;        // 입고 성공 건수
		int errMsgLen = 500;    // 에러메세지 길이
		
		String totInRsCode = "S";    // 입고테이블 insert 결과 코드
		StringBuffer totInRsSbMsg = new StringBuffer(); // 입고테이블 insert 결과 메세지
		
		String totRsCode = "S";    // 인터페이스 결과 코드
		StringBuffer totRsSbMsg = new StringBuffer(); // 인터페이스 결과 메세지
		
		String inRsCode = "";
		String inRsMsg = "";
		
		List<Map> sapIfErrList = new ArrayList();               // Batch SAP IF ERROR List
		Map sapIfErrMap = new HashMap();                        // Batch SAP IF ERROR Map
		
		boolean successYN = true;            // 헤더 별 저장 및 인터페이스 전송 성공 여부
		
		TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
		TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
		
		/*********************************************************************************
		 * 품질상태변경 저장 START
		 *********************************************************************************/
		try {
			
			hQtyGod = head.getString("QTYGOD");
			hQtyBad = head.getString("QTYBAD");
			hIfId   = head.getString("IFID");
			hRecvKy = head.getString("RECVKY");
			hRecvIt = head.getString("RECVIT");
			tblNm = head.getString("TBLNM");
			wareky = head.getString("WAREKY");
			docdat = head.getString("DOCDAT");
			hLogSeqNo = head.getString("LOGSEQNO");
			hSeqno = head.getString("SEQNO");
			
			logSeqNo = getLOGSEQNO();
			
			log.debug("LOGSEQNO : " + logSeqNo);
			
			// 상태 체크
			head.setModuleCommand("WmsInbound", "GR14_VAL");
			DataMap valMap = commonDao.getMap(head);
			String ITFFLG = valMap.getString("ITFFLG");
			String PRCFLG = valMap.getString("PRCFLG");
			
			if(!"C".equals(ITFFLG)||!"C".equals(PRCFLG)) {
				rsMap.put("SADJKY", "");
				//rsMap.put("ifidList",ifidList);
				rsMap.put("ERRCODE", "E");
				rsMap.put("ERRMSG", "VALID_M2006"); // 품질결과정보가 변경된 품목입니다. 재조회 후 처리해주세요.
				return rsMap;
			}
			
			
			// 품질상태 정상
			godHeadMap.putAll(head);
			
			
			head.setModuleCommand("WmsInventory", "ADJDH");
			head.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
