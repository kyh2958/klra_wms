				logMap.put("IFID", ifid);
				logMap.put("COMSTAT", "C"); //호출
				logMap.put("SEQNO", logSeqNo);
				commonDao.insert(logMap);
				
				qMap.put("IFID", ifid);
				qMap.put("LOGSEQNO", logSeqNo);
				// LOGSEQNO단위 SEQNO ASC 순으로 데이터 전송
				result = iFService.send_IFWMS223(qMap);
	//			log.debug("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"+result);
				
				
				// 오류시 상태복원후 CHKRST=QR로 변경해서 GR14 품질검사결과관리 화면에서 처리되도록
				// CHKRSTG : 정상SAP처리결과, CHKRSTB : 보류(불량)SAP처리결과
				//errMap.setModuleCommand("Erpif", "IFWMS109_CHKRST");
				// tblNm : 테이블 이름(IFWMS109:품질검사결과,IFWMS108:순회품질검사결과)
				errMap.setModuleCommand("WmsInbound", tblNm+"_CHKRST");
				errMap.put("IFID", ifid);
				errMap.put("CHKRST", "QR");
				errMap.put("IF_KEY", logSeqNo);
				errMap.put("IF_KEY_REF", hLogSeqNo);
				errMap.put("SEQNO", hSeqno);
				
				errMap.put("SADJKY", sadjky);
				commonDao.update(errMap);
				
				
				
				if(result.equals("SUCCESS")) {
					// 통신로그 수정
					logStep = "통신로그 수정";
					logMap.put("COMSTAT", "R");
					logMap.put("REMARK", "[GR14]LOGSEQNO[" + logSeqNo + "]건"); //
				} else {
					//logMap.put("COMSTAT", "E");
					//logMap.put("ERRTXT", "LOGSEQNO[" + logSeqNo + "]건 처리에러 : " + result); //
					
					// 상태원복
					DataMap rbStatus = new DataMap();
					rbStatus.put("SES_USER_ID", ifid);
					
					List<DataMap> cancelList = new ArrayList<>();
					
					DataMap cancelMap = new DataMap();
					cancelMap.put("DOCCAT", "400");
					cancelMap.put("DOCUTY", "402");
					cancelMap.put("SADJKY", sadjky);
					cancelMap.put("WAREKY", wareky);
					cancelMap.put("DOCDAT", docdat);
					
					cancelList.add(cancelMap);
					rbStatus.put("headList", cancelList);
					
					String rs = "";
					try {
						rs = inventoryService.cancelAdjustWMSONLY(rbStatus);
					} catch (Exception e) {
						rs = e.getMessage();
						if(rs != null && rs.length() > 200) { rs = rs.substring(0, 200); }
					}
					
					// 상태원복 오류시 방법없음
					//IFWMSLOG
					logMap.setModuleCommand("Erpif", "IFWMSLOG");
					logMap.put("COMSTAT", "E");
					logMap.put("ERRTXT", "[GR14]LOGSEQNO[" + logSeqNo + "]건 처리에러 : " + result + ", 재고상태원복결과 : " + rs); //
					logMap.put("REMARK", "[GR14]LOGSEQNO[" + logSeqNo + "]건"); //
					
					successYN = false;
					ifRsCode = "E";
					ifRsMsg = "recvky[" + hRecvKy + "] recvit[" + hRecvIt + "]  품질상태변경 SAP 인터페이스 전송 에러 : " + result + ", 재고상태원복결과 : " + rs;
				}
				commonDao.update(logMap);
				
				if(result.equals("SUCCESS")) {
					transactionManager.commit(transactionStatus);
					log.debug("InboundService.saveGr14New 품질상태변경 SAP 인터페이스 전송 - recvky : " + hRecvKy + " - commit");
				}else {
					if(!transactionStatus.isCompleted()) {
						transactionManager.commit(transactionStatus);
						log.debug("InboundService.saveGr14New 품질상태변경 SAP 인터페이스 전송 - recvky : " + hRecvKy + " - recvit : " + hRecvIt + " - ifid : " + hIfId + " - ifRsMsg : " + ifRsMsg + " - commit");
					}
				}
				
			} catch(SQLException se) {
				log.error("InboundService.saveGr14New 품질상태변경 SAP 인터페이스 전송 - recvky : " + hRecvKy + " - recvit : " + hRecvIt + " - ifid : " + hIfId + " - SQLException Error : " + se.getMessage());
				String errMsg = se.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				ifRsCode = "E";
				ifRsMsg = "recvky[" + hRecvKy + "] recvit[" + hRecvIt + "]  품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				//se.printStackTrace();
			} catch(BadSqlGrammarException bse) {
				log.error("InboundService.saveGr14New 품질상태변경 SAP 인터페이스 전송 - recvky : " + hRecvKy + " - recvit : " + hRecvIt + " - ifid : " + hIfId + " - BadSqlGrammarException Error : " + bse.getMessage());
				ifRsCode = "E";
				//bse.printStackTrace();
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + hRecvKy + "] recvit[" + hRecvIt + "] 품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + hRecvKy + "] recvit[" + hRecvIt + "] 품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				}
			} catch(UncategorizedSQLException bse) {
				log.error("InboundService.saveGr14New 품질상태변경 SAP 인터페이스 전송 - recvky : " + hRecvKy + " - recvit : " + hRecvIt + " - ifid : " + hIfId + " - UncategorizedSQLException Error : " + bse.getMessage());
				ifRsCode = "E";
				//bse.printStackTrace();
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + hRecvKy + "] recvit[" + hRecvIt + "]  품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsMsg = "recvky[" + hRecvKy + "] recvit[" + hRecvIt + "] 품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				}	
			} catch(Exception e) {
				log.error("InboundService.saveGr14New 품질상태변경 SAP 인터페이스 전송 - recvky : " + hRecvKy + " - recvit : " + hRecvIt + " - ifid : " + hIfId + " - Exception Error : " + e.getMessage());
				String errMsg = e.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				ifRsCode = "E";
				ifRsMsg = "recvky[" + hRecvKy + "] recvit[" + hRecvIt + "] 품질상태변경 SAP 인터페이스 전송 에러 : " + cutErrMsg;
				e.printStackTrace();
			}
			
			// 에러 처리
			if("E".equals(ifRsCode)) {
				
				failCnt++;
				
				// 인터페이스 에러 결과 메세지
				totRsCode = ifRsCode;
				totRsSbMsg.append("\n");
				totRsSbMsg.append(ifRsMsg);
				
				if(!transactionStatus.isCompleted()) {
					//transactionManager.rollback(transactionStatus);
					transactionManager.commit(transactionStatus);					
				}
				successYN = false;
				//log.debug("InboundService.saveGr14New 품질상태변경 SAP 인터페이스 전송 에러 - recvky : " + hRecvKy + " - recvit : " + hRecvIt + " - sadjky : " + sadjky + " - rollback");
				log.debug("InboundService.saveGr14New 품질상태변경 SAP 인터페이스 전송 에러 - recvky : " + hRecvKy + " - recvit : " + hRecvIt + " - sadjky : " + sadjky + " - commit");
				
				// sap if error log
				sapIfErrMap = new HashMap();
				sapIfErrMap.putAll(head);
				sapIfErrMap.put("ERRTXT",ifRsMsg);
				sapIfErrMap.put("PROGID",map.getString("PROGID"));					
				sapIfErrList.add(sapIfErrMap);
				
			}
			
		}
		
		/*********************************************************************************
		 * 인터페이스 네트워크 전송  END
		 *********************************************************************************/
		
		if(successYN == true) {
			sucCnt++;
			
			// 전체 완료가 되면 품질 상태변경 완료 처리
			head.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			head.setModuleCommand("WmsInbound", "GR14_COMPLETE");
			head.put("CHKRST", "QF");
			
			commonDao.update(head);
			
		}else {
			failCnt++;
		}
		
		/*
		// 롤백 안하게 변경되어 rolback 로그에 쌓지 않음.
		// SAP 실적 인터페이스 오류 로그
		try {
			log.debug("~~ saveGr14.sapIfErrList.size : " + sapIfErrList.size() );
			if(sapIfErrList!=null && sapIfErrList.size()>0) {
				execBatchList("WmsInbound.GR_IF_SAP_LOG_BATCH", sapIfErrList);
			}
		}catch(Exception e) {
			log.debug("~~ saveGr14.GR_IF_SAP_LOG_BATCH error : " + e.getMessage() );
			e.printStackTrace();
		}
		*/
		
		StringBuilder sb = new StringBuilder();
		sb.append("'").append(sadjky).append("'");
		//sb.append(",'").append(sadjky).append("'");
		
		rsMap.put("SADJKY", sb.toString());
		//rsMap.put("ifidList",ifidList);
		
		if(successYN==true) {
			rsMap.put("ERRCODE", "S");
			rsMap.put("ERRMSG", "SUCCESS");
		}else {
			rsMap.put("ERRCODE", "E");
			rsMap.put("ERRMSG", totInRsSbMsg.toString() + totRsSbMsg.toString());
		}
		
		return rsMap;
	}

	
	@Transactional
	public DataMap saveGr00(DataMap map) throws Exception {
		List<DataMap> head = map.getList("head");
		List<DataMap> itemList = map.getList("list");
		List<DataMap> selectList = new ArrayList<DataMap>();
		String headAsndky = map.get("headAsndky").toString();
		
		if(headAsndky.equals(itemList.get(0).getMap("map").getString("ASNDKY"))){
			selectList = itemList;
		} 
		
		int count = 0;
		int itemCount = 0;
		
		DataMap row;
		DataMap itemRow;
		
		List docNumList = new ArrayList();
		DataMap rsMap = new DataMap();
		
		
		for(int i = 0 ; i < head.size() ; i ++){
			if(head.get(i).getMap("map").getString("ASNDKY").equals(headAsndky)){
				
				//validation
				if(selectList.size() > 0){
					// Validation
					StringBuffer sb = new StringBuffer();
					for(DataMap item : selectList){
						if(sb.length() > 0) 
							sb.append(" UNION ALL\n ");
						
						sb.append(" SELECT '").append(head.get(i).getMap("map").get("SEBELN")).append("' AS SEBELN, ");
						sb.append("        '").append(item.getMap("map").get("SEBELP")).append("' AS SEBELP, ");
						sb.append("        '").append(head.get(i).getMap("map").get("DOCUTY")).append("' AS RCPTTY, ");
						sb.append("        '").append(head.get(i).getMap("map").get("WAREKY")).append("' AS WAREKY, ");
						sb.append("        '").append(head.get(i).getMap("map").get("OWNRKY")).append("' AS OWNRKY, ");
						sb.append("        '").append(head.get(i).getMap("map").get("DPTNKY")).append("' AS DPTNKY, ");
						sb.append("        '").append(item.getMap("map").get("LOCAKY")).append("' AS LOCAKY, ");
						sb.append("        '").append(item.getMap("map").get("SKUKEY")).append("' AS SKUKEY, ");
						sb.append("         ").append(item.getMap("map").get("QTYRCV")).append("  AS QTYRCV, ");
						sb.append("        '").append(item.getMap("map").get("UOMKEY")).append("' AS UOMKEY FROM DUAL ");
					}
					
					map.setModuleCommand("WmsInbound", "GOODS_RECEIPT"); // 쿼리키값 넣을것
					map.put("APPEND_QUERY", sb.toString());
					map.put("RCPTTY", head.get(i).getMap("map").get("DOCUTY"));
					List<DataMap> validList = commonDao.getValidation(map);
					if(validList.size() > 0){
						DataMap valid = validList.get(0);
						
						return valid;
					}
				}

				row = head.get(i).getMap("map");
				String docNum = wmsService.getDocSeq("112");
				docNumList.add(docNum);
				
				row.put("RECVKY", docNum);
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				row.setModuleCommand("WmsInbound", "GR01");
				
				commonDao.insert(row);
								
				for(int k = 0 ; k < selectList.size() ; k ++){
					itemRow = selectList.get(k).getMap("map");
					itemRow.put("RECVKY", docNum);
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					itemRow.setModuleCommand("WmsInbound", "GR01Sub");
					
					itemCount += 10;
					String snum = String.valueOf(itemCount);
					String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
					
					itemRow.put("RECVIT", inum);
					itemRow.put("AREAKY", head.get(i).getMap("map").getString("AREAKY"));
					itemRow.put("ASNDAT", head.get(i).getMap("map").getString("ASNDAT"));
	
					commonDao.insert(itemRow);
				}
				itemCount = 0;
			}else{
				row = head.get(i).getMap("map");
				map.clonSessionData(row);
				
				String docNum = wmsService.getDocSeq("112");
				docNumList.add(docNum);
				
				row.put("RECVKY", docNum);
				row.setModuleCommand("WmsInbound", "GR01");
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				commonDao.insert(row);

				row.setModuleCommand("WmsInbound", "GR00Sub");
				
				List<DataMap> list = commonDao.getList(row); 
				
				for(int j = 0 ; j < list.size() ; j ++){
					itemRow = list.get(j);
					itemRow.put("RECVKY", docNum);
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					itemRow.setModuleCommand("WmsInbound", "GR01Sub");
					
					itemCount += 10;
					String snum = String.valueOf(itemCount);
					String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
					
					itemRow.put("RECVIT", inum);
					itemRow.put("AREAKY", head.get(i).getMap("map").getString("AREAKY"));
					itemRow.put("ASNDAT", head.get(i).getMap("map").getString("ASNDAT"));
					commonDao.insert(itemRow);
				}
				itemCount = 0;
		}
		
		StringBuilder sb = new StringBuilder();
		for(int k = 0 ; k < docNumList.size() ; k ++){
			if(k != 0){
				sb.append(",");
			}
			sb.append("'").append(docNumList.get(k)).append("'");
		}
		rsMap.put("RECVKY", sb.toString());
		}
		return rsMap;
	}
	
	@Transactional
	public DataMap saveGr01(DataMap map) throws Exception {
		List<DataMap> head = map.getList("head");
		List<DataMap> itemList = map.getList("list");
		List<DataMap> selectList = new ArrayList<DataMap>();
		String headSebeln = map.get("headSebeln").toString();
			
		int count = 0;
		int itemCount = 0;
		
		DataMap row;
		DataMap itemRow;
		
		List docNumList = new ArrayList();
		DataMap rsMap = new DataMap();
		
		for(int i = 0 ; i < head.size() ; i ++){
			if(head.get(i).getMap("map").getString("SEBELN").equals(headSebeln)){
				
				//validation
				if(headSebeln.equals(itemList.get(0).getMap("map").getString("SEBELN"))){
					selectList = itemList;
				} 
				
				if(selectList.size() > 0){
					// Validation
					StringBuffer sb = new StringBuffer();
					for(DataMap item : selectList){
						if(sb.length() > 0) 
							sb.append(" UNION ALL\n ");
						
						sb.append(" SELECT '").append(head.get(i).getMap("map").get("SEBELN")).append("' AS SEBELN, ");
						sb.append("        '").append(item.getMap("map").get("SEBELP")).append("' AS SEBELP, ");
						sb.append("        '").append(head.get(i).getMap("map").get("DOCUTY")).append("' AS RCPTTY, ");
						sb.append("        '").append(head.get(i).getMap("map").get("WAREKY")).append("' AS WAREKY, ");
						sb.append("        '").append(head.get(i).getMap("map").get("OWNRKY")).append("' AS OWNRKY, ");
						sb.append("        '").append(head.get(i).getMap("map").get("DPTNKY")).append("' AS DPTNKY, ");
						sb.append("        '").append(item.getMap("map").get("LOCAKY")).append("' AS LOCAKY, ");
						sb.append("        '").append(item.getMap("map").get("SKUKEY")).append("' AS SKUKEY, ");
						sb.append("         ").append(item.getMap("map").get("QTYRCV")).append("  AS QTYRCV, ");
						sb.append("        '").append(item.getMap("map").get("UOMKEY")).append("' AS UOMKEY FROM DUAL ");
					}
					
					map.setModuleCommand("WmsInbound", "GOODS_RECEIPT"); // 쿼리키값 넣을것
					map.put("APPEND_QUERY", sb.toString());
					map.put("RCPTTY", head.get(i).getMap("map").get("DOCUTY"));
					List<DataMap> validList = commonDao.getValidation(map);
					if(validList.size() > 0){
						DataMap valid = validList.get(0);
						
						return valid;
					}
				}// validation 끝

				row = head.get(i).getMap("map");
				String docNum = wmsService.getDocSeq("101");
//				String docNum = wmsService.getDocSeq("166");
				docNumList.add(docNum);
				
				row.put("RECVKY", docNum);
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				row.setModuleCommand("WmsInbound", "GR01");
				
				commonDao.insert(row);
								
				for(int k = 0 ; k < selectList.size() ; k ++){
					itemRow = selectList.get(k).getMap("map");
					itemRow.put("RECVKY", docNum);
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					itemRow.setModuleCommand("WmsInbound", "GR01Sub");
					
					itemCount += 10;
					String snum = String.valueOf(itemCount);
					String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
					
					itemRow.put("RECVIT", inum);
					itemRow.put("AREAKY", head.get(i).getMap("map").getString("AREAKY"));
					itemRow.put("ASNDAT", head.get(i).getMap("map").getString("ASNDAT"));
	
					commonDao.insert(itemRow);
				}
				itemCount = 0;
			}else{
				row = head.get(i).getMap("map");
				map.clonSessionData(row);
				
				String docNum = wmsService.getDocSeq("102");
				docNumList.add(docNum);
				
				row.put("RECVKY", docNum);
				row.setModuleCommand("WmsInbound", "GR01");
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				commonDao.insert(row);

				row.setModuleCommand("WmsInbound", "GR01Sub");
				
				List<DataMap> list = commonDao.getList(row); 
				
				for(int j = 0 ; j < list.size() ; j ++){
					itemRow = list.get(j);
					itemRow.put("RECVKY", docNum);
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					itemRow.setModuleCommand("WmsInbound", "GR01Sub");
					
					itemCount += 10;
					String snum = String.valueOf(itemCount);
					String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
					
					itemRow.put("RECVIT", inum);
					itemRow.put("AREAKY", head.get(i).getMap("map").getString("AREAKY"));
					itemRow.put("ASNDAT", head.get(i).getMap("map").getString("ASNDAT"));
					commonDao.insert(itemRow);
				}
				itemCount = 0;
		}
		
		StringBuilder sb = new StringBuilder();
		for(int k = 0 ; k < docNumList.size() ; k ++){
			if(k != 0){
				sb.append(",");
			}
			sb.append("'").append(docNumList.get(k)).append("'");
		}
		rsMap.put("RECVKY", sb.toString());
		}
		return rsMap;
	}

