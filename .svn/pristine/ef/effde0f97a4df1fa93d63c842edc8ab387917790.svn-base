	@Transactional
	public DataMap deleteGR40(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();                         	// return Map
		
		List<DataMap> head = map.getList("head"); 				// 입고번호 아이템
		
		int count = 0;
		
		DataMap headRow = new DataMap();
		
		for(int i=0;i<head.size();i++){
		
			headRow = head.get(i).getMap("map");
			headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			// 아이템이 삭제
			headRow.setModuleCommand("WmsInbound", "GR09DELETE");
			commonDao.update(headRow);
			
			// 아이템이 모두 삭제되면 헤더도 삭제
			headRow.setModuleCommand("WmsInbound", "RECDI_ITEMCNT");
			int cnt = commonDao.getCount(headRow);
			if(cnt == 0) {
				headRow.setModuleCommand("WmsInbound", "GR09DELETEHEADER");
				commonDao.update(headRow);
			}
			
			// 밀롤 입고 예정정보 상태 전체 강제 입고 가능하게 업데이트
			headRow.setModuleCommand("WmsInbound", "GR40_CANCEL");
			commonDao.update(headRow);
			
			// ROLLMA 컨테이너 단위 초기화
			headRow.put("CONTNO", headRow.getString("SIGNI"));
			headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
			commonDao.update(headRow);
			
			// 유저 신규 추가 ROLLMA 데이터 삭제
			headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
			commonDao.delete(headRow);
			
			count ++;
			
		}
		
		rsMap.put("count",count);
		
		return rsMap;
		
	}
	
	/**************************************************************************
	 * 2022-07-05 입고취소 : 오더별 트랜잭션 나눈버전. 롤백 후 후처리 추가
	 *  - 입고유형별 로 인터페이스 데이터가 그룹으로 나뉘어서 SAP로 인터페이스 전송 되면 롤백 부분 롤백 불가로 
	 *    헤더 기준으로 트랜잭션 나뉘어져야함. 
	 **************************************************************************/
	public DataMap deleteGR40New(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();                         	// return Map
		
		List<DataMap> head = map.getList("head"); 				// 입고번호 아이템
		List<DataMap> list = new ArrayList<DataMap>(); 			// 입고번호 아이템
		
		int count = 0;
		
		List<DataMap> ifidSapList = new ArrayList<DataMap>();   // IFID : SAP 인터페이스 전송 목록
		List<DataMap> ifidOtrList = new ArrayList<DataMap>();   // IFID : 실적(SAP 제외)인터페이스 전송 목록
		
		List<String> rcpttySapList = new ArrayList<String>();   // IF 실적 : 입고유형 SAP
		DataMap rcpttySapMap = new DataMap();                   // IF 실적 : 입고유형별 입고헤더키 SAP
		List<String> rcpttyOtrList = new ArrayList<String>();   // IF 실적 : 입고유형(SAP,PORTAL 제외)
		DataMap rcpttyOtrMap = new DataMap();                   // IF 실적 : 입고유형별 입고헤더키(SAP,PORTAL 제외)
		
		DataMap headRow = new DataMap();
		DataMap itemRow = new DataMap();
		
		List<Map> sapIfErrList = new ArrayList();               // Batch SAP IF ERROR List
		Map sapIfErrMap = new HashMap();                        // Batch SAP IF ERROR Map
		
		List<String> recvkyList = new ArrayList();              // return RECVKY List
		
		List<DataMap> sucList = new ArrayList<DataMap>();       // 입고 취소 성공 목록
		
		int totCnt = 0;         // 입고 전체 건수
		int sucCnt = 0;         // 입고 성공 건수 
		int failCnt = 0;        // 입고 성공 건수
		
		int errMsgLen = 500;    /// 에러메세지 길이
		
		String totInRsCode = "S";    					// 입고테이블 insert 결과 코드
		StringBuffer totInRsSbMsg = new StringBuffer(); // 입고테이블 insert 결과 메세지
		
		String totRsCode = "S";    						// 인터페이스 결과 코드
		StringBuffer totRsSbMsg = new StringBuffer(); 	// 인터페이스 결과 메세지
		
		
		for(int i=0;i<head.size();i++){
		
			TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
			TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
			
			headRow = head.get(i).getMap("map");
			headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			
			// 입고 테이블 insert 결과
			String inRsCode = "S";
			String inRsMsg = "";
			
			String recvky = headRow.getString("RECVKY");
			
			boolean successYN = true;            // 헤더 별 저장 및 인터페이스 전송 성공 여부
			
			recvkyList.add(recvky); 			// 오더별 입고 전체 완료 확인 위해 필요 
			
			/*********************************************************************************
			 * WMS 테이블 입고 취소 START
			 *********************************************************************************/
			try {
			
				// 아이템이 삭제
				headRow.setModuleCommand("WmsInbound", "GR09DELETE");
				commonDao.update(headRow);
				
				// 아이템이 모두 삭제되면 헤더도 삭제
				headRow.setModuleCommand("WmsInbound", "RECDI_ITEMCNT");
				int cnt = commonDao.getCount(headRow);
				if(cnt == 0) {
					headRow.setModuleCommand("WmsInbound", "GR09DELETEHEADER");
					commonDao.update(headRow);
				}
				
				// 밀롤 입고 예정정보 상태 전체 강제 입고 가능하게 업데이트
				headRow.setModuleCommand("WmsInbound", "GR40_CANCEL");
				commonDao.update(headRow);
				
				// ROLLMA 컨테이너 단위 초기화
				headRow.put("CONTNO", headRow.getString("SIGNI"));
				headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
				commonDao.update(headRow);
				
				// 유저 신규 추가 ROLLMA 데이터 삭제
				headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
				commonDao.delete(headRow);
			
			
			log.debug("InboundService.deleteGR40New 밀롤 WMS 테이블 입고 취소 저장 성공 - recvky : " + recvky);
			
			} catch(SQLException se) {
				log.error("InboundService.deleteGR40New 밀롤 WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - SQLException Error : " + se.getMessage());
				String errMsg = se.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				
				inRsCode = "E";
				inRsMsg = "[" + recvky + "] 밀롤 WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				//se.printStackTrace();
			} catch(BadSqlGrammarException bse) {
				log.error("InboundService.deleteGR40New 밀롤 WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - BadSqlGrammarException Error : " + bse.getMessage());
				inRsCode = "E";
				//bse.printStackTrace();
				
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] 밀롤 WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] 밀롤 WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}
			} catch(UncategorizedSQLException bse) {
				log.error("InboundService.deleteGR40New 밀롤 WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - UncategorizedSQLException Error : " + bse.getMessage());
				inRsCode = "E";
				//bse.printStackTrace();
				
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] 밀롤 WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] 밀롤 WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}
			} catch(Exception e) {
				log.error("InboundService.deleteGR40New 밀롤 WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - Exception Error : " + e.getMessage());
				String errMsg = e.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				inRsCode = "E";
				inRsMsg = "[" + recvky + "] 밀롤 WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				e.printStackTrace();
			}
			
			// 에러 처리
			if("E".equals(inRsCode)) {
				
				failCnt++;
				// 인터페이스 에러 결과 메세지
				totInRsCode = inRsCode;
				totInRsSbMsg.append("\n");
				totInRsSbMsg.append(inRsMsg.toString());
				
				transactionManager.rollback(transactionStatus);
				successYN = false;
				log.debug(i + " - InboundService.deleteGR40New 밀롤 WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - rollback");
				//continue;
				break;
			}
			/*********************************************************************************
			 * WMS 테이블 입고 취소 END
			 *********************************************************************************/
			/*
			if(1==1) {
				sucCnt++;
				transactionManager.commit(transactionStatus);
				log.debug(i + " - InboundService.deleteGR40New 밀롤 입고 취소 실적 SAP 인터페이스 저장 - recvky : " + recvky + " - commit");
				break;
			}
			*/
			
			rcpttySapList = new ArrayList<String>();   // IF 실적 : 입고유형 SAP
			rcpttySapMap  = new DataMap();             // IF 실적 : 입고유형별 입고헤더키 SAP
			rcpttyOtrList = new ArrayList<String>();   // IF 실적 : 입고유형(SAP,PORTAL 제외)
			rcpttyOtrMap  = new DataMap();             // IF 실적 : 입고유형별 입고헤더키(SAP,PORTAL 제외)
			
			ifidSapList = new ArrayList<DataMap>();    // IFID : SAP 인터페이스 전송 목록
			ifidOtrList = new ArrayList<DataMap>();    // IFID : 실적(SAP 제외)인터페이스 전송 목록
			/*********************************************************************************
			 * 인터페이스 전송 테이블 저장 START
			 *********************************************************************************/
			// 입고 취소시 실적 IF 데이터 추출
			String I_OWNRKY 	= headRow.getString("OWNRKY");
			String I_RECVKY 	= headRow.getString("RECVKY");
			String I_RCPTTY 	= headRow.getString("RCPTTY");      // 입고유형
			String I_IFID_SAP   = headRow.getString("IFID_SAP");    // 실적 SAP IF_ID
			String I_IFID_OTR   = headRow.getString("IFID_OTR");   	// 실적 IF_ID(SAP,PORTAL 제외)
			
			// IF 실적 SAP 입고유형별 입고키 넣기
			if(I_IFID_SAP!=null && !"".equals(I_IFID_SAP.trim())) {
				
				// 실적 SAP 인터페이스 전송
				String ifRsCode = "S";
				String ifRsMsg = "";
				
				try {
					
					rcpttySapList.add(I_RCPTTY);
					rcpttySapMap.put(I_RCPTTY,""+I_RECVKY+"");
					rcpttySapMap.put(I_RCPTTY+"_IFID",I_IFID_SAP);
					rcpttySapMap.put(I_RCPTTY+"_OWNRKY",I_OWNRKY);
					
					// 실적 SAP 인터페이스 저장
					dataInsertIF(map, rcpttySapList, rcpttySapMap, ifidSapList);
					
					log.debug("InboundService.deleteGR40New 밀롤 입고취소 실적 SAP 인터페이스 저장 - ifid : " + I_IFID_SAP + " - ifRsMsg : " + ifRsMsg );
				} catch(SQLException se) {
					log.error("InboundService.deleteGR40New 밀롤 입고취소 실적 SAP 인터페이스 저장 - ifid : " + I_IFID_SAP + " - SQLException Error : " + se.getMessage());
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고취소 실적 SAP 인터페이스 저장 에러 : " + cutErrMsg;
					//se.printStackTrace();
				} catch(BadSqlGrammarException bse) {
					log.error("InboundService.deleteGR40New 밀롤 입고취소 실적 SAP 인터페이스 저장 - ifid : " + I_IFID_SAP + " - BadSqlGrammarException Error : " + bse.getMessage());
					ifRsCode = "E";
					//bse.printStackTrace();
					
					try {
						SQLException se = bse.getSQLException();
						String errMsg = se.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고취소 실적 SAP 인터페이스 저장 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고취소 실적 SAP 인터페이스 저장 에러 : " + cutErrMsg;
					}
					
				} catch(UncategorizedSQLException bse) {
					log.error("InboundService.deleteGR40New 밀롤 입고취소 실적 SAP 인터페이스 저장 - ifid : " + I_IFID_SAP + " - UncategorizedSQLException Error : " + bse.getMessage());
					ifRsCode = "E";
					//bse.printStackTrace();
					
					try {
						SQLException se = bse.getSQLException();
						String errMsg = se.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고취소 실적 SAP 인터페이스 저장 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고취소 실적 SAP 인터페이스 저장 에러 : " + cutErrMsg;
					}	
					
				} catch(Exception e) {
					log.error("InboundService.deleteGR40New 밀롤 입고취소 실적 SAP 인터페이스 저장 - ifid : " + I_IFID_SAP + " - Exception Error : " + e.getMessage());
					String errMsg = e.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고취소 실적 SAP 인터페이스 저장 에러 : " + cutErrMsg;
					//e.printStackTrace();
				}
				
				// 에러 처리
				if("E".equals(ifRsCode)) {
					
					failCnt++;
					
					// 인터페이스 에러 결과 메세지
					totRsCode = ifRsCode;
					totRsSbMsg.append("\n");
					totRsSbMsg.append(ifRsMsg);
					
					transactionManager.rollback(transactionStatus);
					successYN = false;
					log.debug(i + " - InboundService.deleteGR40New 밀롤 입고취소 실적 SAP 인터페이스 저장 에러 - recvky : " + I_RECVKY + " - rollback");
					
					//continue;
					break;
				}
				
			}
			log.debug("~~ 밀롤 입고취소 실적 SAP 인터페이스 저장 rcpttySapList : " + rcpttySapList.toString());
			log.debug("~~ 밀롤 입고취소 실적 SAP 인터페이스 저장 rcpttySapMap : " + rcpttySapMap.toString());
			log.debug("~~ 밀롤 입고취소 실적 SAP 인터페이스 저장 ifidSapList : " + ifidSapList.toString());
			
			
			/*********************************************************************************
			 * 인터페이스 전송 테이블 저장 END
			 *********************************************************************************/
			
			/*********************************************************************************
			 * 인터페이스 네트워크 전송  START
			 *********************************************************************************/
			// IF 실적 SAP 입고유형별 입고키 넣기
			if(I_IFID_SAP!=null && !"".equals(I_IFID_SAP.trim()) && rcpttySapList!=null && rcpttySapList.size()>0 ) {
				
				// 실적 SAP 인터페이스 전송
				String ifRsCode = "S";
				String ifRsMsg = "";
				
				try {
					
					DataMap sendMap = new DataMap();
					
					sendMap = ifidSapList.get(0);
					
					sendMap.put("ownrky", I_OWNRKY);
					sendMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					//ifRsMsg = iFService.sendIF(sendMap);
					
					String logseq = sendMap.getString("LOGSEQNO");
					
					String sapIfid = headRow.getString("SAP_IFID").trim();
					String rfcfn   = headRow.getString("SAP_RFCFN").trim();
					String rfctbl  = "T_INDATA";
					if(!"".equals(rfcfn)) {
						
						DataMap pMap = new DataMap();
						DataMap logMap = new DataMap();
						DataMap reqMap = new DataMap();
						List<DataMap> reqList = new ArrayList<DataMap>();
						
						//String logseq = getLOGSEQNO();
						
						pMap.put("I_IF_KEY", logseq);
						
						
						DataMap itemListMap = new DataMap();
						headRow.putAll(itemListMap);
						headRow.setModuleCommand("WmsInbound", "GR09Sub");
						list = commonDao.getList(headRow);
						
						
						for(int j=0;j<list.size();j++){
							
							itemRow = list.get(j).getMap("map");
							
							reqMap = new DataMap();
							
							if(rfcfn.equals("Z_WMS_DELIVERY_CANCEL")) {

								reqMap.put("WMSDN", itemRow.get("RECVKY"));
								reqMap.put("VBELN", itemRow.getString("SXBLNR"));
								reqMap.put("WADAT_IST", itemRow.getString("DOCDAT"));
								reqMap.put("BWART", itemRow.get("BWARTSAP"));
								
								pMap.put("I_IF_NAM", "WMS_IF_777");	
								
							}else if(rfcfn.equals("Z_WMS_MAT_DOC_CANCEL")){
								
								reqMap.put("WMSDN", itemRow.getString("RECVKY"));
								reqMap.put("MBLNR", itemRow.getString("SXBLNR"));
								reqMap.put("BUDAT", itemRow.getString("DOCDAT"));
								reqMap.put("MJAHR", itemRow.getString("DOCDAT").substring(0, 4));		
								
								pMap.put("I_IF_NAM", "WMS_IF_778");
								
							}
							
							if(j==0) {
								reqList.add(reqMap);
							}
							
						}
						
						logMap.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
						logMap.put("COMSTAT", "C"); //호출
						logMap.put("IFID", pMap.get("I_IF_NAM"));
						logMap.put("REMARK", recvky); 
						logMap.put("SEQNO",logseq);
						logMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						commonDao.insert(logMap);
						
						//RFC통신
						
						log.debug("밀롤 deleteGR09.send - rfcfn : " + rfcfn);
						
						RfcCallFunction sapConn = new RfcCallFunction();
						
						log.debug("\n 밀롤 deleteGR09.send - reqList : " + reqList);
						
						DataMap sapRes = sapConn.rfcCancel(rfcfn, rfctbl, pMap, reqList);

						log.debug("\n 밀롤 deleteGR09.result - sapRes : " + sapRes);
						
						String errMsg;
						
						for(DataMap reMap : sapRes.getMapList("head")) {
							
							if(!("S".equals(reMap.getString("EV_CODE")) || "S".equals(reMap.getString("TYPE")))) {
								
								if("E".equals(reMap.getString("EV_CODE"))){
									errMsg = reMap.getString("EV_MSG");
								}else {
									errMsg = reMap.getString("MESSAGE");
								}
								
								//throw new SQLException("SAP : "+errMsg);
								
								ifRsCode = "E";
								ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고 취소 실적 SAP 인터페이스 전송 에러 : " + errMsg;
								
							}
						}
						
						if(sapRes.getMapList("head").size() < 1) {
							//throw new SQLException("SAP : I/F에서 받은 결과가 존재하지않습니다.");
							ifRsCode = "E";
							ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고 취소 실적 SAP 인터페이스 전송 에러 : " + "SAP : I/F에서 받은 결과가 존재하지않습니다.";
						}
						
						//통신결과 update
						logMap.setModuleCommand("Erpif", "IFWMSLOG");
						logMap.put("IFID", pMap.get("I_IF_NAM"));
						logMap.put("COMSTAT", "S"); //호출
						commonDao.update(logMap);
						
					}
					
					log.debug("InboundService.deleteGR40New 밀롤 입고 취소 실적 SAP 인터페이스 전송 - ifid : " + I_IFID_SAP + " - ifRsMsg : " + ifRsMsg );
				} catch(SQLException se) {
					log.error("InboundService.deleteGR40New 밀롤 입고 취소 실적 SAP 인터페이스 전송 - ifid : " + I_IFID_SAP + " - SQLException Error : " + se.getMessage());
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고 취소 실적 SAP 인터페이스 전송 에러 : " + cutErrMsg;
					//se.printStackTrace();
				} catch(BadSqlGrammarException bse) {
					log.error("InboundService.deleteGR40New 밀롤 입고 취소 실적 SAP 인터페이스 전송 - ifid : " + I_IFID_SAP + " - BadSqlGrammarException Error : " + bse.getMessage());
					ifRsCode = "E";
					//bse.printStackTrace();
					
					try {
						SQLException se = bse.getSQLException();
						String errMsg = se.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고 취소 실적 SAP 인터페이스 전송 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고 취소 실적 SAP 인터페이스 전송 에러 : " + cutErrMsg;
					}
					
				} catch(UncategorizedSQLException bse) {
					log.error("InboundService.deleteGR40New 밀롤 입고 취소 실적 SAP 인터페이스 전송 - ifid : " + I_IFID_SAP + " - UncategorizedSQLException Error : " + bse.getMessage());
					ifRsCode = "E";
					//bse.printStackTrace();
					
					try {
						SQLException se = bse.getSQLException();
						String errMsg = se.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고 취소 실적 SAP 인터페이스 전송 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고 취소 실적 SAP 인터페이스 전송 에러 : " + cutErrMsg;
					}	
					
				} catch(Exception e) {
					log.error("InboundService.deleteGR40New 밀롤 입고 취소 실적 SAP 인터페이스 전송 - ifid : " + I_IFID_SAP + " - Exception Error : " + e.getMessage());
					String errMsg = e.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + I_RECVKY + "] 밀롤 입고 취소 실적 SAP 인터페이스 전송 에러 : " + cutErrMsg;
					//e.printStackTrace();
				}
				
				// 에러 처리
				if("E".equals(ifRsCode)) {
					
					failCnt++;
					
					// 인터페이스 에러 결과 메세지
					totRsCode = ifRsCode;
					totRsSbMsg.append("\n");
					totRsSbMsg.append(ifRsMsg);
					
					transactionManager.rollback(transactionStatus);
					successYN = false;
					log.debug(i + " - InboundService.deleteGR40New 밀롤 입고 취소 실적 SAP 인터페이스 전송 에러 - recvky : " + I_RECVKY + " - rollback");
					
					// sap if error log
					sapIfErrMap = new HashMap();
					sapIfErrMap.putAll(head.get(i).getMap("map"));
					sapIfErrMap.put("ERRTXT",ifRsMsg);
					sapIfErrMap.put("PROGID",map.getString("PROGID"));					
					sapIfErrList.add(sapIfErrMap);
					
					//continue;
					break;
				}
				
			}
			log.debug("~~ 밀롤 입고 취소 실적 SAP 인터페이스 전송 rcpttySapList : " + rcpttySapList.toString());
			log.debug("~~ 밀롤 입고 취소 실적 SAP 인터페이스 전송 rcpttySapMap : " + rcpttySapMap.toString());
			log.debug("~~ 밀롤 입고 취소 실적 SAP 인터페이스 전송 ifidSapList : " + ifidSapList.toString());
			
			transactionManager.commit(transactionStatus);
			log.debug(i + " - InboundService.deleteGR40New 밀롤 입고 취소 실적 SAP 인터페이스 저장 - recvky : " + I_RECVKY + " - commit");
			
			
			/*********************************************************************************
			 * 인터페이스 네트워크 전송  END
			 *********************************************************************************/
			
			if(successYN == true) {
				sucCnt++;
			}else {
				failCnt++;
			}
						
			count ++;
			
		}
		
		
		
		// 입고 저장 결과
		rsMap.put("inRsCode", totInRsCode);
		rsMap.put("inRsMsg", totInRsSbMsg.toString());
		
		// 인터페이스 전송 결과
		rsMap.put("ifRsCode", totRsCode);
		rsMap.put("ifRsMsg", totRsSbMsg.toString());
		
		// 입고 성공/실패 카운트
		rsMap.put("totCnt", totCnt);
		rsMap.put("sucCnt", sucCnt);
		rsMap.put("failCnt", failCnt);
		
		log.debug("~~ deleteGR40New last called");
		
		// 입고취소 성공 목록
		StringBuilder sb2 = new StringBuilder(); // 입고 전체완료 확인 sql
		try {
			for(int k = 0 ; k < recvkyList.size() ; k ++){
				if(k != 0){
					sb2.append(",");
				}
				sb2.append("'").append(recvkyList.get(k)).append("'");
			}
			if("".equals(sb2.toString())) {
				sb2.append("' '");
			}
			
			DataMap completeMap = new DataMap();
			completeMap.put("RECVKYS", sb2.toString());
			completeMap.setModuleCommand("WmsInbound", "GR09_CANCEL");
			sucList = commonDao.getList(completeMap);
		}catch(Exception e) {
			log.debug("~~ deleteGR40New.GR09_CANCEL error : " + e.getMessage() );
			e.printStackTrace();
		}
		// 인터페이스 전송 목록
		rsMap.put("sucList", sucList);
		
		// SAP 실적 인터페이스 실패로그
		try {
			log.debug("~~ deleteGR40New.sapIfErrList.size : " + sapIfErrList.size() );
			if(sapIfErrList!=null && sapIfErrList.size()>0) {
				execBatchList("WmsInbound.GR_IF_SAP_LOG_BATCH", sapIfErrList);
			}
		}catch(Exception e) {
			log.debug("~~ deleteGR40New.GR_IF_SAP_LOG_BATCH error : " + e.getMessage() );
			e.printStackTrace();
		}
		
		
		rsMap.put("count",count);
		
		
		return rsMap;
		
	}
	
	
	@Transactional
	public DataMap deleteTmpGR40(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();                         	// return Map
		
		List<DataMap> head = map.getList("list"); 				// 입고번호 아이템
		
		int count = 0;
		
		DataMap headRow = new DataMap();
		
		for(int i=0;i<head.size();i++){
		
			headRow = head.get(i).getMap("map");
			headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			// ROLLMA 임시저장상태 상태 삭제
			//headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_ITEM");
			//commonDao.delete(headRow);
			
			// 아이템이 삭제
			headRow.setModuleCommand("WmsInbound", "GR40_SEBELN_ITEM");
			commonDao.delete(headRow);
			
			// 아이템이 모두 삭제되면 헤더도 삭제
			headRow.setModuleCommand("WmsInbound", "GR40_RECDI_ITEMCNT");
			int cnt = commonDao.getCount(headRow);
			if(cnt == 0) {
				headRow.setModuleCommand("WmsInbound", "GR40_SEBELN_HEAD");
				commonDao.delete(headRow);
			}
			
			count ++;
			
		}
		
		rsMap.put("count",count);
		
		return rsMap;
		
	}
	
	@Transactional
	public DataMap deleteTmpRollmaGR40(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();                         	// return Map
		
		List<DataMap> head = map.getList("list"); 				// 입고번호 아이템
		
		int count = 0;
		
		DataMap headRow = new DataMap();
		
		for(int i=0;i<head.size();i++){
		
			headRow = head.get(i).getMap("map");
			headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			// ROLLMA 임시저장상태 상태 삭제
			headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_ITEM");
			commonDao.delete(headRow);
			count ++;
		}
		
		rsMap.put("count",count);
		return rsMap;
		
	}
}
