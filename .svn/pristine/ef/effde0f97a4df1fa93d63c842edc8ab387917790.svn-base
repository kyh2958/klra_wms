				rsMap.put("RECVKY", sb.toString());
			} catch (Exception e) {
				e.printStackTrace();
				String errmsg = e.getMessage();
				rsMap.put("V_ERRNUM", 0);
				rsMap.put("V_ERRMSG", errmsg);
			}
		}
		return rsMap;
	}
