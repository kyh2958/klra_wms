	// 포탈 인터페이스 전송
	@Transactional
	public String dataSendIFPtl(DataMap map, List<DataMap> ifidList, String ifidPtl) throws SQLException {
		
		List<DataMap> ifList = new ArrayList<DataMap>();       // IF 실적 : 실적 인터페이스 목록
		
		DataMap ifidMap = new DataMap();                       // IFID : 입고유형별 LOGSEQNO
		DataMap doMap = new DataMap();
		
		String sqlMapNamespace = "WmsInbound";
		
		String resultMsg = "Fail"; 
		
		if(StringUtils.isNotEmpty(ifidPtl)) {
			
			for(int i=0; i<ifidList.size();i++) {
				
				ifidMap = ifidList.get(i);
				
				String LOGSEQNO = ifidMap.getString("LOGSEQNO");
				doMap = new DataMap();
				doMap.put("INOUT_TYPE", "OUT");
				doMap.put("LOGSEQNO", LOGSEQNO);
				
				doMap.setModuleCommand(sqlMapNamespace, "PORTAL_INOUT_PROC_CALL"); 
				commonDao.getMap(doMap);
				
				resultMsg = doMap.getString("ERRORMESG");
				
				log.debug("---------------------------------------------------------------------------------------------------------------------------");
				log.debug("InboundService.dataSendIFPtl - i  " + i+ " - INOUT_TYPE : OUT  - LOGSEQNO : " + LOGSEQNO );
				log.debug(i + " - ERRORMESG : " + resultMsg);
				log.debug("---------------------------------------------------------------------------------------------------------------------------");
				
			}
			
		}
		
		return resultMsg;
		
	}
	
	
	@Transactional
	public void execBatchList(String moduleCommand, List<Map> batchList) throws SQLException {
		
		log.debug("batch start - batchList.size() : " + batchList.size());
		//DataMap rsMap = new DataMap();
		int limitCnt = 100;
		int loopSize = (batchList.size()/limitCnt);
		int rmSize = (batchList.size()%limitCnt);
		
		if( batchList!=null && batchList.size()>0 && loopSize==0) {
			loopSize=1;
			rmSize=0;
		}
		
		log.debug("batch loopSize : " + loopSize);
		log.debug("batch rmSize : " + rmSize);
		
		for (int k = 0; k < loopSize; k++) {
			
			if(batchList.size()<limitCnt) {
				commonDao.insert(moduleCommand, batchList.subList( (k*limitCnt), batchList.size() ) );
				log.debug( k + " - batch - start : " + (k*limitCnt) + " - end : " + batchList.size() );
			}else {
				commonDao.insert(moduleCommand, batchList.subList( (k*limitCnt), (((k+1)*limitCnt)) ) );
				log.debug( k + " - batch - start : " + (k*limitCnt) + " - end : " + (((k+1)*limitCnt)) );
			}
			
			if( k==(loopSize-1) && rmSize!=0 ) {
				commonDao.insert(moduleCommand, batchList.subList( ((k+1)*limitCnt), batchList.size()) );
				log.debug( k + " - batch last - start : " + ((k+1)*limitCnt) + " - end : " + batchList.size() );
			}
		}
		log.debug("batch end - batchList.size() : " + batchList.size());
		
	}
	
	
//	@Transactional
	public void sendIf(DataMap map) throws SQLException {
		
		String ifid = map.getString("IFID");
	
		try {
			String ifRsMsg = iFService.sendIF(map);
			map.put("ifRsMsg",ifRsMsg);
			log.debug( "InboundService.sendIF - ifid : " + ifid + " - ifRsMsg : " + ifRsMsg );
		}catch(Exception e) {
			log.error("InboundService.sendIF - ifid : " + ifid + " - Error : " + e.getMessage());
			map.put("ifRsMsg",e.getMessage());
			e.printStackTrace();
		}
		
	}
	
	@Transactional(rollbackFor = Exception.class)
	public int saveSingleGrFile(DataMap map) throws Exception {
		int count = 0;
		try {
			log.debug(map);
			DataMap fileMap = map.getMap(CommonConfig.FILE_MAP_KEY);
			List<DataMap> fileInfoList = fileMap.getList(CommonConfig.FILEINFOLIST_KEY);
			int fileInfoListSize = fileInfoList.size();
			if(fileInfoListSize > 0){
				DataMap row = fileInfoList.get(0).getMap("map");
				row.put("ATTACH", row.getString("UUID"));
//				row.put("DOCTXT", "Single File Upload");
				row.setModuleCommand("WmsInbound", "GRFILE");
				row.put("SEBELN", map.getString("SEBELN"));
				commonDao.insert(row);
				count++;
			}
		} catch (Exception e) {
			throw new Exception(e.getMessage());
		}
		return count;
	}
	
	@Transactional
	public int saveGrFile(DataMap map) throws Exception {
		int count = 0;
		
		List<DataMap> list = map.getList("list");
		int listSize = list.size();
		try {
			if(listSize > 0){
				for (int i = 0; i < listSize; i++) {
					DataMap row = list.get(i).getMap("map");
					map.clonSessionData(row);
					row.setModuleCommand("WmsInbound", "GRFILE");
					
					String uuid = row.getString("UUID");
					String attach = row.getString("ATTACH");
					
					String gRowStatus = row.getString(CommonConfig.GRID_ROW_STATE_ATT);
					switch (gRowStatus) {
					case "C":
						commonDao.insert(row);
						break;
					case "U":
						commonDao.update(row);
						
						if(!"".equals(uuid)){
							String path = row.getString("PATH");
							String name = row.getString("FNAME");
							if(!"".equals(path) && !"".equals(name) && !uuid.equals(attach)){
								FileUtil fileUtil = new FileUtil();
								
								boolean result = fileUtil.deleteFile(path, name);
								if(result){
									DataMap sysFileMap = new DataMap();
									sysFileMap.put("UUID", uuid);
									sysFileMap.setModuleCommand("System", "SYSFILE");
									
									commonDao.delete(sysFileMap);
								}
								log.debug("Origin File Delete[ "+ row.get("SEBELN") +"," + uuid + " ] :: " + (result?"success":"false"));
							}
						}
						break;
					case "D":
						commonDao.delete(row);
						
						String path = row.getString("PATH");
						String name = row.getString("FNAME");
						if(!"".equals(path) && !"".equals(name)){
							FileUtil fileUtil = new FileUtil();
							
							boolean result = fileUtil.deleteFile(path, name);
							if(result){
								DataMap sysFileMap = new DataMap();
								sysFileMap.put("UUID", uuid);
								sysFileMap.setModuleCommand("System", "SYSFILE");
								
								commonDao.delete(sysFileMap);
							}
							log.debug("File Delete[ "+ row.get("SEBELN") +"," + uuid + " ] :: " + (result?"success":"false"));
						}else{
							log.debug("No File Delete[ "+ row.get("SEBELN") +"," + uuid + " ]");
						}
						break;	
					default:
						break;
					}
					
					count++;
				}
			}
		} catch (Exception e) {
			throw new Exception(e.getMessage());
		}
		return count;
	}
	
	
