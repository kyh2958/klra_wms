			log.debug("~~ 입고 실적(구매포탈) 인터페이스 전송 rcpttyList : " + rcpttyPtlList.toString());
			log.debug("~~ 입고 실적(구매포탈) 인터페이스 전송 rcpttyMap : " + rcpttyPtlMap.toString());
			log.debug("~~ 입고 실적(구매포탈) 인터페이스 전송 ifidOtrList : " + ifidPtlList.toString());			
			
			/*********************************************************************************
			 * 인터페이스 네트워크 전송  END
			 *********************************************************************************/
			
			log.debug("~~ 4. 입고 실적 인터페이스 전송 종료. - head : " + i + " / 트랜잭션 상태 - " + transactionStatus.isCompleted());
			
			//240216 HNW for문 내 트랜잭션 완료처리
			if(!transactionStatus.isCompleted()) {
				transactionManager.commit(transactionStatus);
			}
			
			log.debug("~~ 5. 입고 실적 인터페이스 전송 종료. - head : " + i + " / 트랜잭션 상태 - " + transactionStatus.isCompleted());
			
			if(successYN == true) {
				sucCnt++;
			}else {
				failCnt++;
			}
			
		}
		
		// 입고 저장 결과
		rsMap.put("inRsCode", totInRsCode);
		rsMap.put("inRsMsg", totInRsSbMsg.toString());
		
		// 인터페이스 전송 결과
		rsMap.put("ifRsCode", totRsCode);
		rsMap.put("ifRsMsg", totRsSbMsg.toString());
		
		// 입고 성공/실패 카운트
		rsMap.put("totCnt", totCnt);
		rsMap.put("sucCnt", sucCnt);
		rsMap.put("failCnt", failCnt);
		
		
		log.debug("~~ saveGr02New last called");
		StringBuilder sb = new StringBuilder();
		StringBuilder sb1 = new StringBuilder(); // gr99 때문에 하나더 만듬. 저장 후 재조회 용으로 사용
		for(int k = 0 ; k < docNumList.size() ; k ++){
			if(k != 0){
				sb.append(",");
				sb1.append(",");
			}
			sb.append("'").append(docNumList.get(k)).append("'");
			sb1.append("").append(docNumList.get(k)).append("");
		}
		rsMap.put("RECVKYS", sb.toString());
		rsMap.put("RECVKY", sb1.toString());
		rsMap.put("SAPIFYN", sapifyn);
		
		
		// 입고 RECDH,RECDI,SAP실적 성공 목록
		StringBuilder sb2 = new StringBuilder(); // 입고 전체완료 확인 sql
		try {
			for(int k = 0 ; k < sebelnList.size() ; k ++){
				if(k != 0){
					sb2.append(",");
				}
				sb2.append("'").append(sebelnList.get(k)).append("'");
			}
			if("".equals(sb2.toString())) {
				sb2.append("' '");
			}
			
			DataMap completeMap = new DataMap();
			completeMap.put("SEBELNS", sb2.toString());
			completeMap.setModuleCommand("WmsInbound", "GR_COMPLETE");
			sucList = commonDao.getList(completeMap);
		}catch(Exception e) {
			log.debug("~~ saveGr02New.GR_COMPLETE error : " + e.getMessage() );
			e.printStackTrace();
		}
		// 인터페이스 전송 목록
		rsMap.put("sucList", sucList);
		
		// SAP 실적 인터페이스 오류 로그
		try {
			log.debug("~~ saveGr02New.sapIfErrList.size : " + sapIfErrList.size() );
			if(sapIfErrList!=null && sapIfErrList.size()>0) {
				execBatchList("WmsInbound.GR_IF_SAP_LOG_BATCH", sapIfErrList);
			}
		}catch(Exception e) {
			log.debug("~~ saveGr02New.GR_IF_SAP_LOG_BATCH error : " + e.getMessage() );
			e.printStackTrace();
		}
		
		//if(1==1) commonDao.rollback();
		
		log.debug("~~ saveGr02New 입고완료 메서드 End - " + rsMap);
		
		return rsMap;
	}
	
	public DataMap saveGr031New(DataMap map) throws SQLException {
		
		List<DataMap> head = map.getList("head");
		//List<DataMap> itemList = new ArrayList<DataMap>();
		List<DataMap> selectList = new ArrayList<DataMap>();
		String headSebeln = map.getString("headSebeln");
			
		int itemCount = 0;      // 입고 아이템 채번 번호
		
		int totCnt = 0;         // 입고 전체 건수
		int sucCnt = 0;         // 입고 성공 건수 
		int failCnt = 0;        // 입고 성공 건수
		
		int errMsgLen = 500;    // 에러메세지 길이
		
		String totInRsCode = "S";    // 입고테이블 insert 결과 코드
		StringBuffer totInRsSbMsg = new StringBuffer(); // 입고테이블 insert 결과 메세지
		
		String totRsCode = "S";    // 인터페이스 결과 코드
		StringBuffer totRsSbMsg = new StringBuffer(); // 인터페이스 결과 메세지
		
		String sapifyn = "";      // 인터페이스 전송여부(GR99 SAP 전송여부 때문에추가)
		
		DataMap row;
		DataMap itemRow;
		
		List<String> sebelnList = new ArrayList();              // return EBELN List
		
		List<String> docNumList = new ArrayList();              // return RECVKY List
		DataMap rsMap = new DataMap();                          // return Map
		
		List<Map> batchHeadList = new ArrayList();              // Batch Insert Header List
		Map batchHeadMap = new HashMap();                       // Batch Insert Header Map
		
		List<Map> batchItemList = new ArrayList();              // Batch Insert Item List
		Map batchItemMap = new HashMap();                       // Batch Insert Item Map
		
		List<Map> sapIfErrList = new ArrayList();               // Batch SAP IF ERROR List(sap Error rollback log insert List)
		Map sapIfErrMap = new HashMap();                        // Batch SAP IF ERROR Map
		
		
		List<DataMap> ifidSapList = new ArrayList<DataMap>();   // IFID : SAP 인터페이스 전송 목록
		List<DataMap> ifidQtrList = new ArrayList<DataMap>();   // IFID : 품질검사 인터페이스 전송 목록
		List<DataMap> ifidStnList = new ArrayList<DataMap>();   // IFID : 즉시불출 인터페이스 전송 목록
		
		List<DataMap> ifidPtlList = new ArrayList<DataMap>();   // IFID : 실적(구매포탈)인터페이스 전송 목록
		List<DataMap> ifidMesList = new ArrayList<DataMap>();   // IFID : 실적(MES)인터페이스 전송 목록
		
		
		List<String> rcpttySapList = new ArrayList<String>();   // IF 실적 : 입고유형 SAP
		DataMap rcpttySapMap = new DataMap();                   // IF 실적 : 입고유형별 입고헤더키 SAP
		
		List<String> rcQtrList = new ArrayList<String>();       // IF 품질검사 : 입고유형
		DataMap rcQtrMap = new DataMap();                       // IF 품질검사 : 입고유형별 입고헤더키
		
		List<String> rcStnList = new ArrayList<String>();       // IF 즉시불출 : 입고유형
		DataMap rcStnMap = new DataMap();                       // IF 즉시불출 : 입고유형별 입고헤더키		
		
		List<String> rcpttyPtlList = new ArrayList<String>();   // IF 실적 : 입고유형(구매포탈)
		DataMap rcpttyPtlMap = new DataMap();                   // IF 실적 : 입고유형별 입고헤더키(구매포탈)
		
		List<String> rcpttyMesList = new ArrayList<String>();   // IF 실적 : 입고유형(MES)
		DataMap rcpttyMesMap = new DataMap();                   // IF 실적 : 입고유형별 입고헤더키(MES)
		
		
		List<DataMap> sucList = new ArrayList<DataMap>();       // 입고 RECDH,RECDI,SAP실적 성공 목록
		
		
		String rollYN = map.getString("ROLLYN"); 				// 밀롤 여부
		String eachYN = map.getString("EACHYN"); 				// 개별처리 여부(PDA 생산,반납입고 처리)
		String valSkipYN = map.getString("VALSKIPYN"); 			// validation skip 여부(GR99 재고조정입고 오더번호 없어서 패스해야됨.)
		
		//totCnt = head.size();
		totCnt = map.getList("list").size();

		// head.size() = 1 선적번호 기준으로 오더번호 조회하여 프로세스 처리 하기 kyh
		
		DataMap headRow = map;
		headRow.clonSessionData(headRow);
		headRow.setModuleCommand("WmsInbound", "GR02"); // 반품입고 기존쿼리 사용하여 오더번호 목록조회
		headRow.put("DOCDAT", head.get(0).getMap("map").getString("DOCDAT"));
		headRow.put("STKNUM", head.get(0).getMap("map").getString("STKNUM"));
		headRow.put("STTNEW", 'V');	// 미작업 문서대상 입고처리

		List<DataMap> stknumSubRow = commonDao.getList(headRow);

		for(int i = 0 ; i < stknumSubRow.size() ; i ++){
			
			List<DataMap> itemList = new ArrayList<DataMap>(map.getList("list"));

			//itemList = map.getList("list");
			//System.out.println("list 전: " + map.getList("list").toString());
			//System.out.println("remove 전: " + itemList.toString());
			//System.out.println("remove 전size: " + itemList.size());
			
			for(int itemj = 0 ; itemj < itemList.size() ; itemj ++){
				
				// 선적번호기준 오더목록 조회
				// 오더목록과 상세목록 오더 비교하여 반품입고 분할 처리 (오더번호별 반품입고처리)
				//System.out.println("2712 " + i + " / " + stknumSubRow.get(i).getMap("map").getString("SEBELN") + " = " + itemj + " / " + itemList.get(itemj).getMap("map").get("SEBELN"));
				if (stknumSubRow.get(i).getMap("map").getString("SEBELN").equals(itemList.get(itemj).getMap("map").get("SEBELN"))) {

				}else {
					//System.out.println("remove");
					itemList.remove(itemj);
					
					itemj--;
				}
			}
			
			//System.out.println("continue X1 >> " + stknumSubRow.get(i).getMap("map").getString("SEBELN") );

			if (itemList.size() < 1) {
				continue;
			}

			//System.out.println("continue X2 >> " + stknumSubRow.get(i).getMap("map").getString("SEBELN") );
			//System.out.println("remove 후: " + itemList.toString());
			//System.out.println("list 후: " + map.getList("list").toString());
			
			TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
	        TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
	        
	        batchHeadList = new ArrayList();     // Batch Insert Header List
	        batchItemList = new ArrayList();     // Batch Insert Item List 초기화
	        
	        boolean successYN = true;            // 헤더 별 저장 및 인터페이스 전송 성공 여부
	        
	        String I_OWNRKY   = map.getString("OWNRKY");  
	        String I_RECVKY   = "";
			String I_RCPTTY   = "";   // 입고유형
			String I_IFID_SAP = "";   // 실적 SAP IF_ID			
			String I_IFID_QTR = "";   // 품질 IF_ID
			String I_IFID_STN = "";   // 즉시불출 IF_ID
			
			String I_IFID_PTL = "";   // 실적 IF_ID(구매포탈)
			String I_IFID_MES = "";   // 실적 IF_ID(MES)
			
			String I_QRTAYN   = "";   // 품질검사여부
			String I_SHTAYN   = "";   // 즉시불출여부
			
			String docNum ="";        // 입고 문서키
			
			// 입고 테이블 insert 결과
			String inRsCode = "S";
			String inRsMsg = "";
			
			log.debug("saveGR301 loop i : " + i);
			
			String sebeln = ""; // 오더번호
			String rcptty = ""; // 입고유형
			
			String dptnky = ""; // 20221011 거래처코드(반납입고 거래처 유형은 변경전 플랜트+저장위치임.)
			
			boolean sapIfSkipYn = false; // 20221011 반납입고로 인해 SAP 인터페이스 전송여부 추가
			
			/*********************************************************************************
			 * 입고 테이블 저장 START
			 *********************************************************************************/
			try {
				
				row = stknumSubRow.get(i).getMap("map");
				
				sebeln = row.getString("SEBELN"); // 오더번호
				rcptty = row.getString("RCPTTY"); // 입고유형
				dptnky = row.getString("DPTNKY"); // 20221011 거래처코드(반납입고 거래처 유형은 변경전 플랜트+저장위치임.)
				
				sebelnList.add(sebeln); // 오더별 입고 전체 완료 확인 위해 필요
				
				// 20221011 KJH 반납입고는 변경전 플랜트,저장위치(납품처)와 변경후 플랜트,저장위치(LOTA01,LOTA02)가 동일할 경우 SAP전송하지 않게 변경 요청.
				if("135".equals(rcptty)) {
					sapIfSkipYn = true; // 반납입고 처음엔 스킵true. from to 플랜트,저장위치 하나라도 다른게 있으면 무조건 sap if 전송.
				}
				
				sapifyn = stknumSubRow.get(i).getMap("map").getString("SAPIFYN"); // 인터페이스 전송여부
				//sapifyn = "";
				
				log.debug(i + " - sapifyn : " + sapifyn);
			
				if( true || "Y".equals(eachYN) ){
					
					//itemList = map.getList("list");
					
					//validation
					if(true || "Y".equals(eachYN)){
						selectList = itemList;
					}
					
					if(selectList.size() > 0 && !"Y".equals(valSkipYN) ){
						
						// Validation
						StringBuffer sb = new StringBuffer();
						
						List<DataMap> cropList = new ArrayList<DataMap>();
						
						int valLimitCnt = 300;
						int valLoopSize = (selectList.size()/valLimitCnt);
						int valRmSize = (selectList.size()%valLimitCnt);
						
						if( selectList!=null && selectList.size()>0 && valLoopSize==0) {
							valLoopSize=1;
							valRmSize=0;
						}
						
						log.debug("saveGR301 Validation valLoopSize : " + valLoopSize);
						log.debug("saveGR301 Validation valRmSize : " + valRmSize);
						
						
						for (int k = 0; k < valLoopSize; k++) {
						
							cropList = new ArrayList<DataMap>();
							sb = new StringBuffer();
							
							if(selectList.size()<valLimitCnt) {
								cropList = selectList.subList( (k*valLimitCnt), selectList.size() );
								log.debug( k + " - batch - start : " + (k*valLimitCnt) + " - end : " + selectList.size() );
							}else {
								cropList = selectList.subList( (k*valLimitCnt), (((k+1)*valLimitCnt)) );
								log.debug( k + " - batch - start : " + (k*valLimitCnt) + " - end : " + (((k+1)*valLimitCnt)) );
							}
							
							if( k==(valLoopSize-1) && valRmSize!=0 ) {
								cropList = selectList.subList( ((k+1)*valLimitCnt), selectList.size() );
								log.debug( k + " - batch last - start : " + ((k+1)*valLimitCnt) + " - end : " + selectList.size() );
							}
							
							for(DataMap item : cropList){
								
								if(sb.length() > 0) sb.append(" UNION ALL\n ");
								
								sb.append(" SELECT '").append(item.getMap("map").get("SEBELN")).append("' AS SEBELN, ");
								sb.append("        '").append(item.getMap("map").get("SEBELP")).append("' AS SEBELP, ");
								sb.append("        '").append(item.getMap("map").get("DOCUTY")).append("' AS RCPTTY, ");
								sb.append("        '").append(item.getMap("map").get("WAREKY")).append("' AS WAREKY, ");
								sb.append("        '").append(item.getMap("map").get("OWNRKY")).append("' AS OWNRKY, ");
								sb.append("        '").append(item.getMap("map").get("PTNRTY")).append("' AS PTNRTY, ");
								sb.append("        '").append(item.getMap("map").get("DPTNKY")).append("' AS DPTNKY, ");
								sb.append("        '").append(item.getMap("map").get("LOCAKY")).append("' AS LOCAKY, ");
								sb.append("        '").append(item.getMap("map").get("SKUKEY")).append("' AS SKUKEY, ");
								sb.append("         ").append(item.getMap("map").get("QTYRCV")).append("  AS QTYRCV, ");
								sb.append("        '").append(item.getMap("map").get("UOMKEY")).append("' AS UOMKEY FROM DUAL ");
							}
							
							map.setModuleCommand("WmsInbound", "GOODS_RECEIPT"); // 쿼리키값 넣을것
							map.put("APPEND_QUERY", sb.toString());
							map.put("RCPTTY", stknumSubRow.get(i).getMap("map").get("DOCUTY"));
							List<DataMap> validList = commonDao.getValidation(map);
							if(validList.size() > 0){
								DataMap valid = validList.get(0);
								
								return valid;
							}
						
						}
						
					}// validation 끝
					
					
					docNum ="";
					
					// 20220526 수입밀롤 기존 임시저장 입고 데이터 삭제
					if("Y".equals(rollYN)) {
						
						DataMap recvkyRow = new DataMap();
						recvkyRow.put("SEBELN", row.getString("SEBELN"));
						recvkyRow.setModuleCommand("WmsMobileInboundGoodsReceipt", "PDGR05_RECVKY");
						recvkyRow = commonDao.getMap(recvkyRow);
						
						String recvky = "";
						
						if(recvkyRow!=null) {
							recvky = recvkyRow.getString("RECVKY").trim();
						}
						
						if(!"".equals(recvky)) {
							docNum = recvky;
							
							DataMap tempRow = new DataMap();
							tempRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
							
							// 임시저장 입고헤더 상태,전기일자 변경
							tempRow.put("DOCDAT", row.getString("DOCDAT"));
							tempRow.put("RECVKY", recvky);
							tempRow.put("SEBELN", row.getString("SEBELN"));
							tempRow.setModuleCommand("WmsMobileInboundGoodsReceipt", "PDGR05_RECDH_COMPLETE");
							commonDao.update(tempRow);
							
							// 임시저장 아이템이 삭제
							tempRow.put("SEBELN", row.getString("SEBELN"));
							tempRow.setModuleCommand("WmsInbound", "GR40_SEBELN_ITEM_ALL");
							commonDao.delete(tempRow);
							
							// ROLLMA 컨테이너 단위 초기화
							tempRow.put("CONTNO", row.getString("SIGNI"));
							tempRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
							commonDao.update(tempRow);
						}
						
					}
					
					// 20220628 수입밀롤 때문에 입고키 없을 경우 입고키 채번
					if(docNum==null || "".equals(docNum.trim())) {
						docNum = wmsService.getDocSeq(rcptty);
						
						row.put("RECVKY", docNum);
						row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						row.setModuleCommand("WmsInbound", "GR02");
						
						commonDao.insert(row);
						
					}else {
						row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						row.put("RECVKY", docNum);
					}
					
					docNumList.add(docNum);
					
					batchHeadMap = new HashMap();
					batchHeadMap.putAll(row);
					batchHeadList.add(batchHeadMap);
					
					
					for(int j = 0 ; j < selectList.size() ; j ++){
						
						itemRow = selectList.get(j).getMap("map");
												
						String qrtayn = itemRow.getString("QRTAYN"); // 품질검사여부
						String shtayn = itemRow.getString("SHTAYN"); // 즉시불출여부
						String bwart = itemRow.getString("BWART");
						String ebeln = itemRow.getString("EBELN");
						
						String lota01 = itemRow.getString("LOTA01"); // 저장위치 
						String lota02 = itemRow.getString("LOTA02"); // 플랜트
						String lota0102 = lota02.trim() + lota01.trim(); // 20221011 반납입고 from 플랜트+저장위치 비교 문자
						
						String uomKey = itemRow.getString("UOMKEY");   // 수량단위
						String muomKey = itemRow.getString("MUOMKEY"); // 기본단위
						Double uomQty = Double.parseDouble(itemRow.getString("UOMQTY")); // 기본단위수량

						log.debug("!!!! dptnky : " + dptnky);
						log.debug("!!!! lota0102 : " + lota0102);
						if("Y".equals(eachYN)) {
							// 입고 예정 정보 아이템 개별 처리 일 경우 오더번호 동일 해야 함. 
							if(!sebeln.equals(ebeln) /*|| hSeqno.equals(seqno)*/ ) {
								continue;
							}
						}
						//20221205.선적문서번호 추가 
						String stknum = row.getString("STKNUM");
						itemRow.put("STKNUM",stknum);

						itemRow.put("RECVKY", docNum);
						itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						//itemRow.setModuleCommand("WmsInbound", "GR02Sub");
						
						itemCount += 10;
