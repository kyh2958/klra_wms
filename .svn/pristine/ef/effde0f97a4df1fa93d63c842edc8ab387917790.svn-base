						I_IFID_MES = itemRow.getString("IFID_MES");   	// 실적 IF_ID(MES)
						
						// 즉시불출은 품질검사 안나감.
						if ( !"V".equals(shtayn) && null!=bwart && "131".equals(bwart)) {
