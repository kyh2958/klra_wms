						if("135".equals(rcptty) && !lota0102.equals(dptnky) ) {
							sapIfSkipYn = false; // 반납입고 처음엔 스킵true. from to 플랜트,저장위치 하나라도 다른게 있으면 무조건 sap if 전송.
