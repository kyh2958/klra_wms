	@Transactional
	public String getAsnPltBcd(DataMap map) throws SQLException {
		String result = "OK";
		List<DataMap> list = map.getList("list");
		
		String validationSql = "";
		String key = map.get("key").toString();
		if( map.containsKey("key") ){
			validationSql = util.urlCreateValidationSql(map, key);
			map.put(CommonConfig.VALIDATION_SQL_KEY, validationSql);
			map.setModuleCommand("WmsInbound", "GR09VAL");
						
			List<DataMap> vList = commonDao.getValidation(map);
			
			DataMap rsMap = new DataMap();
			
			for(int j = 0; j < vList.size(); j++){
				rsMap = vList.get(j);
				if( !rsMap.getString("MSG").equals("OK") ){
					result = rsMap.getString("MSG");
					break;
				}
			}
		}
		return result;
	}
	
	@Transactional
	public String BARCDInsert(DataMap map) throws SQLException {
		List<DataMap> head = map.getList("head");
		List<DataMap> list = map.getList("list");
		DataMap row = new DataMap();
		DataMap itemrow = new DataMap();
		String result = "HHT_T0008";

		for(int h = 0 ; h < head.size() ; h ++){
			//해당 ASNDKY가 BARCD에 없으면 생성
			DataMap headrow = head.get(h).getMap("map");
			String HeadAsndky = headrow.getString("ASNDKY");

			row.put("ASNDKY", HeadAsndky);
			row.setModuleCommand("WmsInbound", "PltBcdChk");
			DataMap bcdChk = commonDao.getMap(row);

			if("0".equals(bcdChk.getString("CNT"))){
				
				row.setModuleCommand("WmsInbound", "ASNDIT");
				list = commonDao.getList(row);

				//ASNDIT만큼 for문 돌리기
				for(int i = 0; i < list.size(); i++) {
					row = list.get(i).getMap("map");

					String asndky = row.getString("ASNDKY");
					String asndit = row.getString("ASNDIT");
					//ASNDIT -> SKU -> 팔렛트 입수만큼 바코드 분할하는 쿼리
					row.setModuleCommand("WmsInbound", "PltCount");
					DataMap pltrow = commonDao.getMap(row);

					//분할된 팔렛트수만큼 for문 돌리기
					int itemCount = 0;	//ASNDIT별로 초기화
					int pltCnt = Integer.parseInt(pltrow.getString("PLTCNT"));
					for(int j = 0; j < pltCnt; j++){
						itemCount += 10;

						String snum = String.valueOf(itemCount);
						String inum = String.valueOf("0000").substring(0,(4-snum.length()))+snum;
						itemrow.put("BARCOD", asndky+asndit+inum);
						itemrow.put("WAREKY", pltrow.getString("WAREKY"));
						itemrow.put("SKUKEY", pltrow.getString("SKUKEY"));
						itemrow.put("DESC01", pltrow.getString("DESC01"));
						itemrow.put("QTDUOM", Integer.parseInt(pltrow.getString("QTPUOM")));	//SKU의 1팔렛트 입수량
						itemrow.put("QTDBOX", Integer.parseInt(pltrow.getString("PLTCNT")));	//PLT 수량
						itemrow.put("QTDREM", Integer.parseInt(pltrow.getString("QTYMOD")));	//잔량
						itemrow.put("QTDPRT", Integer.parseInt(pltrow.getString("QTYASN")));	//ASN 수량
						itemrow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));

						itemrow.setModuleCommand("WmsInbound", "BARCD");
						commonDao.insert(itemrow);
					}
				}
			}
		}
		return result;
	}
	
	
	
	@Transactional
	public int saveGR98EXCEL(DataMap map) throws SQLException, Exception {
		
		// 기초재고셋업 excel 업로드
		List<DataMap> excelList = map.getList("excelList");
		DataMap excelRow = new DataMap();
		
		List<Map> batchItemList = new ArrayList();             // Batch Insert Item List
		Map batchItemMap = new HashMap();                      // Batch Insert Item Map
		
		String sqlMapNamespace = "WmsInbound";
		
		// default 재고조정 입고 location 조회 
		map.setModuleCommand(sqlMapNamespace, "GR98");
		DataMap infoRow = commonDao.getMap(map);
		
		int count = 0;
		
		for(int i = 0; i < excelList.size(); i++) {
			
			excelRow = excelList.get(i).getMap("map");
			excelRow.put("WAREKY", map.getString("WAREKY"));
			excelRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			String AREAKY = excelRow.getString("AREAKY");
			String ZONEKY = excelRow.getString("ZONEKY");
			String LOCAKY = excelRow.getString("LOCAKY");
			
			String LOTA11 = excelRow.getString("LOTA11").replaceAll("[.]", "").replaceAll("-", "").replaceAll("/", "").trim();
			String LOTA12 = excelRow.getString("LOTA12").replaceAll("[.]", "").replaceAll("-", "").replaceAll("/", "").trim();
			String LOTA13 = excelRow.getString("LOTA13").replaceAll("[.]", "").replaceAll("-", "").replaceAll("/", "").trim();
			
			excelRow.put("LOTA11", LOTA11 );
			excelRow.put("LOTA12", LOTA12 );
			excelRow.put("LOTA13", LOTA13 );
			
			if("".equals(AREAKY.trim()) && "".equals(ZONEKY.trim()) && "".equals(LOCAKY.trim())) {
				excelRow.put("AREAKY", infoRow.getString("AREAKY"));
				excelRow.put("ZONEKY", infoRow.getString("ZONEKY"));
				excelRow.put("LOCAKY", infoRow.getString("LOCAKY"));
			}

			//excelRow.setModuleCommand(sqlMapNamespace, "saveGR98EXCEL");
			//commonDao.insert(excelRow);
			
			batchItemMap = new HashMap();
			batchItemMap.putAll(excelRow);
			batchItemList.add(batchItemMap);
			
			count ++;
		}
		
		// 입고 아이템 데이터 대량 insert
		execBatchList("WmsInbound.saveGR98EXCELBatch", batchItemList);
		
		return count;
	}
	
	
	@Transactional
	public DataMap saveGR98(DataMap map) throws Exception {
		
		List<DataMap> list = map.getList("head");
		
		List<DataMap> headList = new ArrayList<DataMap>();
		List<DataMap> itemList = new ArrayList<DataMap>();
		
		
		List<Map> batchHeadList = new ArrayList();             // Batch Insert Header List
		Map batchHeadMap = new HashMap();                      // Batch Insert Header Map
		
		List<Map> batchItemList = new ArrayList();             // Batch Insert Item List
		Map batchItemMap = new HashMap();                      // Batch Insert Item Map
		
		DataMap palletMap = new DataMap();
		DataMap addRow = new DataMap();
		
		StringBuilder sb = new StringBuilder();
		
		String sqlMapNamespace = "WmsInbound";
		
		int count = 0;

		
		for(int i=0; i < list.size(); i++) {
			
			DataMap row = list.get(i).getMap("map");

			// 거점, 플랜트, 거래처 별 입고 헤더 문서 생성 조회 
			row.setModuleCommand(sqlMapNamespace, "GR98Head");
			headList = new ArrayList();
			headList = commonDao.getList(row);
			
			batchHeadList = new ArrayList();
			batchItemList = new ArrayList();
			
			for(int j=0; j < headList.size(); j++) {
			
				DataMap headRow = headList.get(j).getMap("map");
				
				String recvky = headRow.getString("RECVKY");
				String rcptty = headRow.getString("RCPTTY");
				
				headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				headRow.put("DOCTXT", row.getString("DOCTXT"));
			
				batchHeadMap = new HashMap();
				batchHeadMap.putAll(headRow);
				batchHeadList.add(batchHeadMap);
				
				// tml_stk 조회
				itemList = new ArrayList();
				headRow.setModuleCommand(sqlMapNamespace, "GR98Sub");
				itemList = commonDao.getList(headRow);
				
				int itemCount = 10;
				
				for(int k = 0; k < itemList.size(); k++) {
					
					DataMap itemRow = itemList.get(k).getMap("map");
					
					itemRow.put("RECVKY", recvky);
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					itemRow.put("DOCTXT", row.getString("DOCTXT"));
					
					
					// LOTA15 LOT번호 없을 경우 신규 채번
					String LOTA15 = itemRow.getString("LOTA15").trim();
					if(StringUtils.isEmpty(LOTA15)) {
						itemRow.put("RCPTTY",itemRow.getString("RCPTTY"));
						itemRow.setModuleCommand("WmsInbound", "GENNOTNO");
						String NW_LOTA15 = (String) commonDao.getObject(itemRow);
						log.debug("LOTA15 : " + LOTA15 + " - NW_LOTA15 : " + NW_LOTA15);
						itemRow.put("LOTA15", NW_LOTA15);
					}
					
					
					String LOTA14 = itemRow.getString("LOTA14");                  // 개별바코드
					float PALQTY = Float.parseFloat(itemRow.getString("PALQTY")); // 기본단위/pallet
					
					if( LOTA14!=null && StringUtils.isEmpty(LOTA14.trim()) ) {
						
						itemRow.setModuleCommand(sqlMapNamespace, "PALLET"); 
						palletMap = commonDao.getMap(itemRow);
						
						int PALCNT = palletMap.getInt("PALCNT");
						
						itemRow.put("PALCNT", PALCNT);
						itemRow.setModuleCommand(sqlMapNamespace, "NEW_BARCODE_PROC_CALL"); 
						commonDao.getMap(itemRow);
						
						String barcode = itemRow.getString("BARCODE2");
						int startSeq = itemRow.getInt("STRSEQ");
						int endSeq = itemRow.getInt("ENDSEQ");
						
						String REMQTY = palletMap.getString("REMQTY");
						
						String UOMQTY = palletMap.getString("UOMQTY");
						String TOT = palletMap.getString("TOT");
						String BAG = palletMap.getString("BAG");
						String BOX = palletMap.getString("BOX");
						String PLT = palletMap.getString("PLT");
						String SOK = palletMap.getString("SOK");
						String EA = palletMap.getString("EA");
						String QTYRCV = palletMap.getString("QTYRCV");
						
						String UOMQTY_REM = palletMap.getString("UOMQTY_REM");
						String TOT_REM = palletMap.getString("TOT_REM");
						String BAG_REM = palletMap.getString("BAG_REM");
						String BOX_REM = palletMap.getString("BOX_REM");
						String PLT_REM = palletMap.getString("PLT_REM");
						String SOK_REM = palletMap.getString("SOK_REM");
						String EA_REM = palletMap.getString("EA_REM");
						String QTYRCV_REM = palletMap.getString("QTYRCV_REM");
						
						int barcodeSeq = 0;
						
						// pallet
						if(PALCNT>1) {
							
							for(int l=0; l<(PALCNT-1); l++) {
								
								addRow = new DataMap();
								
								String snum = String.valueOf(itemCount);
								String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
								
								barcodeSeq = startSeq + l;
								
								addRow.putAll(itemRow);
								addRow.put("RECVIT", inum);
								addRow.put("QTYRCV", QTYRCV);
								addRow.put("UOMQTY", UOMQTY);
								addRow.put("TOT", TOT);
								addRow.put("BAG", BAG);
								addRow.put("BOX", BOX);
								addRow.put("PLT", PLT);
								addRow.put("SOK", SOK);
								addRow.put("EA", EA);
								addRow.put("LOTA14", barcode + String.format("%05d",(barcodeSeq)));
								
								
								batchItemMap = new HashMap();
								batchItemMap.putAll(addRow);
								batchItemList.add(batchItemMap);
								
								count++;
								itemCount += 10;
							}
							
						}
						
						// 나머지 값
						addRow = new DataMap();
						
						addRow.putAll(itemRow);
						
						String snum = String.valueOf(itemCount);
						String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
						
						addRow.put("RECVIT", inum);
						
						if("0".equals(REMQTY)) {
							addRow.put("QTYRCV", QTYRCV);
						}else {
							addRow.put("QTYRCV", QTYRCV_REM);
						}
						
						addRow.put("UOMQTY", UOMQTY_REM);
						addRow.put("TOT", TOT_REM);
						addRow.put("BAG", BAG_REM);
						addRow.put("BOX", BOX_REM);
						addRow.put("PLT", PLT_REM);
						addRow.put("SOK", SOK_REM);
						addRow.put("EA", EA_REM);
						addRow.put("LOTA14", barcode + String.format("%05d",(barcodeSeq + 1)));
						
						addRow.put("LOTA09", row.getString("LOTA09"));
						addRow.put("LOTA11", row.getString("LOTA11"));
						
						batchItemMap = new HashMap();
						batchItemMap.putAll(addRow);
						batchItemList.add(batchItemMap);
						
						count++;
						itemCount += 10;
						
					}else {
						
						String snum = String.valueOf(itemCount);
						String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
						itemRow.put("RECVIT", inum);
						
						batchItemMap = new HashMap();
						batchItemMap.putAll(itemRow);
						batchItemList.add(batchItemMap);
						
						count++;
						itemCount += 10;
						
					}
					
				}
				
				
				if(!"".equals(sb.toString())) {
					sb.append(",");
				}
				sb.append("'").append(recvky).append("'");
				
			}
			
			// 입고 헤더 데이터 대량 insert
			execBatchList("WmsInbound.GR02Batch", batchHeadList);
			
			// 입고 아이템 데이터 대량 insert
			execBatchList("WmsInbound.GR02SubBatch", batchItemList);

			// 처리상태 Y셋팅
			//row.setModuleCommand(sqlMapNamespace, "GR98");
			//commonDao.update(row);
			execBatchList("WmsInbound.GR98Batch", batchItemList);
			// 입고 결과 키 insert
			execBatchList("WmsInbound.saveGR98RcvLBatch", batchItemList);
			
		}

		DataMap rsMap = new DataMap();
		
		rsMap.put("RECVKY", sb.toString());
		
		return rsMap;
	}
	
	/***************************************************************************************
	 * [GR98] 기초 재고 셋업 - 프로시저 저장
	 * 
	 ***************************************************************************************/
	public List<DataMap> saveGR98Proc(DataMap map) throws Exception {
		
		List<DataMap> list = map.getList("head");
		
		DataMap row = new DataMap();
		
		String sqlMapNamespace = "WmsInbound";
		
		List<DataMap> rsList = new ArrayList<DataMap>();
		
		for(int i=0; i < list.size(); i++) {
			
			row = list.get(i).getMap("map");
			
			TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
	        TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
	        
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			row.setModuleCommand(sqlMapNamespace, "SAVE_GR98_PROC_CALL"); 
			commonDao.getMap(row);
			
			String ERRORCODE = row.getString("ERRORCODE");
			String ERRORMESG = row.getString("ERRORMESG");
			
			log.debug("---------------------------------------------------------------------------------------------------------------------------");
			log.debug("InboundService.saveGR98Proc - i  " + i + " - WAREKY : " + row.getString("WAREKY") + " - LOTA02 : " + row.getString("LOTA02"));
			log.debug(i + " - ERRORCODE : " + ERRORCODE);
			log.debug(i + " - ERRORMESG : " + ERRORMESG);
			if("1".equals(ERRORCODE)) {
				transactionManager.commit(transactionStatus);
				log.debug(i + " - commit");
			}else {
				transactionManager.rollback(transactionStatus);
				log.debug(i + " - rollback");
			}
			log.debug("---------------------------------------------------------------------------------------------------------------------------");
			
			rsList.add(row);
			
		}
		
		return rsList;
	}
	
	@Transactional
	public DataMap deleteGR98(DataMap map) throws Exception {
		
		List<DataMap> headList = map.getList("head");
		
		String sqlMapNamespace = "WmsInbound";
		
		int count = 0;
		for(DataMap headRow : headList) {
			headRow.getMap("map").setModuleCommand(sqlMapNamespace, "GR98");
			headRow.getMap("map").put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			commonDao.delete(headRow.getMap("map"));
			count++;
		}
				
		DataMap rsMap = new DataMap();
		rsMap.put("count", count);
		
		return rsMap;
	}
	
	
	@Transactional
	public DataMap saveGR99(DataMap map) throws Exception {
		
		List<DataMap> head = map.getList("head");
		List<DataMap> itemList = map.getList("list");
		
		List<DataMap> ifList = new ArrayList<DataMap>(); // 실적 인터페이스 목록
		
		List<DataMap> ifidList = new ArrayList<DataMap>();     // IFID : 인터페이스 전송 목록
		DataMap ifidMap = new DataMap();                       // IFID : 입고유형별 LOGSEQNO
		
		
		DataMap ifRow = new DataMap();
		
		DataMap ifMap = new DataMap();
		
		int count = 0;
		int itemCount = 10;
		
		DataMap headRow = head.get(0).getMap("map");
		String sqlMapNamespace = "WmsInbound";
		
		String RCPTTY = headRow.getString("DOCUTY");
		String recvky = wmsService.getDocSeq(RCPTTY);
		String SAPIFYN = headRow.getString("SAPIFYN"); 
		String IFID = headRow.getString("IFID");
		String OWNRKY = headRow.getString("OWNRKY");
		
		headRow.setModuleCommand(sqlMapNamespace, "GR02");
		headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		headRow.put("RECVKY", recvky);
		headRow.put("RCPTTY", headRow.getString("DOCUTY"));
		
		commonDao.insert(headRow);
		
		for(int i = 0; i < itemList.size(); i++) {
			
			//DataMap row = itemList.get(i).getMap("map");
			
			DataMap inputData = new DataMap();
			
			inputData = itemList.get(i).getMap("map");
			inputData.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			inputData.put("RECVKY", recvky);
			
			String snum = String.valueOf(itemCount);
			String inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
			inputData.put("RECVIT", inum);
			
			// LOTA15 LOT번호 없을 경우 신규 채번
			String LOTA15 = inputData.getString("LOTA15").trim();
			if(StringUtils.isEmpty(LOTA15)) {
				inputData.put("RCPTTY",headRow.getString("DOCCAT"));
				inputData.put("DPTNKY",headRow.getString("DPTNKY"));
				inputData.setModuleCommand("WmsInbound", "GENNOTNO");
				String NW_LOTA15 = (String) commonDao.getObject(inputData);
				log.debug("LOTA15 : " + LOTA15 + " - NW_LOTA15 : " + NW_LOTA15);
				inputData.put("LOTA15", NW_LOTA15);
			}
			
			inputData.setModuleCommand("WmsInbound", "GR02Sub");
			commonDao.insert(inputData);
			
			log.debug(i + " - inputData : " + inputData);
			
			//ifList.add(row);
			
			count++;
			itemCount += 10;
		}
		
		if("V".equals(SAPIFYN)) {
		
			String LOGSEQNO = getLOGSEQNO();
			
			ifidMap.put("IFID", IFID);          // IFID 목록
			ifidMap.put("LOGSEQNO", LOGSEQNO);  // IF 호출 유니크 키 생성
			ifidList.add(ifidMap);
		
			ifMap.put("LOGSEQNO", LOGSEQNO);
			ifMap.put("RECVKYIN", "'"+recvky+"'");
			
			ifList = new ArrayList();
			ifList.add(ifMap);
			
			ifRow.put("list", ifList);
			
			ifRow.put("ownrky", OWNRKY);
			ifRow.put("IFID", IFID);
			ifRow.put("LOGSEQNO", LOGSEQNO);
			ifRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			// 입고실적등록  인터페이스 호출
			String insertErrMsg = iFService.dataInsertIF(ifRow);
			log.debug( "saveGR99.dataInsertIF - Msg : " + insertErrMsg );
		
		}
		
		DataMap rsMap = new DataMap();
		if(count > 0) {
			rsMap.put("RECVKY", recvky);
			rsMap.put("SAPIFYN", SAPIFYN);
		}
		
		rsMap.put("ifidList",ifidList);
		
		return rsMap;
	}
	
	
	@Transactional
	public String getPalletizingList(DataMap map) throws SQLException, Exception {
		
		// 기초재고셋업 excel 업로드
		List<DataMap> list = map.getList("list");
		StringBuffer result = new StringBuffer();
		DataMap row = new DataMap();
		DataMap palletMap = new DataMap();
		
		List<DataMap> palList = new ArrayList<DataMap>();
		//DataMap palRow = new DataMap();
		DataMap addRow = new DataMap();
		//DataMap palRemRow = new DataMap();
		
		String sqlMapNamespace = "WmsInbound";
		
		for(int i=0; i<list.size(); i++) {
			
			row = list.get(i).getMap("map");
			
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			if(row.getString("PALQTY")==null || "".equals(row.getString("PALQTY").trim())) {
				row.put("PALQTY","0");
			}
			
			row.setModuleCommand(sqlMapNamespace, "PALLET"); 
			palletMap = commonDao.getMap(row);
			
			//float PALCNT = palletMap.getInt("PALCNT");
			float PALCNT = Float.parseFloat(palletMap.getString("PALCNT"));
			
	        DataMap barcodeRow = new DataMap();
	        
	        barcodeRow.putAll(row);
	        barcodeRow.put("PALCNT", PALCNT);
	        barcodeRow.setModuleCommand(sqlMapNamespace, "NEW_BARCODE_PROC_CALL"); 
			commonDao.getMap(barcodeRow);
			
			log.debug("getPalletizingList.NEW_BARCODE_PROC_CALL : " + row);
			
			String barcode = barcodeRow.getString("BARCODE2");
			int startSeq = barcodeRow.getInt("STRSEQ");
			int endSeq = barcodeRow.getInt("ENDSEQ");
			
			log.debug("getPalletizingList - i : " + i + " - barcode : " + barcode + " - startSeq : " + startSeq + " - endSeq : " + endSeq);
			
			String PALQTY = row.getString("PALQTY");
			String BWART = row.getString("BWART");// 입고유형 - 131:반품입고
			String SKUG05 = row.getString("SKUG05"); // 제품군 - 00:원부자재, 10:제지, 20:생활			
			
			String REMQTY = palletMap.getString("REMQTY");
			
			String UOMQTY = palletMap.getString("UOMQTY");
			String TOT = palletMap.getString("TOT");
			String BAG = palletMap.getString("BAG");
			String BOX = palletMap.getString("BOX");
			String PLT = palletMap.getString("PLT");
			String SOK = palletMap.getString("SOK");
			String EA = palletMap.getString("EA");
			String QTYRCV = palletMap.getString("QTYRCV");
			
			String UOMQTY_REM = palletMap.getString("UOMQTY_REM");
			String TOT_REM = palletMap.getString("TOT_REM");
			String BAG_REM = palletMap.getString("BAG_REM");
			String BOX_REM = palletMap.getString("BOX_REM");
			String PLT_REM = palletMap.getString("PLT_REM");
			String SOK_REM = palletMap.getString("SOK_REM");
			String EA_REM = palletMap.getString("EA_REM");
			String QTYRCV_REM = palletMap.getString("QTYRCV_REM");
			
			
			/*
			row.setModuleCommand(sqlMapNamespace, "PALLETIZING"); 
			
			palRow = new DataMap();
			palRemRow = new DataMap();
			
			palRow = commonDao.getMap(row);
			palRemRow.putAll(palRow);
			*/
			
			// LOTA15 LOT번호 없을 경우 신규 채번
			String LOTA15 = row.getString("LOTA15").trim();
			if(StringUtils.isEmpty(LOTA15)) {
				row.put("RCPTTY",row.getString("RCPTTY"));
				row.setModuleCommand("WmsInbound", "GENNOTNO");
				String NW_LOTA15 = (String) commonDao.getObject(row);
				log.debug("LOTA15 : " + LOTA15 + " - NW_LOTA15 : " + NW_LOTA15);
				row.put("LOTA15", NW_LOTA15);
				//palRow.put("LOTA15", NW_LOTA15);
				//palRemRow.put("LOTA15", NW_LOTA15);
			}
			
			int barcodeSeq = 0;
			
			if(PALCNT>1) {
				for(int j=0; j<(PALCNT-1); j++) {
					addRow = new DataMap();
					
					barcodeSeq = startSeq + j;
					
					log.debug("getPalletizingList.barcodeSeq - PALCNT j : " + j + " - barcodeSeq : " + barcodeSeq + " - BWART : " + BWART + " - SKUG05 : " + SKUG05);
					
					//addRow.putAll(palRow);
					addRow.putAll(row);
					addRow.put("QTYRCV", QTYRCV);
					addRow.put("QTYRCV1", QTYRCV);
					addRow.put("UOMQTY", UOMQTY);
					addRow.put("TOT", TOT);
					addRow.put("BAG", BAG);
					addRow.put("BOX", BOX);
					addRow.put("PLT", PLT);
					addRow.put("SOK", SOK);
					addRow.put("EA", EA);
					
					// 20220923 반품입고 ps는 마지막 자릿수 4자리, 나머지는 5자리로 구성 요청
					if("131".equals(BWART) && "10".equals(SKUG05)) {
						addRow.put("LOTA14", barcode + String.format("%04d",(barcodeSeq)));
					}else {
						addRow.put("LOTA14", barcode + String.format("%04d",(barcodeSeq)));
					}
					
					addRow.put("SKUG05_1", row.getString("SKUG05_1"));
					
					palList.add(addRow);
				}
				
				barcodeSeq = barcodeSeq + 1;
			}else {
				barcodeSeq = startSeq;
			}

			addRow = new DataMap();
			addRow.putAll(row);
			
			// 나머지 값
			if("0".equals(REMQTY)) {
				addRow.put("QTYRCV", QTYRCV);
				addRow.put("QTYRCV1", QTYRCV);
			}else {
				addRow.put("QTYRCV", QTYRCV_REM);
				addRow.put("QTYRCV1", QTYRCV_REM);
			}

			log.debug("last.barcodeSeq : " + barcodeSeq + " - BWART : " + BWART + " - SKUG05 : " + SKUG05);
			
			addRow.put("UOMQTY", UOMQTY_REM);
			addRow.put("TOT", TOT_REM);
			addRow.put("BAG", BAG_REM);
			addRow.put("BOX", BOX_REM);
			addRow.put("PLT", PLT_REM);
			addRow.put("SOK", SOK_REM);
			addRow.put("EA", EA_REM);
			
			// 20220923 반품입고 ps는 마지막 자릿수 4자리, 나머지는 5자리로 구성 요청
			if("131".equals(BWART) && "10".equals(SKUG05)) {
				addRow.put("LOTA14", barcode + String.format("%04d",(barcodeSeq)));
			}else {
				addRow.put("LOTA14", barcode + String.format("%04d",(barcodeSeq)));
			}
			
			addRow.put("LOTA09", row.getString("LOTA09"));
			addRow.put("LOTA11", row.getString("LOTA11"));
			
			palList.add(addRow);
			
			//result.append(commonDao.getJdbcData(row));
			//result.append(commonDao.getList(row));
			
		}
		
		result = getConvertListToJdbcString(palList);
		
		return result.toString();
	}
	
	public StringBuffer getConvertListToJdbcString(List<DataMap> list) throws Exception {
		
		StringBuffer sb = new StringBuffer();
		DataMap row = new DataMap();
		
		if(list!=null) {
			
			for(int i=0; i<list.size(); i++) {
				row = list.get(i).getMap("map");
			
				if(i==0) {
					Iterator<String> keySetIteratorH = row.keySet().iterator();
					int idx=0;
					while (keySetIteratorH.hasNext()) {	
					    
						String key = keySetIteratorH.next();
					    if(idx>0) {
					    	sb.append("↓");
					    }
						sb.append(key);
					    idx++;
					}
					sb.append("↑");
				}
				
				Iterator<String> keySetIterator = row.keySet().iterator();
				int idx=0;
				while (keySetIterator.hasNext()) {	
				    
					String key = keySetIterator.next();
				    if(idx>0) {
				    	sb.append("↓");
				    }
					sb.append(row.getString(key));
				    idx++;
				}		
				
				if(i!=(list.size()-1)) {
					sb.append("↑");
				}
			}
		
		}
		
		return sb;
		
	}
	
	
