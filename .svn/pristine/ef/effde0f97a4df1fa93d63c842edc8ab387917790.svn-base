						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + sebeln + "] 입고 실적(MES) 인터페이스 전송 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + sebeln + "] 입고 실적(MES) 인터페이스 전송 에러 : " + cutErrMsg;
					}
				}catch(Exception e) {
					log.error("InboundService.saveGr02New 입고 실적(MES) 인터페이스 에러 - ifid : " + I_IFID_MES + " - Exception Error : " + e.getMessage());
					String errMsg = e.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + sebeln + "] 입고 실적(MES) 인터페이스 전송 에러 : " + cutErrMsg;
					e.printStackTrace();
				}
				
				String errMassage = ifRsMsg.replaceAll(" ", "");
				
				// 에러 처리
				if("E".equals(ifRsCode) || "I".equals(ifRsCode)) {
					// 인터페이스 에러 결과 메세지
					totRsCode = ifRsCode;
					totRsSbMsg.append("\n");
					totRsSbMsg.append(ifRsMsg);
					successYN = false;

					/*
						MES로 생산입고실적 전송 실패시 SAP 취소 RFC CALL을 해야함.
						GR09에서 Grid Head정보로 입고취소를 하고 있음
						SAP만 취소하도록 Head 데이터를 만들어 주는 쿼리를 따로 생성 (GR09CANCEL)
						MES에 취소에 대한 인터페이스 정보는 만들지 않도록 쿼리를 수정
					*/
					if ("101".equals(rcptty)){ //입고유형이 생산입고(101)시 취소. 
						row = head.get(i).getMap("map");
						
						DataMap cancelMap = new DataMap();
						//기존 취소 로직에서 I_IFID_MES는 비운 상태로 보내야함..
						cancelMap.setModuleCommand("WmsInbound", "GR09CANCEL");
						cancelMap.put("OWNRKY", row.getString("OWNRKY"));
						cancelMap.put("WAREKY", row.getString("WAREKY"));
						cancelMap.put("EBELN" , row.getString("EBELN"));
						cancelMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						
						List<DataMap> cancelList = commonDao.getList(cancelMap);
						cancelMap.put("head", cancelList);
						
						deleteGR09New(cancelMap);
						
					}
					
					// 240221 HNW MES 리턴메시지 관련 처리 추가(테스트 후 반영)
					if (errMassage.indexOf("입고처리된개별바코드") > 0) {
						// MES에서 이미 입고처리된 개별 바코드라는 메시지가 리턴될 때, SAP, MES는 이미 정상처리된 것이므로 SAP입고취소 처리 + WMS는 입고완료로 처리
						
						DataMap headRow = new DataMap();
						headRow = head.get(i).getMap("map");

						log.debug("~~ saveGr02New MES 인터페이스 처리 - WMS 자체 입고처리 / 이미 입고처리된 개별 바코드" + i + " / " + headRow.getString("SEBELN"));
						
						DataMap recvMap = new DataMap();					
						recvMap.put("OWNRKY", headRow.getString("OWNRKY"));
						recvMap.put("WAREKY", headRow.getString("WAREKY"));
						recvMap.put("EBELN" , headRow.getString("SEBELN"));
						recvMap.put("headSebeln", headRow.getString("SEBELN")); //입고처리시 단건처리를 위한 설정
						recvMap.put("PROGID", "GR02_R"); //재 입고처리 실패시 IFSAPLOG에 데이터 INSERT를 할 경우 임의로 GR02_R라는 값을 넣도록 설정
						recvMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						
						recvMap.setModuleCommand("WmsInbound", "GR09RECV"); // 재입고 head 정보
						List<DataMap> recvList = commonDao.getList(recvMap);
						recvMap.put("head", recvList);
						
						//MES입고취소 인터페이스 실패 후 SAP만 전송을 해야하기때문에 입고 쿼리에서  I_IFID_MES는 비운 상태로 쿼리작성. (해당 로직으로 재입고시 MES로는 전송 안함)
						recvMap.setModuleCommand("WmsInbound", "GR09RECVSUB"); // 재입고 detail 정보
						List<DataMap> recvSubList = commonDao.getList(recvMap);
						recvMap.put("list", recvSubList);
						
						saveGr02New_X(recvMap);
						
						//continue; // 위에서 출고취소가 되었기 때문에, WMS, SAP는 취소상태. 이어서 다시 재처리하는 방식임.
					}
				
				} 
				
			}
			log.debug("~~ 입고 실적(MES) 인터페이스 전송 rcpttyList : " + rcpttyMesList.toString());
			log.debug("~~ 입고 실적(MES) 인터페이스 전송 rcpttyMap : " + rcpttyMesMap.toString());
			log.debug("~~ 입고 실적(MES) 인터페이스 전송 ifidOtrList : " + ifidMesList.toString());
			//mes 미연동 전송 시 마지막

			// 품질검사 인터페이스
			// 조건 입고타입이 131 반품입고이거나 품질검사 여부가 위의 로직에서 체크가 되서 내려온 것
			if( (null!=I_RCPTTY && "131".equals(I_RCPTTY) || (null!=I_QRTAYN && "V".equals(I_QRTAYN)) ) 
					&& (null!=I_IFID_QTR && !"".equals(I_IFID_QTR.trim())) && rcQtrList!=null && rcQtrList.size()>0 ) {
				
				// 품질검사 인터페이스 인터페이스 전송
				String ifRsCode = "S";
				String ifRsMsg = "";
				
				try {
					
					DataMap sendMap = new DataMap();
					
					sendMap = ifidQtrList.get(0);
					
					sendMap.put("ownrky", I_OWNRKY);
					sendMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					ifRsMsg = iFService.sendIF(sendMap);
					
					if( ifRsMsg==null || !ifRsMsg.equals("SUCCESS")) {
						ifRsCode = "E";
						ifRsMsg = "[" + sebeln + "] 입고 품질검사 인터페이스 전송 에러 : " + ifRsMsg;
					}
					
					log.debug("InboundService.saveGr02New 입고 품질검사 인터페이스 전송 - ifid : " + I_IFID_QTR + " - ifRsMsg : " + ifRsMsg );
				
				} catch(SQLException se) {
					log.error("InboundService.saveGr02New 입고 품질검사 인터페이스 전송 - ifid : " + I_IFID_QTR + " - SQLException Error : " + se.getMessage());
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					ifRsCode = "E";
					ifRsMsg = "[" + sebeln + "] 입고 품질검사 인터페이스 전송 에러  : " + cutErrMsg;
					
				} catch(BadSqlGrammarException bse) {
					log.error("InboundService.saveGr02New 입고 품질검사 인터페이스 전송 - ifid : " + I_IFID_QTR + " - BadSqlGrammarException Error : " + bse.getMessage());
					ifRsCode = "E";
					try {
						SQLException se = bse.getSQLException();
						String errMsg = se.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
						ifRsMsg = "[" + sebeln + "] 입고 품질검사 인터페이스 전송 에러 : " + cutErrMsg;
					}catch(Exception e) {
						String errMsg = bse.getMessage();
						String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
