	/**************************************************************************
	 * 2022-07-06 구매포탈 마감
	 *  - IFWMS103.DLEFLG : 구매포탈 마감 플래그 업데이트
	 *	- IFWMS103.DLEDAT : 구매포탈 마감 일자 업데이트
	 *	- IFWMS103.DLETIM : 구매포탈 마감 일시 업데이트
	 *	- IFWMS103.DLEUSR : 구매포탈 마감 유저 업데이트
	 *  - IF_PORTAL.T_IF_EPK_DEADLINE 구매포탈 마감 테이블 데이터 추가 
	 **************************************************************************/
	@Transactional
	public DataMap deadlineGR02(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();                          // return Map
		
		List<DataMap> head = map.getList("head");
		
		DataMap headMap = new DataMap();
		
		int count = 0;
		
		for(int i = 0 ; i < head.size() ; i ++){
			
			headMap = new DataMap();
			headMap = head.get(i).getMap("map");
			
			headMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			// WMS 구매입고 마감 처리
			headMap.put("DLEFLG", "Y");  // 구매포탈 마감 플래그 (Y:마감완료 / N:마감취소)
			headMap.setModuleCommand("WmsInbound", "GR02_DEADLINE_FLAG");
			commonDao.update(headMap);
			
			// 구매포탈 마감 처리
			
			headMap.put("STATUS", "C");  // 상태구분 (C:마감완료 / D:마감취소)
			headMap.setModuleCommand("WmsInbound", "GR02_IF_PTL_DEADLINE");
			commonDao.insert(headMap);
			
			count++;
		}
		
		rsMap.put("count", count);
		
		return rsMap;
	}
	
	/**************************************************************************
	 * 2022-07-06 구매포탈 마감 취소
	 *  - IFWMS103.DLEFLG : 구매포탈 마감 플래그 업데이트
	 *	- IFWMS103.DLEDAT : 구매포탈 마감 일자 업데이트
	 *	- IFWMS103.DLETIM : 구매포탈 마감 일시 업데이트
	 *	- IFWMS103.DLEUSR : 구매포탈 마감 유저 업데이트
	 *  - IF_PORTAL.T_IF_EPK_DEADLINE 구매포탈 마감 테이블 데이터 추가 
	 **************************************************************************/
	@Transactional
	public DataMap deadlineCancelGR02(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();                          // return Map
		
		List<DataMap> head = map.getList("head");
		
		DataMap headMap = new DataMap();
		
		int count = 0;
		
		for(int i = 0 ; i < head.size() ; i ++){
			
			headMap = new DataMap();
			headMap = head.get(i).getMap("map");
			
			headMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			// WMS 구매입고 마감 처리
			headMap.put("DLEFLG", "N"); // 구매포탈 마감 플래그(Y:마감완료 / N:마감취소)
			headMap.setModuleCommand("WmsInbound", "GR02_DEADLINE_FLAG");
			commonDao.update(headMap);
			
			// 구매포탈 마감 처리
			headMap.put("STATUS", "D"); // 상태구분 (C:마감완료 / D:마감취소)
			headMap.setModuleCommand("WmsInbound", "GR02_IF_PTL_DEADLINE");
			commonDao.insert(headMap);
			
			count++;
		}
		
		rsMap.put("count", count);
		
		return rsMap;
	}
	
	
	
	@Transactional
	public String getRecvkyArrToInString(List<String> IFID_LIST) {
		String rs = "";
		
		if(IFID_LIST!=null) {
			for(int i=0;i<IFID_LIST.size();i++) {
				if(!"".equals(rs)) {
					rs += ",";
				}
				rs += "'"+IFID_LIST.get(i)+"'";
			}
		}
		
		return rs;
	}
	
	@Transactional
	public void setGr02DocSeqList(List<Map> batchHeadList, List<Map> batchItemList, List<String> docNumList
			                    , List<String> rcpttyList, DataMap rcpttyMap, List<String> rcQtrList, DataMap rcQtrMap
			                    , DataMap rcStnMap, List<String> rcItmList, DataMap rcItmMap ) throws SQLException {
		
		DataMap dataMap = new DataMap();
		Map batchHeadMap = new HashMap();
		Map batchItemMap = new HashMap();
		
		Map delBatchHeadMap = new HashMap();
		
		DataMap rsMap = new DataMap();
		
		StringBuffer sb = new StringBuffer();
		
		List<String> rcStnList = new ArrayList<String>();      // IF 즉시불출 : 입고유형
		
		List<Map> delBatchHeadList = new ArrayList();
		
		
		for(int i=0; i<batchHeadList.size(); i++) {
			batchHeadMap = batchHeadList.get(i);
			
			String RCPTTY = (String) batchHeadMap.get("RCPTTY");
			String SEBELN = (String) batchHeadMap.get("SEBELN");
			String RECVKY = (String) batchHeadMap.get("RECVKY");
			
			if(i>0) {
				sb.append("\n UNION ALL \n");
			}
			
			if(RECVKY!=null && !RECVKY.trim().equals("")) {
				sb.append(" SELECT '" + RECVKY + "' AS DOCSEQ, '" + SEBELN + "' AS SEBELN, 'N' AS NEW_YN FROM DUAL ");
			}else {
				sb.append(" SELECT SZF_GETDOCNUMBER('" + RCPTTY + "') AS DOCSEQ, '" + SEBELN + "' AS SEBELN, 'Y' AS NEW_YN FROM DUAL ");
			}
			
		}
		
		dataMap.setModuleCommand("WmsInbound", "FN_DOCUSEQ");
		dataMap.put("SQL", sb.toString());
		
		List<DataMap> rsList = commonDao.getList(dataMap);
		
		for(int i=0; i<rsList.size(); i++) {
			rsMap = rsList.get(i);
			
			String DOCSEQ = rsMap.getString("DOCSEQ"); // 입고문서키
			String SEBELN = rsMap.getString("SEBELN"); // 오더번호
			String NEW_YN = rsMap.getString("NEW_YN"); // 입고문서키 신규채번 여부
			
			// 입고문서 헤더 세팅
			for(int j=0; j<batchHeadList.size(); j++) {
				batchHeadMap = batchHeadList.get(j);
				
				String I_SEBELN = (String) batchHeadMap.get("SEBELN");
				
				if(I_SEBELN.equals(SEBELN)) {
					
					// 배치insert Header 문서키 세팅
					batchHeadMap.put("RECVKY", DOCSEQ);
					
					// 결과 리턴 입고 문서키
					docNumList.add(DOCSEQ);
					
					if(!"Y".equals(NEW_YN)) {
						delBatchHeadMap = new HashMap();
						//batchHeadMap.putAll(delBatchHeadMap);
						delBatchHeadMap.putAll(batchHeadMap);
						delBatchHeadList.add(delBatchHeadMap);
					}
					
					break;
				}
			}
			
			// 입고문서 아이템 세팅
			for(int j=0; j<batchItemList.size(); j++) {
				batchItemMap = batchItemList.get(j);
				
				String I_SEBELN   = (String) batchItemMap.get("SEBELN");
				String I_RCPTTY   = (String) batchItemMap.get("RCPTTY");   // 입고유형
				String I_IFID     = (String) batchItemMap.get("IFID");     // 실적 IF_ID
				String I_IFID_QTR = (String) batchItemMap.get("IFID_QTR"); // 품질 IF_ID
				String I_IFID_STN = (String) batchItemMap.get("IFID_STN"); // 즉시불출 IF_ID
				String I_IFID_ITM = (String) batchItemMap.get("IFID_ITM"); // 수입밀롤 IF_ID
				String I_OWNRKY   = (String) batchItemMap.get("OWNRKY");  
				String I_QRTAYN   = (String) batchItemMap.get("QRTAYN");   // 품질검사여부
				String I_SHTAYN   = (String) batchItemMap.get("SHTAYN");   // 즉시불출여부
				
				if(I_SEBELN.equals(SEBELN)) {
					
					// 배치insert Item 문서키 세팅
					batchItemMap.put("RECVKY", DOCSEQ);
					
					// IF 실적 입고유형별 입고키 넣기
					if(null!=I_IFID && !"".equals(I_IFID.trim())) {
						if(!rcpttyList.contains(I_RCPTTY)) {
							rcpttyList.add(I_RCPTTY);
							rcpttyMap.put(I_RCPTTY,""+DOCSEQ+"");
							rcpttyMap.put(I_RCPTTY+"_IFID",I_IFID);
							rcpttyMap.put(I_RCPTTY+"_OWNRKY",I_OWNRKY);
						} else {
							String docNums = rcpttyMap.getString(I_RCPTTY);
							if(!docNums.contains(DOCSEQ.trim())) {
								if(docNums!=null && !"".equals(docNums.trim())) {
									docNums += ","+DOCSEQ+"";
								} else {
									docNums += ""+DOCSEQ+"";
								}
								rcpttyMap.put(I_RCPTTY,docNums);
							}
						}
					}
					
					// 품질검사
					if( ((null!=I_RCPTTY && "131".equals(I_RCPTTY)) || (null!=I_QRTAYN && "V".equals(I_QRTAYN)) ) && (null!=I_IFID_QTR && !"".equals(I_IFID_QTR.trim())) ) {
					
						// IF 품질검사 입고유형별 입고키 넣기
						if(!rcQtrList.contains(I_RCPTTY)) {
							rcQtrList.add(I_RCPTTY);
							rcQtrMap.put(I_RCPTTY,""+DOCSEQ+"");
							rcQtrMap.put(I_RCPTTY+"_IFID",I_IFID_QTR);
							rcQtrMap.put(I_RCPTTY+"_OWNRKY",I_OWNRKY);
						} else {
							String docNums = rcQtrMap.getString(I_RCPTTY);
							if(!docNums.contains(DOCSEQ.trim())) {
								if(docNums!=null && !"".equals(docNums.trim())) {
									docNums += ","+DOCSEQ+"";
								}else {
									docNums += ""+DOCSEQ+"";
								}
								rcQtrMap.put(I_RCPTTY,docNums);
							}
						}
					
					}
					
					// 즉시불출
					if(null!=I_SHTAYN && "V".equals(I_SHTAYN) && (null!=I_IFID_STN && !"".equals(I_IFID_STN.trim())) ) {
						rcStnList.add(DOCSEQ);
						rcStnMap.put("IFID_STN",I_IFID_STN);
					}
					
					// 수입밀롤
					if(null!=I_RCPTTY && "121".equals(I_RCPTTY) && (null!=I_IFID_ITM && !"".equals(I_IFID_ITM.trim())) ) {
						
						// IF 수입밀롤 입고유형별 입고키 넣기
						if(!rcItmList.contains(I_RCPTTY)) {
							rcItmList.add(I_RCPTTY);
							rcItmMap.put(I_RCPTTY,""+DOCSEQ+"");
							rcItmMap.put(I_RCPTTY+"_IFID",I_IFID_ITM);
							rcItmMap.put(I_RCPTTY+"_OWNRKY",I_OWNRKY);
						} else {
							String docNums = rcItmMap.getString(I_RCPTTY);
							
							if(!docNums.contains(DOCSEQ.trim())) {
								if(docNums!=null && !"".equals(docNums.trim())) {
									docNums += ","+DOCSEQ+"";
								}else {
									docNums += ""+DOCSEQ+"";
								}
								rcItmMap.put(I_RCPTTY,docNums);
							}
						}
						
					}
					
				}
			}
			
			// 즉시불출 목록 있으면 데이터 담기. 즉시불출은 프로시져 호출해야되서, 데이터 담는게 다름.
			if(null!=rcStnList && rcStnList.size()>0) {
				rcStnMap.put("RECVKYS", rcStnList);
			}
			
		}

		// 이미 입고 헤더 번호 가있는데이터는 기존 입고번호 활용해야 되므로 헤더 데이터 삭제
		for(int i=0;i<batchHeadList.size();i++) {
			batchHeadMap = batchHeadList.get(i);
			String recvky = (String) batchHeadMap.get("RECVKY");
			for(int j=0;j<delBatchHeadList.size();j++) {
				delBatchHeadMap = delBatchHeadList.get(j);
				String delrecvky = (String) delBatchHeadMap.get("RECVKY");
				if(delrecvky.equals(recvky)) {
					batchHeadList.remove(i);
					break;
				}
			}
		}

	}
	
	@Transactional
	public String getLOGSEQNO() throws SQLException {
	
		String LOGSEQNO ="";
		
		DataMap logoIdxMap = new DataMap();
		logoIdxMap.setModuleCommand("Erpif", "IFWMSLOGSEQNO");
		logoIdxMap = commonDao.getMap(logoIdxMap);
		
		LOGSEQNO = logoIdxMap.getString("LOGSEQNO");
		
		return LOGSEQNO;
	}
	
	// 실적 인터페이스 저장 
	@Transactional
	public void dataInsertIF(DataMap map, List<String> rcpttyList, DataMap rcpttyMap, List<DataMap> ifidList) throws SQLException {
		
		List<DataMap> ifList = new ArrayList<DataMap>();       // IF 실적 : 실적 인터페이스 목록
		
		DataMap ifidMap = new DataMap();                       // IFID : 입고유형별 LOGSEQNO
		DataMap ifMap = new DataMap();
		DataMap ifRow = new DataMap();
		
		// 실적 인터페이스 저장
		for(int i=0;i<rcpttyList.size();i++) {
			
			ifMap = new DataMap();
			
			String RCPTTY  = rcpttyList.get(i);
			String RECVKYS = rcpttyMap.getString(RCPTTY);
			String IFIDS   = rcpttyMap.getString(RCPTTY+"_IFID");
			String OWNRKY  = rcpttyMap.getString(RCPTTY+"_OWNRKY");
			
			String[] IFID_ARR = IFIDS.split(",");
			
			String[] RECVKY_ARR = RECVKYS.split(",");
			
			List<String> RECVKY_LIST = Arrays.asList(RECVKY_ARR);
			
			for(int j=0;j<IFID_ARR.length;j++) {
			
				int limitCnt = 1000;
				int totCnt  = RECVKY_ARR.length; 
				int loopSize = (totCnt/limitCnt);
				int rmSize = (totCnt%limitCnt);
				
				if( loopSize==0) {
					loopSize=1;
					rmSize=0;
				}
				
				String RECVKYIN = "";
				String IFID = IFID_ARR[j];
				String LOGSEQNO = "";
				
				if(!ifidList.contains(IFID)) {
					ifidMap = new DataMap();
					
					LOGSEQNO = getLOGSEQNO();
					
					ifidMap.put("IFID", IFID);          // IFID 목록
					ifidMap.put("LOGSEQNO", LOGSEQNO);  // IF 호출 유니크 키 생성
					ifidMap.put("RCPTTY", RCPTTY);  // IF 호출 유니크 키 생성
					ifidList.add(ifidMap);
				} else {
					for(DataMap item : ifidList) {
						if(IFID.equals(item.getMap("map").getString("IFID"))) {
							LOGSEQNO = item.getMap("map").getString("LOGSEQNO");
							break;
						}
					}
				}
				
				for (int k = 0; k < loopSize; k++) {
				
					if(totCnt<limitCnt) {
						RECVKYIN = getRecvkyArrToInString(RECVKY_LIST);
						log.debug( k + " - RECVKYS IF send batch - start : " + (k*limitCnt) + " - end : " + RECVKY_LIST.size() );
					} else {
						RECVKYIN = getRecvkyArrToInString(RECVKY_LIST.subList( (k*limitCnt), (((k+1)*limitCnt)) ));
						log.debug( k + " - RECVKYS IF send batch - start : " + (k*limitCnt) + " - end : " + (((k+1)*limitCnt)) );
					}
					
					if( k==(loopSize-1) && rmSize!=0 ) {
						RECVKYIN = getRecvkyArrToInString(RECVKY_LIST.subList( ((k+1)*limitCnt), RECVKY_LIST.size() ));
						log.debug( k + " - RECVKYS IF send batch last - start : " + ((k+1)*limitCnt) + " - end : " + RECVKY_LIST.size() );
					}
					
					log.debug("dataInsertIF - loopSize : " + k + " - IFID : " + IFID);
					
					String menuId = map.getString("PROGID");
					
					ifMap.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
					ifMap.put("menuId", menuId);

					ifMap.put("LOGSEQNO", LOGSEQNO);
					ifMap.put("RECVKYIN", RECVKYIN);
					
					ifList = new ArrayList();
					ifList.add(ifMap);
					
					ifRow = new DataMap();
					
					ifRow.put("list", ifList);
					
					ifRow.put("ownrky", OWNRKY);
					ifRow.put("IFID", IFID);
					ifRow.put("LOGSEQNO", ifMap.getString("LOGSEQNO"));
					ifRow.put("RCPTTY", RCPTTY);
					ifRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));	
					
//					String menuId = map.getString("MENUID");
					
					if(menuId.equals("SD07")){
						DataMap listMap = map;
						ifRow.put("row", listMap);
						ifRow.put("menuId", menuId);
					}
					
					// 입고실적등록  인터페이스 호출
					String insertErrMsg = iFService.dataInsertIF(ifRow);
					log.debug( "InboundService.dataInsertIF - Msg : " + insertErrMsg );
					
				}
			
			}
		
		}
		
	}
	
	// 즉시분출 인터페이스 저장
	@Transactional
	public void dataInsertIFStn(DataMap map, DataMap rcStnMap, List<DataMap> ifidList) throws SQLException {
		
		List<DataMap> ifList = new ArrayList<DataMap>();       // IF 실적 : 실적 인터페이스 목록
		
		DataMap ifidMap = new DataMap();                       // IFID : 입고유형별 LOGSEQNO
		DataMap doMap = new DataMap();
		
		List<String> rcStnList = new ArrayList<String>();      // IF 즉시불출 : 입고유형
		
		String sqlMapNamespace = "WmsInbound";
		
		String I_IFID_STN = rcStnMap.getString("IFID_STN");
		
		String LOGSEQNO = "";
		
		
		if(StringUtils.isNotEmpty(I_IFID_STN)) {
			
			ifidMap = new DataMap();
			
			LOGSEQNO = getLOGSEQNO();
			
			ifidMap.put("IFID", I_IFID_STN);    // IFID 목록
			ifidMap.put("LOGSEQNO", LOGSEQNO);  // IF 호출 유니크 키 생성
			ifidList.add(ifidMap);
			
			rcStnList = rcStnMap.getList("RECVKYS");
			
			for(int i=0; i<rcStnList.size();i++) {
				String recvky = rcStnList.get(i);
				
				doMap = new DataMap();
				doMap.put("RECVKY", recvky);
				doMap.put("LOGSEQNO", LOGSEQNO);
				
				doMap.setModuleCommand(sqlMapNamespace, "DIRECT_OUTBOUND_PROC_CALL"); 
				commonDao.getMap(doMap);
				
			}
			
		}
		
	}
	
	
