							itemRow.put("LOTA06", "05");
							I_QRTAYN   = qrtayn;     	// 품질검사여부
						}else if( !"V".equals(shtayn) && (null!=bwart && !"131".equals(bwart) && !"135".equals(bwart)) && (null!=qrtayn && "V".equals(qrtayn)) ) {
