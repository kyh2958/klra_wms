		for(int k = 0 ; k < docNumList.size() ; k ++){
			if(k != 0){
				sb.append(",");
				sb1.append(",");
			}
			sb.append("'").append(docNumList.get(k)).append("'");
			sb1.append("").append(docNumList.get(k)).append("");
		}
		rsMap.put("RECVKYS", sb.toString());
		rsMap.put("RECVKY", sb1.toString());
		rsMap.put("SAPIFYN", sapifyn);
		
		
		// 입고 RECDH,RECDI,SAP실적 성공 목록
		StringBuilder sb2 = new StringBuilder(); // 입고 전체완료 확인 sql
		try {
			for(int k = 0 ; k < sebelnList.size() ; k ++){
				if(k != 0){
					sb2.append(",");
				}
				sb2.append("'").append(sebelnList.get(k)).append("'");
			}
			if("".equals(sb2.toString())) {
				sb2.append("' '");
			}
			
			DataMap completeMap = new DataMap();
			completeMap.put("SEBELNS", sb2.toString());
			completeMap.setModuleCommand("WmsInbound", "GR_COMPLETE");
			sucList = commonDao.getList(completeMap);
		}catch(Exception e) {
			log.debug("~~ saveGr02New.GR_COMPLETE error : " + e.getMessage() );
			e.printStackTrace();
		}
		// 인터페이스 전송 목록
		rsMap.put("sucList", sucList);
		
		// SAP 실적 인터페이스 오류 로그
		try {
			log.debug("~~ saveGr02New.sapIfErrList.size : " + sapIfErrList.size() );
			if(sapIfErrList!=null && sapIfErrList.size()>0) {
				execBatchList("WmsInbound.GR_IF_SAP_LOG_BATCH", sapIfErrList);
			}
		}catch(Exception e) {
			log.debug("~~ saveGr02New.GR_IF_SAP_LOG_BATCH error : " + e.getMessage() );
			e.printStackTrace();
		}
		
		//if(1==1) commonDao.rollback();
		
		return rsMap;
	}
	
	// 에러메세지 자르기
	public String getExceptionMsgCut(String errMsg, int errMsgLen) {
		String result = "";
		try {
			if(errMsgLen<0)errMsgLen=100;
			if(errMsg!=null && errMsg.length()>errMsgLen) {
				result = errMsg.substring(0, errMsgLen);
			}else {
				result = errMsg;
			}
		}catch(Exception e) {
			log.debug("getExceptionMsgCut error : " + e.getMessage());
			e.printStackTrace();
			return result;
		}
		return result;
	}
	
	@Transactional
	public String validationOrderGr02(DataMap map) throws SQLException {
		String result = "OK";
		int	   sqlLimit = 500;
		int	   sqlCount = 1;
		int	   sqlTotCount = 1;
		
		List<DataMap> head = map.getList("head");
		List<DataMap> list = map.getList("list");
		
		String headSebeln = map.getString("headSebeln");
		
		StringBuffer sb = new StringBuffer(); 

		// item list 체크
		if(list!=null && list.size()>0) {
			for(DataMap item : list){
				if(sb.length() > 0) {
					sb.append(" UNION ALL\n ");
				}
				sb.append(" SELECT '").append(map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY)).append("' AS WAREKY ");	
				sb.append("      , '").append(item.getMap("map").get("SEQNO")).append("' AS SEQNO ");
				sb.append("      , '").append(item.getMap("map").get("MENGE")).append("' AS MENGE ");
				sb.append("      , '").append(item.getMap("map").get("MENGE_R")).append("' AS MENGE_R ");
				sb.append("      , '").append(item.getMap("map").get("EBELN")).append("' AS EBELN ");
				sb.append("      , '").append(item.getMap("map").get("EBELP")).append("' AS EBELP ");
				sb.append("      , '").append(item.getMap("map").get("SKUKEY")).append("' AS SKUKEY ");
				sb.append("      , '").append(item.getMap("map").get("UOMKEY")).append("' AS UOMKEY ");
				sb.append("      , '").append(item.getMap("map").get("LOTA01_ORG")).append("' AS LOTA01 ");
				sb.append("      , '").append(item.getMap("map").get("LOTA02_ORG")).append("' AS LOTA02 ");
				sb.append("      , '").append(item.getMap("map").get("LOTA03_ORG")).append("' AS LOTA03 ");
				sb.append("      , '").append(item.getMap("map").get("LOTA07_ORG")).append("' AS LOTA07 ");
				sb.append("      , '").append(item.getMap("map").get("LOTA08_ORG")).append("' AS LOTA08 ");
				sb.append("      , '").append(item.getMap("map").get("LOTA15_ORG")).append("' AS LOTA15 ");	// 240207
				sb.append("      , '").append(item.getMap("map").get("LOTA16_ORG")).append("' AS LOTA16 ");
				sb.append("      , '").append(item.getMap("map").get("LOTA17_ORG")).append("' AS LOTA17 ");
				sb.append("      , '").append(item.getMap("map").get("QTYRCV")).append("' AS QTYRCV ");
				sb.append("      , '").append(item.getMap("map").get("CREDAT")).append("' AS CREDAT ");
				sb.append("      , '").append(item.getMap("map").get("CRETIM")).append("' AS CRETIM ");
				sb.append(" FROM DUAL ");
				
				
				if ( sqlCount == sqlLimit || sqlTotCount == list.size() ){
					map.setModuleCommand("WmsInbound", "GR02_ORDER_01");  
					map.put("APPEND_QUERY", sb.toString());
				
					List<DataMap> validList = commonDao.getValidation(map);
					if(validList.size() > 0){
						DataMap valid = validList.get(0);
						return valid.getString("RESULTMSG");
					}
					sqlCount = 0;
					sb.setLength(0); ;
				}
				sqlCount++;
				sqlTotCount++;
			}
		}
		
		// 헤더 리스트 체크
		if(head!=null && head.size()>0) {
			
			sb = new StringBuffer();
			sqlCount = 1;
			sqlTotCount = 1;
			
			int totCnt = head.size();
			if(headSebeln!=null || headSebeln.trim().equals("")) {
				totCnt = totCnt - 1;
			}
					
			for(DataMap item : head){
				
				// 현재 조회 중인 오더는 아이템 목록에서 확인
				String sebeln = item.getMap("map").getString("EBELN");
				if(headSebeln!=null && headSebeln.equals(sebeln)) {
					sqlTotCount++;
					continue;
				}
				
				if(sb.length() > 0) {
					sb.append(" UNION ALL\n ");
				}
				sb.append(" SELECT '").append(map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY)).append("' AS WAREKY ");	
				sb.append("      , '").append(item.getMap("map").get("EBELN")).append("' AS EBELN ");
				sb.append(" FROM DUAL ");
				
				
				if ( sqlCount == sqlLimit || sqlTotCount == totCnt ){
					map.setModuleCommand("WmsInbound", "GR02_ORDER_02");  
					map.put("APPEND_QUERY", sb.toString());
				
					List<DataMap> validList = commonDao.getValidation(map);
					if(validList.size() > 0){
						DataMap valid = validList.get(0);
						return valid.getString("RESULTMSG");
					}
					sqlCount = 0;
					sb.setLength(0); ;
				}
				sqlCount++;
				sqlTotCount++;
			}
		}
		
		return result;
	}
	
