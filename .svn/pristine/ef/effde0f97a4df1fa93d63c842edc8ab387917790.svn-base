	}
	

	@Transactional(rollbackFor = Exception.class)
	public DataMap deleteGR09(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();                         	// return Map
		
		List<DataMap> head = map.getList("head"); 				// 입고번호 헤더
		List<DataMap> list = map.getList("list"); 				// 입고번호 아이템
		String headRecvky =  map.getString("headRecvky"); 		// 개별선택한 입고번호
		
		int count = 0;
		
		List<DataMap> ifidList = new ArrayList<DataMap>();     // IFID : 인터페이스 전송 목록
		
		List<String> rcpttyList = new ArrayList<String>();     // IF 실적 : 입고유형
		DataMap rcpttyMap = new DataMap();                     // IF 실적 : 입고유형별 입고헤더키
		
		
		List<Map> batchHeadList = new ArrayList();             // Batch Insert Header List
		Map batchHeadMap = new HashMap();                      // Batch Insert Header Map
		
		List<Map> batchItemList = new ArrayList();             // Batch Insert Item List
		Map batchItemMap = new HashMap();                      // Batch Insert Item Map
		
		DataMap headRow = new DataMap();
		DataMap itemRow = new DataMap();
		
		for(int i=0;i<head.size();i++){
			headRow = head.get(i).getMap("map");
			
			String recvky = headRow.getString("RECVKY");
			
			if(StringUtils.isNotEmpty(headRecvky) && recvky.equals(headRecvky)) {
				
				for(int j=0;j<list.size();j++){
					itemRow = list.get(j).getMap("map");
					
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					batchItemMap = new HashMap();
					batchItemMap.putAll(itemRow);
					batchItemList.add(batchItemMap);
					
				}
				
				// 아이템이 삭제
				execBatchList("WmsInbound.RECDIDEL_BATCH", batchItemList);
				
				// 아이템이 모두 삭제되면 헤더도 삭제
				headRow.setModuleCommand("WmsInbound", "RECDI_ITEMCNT");
				int cnt = commonDao.getCount(headRow);
				if(cnt == 0) {
					headRow.setModuleCommand("WmsInbound", "GR09DELETEHEADER");
					headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					commonDao.update(headRow);
				}
				
			} else {
				
				headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				batchHeadMap = new HashMap();
				batchHeadMap.putAll(headRow);
				batchHeadList.add(batchHeadMap);
				
			}
			
			// 입고 취소시 실적 IF 데이터 추출
			String I_RCPTTY = headRow.getString("RCPTTY");
			String I_IFID   = headRow.getString("IFID");
			String I_OWNRKY = headRow.getString("OWNRKY");
			String I_RECVKY = headRow.getString("RECVKY");
			
			// IF 실적 입고유형별 입고키 넣기
			if(!rcpttyList.contains(I_RCPTTY)) {
				rcpttyList.add(I_RCPTTY);
				rcpttyMap.put(I_RCPTTY,""+I_RECVKY+"");
				rcpttyMap.put(I_RCPTTY+"_IFID",I_IFID);
				rcpttyMap.put(I_RCPTTY+"_OWNRKY",I_OWNRKY);
			} else {
				String docNums = rcpttyMap.getString(I_RCPTTY);
				if(docNums!=null && !"".contentEquals(docNums.trim())) {
					docNums += ","+I_RECVKY+"";
				} else {
					docNums += ""+I_RECVKY+"";
				}
				rcpttyMap.put(I_RCPTTY,docNums);
			}
			
			count ++;
		}
		
		if(batchHeadList.size()>0) {
			// 아이템이 삭제
			execBatchList("WmsInbound.RECDIDEL_ALL_BATCH", batchHeadList);
			// 아이템이 모두 삭제되면 헤더도 삭제
			execBatchList("WmsInbound.RECDHDEL_BATCH", batchHeadList);
		}
		
		
		// SAP 취소 RFC 전송
		for(int i=0;i<head.size();i++){
			
			headRow = head.get(i).getMap("map");
			 
			String recvky = headRow.getString("RECVKY");
			
			String sapIfid = headRow.getString("SAP_IFID").trim();
			String rfcfn   = headRow.getString("SAP_RFCFN").trim();
			String rfctbl  = "T_INDATA";
			if(!"".equals(rfcfn)) {
				
				DataMap pMap = new DataMap();
				DataMap logMap = new DataMap();
				DataMap reqMap = new DataMap();
				List<DataMap> reqList = new ArrayList<DataMap>();
				
				String logseq = getLOGSEQNO();
				
				pMap.put("I_IF_KEY", logseq);
				
				
				if(StringUtils.isNotEmpty(headRecvky) && recvky.equals(headRecvky)) {
				}else {
					
					DataMap itemListMap = new DataMap();
					headRow.putAll(itemListMap);
					headRow.setModuleCommand("WmsInbound", "GR09Sub");
					list = commonDao.getList(headRow);
				}
				
				
				for(int j=0;j<list.size();j++){
					
					itemRow = list.get(j).getMap("map");
					
					reqMap = new DataMap();
					
					if(rfcfn.equals("Z_WMS_DELIVERY_CANCEL")) {

						reqMap.put("WMSDN", itemRow.get("RECVKY"));
						reqMap.put("VBELN", itemRow.getString("SXBLNR"));
						reqMap.put("WADAT_IST", itemRow.getString("DOCDAT"));
						reqMap.put("BWART", itemRow.get("BWARTSAP"));
						
						pMap.put("I_IF_NAM", "WMS_IF_777");	
						
					}else if(rfcfn.equals("Z_WMS_MAT_DOC_CANCEL")){
						
						reqMap.put("WMSDN", itemRow.getString("RECVKY"));
						reqMap.put("MBLNR", itemRow.getString("SXBLNR"));
						reqMap.put("BUDAT", itemRow.getString("DOCDAT"));
						reqMap.put("MJAHR", itemRow.getString("DOCDAT").substring(0, 4));		
						
						pMap.put("I_IF_NAM", "WMS_IF_778");
						
					}
					
					if(j==0) {
						reqList.add(reqMap);
					}
					
				}
				
				logMap.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
				logMap.put("COMSTAT", "C"); //호출
				logMap.put("IFID", pMap.get("I_IF_NAM"));
				logMap.put("REMARK", recvky); 
				logMap.put("SEQNO",logseq);
				logMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				commonDao.insert(logMap);
				
				//RFC통신
				
				log.debug("deleteGR09.send - rfcfn : " + rfcfn);
				
				RfcCallFunction sapConn = new RfcCallFunction();
				
				log.debug("\n deleteGR09.send - reqList : " + reqList);
				
				DataMap sapRes = sapConn.rfcCancel(rfcfn, rfctbl, pMap, reqList);

				log.debug("\n deleteGR09.result - sapRes : " + sapRes);
				
				String errMsg;
				
				for(DataMap reMap : sapRes.getMapList("head")) {
					
					if(!("S".equals(reMap.getString("EV_CODE")) || "S".equals(reMap.getString("TYPE")))) {
						
						if("E".equals(reMap.getString("EV_CODE"))){
							errMsg = reMap.getString("EV_MSG");
						}else {
							errMsg = reMap.getString("MESSAGE");
						}
						
						throw new SQLException("SAP : "+errMsg);
					}
				}
				
				if(sapRes.getMapList("head").size() < 1) {
					throw new SQLException("SAP : I/F에서 받은 결과가 존재하지않습니다.");
				}
				
				//통신결과 update
				logMap.setModuleCommand("Erpif", "IFWMSLOG");
				logMap.put("IFID", pMap.get("I_IF_NAM"));
				logMap.put("COMSTAT", "S"); //호출
				commonDao.update(logMap);
				
			}
			
		}
		
		/*
		if(rcpttyList!=null && rcpttyList.size() > 0) {
			// 실적 인터페이스 저장
			dataInsertIF(map, rcpttyList, rcpttyMap, ifidList);
		}
		
		// 실적 인터페이스 전송 목록
		rsMap.put("ifidList",ifidList);
		*/
		rsMap.put("count",count);
		
		return rsMap;
		
	}
	
	
	/**************************************************************************
	 * 2022-07-04 입고취소 : 오더별 트랜잭션 나눈버전
	 *  - 입고유형별 로 인터페이스 데이터가 그룹으로 나뉘어서 SAP로 인터페이스 전송 되면 롤백 부분 롤백 불가로 
	 *    헤더 기준으로 트랜잭션 나뉘어져야함. 
	 **************************************************************************/
	
	public DataMap deleteGR09New(DataMap map) throws SQLException {
		
		DataMap rsMap = new DataMap();                         	 // return Map
		
		List<DataMap> head = map.getList("head"); 				 // 입고번호 헤더
		List<DataMap> list = new ArrayList<DataMap>(); 			 // 입고번호 아이템
		
		int count = 0;
		
		List<DataMap> ifidSapList = new ArrayList<DataMap>();    // IFID : SAP 인터페이스 전송 목록
		List<DataMap> ifidQtrList = new ArrayList<DataMap>();    // IFID : 품질검사 인터페이스 전송 목록
		List<DataMap> ifidStnList = new ArrayList<DataMap>();    // IFID : 즉시불출 인터페이스 전송 목록
		
		List<DataMap> ifidPtlList = new ArrayList<DataMap>();    // IFID : 실적(구매포탈)인터페이스 전송 목록
		List<DataMap> ifidMesList = new ArrayList<DataMap>();    // IFID : 실적(MES)인터페이스 전송 목록
		
		
		List<DataMap> ifStkkyStnList = new ArrayList<DataMap>(); // IFID : 즉시불출 재고 인터페이스 전송 목록(입고 취소시 재고 수량 없어지므로 취소전 조회 해야됨.)
		
		List<String> rcpttySapList = new ArrayList<String>();    // IF 실적 : 입고유형 SAP
		DataMap rcpttySapMap = new DataMap();                    // IF 실적 : 입고유형별 입고헤더키 SAP
		
		List<String> rcpttyPtlList = new ArrayList<String>();    // IF 실적 : 입고유형(구매포탈)
		DataMap rcpttyPtlMap = new DataMap();                    // IF 실적 : 입고유형별 입고헤더키(구매포탈)
		
		List<String> rcpttyMesList = new ArrayList<String>();    // IF 실적 : 입고유형(MES)
		DataMap rcpttyMesMap = new DataMap();                    // IF 실적 : 입고유형별 입고헤더키(MES)
		
		
		List<String> rcQtrList = new ArrayList<String>();        // IF 품질검사 : 입고유형
		DataMap rcQtrMap = new DataMap();                        // IF 품질검사 : 입고유형별 입고헤더키
		
		List<String> rcStnList = new ArrayList<String>();        // IF 즉시불출 : 입고유형
		DataMap rcStnMap = new DataMap();                        // IF 즉시불출 : 입고유형별 입고헤더키		
		
		DataMap headRow = new DataMap();
		DataMap itemRow = new DataMap();
		
		List<Map> sapIfErrList = new ArrayList();                // Batch SAP IF ERROR List
		Map sapIfErrMap = new HashMap();                         // Batch SAP IF ERROR Map
		
		List<String> recvkyList = new ArrayList();               // return RECVKY List
		
		List<DataMap> sucList = new ArrayList<DataMap>();        // 입고 취소 성공 목록
		
		int totCnt = 0;         // 입고 전체 건수
		int sucCnt = 0;         // 입고 성공 건수 
		int failCnt = 0;        // 입고 성공 건수
		
		int errMsgLen = 500;    // 에러메세지 길이
		
		String totInRsCode = "S";    					         // 입고테이블 insert 결과 코드
		StringBuffer totInRsSbMsg = new StringBuffer();          // 입고테이블 insert 결과 메세지
		
		String totRsCode = "S";    						         // 인터페이스 결과 코드
		StringBuffer totRsSbMsg = new StringBuffer(); 	         // 인터페이스 결과 메세지
		
		String tmpDocNo = "";		// 240110 취소 대상 SAP 문서번호 
		
		totCnt = head.size();
		
		for(int i=0;i<head.size();i++){
			
			TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
			TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
			
			headRow = head.get(i).getMap("map");
			
			
			// 입고 테이블 insert 결과
			String inRsCode = "S";
			String inRsMsg = "";
			
			String recvky = headRow.getString("RECVKY"); // 입고문서키
			String sebeln = headRow.getString("SEBELN"); // 오더번호
			String mrflg  = headRow.getString("MRFLG");  // 수입밀롤 구분자
			String rcptty = headRow.getString("RCPTTY"); // 입고유형
			String sapetc = headRow.getString("SAPETC"); // 재고조정 SAP 연동여부
			String sapifskip = headRow.getString("SAPIFSKIP"); // 20221012 반납입고 from to 플랜트,저장위치 동일 할 경우 sap 인터페이스 전송 안함 SAP 연동 스킵여부
			//sapetc = "";
			boolean successYN = true;            // 헤더 별 저장 및 인터페이스 전송 성공 여부
			
			recvkyList.add(recvky); 			// 오더별 입고 전체 완료 확인 위해 필요 
			
			/*********************************************************************************
			 * WMS 테이블 입고 취소 START
			 *********************************************************************************/
			try {
			
				// 헤더 단위 입고 취소 가능.
				headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				
				ifStkkyStnList = new ArrayList<DataMap>(); // IFID : 즉시불출 재고 인터페이스 전송 목록(입고 취소시 재고 수량 없어지므로 취소전 조회 해야됨.)
				if("V".equals(headRow.getString("SHTAYN").trim())) {
					// 즉시불출 재고 인터페이스 전송 목록(입고 취소시 재고 수량 없어지므로 취소전 조회 해야됨.)
					headRow.setModuleCommand("WmsInbound", "GR09_SHTAYN_STKKY");
					ifStkkyStnList = headRow.getList(headRow);
				}
				
				if("S0".equals(mrflg)) {
					// 수입밀롤 삭제
					
					log.debug("InboundService.deleteGR09New 수입밀롤 WMS 테이블 입고 취소 저장 시작 - recvky : " + recvky);
					
					// 아이템이 삭제
					headRow.setModuleCommand("WmsInbound", "GR09DELETE");
					commonDao.update(headRow);
					
					// 아이템이 모두 삭제되면 헤더도 삭제
					headRow.setModuleCommand("WmsInbound", "RECDI_ITEMCNT");
					int cnt = commonDao.getCount(headRow);
					if(cnt == 0) {
						headRow.setModuleCommand("WmsInbound", "GR09DELETEHEADER");
						commonDao.update(headRow);
					}
					
					// 밀롤 입고 예정정보 상태 전체 강제 입고 가능하게 업데이트
					headRow.setModuleCommand("WmsInbound", "GR40_CANCEL");
					commonDao.update(headRow);
					
					// ROLLMA 컨테이너 단위 초기화
					headRow.put("CONTNO", headRow.getString("SIGNI"));
					headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
					commonDao.update(headRow);
					
					// 유저 신규 추가 ROLLMA 데이터 삭제
					headRow.setModuleCommand("WmsInbound", "GR40_ROLLMA_INIT");
					commonDao.delete(headRow);
					
				} else {
				
					log.debug("InboundService.deleteGR09New 일반 WMS 테이블 입고 취소 저장 시작 - recvky : " + recvky);
					
					// 입고 아이템 취소 처리			
					headRow.setModuleCommand("WmsInbound", "GR09DELETE");
					commonDao.update(headRow);
					
					// 아이템이 모두 삭제되면 헤더도 삭제
					headRow.setModuleCommand("WmsInbound", "RECDI_ITEMCNT");
					int cnt = commonDao.getCount(headRow);
					if(cnt == 0) {
						headRow.setModuleCommand("WmsInbound", "GR09DELETEHEADER");
						headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						commonDao.update(headRow);
					}
				
				}
				
				log.debug("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 성공 - recvky : " + recvky);
			
			} catch(SQLException se) {
				log.error("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - SQLException Error : " + se.getMessage());
				String errMsg = se.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				
				inRsCode = "E";
				inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				//se.printStackTrace();
			} catch(BadSqlGrammarException bse) {
				log.error("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - BadSqlGrammarException Error : " + bse.getMessage());
				inRsCode = "E";
				//bse.printStackTrace();
				
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}
			} catch(UncategorizedSQLException bse) {
				log.error("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - UncategorizedSQLException Error : " + bse.getMessage());
				inRsCode = "E";
				//bse.printStackTrace();
				
				try {
					SQLException se = bse.getSQLException();
					String errMsg = se.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}catch(Exception e) {
					String errMsg = bse.getMessage();
					String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
					inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				}
			} catch(Exception e) {
				log.error("InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - Exception Error : " + e.getMessage());
				String errMsg = e.getMessage();
				String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
				inRsCode = "E";
				inRsMsg = "[" + recvky + "] WMS 테이블 입고 취소 저장 실패 : " + cutErrMsg;
				e.printStackTrace();
			}
			
			// 에러 처리
			if("E".equals(inRsCode)) {
				
				failCnt++;
				// 인터페이스 에러 결과 메세지
				totInRsCode = inRsCode;
				totInRsSbMsg.append("\n");
				totInRsSbMsg.append(inRsMsg.toString());
				
				transactionManager.rollback(transactionStatus);
				successYN = false;
				log.debug(i + " - InboundService.deleteGR09New WMS 테이블 입고 취소 저장 실패 - recvky : " + recvky + " - rollback");
				//continue;
				break;
			}
			/*********************************************************************************
			 * WMS 테이블 입고 취소 END
			 *********************************************************************************/
			/*
			log.debug(i + " - WMS 테이블 입고 취소 저장 성공 ");
			if(1==1) {
				sucCnt++;
				transactionManager.commit(transactionStatus);
				log.debug(i + " - 실적 SAP 인터페이스 저장");
				continue;
			}
			*/
			
			
			rcpttySapList = new ArrayList<String>();   // IF 실적 : 입고유형 SAP
			rcpttySapMap  = new DataMap();             // IF 실적 : 입고유형별 입고헤더키 SAP
			
			rcpttyPtlList = new ArrayList<String>();   // IF 실적 : 입고유형(구매포탈)
			rcpttyPtlMap  = new DataMap();             // IF 실적 : 입고유형별 입고헤더키(구매포탈)
			
			rcpttyMesList = new ArrayList<String>();   // IF 실적 : 입고유형(MES)
			rcpttyMesMap  = new DataMap();             // IF 실적 : 입고유형별 입고헤더키(MES)
			
			ifidSapList = new ArrayList<DataMap>();    // IFID : SAP 인터페이스 전송 목록
			
