										<td GH="100 STD_SKUNUM" GCol="input,SKUNUM" GF="S 6">품목번호</td>
										
										<td GH="150 STD_LOTA07" GCol="text,LOTA07">주문번호MTO</td>
										
										<td GH="100 STD_LOTA16" GCol="input,LOTA16,SHZPPTM">평량</td>
										<td GH="100 STD_LOTA03" GCol="text,LOTA03" >포장타입</td>
										<td GH="100 STD_LOTA17" GCol="text,LOTA17">컨테이너유형</td>
										<td GH="120 STD_LOTA09" GCol="text,LOTA09">판매처</td>
										 -->
										 
										<!-- 호기 -->
										<td GH="150 STD_LOTA04" GCol="select,LOTA04">
											<select Combo="WmsInbound,UNITNOOMBO" >
											  <option value=""></option>
											</select>
										</td>
										
										<!-- 국가코드 -->
										<td GH="120 STD_LOTA08" GCol="select,LOTA08">
											<select CommonCombo="NATNKY">
											  <option value=""></option>
											</select>
										</td>
										
										
										<!-- <td GH="100 STD_LOTA10" GCol="input,LOTA10">보류사유명</td> -->
										
										<td GH="100 STD_LOTA11" GCol="input,LOTA11" GF="C 8" validate="required">제조일자</td>
										<td GH="100 STD_LOTA12" GCol="input,LOTA12" GF="C N">입고일자</td>
										<!-- <td GH="100 STD_LOTA13" GCol="input,LOTA13" GF="C 8">유통기한</td> -->
										<td GH="150 STD_LOTA14" GCol="input,LOTA14" >제조LOT</td>
										<td GH="150 STD_LOTA15" GCol="input,LOTA15" validate="required">SAP배치번호</td>
										<!-- 
										<td GH="150 STD_LOTA21" GCol="input,LOTA21">지관</td>
										<td GH="150 STD_LOTA22" GCol="input,LOTA22">특별재고번호</td>
										<td GH="150 STD_LOTA23" GCol="input,LOTA23">생산자ID</td>
										<td GH="150 STD_LOTA24" GCol="input,LOTA24">생산자명</td>
										 -->
										<!-- 사유코드 -->
										<td GH="100 STD_RSNCOD" GCol="select,RSNCOD">
											<select Combo="WmsInbound,RSNCD_SET" >
												<option value=" "></option>
											</select>
										</td>
										<td GH="200 STD_RSNTXT" GCol="input,RCPRSN">상세사유</td>
										
										<td GH="100 STD_AREAKY" GCol="text,AREAKY">창고</td>
										<!-- <td GH="100 STD_ZONEKY" GCol="text,ZONEKY">구역</td> -->
										<td GH="100 STD_LOCAKY" GCol="text,LOCAKY">로케이션</td>
										
										<td GH="80 STD_SUOMQTY" GCol="text,UOMQTY" GF="N 20,3">기본단위수량</td>
										<td GH="100 STD_MEINS" GCol="text,MUOMKEY">기본단위</td>
