										<td GH="130 STD_LOTA02" GCol="select,LOTA02" validate="required">
										  <select Combo="Wms,PLNTKYCOMBO" >
										  	<option value=" "></option>
										  </select>
										</td>
										<td GH="80 STD_LOTA01" GCol="input,LOTA01,SHSTLMAP" validate="required">저장위치</td>
										<td GH="80 STD_WARCHN" GCol="text,EXIST_OTHER_LOTA01_YN">다른저장위치 존재유무</td>
										<!-- <td GH="100 STD_STLNM" GCol="text,LOTA01NM">저장위치명</td> -->
