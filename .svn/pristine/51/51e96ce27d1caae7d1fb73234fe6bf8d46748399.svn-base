							<input type="checkbox" class="input" id="STAT00" name="STAT00" value="V" onclick="searchCheckBoxAll(this)"/>
							<label CL="STD_ALL" for="STAT00">전체</label>
							<input type="checkbox" class="input" id="STTNEW" name="STTNEW" value="V" checked="checked"/>
							<label CL="STD_NEW" for="STTNEW">미작업</label>
							<input type="checkbox" class="input" id="STTTC2" name="STTTC2" value="V"/>
							<label CL="STD_EXRECP" for="STTTC2">입고완료</label>
						</dd>
					</dl>
					
					<dl>
                        <dt CL="STD_STKNUM">선적번호</dt>
                        <dd>
                            <input type="text" class="input" name="PO.STKNUM" UIInput="SR"/>
                        </dd>
                    </dl>
					
				</div>
				<div class="btn_tab">
					<input type="button" class="btn_more" value="more" onclick="searchMore()"/>
				</div>
			</div>
		</div>
		
