<script type="text/javascript">
	
	var dblIdx = -1;
	var subIdx = 0;
	var headSebeln = "";
	var selTab = 1;
	var initNum = 0;
	var gridSub = new DataMap();
	
	$(document).ready(function(){
		
		gridList.setGrid({
			id : "gridList",
