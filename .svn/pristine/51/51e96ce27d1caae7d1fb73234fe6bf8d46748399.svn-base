							<select CommonCombo="SKUL01" class="input" name="SKUL01" id="SKUL01" style="width: 177px;">
							  <option value=""></option>
							</select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_STATDO">문서상태</dt>
