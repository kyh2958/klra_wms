							</select> -->
							<input type="text" class="input" name="OWNRKY" value="<%=ownrky %>" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA02">플랜트</dt>
						<dd>
							<select type="text" class="input" Combo="Wms,PLNTKYCOMBO" name="PO.LOTA02" id="PLNTKY" ComboType="MS" validate="required">
							</select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA01">저장위치</dt>
						<dd>
							<input type="text" class="input" name="PO.LOTA01" UIInput="R,SHSTLMAP" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_ORDDAT">오더일자</dt>
						<dd>
							<input type="text" class="input" name="PO.BEDAT" UIInput="R" UIFormat="C 0" validate="required" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_RCPTTY">입고유형</dt>
						<dd>
							<select type="text" class="input" Combo="WmsOrder,RCPTTYCOMBO" name="PO.BWART" id="RCPTTY" ComboType="MS" validate="required"> </select>
							<!--<select name="BWART" class="input" Combo="WmsOrder,RCPTTYCOMBO"  validate="required">
								<option value="">Please Select</option>
							</select> -->
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_MATNR">품목코드</dt>
						<dd>
							<input type="text" class="input" name="PO.SKUKEY" UIInput="R,SHSKUMA" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_PRODLOT">개별바코드</dt>
						<dd>
							<input type="text" class="input" id="testArea" name="PO.LOTA14" UIInput="R" UIFormat="U"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_EBELN">오더번호</dt>
						<dd>
							<input type="text" class="input" name="PO.EBELN" UIInput="R" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_RCVDAT">입고예정일자</dt>
						<dd>
							<input type="text" class="input" name="PO.EINDT" UIInput="R" UIFormat="C"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_DPTNKY1">공급사</dt>
						<dd>
							<input type="text" class="input" name="PO.LIFNR" UIInput="R,SHBZPTN" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_DPTNNM">공급사명</dt>
						<dd>
							<input type="text" class="input" name="BZ.NAME01" UIInput="R" />
						</dd>
					</dl>
					
					<!-- 
					<dl>
						<dt CL="STD_MATNR">품번</dt>
						<dd>
							<input type="text" class="input" name="PO.SKUKEY" UIInput="R,SHSKUMA"/>
						</dd>
					</dl>
					 -->
					<dl>
						<dt CL="STD_DESC01">품명</dt>
