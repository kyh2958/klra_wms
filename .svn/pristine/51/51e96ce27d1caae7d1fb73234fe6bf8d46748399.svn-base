	  var $selRCPTTY = $('select[id="RCPTTY"]');
	  $selRCPTTY.multipleSelect('checkAll');
      
    }

	function commonBtnClick(btnName){
		
		if(btnName == "Search"){
			searchList();
		}else if(btnName == "Save"){
			saveData();
		}else if(btnName == "Pallet"){
            fnAutoPalletzing();
        }else if(btnName == "Reflect"){
			setSTLKY();
		}else if(btnName == "Ptldle"){
			setDeadLine();
		}else if(btnName == "Ptldlecel"){
			setDeadLineCancel();
		}else if(btnName == "Print"){
			printList();
		}
		
	}
	
	//중복제거 프로시저 호출
	function deleteDupOrder(){
    	
	    netUtil.sendData({
			module : "WmsInbound",
			command : "CALL_IFWMS204_SEQNO",
			sendType : "map"
		});
    	
    }
	
	function searchList(){
		
		if(validate.check("searchArea")){

			//중복제거 프로시저 호출
			//deleteDupOrder();
			
			var param = inputList.setRangeParam("searchArea");
			param.put("PROGID", configData.MENU_ID);
			
			gridList.resetGrid("gridList");
			gridList.resetGrid("gridListSub");
			
			$('#tabSub1').click();
			
			// 2022.09.29 이송입고 개별바코드 같은경우 출고데이터 추적해서 가져오므로 이송입고때문에 자동으로 검색조건 만들어주는 걸로는 검색이 안됨. 
			var vParam = param.map;
			//console.log("vParam : " + JSON.stringify(vParam));
			var rageDataMap = new DataMap();
			if(param.map.RANGE_DATA_PARAM){
				rageDataMap = param.map.RANGE_DATA_PARAM;
				if(rageDataMap){
					if(rageDataMap.containsKey("PO.LOTA14_Single")){
						var lota14 = rageDataMap.get("PO.LOTA14_Single");						
						var lota14Sql = mkWhereSql(lota14, "TI.LOTA14");
						var lota14TrSql = mkWhereSql(lota14, " DECODE(TI_T.EBELN, NULL, PO.LOTA14, TI_T.LOTA14 ) ");
						rageDataMap.remove("PO.LOTA14_Single");
						param.put("LOTA14_SQL", lota14Sql);
						param.put("LOTA14_TR_SQL", lota14TrSql);
					}
				}
			}
			
			gridList.gridList({
		    	id : "gridList",
		    	param : param
		    });
		}
	}
	
	function mkWhereSql(str, field){
		var result = "";
		if(str!=undefined && str!=""){
			var arr = str.split("↑");
			
			for(var i=0; i<arr.length; i++){
				var rStr = arr[i];
				var rArr = rStr.split("↓")
				
				if(rArr.length==3){
					var oper = rArr[0];
					var searVal = rArr[1];
					var logi = rArr[2];
					
					if(result!=""){
						
						if(logi=="OR"){
							result = result + " " + "OR";
						}else if(logi=="AND"){
							result = result + " " + "AND";
						}
						
					}
					
					result = result + " " + field; 
					
					if(oper=="E"){
						result = result + " " + "=";
					}else if(oper=="N"){
						result = result + " " + "!=";
					}else if(oper=="LT"){
						result = result + " " + "<";
					}else if(oper=="GT"){
						result = result + " " + ">";
					}else if(oper=="LE"){
						result = result + " " + "<=";
					}else if(oper=="GE"){
						result = result + " " + ">=";
					}
					
					result = result + " '" + searVal + "' ";
					
				}
			}
		}
		
		if(result!=""){
			result = "AND ( " + result + " ) ";
		}
		
		return result;
	}
 	
 	function getItemSearchParam(rowNum){
 		var rowData = gridList.getRowData("gridList", rowNum);
        var param = inputList.setRangeParam("searchArea");
        param.put("PROGID", configData.MENU_ID);
        param.putAll(rowData);
        
        return param;
 	}
 	
	function gridListEventItemGridSearch(gridId, rowNum, itemGridList){
		
		if(gridId == "gridList"){
	        var param = getItemSearchParam(rowNum);
	        
	     	// 2022.09.29 이송입고 개별바코드 같은경우 출고데이터 추적해서 가져오므로 이송입고때문에 자동으로 검색조건 만들어주는 걸로는 검색이 안됨.
	        var vParam = param.map;
			//console.log("vParam : " + JSON.stringify(vParam));
			var rageDataMap = new DataMap();
			if(param.map.RANGE_DATA_PARAM){
				rageDataMap = param.map.RANGE_DATA_PARAM;
				if(rageDataMap){
					if(rageDataMap.containsKey("PO.LOTA14_Single")){
						var lota14 = rageDataMap.get("PO.LOTA14_Single");						
						var lota14Sql = mkWhereSql(lota14, "PO.LOTA14");
						var lota14TrSql = mkWhereSql(lota14, " DECODE(TI_T.EBELN, NULL, PO.LOTA14, TI_T.LOTA14 ) ");
						rageDataMap.remove("PO.LOTA14_Single");
						param.put("LOTA14_SQL", lota14Sql);
						param.put("LOTA14_TR_SQL", lota14TrSql);
					}
				}
			}
	        
	        gridList.gridList({
	           id : "gridListSub",
	           param : param,
	        });
			
	        dblIdx = rowNum;
			subIdx = rowNum;
		}
	}
 	
	function gridListEventDataBindEnd(gridId, dataLength){
		
		if(gridId == "gridList"){
			
			//Validation check 를 위한 cheating.. ysy
			gridList.checkAll('gridList', true);
			gridList.checkAll('gridList', false);
			
			var list = gridList.getGridData("gridList");
			for(var i=0; i < list.length; i++) {
				var rowData = list[i];
            	var rowNum = rowData.get("GRowNum");
				var STATDO = list[i].get("STATDO"); // 문서상태
				var DLEFLG = list[i].get("DLEFLG"); // 마감여부
				
				if(DLEFLG=="Y"){
					gridList.setRowReadOnly(gridId, rowNum, true, ['DOCDAT','DOCTXT']);
				}else if(STATDO!="NEW"){
					//gridList.setRowReadOnly(gridId, rowNum, true, ['rowCheck','DOCDAT','DOCTXT']);
					gridList.setRowReadOnly(gridId, rowNum, true, ['DOCDAT','DOCTXT']);
				}
			}
			
			selTab = 1;
            $('#tab2-1').show();
            $('#tab2-2').hide();
            $('#tabSub1').click();
            gridList.setReadOnly("gridList", false, ['rowCheck']);
            gridList.resetGrid("gridConfirmList");
			
		}else if(gridId == "gridListSub"){
			
			var list = gridList.getGridData("gridListSub");
			
			var headRowNum =  gridList.getFocusRowNum("gridList");
			var headRowCheck = gridList.getSelectType("gridList", headRowNum);
			
			for(var i=0; i < list.length; i++) {
				
				var rowData = list[i];
            	var rowNum = rowData.get("GRowNum");
				
				var QTYRCV1 = list[i].get("QTYRCV1");
				var IFFLG = list[i].get("IFFLG");
				var DLEFLG = list[i].get("DLEFLG");
			
				if( QTYRCV1<=0 || IFFLG=="Y" || DLEFLG=="Y"){
					gridList.setRowReadOnly(gridId, rowNum, true, ['rowCheck','QTYRCV','LOTA01','LOTA11','LOTA14','LOTA15', 'SKUG05_1','PALQTY']);
				}
				var BWART = list[i].get("BWART");
				var FWMSMAK = list[i].get("FWMSMAK"); // 이송입고 wms재고관리 대상 여부
				var TEBELN = list[i].get("TEBELN");  // 출고지시서 여부 판단 오더번호
				
				//var SUM_ITEM = list[i].get("SUM_ITEM").split('//');
				//console.log(SUM_ITEM);
				//gridList.setColValue(gridId, rowNum, "SUM_ITEM", SUM_ITEM[0]);
				
				if(BWART=="121" && FWMSMAK=="V"&&TEBELN!=""&&TEBELN!=" "){
					gridList.setRowReadOnly(gridId, rowNum, true, ['QTYRCV','LOTA14','LOTA15', 'SKUG05_1','PALQTY']);
				}
				
				//console.log(i + " a - IFFLG : " + IFFLG + " - DLEFLG : " + DLEFLG);
				if(IFFLG=="Y" || DLEFLG=="Y"){
					gridList.setRowCheck(gridId, rowNum, false);
					if(headRowCheck){
						gridList.setRowCheck("gridList", headRowNum, true);
					}
				}
			}
			
			selTab = 1;
            $('#tab2-1').show();
            $('#tab2-2').hide();
            $('#tabSub1').click();
			gridList.resetGrid("gridConfirmList");
		}
		
	}
	
	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
		
		if (gridId == "gridList") {
			
			if (colName == "DOCDAT") {
				var rowData = gridList.getRowData(gridId, rowNum);
				var asndat = rowData.get("ASNDAT");
				var docdat = rowData.get("DOCDAT");
				var asndate = asndat-1;
				var now = new Date();
				now.setDate(now.getDate());
				var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
				var todayValue = tmpValue.replace(".","").replace(".","");
				
				if(docdat < asndate){
					//commonUtil.msgBox("IN_M0139"); // 과거일자로 입고하실 수 없습니다."
					//gridList.setColValue(gridId, rowNum, "DOCDAT", tmpValue);
				}else if(docdat>todayValue){
// 					commonUtil.msgBox("VALID_M2133"); // 미래일자로 입력하실 수 없습니다.
// 					gridList.setColValue(gridId, rowNum, "DOCDAT", tmpValue);
				}
			}
			
		}else if (gridId == "gridListSub"){
			
			if (colName == "QTYRCV") {
				setUOMInfo(gridId, rowNum);
			}else if(colName == "SKUG05_1") {
            	setSKUG04(gridId, rowNum, colName, colValue);				
			}else if (colName == "LOTA01") {
				setStlkyInfo(gridId, rowNum);
			}else if (colName == "LOTA11") {
				var lota11 = gridList.getColData(gridId, rowNum, "LOTA11");
				var now = new Date();
				var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
				var todayValue = tmpValue.replace(".","").replace(".","");
				if(lota11>todayValue){
					commonUtil.msgBox("VALID_M2133"); // 미래일자로 입력하실 수 없습니다.
					gridList.setColValue(gridId, rowNum, colName, "");
				}
			}else if (colName == "LOTA12") {
				var lota12 = gridList.getColData(gridId, rowNum, "LOTA12");
				var now = new Date();
				var tmpValue = uiList.dateFormat(now, configData.COMMON_DATE_TYPE);
				var todayValue = tmpValue.replace(".","").replace(".","");
				if(lota12>todayValue){
					commonUtil.msgBox("VALID_M2133"); // 미래일자로 입력하실 수 없습니다.
					gridList.setColValue(gridId, rowNum, colName, "");
				}
			}
			
		}else if (gridId == "gridConfirmList"){
        	
			if(colName == "SKUG05_1") {
        		setSKUG04(gridId, rowNum, colName, colValue);
        	}else if (colName == "LOTA01") {
				setStlkyInfo(gridId, rowNum);
			}else if (colName == "QTYRCV") {
				setUOMInfo(gridId, rowNum);
			}
        }
	}
	
	function gridListEventRowClick(gridId, rowNum, colName){
		if(gridId == "gridList"){
			if(dblIdx!=rowNum){
				
				var chkItemIdx = gridList.getSelectRowNumList("gridListSub");
				var itemGrdViewYn = gridList.getItemGridViewCheck("gridList");
	            
	            if(chkItemIdx==0 && itemGrdViewYn==false ){
	            	dblIdx=-1;
	                $('#tabSub1').click();
	                gridList.resetGrid("gridConfirmList");
	                if(colName=="FILEPOP01"||colName=="FILEPOP02"){
	                	popGrFile(gridId, rowNum, colName);
					}
	            }
    		} else{
    			if(colName=="FILEPOP01"||colName=="FILEPOP02"){
                	popGrFile(gridId, rowNum, colName);
				}
    		}
		}
	}
	
	function gridListEventRowDblclick(gridId, rowNum, colName, colValue){
		if(gridId == "gridList"){
			
			dblIdx=rowNum;
			selTab = 1;
            $('#tabSub1').click();
            gridList.resetGrid("gridConfirmList");
			
		}
	}
	
	function gridExcelDownloadEventBefore(gridId){
		var param = new DataMap();
		if(gridId == "gridList"){
			param = inputList.setRangeParam("searchArea");
			param.put("dataGridExcel", "입고작업_리스트");
		}else if(gridId == "gridListSub"){
			 
			var rowNum = gridList.getSearchRowNum("gridList");
			if(rowNum == -1){
				 return false;
			}else{
				 param = getItemSearchParam(rowNum);
			}
			param.put("dataGridExcel", "입고작업_상세_리스트");
		}else if(gridId == "gridConfirmList"){
			param.put("dataGridExcel", "입고작업_개별바코드_리스트");
		}
		
		return param;
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType, obj, rowNum){
		var param = new DataMap();
		
		if(searchCode == "SHBZPTN"){
            param.put("LANGKY", "<%=langky%>");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("WAREKY", "<%=wareky%>");
            param.put("PTNRTY", "VD");
            return param;
        }else if(searchCode == "SHSTLMAP"){
        	var PLNTKY = $('select[id="PLNTKY"]').val();
        	param.put("LANGKY", "<%=langky%>");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("WAREKY", "<%=wareky%>");
            param.put("PLNTKY", PLNTKY);
            if(PLNTKY==null || $.trim(PLNTKY)==""){
            	return false;
            }
            return param;
		}else if(searchCode == "SHSTLMAP2"){
			param.put("LANGKY", "<%=langky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("WAREKY", "<%=wareky%>");
			var gridId = "gridListSub";
			if(selTab!=1){
				gridId = "gridConfirmList";
			}
			var lota02 = gridList.getColData(gridId, rowNum, "LOTA02");
			param.put("PLNTKY", lota02);
			
			return param;
		}
	}
	
	function comboEventDataBindeBefore(comboAtt){
		
		if(comboAtt == "WmsOrder,RCPTTYCOMBO"){
			var param = new DataMap();
			param.put("DOCCAT", "100");
			param.put("PROGID", configData.MENU_ID);
			return param;
		}else if(comboAtt == "Wms,PLNTKYCOMBO"){
			var param = new DataMap();
			var WAREKYS = "'<%= wareky%>'";
			param.put("WAREKYS", WAREKYS);
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
			return param;
		} else if(comboAtt == "WmsInbound,UNITNOOMBO"){
			var param = new DataMap();
			param.put("WAREKY", "<%= wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
			return param;
		}
		
	}
	
	function popGrFile(gridId, rowNum, colName){
		var rowData = gridList.getRowData(gridId, rowNum);
		page.linkPopOpen("/wms/inbound/GRFILEPOP.page", rowData);
	}
	
	//모두 선택했을 때 DETAIL을 일괄 검색 후 데이터셋 만들어주기 ysy
	function gridListEventRowCheckAll(gridId, checkType) {

		//그리드 Check 를 해주면 gridListEventRowCheck 을 타도록 함.
		if (gridId == "gridList" && checkType == true) {
			gridSub.clear();
			
			//선택한 Header List
			var listArr = new Array();
		 	var headList = gridList.getSelectData("gridList");
            for(var i=0; i<headList.length; i++){
            	var rowData = headList[i];
            	var sebeln = rowData.get("SEBELN");  // 오더번호
            	listArr.push(sebeln);
            }
			
            var res = "'"+listArr.join("','")+"'"
            //Check 한 HeadList로 품목 조회
			var param = new DataMap();
            param.put("SEBELN", res);
    		param.put("OWNRKY", "<%=ownrky%>");
    		param.put("WAREKY", "<%=wareky%>");
    		param.put("PROGID", "GR02")
			
    		//setTimeout(function(){
				gridList.gridList({
			    	id : "gridListHidden",
					module : "WmsInbound",
					command : "GR02VAL",
					sendType : "list",
			    	param : param
			    });
    		//}, 50);
			
			var itemList = gridList.getGridData("gridListHidden");
			var dataArray = new Array();
			
			for(var i=0; i<headList.length; i++){
				for(var j=0; j<itemList.length; j++) {
		
					if(headList[i].get("EBELN") == itemList[j].get("EBELN")) {
						//DataMap Array를 만들어야함..
						dataArray.push(itemList[j]);
					} 
					gridSub.put(headList[i].get("GRowNum"), dataArray);
				}
				dataArray = []; // Data Array 비우기
			}
			
			//console.log(gridSub);

		} else if (gridId == "gridList" && checkType == false) {
			for(var i = 0; i < gridList.getGridData(gridId).length; i++){
				gridList.setRowCheck(gridId, i, false);
				
			}
			//만들어진 DataSet 도 비워줘야함.
		}
	}
	
	//개별 선택했을 때
	function gridListEventRowCheck(gridId, rowNum, checkType) {
		
		if (gridId == "gridList" && checkType == true) {
			gridListEventRowClick(gridId, rowNum);

			var subDataMap = gridList.getSelectData("gridListSub");
			gridSub.put(rowNum, subDataMap);
			
		} else if (gridId == "gridList" && checkType == false) {
			gridSub.remove(rowNum);
		} else if (gridId == "gridListSub") {
			//Detail Check Logic..
			var subDataMap = gridList.getSelectData("gridListSub");
			gridSub.put(rowNum, subDataMap);
		}
		//console.log(gridSub);
	}
	
	function checkValidation() {
        var chkItemList = gridSub.map;
		var subGridId = "gridListSub";
		
        if(selTab==2){
            subGridId = "gridConfirmList";
        }
		
		for (key in chkItemList) {
			if (chkItemList[key].length != 0) {
				var menge, menge_r, qtyrcv1, qtyrcv, sumrcv, diffrcv = 0; // (오더수량, 기입고수량, 입고가능수량, 입고수량, 입고수량sum)
				var nSeqno = ""; // (변경후 seqno, 오더번호, 오더아이템번호)
				var bwart = "";	// 해당 헤더의 입고유형 정보용도
				
				for (var i=0; i<chkItemList[key].length; i++ ) {
					var itemMap = chkItemList[key][i].map;
					var tSeqno = itemMap.SEQNO;
					var rowNum = itemMap.GRowNum;
			 		var sebeln = itemMap.SEBELN;
			 		var sebelp = itemMap.SEBELP;
	            	var lota14 = itemMap.LOTA14;  	 // 개별바코드
					var shtayn = itemMap.SHTAYN; 	 // 즉시불출 여부
					var wmsmak = itemMap.WMSMAK; 	 // WMS재고관리대상 여부
					var lota01 = itemMap.LOTA01; 	 // 저장위치
					var skug05_1 = itemMap.SKUG05_1; // 사업부
					bwart = itemMap.BWART;		// 입고유형
					
					//var imib02Lota01 = itemMap.IMIB02_LOTA01;
			 		
			 		if (i == 0 || nSeqno != tSeqno) {
			 			console.log(i);
			 			console.log(nSeqno);
			 			console.log(tSeqno);
			 			nSeqno = tSeqno;
			 			menge  = 0;
			 			sumrcv = 0;
			 			diffrcv = 0;
	            	}
	            	
	            	if (tSeqno == nSeqno) {
	                	menge   = parseFloat(itemMap.MENGE);   //오더수량
		            	menge_r = parseFloat(itemMap.MENGE_R); //기입고수량
		                qtyrcv  = parseFloat(itemMap.QTYRCV);  //입고수량
		                qtyrcv1 = parseFloat(itemMap.QTYRCV1); //입고가능수량
		                sumrcv += parseFloat(itemMap.QTYRCV);
	                } 
	            	
	            	nSeqno = tSeqno;
	            	console.log("seqno : " + tSeqno +"///"+nSeqno+" - qtyrcv1 : " + qtyrcv1 + " - qtyrcv : " + qtyrcv + " - menge : " + menge + " - menge_r : " + menge_r + " - sumrcv : " + sumrcv);
	                
	            	if( (lota14==""||lota14==" ") && (skug05_1==""||skug05_1==" ") ){
						commonUtil.msgBox("VALID_M2060");		//개별바코드가 없을 경우에는 사업부가 필수 입니다.
						gridList.setColFocus(subGridId, rowNum, "SKUG05_1");
						return false;
					}
					
					if(lota14==""||lota14==" "){
						gridList.setColFocus(subGridId, rowNum, "LOTA14");
		            	//commonUtil.msgBox("VALID_M2063");// 개별바코드가 없는 문서가 존재하여 입고를 할 수 없습니다.
		            	commonUtil.msgBox("VALID_M2118",[sebeln]);// [{0}] 개별바코드가 없는 문서가 존재하여 입고를 할 수 없습니다.
		                return false;
		            }
					
		            if(shtayn=="V" && wmsmak=="V"){
		            	gridList.setColFocus(subGridId, rowNum, "rowCheck");
		            	commonUtil.msgBox("VALID_M2105",[sebeln]);// [{0}] 즉시불출이며, WMS재고대상 인 문서가 존재하여 입고를 할 수 없습니다.
		                return false;
		            }
		            
					if(shtayn!="V" && wmsmak!="V"){
		            	var imib02Lota01 = itemMap.IMIB02_LOTA01; //rowData.get("IMIB02_LOTA01");
		            	gridList.setColFocus(subGridId, rowNum, "rowCheck");
		            	var imib02 = itemMap.IMIB02; //rowData.get("IMIB02");
		            	imib02msg = commonUtil.getMsg("VALID_M2106",[sebeln,lota01]); // [{0}] 저장위치[{1}] 즉시불출이 아니고, WMS재고대상 아닌 문서가 존재합니다. 진행하시겠습니까?
		            }
				}
				
				console.log("BWART 확인 = " + bwart);
				
            	//20221031 JS 무한 소수점 오류 수정
               	sumrcv = Number(sumrcv.toFixed(3));
            	
               	if(sumrcv > menge) {
                    gridList.setColFocus(subGridId, rowNum, "QTYRCV");
                    commonUtil.msgBox("VALID_M2131",[sebeln,sebelp,(menge),sumrcv]);   // [{0}][{1}]오더의 입고가능한 수량[{2}]을 넘겼습니다. 수량[{3}]을 확인해주세요.
                    return false;
                }
               	
               	// 20221012 오더순번 별 전량 입고 해야됨.
               	if(sumrcv != menge) {
               		diffrcv = Number(Math.abs(sumrcv - menge).toFixed(3));
               		
               		if(bwart == "121" && diffrcv == 0.001){
               			console.log("수량 체크 = " + sumrcv + "   /  " + menge);
               			if(!commonUtil.msgConfirm("(이송입고)출고수량이 오더수량보다 0.001 작습니다. 진행하시겠습니까??")){
        	                return false; 
        	            }else{
        	            	return true;
        	            }
               		}else{
	                    gridList.setColFocus(subGridId, rowNum, "QTYRCV");
	                    commonUtil.msgBox("VALID_M2147",[sebeln,sebelp,(menge),sumrcv]);   // 이송입고 [{0}][{1}]오더는 오더 수량[{2}](을)를 전량 입고 하여야 합니다. 수량[{3}]을 확인해주세요.
	                    return false;               			
               		}
                }
			} // chkItemList[key].length
		} // for key in chkItemList
		
		return true;
	}
	
	function saveData(){
		
		/*
		 TAB에 따른 품목 Grid ID Set 
		 gridListSub : 상세리스트
		 gridConfirmList : 개별바코드
		*/
        var subGridId = (selTab==2 ? "gridConfirmList" : "gridListSub");
		
		if (subGridId == "gridListSub") {
	        if (!checkValidation()){
				return;
			};
		}
		
		if(gridList.validationCheck(subGridId, "select")){

            var headChkLen = gridList.getSelectRowNumList("gridList").length; //헤더 선택 개수
			var chkItemIdx = gridList.getSelectRowNumList(subGridId); //품목 선택 Idx
            var chkItemLen = chkItemIdx.length; 
            
            var totBwart = 0;
            var selBwart = 0;
            
            var imib02 = "";     // 즉시불출이아니며 WMS재고비관리대상 여부
            var imib02msg = "";  // 즉시불출이아니며 WMS재고비관리대상 여부 메세지
            
            if(chkItemLen == 0 && headChkLen == 0){
            	commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
                return;
            }
            
            var headIdxChk = false;
            var chkHeadList = gridList.getSelectData("gridList");
            for(var i=0;i<chkHeadList.length;i++){
            	var rowData = chkHeadList[i];
            	var rowNum = rowData.get("GRowNum");
            	var sebeln = rowData.get("SEBELN"); // 오더번호
            	var rcptty = rowData.get("RCPTTY"); // 입고유형
            	
            	 var statdo = rowData.get("STATDO"); // 문서상태 DLTKR
            	if(statdo!="NEW"){
            		//gridList.setColFocus("gridList", rowNum, "rowCheck");
            		commonUtil.msgBox("VALID_M2119",[sebeln]);// [{0}] 입고 완료된 문서는 입고 할 수 없습니다.
            		return;
            	} 
            	
            	var dleflg = rowData.get("DLEFLG"); // 구매포탈 마감여부
            	if(dleflg=="Y"){
            		//gridList.setColFocus("gridList", rowNum, "rowCheck");
            		commonUtil.msgBox("VALID_M2120",[sebeln]);// [{0}] 마감된 문서는 입고 할 수 없습니다.
            		return;
            	}
            	
            	var qyrcv1 = rowData.get("QTYRCV1"); // 입고가능수량
            	if(Number(qyrcv1)==0){
            		//gridList.setColFocus("gridList", rowNum, "rowCheck");
            		commonUtil.msgBox("VALID_M2109",[sebeln]); // [{0}]입고 가능한 수량이 없습니다.
            		return;
            	}
            	
	            if(rowNum==dblIdx){
	            	headIdxChk=true;
	            }
	            
	            if(dblIdx!=rowNum){
	            	
		            var lota14EmptyYn = rowData.get("LOTA14_EMPTY_YN");
		            if(lota14EmptyYn!="N" && rcptty!= "121"){
		            	//gridList.setColFocus("gridList", rowNum, "rowCheck");
		            	//commonUtil.msgBox("VALID_M2063");// 개별바코드가 없는 문서가 존재하여 입고를 할 수 없습니다.
		            	commonUtil.msgBox("VALID_M2118",[sebeln]);// [{0}] 개별바코드가 없는 문서가 존재하여 입고를 할 수 없습니다.
		                return;
		            }
		            var imib01 = rowData.get("IMIB01"); // 즉시불출이며 WMS재고관리대상 여부
		            if(imib01=="V"){
		            	//gridList.setColFocus("gridList", rowNum, "rowCheck");
		            	commonUtil.msgBox("VALID_M2105",[sebeln]);// [{0}] 즉시불출이며, WMS재고대상 인 문서가 존재하여 입고를 할 수 없습니다.
		                return;
		            }
		            
		            if(imib02=="" && rowData.get("IMIB02") == "V"){
		            	var imib02Lota01 = rowData.get("IMIB02_LOTA01");
		            	imib02 = rowData.get("IMIB02");
		            	imib02msg = commonUtil.getMsg("VALID_M2106",[sebeln,imib02Lota01]); // [{0}] 저장위치[{1}] 즉시불출이 아니고, WMS재고대상 아닌 문서가 존재합니다. 진행하시겠습니까?
		            }
	            }
            }
            
            if( chkItemLen > 0 ){
	            if(headIdxChk==false){
	            	//gridList.setColFocus("gridList", rowNum, "rowCheck");
	            	commonUtil.msgBox("VALID_M2061");// 현재 진행중인 데이터의 헤더 체크박스를 선택하여주세요.
	                return;
	            }
            }else if( chkItemLen <= 0 && headIdxChk==true ){
            	commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
                return;
            }
            
            
            var chkItemList = gridList.getSelectData(subGridId); 
            
            for(var i=0;i<chkItemList.length;i++){
            	var rowData = chkItemList[i];
            	var rowNum  = rowData.get("GRowNum");
            	var sebeln  = rowData.get("SEBELN");  // 오더번호
            	var sebelp  = rowData.get("SEBELP");  // 오더아이템번호
            	var bwart   = rowData.get("BWART");    // 입고유형
            	var tebeln  = rowData.get("TEBELN");  // 이송오더번호
            	var seqno   = rowData.get("SEQNO");    // 오더시퀀스
            	
            	var lota14  = rowData.get("LOTA14");  // 개별바코드
            	
                var qtyrcv1 = new Number(rowData.get("QTYRCV1")); //입고가능수량
                var qtyrcv = new Number(rowData.get("QTYRCV")); //입고수량
                var menge = new Number(rowData.get("MENGE")); //오더수량
                var menge_r = new Number(rowData.get("MENGE_R")); //기입고수량
                //console.log("seqno : " + seqno + " - qtyrcv1 : " + qtyrcv1 + " - qtyrcv : " + qtyrcv + " - menge : " + menge + " - menge_r : " + menge_r);
                
                /*
                // 20221011 일시적으로 입고 가능수량 validation 제거요청으로 주석 KJH
                if((qtyrcv1 - qtyrcv) < 0){
                    gridList.setColFocus(subGridId, rowNum, "QTYRCV");
                    commonUtil.msgBox("IN_M0078");      //입고수량은 입고가능수량보다 클 수 없습니다.
                    return;
                }
                */
                ////////////////////////
                
                if (subGridId == "gridConfirmList") {
	                if(bwart=="121" /*&& $.trim(tebeln)!=""*/){
	                	
	                	var tQtyRcvSum = 0;
	                	var tLota14DuplYn = false;
	                	for(var j=0;j<chkItemList.length;j++){
	                    	var tRowData = chkItemList[j];
	                    	var tRowNum = tRowData.get("GRowNum");
	                    	var tSeqno = tRowData.get("SEQNO");    // 오더시퀀스키
	                    	var tLota14 = tRowData.get("LOTA14");  // 개별바코드
	                    	var tQtyrcv = new Number(tRowData.get("QTYRCV")); // 입고수량
	                    	if(seqno==tSeqno){
	                    		tQtyRcvSum = tQtyRcvSum + tQtyrcv;
	                    	}
	                    	
	                    	// 개별바코드 중복여부 확인
	                    	if(rowNum!=tRowNum && lota14==tLota14){
	                    		tLota14DuplYn = true;
	                    	}
	                    	
	                	}
	                	//20221031 JS 무한 소수점 오류 수정
	                	tQtyRcvSum = Number(tQtyRcvSum.toFixed(3));
	                	
	                	// 20221011 일시적으로 입고 가능수량 validation 제거요청으로 주석 KJH -> 20221012 KJH제거
	                	if(tQtyRcvSum > menge){
		                    gridList.setColFocus(subGridId, rowNum, "QTYRCV");
		                    commonUtil.msgBox("VALID_M2131",[sebeln,sebelp,(menge),tQtyRcvSum]);   // [{0}][{1}]오더의 입고가능한 수량[{2}]을 넘겼습니다. 수량[{3}]을 확인해주세요.
		                    return;
		                }
	                	
	                	//console.log("tLota14DuplYn : " + tLota14DuplYn);
	                	//console.log("tQtyRcvSum : " + tQtyRcvSum);
	                	//console.log("menge : " + menge);
	                	//console.log("menge_r : " + menge_r);
	                	
	                	// 20221012 오더순번 별 전량 입고 해야됨.
	                	if(tQtyRcvSum != menge){
	                		console.log("오더체크 테스트");
		                    gridList.setColFocus(subGridId, rowNum, "QTYRCV");
		                    commonUtil.msgBox("VALID_M2147",[sebeln,sebelp,(menge),tQtyRcvSum]);   // 이송입고 [{0}][{1}]오더는 오더 수량[{2}](을)를 전량 입고 하여야 합니다. 수량[{3}]을 확인해주세요.
		                    return;
		                }
	                	// 20221012 개별바코드 중복여부 확인
	                	
	                	/*
	                	if(tLota14DuplYn==true){
	                		gridList.setColFocus(subGridId, rowNum, "LOTA14");
		                    commonUtil.msgBox("VALID_M2148",[lota14]);   // 중복된 개별바코드[{0}]가 있습니다. 확인해주세요.
		                    return;
	                	}
	                	*/
	                }else{
		                /*
		                // 20221011 일시적으로 입고 가능수량 validation 제거요청으로 주석 KJH
	                	if(qtyrcv > (menge-menge_r)){
		                    gridList.setColFocus(subGridId, rowNum, "QTYRCV");
		                    commonUtil.msgBox("VALID_M2131",[sebeln,sebelp,(menge-menge_r),qtyrcv]);   //[{0}][{1}]오더의 입고가능한 수량[{2}]을 넘겼습니다. 수량[{3}]을 확인해주세요.
		                    return;
		                }
		                */
	                }
	                
	                var lota14 = rowData.get("LOTA14"); // 개별바코드
					var skug05_1 = rowData.get("SKUG05_1"); // 사업부
					if( (lota14==""||lota14==" ") && (skug05_1==""||skug05_1==" ") ){
						commonUtil.msgBox("VALID_M2060");		//개별바코드가 없을 경우에는 사업부가 필수 입니다.
						gridList.setColFocus(subGridId, rowNum, "SKUG05_1");
						return;
					}
					
					if(lota14==""||lota14==" "){
						gridList.setColFocus(subGridId, rowNum, "LOTA14");
		            	//commonUtil.msgBox("VALID_M2063");// 개별바코드가 없는 문서가 존재하여 입고를 할 수 없습니다.
		            	commonUtil.msgBox("VALID_M2118",[sebeln]);// [{0}] 개별바코드가 없는 문서가 존재하여 입고를 할 수 없습니다.
		                return;
		            }
					
					var shtayn = rowData.get("SHTAYN"); // 즉시불출 여부
					var wmsmak = rowData.get("WMSMAK"); // WMS재고관리대상 여부
					var lota01 = rowData.get("LOTA01"); // 저장위치
		            if(shtayn=="V" && wmsmak=="V"){
		            	gridList.setColFocus(subGridId, rowNum, "rowCheck");
		            	commonUtil.msgBox("VALID_M2105",[sebeln]);// [{0}] 즉시불출이며, WMS재고대상 인 문서가 존재하여 입고를 할 수 없습니다.
		                return;
		            }
		            
					if(shtayn!="V" && wmsmak!="V"){
		            	var imib02Lota01 = rowData.get("IMIB02_LOTA01");
		            	gridList.setColFocus(subGridId, rowNum, "rowCheck");
		            	imib02 = rowData.get("IMIB02");
		            	imib02msg = commonUtil.getMsg("VALID_M2106",[sebeln,lota01]); // [{0}] 저장위치[{1}] 즉시불출이 아니고, WMS재고대상 아닌 문서가 존재합니다. 진행하시겠습니까?
		            }
                }
				/////////////////////
            }
            
            var list = new Array();
			if(headChkLen > 0 && dblIdx == subIdx && dblIdx!=-1 && chkItemLen!=0){
				
				var head = gridList.getRowData("gridList", dblIdx);
				list = gridList.getSelectData(subGridId);
				
				headSebeln = gridList.getColData("gridList", dblIdx, "SEBELN");
			}else{
				headSebeln="";
			}
			
			var head = gridList.getSelectData("gridList");
			//console.log(JSON.stringify(list));
			/*
			if(list.length==0){
				commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
                return;
			}
			*/
			// 20220817 입고 오더 데이터 변경 VALIDATION
			var vParam = new DataMap();
			vParam.put("OWNRKY", "<%=ownrky%>");
			vParam.put("head", head); 
			vParam.put("list", list);
			vParam.put("headSebeln", headSebeln);
			
			var json = netUtil.sendData({
				url : "/wms/inbound/json/validationOrderGr02.data",			
				param : vParam
			});
			if(json.data != "OK"){
				var msgList = json.data.split("†");
				var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
				commonUtil.msg(msgTxt);										//작업아이템번호에 입력된 지번은 등록되지 않았습니다.
				
				gridList.resetGrid("gridList");
				gridList.resetGrid("gridListSub");
				searchList();
				return;
			}
            
			//alert("2 - headChkLen : " + headChkLen + "\ndblIdx : " + dblIdx + "\nsubIdx : " + subIdx);
			if(imib02==""){
	            if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){
	                return;
	            }
			}else{
				// 즉시불출이아니며 WMS재고비관리대상 =>  [저장위치 : XXXX] WMS재고관리대상이 아닙니다. 계속 진행 하시겠습니까?
				if(!commonUtil.msgConfirm(imib02msg)){
	                return;
	            }
			}
			
			var param = new DataMap();
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("head", head);
			param.put("list", list);
			param.put("headSebeln", headSebeln);
			//param.put("headModifyIndex", dblIdx);
			param.put("PROGID", configData.MENU_ID);
			
			param.put("headList", head);
			param.put("messageOption", {
				total_count : param.map.headList.length,
                current_count : 1,
                message   : commonUtil.getMsg("IN_M0153")//"입고 진행중입니다."
            })
            
            sucCount = 0;
        	errCount = 0;
        	msgHtml = "";
			var json = sendSave(param);
			
			
		}
	}
	
	
	var sucCount = 0;
    var errCount = 0;
    var msgHtml = "";
    // 20220907 저장방식 변경됨.
	function sendSave(param, recall){
        
		var current_count = param.map.messageOption.current_count;
		var total_count = param.map.messageOption.total_count;
		
    	if(total_count == 1){
    		sucCount = 0; 
    	    errCount = 0;
    	    msgHtml = "";
    	}
		
		if(param.map.messageOption){
        	netUtil.processMessage(param);
	    }
		
		var loopHeadList = new Array();
		loopHeadList.push(param.map.headList[current_count-1]);
		param.put("head", loopHeadList);
		
        var json;
		
        setTimeout(function(){
        	json = netUtil.sendData({
                url : "/wms/inbound/json/SaveGR02New.data",
                param : param,
                async : true,       // 응답없는 메시지 제거를위해 비동기 처리
                loading : true,     // 전체완료될때까지 로딩 유지
                recall : recall,    // 로딩이미지 적용을위해 재귀호출시 필요
                callBackFunction : function(returnData){
                	
                	var inRsCode = returnData.data.inRsCode; // 입고저장 결과코드
                    var inRsMsg = returnData.data.inRsMsg;   // 입고저장 결과 메시지
    				
    				var ifRsCode = returnData.data.ifRsCode; // 인터페이스 전송 결과코드
                    var ifRsMsg = returnData.data.ifRsMsg;   // 인터페이스 전송 결과 메시지
                    
                    var totCnt = returnData.data.totCnt;     // 입고 전체 건수
                    var sucCnt = returnData.data.sucCnt;     // 입고 성공 건수
                    var failCnt = returnData.data.failCnt;   // 입고 실패 건수
                    
                    console.log("전체 : " + totCnt + " - 성공 : " + sucCnt + " - 실패 : " + failCnt);
                	console.log("inRsCode : " + inRsCode);
                	console.log("ifRsCode : " + ifRsCode);
                	console.log("inRsMsg : " + inRsMsg);
                	console.log("ifRsMsg : " + ifRsMsg);
                	//console.log("sucList : " + sucList);
                	
                	if(inRsCode != "S" && ifRsCode != "S"){
                		msgHtml += "\n" + inRsMsg + "" + ifRsMsg;
                		errCount++;
                	}else if(inRsCode != "S"){
                    	msgHtml += "\n" + inRsMsg;
                    	errCount++;
                	}else if(ifRsCode != "S"){
                    	msgHtml += "\n" + ifRsMsg;
                    	errCount++;
                    }else{
                    	sucCount++;
                    }
                	
                	if(total_count > current_count){
                		sendSave(param, true);
                    }else{
                    	netUtil.processMessageOff();
                        commonUtil.msgBox("실패:"+errCount +", 성공:"+sucCount+msgHtml); //관리자에게 문의 바랍니다.
                        
                    	searchList();
                    }
                }
            });
        }, 100);
    }
	
	function saveRsReadonly(sucList,chkHeadList,headSebeln){
		
		if(sucList!=undefined && sucList.length > 0){
    		// 완료된 데이터 잠금
    		for(i=0;i<sucList.length;i++){
    			var sucRow = sucList[i];
    			var sebeln = sucRow.SEBELN; 
    			//console.log(i + " - sucList - sebeln : " + sebeln + " - chkHeadList.length : " + chkHeadList.length);
    			
    			for(var j=0;j<chkHeadList.length;j++){
                	var rowData = chkHeadList[j];
                	var rowNum = rowData.get("GRowNum");
                	var hSebeln = rowData.get("SEBELN");
                	//console.log(j + " - chkHeadList - hSebeln : " + hSebeln);
                    if(sebeln==hSebeln){
                    	//console.log(j + " - chkHeadList matching - hSebeln : " + hSebeln);
                    	gridList.setRowCheck("gridList", rowNum, false);
                    	gridList.setColValue("gridList", rowNum, "STATDO", "FRV");
                    	gridList.setColValue("gridList", rowNum, "STATDONM", "입고완료");
                    	gridList.setRowReadOnly("gridList", rowNum, true, ['rowCheck',"DOCDAT","DOCTXT"]);
                    	gridList.setRowState("gridList", configData.GRID_ROW_STATE_READ, rowNum) ;
                    	gridList.reloadAll("gridList");
                    	
                    	if(headSebeln!="" && headSebeln==hSebeln){
                    		gridList.resetGrid("gridListSub");
                    		gridList.resetGrid("gridConfirmList");
                    		gridListEventItemGridSearch("gridList", rowNum);
                    	}
                    	
                    	break;
                    }
                }
    		}
    	}
	}
	
	function setSKUG04(gridId, rowNum, colName, colValue){
    	
    	// 사업부에 따른 상품국분 넣기
		if(colValue.length > 0 && colValue != " ") {
			var param = new DataMap();
			param.put("SKUG05", colValue);
			var json = netUtil.sendData({
				module : "WmsInbound",
				command : "GR99_SKUG05",
				sendType : "map",
				param : param
			});
			
			if(json && json.data){
				gridList.setColValue(gridId, rowNum, "SKUG04", json.data["SKUG04"]);
			} else {
				gridList.setColValue(gridId, rowNum, "SKUG04", "");
			}
		} else {
			gridList.setColValue(gridId, rowNum, "SKUG04", "");
		}
    	
    }
	
	function fnAutoPalletzing(){
		
       var chkItemIdx = gridList.getSelectRowNumList("gridListSub");
       var chkItemLen = chkItemIdx.length; 
       var headChkLen = gridList.getSelectRowNumList("gridList").length;
       
       if( chkItemLen == 0 ){
           commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
           return;
       }
       
       var chkItemList = gridList.getSelectData("gridListSub"); 
       
       for(var i=0;i<chkItemList.length;i++){
    	   var rowData = chkItemList[i];
           var rowNum = rowData.get("GRowNum");
           
           var LOTA14 = $.trim(rowData.get("LOTA14")); //개별바코드
           if(LOTA14!=""){
               gridList.setColFocus("gridListSub", rowNum, "LOTA14");
        	   commonUtil.msgBox("VALID_M2062");      //개별바코드가 존재하여 자동Palletizing을 할 수 없습니다.
               return;
           }
           
           var LOTA11 = $.trim(rowData.get("LOTA11")); //제조일자
           if(LOTA11==""){
               gridList.setColFocus("gridListSub", rowNum, "LOTA11");
               var STD_LOTA11 = commonLabel.getLabel("STD_LOTA11", 1);
        	   commonUtil.msgBox("VALID_required",[STD_LOTA11]);      // {제조일자} 은(는) 필수 입력항목입니다.
               return;
           }
           
           var LOTA11 = $.trim(rowData.get("LOTA11")); //입고일자
           var LOTA15 = $.trim(rowData.get("LOTA15")); //LOT번호
           //console.log("LOTA11 : " + LOTA11 + " - LOTA15 : " + LOTA15);
           if(LOTA11=="" && LOTA15==""){
        	   gridList.setColFocus("gridListSub", rowNum, "LOTA11");
        	   commonUtil.msgBox("VALID_M2066");      // LOT번호가 없을 경우 제조일자는 필수 입니다.
               return;
           }
           
           var QTYORD = new Number(rowData.get("QTYRCV1")); //오더수량
           var QTYRCV = new Number(rowData.get("QTYRCV")); //입고수량
           /*
           // 20221011 일시적으로 입고 가능수량 validation 제거요청으로 주석 KJH
           if((QTYORD - QTYRCV) < 0){
               gridList.setColFocus("gridListSub", rowNum, "QTYRCV");
               commonUtil.msgBox("IN_M0078");      //입고수량은 입고가능수량보다 클 수 없습니다.
               return;
           }
           */
           
           /*
           var PALQTY = new Number(rowData.get("PALQTY")); //기본단위/Pallet
           
           if(PALQTY >= QTYRCV){
        	   commonUtil.msgBox("VALID_M2064");      //입고수량이 기본단위/Pallet 수량보다 작으면 자동Palletizing을 할 수 없습니다.
               gridList.setColFocus("gridListSub", rowNum, "QTYRCV");
               return;
           }
           */
           
           var BWART = rowData.get("BWART");
           var FWMSMAK = rowData.get("FWMSMAK"); // 이송입고 WMS재재고대상여부
           var TEBELN = rowData.get("TEBELN"); // 지시서여부
           if(BWART=="121"&&FWMSMAK=="V"&&TEBELN!=""&&TEBELN!=" "){
        	   gridList.setColFocus("gridListSub", rowNum, "SKUKEY");
        	   commonUtil.msgBox("VALID_M20646");      //이송입고는 자동Palletizing을 할 수 없습니다.
               return;
           }
           
       }
       //alert("2 - headChkLen : " + headChkLen + "\ndblIdx : " + dblIdx + "\nsubIdx : " + subIdx);
       var list = gridList.getSelectData("gridListSub");
       
       var param = new DataMap();
       param.put("list", list);
       
       //파레타이징을 했을 때 해당 List를 GridSub에 맞춰넣도록..내용 추가를 해볼 것..
       
       /*
       gridList.resetGrid("gridConfirmList");
       gridList.gridList({
           id : "gridConfirmList",
           param : param,
           url : "/wms/inbound/json/Palletizing.data"
       });
       */
       
       	// 20221012 개별바코드 추가 채번 후 데이터 append 기능 추가
       	var json = netUtil.sendData({
        	url : "/wms/inbound/json/PalletizingJson.data",
			sendType : "list",
			param : param
		});
		//console.log("getLotaInfoList : " + JSON.stringify(json));
		if( json && json.data ){
			// 기존 Pallitizing 데이터를 삭제 후 추가 하시겠습니까?
			if(commonUtil.msgConfirm("VALID_M2146")){
				gridList.resetGrid("gridConfirmList");
			}
			gridList.appendJson('gridConfirmList', json);
		}else{
			alert("Palletting error");
		}
       
       	selTab = 2;
       
       	$('#tabSub2').click();
       	gridList.firstRowFocus('gridConfirmList');
       
    }
	
	function setUOMInfo(gridId, rowNum){
		
		var param = new DataMap();
		
		var SKUKEY = gridList.getColData(gridId, rowNum, "SKUKEY");
		var UOMKEY = gridList.getColData(gridId, rowNum, "UOMKEY");
		var QTYRCV = gridList.getColData(gridId, rowNum, "QTYRCV");
		
		var RCPTTY = gridList.getColData(gridId, rowNum, "RCPTTY");
		
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("WAREKY", "<%=wareky%>");
		param.put("SKUKEY", SKUKEY);
		param.put("QTY", QTYRCV);
		param.put("UOMKEY", UOMKEY);
		
		var json = netUtil.sendData({
			module : "WmsInbound",
			command : "UOMQTYval",
			sendType : "map",
			param : param
		});
		
		var UOMQTY = json.data["UOMQTY"];
		
		var TOT = json.data["TOT"];
		var BAG = json.data["BAG"];
		var BOX = json.data["BOX"];
		var PLT = json.data["PLT"];
		var SOK = json.data["SOK"];
		var EA = json.data["EA"];
		var MUOMKEY = json.data["MUOMKEY"];
		
		//구매입고, 수량단위 KG, 기본단위가 R일 경우 소수점 반올림 처리 ( (주)한창제지 CASE )
		var parUOMQTY = (RCPTTY == '111' && UOMKEY == 'KG' && MUOMKEY == 'R') ? parseFloat(UOMQTY).toFixed(1) : UOMQTY;
		
		gridList.setColValue(gridId, rowNum, "UOMQTY", parUOMQTY);
		gridList.setColValue(gridId, rowNum, "TOT", TOT);
		gridList.setColValue(gridId, rowNum, "BAG", BAG);
		gridList.setColValue(gridId, rowNum, "BOX", BOX);
		gridList.setColValue(gridId, rowNum, "PLT", PLT);
		gridList.setColValue(gridId, rowNum, "SOK", SOK);
		gridList.setColValue(gridId, rowNum, "EA", EA);
		//gridList.setColValue(gridId, rowNum, "MUOMKEY", MUOMKEY);
		
	}
	
	function setStlkyInfo(gridId, rowNum){
		
		var param = new DataMap();
		
		var LOTA01 = gridList.getColData(gridId, rowNum, "LOTA01");
		var LOTA02 = gridList.getColData(gridId, rowNum, "LOTA02");
		
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("LOTA02", LOTA02);
		param.put("LOTA01", LOTA01);
		
		if(LOTA01==""){
			gridList.setColValue(gridId, rowNum, "LOTA01NM", "");
		}else{
			var json = netUtil.sendData({
				module : "WmsInbound",
				command : "GR99_STLKYINFO",
				sendType : "map",
				param : param
			});
			
			if(json && json.data){
				gridList.setColValue(gridId, rowNum, "LOTA01NM", json.data["STLNM"]);
				gridList.setColValue(gridId, rowNum, "WMSMAK", json.data["WMSMAK"]);  // WMS 재고관리대상 여부
			} else {
				commonUtil.msgBox("VALID_M2084"); // 존재하지 않는 저장소입니다.
				gridList.setColValue(gridId, rowNum, "LOTA01", "");
				gridList.setColValue(gridId, rowNum, "LOTA01NM", "");
				gridList.setColValue(gridId, rowNum, "WMSMAK", "");
			}
		}
	}
	
	function setSTLKY(){
		
		var gridId = "gridListSub";
		if(selTab!=1){
			gridId = "gridConfirmList";
		}
		var toStlky = $("#TOSTLKY").val(); // 저장위치
		var toStddt = $("#STDDT").val();  // 제조일자
		var stlkyList = new Array();
		
		if(gridList.getSelectData(gridId).length < 1) {
			commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
			return;
		}
		
		if(selTab==1){
			if( $.trim(toStlky)=="" && $.trim(toStddt)=="" ){
				commonUtil.msgBox("VALID_M2149");// 저장위치나 제조일자를 입력하여 주세요.
				return;
			}
		}else{
			toStddt="";
			if( $.trim(toStlky)==""){
				commonUtil.msgBox("VALID_M2150");// 저장위치를 입력하여 주세요.
				return;
			}
		}
		
		if($.trim(toStddt)!="" ){
			var selectNumList = gridList.getSelectRowNumList(gridId);
			for(var i=0;i<selectNumList.length;i++){
				var rowNum = selectNumList[i];
				gridList.setColValue(gridId, rowNum, "LOTA11", toStddt);
			}
		}
		
		if($.trim(toStlky)!="" ){
		
			var param = new DataMap();
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("STLKY",toStlky);
			
			// 저장소정보 조회
			var json = netUtil.sendData({
				module : "WmsInbound",
				command : "STLKY_INFO",
				sendType : "list",
				param : param
			});
			
			if (json.data && json.data.length>0){
				stlkyList = json.data;
			}else{
				commonUtil.msgBox("VALID_M2085", toStlky);	// 저장소 [{0}]가 이 유효하지 않습니다.
				return false;
			}
			
			var selectNumList = gridList.getSelectRowNumList(gridId);
			
			for(var i=0;i<selectNumList.length;i++){
				var rowNum = selectNumList[i];
				var lota02 = gridList.getColData(gridId, rowNum, "LOTA02");
				var sameLota02YN = false;
				for(var j=0;j<stlkyList.length;j++){
					var item = stlkyList[0];
					var plntky = item.PLNTKY;
					if(lota02==plntky){
						sameLota02YN=true;
						break;
					}
				}
				if(!sameLota02YN){
					gridList.setColFocus(gridId, rowNum, "LOTA01");
					commonUtil.msgBox("VALID_M2086");	// 동일한 플랜트 내 저장소만 변경 가능합니다.
					return;
				}
			}
			
			for(var i=0;i<selectNumList.length;i++){
				var rowNum = selectNumList[i];
				for(var j=0;j<stlkyList.length;j++){
					var item = stlkyList[0];
					var plntky = item.PLNTKY;
					var stlnm = item.STLNM;
					if(lota02==plntky){
						gridList.setColValue(gridId, rowNum, "LOTA01", toStlky);
						gridList.setColValue(gridId, rowNum, "LOTA01NM", stlnm);
						break;
					}
				}
			}
		
		}
		
		commonUtil.msgBox("TASK_M0700");	// 반영되었습니다.
	}
	
	function tabChange(tabNo){
        $("[id^=tab2_btn]").hide();
        $("#"+tabNo).show();
        
        if(tabNo=="tab2_btn_01"){
        	selTab=1;

        	$("[id=stddt01]").show();
        	$("[id=stddt02]").show();
        	
        }else if(tabNo=="tab2_btn_02"){
        	selTab=2;
        	
        	$("[id=stddt01]").hide();
        	$("[id=stddt02]").hide();
        	
        }
    }
	
	function setDeadLine(){

		var gridId = "gridList";
		var headChkLen = gridList.getSelectRowNumList(gridId).length;
		if(headChkLen == 0){
			commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
			return;
		}
		
		var chkHeadList = gridList.getSelectData(gridId);
		for(var i=0;i<chkHeadList.length;i++){
			var rowData = chkHeadList[i];
			var rowNum = rowData.get("GRowNum");
			
			var rcptty = rowData.get("RCPTTY");
			var dleflg = rowData.get("DLEFLG");
			
			if(rcptty!="111"){
			    gridList.setColFocus(gridId, rowNum, "rowCheck");
				var STD_PTLDLE = commonLabel.getLabel("STD_PTLDLE", 1);
				commonUtil.msgBox("VALID_M0957",[STD_PTLDLE]); // [{0}]은(는) 구매입고만 가능합니다.
			    return;
			}
			
			if(dleflg == "Y"){
				gridList.setColFocus(gridId, rowNum, "rowCheck");
				var STD_PTLDLE = commonLabel.getLabel("STD_PTLDLE", 1);
				commonUtil.msgBox("VALID_M0958",[STD_PTLDLE]); // 이미 마감한 문서는 마감 할 수 없습니다.
			    return;
			}
			
		}
		
		// 마감하시겠습니까?
		if(!commonUtil.msgConfirm("VALID_M0967")){
			return;
		}
		
		var param = new DataMap();
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("head", chkHeadList);
		
		var json = netUtil.sendData({
			url : "/wms/inbound/json/deadlineGR02.data",
			param : param
		});
		
		if(json.data && json.data.RESULTMSG ){
			var msgList = json.data.RESULTMSG.split("†");
			var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
			commonUtil.msg(msgTxt);
			return;
		}
		
		if(json && json.data){
			commonUtil.msgBox("VALID_M0968"); // 마감이 완료되었습니다.
			
			gridList.resetGrid("gridList");
			gridList.resetGrid("gridListSub");
			searchList();
		}

	}
	
	
	function setDeadLineCancel(){

		var gridId = "gridList";
		var headChkLen = gridList.getSelectRowNumList(gridId).length;
		if(headChkLen == 0){
			commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
			return;
		}
		
		var chkHeadList = gridList.getSelectData(gridId);
		for(var i=0;i<chkHeadList.length;i++){
			var rowData = chkHeadList[i];
			var rowNum = rowData.get("GRowNum");
			
			var rcptty = rowData.get("RCPTTY");
			var dleflg = rowData.get("DLEFLG");
			
			if(rcptty!="111"){
			    gridList.setColFocus(gridId, rowNum, "rowCheck");
				var STD_PTLDLE = commonLabel.getLabel("STD_PTLDLE", 1);
				commonUtil.msgBox("VALID_M0957",[STD_PTLDLE]); // [{0}]은(는) 구매입고만 가능합니다.
			    return;
			}
			
			if(dleflg != "Y"){
				gridList.setColFocus(gridId, rowNum, "rowCheck");
				commonUtil.msgBox("VALID_M0959"); // 마감된 문서만 취소 할 수 있습니다.
			    return;
			}
			
		}
		
		// 마감취소하시겠습니까?
		if(!commonUtil.msgConfirm("VALID_M0969")){
			return;
		}
		
		var param = new DataMap();
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("head", chkHeadList);
		
		var json = netUtil.sendData({
			url : "/wms/inbound/json/deadlineCancelGR02.data",
			param : param
		});
		
		if(json.data && json.data.RESULTMSG ){
			var msgList = json.data.RESULTMSG.split("†");
			var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
			commonUtil.msg(msgTxt);
			return;
		}
		
		if(json && json.data){
			commonUtil.msgBox("VALID_M0970"); // 마감취소가 완료되었습니다.
			
			gridList.resetGrid("gridList");
			gridList.resetGrid("gridListSub");
			searchList();
		}

	}
	
	function printList(){
		// gridListSub에 변경된 바코드 존재 시 return;
		var changedList = gridList.getModifyData('gridListSub', 'M');
		var changedLota14 = changedList.find(x => {return x.get("LOTA14") != ''});
		if (changedLota14) {
			commonUtil.msgBox("VALID_M2145"); // 변경된 개별바코드로는 출력할 수 없습니다.
			return false;
		}
		
		var list = gridList.getSelectData("gridList");
		var Sublist = gridList.getSelectData("gridListSub");
		
		if (Sublist.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		} 
		
		var param = new DataMap();
		param.put("list",Sublist);
		param.put("columnList", "WAREKY");
		param.put("PRTTYP","RCP_LB");
		param.put("OWNRKY", "<%=ownrky%>");
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		
		var url = "Receipt_TGR02_Label_Print.ezg";
		var Keywareky  = "";
		var where = "AND PO.WAREKY=" + "'<%=wareky%>' AND (";
		var orderby = "";
		var language = "<%=langky%>";
		var map = new DataMap();
	
		/* for(var j=0; j<list.length; j++){
			var row = list[j];
			var DOCUTY = row.get("DOCUTY");

			if(DOCUTY != "101"){
				commonUtil.msgBox("VALID_M2144"); // 라벨을 출력할수 있는 입고 유형이 아닙니다.
				return false;
			}
		} */
		
		
		for(var i=0; i<Sublist.length; i++){
			var row = Sublist[i];
			var WAREKY = row.get("WAREKY");
			var SEBELN = row.get("SEBELN");
			var LOTA14 = row.get("LOTA14");
			var SEBELP = row.get("SEBELP");
			
			if(!LOTA14 || !LOTA14.trim()){
				commonUtil.msgBox("VALID_M2144"); // 개별바코드가 부여되지 않아 출력할 수 없습니다.
				return false;	
			}
			
			Keywareky = row.get("WAREKY");
			where += "PO.EBELN='"+SEBELN+"' AND PO.EBELP='"+SEBELP+"'";
			if(i==Sublist.length-1) break;
			where += " OR ";	
		}
		where += ")";
		
		var width = '850';
		var height = '680';

		map.put("WAREKY", Keywareky);
		WriteEZgenElement(url, where, orderby, language, map, width, height);
	}
	
	//search 전체 체크박스 클릭
	function searchCheckBoxAll(obj) {
		
		if($(obj).prop("checked") == true){
			$(obj).parent('dd').children('input').prop("checked", true);
		}else{
			$(obj).parent('dd').children('input').prop("checked", false);
		}
	}
	
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
	<div class="content_inner">
		<%@ include file="/common/include/webdek/title.jsp" %>
		<div class="content_serch" id="searchArea">
