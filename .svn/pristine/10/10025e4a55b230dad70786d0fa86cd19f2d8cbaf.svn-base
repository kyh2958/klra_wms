<%@page import="project.common.airfw.User"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Grid default</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<link rel="stylesheet" type="text/css" href="/common/theme/webdek/css/demo_layout.css">
<script type="text/javascript">
	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",
			name : "gridList",
			module : "WmsInventory",
			command : "TASDH",
			editable : false,
			itemGrid : "gridListSub",
			itemSearch : true
		});
		
		gridList.setGrid({
			id : "gridListSub",
			name : "gridListSub",
			module : "WmsInventory",
			command : "TASDI",
			editable : false,
		});
		
		initSearchArea();
	});
	
	function initSearchArea() {
		<%if(plant.equals("")){%>
			$('select[name="TI.LOTA02"]').multipleSelect('checkAll');
		<%}else{%>
			$('select[name="TI.LOTA02"]').multipleSelect('setSelects', ['<%=plant%>']);
		<%}%>
	}
	
	function comboEventDataBindeBefore(comboAtt){
		if(comboAtt == "Wms,PLNTKYCOMBO"){
			var param = new DataMap();
			param.put("WAREKYS", "'<%=wareky%>'");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
			return param;
		} else if(comboAtt == "airfw,COMCOMBO"){
			var param = new DataMap();
			param.put("CODE", 'SKUL01');
			return param;
		}
	}
	
	function commonBtnClick(btnName){
		if (btnName == "Search"){
			searchList();
		}
	}
	
	function searchList(){
		if(validate.check("searchArea")){
			gridList.resetGrid("gridListSub");
			
			var param = inputList.setRangeParam("searchArea");
			param.put("WAREKY", "<%=wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
			param.put("PROGID", "<%=menuId%>");
			
			gridList.gridList({
				id : "gridList",
				param : param
			});
			
		}
	}

	function gridListEventDataBindEnd(gridId, dataCount){
		if(gridId == "gridList" && dataCount > 0){
			gridListEventRowDblclick(gridId, 0);
		}
		gridList.setReadOnly("gridList", true);
		gridList.setReadOnly("gridListSub", true);
	}
	
	function gridListEventRowDblclick(gridId, rowNum, colName, colValue){
		if (gridId == "gridList"){
			gridList.resetGrid("gridListSub");
			
			var param = inputList.setRangeParam("searchArea");
			param.put("LANGKY", "<%=langky%>");
			param.put("PROGID", "<%=menuId%>");
			param.put("TASKKY", gridList.getColData(gridId, rowNum, "TASKKY"));
			
			gridList.gridList({
				id : "gridListSub",
				param : param
			});
		}
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType, $inputObj){
		if (searchCode == "SHZONMA"){ // 구역
			var param = inputList.setRangeParam("searchArea");
			param.put("WAREKY", '<%=wareky%>');
			param.put("AREAKY", param.get("AREAKY"));
			return param;
		} else if(searchCode == "SHSKUMA"){ //품목코드
			var param = new DataMap();
			param.put("WAREKY", '<%=wareky%>');
			param.put("OWNRKY", "<%=ownrky%>");
			return param;
		} else if(searchCode == "SHCMCDV"){ // 재고상태
			var param = new DataMap();
			param.put("CMCDKY", "LOTA06");
			return param;
		} else if(searchCode == "SHLOCMA_PT") { // 로케이션
			var param = dataBind.paramData("searchArea");
		
			var plntkyArr = $('select[name="TI.LOTA02"]').val();
			plntkyArr = plntkyArr ? plntkyArr : [];
			plntkyArr.push(' ');
			
			param.put("PLNTKY", plntkyArr);
			return param;
		} else if(searchCode == "SHSTLMAP") { // 저장위치
			var param = new DataMap();
			var PLNTKY = $('select[name="TI.LOTA02"]').val();
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("PLNTKY", PLNTKY);
			return param;
		}
	}
	
	function gridListEventItemGridSearch(gridId, rowNum, itemGridList){
	    if(gridId == "gridList"){
	        
	        gridListEventRowDblclick(gridId, rowNum);

	    }
	}  
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
	<div class="content_inner">
		<%@ include file="/common/include/webdek/title.jsp" %>
		<div class="content_serch" id="searchArea">
			<div class="btn_wrap">
				<div class="fl_l">
				</div>
				<div class="fl_r">
					<input type="button" CB="Search SEARCH BTN_DISPLAY" />
				</div>
			</div>
			<div class="search_inner">
				<div class="search_wrap">
					<dl>
						<dt CL="STD_WAREKY">거점</dt>
						<dd>
							<input type="text" class="input" name="WAREKY" value="<%=wareky%>" readonly="readonly" validate="required" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA02">플랜트</dt>
						<dd>
							<select name="TI.LOTA02" class="input" Combo="Wms,PLNTKYCOMBO" ComboType="MS" validate="required">
							</select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA01">저장위치</dt>
						<dd>
							<input type="text" class="input" name="TI.LOTA01" UIInput="R,SHSTLMAP" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_DOCDAT">전기일자</dt>
						<dd>
							<input type="text" class="input" name="TH.DOCDAT" UIInput="R" UIFormat="C 0 N" validate="required"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_TASCAT">작업유형</dt>
						<dd>
							<select class="input" Combo="WmsInventory,DOCTCOMBO" name="TASOTY" validate="required"></select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SKUKEY">품목코드</dt>
						<dd>
							<input type="text" class="input" name="TI.SKUKEY" UIInput="R,SHSKUMA" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA14">제조LOT</dt>
						<dd>
							<input type="text" class="input" name="TI.LOTA14" UIInput="R" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_AREAKY">영역</dt>
						<dd>
							<input type="text" class="input" name="TI.AREAKY" UIInput="R,SHAREMA" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_ZONEKY">구역</dt>
						<dd>
							<input type="text" class="input" name="TI.ZONEKY" UIInput="R,SHZONMA" UIFormat="U"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOCASR">FROM 로케이션</dt>
						<dd>
							<input type="text" class="input" name="TI.LOCASR" UIInput="R,SHLOCMA_PT" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOCATG">TO 로케이션</dt>
						<dd>
							<input type="text" class="input" name="TI.LOCATG" UIInput="R,SHLOCMA_PT" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_TASKKY">작업문서번호</dt>
						<dd>
							<input type="text" class="input" name="TI.TASKKY" UIInput="R" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_DESC01">품목명</dt>
						<dd>
							<input type="text" class="input" name="DESC01"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SKUG01">품목유형</dt>
						<dd>
							<select class="input" name="SKUG01" Combo="WmsInventory,SKUG01COMBO"><option value=""/></select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SKUL01">품목구분</dt>
						<dd>
							<select class="input" name="SKUL01" Combo="airfw,COMCOMBO">
								<option></option>
							</select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA06">재고상태</dt>
						<dd>
							<select name="TI.LOTA06" class="input" CommonCombo="LOTA06" ComboType="MS"></select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA11">제조일자</dt>
						<dd>
							<input type="text" class="input" name="TI.LOTA11" UIInput="R" UIFormat="C" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA13">유통기한</dt>
						<dd>
							<input type="text" class="input" name="TI.LOTA13" UIInput="R" UIFormat="C" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA12">입고일자</dt>
						<dd>
							<input type="text" class="input" name="TI.LOTA12" UIInput="R" UIFormat="C" />
						</dd>
					</dl>

				</div>
				<div class="btn_tab">
					<input type="button" class="btn_more" value="more" onclick="searchMore()"/>
				</div>
			</div>
		</div>
		<div class="search_next_wrap">
			<div class="content_layout tabs top_layout">
				<ul class="tab tab_style02">
					<li><a href="#tab1-1"><span CL="STD_LIST">리스트</span></a></li>
					<li class="btn_zoom_wrap">
						<ul>
							<li><button class="btn btn_bigger"><span>확대</span></button></li>
						</ul>
					</li>
				</ul>
				<div class="table_box section" id="tab1-1">
					<div class="table_list01">
						<div class="scroll">
							<table class="table_c">
								<tbody id="gridList">
									<tr CGRow="true">
										<td GH="40" 				GCol="rownum">1</td>
										<td GH="100 STD_TASKKY"		GCol="text,TASKKY"				>작업문서번호</td>
										<td GH="100 STD_DOCDAT"		GCol="text,DOCDAT"	GF="C"		>전기일자</td>
										<td GH="100 STD_DOCCAT"		GCol="text,DOCCAT"				>문서카테고리</td>
										<td GH="100 STD_DOCCATNM"	GCol="text,DOCCATNM"			>문서카테고리명</td>
										<td GH="100 STD_DOCUTY"		GCol="text,DOCUTY"				>문서유형</td>
										<td GH="100 STD_DOCUTYNM"	GCol="text,DOCUTYNM"			>문서유형명</td>
										<td GH="100 STD_STATDO"		GCol="text,STATDO"				>문서상태</td>
										<td GH="100 STD_STATDONM"	GCol="text,STATDONM"			>문서상태명</td>
										<td GH="100 STD_DOCTXT"		GCol="text,DOCTXT"				>비고</td>
										<td GH="100 STD_WAREKY"		GCol="text,WAREKY"				>거점</td>
										<td GH="100 STD_WARENM"		GCol="text,WARENM"				>거점명</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="btn_lit tableUtil">
						<button type='button' GBtn="find"></button>
						<button type='button' GBtn="sortReset"></button>
						<button type='button' GBtn="layout"></button>
						<button type='button' GBtn="total"></button>
						<button type='button' GBtn="excel"></button>
						<span class='txt_total' >총 건수 : <span GInfoArea='true'>0</span></span>
					</div>
				</div>
			</div>
			
			<div class="content_layout tabs bottom_layout">
				<ul class="tab tab_style02">
					<li><a href="#tab1-1"><span CL="STD_DETAILLIST">상세리스트</span></a></li>
					<li class="btn_zoom_wrap">
						<ul>
							<li><button class="btn btn_bigger"><span>확대</span></button></li>
						</ul>
						
					</li>
				</ul>
				<div class="table_box section" id="tab1-1">
					<div class="table_list01">
						<div class="scroll">
							<table class="table_c">
								<tbody id="gridListSub">
									<tr CGRow="true">
										<td GH="40"	GCol="rownum">1</td>
										<td GH="80 STD_TASKIT"		GCol="text,TASKIT"				>작업문서순번	</td>
										<td GH="60 STD_AREAKY"		GCol="text,AREAKY"				>영역			</td>
										<td GH="60 STD_ZONEKY"		GCol="text,ZONEKY"				>구역			</td>
										<td GH="100 STD_LOCASR"		GCol="text,LOCASR"				>From 로케이션	</td>
										<td GH="100 STD_LOCACM"		GCol="text,LOCATG"				>To 로케이션	</td>
										<td GH="100 STD_LOCATG"		GCol="text,LOCAAC"				>실로케이션	</td>
										<td GH="100 STD_SKUL01"		GCol="text,SKUL01NM"			>품목구분		</td>
										<td GH="100 STD_SKUKEY"		GCol="text,SKUKEY"				>품목코드		</td>
										<td GH="100 STD_DESC01"		GCol="text,DESC01"				>품목명		</td>
										<td GH="100 STD_UOMKEY"		GCol="text,UOMKEY"				>단위			</td>
										<td GH="80 STD_QTTAOR"		GCol="text,QTTAOR"	GF="N 30,3"	>작업수량		</td>
										<td GH="80 STD_QTCOMP"		GCol="text,QTCOMP"	GF="N 30,3"	>완료수량		</td>
										<td GH="100 STD_TOTWG"		Gcol="text,TOTWG"	GF="N 20,3"	>총중량		</td>
										<td GH="100 STD_BOXBAG" 	GCol="text,BOXBAG" 	GF="N 20,3" >BOXBAG		</td>
										<td GH="100 STD_BAGQT"		Gcol="text,BAGQT"	GF="N 20,3"	>BAG		</td>
										<td GH="100 STD_BOXQT"		Gcol="text,BOXQT"	GF="N 20,3"	>BOX		</td>
										<td GH="100 STD_PLTQT"		Gcol="text,PLTQT"	GF="N 20,3"	>Pallet		</td>
										<td GH="100 STD_SOKQT"		Gcol="text,SOKQT"	GF="N 20,3"	>속(개/BALE)	</td>
										<td GH="100 STD_EAQTY"		Gcol="text,EAQTY"	GF="N 20,3"	>매(sheet/속)	</td>
										<td GH="100 STD_LOTA06"		GCol="text,LOTA06NM"			>재고상태		</td>
										<td GH="100 STD_LOTA02"		GCol="text,LOTA02"				>플랜트		</td>
										<td GH="100 STD_LOTA01"		GCol="text,LOTA01"				>저장위치		</td>
										<td GH="100 STD_LOTA04"		Gcol="text,LOTA04"				>호기			</td>
										<td GH="100 STD_LOTA08"		GCol="text,LOTA08"				>국가			</td>
										<td GH="100 STD_LOTA07"		Gcol="text,LOTA07"				>판매번호		</td>
										<td GH="100 STD_LOTA09"		GCol="text,LOTA09"				>거래처코드MTO	</td>
										<td GH="100 STD_LOTA09NM"	GCol="text,LOTA09NM"			>거래처명MTO	</td>
										<td GH="100 STD_LOTA11"		GCol="text,LOTA11"	GF="C"		>제조일자		</td>
										<td GH="100 STD_LOTA12"		GCol="text,LOTA12"	GF="C"		>입고일자		</td>
										<td GH="100 STD_LOTA13"		GCol="text,LOTA13"	GF="C"		>유통기한		</td>
										<td GH="100 STD_LOTA14"		GCol="text,LOTA14"				>개별바코드	</td>
										<td GH="100 STD_LOTA15"		GCol="text,LOTA15"				>LOT번호		</td>
										<td GH="100 STD_LOTA03"		Gcol="text,LOTA03"				>포장타입		</td>
										<td GH="100 STD_LOTA16"		Gcol="text,LOTA16"	GF="N 20,3"	>평량			</td>
										<td GH="100 STD_LOTA17"		Gcol="text,LOTA17"				>컨테이너유형	</td>
										<td GH="100 STD_CREDAT"		GCol="text,CREDAT"	GF="D"		>생성일자		</td>
										<td GH="100 STD_CRETIM"		GCol="text,CRETIM"	GF="T"		>생성시간		</td>
										<td GH="100 STD_CREUSR"		GCol="text,CREUSR"				>생성자ID		</td>
										<td GH="100 STD_CUSRNM"		GCol="text,CUSRNM"				>생성자명		</td>
										<td GH="100 STD_LMODAT"		GCol="text,LMODAT"	GF="D"		>수정일자		</td>
										<td GH="100 STD_LMOTIM"		GCol="text,LMOTIM"	GF="T"		>수정시간		</td>
										<td GH="100 STD_LMOUSR"		GCol="text,LMOUSR"				>수정자ID		</td>
										<td GH="100 STD_LUSRNM"		GCol="text,LUSRNM"				>수정자명		</td>
										
									</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="btn_lit tableUtil">
						<button type='button' GBtn="find"></button>
						<button type='button' GBtn="sortReset"></button>
						<button type='button' GBtn="layout"></button>
						<button type='button' GBtn="total"></button>
						<button type='button' GBtn="excel"></button>
						<span class='txt_total' >총 건수 : <span GInfoArea='true'>0</span></span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- //content -->
<%@ include file="/common/include/webdek/bottom.jsp" %>
</body>
</html>