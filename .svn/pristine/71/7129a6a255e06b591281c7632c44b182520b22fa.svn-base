			/*  Tasdr 인써트 */
			//row.put("STOKKY", "%");
			
			commonDao.getMap("WmsTask.SAVETK_SZP_INS_TASDR", row);						
			
			String firstSkukey    =  row.getString("SKUKEY").substring(0, 2);
			String stkkyLota01    = row.getString("LOTA01");
			String stkkyLOTA02    = row.getString("LOTA02");
			String sendLota01     = head.getString("LOTA01");			
			String taskty         = row.getString("TASKTY");
			
			if((firstSkukey.equals("S0") || firstSkukey.equals("S9")) && stkkyLota01.equals("2400") && stkkyLOTA02.equals("P100") && sendLota01.equals("2400") && taskty.equals("356")) {
				row.put("IFID", row.getString("IFID").split(",", 0)[1]);
			}
			
			if((stockMapList.get(0).getString("SKUKEY").substring(0, 2).equals("S0") || stockMapList.get(0).getString("SKUKEY").substring(0, 2).equals("S9"))&& stockMapList.get(0).getString("LOTA01").equals("2400") && stockMapList.get(0).getString("LOTA02").equals("P100") && !sendLota01.equals("2400") && taskty.equals("356")) {				
				rsMap.put("MSG", "VALID_M2101");
				return rsMap;
			}
			
			
			// 입고 취소시 실적 IF 데이터 추출
			String I_RCPTTY = row.getString("TASKTY");
			String I_IFID   = row.getString("IFID");
			String I_OWNRKY = row.getString("OWNRKY");
			String I_RECVKY = row.getString("TASKKY");
			
			// IF 실적 입고유형별 입고키 넣기
			if(!rcpttyList.contains(I_RCPTTY)) {
				rcpttyList.add(I_RCPTTY);
				rcpttyMap.put(I_RCPTTY,""+I_RECVKY+"");
				rcpttyMap.put(I_RCPTTY+"_IFID",I_IFID);
				rcpttyMap.put(I_RCPTTY+"_OWNRKY",I_OWNRKY);
			} else {
				String docNums = rcpttyMap.getString(I_RCPTTY);
				if(docNums!=null && !"".contentEquals(docNums.trim())) {
					docNums += ","+I_RECVKY+"";
				} else {
					docNums += ""+I_RECVKY+"";
				}
				rcpttyMap.put(I_RCPTTY,docNums);
			}
			count ++;
			
			String SAPIFYN= head.getString("SAPIFYN");
			
			//폐기출고 SAP 미연동
			//if(FALSE && SAPIFYN.equals("V")) {
			
			//폐기출고 SAP 연동
			if(SAPIFYN.equals("V")) {	
//				try {
				// 실적 인터페이스 저장
				outboundService.dataInsertIF(map, rcpttyList, rcpttyMap, ifidList, false);
				
					DataMap resultMap;				
						
					// 인터페이스 전송
					for(DataMap item : ifidList) {
						item.put("ownrky", map.getString("OWNRKY"));
						item.put("IFID", item.getString("IFID"));
						item.put("RCPTTY", item.getString("RCPTTY"));
						item.put(CommonConfig.SES_USER_ID_KEY, USER);
						resultMap = outboundService.sendIf(item);												

						
						if(item.getString("RFCTYPE").equals("SAP") && ("S".equals(resultMap.getString("sendMsg")) || "SUCCESS".equals(resultMap.getString("sendMsg")))){
							//transactionSavepoint = transactionStatus.createSavepoint();
							   
							if(ifidList.size() > 1 ) {
								transactionSavepoint = transactionStatus.createSavepoint();
							}else {
								transactionManager.commit(transactionStatus);
							}
							
						}else if(1 == ifidList.size() && item.getString("RFCTYPE").equals("MES")){
							
							if(!"S".equals(resultMap.getString("sendMsg")) && !"SUCCESS".equals(resultMap.getString("sendMsg"))) {
								
				                MSG = resultMap.getString("sendMsg");
				                
				                rsMap.put("MSG", MSG);
				                rsMap.put("MSG_TYPE", "MES");
				                rsMap.put("MSG_DOC_NO", seq);
				                
				                transactionStatus.rollbackToSavepoint(transactionSavepoint);
				                
					             if(I_IFID.equals("WMS_IF_322")) {

					            	rsMap.put("ERRTXT", MSG);
									rsMap.put("ZDOCNO", STOKKY);
									rsMap.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
									rsMap.put("PROGID", map.getString("menuId"));
									rsMap.put(CommonConfig.SES_USER_ID_KEY, USER);

									rsMap.setModuleCommand("WmsOutbound", "IFSAPLOG");
									commonDao.insert(rsMap);
									transactionManager.commit(transactionStatus);	
					               }
					             
							}else {															             
						         transactionManager.commit(transactionStatus);
							}
							
						}else if(!"S".equals(resultMap.getString("sendMsg")) && !"SUCCESS".equals(resultMap.getString("sendMsg"))){
							String RFCTYPE; 
							
							if(item.getString("RFCTYPE").equals("SAP")) {
								
								transactionStatus.rollbackToSavepoint(transactionSavepoint);
								
								RFCTYPE ="SAP : ";							
								MSG = RFCTYPE+resultMap.getString("sendMsg");
								rsMap.put("MSG", MSG);
								rsMap.put("ERRTXT", resultMap.getString("sendMsg"));
								rsMap.put("ZDOCNO", seq);										
								rsMap.put("WAREKY", WAREKY);
								rsMap.put("PROGID", map.getString("menuId"));
								rsMap.put(CommonConfig.SES_USER_ID_KEY, USER);

								
								rsMap.setModuleCommand("WmsOutbound", "IFSAPLOG");
								commonDao.insert(rsMap);
								transactionManager.commit(transactionStatus);
								break;
							}else {
															
								RFCTYPE = "MES";
				                MSG = resultMap.getString("sendMsg");
				                
				                rsMap.put("MSG", MSG);
				                rsMap.put("MSG_TYPE", RFCTYPE);
				                rsMap.put("MSG_DOC_NO", seq);
								
				                transactionManager.commit(transactionStatus);
							}
						}else if(item.getString("RFCTYPE").equals("MES") && ("S".equals(resultMap.getString("sendMsg")) || "SUCCESS".equals(resultMap.getString("sendMsg")))){
							transactionManager.commit(transactionStatus);
							   
						}				
						
						//transactionManager.commit(transactionStatus);
					}//send for
//				  }catch (Exception e) {
//						transactionStatus.rollbackToSavepoint(transactionSavepoint);
//						rsMap.put("MSG", e.getMessage());
//						transactionManager.commit(transactionStatus);
//						return rsMap;			  
//				  }
					//transactionManager.commit(transactionStatus);
				}else {
					transactionManager.commit(transactionStatus);
				}
			
			}catch (Exception e) {
				transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
				 //transactionManager.commit(transactionStatus);	
				rsMap.put("MSG", e.getMessage());
				return rsMap;
			}
			
			
		}//list for
		
		
		
		// 실적 인터페이스 전송 목록
		//rsMap.put("ifidList",ifidList);	
		//rsMap.put("rcpttyList",rcpttyList);
		//rsMap.put("SAPIFYN", SAPIFYN);
		//rsMap.put("TASKKY", seq);		
		
		return rsMap;
	}

	
	public DataMap cancelTK(DataMap map) throws SQLException {
		        
		List<DataMap> headList = map.getList("loopHeadList");

		DataMap rsMap = new DataMap();
		DataMap rsRowMap = new DataMap();
		DataMap rqMap = new DataMap();

		DataMap row;

		int count = 0;
		String MSG = "OK";
		
		//SHPDI I/F SENDYN CHECK 
		/*
		 * for(int j=0;j<headList.size();j++){ rsRowMap = headList.get(j).getMap("map");
		 * rsMap.setModuleCommand("WmsOutbound", "VALIDATION_TASDI_IFSNED_CHECK");
		 * rsMap.put("TASKKY", rsRowMap.get("TASKKY")); rqMap = commonDao.getMap(rsMap);
		 * 
		 * if(rqMap != null) { rsMap.put("TASKKY", rqMap.getString("TASKKY"));
		 * 
		 * return rsMap; }
		 * 
		 * }
		 */
		
		String OWNRKY = map.getString(CommonConfig.SES_USER_OWNER_KEY);
		String WAREKY = map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY);
		String USER = map.getString(CommonConfig.SES_USER_ID_KEY);
		
		DataMap reqMap = new DataMap();
		
		for(int i=0;i<headList.size();i++){
			
			TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
	        TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
	        Object transactionSavepoint = transactionStatus.createSavepoint();
	        
	        List<DataMap> ifidList = new ArrayList<DataMap>();     	// IFID : 인터페이스 전송 목록
			List<DataMap> ifidList2 = new ArrayList<DataMap>(); 	// IFID : 인터페이스 전송 목록
			List<String> rcpttyList = new ArrayList<String>();     	// IF 실적 : 작업유형
			DataMap rcpttyMap = new DataMap();                     	// IF 실적 : 작업유형별 TASK헤더키
			String HeadTaskky = "";
			List<DataMap> reqList = new ArrayList<DataMap>();
			
			try {
				
				row = headList.get(i).getMap("map");
		 	   	String TASOTY = row.getString("DOCUTY");
		 	   	String SAPIFYN = row.getString("SAPIFYN");
		 	   	String TASKKY = row.getString("TASKKY");
		 	   
		 	   	HeadTaskky = TASKKY;
		 	   
		 	   	row.put(CommonConfig.SES_USER_ID_KEY, USER);
		 	   	row.put(CommonConfig.SES_USER_OWNER_KEY, OWNRKY);
		 	   	row.put(CommonConfig.SES_USER_WHAREHOUSE_KEY, WAREKY);				 		
		 	   
		 	   	if(!TASOTY.equals("356") && !TASOTY.equals("361") && !TASOTY.equals("354")) { //폐기출고(361), 생산직불출(356), 즉시불출(354) 실행
		 	   		continue;   
		 	   	}
		 	   	
		 	   	//출고취소 프로시저 호출
		 	   	commonDao.getMap("WmsTask.CALL_ETCSHP_CONFIRM_CANCEL", row); //출고취소
			   
			  
		 	   	//출고취소시 실적 IF 데이터 추출
				String I_RCPTTY = TASOTY;
				String I_IFID   = row.getString("IFID");
				String I_OWNRKY = row.getString("OWNRKY");
				String I_RECVKY = row.getString("TASKKY");
				
				// IF 실적 출고유형별 입고키 넣기
				if(!rcpttyList.contains(I_RCPTTY)) {
					rcpttyList.add(I_RCPTTY);
					rcpttyMap.put(I_RCPTTY,""+I_RECVKY+"");
					rcpttyMap.put(I_RCPTTY+"_IFID",I_IFID);
					rcpttyMap.put(I_RCPTTY+"_OWNRKY",I_OWNRKY);
				} else {
					String docNums = rcpttyMap.getString(I_RCPTTY);
					
					if(docNums!=null && !"".contentEquals(docNums.trim())) {
						docNums += ","+I_RECVKY+"";
					} else {
						docNums += ""+I_RECVKY+"";
					}
					
					rcpttyMap.put(I_RCPTTY,docNums);
				}
				
				outboundService.dataCancelIF(map, rcpttyList, rcpttyMap, ifidList);
		 	  
		 	    DataMap pMap = new DataMap();
				String rfcfn = ""; // FUNCTION
				String rfctbl = ""; // IF_RETBL
				
		 	   	if("V".equals(SAPIFYN)) {
		 		
				 	//List<DataMap> ifidList = rsMap.getList("ifidList");
					if(null!=ifidList && ifidList.size()>0) {
						 			
				 		        
						for(DataMap item : ifidList) {
								
							//로그 쌓기
							DataMap logMap = new DataMap();
							String logseq;																													
								
							DataMap rfcinfo = new DataMap(); 
								 		 
							rfcinfo.setModuleCommand("WmsOutbound","CANCEL_RFCINFO");
							rfcinfo.put("IFID", item.get("IFID"));
								 		 
							DataMap rfcrst = commonDao.getMap(rfcinfo);
								 
							pMap.put("I_IF_KEY", item.get("LOGSEQNO"));
							 
							logseq = item.getString("LOGSEQNO");
								 
							if("SAP".equals(item.get("RFCTYPE"))){
									
								rfcfn = rfcrst.getString("RFCFN"); // FUNCTION
								rfctbl = "T_INDATA";
								   
								if(rfcfn.equals("Z_WMS_MAT_DOC_CANCEL")){
									
									reqMap.put("WMSDN", row.getString("TASKKY"));
									reqMap.put("MBLNR", row.getString("SXBLNR"));
									reqMap.put("BUDAT", row.getString("DOCDAT"));
									reqMap.put("MJAHR", row.getString("DOCDAT").substring(0, 4));		
									pMap.put("I_IF_NAM", "WMS_IF_778");	
									
								}
								
								reqList.add(reqMap);
									
								logMap.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
								logMap.put("IFID", pMap.get("I_IF_NAM"));
								logMap.put(CommonConfig.SES_USER_ID_KEY, USER);
								logMap.put("COMSTAT", "C"); // 호출
								logMap.put("REMARK", TASKKY);
								logMap.put("SEQNO", logseq);
								commonDao.insert(logMap);
	
								// RFC통신 
								RfcCallFunction sapConn = new RfcCallFunction(); 
								DataMap sapRes = sapConn.rfcCancel(rfcfn, rfctbl, pMap, reqList);
													
								String errMsg;
	
								for (DataMap reMap : sapRes.getMapList("head")) {
										
									if("S".equals(reMap.getString("EV_CODE")) || "S".equals(reMap.getString("TYPE"))) {
											
										if(ifidList.size() == 1) {
											transactionManager.commit(transactionStatus);
										} else {
											transactionSavepoint = transactionStatus.createSavepoint();	
										}
										
									} else {
	
										if ("E".equals(reMap.getString("EV_CODE"))) {
											errMsg = reMap.getString("EV_MSG");
										} else {
											errMsg = reMap.getString("MESSAGE");
										}
											
										transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
											
										rsMap.put("MSG", "SAP : " + errMsg);
										
										rsMap.put("ERRTXT", errMsg);
										rsMap.put("ZDOCNO", TASKKY);										
										rsMap.put("WAREKY", WAREKY);
										rsMap.put("PROGID", map.getString("menuId"));
										rsMap.put(CommonConfig.SES_USER_ID_KEY, USER);
	
										rsMap.setModuleCommand("WmsOutbound", "IFSAPLOG");
										commonDao.insert(rsMap);
										transactionManager.commit(transactionStatus);
										break;								
									}
								}
	
								if (sapRes.getMapList("head").size() < 1) {
									  
									transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
									transactionManager.commit(transactionStatus);
									rsMap.put("MSG", "SAP : I/F에서 받은 결과가 존재하지않습니다."); }
									
									//통신결과 update
									logMap.setModuleCommand("Erpif", "IFWMSLOG");
									logMap.put("IFID", pMap.get("I_IF_NAM"));
									logMap.put("COMSTAT", "S"); //호출
									commonDao.update(logMap);
																				
								} else {
									// 실적 인터페이스 저장
									outboundService.dataInsertIF(map, rcpttyList, rcpttyMap, ifidList2, true);
						 		
									//ifidList = rsMap.getList("ifidList");
								
									if(null!=ifidList2 && ifidList2.size()>0) {
										// 인터페이스 전송
										try {
											DataMap resultMap;
						 				
											for(DataMap item2 : ifidList2) {
											
												if("SAP".equals(item2.get("RFCTYPE")))continue;
											
												item2.put("ownrky", map.getString("OWNRKY"));
												item2.put("IFID", item2.getString("IFID"));
												item2.put(CommonConfig.SES_USER_ID_KEY, USER);
												resultMap = outboundService.sendIf(item2);
											
											
												if(!"S".equals(resultMap.getString("sendMsg")) && !"SUCCESS".equals(resultMap.getString("sendMsg"))){
													String RFCTYPE; 
												
													RFCTYPE = "MES";
													MSG = resultMap.getString("sendMsg");
								                
													rsMap.put("MSG", MSG);
													rsMap.put("MSG_TYPE", RFCTYPE);
													rsMap.put("MSG_DOC_NO", TASKKY);
																				                
													if(I_IFID.equals("WMS_IF_322")) {
														transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
	
														rsMap.put("ERRTXT", MSG);
														rsMap.put("ZDOCNO", TASKKY);
														rsMap.put("WAREKY", WAREKY);
														rsMap.put("PROGID", map.getString("menuId"));
														rsMap.put(CommonConfig.SES_USER_ID_KEY, USER);
	
														rsMap.setModuleCommand("WmsOutbound", "IFSAPLOG");
														commonDao.insert(rsMap);
														//transactionManager.commit(transactionStatus);	
													}
												}
											}
										
										} catch (Exception e) {
											transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
											rsMap.put("MSG", e);
											rsMap.put("ERRTXT", MSG);
											rsMap.put("ZDOCNO", TASKKY);
											rsMap.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
											rsMap.put("PROGID", map.getString("menuId"));
											rsMap.put(CommonConfig.SES_USER_ID_KEY, USER);
	
											rsMap.setModuleCommand("WmsOutbound", "IFSAPLOG");
											commonDao.insert(rsMap);
											transactionManager.commit(transactionStatus);
											return rsMap;
										}
									}
						 		
									transactionManager.commit(transactionStatus);	
								}
							
								count++;
							
	//							if(ifidList.size() == 1) {
	//								transactionManager.commit(transactionStatus);
	//							}
							}//send for
													
					}
		 	  } else if("WMS_IF_310".equals(I_IFID)) {
		 		  
		 		  // IF 실적(MES) 인터페이스 전송
		 		  String ifRsCode = "S";
		 		  String ifRsMsg = "";
				
		 		  try {
		 			  DataMap sendMap = new DataMap();
						
		 			  sendMap = ifidList.get(0);
						
		 			  sendMap.put("ownrky", I_OWNRKY);
		 			  sendMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						
		 			  ifRsMsg = iFService.sendIF(sendMap);
						
		 			  if( ifRsMsg==null || !ifRsMsg.equals("SUCCESS")) {
		 				  ifRsCode = "E";
		 				  ifRsMsg = " (MES) 인터페이스 전송 에러 : " + ifRsMsg;
		 			  }
						
		 			  log.debug(" (MES) 인터페이스 전송 - ifid : " + I_IFID + " - ifRsMsg : " + ifRsMsg );
					
		 		  } catch(Exception e) {
		 			  log.error(" (MES) 인터페이스 에러 - ifid : " + I_IFID + " - Exception Error : " + e.getMessage());
		 			  String errMsg = e.getMessage();
		 			  //String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
		 			  ifRsCode = "E";
		 			  ifRsMsg = "실적(MES) 인터페이스 전송 에러 : " + errMsg;
		 			  e.printStackTrace();
		 		  }
					
		 		  // 에러 처리
		 		  if("E".equals(ifRsCode)) {
		 			  // 인터페이스 에러 결과 메세지
		 			  rsMap.put("MSG", ifRsCode);
		 			  rsMap.put("ERRTXT", ifRsMsg);
						
		 			  transactionManager.rollback(transactionStatus);
						
		 			  break;
		 		  }
		 		  
		 		  transactionManager.commit(transactionStatus);
		 		  
		 	  } else {
		 		  transactionManager.commit(transactionStatus);	
		 	  }
		 	  // 실적 인터페이스 전송 목록
		 	  rsMap.put("ifidList",ifidList);				
		 	  rsMap.put("CNT", count);
				
			} catch (Exception e) {
				transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
				rsMap.put("MSG", e);
				rsMap.put("ERRTXT", MSG);
				rsMap.put("ZDOCNO", HeadTaskky);
				rsMap.put("WAREKY", WAREKY);
				rsMap.put("PROGID", map.getString("menuId"));
				rsMap.put(CommonConfig.SES_USER_ID_KEY, USER);

				rsMap.setModuleCommand("WmsOutbound", "IFSAPLOG");
				commonDao.insert(rsMap);
				transactionManager.commit(transactionStatus);
				return rsMap;
			}
		 } // list for
		return rsMap;
	}
	
	//231212 신규(중첩트랜잭션 추가)
	public DataMap cancelTK_T(DataMap map) throws SQLException {
        
		List<DataMap> headList = map.getList("loopHeadList");

		DataMap rsMap = new DataMap();
		DataMap rsRowMap = new DataMap();
		DataMap rqMap = new DataMap();

		DataMap row;

		int count = 0;
		String MSG = "OK";
		
		String OWNRKY = map.getString(CommonConfig.SES_USER_OWNER_KEY);
		String WAREKY = map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY);
		String USER = map.getString(CommonConfig.SES_USER_ID_KEY);
		
		DataMap reqMap = new DataMap();
		
		for(int i=0;i<headList.size();i++){
			
			TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
	        TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
	        Object transactionSavepoint = transactionStatus.createSavepoint();
	        
	        List<DataMap> ifidList = new ArrayList<DataMap>();     	// IFID : 인터페이스 전송 목록
			List<DataMap> ifidList2 = new ArrayList<DataMap>(); 	// IFID : 인터페이스 전송 목록
			List<String> rcpttyList = new ArrayList<String>();     	// IF 실적 : 작업유형
			DataMap rcpttyMap = new DataMap();                     	// IF 실적 : 작업유형별 TASK헤더키
			String HeadTaskky = "";
			List<DataMap> reqList = new ArrayList<DataMap>();
			
			try {
				
				row = headList.get(i).getMap("map");
		 	   	String TASOTY = row.getString("DOCUTY");
		 	   	String SAPIFYN = row.getString("SAPIFYN");
		 	   	String TASKKY = row.getString("TASKKY");
		 	   
		 	   	HeadTaskky = TASKKY;
		 	   
		 	   	row.put(CommonConfig.SES_USER_ID_KEY, USER);
		 	   	row.put(CommonConfig.SES_USER_OWNER_KEY, OWNRKY);
		 	   	row.put(CommonConfig.SES_USER_WHAREHOUSE_KEY, WAREKY);				 		
		 	   
		 	   	if(!TASOTY.equals("356") && !TASOTY.equals("361") && !TASOTY.equals("354")) { //폐기출고(361), 생산직불출(356), 즉시불출(354) 실행
		 	   		continue;   
		 	   	}
		 	   	
		 	   	//출고취소 프로시저 호출
		 	   	commonDao.getMap("WmsTask.CALL_ETCSHP_CONFIRM_CANCEL", row); //출고취소
			   
		 	   	//출고취소시 실적 IF 데이터 추출
				String I_RCPTTY = TASOTY;
				String I_IFID   = row.getString("IFID");
				String I_OWNRKY = row.getString("OWNRKY");
				String I_RECVKY = row.getString("TASKKY");
				
				// IF 실적 출고유형별 입고키 넣기
				if(!rcpttyList.contains(I_RCPTTY)) {
					rcpttyList.add(I_RCPTTY);
					rcpttyMap.put(I_RCPTTY,""+I_RECVKY+"");
					rcpttyMap.put(I_RCPTTY+"_IFID",I_IFID);
					rcpttyMap.put(I_RCPTTY+"_OWNRKY",I_OWNRKY);
				} else {
					String docNums = rcpttyMap.getString(I_RCPTTY);
					
					if(docNums!=null && !"".contentEquals(docNums.trim())) {
						docNums += ","+I_RECVKY+"";
					} else {
						docNums += ""+I_RECVKY+"";
					}
					
					rcpttyMap.put(I_RCPTTY,docNums);
				}
				
				// 중첩 트랜잭션 생성(부모 트랜잭션과 별개 처리를 위함
				DefaultTransactionDefinition nestedTransactionDefinition = new DefaultTransactionDefinition();
				TransactionStatus nestedTransactionStatus = transactionManager.getTransaction(nestedTransactionDefinition);

				try {
					//취소용 데이터 생성(SAP, MES 순)
					outboundService.dataCancelIF(map, rcpttyList, rcpttyMap, ifidList);
					
					transactionManager.commit(nestedTransactionStatus);
				} catch (Exception e) {
					transactionManager.rollback(nestedTransactionStatus);
				}
				
		 	    DataMap pMap = new DataMap();
				String rfcfn = ""; // FUNCTION
				String rfctbl = ""; // IF_RETBL
				
				//해당 ROW가 SAP 처리건인 경우
		 	   	if("V".equals(SAPIFYN)) {
		 		
				 	//List<DataMap> ifidList = rsMap.getList("ifidList");
					if(null!=ifidList && ifidList.size()>0) {
						 			
						for(DataMap item : ifidList) {
								
							//로그 쌓기
							DataMap logMap = new DataMap();
							String logseq;																													
								
							DataMap rfcinfo = new DataMap(); 
								 		 
							rfcinfo.setModuleCommand("WmsOutbound","CANCEL_RFCINFO");
