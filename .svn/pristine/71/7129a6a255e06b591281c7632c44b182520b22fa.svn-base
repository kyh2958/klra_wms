	@Transactional
	public int DeletePT02(DataMap map) throws SQLException {
		
		List<DataMap> head = map.getList("head"); // 작업지시번호 헤더
		List<DataMap> list = map.getList("list"); // 작업지시번호 아이템
		String headTaskky =  map.getString("headTaskky"); // 개별선택한 작업지시번호
		
		int count = 0;
		
		List<Map> batchHeadList = new ArrayList();             // Batch Insert Header List
		Map batchHeadMap = new HashMap();                      // Batch Insert Header Map
		
		List<Map> batchItemList = new ArrayList();             // Batch Insert Item List
		Map batchItemMap = new HashMap();                      // Batch Insert Item Map
		
		DataMap headRow = new DataMap();
		DataMap itemRow = new DataMap();
		
		
		for(int i=0;i<head.size();i++){
			headRow = head.get(i).getMap("map");
			
			String taskky = headRow.getString("TASKKY");
			
			if(StringUtils.isNotEmpty(headTaskky) && taskky.equals(headTaskky)) {
		
				for(int j=0;j<list.size();j++){
					itemRow = list.get(j).getMap("map");
					
					//itemRow.setModuleCommand("WmsTask", "TASDIDEL");
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					//commonDao.delete(row);
					
					batchItemMap = new HashMap();
					batchItemMap.putAll(itemRow);
					batchItemList.add(batchItemMap);
					
				}
				
				// 아이템이 삭제
				inboundService.execBatchList("WmsTask.TASDIDEL_BATCH", batchItemList);
				
				// 아이템이 모두 삭제되면 헤더도 삭제
				headRow.setModuleCommand("WmsTask", "TASDH_ITEMCNT");
				int cnt = commonDao.getCount(headRow);
				if(cnt == 0) {
					headRow.setModuleCommand("WmsTask", "TASDH");
					commonDao.delete(headRow);
				}
			
			}else {
				
				headRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				batchHeadMap = new HashMap();
				batchHeadMap.putAll(headRow);
				batchHeadList.add(batchHeadMap);
				
//				// 아이템이 삭제
//				headRow.setModuleCommand("WmsTask", "TASDIDEL_ALL");
//				commonDao.delete(headRow);
//				
//				// 아이템이 모두 삭제되면 헤더도 삭제
//				headRow.setModuleCommand("WmsTask", "TASDH");
//				commonDao.delete(headRow);
				
			}
			
			count ++;
		
		}
		
		if(batchHeadList.size()>0) {
			// 아이템이 삭제
			inboundService.execBatchList("WmsTask.TASDIDEL_ALL_BATCH", batchHeadList);
			// 아이템이 모두 삭제되면 헤더도 삭제
			inboundService.execBatchList("WmsTask.TASDHDEL_BATCH", batchHeadList);
		}
		
		return count;
	}
	
	@Transactional
	public int DeleteDL06(DataMap map) throws SQLException {
		List<DataMap> selectList = new ArrayList<DataMap>();

		int headModifyIndex = -1;
		List<DataMap> itemList = null;
		if(map.containsKey("headModifyIndex")){
			headModifyIndex = map.getInt("headModifyIndex");
			itemList = map.getList("list");
		}

		List<DataMap> headList = map.getList("head");

		DataMap row;
		int count = 0;

		for(int i=0; i<headList.size(); i++){
			row = headList.get(i).getMap("map");
			
			if(headModifyIndex == i){
				for(int j=0; j<itemList.size();j++){
					if(itemList.get(j).getMap("map").getString("STATIT").equals("NEW")){
						row.append(itemList.get(j).getMap("map"));
						row.setModuleCommand("WmsTask", "TASDIDEL");
						row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						commonDao.delete(row);
					}	
				}
			}else{
				row.setModuleCommand("WmsTask", "DL06");
				selectList = commonDao.getList(row);
				
				for(int j=0; j<selectList.size();j++){
					if(selectList.get(j).getString("STATIT").equals("NEW")){
						//삭제
						row.append(selectList.get(j).getMap("map"));
						row.setModuleCommand("WmsTask", "TASDIDEL");
						row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						commonDao.delete(row);
					}	
				}
			}

			//TASDI ITEM 다 삭제되면 TASDH HEAD도 삭제 
			row.setModuleCommand("WmsTask", "TASDHDEL");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			commonDao.delete(row);
			count ++;
		}

		return count;
	}
	
	@Transactional
	public DataMap RecommendLocation(DataMap map) throws SQLException {
		
		List<DataMap> list = map.getList("list");
		DataMap row = new DataMap();
		DataMap rstMap = new DataMap();
		List<DataMap> retList = new ArrayList();
		
		String sqlMapNamespace = "WmsTask";
		
		try {
			
			row.setModuleCommand(sqlMapNamespace, "PLTSEQ");
			String pltseq = (String)commonDao.getObj(row); // P_AIRWMS_PUTAWAY_LOCATION2.PLTSEQ 값 구하기
			log.debug("RecommendLocation.pltseq : " + pltseq);
			
			for(int i=0;i<list.size();i++){
				row = list.get(i).getMap("map");

				row.put("PTLSEQ", pltseq);
				row.put("PASTKY", map.get("PASTKY"));
				row.put("USERID", map.get(CommonConfig.SES_USER_ID_KEY));
				
				row.setModuleCommand(sqlMapNamespace, "PUTAWAY_LOCATION2_PROC_CALL");
				commonDao.update(row);
				
				retList.add(row);
				
			}
		} catch (Exception e) {
			e.printStackTrace();
			rstMap.put("ERRCODE", "FAIL");
			rstMap.put("ERRMSG", e.getMessage());
			return rstMap;
		}
		
		rstMap.put("list", retList);
		rstMap.put("ERRCODE", "OK");
		rstMap.put("ERRMSG", "Success");
		
		return rstMap;
	}
	
	@Transactional
	public DataMap saveSD07_TK(DataMap map) throws SQLException {				
		
		String iprogid = map.getString("PROGID");
		List<DataMap> list = map.getList("list");
		
		DataMap rsMap = new DataMap();
		String MSG = "OK";
		
		String OWNRKY = map.getString(CommonConfig.SES_USER_OWNER_KEY);
		String WAREKY = map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY);
		String USER = map.getString(CommonConfig.SES_USER_ID_KEY);
		
		int suCnt  =0;
		int faCnt = 0;
		
		for(int i=0; i<list.size(); i++){
			
//			TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
//			TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
//			Object transactionSavepoint = transactionStatus.createSavepoint();
			
			DataMap row;
			
			//taskky대신 yyyyMMddhh24miss 
			//seq = yyyyMMddhh24miss
			SimpleDateFormat fmDate = new SimpleDateFormat("yyyyMMddHHmmss", Locale.KOREA);
			String seq = fmDate.format(new Date());

			String mnuid = map.getString("PROGID");
			List<DataMap> ifidList = new ArrayList<DataMap>();     // IFID : 인터페이스 전송 목록
			
			List<String> rcpttyList = new ArrayList<String>();     // IF 실적 : 작업유형
			DataMap rcpttyMap = new DataMap();                     // IF 실적 : 작업유형별 TASK헤더키
			
			
			row = list.get(i).getMap("map");
//			row.put("QTYGAP", -29);
			
			double gap = Double.parseDouble(row.getString("QTYGAP"));
			row.put(CommonConfig.SES_USER_OWNER_KEY, OWNRKY);
			row.put(CommonConfig.SES_USER_WHAREHOUSE_KEY, WAREKY);
			row.put(CommonConfig.SES_USER_ID_KEY, USER);
			row.put("REMARK", "SYS_ADJ_"+USER);
			row.put("QTTAOR",gap);
			row.put("MENUID",mnuid);
			row.put("PROGID",mnuid);
			
			String lota06 = row.getString("LOTA06");
			if(gap==0|| !lota06.equals("00")) {
				continue;
			}else if (gap<0) {
				try {
					row.put("IFID", "WMS_IF_314");
					row.put("PTNRTY", "CT");
					row.put("TASKTY", "SH");  //재고조정출고
					row.put("TASKKY", seq);

					String firstSkukey    =  row.getString("SKUKEY").substring(0, 2);
					String stkkyLota01    = row.getString("LOTA01");//2400만이나면도 ㅐ느넉가톡
					String stkkyLOTA02    = row.getString("LOTA02"); 
	//				String sendLota01     = head.getString("LOTA01");	//그냥 헤더에 있는 lota01	
					String sendLota01 = row.getString("LOTA01");
					String taskty         = row.getString("TASKTY"); //SH 재고조정출고 적어준거
	
					if((firstSkukey.equals("S0") || firstSkukey.equals("S9")) && stkkyLota01.equals("2400") && stkkyLOTA02.equals("P100") && sendLota01.equals("2400") && taskty.equals("356")) {
						row.put("IFID", row.getString("IFID").split(",", 0)[1]);
					}
					
	//				if((stockMapList.get(0).getString("SKUKEY").substring(0, 2).equals("S0") || stockMapList.get(0).getString("SKUKEY").substring(0, 2).equals("S9"))&& stockMapList.get(0).getString("LOTA01").equals("2400") && stockMapList.get(0).getString("LOTA02").equals("P100") && !sendLota01.equals("2400") && taskty.equals("356")) {				
	//					rsMap.put("MSG", "VALID_M2101");
	//					return rsMap;
	//				}
					
					// 입고 취소시 실적 IF 데이터 추출
					String I_RCPTTY = row.getString("TASKTY");
					String I_IFID   = row.getString("IFID");
	//				String I_OWNRKY = row.getString("OWNRKY");
					String I_OWNRKY = OWNRKY;
					String I_RECVKY = row.getString("TASKKY");
					
					// IF 실적 입고유형별 입고키 넣기
					if(!rcpttyList.contains(I_RCPTTY)) {
						rcpttyList.add(I_RCPTTY);
						rcpttyMap.put(I_RCPTTY,""+I_RECVKY+"");
						rcpttyMap.put(I_RCPTTY+"_IFID",I_IFID);
						rcpttyMap.put(I_RCPTTY+"_OWNRKY",I_OWNRKY);
					} else {
						String docNums = rcpttyMap.getString(I_RCPTTY);
						if(docNums!=null && !"".contentEquals(docNums.trim())) {
							docNums += ","+I_RECVKY+"";
						} else {
							docNums += ""+I_RECVKY+"";
						}
						rcpttyMap.put(I_RCPTTY,docNums);
					}
					row.put("SAPIFYN","V");
					String SAPIFYN= row.getString("SAPIFYN");
					
					if(SAPIFYN.equals("V")) {
						// 실적 인터페이스 저장
						outboundService.dataInsertIF(row, rcpttyList, rcpttyMap, ifidList, false);
						
						DataMap resultMap;				
						
						// 인터페이스 전송
						for(DataMap item : ifidList) {
							item.put("ownrky", map.getString("OWNRKY"));
							item.put("IFID", item.getString("IFID"));
							item.put("RCPTTY", item.getString("RCPTTY"));
							item.put(CommonConfig.SES_USER_ID_KEY, USER);
							resultMap = outboundService.sendIf(item);
							//IFWMS213 REMARK 업데이트 해줘야햅
							row.setModuleCommand("WmsTask", "SDREMARK");
							commonDao.update(row);
							suCnt++;
							String errMsg = resultMap.getString("sendMsg");
							if(!errMsg.equals("SUCCESS")) {
								rsMap.put("suCnt",suCnt);
								rsMap.put("MSG",errMsg);
								return rsMap;
							}
							
							
							if(item.getString("RFCTYPE").equals("SAP") && ("S".equals(resultMap.getString("sendMsg")) || "SUCCESS".equals(resultMap.getString("sendMsg")))){
								//transactionSavepoint = transactionStatus.createSavepoint();
								
								if(ifidList.size() > 1 ) {
//									transactionSavepoint = transactionStatus.createSavepoint();
								}else {
//									transactionManager.commit(transactionStatus);
								}
								rsMap.putAll(resultMap);
							}				
						}//send for
					}else {
//						transactionManager.commit(transactionStatus);
					}
					
				}catch (Exception e) {
//					transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
					//transactionManager.commit(transactionStatus);	
					rsMap.put("MSG", e.getMessage());
					return rsMap;
				}
				
				
			}else if(gap>0) {
				DataMap resGR = new DataMap();
				row.put("RECVKY", seq);
				row.put("IFID", "WMS_IF_219");
				resGR = inboundService.saveSDGR(row);
				int cntt = resGR.getInt("sucCnt");
				if(cntt>0) {
					suCnt++;
				}
//				transactionManager.commit(transactionStatus);
			}
		}
		rsMap.put("suCnt",suCnt);
		return rsMap;
	}
	
