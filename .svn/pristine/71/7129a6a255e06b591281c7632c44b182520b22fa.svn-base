					// 2022.07.14 WMS, SAP이 1개의 트랜잭션으로 구성된 경우 IFSAPLOG INSERT 추가
					res.put("ZDOCNO", adjky);
					res.put("ERRTXT", ifRsMsg);
					res.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
					res.put("PROGID", map.get(CommonConfig.MENU_ID_KEY));
					res.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
					res.setModuleCommand("WmsInventory", "IFSAPLOG");
					commonDao.insert(res);
					
					
				    // 인터페이스 에러 결과 메세지
					totRsCode = "E";
					totRsSbMsg.append("\n");
					totRsSbMsg.append(ifRsMsg);
					
					break;
					
				} else {
					
					if(!transactionStatus.isCompleted()) {
						transactionManager.commit(transactionStatus);
						log.debug("TaskService.PT01SaveEnd SAP 저장위치 변경 인터페이스 성공 - taskky : " + taskkyGrid + " - adjky : " + adjky + " - commit");
					}
					
					// 적치지시 아이템 데이터 대량 LOTA01 update
					inboundService.execBatchList("WmsTask.TASDIEND_LOTA01_BATCH", sjItemUpList);
					
					ifRsMsg = SAPRES;
				}
				
			} else {
				
				// 적치지시 아이템 데이터 대량 LOTA01 update
				inboundService.execBatchList("WmsTask.TASDIEND_LOTA01_BATCH", batchItemList);
				
				if(!transactionStatus.isCompleted()) {
					transactionManager.commit(transactionStatus);
					log.debug("TaskService.PT01SaveEnd SAP 저장위치 변경 인터페이스 X - sjItemList.size() : " + sjItemList.size() + " - commit");
				}
			}
			
			if(!transactionStatus.isCompleted()) {
				transactionManager.commit(transactionStatus);
				log.debug("TaskService.PT02SaveEnd - commit");
			}
			
			sucCnt++;
			
		}
			
		//rsMap.put("count", count);
		//rsMap.put("resultMsg", resultMsg);
		
		// 입고 저장 결과
		rsMap.put("inRsCode", totInRsCode);
		rsMap.put("inRsMsg", totInRsSbMsg.toString());
		
		// 인터페이스 전송 결과
		rsMap.put("ifRsCode", totRsCode);
		rsMap.put("ifRsMsg", totRsSbMsg.toString());
		
		// 입고 성공/실패 카운트
		rsMap.put("totCnt", totCnt);
		rsMap.put("sucCnt", sucCnt);
		rsMap.put("failCnt", failCnt);
		
		return rsMap;
	}
	
	
	@Transactional
	public int PT02Delete(DataMap map) throws SQLException {
		List<DataMap> head = map.getList("head");
		
		int count = 0;
		for(int i=0;i<head.size();i++){
			DataMap row = head.get(i).getMap("map");
			row.setModuleCommand("WmsTask", "TASDI");
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			commonDao.delete(row);
			
			row.setModuleCommand("WmsTask", "TASDH");
			commonDao.delete(row);
			
			count++;
		}
		
		return count;
	}
	
	@Transactional
	public String PTDeleteValidation(DataMap map) throws SQLException {
		String result = "OK";
		int	   sqlLimit = 500;
		int	   sqlCount = 1;
		int	   sqlTotCount = 1;
		
		List<DataMap> itemList = new ArrayList<DataMap>();
		DataMap sqlMap = new DataMap(); 
		
		List<DataMap> head = map.getList("head");
		List<DataMap> list = map.getList("list");
		String headTaskky  = map.getString("headTaskky");
		
		StringBuffer sb = new StringBuffer();

		for(DataMap headItem : head){
		
			itemList = new ArrayList<DataMap>();
			sb = new StringBuffer();
			sqlCount = 1;
			sqlTotCount = 1;
			
			String hOwnrky = headItem.getMap("map").getString("OWNRKY");
			String hWareky = headItem.getMap("map").getString("WAREKY");
			String hTaskky = headItem.getMap("map").getString("TASKKY");
			
			if(headTaskky.equals(hTaskky)) {
				itemList = list;
			} else {
				sqlMap = new DataMap(); 
				sqlMap.put("OWNRKY", hOwnrky);
				sqlMap.put("WAREKY", hWareky);
				sqlMap.put("TASKKY", hTaskky);
				sqlMap.setModuleCommand("WmsTask", "PT02");
				itemList = commonDao.getList(sqlMap);
			}
			
			for(DataMap listItem : itemList){
				
				if(sb.length() > 0) {
					sb.append(" UNION ALL\n ");
				}
				
				sb.append(" SELECT '").append(listItem.getMap("map").get("WAREKY")).append("' AS WAREKY, ");
				sb.append("        '").append(listItem.getMap("map").get("TASKKY")).append("' AS TASKKY, ");
				sb.append("        '").append(listItem.getMap("map").get("TASKIT")).append("' AS TASKIT, ");
				sb.append("        '").append(listItem.getMap("map").get("LOCAAC")).append("' AS LOCAAC, ");
				sb.append("        '").append(listItem.getMap("map").get("LOTA02")).append("' AS LOTA02, ");
				sb.append("        '").append(listItem.getMap("map").get("LOTA07")).append("' AS LOTA07, ");
				sb.append("        '").append(listItem.getMap("map").get("SKUKEY")).append("' AS SKUKEY ");
				sb.append(" FROM DUAL ");
				
				if ( sqlCount == sqlLimit || sqlTotCount == itemList.size() ){
					map.setModuleCommand("WmsTask", "PT01DEL_MASTER");  
					map.put("APPEND_QUERY", sb.toString());
				
					List<DataMap> validList = commonDao.getValidation(map);
					if(validList.size() > 0){
						DataMap valid = validList.get(0);
						return valid.getString("RESULTMSG");
					}
					sqlCount = 0;
					sb.setLength(0); ;
				}
				
				sqlCount++;
				sqlTotCount++;
				
			}
		
		}
		
		return result;
	}
	
