						sjItemMap.putAll(row);
						
						sjItemMap.put("LOTA01", STLKY);
						sjItemMap.put("ALOTA01", STLKY);
						sjItemMap.put("ALOTA02", PLNTKY);
						sjItemMap.put("PTLT01", STLKY);
						sjItemMap.put("PTLT02", PLNTKY);
						sjItemMap.put("LOCAKY", row.get("LOCAAC"));
						sjItemList.add(sjItemMap);
						
						sjItemUpMap = new DataMap();
						sjItemUpMap.putAll(sjItemMap);
						sjItemUpList.add(sjItemUpMap);
						
					}
					
					//row.setModuleCommand("WmsTask", "TASDIEND");
					//commonDao.insert(row);
	
	//				if (workType.equals("2")){
//						row.put("STOKKY", "%");
	//				}else{
						row.put("STOKKY", row.getString("SRCSKY"));	
	//				}
						
		 			//tasdr 프로시져에서 처리
	//				row.setModuleCommand("WmsTask", "TASDREND");
	//				commonDao.insert(row);
					//commonDao.getMap("WmsTask.DBMSPROC_SZP_INS_TASDR", row);
					
					batchItemMap = new HashMap();
					batchItemMap.putAll(row);
					batchItemList.add(batchItemMap);
					
				}
				count++;
			}
			
			// 적치지시 아이템 데이터 대량 insert
			inboundService.execBatchList("WmsTask.TASDIEND_BATCH", batchItemList);
			
			for(int i=0;i<list.size();i++){
				row = list.get(i).getMap("map");
				// tasdr 프로시져에서 처리
				commonDao.getMap("WmsTask.DBMSPROC_SZP_INS_TASDR", row);
			}
		
		} catch(SQLException se) {
			log.error("TaskService.PT01SaveEnd 적치 테이블 insert 저장 실패 - SQLException Error : " + se.getMessage());
			String errMsg = se.getMessage();
			String cutErrMsg = inboundService.getExceptionMsgCut(errMsg, errMsgLen);
			
			inRsCode = "E";
			inRsMsg = "적치 테이블 insert 저장 실패 : " + cutErrMsg;
			//se.printStackTrace();
		} catch(BadSqlGrammarException bse) {
			log.error("TaskService.PT01SaveEnd 적치 테이블 insert 저장 실패 - BadSqlGrammarException Error : " + bse.getMessage());
			inRsCode = "E";
			//bse.printStackTrace();
			
			try {
				SQLException se = bse.getSQLException();
				String errMsg = se.getMessage();
				String cutErrMsg = inboundService.getExceptionMsgCut(errMsg, errMsgLen);
				inRsMsg = "적치 테이블 insert 저장 실패 : " + cutErrMsg;
			}catch(Exception e) {
				String errMsg = bse.getMessage();
				String cutErrMsg = inboundService.getExceptionMsgCut(errMsg, errMsgLen);
				inRsMsg = "적치 테이블 insert 저장 실패 : " + cutErrMsg;
			}
		} catch(UncategorizedSQLException bse) {
			log.error("TaskService.PT01SaveEnd 적치 테이블 insert 저장 실패 - UncategorizedSQLException Error : " + bse.getMessage());
			inRsCode = "E";
			//bse.printStackTrace();
			
			try {
				SQLException se = bse.getSQLException();
				String errMsg = se.getMessage();
				String cutErrMsg = inboundService.getExceptionMsgCut(errMsg, errMsgLen);
				inRsMsg = "적치 테이블 insert 저장 실패 : " + cutErrMsg;
			}catch(Exception e) {
				String errMsg = bse.getMessage();
				String cutErrMsg = inboundService.getExceptionMsgCut(errMsg, errMsgLen);
				inRsMsg = "적치 테이블 insert 저장 실패 : " + cutErrMsg;
			}
		} catch(Exception e) {
			log.error("TaskService.PT01SaveEnd 적치 테이블 insert 저장 실패 - Exception Error : " + e.getMessage());
			String errMsg = e.getMessage();
			String cutErrMsg = inboundService.getExceptionMsgCut(errMsg, errMsgLen);
			inRsCode = "E";
			inRsMsg = "입고 테이블 insert 저장 실패 : " + cutErrMsg;
			e.printStackTrace();
		}
		
		// 에러 처리
		if("E".equals(inRsCode)) {
			
			// 인터페이스 에러 결과 메세지
			resultMsg = inRsMsg;
			
			transactionManager.rollback(transactionStatus);
			
			log.debug("TaskService.PT01SaveEnd 적치 테이블 저장 실패  - taskky : " + taskky + " - rollback");
			
			rsMap.put("count", count);
			rsMap.put("resultMsg", resultMsg);
			
			return rsMap;
			
		}
		
		log.debug("PT01SaveEnd.sjItemList.size() : " + sjItemList.size());
		
		// 저장위치 변경시 재고 저장위치변경 로직 실행
		if(sjItemList!=null && sjItemList.size()>0) {
			
			// docunum으로 대상 LIST 조회
			DataMap param = new DataMap();
			
			param = new DataMap();
			param.put("WAREKY", head.getString("WAREKY"));
			param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			param.put(CommonConfig.MENU_ID_KEY    , map.get(CommonConfig.MENU_ID_KEY));
			param.put("DOCUTY", "401"); // 401: 재고저장위치변경
			param.put("list", sjItemList);
			
			DataMap res = new DataMap();
			
			String SAPRES = "";
			
			try {
				res = inventoryService.saveAdjByTask(param);
			}catch (Exception e) {
				log.debug("TaskService.PT01SaveEnd.saveAdjByTask SAP 저장위치 변경 인터페이스 실패 - taskky : " + taskky + " - rollback");
				if(!transactionStatus.isCompleted()) {
					transactionManager.rollback(transactionStatus);
				}
				String errMsg = e.getMessage();
				SAPRES = "TaskService.PT01SaveEnd.saveAdjByTask SAP 저장위치 변경 인터페이스 실패" + inboundService.getExceptionMsgCut(errMsg, errMsgLen);
			}
			
			// 실적 SAP 인터페이스 전송
			String ifRsMsg = "";
			
			if("".equals(SAPRES)) {
				SAPRES = res.getString("SAPRES");
			}
			log.debug("Sap Response : " + SAPRES);
			
			String adjky = res.getString("SADJKY");
			log.debug("PT01SaveEnd.saveStock - SADJKY : " + adjky);
			
			if(!"SUCCESS".equals(SAPRES)) {
				
				if(!transactionStatus.isCompleted()) {
					transactionManager.rollback(transactionStatus);
				}
				
				resultMsg = "[" + taskky + "] 저장위치 변경 SAP 인터페이스 전송 에러 : " + SAPRES;
				
				log.debug("TaskService.PT01SaveEnd SAP 저장위치 변경 인터페이스 실패 - taskky : " + taskky + " - adjky : " + adjky + " - rollback");
				
				// 2022.07.14 WMS, SAP이 1개의 트랜잭션으로 구성된 경우 IFSAPLOG INSERT 추가
				res.put("ZDOCNO", adjky);
				res.put("ERRTXT", resultMsg);
				res.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
				res.put("PROGID", map.get(CommonConfig.MENU_ID_KEY));
				res.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
				res.setModuleCommand("WmsInventory", "IFSAPLOG");
				commonDao.insert(res);
				
			} else {
				
				if(!transactionStatus.isCompleted()) {
					transactionManager.commit(transactionStatus);
					log.debug("TaskService.PT01SaveEnd SAP 저장위치 변경 인터페이스 성공  - taskky : " + taskky + " - adjky : " + adjky + " - commit");
				}
				
				// 적치지시 아이템 데이터 대량 LOTA01 update
				inboundService.execBatchList("WmsTask.TASDIEND_LOTA01_BATCH", sjItemUpList);
				
				resultMsg = SAPRES;
				
			}
			
		}else {
		
			// 적치지시 아이템 데이터 대량 LOTA01 update
			inboundService.execBatchList("WmsTask.TASDIEND_LOTA01_BATCH", batchItemList);
			
			log.debug("TaskService.PT01SaveEnd SAP 저장위치 변경 인터페이스 X - sjItemList.size() : " + sjItemList.size() );
			
		}
		
		if(!transactionStatus.isCompleted()) {
			transactionManager.commit(transactionStatus);
			log.debug("TaskService.PT01SaveEnd - commit");
		}
		
		rsMap.put("count", count);
		rsMap.put("resultMsg", resultMsg);
		
		return rsMap;
	}
	
