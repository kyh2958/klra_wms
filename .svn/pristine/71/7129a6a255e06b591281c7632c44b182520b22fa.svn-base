													RFCTYPE = "MES";
													MSG = resultMap.getString("sendMsg");
								                
													rsMap.put("MSG", MSG);
													rsMap.put("MSG_TYPE", RFCTYPE);
													rsMap.put("MSG_DOC_NO", TASKKY);
																				                
													if(I_IFID.equals("WMS_IF_322")) {
														transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
	
														rsMap.put("ERRTXT", MSG);
														rsMap.put("ZDOCNO", TASKKY);
														rsMap.put("WAREKY", WAREKY);
														rsMap.put("PROGID", map.getString("menuId"));
														rsMap.put(CommonConfig.SES_USER_ID_KEY, USER);
	
														rsMap.setModuleCommand("WmsOutbound", "IFSAPLOG");
														commonDao.insert(rsMap);
														//transactionManager.commit(transactionStatus);	
													}
												}
											}
										
										} catch (Exception e) {
											transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
											rsMap.put("MSG", e);
											rsMap.put("ERRTXT", MSG);
											rsMap.put("ZDOCNO", TASKKY);
											rsMap.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
											rsMap.put("PROGID", map.getString("menuId"));
											rsMap.put(CommonConfig.SES_USER_ID_KEY, USER);
	
											rsMap.setModuleCommand("WmsOutbound", "IFSAPLOG");
											commonDao.insert(rsMap);
											transactionManager.commit(transactionStatus);
											return rsMap;
										}
									}
									 */
									transactionManager.commit(transactionStatus);	
								}
								
								count++;

							}//send for
					}
		 	  } else if("WMS_IF_310".equals(I_IFID)) {	//SAP 처리가 불필요한 경우
		 		  
		 		  // IF 실적(MES) 인터페이스 전송
		 		  String ifRsCode = "S";
		 		  String ifRsMsg = "";
				
		 		  try {
		 			  DataMap sendMap = new DataMap();
						
		 			  sendMap = ifidList.get(0);
						
		 			  sendMap.put("ownrky", I_OWNRKY);
		 			  sendMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						
		 			  ifRsMsg = iFService.sendIF(sendMap);
						
		 			  if( ifRsMsg==null || !ifRsMsg.equals("SUCCESS")) {
		 				  ifRsCode = "E";
		 				  ifRsMsg = " (MES) 인터페이스 전송 에러 : " + ifRsMsg;
		 			  }
						
		 			  log.debug(" (MES) 인터페이스 전송 - ifid : " + I_IFID + " - ifRsMsg : " + ifRsMsg );
					
		 		  } catch(Exception e) {
		 			  log.error(" (MES) 인터페이스 에러 - ifid : " + I_IFID + " - Exception Error : " + e.getMessage());
		 			  String errMsg = e.getMessage();
		 			  //String cutErrMsg = getExceptionMsgCut(errMsg, errMsgLen);
		 			  ifRsCode = "E";
		 			  ifRsMsg = "실적(MES) 인터페이스 전송 에러 : " + errMsg;
		 			  e.printStackTrace();
		 		  }
					
		 		  // 에러 처리
		 		  if("E".equals(ifRsCode)) {
		 			  // 인터페이스 에러 결과 메세지
		 			  rsMap.put("MSG", ifRsCode);
		 			  rsMap.put("ERRTXT", ifRsMsg);
						
		 			  transactionManager.rollback(transactionStatus);
						
		 			  break;
		 		  }
		 		  
		 		  transactionManager.commit(transactionStatus);
		 		  
		 	  } else {
		 		  transactionManager.commit(transactionStatus);	
		 	  }
		 	  // 실적 인터페이스 전송 목록
		 	  rsMap.put("ifidList",ifidList);				
		 	  rsMap.put("CNT", count);
				
			} catch (Exception e) {
				transactionStatus.rollbackToSavepoint(transactionSavepoint); // 롤백
				
				rsMap.put("MSG", e);
				rsMap.put("ERRTXT", MSG);
				rsMap.put("ZDOCNO", HeadTaskky);
