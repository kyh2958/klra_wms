				String errMsg = e.getMessage();
				String cutErrMsg = inboundService.getExceptionMsgCut(errMsg, errMsgLen);
				inRsCode = "E";
				inRsMsg = "입고 테이블 insert 저장 실패 : " + cutErrMsg;
				e.printStackTrace();
			}
			
			// 에러 처리
			if("E".equals(inRsCode)) {
				
				failCnt++;
			    // 인터페이스 에러 결과 메세지
				totInRsCode = inRsCode;
				totInRsSbMsg.append("\n");
				totInRsSbMsg.append(inRsMsg.toString());
				
				// 인터페이스 에러 결과 메세지
				//resultMsg = inRsMsg;
