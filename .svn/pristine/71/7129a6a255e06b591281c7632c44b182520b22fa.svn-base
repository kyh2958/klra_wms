			if(headList.size()-1 == k) {
				
				DataMap ifMap = new DataMap();
				List<DataMap> stknumInfoList = null;
				
				map.put("STATUS", "C");
				map.put("SHPOKY", rsMap.get("SHPOKY"));
				map.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
				map.setModuleCommand("WmsOutbound", "SHPDI_STKNUM_INFO");
				
				stknumInfoList = commonDao.getList(map);
				
				if(stknumInfoList.size() > 0) {
				
				ifMap.put("list", stknumInfoList);
				ifMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));

					try {			
						
						
						String resultMsg = iFService.send_TK_CONTROL(ifMap);
						
						if(!"SUCCESS".equals(resultMsg)){
							rsMap.put("MSG", "SAP : " + resultMsg);
						
						}else {
							rsMap.put("MSG", resultMsg);
						}
									
					}catch (Exception e) {
						throw new SQLException(e.getMessage());
					}
				}
			}
		}
		
		rsMap.put("CNT", count);
		return rsMap;
	}
	
	@Transactional
	public int savePrtseq(DataMap map) throws SQLException {
		List<DataMap> list = map.getList("head");
		int count = 0;
		
		DataMap row;
		for(int i=0;i<list.size();i++){
		    row = list.get(i).getMap("map");
			row.setModuleCommand("WmsTask", "PRTLGPUTA");		
			row.put("PRTSEQ", map.get("PRTSEQ"));	
			
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			row.put(CommonConfig.SES_USER_OWNER_KEY, map.get(CommonConfig.SES_USER_OWNER_KEY));
			commonDao.insert(row);
			
			count ++;
		}
		
		return count;
	}
	
	@Transactional
	public DataMap saveTK32(DataMap map) throws SQLException {
		DataMap head = map.getMap("head").getMap("map");
		List<DataMap> list = map.getList("list");
		String seq = wmsService.getNumSeq("NR03");
		
		DataMap rsMap = new DataMap();
		
		String mnuid = map.getString("PROGID");
		if(mnuid.equals("TK31") || mnuid.equals("TK32") || mnuid.equals("TK33") || mnuid.equals("TK34") || mnuid.equals("TK35")){
			head.put("TSPKEY", head.get("AREAKY")); //창간이동/기타출고/폐기출고/공급사 반품출고 일 경우 TSPKEY 컬럼에 From 창고 매핑 
			
			if(mnuid.equals("TK34")){
				head.put("PTNRTY", "VD");
			}else {
				head.put("PTNRTY", "CT");
			}
						
		}
		
		//새로운 taskky 번호 채번
		head.setModuleCommand("WmsTask", "TASDH");
		head.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		head.put("TASKKY", seq);
		head.put("WARETG", head.get("WAREKY"));
		head.put("TASOTY", head.get("DOCUTY"));
		head.put("PTNRKY", head.get("DPTNKY"));				
		head.put("PTNRNM", head.get("DPTNKYNM"));
		
		commonDao.insert(head);
		
		int count = 1;
		int itemCount = 0;
		DataMap row;
		String snum;
		String inum;
		
		for(int i=0;i<list.size();i++){
			row = list.get(i).getMap("map");
			row.setModuleCommand("WmsTask", "TASDI");
			row.put("TASKKY", seq);			
			row.put("STATIT", "FPC");
			
			if(mnuid.equals("TK35")) { 
				row.put("TASKTY", "361"); //폐기출고
			}else if(mnuid.equals("TK36")){
				row.put("TASKTY", "356"); //생산직불출 출고
			}else {
				row.put("TASKTY", "SH");  //재고조정출고
			}
			
			itemCount += 10;
			snum = String.valueOf(itemCount);
			inum = String.valueOf("000000").substring(0,(6-snum.length()))+snum;
			
			row.put("TASKIT", inum);
			row.put("LOCASR", row.get("LOCASR"));
			row.put("LOCAAC", row.get("LOCASR"));
			row.put("QTCOMP", row.getString("QTTAOR"));
			row.put("TASRSN", row.getString("RSNTXT"));					
			
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			commonDao.insert(row);

			row.put("STOKKY", "%");
			row.setModuleCommand("WmsOutbound", "TK32TASDR_PROCALL");
			commonDao.getMap(row);
			
			count ++;
		}
		
		rsMap.put("TASKKY", seq);
		
		return rsMap;
	}
	
