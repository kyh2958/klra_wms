				for(int i=0;i<batchItemList.size();i++){
					batchItemMap = batchItemList.get(i);				
					row = new DataMap();
					row.putAll(batchItemMap);
					// tasdr 프로시져에서 처리
					commonDao.getMap("WmsTask.DBMSPROC_SZP_INS_TASDR", row);
				}
			
			} catch(SQLException se) {
