	@Transactional
	public String PTLocaacCheck(DataMap map) throws SQLException {
		String result = "OK";
		int	   sqlLimit = 500;
		int	   sqlCount = 1;
		int	   sqlTotCount = 1;
		
		List<DataMap> itemList = new ArrayList<DataMap>();
		DataMap sqlMap = new DataMap(); 
		
		List<DataMap> head = map.getList("head");
		List<DataMap> list = map.getList("list");
		String headTaskky  = map.getString("headTaskky");
		
		StringBuffer sb = new StringBuffer();

		for(DataMap headItem : head){
		
			itemList = new ArrayList<DataMap>();
			sb = new StringBuffer();
			sqlCount = 1;
			sqlTotCount = 1;
			
			String hOwnrky = headItem.getMap("map").getString("OWNRKY");
			String hWareky = headItem.getMap("map").getString("WAREKY");
			String hTaskky = headItem.getMap("map").getString("TASKKY");
			
			if(headTaskky.equals(hTaskky)) {
				itemList = list;
			} else {
				sqlMap = new DataMap(); 
				sqlMap.put("OWNRKY", hOwnrky);
				sqlMap.put("WAREKY", hWareky);
				sqlMap.put("TASKKY", hTaskky);
				sqlMap.setModuleCommand("WmsTask", "PT02");
				itemList = commonDao.getList(sqlMap);
			}
			
			for(DataMap listItem : itemList){
				
				if(sb.length() > 0) {
					sb.append(" UNION ALL\n ");
				}
				
				sb.append(" SELECT '").append(listItem.getMap("map").get("WAREKY")).append("' AS WAREKY, ");
				sb.append("        '").append(listItem.getMap("map").get("TASKKY")).append("' AS TASKKY, ");
				sb.append("        '").append(listItem.getMap("map").get("TASKIT")).append("' AS TASKIT, ");
				sb.append("        '").append(listItem.getMap("map").get("LOCAAC")).append("' AS LOCAAC, ");
				sb.append("        '").append(listItem.getMap("map").get("LOTA02")).append("' AS LOTA02, ");
				sb.append("        '").append(listItem.getMap("map").get("PLNTKY")).append("' AS PLNTKY, ");
				sb.append("        '").append(listItem.getMap("map").get("LOTA07")).append("' AS LOTA07, ");
				sb.append("        '").append(listItem.getMap("map").get("SKUKEY")).append("' AS SKUKEY ");
				sb.append(" FROM DUAL ");
				
				if ( sqlCount == sqlLimit || sqlTotCount == itemList.size() ){
					map.setModuleCommand("WmsTask", "PT01CONF_MASTER");  
					map.put("APPEND_QUERY", sb.toString());
				
					List<DataMap> validList = commonDao.getValidation(map);
					if(validList.size() > 0){
						DataMap valid = validList.get(0);
						return valid.getString("RESULTMSG");
					}
					sqlCount = 0;
					sb.setLength(0); ;
				}
				
				sqlCount++;
				sqlTotCount++;
				
			}
		
		}
		
		return result;
	}
	
	
