										rsMap.setModuleCommand("WmsOutbound", "IFSAPLOG");
										commonDao.insert(rsMap);
										transactionManager.commit(transactionStatus);
										return rsMap;
									}
									
									/*
									
									// 실적 인터페이스 저장 231213 주석처리(위에서 이미 생성한 ifid MES용)
									outboundService.dataInsertIF(map, rcpttyList, rcpttyMap, ifidList2, true);
								
									if(null!=ifidList2 && ifidList2.size()>0) {
										// 인터페이스 전송
										try {
											DataMap resultMap;
						 				
											for(DataMap item2 : ifidList2) {
											
												if("SAP".equals(item2.get("RFCTYPE")))
													continue;
											
												item2.put("ownrky", map.getString("OWNRKY"));
												item2.put("IFID", item2.getString("IFID"));
												item2.put(CommonConfig.SES_USER_ID_KEY, USER);
												resultMap = outboundService.sendIf(item2);
											
											
												if(!"S".equals(resultMap.getString("sendMsg")) && !"SUCCESS".equals(resultMap.getString("sendMsg"))){
