	public static boolean isNull(String value) {
		return (value == null);
	}
	
	public static boolean isEmpty(String value) {
		return (isNull(value) || value.trim().length() == 0);
	}
	
	public static boolean isNotEmpty(String value) {
		return isEmpty(value) ? false : true;
	}
	/**
	 * 적치 완료
	 * @param request
	 * @param model
	 * @return
	 * @throws SQLException
	 */
	@Transactional
	public DataMap PT01ValueCheck(DataMap map) throws SQLException {
		
		DataMap resultMap = new DataMap();
		
		List<String> cropList = new ArrayList();
		
		String rsCode = "S"; // S:성공, F:실패, C:확인
		String rsMsg = "";  // 결과 메세지
		String stokky = ""; // 해당 데이터 제고키
		String grRowNum = "";
		String focusField = "";
		String msgField = "";
		
		List<DataMap> list = map.getList("list");
		
		//DataMap row;
		//String VALIDATION_SQL = "";
		//int addCnt = 1;
		
		int loopCnt=0;
		
		//String validationSql = "";
		String key = map.get("key").toString();
		
		if(map.containsKey("key")){
			
			//validationSql = util.urlCreateValidationSql(map, key);
			cropList = urlCreateValidationSqlCrop(map, key, 500);
			
			for(String validationSql : cropList) {
			
				map.put(CommonConfig.VALIDATION_SQL_KEY, validationSql);
				map.setModuleCommand("WmsTask", "TASDI");
				List<DataMap> vList = commonDao.getValidation(map);
				
				log.debug(loopCnt + " - PT01ValueCheck loop");
				
				DataMap rsMap = new DataMap();
				
				for(int i = 0; i < vList.size(); i++){
					rsMap = vList.get(i);
					
					String GRowNum = "-1";
					if(isNotEmpty(rsMap.getString("GROWNUM"))){
						GRowNum = rsMap.getString("GROWNUM");
					}
					
					// skuwc 검사
					if(isEmpty(rsMap.getString("SKUWC_SKUKEY"))){
						rsCode = "F";
						grRowNum = GRowNum;
						focusField = "SKUKEY";
						rsMsg = "MASTER_M0569";										//*상품코드는 등록되지 않은 코드입니다.
						break;
					}
					
					// Putaway strategy key, Location 
					if(isEmpty(rsMap.getString("SKUWC_SKUKEY")) && isEmpty(rsMap.getString("LOCATG"))){
						rsCode = "F";
						grRowNum = GRowNum;
						focusField = "PASTKY";
						rsMsg = "TASK_M0016";										//* 적치전략이 등록되지 않았습니다. 상품마스터를 확인해주세요.
						break;
					}
					
					// Target location검사
					if(isNotEmpty(rsMap.getString("LOCATG")) && isEmpty(rsMap.getString("LOCAKY"))){
						rsCode = "F";
						grRowNum = GRowNum;
						focusField = "LOCATG";
						msgField = "LOCATG";
						rsMsg = "TASK_M0011";										//** 이동대상 로케이션 {0} 이 유효하지 않습니다.
						break;
					}
					
					if(rsMap.getString("LOCATG").equals("SCRLOC") || rsMap.getString("LOCATG").equals("SETLOC") || rsMap.getString("LOCATG").equals("RTNLOC") || rsMap.getString("LOCATG").equals("RTSLOC")){
						rsCode = "F";
						grRowNum = GRowNum;
						focusField = "LOCATG";
						rsMsg = "TASK_M0037";										//*폐기창, 세트창, 반품창, 반품해체창으로 이동할 수 없습니다.
						break;
					}
					
					// 자동창고 여부 검사
					if ("V".equals(rsMap.getString("AUTLOC"))) {
						rsCode = "F";
						grRowNum = GRowNum;
						focusField = "LOCATG";
						rsMsg = "TASK_M0024";                                        // * 자동창고 적치장소로는 이동이 불가능합니다.
						break;
					}
					
					// Putaway strategy key
					if(isNotEmpty(rsMap.getString("PASTKY")) && isEmpty(rsMap.getString("PASTH_PASTKY"))){
						rsCode = "F";
						grRowNum = GRowNum;
						focusField = "PASTKY";
						msgField = "PASTKY";
						rsMsg = "TASK_M0017";                                        // * 전략코드 {0} 이 유효하지 않습니다.
						break;
					}
					
					// 로케이션 상태 정상 유무 확인
					if(isEmpty(rsMap.getString("LOC_STATUS")) || !"00".equals(rsMap.getString("LOC_STATUS"))){
						rsCode = "F";
						grRowNum = GRowNum;
						focusField = "LOCATG";
						msgField = "LOCATG";
						rsMsg = "TASK_M0011"; // * 이동대상 로케이션 {0} 이 유효하지 않습니다.
						break;
					}
					
					// 동일 플랜트 지번인지 확인
					// 20220921 P200과 P300 묶어서 처리 되게 동시에 보이게 설정 요청.
					String lota02 = rsMap.getString("LOTA02");
					if("P200".equals(lota02)||"P300".equals(lota02)) {
						if(isNotEmpty(rsMap.getString("PLNTKY")) && !lota02.equals("P200") && !lota02.equals("P300") ){
							rsCode = "F";
							grRowNum = GRowNum;
							focusField = "LOCATG";
							rsMsg = "TASK_M0701"; // 동일한 플랜트 내 지번만 변경 가능합니다.
							break;
						}
					}else {
						if(isNotEmpty(rsMap.getString("PLNTKY")) && !rsMap.getString("PLNTKY").equals(rsMap.getString("LOTA02")) ){
							rsCode = "F";
							grRowNum = GRowNum;
							focusField = "LOCATG";
							rsMsg = "TASK_M0701"; // 동일한 플랜트 내 지번만 변경 가능합니다.
							break;
						}
					}
					
					// 동일 플랜트 지번인지 확인
					if(isNotEmpty(rsMap.getString("STK_STATUS")) && (!rsMap.getString("STK_STATUS").equals("00")&&!rsMap.getString("STK_STATUS").equals("05"))){
						rsCode = "C";
						stokky = rsMap.getString("STOKKY");
						grRowNum = GRowNum;
						focusField = "LOTA06";
						rsMsg = "TASK_M0704"; // 품목의 재고상태가 불용상태 입니다. 계속 진행하시겠습니까?
						break;
					}
					
				}
				
				if(!"".equals(rsMsg)) {
					break;
				}
				
				loopCnt++;
			}
		}
		
		resultMap.put("rsCode",rsCode);
		resultMap.put("rsMsg",rsMsg);
		resultMap.put("stokky",stokky);
		resultMap.put("grRowNum",grRowNum);
		resultMap.put("focusField",focusField);
		resultMap.put("msgField",msgField);
		
		return resultMap;
	}
	
	public List<String> urlCreateValidationSqlCrop(DataMap map, String key, int valLimitCnt){
		
		List<String> cropList = new ArrayList();
		
		List<DataMap> list = map.getList("list");
		
		if(valLimitCnt==0)valLimitCnt = 300;
		
		DataMap row;
		StringBuilder validationSql = new StringBuilder();
		
		if(map.containsKey("key")){
			
			String[] valCols = map.getString("key").split(",");
			
			for(int i=0;i<list.size();i++){
				
				row = list.get(i).getMap("map");
				
				if(!"".equals(validationSql.toString())) {
					validationSql.append("UNION ALL \n");
				}
				
				validationSql.append("SELECT \n");
				
				for(int j=0;j<valCols.length;j++){
					if(j != 0){
						validationSql.append(" ,");
					}
					validationSql.append(" '").append(row.getString(valCols[j])).append("' AS ").append(valCols[j]);
					
					validationSql.append(" \n");
				}
				
				//if( !"mssql".equals(util.getSqlType()) ){
					validationSql.append("FROM DUAL \n");	
				//}
				
				if( ( i!=0 && (i%valLimitCnt)==0 ) || (i+1)==list.size() ) {
					cropList.add(validationSql.toString());
					validationSql = new StringBuilder();
				}
				
			}
		}
		
		return cropList;
	}
	
	
	@Transactional
	public String PT01StockCheck(DataMap map) throws SQLException {
		String result = "OK";
		int	   sqlLimit = 300;
		int	   sqlCount = 1;
		int	   sqlTotCount = 1;
		
		List<DataMap> list = map.getList("valList");
		
		StringBuffer sb = new StringBuffer(); 

		for(DataMap item : list){
			if(sb.length() > 0)
			sb.append(" UNION ALL\n ");
			
			sb.append(" SELECT '").append(item.getMap("map").getString("WAREKY")).append("' AS WAREKY, ");
			sb.append("        '").append(item.getMap("map").getString("LOTNUM")).append("' AS LOTNUM, ");
			sb.append("        '").append(item.getMap("map").getString("LOCASR")).append("' AS LOCASR, ");
			sb.append("        '").append(item.getMap("map").getString("TRNUSR")).append("' AS TRNUSR, ");
			sb.append("        '").append(item.getMap("map").getString("STOKKY")).append("' AS STOKKY, ");
			sb.append("        '").append(item.getMap("map").getString("QTTAOR")).append("' AS QTTAOR ");	
			
			sb.append(" FROM DUAL ");
			
			if ( sqlCount == sqlLimit || sqlTotCount == list.size() ){
				map.setModuleCommand("WmsTask", "TASDI_STOCK");  
				map.put("APPEND_QUERY", sb.toString());
			
				List<DataMap> validList = commonDao.getValidation(map);
				if(validList.size() > 0){
					DataMap valid = validList.get(0);
					return valid.getString("RESULTMSG");
				}
				sqlCount = 0;
				sb.setLength(0); ;
			}
			sqlCount++;
			sqlTotCount++;
		}	
		return result;
	}
	
		
