				transactionManager.commit(transactionStatus);
				return rsMap;
			}
		 } // list for
		return rsMap;
	}
	
	public static String leftPad(String stringToPad, String padder, int size) {
		StringBuffer strb;
		StringCharacterIterator sci;

		if (padder.length() == 0)
			return stringToPad;

		if (isNull(stringToPad)) {
			char[] t = new char[size];
			for (int i = 0; i < t.length; i++)
				t[i] = padder.charAt(0);

			stringToPad = String.valueOf(t);
		}

		strb = new StringBuffer(size);
		sci = new StringCharacterIterator(padder);

		while (strb.length() < (size - stringToPad.length()))
			for (char ch = sci.first(); ch != CharacterIterator.DONE; ch = sci.next())
				if (strb.length() < size - stringToPad.length())
					strb.insert(strb.length(), String.valueOf(ch));
		return strb.append(stringToPad).toString();
	}
	
	/**
	* @methodName   ConvertStknumToStkunm
	* @param map 출하오더번호
	* @return List<DataMap> 선적번호
	* @throws Exception
	* @description  선적번호(STKNUM)로 출하오더번호(SHPOKY) 조회
	* @history
	* __DATE_______AUTHOR__NOTE__________________________________<br>
	* * 2023.08.23 HJ.jang 최초생성<br>
	* * 2023.10.06 KYH DL081 납품처코드 추가<br>
	*/
	@Transactional
	public List<DataMap> ConvertStknumToShpokyDL061(DataMap map) throws Exception {

		try {
			map.setModuleCommand("WmsTask", "DL061_CONVERT_STKNUM_TO_SHPOKY"); // STKNUM 로 SHPOKY 조회
			List<DataMap> shpokyList = commonDao.getList(map);

			return shpokyList;
		} catch (Exception e) {
			log.error("ERROR ConvertStknumToShpokyDL061 : {}", e);
			throw new SQLException(e.getMessage());
		}
	}
	
	/**
	 * 피킹 완료 (선적단위)
	 * @param request
	 * @param model
	 * @return
	 * @throws SQLException
	 */
	@Transactional
	public DataMap DL061SaveEnd(DataMap map) throws Exception {
		List<DataMap> headList = map.getList("head");
		List<DataMap> itemList = map.getList("list");
		List<DataMap> saveItemList = new ArrayList<DataMap>();
		List shpokyList = new ArrayList();
		
		DataMap HeadRowMap = new DataMap();
		DataMap rsRowMap = new DataMap();
		DataMap rsMap = new DataMap();
		DataMap rqMap = new DataMap();
		
		///String taskkyHead;
		///String taskkyGrid = itemList.get(0).getMap("map").getString("TASKKY");
		
		String stknumHead;
		String stknumGrid = itemList.get(0).getMap("map").getString("STKNUM");

		String WAREKY = map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY);

		int count = 1;
		int itemCount = 0;
		double qtcomp = 0;
		DataMap row;
		DataMap rowTot = new DataMap();

		//SHPDH, SHPDI I/F CHECK 
		for (int j = 0; j < headList.size(); j++) {

			// [시작] 마스터 출고오더번호,출하문서번호 기준을 -> 선적번호 기준으로 변경
			DataMap dmStknum = new DataMap();

			///DataMap rowMap = new DataMap(); // 선택 된 마스터 선적 리스트
			List<DataMap> listMapShpoky = new ArrayList<>();
			StringJoiner sjStknum = new StringJoiner("','", "'", "'");

			rsRowMap = headList.get(j).getMap("map");

			// 선적번호 여러개로 출고오더번호 전체 조회
			sjStknum = sjStknum.add(rsRowMap.getString("STKNUM"));
			String stknumList = sjStknum.toString();

			dmStknum.put("WAREKY", WAREKY);
			dmStknum.put("LOTA02", map.get("SI.LOTA02"));
			dmStknum.put("STAT01", 'V'); // 미작업(NEW) 조회조건 적용
			dmStknum.put("STAT02", 'V'); // 부분피킹(PPC) 조회조건 적용
			dmStknum.put("STKNUM", stknumList);
			listMapShpoky.addAll(ConvertStknumToShpokyDL061(dmStknum));
			// [종료] 마스터 출고오더번호,출하문서번호 기준을 -> 선적번호 기준으로 변경

			for (DataMap shpokyRow : listMapShpoky) {
				String shpoky = shpokyRow.getString("SHPOKY");

				//SHPDH CHECK
				rsMap.setModuleCommand("WmsTask", "VALIDATION_SHPDH");
				rsMap.put("SHPOKY", shpoky);
				rqMap = commonDao.getMap(rsMap);

				if (rqMap != null && !rqMap.getString("SHPOKY").equals(" ")) {
					rsMap.put("SHPOKY", rqMap.getString("SHPOKY"));
					return rsMap;
				}
				
				// SHPDI CHECK
				rsMap.setModuleCommand("WmsTask", "VALIDATION_SHPDI_FPC");
				rsMap.put("SHPOKY", shpoky);
				rqMap = commonDao.getMap(rsMap);

				if (rqMap != null && !rqMap.getString("SHPOKY").equals(" ")) {
					rsMap.put("SHPOKY", rqMap.getString("SHPOKY"));
					return rsMap;
				}
				
				shpokyList.add(shpoky);
			}
		}
		
		// 900개 이상 처리 차단 || 피킹 대상없음 (db값 변경됨)
		if (shpokyList.size() > 900 || shpokyList.size() <1) {
			rsMap.put("SHPOKY", null);
			rsMap.put("SHPOKYCOUNT", shpokyList.size());
			return rsMap;
		}

		// KYH 작업지시단위 > 선적단위 처리 변경 
		for(int k=0;k<headList.size();k++){
			//String shpokyNum = headList.get(k).getMap("map").getString("SHPOKY");
			//shpokyList.add(shpokyNum);
			
			HeadRowMap = headList.get(k).getMap("map");
			///taskkyHead = HeadRowMap.getString("TASKKY");
			stknumHead = HeadRowMap.getString("STKNUM");
			saveItemList.clear();
			rowTot.put("STKNUM", stknumHead);
			rowTot.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));					
			
			/*
			// 20241111 KYH DB조회된 값으로 피킹처리 되도록 수정 
			if (stknumGrid.equals(stknumHead)){
				saveItemList = map.getList("list");
			}else {
				// KYH DL061_SAVE 조건 생성 (선적번호 기준 목록조회)
				HeadRowMap.setModuleCommand("WmsTask", "DL061_SAVE");
				System.out.println("HeadRowMap DL061_SAVE 확인");
				System.out.println(HeadRowMap.toString());
				saveItemList = commonDao.getList(HeadRowMap);
			}
			*/
			
			// KYH DL061_SAVE 조건 생성 (선적번호 기준 목록조회)
			HeadRowMap.setModuleCommand("WmsTask", "DL061_SAVE");
			saveItemList = commonDao.getList(HeadRowMap);
			
