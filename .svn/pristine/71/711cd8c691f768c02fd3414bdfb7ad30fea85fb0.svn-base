                                        <td GH="40" GCol="rownum">번호</td>
                                        <td GH='140 STD_SKUKEY' GCol="text,SKUKEY"></td>
                                        <td GH='230 STD_DESC01' GCol="text,DESC01"></td>                                        
                                        <td GH='100 STD_QTSIWH' GCol="text,QTSIWH" GF="N 20,3"></td>
                                        <td GH='100 STD_USEQTY' GCol="text,USEQTY" GF="N 20,3"></td>
                                        <td GH='100' GCol="text,QTYORG" GF="N 20,3"></td>
                                        <td GH='60 STD_UOMKEY' GCol="text,UOMKEY"></td>
