                            <input type="text" class="input" name="H.USRID1" UIInput="SR"/>
                        </dd>
                    </dl>
                    <dl>
                        <dt CL="STD_DEPTID5">사업장ID</dt>
                        <dd>
                            <select type="text" class="input" Combo="Wms,DEPTID" name="H.DEPTID1" id="DEPTID" ComboType="MS">
                            </select>
