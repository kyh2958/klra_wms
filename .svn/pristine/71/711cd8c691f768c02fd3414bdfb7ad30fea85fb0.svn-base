                    <dl>
                    	<dt></dt>
						<dd style="width: 170px;">
						    <input type="checkbox" class="input" id="LACKQTY" name="LACKQTY" value="V" checked="checked"/>
							<label CL="STD_LACKQTY" for="LACKQTY">부족분</label>
							<input type="checkbox" class="input" id="UACKQTY" name="UACKQTY" value="V"/>
							<label CL="STD_UACKQTY" for="UACKQTY">가용분</label>
						</dd>							
					</dl>					
