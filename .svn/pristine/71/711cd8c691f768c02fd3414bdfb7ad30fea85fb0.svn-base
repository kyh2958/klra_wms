<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Grid default</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<link rel="stylesheet" type="text/css" href="/common/theme/webdek/css/demo_layout.css">
<style>
input[type="checkbox"] {
	height: unset;
}
</style>
<script type="text/javascript">
	var searchFlag = 1;
	var tabPage = 1;
	var paramH = new DataMap();
	
	$(document).ready(function(){
	    //setTopSize(300);
		
	    gridList.setGrid({
	        id : "gridList", 
	        module : "WmsOutbound",
	        command : "DL12",
	        itemGrid : "gridListSub",
	        itemSearch : true
	    });
	
	    gridList.setGrid({
	        id : "gridListSub",
	        module : "WmsOutbound",
	        command : "DL12Sub"
	    });
	
	    gridList.setGrid({
	        id : "gridListDpt",
	        module : "WmsOutbound",
	        command : "DL12DPT",
	        itemGrid : "gridListDptSub",
	        itemSearch : true
	    });
	
	    gridList.setGrid({
	        id : "gridListDptSub",
	        module : "WmsOutbound",
	        command : "DL12DPTSub"
	    });
	
	  <%if(plant.equals("")){%>
        $('select[name="I.LOTA02"]').multipleSelect('checkAll');
      <%}else{%>
        $('select[name="I.LOTA02"]').multipleSelect('setSelects', ['<%=plant%>']);
      <%}%>
	    
	    $("#sub2").hide();
	});
	
	function commonBtnClick(btnName){
	    if(btnName == "Search"){
	        searchList();
	    }else if(btnName == "Save"){
			saveData();
		}
	}
	
	function searchList(){
	    searchFlag = 1;	    
	    
	    gridList.resetGrid("gridList");
	    gridList.resetGrid("gridListSub");      
	    gridList.resetGrid("gridListDpt");
	    gridList.resetGrid("gridListDptSub");
	    
	    if(tabPage == 1) {
	        tabChg(1);	        	        
		    	        
	        gridList.setReadOnly("gridList", false);
	        gridList.setReadOnly("gridListSub", false);
	    } else if(tabPage == 2) {
	        tabChg(2);	        	   	        	        		    	       
	        
	        gridList.setReadOnly("gridListDpt", false);
	        gridList.setReadOnly("gridListDptSub", false);
	    }
	}
	
	function gridListEventItemGridSearch(gridId, rowNum, itemGridList){		
		
		var list = gridList.getGridData(gridId);
		
		if(tabPage == 1 && itemGridList =="gridListSub" && list.length > 0) {
	        if(gridId == "gridList" && searchFlag == 1){
	            
	        	var param = getItemSearchParam(rowNum);
		        
	            gridList.gridList({
	                id : "gridListSub",
	                param : param
	            });
	            
	        }
	    } else if(tabPage == 2 && itemGridList =="gridListDptSub" && list.length > 0) {
	        if(gridId == "gridListDpt" && searchFlag == 1){
	        	
	        	var param = getItemSearchParam(rowNum);
	            
	            gridList.gridList({
	                id : "gridListDptSub",
	                param : param
	            });
	            
	        }
	    }	    
	}
	
	function getItemSearchParam(rowNum){
	    if(tabPage == 1) {
	        var rowData = gridList.getRowData("gridList", rowNum);
	        var param = inputList.setRangeParam("searchArea");
	        param.putAll(rowData);
	        
	        return param;
	    } else if(tabPage == 2) {
	        var rowData = gridList.getRowData("gridListDpt", rowNum);
	        var param = inputList.setRangeParam("searchArea");
	        param.putAll(rowData);
	        
	        return param;
	    }
	}
	
	function gridExcelDownloadEventBefore(gridId){
	    if(gridId == "gridList"){
	        var param = inputList.setRangeParam("searchArea");
	        return param;
	    }else if(gridId == "gridListSub"){
	        var rowNum = gridList.getSearchRowNum("gridList");
	        if(rowNum == -1){
	            return false;
	        }else{
	            var param = getItemSearchParam(rowNum);
	            return param;
	        }
	    }
	}
	
	function comboEventDataBindeBefore(comboAtt){
	    if(comboAtt == "Wms,PLNTKYCOMBO"){
	        var param = new DataMap();
	        param.put("WAREKYS", "'<%= wareky%>'");
	        param.put("OWNRKY", "<%=ownrky%>");
	        param.put("LANGKY", "<%=langky%>");
	        
	        return param;
	    }else if(comboAtt == "Wms,DEPTID"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,VTXTK"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,KVGR"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}
	}
	
	function tabChg(num){
	    tabPage = num;
	    
	     if(num == 1) {
	        $("#sub1").show();
	        $("#sub2").hide();
	    } else {
	        $("#sub1").hide();
	        $("#sub2").show();
	    } 
	     	     	      		   
		    
	     if(tabPage == 1) {
	    	 	    	 
		        if(validate.check("searchArea")){
		            var param = inputList.setRangeParam("searchArea");
		            
		            gridList.gridList({
		                id : "gridList",
		                url : "/wms/outbound/json/DL12.data",
		                param : param
		            });
		        }
		        
		        gridList.setReadOnly("gridList", false);
		        gridList.setReadOnly("gridListSub", false);
		    } else if(tabPage == 2) {			   		    	
			    
		        if(validate.check("searchArea")){
		            var param = inputList.setRangeParam("searchArea");
		            
		            gridList.gridList({
		                id : "gridListDpt",
		                url : "/wms/outbound/json/DL12DPT.data",
		                param : param
		            });
		        }
		        
		        gridList.setReadOnly("gridListDpt", false);
		        gridList.setReadOnly("gridListDptSub", false);
		    }
	}
	
	
function saveData(){	
	
	if(gridList.validationCheck("gridList", "data") && gridList.validationCheck("gridListSub", "data")){
		// 처리할 데이터 체크
		var gridListItem;
		var gridListSubItem;
		
		if(tabPage == 1) {
			gridListItem="gridList"
			gridListSubItem="gridListSub"
		
		}else if(tabPage == 2){
			gridListItem="gridListDpt"
			gridListSubItem="gridListDptSub"
		}
		
		var head = gridList.getGridData(gridListItem);
		var list = gridList.getGridData(gridListSubItem);
		
		if(list.length < 1) {
			commonUtil.msgBox("VALID_M0006");// 선택된 데이터가 없습니다.
			return;
		}
			
			//저장하시겠습니까?
			if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){
				return;
			}
			

			var rowData;
			for(var i=0;i<list.length;i++){
				rowData = list[i];

				var QTYORG = new Number(rowData.get("QTYORG")); //오더수량
				var QTSHPO = new Number(rowData.get("QTSHPO")); //출고지시수량
				if((QTYORG - QTSHPO) < 0){
					commonUtil.msgBox("OUT_M0186");		//출고지시수량은 오더수량보다 클 수 없습니다.
					var rowNum = rowData.get("GRowNum");
					gridList.setColFocus(gridListSubItem, rowNum, "QTSHPO");
					return;
				}
			}

			var param = new DataMap();
			param.put("list", list);
			
			var json = netUtil.sendData({
				url : "/wms/outbound/json/saveDL12Sub.data",
				param : param
			});
			
			if(/*json.data.length > 5 && json.data.length != 10*/ json.data.RESULTMSG ){
				var msgList = json.data.split("†");
				var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
				commonUtil.msg(msgTxt);
				return;
			}
			
			if(json && json.data){
								
				commonUtil.msgBox("MASTER_M0564");
				gridList.resetGrid(gridListItem);
				gridList.resetGrid(gridListSubItem);
				searchList();
			}		
		}
	}
	
	
function searchHelpEventOpenBefore(searchCode, gridType, $inputObj){
    var param = new DataMap();
    
    if(searchCode == "SHSTLMAP"){
    	
    	var PLNTKY = $('select[name="I.LOTA02"]').val();
		
		if(!PLNTKY) {
			var label = commonLabel.getLabel("STD_LOTA02", 1);
			commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
			return false;
		}
		param.put("PLNTKY", PLNTKY);
    	
    	return param;
    }else if(searchCode == "SHBZPTN"){
		param.put("PTNRTY", "CT");
		param.put("OWNRKY", "<%=ownrky%>");			
		return param;
	} 
}

	/* function gridListEventRowClick(gridId, rowNum, colName){
	    if(gridId == "gridList" || gridId == "gridListDpt"){
	    	
	    	if(gridList.validationCheck(gridId+"Sub", "modify")){
	    		
				var param = getItemSearchParam(rowNum);
					        
					        gridList.gridList({
					            id : "gridListSub",
					            param : param
				});
	    	}
	    }
	    
	} */
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
    <div class="content_inner">
        <%@ include file="/common/include/webdek/title.jsp" %>
        <div class="content_serch" id="searchArea">
            <div class="btn_wrap">
                <div class="fl_l">
                </div>
                <div class="fl_r">
                    <input type="button" CB="Search SEARCH BTN_SEARCH" />
                    <input type="button" CB="Save SAVE BTN_SAVE" />
                </div>
            </div>
            <div class="search_inner">
                <div class="search_wrap ">
                    <input type="hidden" class="input" name="OWNRKY" value="<%=ownrky %>" />
                    <dl>
                        <dt CL="STD_WAREKY">거점</dt>
                        <dd>
                            <input type="text" class="input" name="WAREKY" name="WAREKY"  value="<%=wareky%>" readonly="readonly" validate="required" />
                        </dd>
                    </dl>
                    <dl>
                        <dt CL="STD_LOTA02">플랜트</dt>
                        <dd>
                            <select type="text" class="input" Combo="Wms,PLNTKYCOMBO" name="I.LOTA02" id="PLNTKY" ComboType="MS" style="width: 160px;" validate="required">
                            </select>
                        </dd>
                    </dl>
                    <dl>
                        <dt CL="STD_LOTA01">저장위치</dt>
                        <dd>
                            <input type="text" class="input" name="I.LOTA01" UIInput="R,SHSTLMAP" />
                        </dd>
                    </dl>
                    <dl>
                        <dt CL="STD_RQSHPD">출고예정일자</dt>
                        <dd>
                            <input type="text" class="input" name="H.RQSHPD" UIInput="R" UIFormat="C -7 7" validate="required" />
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_STKNUM">선적번호</dt>
                        <dd>
                            <input type="text" class="input" name="I.STKNUM" UIInput="SR"/>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_SAP2">항차번호</dt>
                        <dd>
                            <input type="text" class="input" name="H.SAP2" UIInput="SR" />
                        </dd>
                    </dl>
                    
<!--                     <dl> -->
<!--                         <dt CL="STD_TOTPICKNUM">TOTAL 피킹번호</dt> -->
<!--                         <dd> -->
<!--                             <input type="text" class="input" name="TP.STKNUM" UIInput="SR"/> -->
<!--                         </dd>	 -->
<!--                     </dl> -->
                    
                    <dl>
                        <dt CL="STD_DPTNKY2">납품처</dt>
                        <dd>
                            <input type="text" class="input" name="H.DPTNKY" UIInput="SR,SHBZPTN"/>
                        </dd>	
                    </dl>
                    
                    <dl>
                        <dt CL="STD_DPTNNM3">납품처명</dt>
                        <dd>
                            <input type="text" class="input" name="CT.NAME01" UIInput="SR" />
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_MATNR">품목코드</dt>
                        <dd>
                            <input type="text" class="input" name="I.SKUKEY" UIInput="R,SHSKUMA" UIFormat="U"/>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_DESC01">품명</dt>
                        <dd>
                            <input type="text" class="input" name="I.DESC01" UIInput="SR" />
                        </dd>
                    </dl>
                    
                    <dl>
						<dt CL="STD_SKUG01">품목유형</dt>
						<dd>
							<select class="input" name="SKUG01" Combo="WmsInventory,SKUG01COMBO"><option value=""/></select>
						</dd>
					</dl>
					
                    <dl>
                        <dt CL="STD_SKUL01">품목구분</dt>
                        <dd>
                            <select type="text" class="input" CommonCombo="SKUL01" name="SKUL01" id="SKUL01" style="width: 160px;">
                              <option value=""></option>
                            </select>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_BNAME">영업사원명</dt>
