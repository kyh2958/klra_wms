                                        <td GH="100 STD_QTYORG2" GCol="text,QTSHPO" GF="N 20,3"></td>                                           
                                        <td GH="100 STD_SDUOKY" GCol="text,DUOMKY"></td>                                     
                                        <td GH="100 STD_QTYORG" GCol="text,QTYORG" GF="N 20,3"></td>
                                        <td GH="50 STD_UOMKEY" GCol="text,UOMKEY"></td>  
                                        <td GH="70" GCol="text,SKUG01"></td>  
                                        <td GH="70" GCol="text,WAREKY"></td>  
                                        <td GH="120" GCol="text,WAREKYNM"></td>  
                                        <td GH="70 STD_LOTA02" GCol="text,LOTA02"></td>
                                        <td GH="110 STD_PLNTNM" GCol="text,LOTA02NM"></td>
                                        <td GH="70 STD_LOTA01" GCol="text,LOTA01"></td>
                                        <td GH="130 STD_LOTA01NM" GCol="text,LOTA01NM"></td>
