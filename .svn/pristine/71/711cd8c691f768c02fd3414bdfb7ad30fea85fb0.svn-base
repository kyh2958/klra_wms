                            <table class="table_c">
                                <tbody id="gridList">
                                    <tr CGRow="true">
                                        <td GH="40" GCol="rownum">1</td>                                        
                                        <td GH="140" GCol="text,SKUKEY"></td>
                                        <td GH="230" GCol="text,DESC01"></td>                                                                                                                      
                                        <td GH="100 STD_QTSIWH" GCol="text,QTSIWH" GF="N 20,3"></td>                                        
