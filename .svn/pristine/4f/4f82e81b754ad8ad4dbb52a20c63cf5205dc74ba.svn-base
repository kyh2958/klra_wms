<?xml version="1.0" encoding="UTF-8"?><!--Converted at: Wed Feb 23 09:49:03 KST 2022-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="WmsBatch">

	<sql id="INITMTO">
		/* MTO대상 목록 조회 */
		SELECT STKKY.STOKKY, STKKY.WAREKY
			 , TRUNC(SYSDATE) - TO_DATE(STKKY.LOTA11, 'YYYYMMDD') AS CHKDAY
		  FROM STKKY
		 WHERE LOTA09 != ' '
		   AND QTSIWH > 0
		   AND (QTSIWH - QTSBLK
				 	- GREATEST(QTSALO, QTSPMO)
				 	- (CASE WHEN LOTA06 IN ('00') OR QTSPMO > 0 THEN 0
				 			ELSE QTSIWH
				 	   END)
				 ) > 0
		   <if test="WAREKY != null and WAREKY != ''">
		       AND WAREKY = #{WAREKY}
		   </if>
	</sql>
	
	<select id="MTO_WAREKY_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY, COUNT(1) AS CNT
		FROM (
			<include refid="INITMTO"/>
		) A
		WHERE CHKDAY = (SELECT USARG1 FROM CMCDV WHERE CMCDKY = 'MTODAY')
		GROUP BY A.WAREKY
	</select>
	
	<insert id="INITMTO_INSERT" parameterType="Map">
		INSERT INTO ADJDI (
			  SADJKY
			, SADJIT
			, RSNADJ
			, STOKKY
			, LOTNUM
			, QTADJU
			, QTBLKD
			, QTYUOM
			, ADJRSN
			, DESC01, DESC02
			, LOTA01, LOTA02, LOTA03, LOTA04, LOTA05
			, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
			, LOTA11, LOTA12, LOTA13, LOTA14, LOTA15
			, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
			, LOCAKY, TRNUID, SECTID, PACKID, TRUNTY
			, MEASKY, UOMKEY, QTPUOM, DUOMKY, QTDUOM
			, REFDKY, REFDIT, REFCAT, OWNRKY, SKUKEY
			, AWMSNO, AREAKY, EANCOD, GTINCD
			, ASKU01, ASKU02, ASKU03, ASKU04, ASKU05
			, SKUG01, SKUG02, SKUG03, SKUG04, SKUG05
			, GRSWGT, NETWGT, WGTUNT, LENGTH, WIDTHW
			, HEIGHT, CUBICM, CAPACT, SMANDT, SEBELN, SEBELP
			, STRAID, SVBELN, SPOSNR, STKNUM, STPNUM, SWERKS
			, SLGORT, SDATBG, STDLNR, SSORNU, SSORIT, SMBLNR
			, SZEILE, SMJAHR, SXBLNR, SAPSTS, SBKTXT
			, INDBZL, INDARC, UPDCHK, SZMBLNO, SZMIPNO
			, RELRSN, RELDAT, RELUSR
			, CREDAT, CRETIM, CREUSR, LMODAT, LMOTIM, LMOUSR
			, REFSTK
		)
		SELECT #{SADJKY}                                                        AS SADJKY
			 , LPAD(TO_NUMBER(ROW_NUMBER() OVER(ORDER BY QTSIWH, LV) * 10), 6, '0') AS SADJIT
			 , NVL(#{ARSNADJ}, ' ')                                             AS RSNADJ
			 , DECODE(LV, 1, ST.STOKKY, ' ')                                    AS STOKKY
			 , DECODE(LV, 1, ST.LOTNUM, ' ')                                    AS LOTNUM
			 , ST.QTSIWH * DECODE(LV, 1, -1, 1)                                 AS QTADJU
			 , 0                                                                AS QTBLKD
			 , ST.QTSIWH                                                        AS QTYUOM
			 , NVL(#{AADJRSN},' ')                                              AS AADJRSN
			 , ST.DESC01, ST.DESC02
			 , ST.LOTA01, ST.LOTA02, ST.LOTA03, ST.LOTA04, ST.LOTA05
			 , ST.LOTA06
			 , DECODE(LV, 1, LOTA07, ' ') AS LOTA07
			 , ST.LOTA08
			 , DECODE(LV, 1, LOTA09, ' ') AS LOTA09
			 , ST.LOTA10
			 , ST.LOTA11, ST.LOTA12, ST.LOTA13, ST.LOTA14, ST.LOTA15
			 , ST.LOTA16, ST.LOTA17, ST.LOTA18, ST.LOTA19, ST.LOTA20
			 , ST.LOCAKY, ST.TRNUID, ST.SECTID, ST.PACKID, ST.TRUNTY
			 , ST.MEASKY, SM.DUOMKY, ST.QTPUOM, SM.DUOMKY, SM.QTDUOM
			 , ST.REFDKY, ST.REFDIT, ST.REFCAT, SM.OWNRKY, SM.SKUKEY
			 , ST.AWMSNO, ST.AREAKY, SM.EANCOD, SM.GTINCD
			 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
			 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
			 , SM.GRSWGT, SM.NETWGT, SM.WGTUNT, SM.LENGTH, SM.WIDTHW
			 , SM.HEIGHT, SM.CUBICM, SM.CAPACT, ST.SMANDT, ST.SEBELN, ST.SEBELP
			 , ST.STRAID, ST.SVBELN, ST.SPOSNR, ST.STKNUM, ST.STPNUM, ST.SWERKS
			 , ST.SLGORT, ST.SDATBG, ST.STDLNR, ST.SSORNU, ST.SSORIT, ST.SMBLNR
			 , ST.SZEILE, ST.SMJAHR, ST.SXBLNR, ST.SAPSTS, ST.SBKTXT
			 , SM.INDBZL, SM.INDARC, SM.UPDCHK, ST.SZMBLNO, ST.SZMIPNO
			 , ' ' AS RELRSN, TO_CHAR(SYSDATE, 'YYYYMMDD') AS RELDAT, ' 'AS RELUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
			 , ST.STOKKY
		FROM (
			<include refid="INITMTO"/>
		) A
		INNER JOIN STKKY ST ON A.STOKKY = ST.STOKKY
		INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY AND SM.SKUKEY = ST.SKUKEY
		INNER JOIN (SELECT LEVEL AS LV FROM DUAL CONNECT BY 2 >= LEVEL) ON 1 = 1
		WHERE CHKDAY = (SELECT USARG1 FROM CMCDV WHERE CMCDKY = 'MTODAY')
		  AND ST.QTSIWH > 0
	</insert>
</mapper>