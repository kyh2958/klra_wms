<script type="text/javascript">

	$(document).ready(function(){
		
		var rangeMap = new DataMap();
		var rangeList = new Array();
		
		rangeMap.put("OPER", "E");
		rangeMap.put("DATA", "310");
		rangeList.push(rangeMap);
		
		inputList.setRangeData("TH.TASOTY", configData.INPUT_RANGE_TYPE_SINGLE, rangeList);
	
		gridList.setGrid({
			id : "gridHeadList",
			//pkcol : "TASKKY, WAREKY",
			module : "WmsTask",
			command : "PT02HEAD",
			itemGrid : "gridList",
			itemSearch : true
	    });
		
		gridList.setGrid({
			id : "gridList",
			module : "WmsTask",
			command : "PT02"
	    });
		
	<%-- 		$("#USERAREA").val("<%=user.getUserg5()%>"); --%>
		gridList.setReadOnly("gridList", true, ['LOTA02','LOTA06','LOTA08']);
		
		initSearchArea();
		
	});
	
	function initSearchArea() {
  	  // 플랜트
      <%if(null!=plant && plant.trim().equals("")){%>
        $('select[id="PLNTKY"]').multipleSelect('checkAll');
      <%}else{%>
        $('select[id="PLNTKY"]').multipleSelect('setSelects', ['<%=plant%>']);
      <%}%>
        //$('select[id="SKUL01"]').val("");
    }
	
	function gridListEventItemGridSearch(gridId, rowNum, itemGridList){
		if(gridId == "gridHeadList"){
	        var param = getItemSearchParam(rowNum);
	        
	        gridList.gridList({
	           id : "gridList",
	           param : param
	        });
		}
	}
		
	function getItemSearchParam(rowNum){
		var rowData = gridList.getRowData("gridHeadList", rowNum);
	    var param = inputList.setRangeParam("searchArea");
	    param.putAll(rowData);
    
    	return param;
	}
		
	function searchList(){
		if(validate.check("searchArea")){
			var param = inputList.setRangeParam("searchArea");
			
			gridList.resetGrid("gridHeadList");
			gridList.resetGrid("gridList");
			
			gridList.gridList({
		    	id : "gridHeadList",
		    	param : param
		    });
		}
	}
	
	function gridExcelDownloadEventBefore(gridId){
		
		var param = new DataMap();
		
		if(gridId == "gridHeadList"){
			param = inputList.setRangeParam("searchArea");
			param.put("dataGridExcel", "적치완료_리스트");
		}else if(gridId == "gridList"){
			 var rowNum = gridList.getSearchRowNum("gridHeadList");
			 if(rowNum == -1){
				 return false;
			 }else{
				 param = getItemSearchParam(rowNum);
				 param.put("dataGridExcel", "적치완료_상세_리스트");
			 }
		}
		
		return param;
	}
	
	
	function pkComplete(){
		
		// 적치완료
		var itemGrdViewYn = gridList.getItemGridViewCheck("gridHeadList");
		var head = gridList.getSelectData("gridHeadList");
		var list = gridList.getSelectData("gridList");
		
		var headRowNum = gridList.getFocusRowNum("gridList")
		var headRowCheck = gridList.getSelectType("gridList", headRowNum);
		
		if(itemGrdViewYn && headRowCheck==true){
			if(list.length < 1){
				commonUtil.msgBox("COMMON_M0053"); //아이템 리스트상의 작업 대상이 선택되지 않았습니다.
				return false;
			}
		}else{
			if(head.length < 1){
				commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
				return false;
			}
		}
		
		// 밸리데이션 체크-수량,지번 입력 여부 
		var rowData;
		for(var i = 0; i < list.length; i++){
			
			rowData = list[i];
			
			var rowNum = rowData.get("GRowNum");
			var taskit = rowData.get("TASKIT");
			var qtcomp = rowData.get("QTCOMP");
			var qttaor = rowData.get("QTTAOR");					
			var locaac = rowData.get("LOCAAC");
			
			if ( parseInt(qtcomp) > parseInt(qttaor) ){
				gridList.setColFocus("gridList", rowNum, "QTCOMP");
				commonUtil.msgBox("TASK_M0062",[taskit,qttaor,qtcomp]);	//작업아이템번호의 완료량이 지시량이 많습니다.
				return false;					
			}
			if(locaac == null || locaac == "NaN" || locaac == "null" || locaac.trim() == ""){
				gridList.setColFocus("gridList", rowNum, "LOCAAC");
				commonUtil.msgBox("TASK_M0063",taskit);					//작업아이템번호의 지번이 입력되지 않았습니다.
				return false;
			}
			
			if(Number(qtcomp) <= 0){
				gridList.setColFocus("gridList", rowNum, "QTCOMP");
				commonUtil.msgBox("TASK_M0057");	//완료수량은 0보다 커야합니다.
				return;
			}
		}
		
		var headTaskky = "";
		
		if(itemGrdViewYn){
			var rowNum = gridList.getFocusRowNum("gridHeadList")
			headTaskky = gridList.getColData("gridHeadList", rowNum, "TASKKY");
		}
			
		// 지번 밸리데이션
		var param = new DataMap();
		param.put("head", head);
		param.put("list", list);
		param.put("headTaskky", headTaskky);
		
		var json = netUtil.sendData({
			url : "/wms/task/json/PTLocacValidation.data",			
			param : param
		});
		if(json.data != "OK"){
			var msgList = json.data.split("†");
			var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
			commonUtil.msg(msgTxt);										//작업아이템번호에 입력된 지번은 등록되지 않았습니다.
			return;
		}
		
		if(!commonUtil.msgConfirm("HHT_T0007")){ //저장하시겠습니까?
			return;
		}
		
		param.put("headList", head);
		param.put("messageOption", {
			total_count : param.map.headList.length,
            current_count : 1,
            message   : commonUtil.getMsg("IN_M0155")//"적치 진행중입니다."
        })
        
        sucCount = 0;
        errCount = 0;
        msgHtml = "";
		var json = sendSave(param);
		
		return;
			
	//		var workType = "2";				
	//		param.put("workType", workType);
	
		json = netUtil.sendData({
			url : "/wms/task/json/PT02SaveEnd.data",
			param : param
		});
		/*
		if(json && json.data){
			
			var resultMsg = json.data.resultMsg;
			if(resultMsg=="SUCCESS"){
				
				gridList.resetGrid("gridHeadList");
				gridList.resetGrid("gridList");
				commonUtil.msgBox("COOMON_M0463");								//저장이 완료되었습니다.
				searchList();
			
			}else{
				alert(resultMsg);
			}
			
		}
		*/
		
		if(json.data && json.data.RESULTMSG ){
			var msgList = json.data.RESULTMSG.split("†");
			var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
			commonUtil.msg(msgTxt);
			return;
		}
		
		if(json && json.data){
			
			var inRsCode = json.data.inRsCode; // 입고저장 결과코드
            var inRsMsg = json.data.inRsMsg;   // 입고저장 결과 메시지
			
			var ifRsCode = json.data.ifRsCode; // 인터페이스 전송 결과코드
            var ifRsMsg = json.data.ifRsMsg;   // 인터페이스 전송 결과 메시지
            
            var totCnt = json.data.totCnt;     // 입고 전체 건수
            var sucCnt = json.data.sucCnt;     // 입고 성공 건수
            var failCnt = json.data.failCnt;   // 입고 실패 건수 
            
            //var sucList = json.data.sucList;   // 입고 성공 오더목록 ( 부분입고 여부 확인 불가 )
            
            console.log("전체 : " + totCnt + " - 성공 : " + sucCnt + " - 실패 : " + failCnt);
        	console.log("inRsCode : " + inRsCode);
        	console.log("ifRsCode : " + ifRsCode);
        	//console.log("sucList : " + sucList);
        	
        	if(inRsCode != "S" && ifRsCode != "S"){
        		console.log("inRsMsg : " + inRsMsg);
        		console.log("ifRsMsg : " + ifRsMsg);
        		//commonUtil.msgBox("VALID_M0950"); // 입고 저장에 실패하였습니다.
        		//commonUtil.msgBox("VALID_M0953",[totCnt,sucCnt,failCnt]); // 저장 및 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
        		var msgTxt = commonUtil.getMsg("VALID_M0953",[totCnt,sucCnt,failCnt]); // 저장 및 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
        		alert(msgTxt + "\n" + inRsMsg + "" + ifRsMsg);
        		//saveRsReadonly(sucList,chkHeadList,headSebeln);
        	}else if(inRsCode != "S"){
            	console.log("inRsMsg : " + inRsMsg);
            	//commonUtil.msgBox("VALID_M0950"); // 입고 저장에 실패하였습니다.
            	//commonUtil.msgBox("VALID_M0951",[totCnt,sucCnt,failCnt]); // 입고 저장에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            	var msgTxt = commonUtil.getMsg("VALID_M0951",[totCnt,sucCnt,failCnt]); // 입고 저장에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            	alert(msgTxt + "\n" + inRsMsg);
            	//saveRsReadonly(sucList,chkHeadList,headSebeln);
        	}else if(ifRsCode != "S"){
            	console.log("ifRsMsg : " + ifRsMsg);
            	//commonUtil.msgBox("VALID_M0942"); // 인터페이스 전송에 실패하였습니다.
            	//commonUtil.msgBox("VALID_M0952",[totCnt,sucCnt,failCnt]); // 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            	var msgTxt = commonUtil.getMsg("VALID_M0952",[totCnt,sucCnt,failCnt]); // 인터페이스 전송에 실패 하였습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            	alert(msgTxt + "\n" + ifRsMsg);
            	//saveRsReadonly(sucList,chkHeadList,headSebeln);
            }else{
            	//commonUtil.msgBox("MASTER_M0564"); // 저장 완료되었습니다.
            	commonUtil.msgBox("VALID_M0954",[totCnt,sucCnt,failCnt]); // 저장 완료되었습니다. 전체[{0}] 성공[{1}] 실패[{2}]
            	/*
            	gridList.resetGrid("gridList");
				gridList.resetGrid("gridListSub");
				searchList();
				*/
            }
        	
        	/*
			var ifRsCode = json.ifRsCode; // 인터페이스 전송 결과코드
            var ifRsMsg = json.ifRsMsg;   // 인터페이스 전송 결과 메시지
        	console.log("ifRsCode : " + ifRsCode);            	
            if(ifRsCode != "S"){
            	console.log("ifRsMsg : " + ifRsMsg);
            	commonUtil.msgBox("VALID_M0942"); // 인터페이스 전송에 실패하였습니다.
            }else{
            	commonUtil.msgBox("MASTER_M0564");
            }
            */
			
			gridList.resetGrid("gridHeadList");
			gridList.resetGrid("gridList");
			searchList();
			
		}
		
	}
	
	
	var sucCount = 0;
    var errCount = 0;
    var msgHtml = "";
    // 20220907 저장방식 변경됨.
	function sendSave(param, recall){
        
		var current_count = param.map.messageOption.current_count;
		var total_count = param.map.messageOption.total_count;
		
    	if(total_count == 1){
    		sucCount = 0; 
    	    errCount = 0;
    	    msgHtml = "";
    	}
		
		if(param.map.messageOption){
        	netUtil.processMessage(param);
	    }
		
		var loopHeadList = new Array();
		loopHeadList.push(param.map.headList[current_count-1]);
		param.put("head", loopHeadList);
		
        var json;
		
        setTimeout(function(){
        	json = netUtil.sendData({
                url : "/wms/task/json/PT02SaveEnd.data",
                param : param,
                async : true,       // 응답없는 메시지 제거를위해 비동기 처리
                loading : true,     // 전체완료될때까지 로딩 유지
                recall : recall,    // 로딩이미지 적용을위해 재귀호출시 필요
                callBackFunction : function(returnData){
                	
                	var inRsCode = returnData.data.inRsCode; // 입고저장 결과코드
                    var inRsMsg = returnData.data.inRsMsg;   // 입고저장 결과 메시지
    				
    				var ifRsCode = returnData.data.ifRsCode; // 인터페이스 전송 결과코드
                    var ifRsMsg = returnData.data.ifRsMsg;   // 인터페이스 전송 결과 메시지
                    
                    var totCnt = returnData.data.totCnt;     // 입고 전체 건수
                    var sucCnt = returnData.data.sucCnt;     // 입고 성공 건수
                    var failCnt = returnData.data.failCnt;   // 입고 실패 건수
                    
                    console.log("전체 : " + totCnt + " - 성공 : " + sucCnt + " - 실패 : " + failCnt);
                	console.log("inRsCode : " + inRsCode);
                	console.log("ifRsCode : " + ifRsCode);
                	console.log("inRsMsg : " + inRsMsg);
                	console.log("ifRsMsg : " + ifRsMsg);
                	//console.log("sucList : " + sucList);
                	
                	if(inRsCode != "S" && ifRsCode != "S"){
                		msgHtml += "\n" + inRsMsg + "" + ifRsMsg;
                		errCount++;
                	}else if(inRsCode != "S"){
                    	msgHtml += "\n" + inRsMsg;
                    	errCount++;
                	}else if(ifRsCode != "S"){
                    	msgHtml += "\n" + ifRsMsg;
                    	errCount++;
                    }else{
                    	sucCount++;
                    }
                	
                	if(total_count > current_count){
                		sendSave(param, true);
                    }else{
                    	netUtil.processMessageOff();
                        commonUtil.msgBox("실패:"+errCount +", 성공:"+sucCount+msgHtml); //관리자에게 문의 바랍니다.
                        
                        gridList.resetGrid("gridHeadList");
            			gridList.resetGrid("gridList");
                    	searchList();
                    }
                }
            });
        }, 100);
    }
    
		
	function comboEventDataBindeBefore(comboAtt){
		
		if(comboAtt == "Wms,PLNTKYCOMBO"){
			var param = new DataMap();
			
			//var WAREKY_LIST = ['<%= wareky%>'];
			//param.put("WAREKY_LIST", WAREKY_LIST);
			
			var WAREKYS = "'<%= wareky%>'";
			param.put("WAREKYS", WAREKYS);
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
			
			return param;
		}
		
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType){
		
		var param = new DataMap();
		
		if(searchCode == "SHSTLMAP"){
			var PLNTKY = $('select[id="PLNTKY"]').val();
        	param.put("LANGKY", "<%=langky%>");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("WAREKY", "<%=wareky%>");
            param.put("PLNTKY", PLNTKY);
            if(PLNTKY==null || $.trim(PLNTKY)==""){
            	return false;
            }
            return param;
		}else if(searchCode == "SHLOCMA_PT"){
			
			//console.log("searchCode : " + searchCode + "\ngridType : " + gridType + "\ninputObj : " + JSON.stringify(inputObj));
			param.put("LANGKY", "<%=langky%>");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("WAREKY", "<%=wareky%>");
            
           	var rowNum = -1;
           	var gridId = "gridList";
           	rowNum = gridList.getSelectIndex(gridId);
           	var plntky = gridList.getColData(gridId, rowNum, "LOTA02");
           	var plntkyArr = new Array();
            //plntkyArr.push(plntky);
            
            // 20220921 P200과 P300 묶어서 처리 되게 동시에 보이게 설정 요청.
            var plntkyP200 = "P200";
           	var plntkyP300 = "P300";
           	var plntkyArr = new Array();
           	if(plntky==plntkyP200||plntky==plntkyP300){
           		plntkyArr.push(plntkyP200);
           		plntkyArr.push(plntkyP300);
           	}else{
           		plntkyArr.push(plntky);	
           	}
            plntkyArr.push(" ");
            param.put("PLNTKY", plntkyArr);
            
            return param;
		}else if(searchCode == "SHLOCMA_MV"){
			
			param.put("LANGKY", "<%=langky%>");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("WAREKY", "<%=wareky%>");
            
            return param;
		}
	}
	
	function commonBtnClick(btnName){
		if(btnName == "Search"){
			searchList();
		}else if(btnName == "Work"){
			pkComplete();
		}else if(btnName == "Delete"){
			taskDelete();
		}else if(btnName == "Ptprint"){
			print();
		}
	}
	
	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
		if(gridId=="gridList" && colName=="LOCAAC"){
			var LOCATG = gridList.getColData(gridId, rowNum, "LOCATG");
			chkLOCATG(gridId, rowNum, colName, colValue, LOCATG);
		}
	}
	
	function chkLOCATG(gridId, rowNum, colName, colValue, tmpValue){
		
		var stlkyOrg  = gridList.getColData(gridId, rowNum, "STLKY_ORG");
		var plntkyOrg = gridList.getColData(gridId, rowNum, "PLNTKY_ORG");
		var lota02    = gridList.getColData(gridId, rowNum, "LOTA02");
		
		if(colValue==""){
			gridList.setColValue(gridId, rowNum, colName, "");
			gridList.setColValue(gridId, rowNum, "STLKY", "");
			gridList.setColValue(gridId, rowNum, "PLNTKY", "");
			return;
		}
		
		var param = new DataMap();
		param.put("WAREKY", "<%=wareky%>");
		param.put("ALOCAKY",colValue);
		
		var json = netUtil.sendData({
			module : "WmsTask",
			command : "LOCAKYval2",
			sendType : "map",
			param : param
		});
		
		if (json.data){
			var status = $.trim(json.data["STATUS"]);
			var stlky  = $.trim(json.data["STLKY"]);
			var plntky = $.trim(json.data["PLNTKY"]);
			
			if( status!="00" ){
				gridList.setColFocus(gridId, rowNum, colName);
				gridList.setColValue(gridId, rowNum, colName, tmpValue);
				gridList.setColValue(gridId, rowNum, "STLKY", stlkyOrg);
				gridList.setColValue(gridId, rowNum, "PLNTKY", plntkyOrg);
				commonUtil.msgBox("TASK_M0011", colValue);	//* 이동대상 로케이션 {0} 이 유효하지 않습니다.
				return false;
			}
			// 20220921 P200과 P300 묶어서 처리 되게 동시에 보이게 설정 요청.
			if(lota02=="P200"||lota02=="P300"){
				if( ( plntky!="P200" && plntky!="P300" ) && $.trim(plntky)!=""){
					gridList.setColValue(gridId, rowNum, colName, tmpValue);
					gridList.setColFocus(gridId, rowNum, "LOTA02");
					commonUtil.msgBox("TASK_M0701");	// 동일한 플랜트 내 지번만 변경 가능합니다.
					return false;
				}
			}else{
				if(lota02!=plntky && $.trim(plntky)!=""){
					gridList.setColValue(gridId, rowNum, colName, tmpValue);
					gridList.setColFocus(gridId, rowNum, "LOTA02");
					commonUtil.msgBox("TASK_M0701");	// 동일한 플랜트 내 지번만 변경 가능합니다.
					return false;
				}
			}
			
			gridList.setColValue(gridId, rowNum, "STLKY", stlky);
			gridList.setColValue(gridId, rowNum, "PLNTKY", plntky);
		}else{
			gridList.setColFocus(gridId, rowNum, colName);
			gridList.setColValue(gridId, rowNum, colName, tmpValue);
			gridList.setColValue(gridId, rowNum, "STLKY", stlkyOrg);
			gridList.setColValue(gridId, rowNum, "PLNTKY", plntkyOrg);
			commonUtil.msgBox("TASK_M0011", colValue);	//* 이동대상 로케이션 {0} 이 유효하지 않습니다.
			return false;
		}
		
	}
	
	function taskDelete(){
		
		var head = gridList.getSelectData("gridHeadList");
		var list = gridList.getSelectData("gridList");
		
		var itemGrdViewYn = gridList.getItemGridViewCheck("gridHeadList");
		
		if(itemGrdViewYn && list.length == 0){
			//commonUtil.msgBox("VALID_M2067");// 선택된 아이템이 없습니다.
			//return;
		}
		
		if(head.length==0){
			commonUtil.msgBox("VALID_M2061");// 현재 진행중인 데이터의 헤더 체크박스를 선택하여주세요.
			return;
		}
		
		var headTaskky = "";
		
		if(itemGrdViewYn){
			var rowNum = gridList.getFocusRowNum("gridHeadList")
			headTaskky = gridList.getColData("gridHeadList", rowNum, "TASKKY");
		}
		
		
		var param = new DataMap();
		param.put("head", head);
		param.put("list", list);
		param.put("headTaskky", headTaskky);
		
		var json = netUtil.sendData({
			url : "/wms/task/json/PTDeleteValidation.data",			
			param : param
		});
		if(json.data != "OK"){
			var msgList = json.data.split("†");
	 		var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
			commonUtil.msg(msgTxt);										//작업아이템번호에 입력된 지번은 등록되지 않았습니다.
			return;
		}
		
		if(!commonUtil.msgConfirm("COMMON_M0026")){ //삭제하시겠습니까?
			return;
		}
		/*
		var param = new DataMap();
		param.put("head", head);
		param.put("list", list);
		param.put("headTaskky", headTaskky);
		*/
		var json = netUtil.sendData({
			url : "/wms/task/json/DeletePT02.data",
			param : param
		});
		
		if(json && json.data){
			gridList.resetGrid("gridHeadList");
			gridList.resetGrid("gridList");
			commonUtil.msgBox("VALID_M0003");
			searchList();
		}
	}
	
	function print(){
		var list = gridList.getSelectData("gridHeadList");
		
		if (list.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		} 
		
		var param = new DataMap();
		param.put("list",list);
		param.put("columnList", "WAREKY,TASKKY");
		param.put("PRTTYP","PA_LIST");
		param.put("OWNRKY", "<%=ownrky%>");
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		
		var url = "Putaway_List_A4.ezg?ver=0.03";
		var wareky  = "<%=wareky%>";
		var ownrky  = "<%=ownrky%>";		
		var where = "AND TH.WAREKY='"+wareky+"' AND TI.OWNRKY='"+ownrky+"' AND (";
		for(var i=0; i<list.length; i++){
			var row = list[i];
			var key = row.get("TASKKY");
			
			where += "TH.TASKKY='"+key+"'";
			if(i==list.length-1) break;
			where += " OR ";	
		}
		where += ")"; 
		
		var map = new DataMap();
		map.put("PRTSEQ", prtseq);
		map.put("i_ownrky", ownrky);
		WriteEZgenElement(url, where, "", '<%=langky%>', map, 1300, 900);
	}

</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
