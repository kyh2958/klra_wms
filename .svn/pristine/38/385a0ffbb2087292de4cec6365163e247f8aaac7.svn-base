								<th CL="STD_LOTA12">입고일자</th>
								<th CL="STD_LOTA13">유통기한</th>								
							</tr>
						</thead>
					</table>
				</div>
				<div class="tableBody">
					<table style="width: 100%;">
						<colgroup>
							<col width="40px" />
