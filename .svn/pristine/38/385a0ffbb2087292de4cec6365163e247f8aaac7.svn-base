							<col width="20%" />
							<col width="20%" />
							<col width="20%" />
							<col width="20%" />
							<col width="20%" />
						</colgroup>
					<tbody>
						<tr>
							<th CL='STD_LOCAKY3'>로케이션</th>
							<td colspan="3">
								<input type="text" class="text" name="LOCAKY" id="LOCAKY"/>
							</td>
							<td colspan="2" onclick ="searchLocationList()">
								<button class="bt" style="height: 28px;">
									<p CL='BTN_SEARCH'></p>
								</button>
							</td>
						</tr>
						<tr>
							<th CL='STD_BARCOD'>바코드</th>
							<td colspan="5">
								<input type="text" class="text" name="BARCOD" id="BARCOD" onfocus="this.select();" onkeypress="eventKeydown(event,this.id)"/>
							</td>
						</tr>
						<tr>
							<th CL='STD_LOCAKY3'>로케이션</th>
							<td colspan="5">
								<input type="text" class="text" name="LOCASR" id="LOCASR" readonly/>
							</td>
						</tr>
						<tr>
							<th CL='STD_SKUKEY'>품목코드</th>
							<td colspan="5">
								<input type="text" class="text" name="SKUKEY" id="SKUKEY" readonly/>
							</td>
						</tr>
						<tr>
							<th  CL='STD_DESC01'>품목명</th>
							<td colspan="5">
								<input type="text" class="text" name="DESC01" id="DESC01" readonly/>
							</td>
						</tr>
						<tr>
							<th  CL='STD_QTYRCV1'>지시수량</th>
							<td>
								<input type="text" class="text number" name="QTTAOR" id="QTTAOR" readonly onchange="valueChangeEvent(this)"/>
							</td>									
							<td>
								<input type="text" class="text" name="UOMKEY" id="UOMKEY" readonly onchange="valueChangeEvent(this)"/>
							</td>
							<td>
								<input type="text" class="text number" name="BQTTAOR" id="BQTTAOR" readonly onchange="valueChangeEvent(this)"/>
							</td>
							<td>
								<input type="text" class="text" name="BUOMKEY" id="BUOMKEY" readonly onchange="valueChangeEvent(this)"/>
							</td>
						</tr>
						<tr>			
							<th  CL='STD_QTJCMP'>피킹수량</th>
							<td>
								<input type="text" class="text number"name="QTSPUT" id="QTSPUT" onfocus="this.select();" value="0" onchange="valueChangeEvent(this)" onkeypress="eventKeydown(event,this.id)" onkeyup="eventKeyup(event,this.id)"/>
								<input type="hidden" class="input" name="LASTOB" id="LASTOB"/>
								<input type="hidden" class="input" name="LLOTA11" id="LLOTA11"/>
								<input type="hidden" class="input" name="SHPOKY" id="SHPOKY"/>
								<input type="hidden" class="input" name="SHPOIT" id="SHPOIT"/>
								<input type="hidden" class="input" name="QTPUOM" id="QTPUOM"/>
							</td>
							<td>
								<input type="text" class="text" name="PUT_UOMKEY" id="PUT_UOMKEY" readonly/>
							</td>
							<td>
								<input type="text" class="text number"name="BQTSPUT" id="BQTSPUT" onfocus="this.select();" value="0" onchange="valueChangeEvent(this)" onkeypress="eventKeydown(event,this.id)" onkeyup="eventKeyup(event,this.id)"/>							
							</td>
							<td>
								<input type="text" class="text" name="PUT_BUOMKEY" id="PUT_BUOMKEY" readonly/>
							</td>
						</tr>									
					</tbody>
				</table>
				<!-- 할당로트피킹준수 HIDDEN -->
				<input type="hidden" class="input" name="ALOTPCK" id="ALOTPCK"/>
			</div>
			</div>
			<div class="tableWrap_search section">
				<div class="tableHeader">						 
					<table style="width: 100%;">
						<colgroup>
							<col width="40px" />
							<col width="110px" />
							<col width="75px" />
							<col width="75px" />
							<col width="75px" />
							<col width="75px" />
							<col width="75px" />
