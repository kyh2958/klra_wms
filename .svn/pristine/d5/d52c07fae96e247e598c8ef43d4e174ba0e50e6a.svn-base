<%@page import="project.common.airfw.User"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Grid default</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<style type="text/css">
 .content_wrap{background: none;}
 .search_sub{height: 40px;}
 .content_layout .search_sub p{padding:0 0 5px; line-height:30px;}
 .content_layout .search_sub p span{padding-right:5px;}
</style>
<link rel="stylesheet" type="text/css" href="/common/theme/webdek/css/demo_layout.css">
<script type="text/javascript">
	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",
			name : "gridList",
			module : "WmsInventory",
			command : "SJ03",
			editable : true
			
		});
		
		gridList.setGrid({
			id : "gridListSub",
			name : "gridListSub",
			module : "WmsInventory",
			command : "SJ03Sub",
			editable : true
		});
		
		initSearchArea();

		inputList.setInput("tab1_btn");
	});
	
	function initSearchArea() {
		// DEFAULT : 전체선택
		<%if(plant.equals("")){%>
			$('select[name="S.LOTA02"]').multipleSelect('checkAll');
		<%}else{%>
			$('select[name="S.LOTA02"]').multipleSelect('setSelects', ['<%=plant%>']);
		<%}%>
		$('select[name="SKUL01"]').val("");
	}
	
	function commonBtnClick(btnName){
		if(btnName == "Search"){
			searchList();
		}else if(btnName == "Save"){
			saveData();
		}else if(btnName == "Reflect1"){
			setGridDataByReflectBtn('1');
		}else if(btnName == "Reflect2"){
			setGridDataByReflectBtn('2');
		}else if(btnName == "Reflect3"){
			setGridDataByReflectBtn('3');
		}else if(btnName == "Reflect4"){
			setGridDataByReflectBtn('4');
		}
	}
	
	var searchType = true;
	
	function searchList(){
		gridList.setReadOnly("gridList", false);
		gridList.setReadOnly("gridListSub", false);
		
		searchType = true;
		if(validate.check("searchArea")){
			var param = inputList.setRangeParam("searchArea");
			param.put('WAREKY', '<%=wareky%>');
			param.put('OWNRKY', '<%=ownrky%>');
			param.put('LANGKY', '<%=langky%>');
			
			gridList.gridList({
				id : "gridListSub",
				param : param
			});
		}
	}
	
	function gridListEventDataBindEnd(gridId, dataCount){
		if(dataCount == 0) {
			return;
		}
		
		if(gridId == "gridList"){
			uiList.setActive("Search", true);
			uiList.setActive("Save", true);
			uiList.setActive("Reflect", true);
		} else if(gridId == "gridListSub" && searchType){
			uiList.setActive("Search", false);
			
			var param = inputList.setRangeParam("searchArea");
			param.put('WAREKY', '<%=wareky%>');
			param.put("PROGID", "<%=menuId%>");
			param.put("LANGKY", "<%=langky%>");
			
			gridList.gridList({
				id : "gridList",
				param : param
			});
		}
	}
	

	// 반영(Reflect)버튼 이벤트
	function setGridDataByReflectBtn(flag){
		if(flag) {
			var bundleModify = $("#bundleModify" + flag).val();
			if(bundleModify){
				var targetCol = '';
				switch (flag) {
					case '1' : targetCol = 'ALOTA02'; break;
					case '2' : targetCol = 'ALOTA01'; break;
					case '3' : targetCol = 'ARSNADJ'; break;
					case '4' : targetCol = 'AADJRSN'; break;
					default  : targetCol = ''; break;
				}
				var selectNumList = gridList.getSelectRowNumList("gridListSub");
				for(var i=0;i<selectNumList.length;i++){
					var rowNum = selectNumList[i];
					gridList.setColValue("gridListSub", rowNum, targetCol, bundleModify);
					
					if (targetCol == 'ALOTA02') { // 플랜트(TO)
						gridList.setColValue("gridListSub", rowNum, "ALOTA01", " ");
					}
					
					if (targetCol == 'ALOTA01') { // 저장위치(TO)
						var bundleModify1 = $("#bundleModify1").val();
						gridList.setColValue("gridListSub", rowNum, "ALOTA02", bundleModify1);
						
						/* 성능 이슈로 저장 시 확인하도록 변경 */
						if(checkLOTA01 (rowNum) == false) {
							return false;;
						}
					}
				}
			}
		}
	}
	
	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
		if(gridId == "gridList"){
			uiList.setActive("Save", true);
			
			// 전기일자 체크
			/*
			if(colName == "DOCDAT") {
				var curMonth = new Date().getMonth() + 1;
				if(curMonth != Number(colValue.substr(4, 2))) {
					commonUtil.msgBox('VALID_M0131'); // 전기일자는 당월이어야 합니다.
					gridList.setColValue(gridId, rowNum, "DOCDAT", "");
					gridList.setColFocus(gridId, rowNum, colName);
					return
				}
			}
			*/
		}
		if(gridId == "gridListSub") {
			// 가용수량 체크
			if(colName == "AQTADJU") {
				var QTSIWH  = Number(gridList.getColData(gridId, rowNum, "QTSIWH"));
				var AQTADJU = Number(gridList.getColData(gridId, rowNum, "AQTADJU"));
				
// 				if (QTSIWH == 0) {
// 					commonUtil.msgBox("VALID_M0923"); // 조정수량은 가용수량보다 클 수 없습니다
// 					gridList.setColValue("gridListSub", rowNum, "AQTADJU", 0);
// 					gridList.setColFocus(gridId, rowNum, colName);
// 					return;
// 				}
				
				if (AQTADJU <= 0) {
					commonUtil.msgBox("TASK_M0021", '0'); // 작업수량은 {0}보다 커야 됩니다.
					gridList.setColValue("gridListSub", rowNum, "AQTADJU", QTSIWH);
					gridList.setColFocus(gridId, rowNum, colName);
					return;
				}
				
				if (AQTADJU > QTSIWH) {
					commonUtil.msgBox("INV_M0072"); // 재고수량보다 더 많이 조정할 수 없습니다.
					gridList.setColValue("gridListSub", rowNum, "AQTADJU", QTSIWH);
					gridList.setColFocus(gridId, rowNum, colName);
					return;
				}
			}
			
			if (colName == "ALOTA02") {
				if (colValue.trim() == "") { // 초기화
					gridList.setColValue(gridId, rowNum, "ALOTA01"  , " "); // 저장위치(TO)
					gridList.setColValue(gridId, rowNum, "ALOTA01NM", " "); // 저장위치명(TO)
					gridList.setColValue(gridId, rowNum, "ARSNADJ"  , " "); // 조정사유코드
					gridList.setColValue(gridId, rowNum, "AADJRSN"  , " "); // 조정상세사유
				} else {
					gridList.setColValue(gridId, rowNum, "ALOTA01"  , " "); // 저장위치(TO)
					gridList.setColValue(gridId, rowNum, "ALOTA01NM", " "); // 저장위치명(TO)
				}
			}
			
			if (colName == "ALOTA01") {
				checkLOTA01(rowNum);
			}
			
			if (colName == "BOXQT") { 
				var BOXBAG = new Number(gridList.getColData(gridId, rowNum, "BOXBAG"));
				var USEQTY = new Number(gridList.getColData(gridId, rowNum, "USEQTY"));
				
				if (BOXBAG > 0) {
					if (Number.isInteger(parseFloat(colValue)) == false) {
						commonUtil.msgBox("OUT_M0010");	// 소수점은 허용되지 않습니다.
						gridList.setColValue(gridId, rowNum, colName, 0);
						return;
					}

					if(USEQTY < (BOXBAG * colValue)) {
						commonUtil.msgBox("OUT_M0213") //작업수량이 가용수량보다 클수 없습니다.
						gridList.setColValue(gridId, rowNum, colName, (USEQTY / BOXBAG));
					}else {
						gridList.setColValue(gridId, rowNum, 'AQTADJU', (BOXBAG * colValue));
						gridListEventColValueChange(gridId, rowNum, 'AQTADJU', (BOXBAG * colValue)); // 가용수량 체크
					}
				}else {
					gridList.setColValue(gridId, rowNum, colName, 0);
				}
			}
		}
	}
	
	// LOTA01(저장위치) validation
	function checkLOTA01 (rowNum) {
		var  LOTA01 = gridList.getColData("gridListSub", rowNum,  "LOTA01");
		var  LOTA02 = gridList.getColData("gridListSub", rowNum,  "LOTA02");
		var ALOTA01 = gridList.getColData("gridListSub", rowNum, "ALOTA01");
		var ALOTA02 = gridList.getColData("gridListSub", rowNum, "ALOTA02");
		
		var  LOTA06 = gridList.getColData("gridListSub", rowNum,  "LOTA06");
		if (LOTA06 != '00' && LOTA02 != ALOTA02) {
			alert("품질, 보류, 불용, 폐기 재고는 다른 플랜트로 변경이 불가합니다.");
			gridList.setColValue("gridListSub", rowNum, "ALOTA01", " "); // 저장위치(TO)
			gridList.setColValue("gridListSub", rowNum, "ALOTA02", " "); // 플랜트(TO)
			gridList.setColFocus("gridListSub", rowNum, "ALOTA02");
			return false;
		}
		
		if (LOTA01 == ALOTA01 && LOTA02 == ALOTA02) {
			commonUtil.msgBox("INV_M0055"); // 기존값과 동일합니다. 확인해주세요.
			gridList.setColValue("gridListSub", rowNum, "ALOTA01", " "); // 저장위치(TO)
			gridList.setColValue("gridListSub", rowNum, "ALOTA02", " "); // 플랜트(TO)
			gridList.setColFocus("gridListSub", rowNum, "ALOTA02");
			return false;
		}
		
		// 저장위치(TO)
		if (!ALOTA01 || !ALOTA01.trim()) {
			var label = commonLabel.getLabel("STD_LOTA01_TO", 1);
			commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
			return false;
		}
		
		// 플랜트(TO)
		if (!ALOTA02 || !ALOTA02.trim()) {
			gridList.setColValue("gridListSub", rowNum, "ALOTA02", LOTA02);
			ALOTA02 = LOTA02;
		}
		//20230109 3000 -> 3500 // 3500 -> 3000 이동 제한 
		if((LOTA01=='3000'&&ALOTA01=='3500') ||(LOTA01=='3500'&&ALOTA01=='3000') ){
			commonUtil.msgBox("VALID_M1565", ALOTA01); // 이동단위 {0}가 올바르지 않습니다.
			gridList.setColValue("gridListSub", rowNum, "ALOTA01", " "); // 저장위치(TO)
			gridList.setColValue("gridListSub", rowNum, "ALOTA02", " "); // 플랜트(TO)
			gridList.setColValue("gridListSub", rowNum, "ALOTA01NM", " "); // 저장위치(TO)
			return false;
		}
		
		
		/* //20231031 3000 -> 3900 // 3000 -> 3800  3800 -> 3000 // 3900 -> 3000 제한 
		if((LOTA01=='3000'&&ALOTA01=='3900') ||(LOTA01=='3000'&&ALOTA01=='3800') 
		 ||(LOTA01=='3900'&&ALOTA01=='3000') ||(LOTA01=='3800'&&ALOTA01=='3000')){
			commonUtil.msgBox("VALID_M1565", ALOTA01); // 이동단위 {0}가 올바르지 않습니다.
			gridList.setColValue("gridListSub", rowNum, "ALOTA01", " "); // 저장위치(TO)
			gridList.setColValue("gridListSub", rowNum, "ALOTA02", " "); // 플랜트(TO)
			gridList.setColValue("gridListSub", rowNum, "ALOTA01NM", " "); // 저장위치(TO)
			return false;
		} */
		
		//20231110 3800 -> 3900 // 3900 -> 3800   제한 
		if((LOTA01=='3800'&&ALOTA01=='3900') ||(LOTA01=='3900'&&ALOTA01=='3800') ){
			commonUtil.msgBox("VALID_M1565", ALOTA01); // 이동단위 {0}가 올바르지 않습니다.
			gridList.setColValue("gridListSub", rowNum, "ALOTA01", " "); // 저장위치(TO)
			gridList.setColValue("gridListSub", rowNum, "ALOTA02", " "); // 플랜트(TO)
			gridList.setColValue("gridListSub", rowNum, "ALOTA01NM", " "); // 저장위치(TO)
			return false;
		}
		
		
		var param = new DataMap();
		param.put("WAREKY", "<%=wareky%>");
		param.put("STLKY" , ALOTA01);
		param.put("PLNTKY", ALOTA02);
		
		var json = netUtil.sendData({
			module : "WmsInventory",
			command : "LOTA01val",
			sendType : "map",
			param : param
		});

		if (json.data) {
			gridList.setColValue("gridListSub", rowNum, "ALOTA01NM", json.data['STLNM']); // 저장위치(TO)
		} else {
			var label = commonLabel.getLabel("STD_LOTA01_TO", 1);
			commonUtil.msgBox("VALID_remote",[label]); // {0} 값이 유효하지 않습니다.
			gridList.setColValue("gridListSub", rowNum, "ALOTA01", " "); // 저장위치(TO)
			gridList.setColFocus("gridListSub", rowNum, "ALOTA01");
			return false;
		}
	}
	
	function saveData(){
		if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){
			return;
		}
		
		if(gridList.validationCheck("gridListSub", "select")){
			
			var head = gridList.getRowData("gridList", 0);
			var list = gridList.getSelectModifyList("gridListSub");
			
			if(list.length == 0){
				commonUtil.msgBox("INV_M0055"); // 기존값과 동일합니다. 확인해주세요.
				return;
			}
			
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			param.put("LANGKY", "<%=langky%>");
			param.put("head", head);
			param.put("list", list);
			
			var json = netUtil.sendData({
				url : "/wms/inventory/json/saveStock.data",
				param : param
			});
			
			if(json && json.data){
				var sapResList = json.data.sapResList;
				var successCnt = json.data.successCnt;
				
				if (sapResList && sapResList.length > 0) {
					for (var i in sapResList) {
						var SAPRES = sapResList[i].SAPRES;
						var ERRTXT = sapResList[i].ERRTXT;
						if (SAPRES != 'SUCCESS' || ERRTXT) {
							var msg = ERRTXT ? ERRTXT : '[SAP] '+SAPRES;
							commonUtil.msgBox(successCnt + "건 성공 후 에러 발생\n : " + msg);
							searchList();
							return;
						}
					}
				}
				
				var SADJKY = json.data.SADJKY;
				commonUtil.msgBox("INV_M0010", SADJKY);
				
				searchType = false;
				
				var paramH = new DataMap();
				paramH.put("SADJKY", SADJKY);
				paramH.put("DOCUTY", head.get('ADJUCA'));
				
				gridList.gridList({
					id : "gridList",
					command : "ADJDH",
					param : paramH
				});
				
				gridList.gridList({
					id : "gridListSub",
					command : "ADJDI",
					param : paramH
				});
				
				gridList.setReadOnly("gridList", true);
				gridList.setReadOnly("gridListSub", true);
				uiList.setActive("Save", false);
				uiList.setActive("Reflect", false);
			} else {
				uiList.setActive("Save", true);
				uiList.setActive("Reflect", true);
			}
		}
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType, object){
		var param = new DataMap();
		if(searchCode == "SHSKUMA"){ // 품목코드
			param.put("WAREKY", "<%=wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
		}else if(searchCode == "SHCMCDV"){ // 재고상태
			param.put("CMCDKY", "LOTA06");
		}else if(searchCode == "SHSTLMAP") { // 저장위치
			var PLNTKY = "";
			if (object.name == "S.LOTA01") {
				PLNTKY = $('select[name="S.LOTA02"]').val();
			} else if (object.name == "bundleModify2") {
				PLNTKY = $("#bundleModify1").val();
			} else { 
				var rowNum = gridList.getFocusRowNum("gridListSub");
				PLNTKY = gridList.getColData("gridListSub", rowNum, "ALOTA02").trim();
				if (!PLNTKY) {
					PLNTKY = gridList.getColData("gridListSub", rowNum, "LOTA02").trim();
				}
			}
			
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("PLNTKY", PLNTKY);
		}else if(searchCode == "SHLOCMA_PT") { // 로케이션
			var param = dataBind.paramData("searchArea");
			var plntkyArr = $('select[name="S.LOTA02"]').val();
			plntkyArr = plntkyArr ? plntkyArr : [];
			plntkyArr.push(' ');
			
			param.put("PLNTKY", plntkyArr);
			return param;
		}
		return param;
	}
	
	function comboEventDataBindeBefore(comboAtt){
		var param = new DataMap();
		if(comboAtt == "airfw,RSNADJ"){
			param.put("DOCUTY", "401");
		} else if(comboAtt == "Wms,DOCTCOMBO"){
			param.put("DOCUTY", "401");
		} else if(comboAtt == "Wms,PLNTKYCOMBO"){
			param.put("WAREKYS", "'<%=wareky%>'");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
		}
		return param;
	}
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
	<div class="content_inner">
		<%@ include file="/common/include/webdek/title.jsp" %>
		<div class="content_serch" id="searchArea">
			<div class="btn_wrap">
				<div class="fl_l">
				</div>
				<div class="fl_r">
					<input type="button" CB="Search SEARCH BTN_DISPLAY" />
					<input type="button" CB="Save SAVE STD_SAVE" />
					<!-- <input type="button" CB="GetVariant GETVARIANT BTN_GETVARIANT" />
					<input type="button" CB="SaveVariant SAVEVARIANT BTN_SAVEVARIANT" /> -->
				</div>
			</div>
			<div class="search_inner">
				<div class="search_wrap ">
					<dl>
						<dt CL="STD_WAREKY">거점</dt>
						<dd>
							<input type="text" class="input" name="WAREKY" value="<%=wareky%>" readonly="readonly" validate="required" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA02">플랜트</dt>
						<dd>
							<select name="S.LOTA02" class="input" Combo="Wms,PLNTKYCOMBO" ComboType="MS" validate="required">
							</select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA01">저장위치</dt>
						<dd>
							<input type="text" class="input" name="S.LOTA01" UIInput="R,SHSTLMAP" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_DOCUTY">조정문서유형</dt>
						<dd>
							<select class="input" Combo="Wms,DOCTCOMBO" name="DOCUTY" validate="required"></select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_SKUKEY">품목코드</dt>
						<dd>
							<input type="text" class="input" name="S.SKUKEY" UIInput="R,SHSKUMA" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA14">개별바코드</dt>
						<dd>
							<input type="text" class="input" name="S.LOTA14" UIInput="R" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_AREAKY">영역</dt>
						<dd>
							<input type="text" class="input" name="S.AREAKY" UIInput="R,SHAREMA" />
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_ZONEKY">구역</dt>
						<dd>
							<input type="text" class="input" name="S.ZONEKY" UIInput="R,SHZONMA" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOCAKY">지번</dt>
						<dd>
							<input type="text" class="input" name="S.LOCAKY" UIInput="R,SHLOCMA_PT" UIFormat="U"/>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_DESC01">품목명</dt>
						<dd>
							<input type="text" class="input" name="DESC01"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SKUG01">품목유형</dt>
						<dd>
							<select class="input" name="SKUG01" Combo="WmsInventory,SKUG01COMBO"><option value=""/></select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SKUL01">품목구분</dt>
						<dd>
							<select class="input" name="SKUL01" Combo="WmsInventory,SKUL01COMBO">
								<option></option>
							</select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA06">재고상태</dt>
						<dd>
							<select name="S.LOTA06" class="input" CommonCombo="LOTA06" ComboType="MS"></select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA11">제조일자</dt>
						<dd>
