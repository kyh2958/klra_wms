<div class="select_box">
	<table>
		<colgroup>
			<col width="100px"/>
			<col width="50px"/>
			<col width="50px"/>
			<col width="50px"/>
			<col width="50px"/>
			<col width="50px"/>
			<col width="50px"/>
		</colgroup>
		<tbody>
			<tr>
				<th  CL='STD_PICKED'>피킹완료</th>
				<td colspan='2'>
					<input type="text" class="text gridColInputNumber" name="COMP_BOX" id="COMP_BOX" readonly/>
				</td>
				<td CL='STD_BOXQT'>BOX</td>
				<td colspan='2'>
					<input type="text" class="text gridColInputNumber" name="COMP_PLT" id="COMP_PLT" readonly/>
				</td>
				<td CL='STD_PLTQT'>PLT</td>
			</tr>
			<tr class='hiderow'>
				<th  CL='STD_COMPCNT'>완료건수</th>
				<td CL='STD_ALL'>전체</td>
				<td>
					<input type="text" class="text gridColInputNumber" name="COMPCNT" id="COMPCNT" readonly/>
				</td>
				<td CL='STD_CNT'>count</td>
				<td CL='STD_INCLU'>중</td>
				<td>
					<input type="text" class="text gridColInputNumber" name="COMPCNT2" id="COMPCNT2" readonly/>
				</td>
				<td CL='STD_CNT'>count</td>
			</tr>
			
		</tbody>
	</table>
</div>