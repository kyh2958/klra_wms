	@Transactional
	public int saveSD09(DataMap map) throws SQLException {
		List<DataMap> head = map.getList("head");
		List<DataMap> selectList = new ArrayList<DataMap>();
		if (map.get("list") != null && !map.get("list").equals("")) {
			selectList = map.getList("list");
		}
		
		int count = 0;

		DataMap row;
		DataMap itemRow;

		List docNumList = new ArrayList();
		DataMap rsMap = new DataMap();
		
	
		for (int k = 0; k < selectList.size(); k++) {
			itemRow = selectList.get(k).getMap("map");
			itemRow.setModuleCommand("WmsInventory", "SD09");
			itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));


			count += commonDao.update(itemRow);
		}
			
		return count;
	}
	
	
	public DataMap barcodePartition(DataMap map) throws SQLException {
		DataMap rstMap = new DataMap();
		List<DataMap> retList = new ArrayList<>();
		String USER = map.getString(CommonConfig.SES_USER_ID_KEY);
		try {
			List<DataMap> list = map.getList("list");
			for (int i = 0; i < list.size(); i++) {
				DataMap row = list.get(i).getMap("map");
				row.put("P_stokky", row.getString("STOKKY"));
				row.put("P_qty", row.getString("QTTAOR"));
				row.put("P_userid", USER);
				row.setModuleCommand("WmsInventory", "P_AIRWMS_PLT_PARTITON_PROC");
				commonDao.getMap(row);
				retList.add(row);
			}
		} catch (Exception e) {
			rstMap.put("MSG", e.getMessage());
			return rstMap;
		}
		rstMap.put("MSG", "OK");
		rstMap.put("LIST", retList);
		return rstMap;
	}
	
	public DataMap barcodeMerger(DataMap map) throws SQLException {
		DataMap rstMap = new DataMap();
		List<DataMap> retList = new ArrayList<>();
		String USER = map.getString(CommonConfig.SES_USER_ID_KEY);
		try {
			List<DataMap> list = map.getList("list");
			
			StringBuilder sb = new StringBuilder();
			
			//List<String> SHPOKY_LIST = new ArrayList<>();
	
			/*
			for (int j = 0; j < head.size(); j++) {
				rowMap = head.get(j).getMap("map");
				
				String SHPOKY = rowMap.getString("SHPOKY");

				SHPOKY_LIST.add(SHPOKY);
			}
			*/
			//row.put("SHPOKY", SHPOKY_LIST.get(i));

			

			for (int i = 0; i < list.size(); i++) {
				
				if (i != 0) {
					sb.append(",");
				}
				sb.append(list.get(i).getMap("map").getString("STOKKY"));
				
				
				//SHPOKY_LIST.add(list.get(i).getMap("map").getString("STOKKY"));
			}
			
			DataMap row = new DataMap();
			row.put("P_stokky", sb);	// '123,1234,1235';
			row.put("P_userid", USER);
			//System.out.println("2507: " + row.toString());
			row.setModuleCommand("WmsInventory", "P_AIRWMS_PLT_MERGER_PROC");
			commonDao.getMap(row);
			retList.add(row);
			
		} catch (Exception e) {
			rstMap.put("MSG", e.getMessage());
			return rstMap;
		}
		rstMap.put("MSG", "OK");
		rstMap.put("LIST", retList);
		return rstMap;
	}
}