	/** 재고실사 > 엑셀업로드 */
	@Transactional(rollbackFor = Exception.class)
	public List<DataMap> saveIP02POP(DataMap map) throws SQLException {
		List<DataMap> list = map.getList("list");
		
		String wareky   = map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY);
		String ownrky   = map.getString(CommonConfig.SES_USER_OWNER_KEY);
		
		List<DataMap> failedList = new ArrayList<>();
		for (DataMap row : list) {
			DataMap data = (DataMap) row.get("map");
			
			map.clonSessionData(data);
			data.put("WAREKY", wareky);
			data.put("OWNRKY", ownrky);
			
			String phyiit = data.getString("PHYIIT").trim();
			
			int sqlResult = 0;
			if (StringUtils.isEmpty(phyiit)) {
				data.setModuleCommand("WmsInventory", "PHYDI_EXCEL");
				sqlResult = (int) commonDao.insert(data);
			} else {
				int number = data.getInt("PHYIIT");
				phyiit = String.format("%06d", number);
				data.put("PHYIIT", phyiit);
				data.setModuleCommand("WmsInventory", "PHYDI_EXCEL");
				sqlResult = (int) commonDao.update(data);
			}
			
			if(sqlResult < 1) {
				failedList.add(row);
			}
		}
		
		return failedList;
	}
	
