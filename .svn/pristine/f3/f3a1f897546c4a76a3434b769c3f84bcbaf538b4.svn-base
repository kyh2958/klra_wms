			rsMap.put("successCnt", successCnt);
			rsMap.put("sapResList", sapResList);
		} finally {
			transactionManager.commit(transactionStatus);
		}
		return rsMap;
	}
	
	/* PDA 재고상태변경
	 * 2022.05.13 바코드, 지번, 재고상태로 group by해서 보여준 후 해당 데이터로 수정할 수 있도록 saveStock와 분리.
	 */
	@Transactional(rollbackFor = Exception.class)
	public DataMap savePDSJ01(DataMap map) throws SQLException {
		String docuty = "402"; // 재고상태변경
		String docSeq = wmsService.getDocSeq(docuty);
		
		// validate
		if (StringUtils.equals(map.getString("LOTA06"), map.getString("ALOTA06"))) {
			throw new SQLException("equals LOTA06, ALOTA06");
		}
		
		double AQTADJU = Utils.parseDouble(map.get("AQTADJU")); // 조정수량
		
		// 바코드, 지번, 재고상태로 재고목록 조회
		map.setModuleCommand("WmsInventory", "PDSJ01_ADJ_TARGET");
		map.put("SADJKY", docSeq);
		List<DataMap> stkkyList = commonDao.getList(map);
		
		// 조정대상 List 생성
		List<DataMap> targetList = new ArrayList<>();
		for (DataMap stkky : stkkyList) {
			double QTADJU = Utils.parseDouble(stkky.get("QTADJU"));
			
			if (AQTADJU < QTADJU) { // 조정수량이 재고상태보다 작다면
				stkky.put("AQTADJU", AQTADJU);
				stkky.put( "QTADJU", AQTADJU);
				targetList.add(stkky);
				break;
			} else {
				stkky.put("AQTADJU", QTADJU);
				stkky.put( "QTADJU", QTADJU);
				targetList.add(stkky);
				AQTADJU -= QTADJU;
			}
		}
		
		TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
		TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
		Object transactionSavepoint = transactionStatus.createSavepoint();
		
		// head 조회 (required : WAREKY, DOCUTY)
		map.setModuleCommand("WmsInventory", "SJ03");
		map.put("DOCUTY", docuty);
		List<DataMap> headList = commonDao.getList(map);
		
		// head insert
		DataMap head = headList.get(0);
		map.clonSessionData(head);
		head.put("SADJKY", docSeq);
		head.put("ADJFLG", "M");
		head.setModuleCommand("WmsInventory", "ADJDH");
		commonDao.update(head);
		
		// insert item
		List<DataMap> ifList = new ArrayList<>();
		List<HashMap> mList  = new ArrayList<>();
		int subSize = 100;
		for (int i = 0; i < targetList.size(); i++) {
			DataMap row = targetList.get(i);
			map.clonSessionData(row);
			
			row.put("SADJKY", docSeq);
			row.put("SADJIT", String.format("%06d", (i + 1) * 20));
			
			/* 2022.06.23 재고상태TO가 10, 30, 50인 경우 제품군에 따라 저장위치 변경 (P400 플랜트 제외) */
			String  WAREKY = row.getString( "WAREKY");
			String  SKUG05 = row.getString( "SKUG05");
			String  LOTA01 = row.getString( "LOTA01");
			String  LOTA02 = row.getString( "LOTA02");
			String  LOTA06 = row.getString( "LOTA06").trim();
			String ALOTA06 = row.getString("ALOTA06").trim();
			
			/**
			 * 1. 2023.07.25 강내창고의 상태 변경시 저장위치 미변경
			 *  - (P400 플랜트 제외) && (거점: 1100, 1500) && (강내창고 (P200 OR P300) && 3500 저장위치)
			 *   >> 저장위치 변경없음
			 * 
			 * 2. 2024.12.13 영보창고의 상태 변경시 저장위치 미변경
			 *  - 거점: 1100 && P100 && 3400 저장위치)
			 *   >> 저장위치 변경없음
			 *   
			 * 3. 기존조건
			 *  - (P400 플랜트 제외) && (거점: 1100, 1500) && (TO재고상태: 보류, 불용, 폐기, 품질)
			 *   ㄴ 품질:
			 *   	>> 저장위치(원자재): 유지
			 *   	>> 저장위치(세품/상품/반제품): 3800
			 *   ㄴ 그외
			 *   	>> 저장위치(원자재): 1900
			 *   	>> 저장위치(세품/상품/반제품): 3900
			 * 
			 * 4. 2022. 10. 10 재고상태변경 시 보류, 불용, 폐기에서 정상으로 변경되는 경우 기존 정상 상태의 저장위치로 세팅
			 *    2023. 07. 25 재고상태변경 시 보류, 불용, 폐기에서 정상으로 변경되는 경우 저장위치 3000 세팅
			 *  - (P400 플랜트 제외) && (거점: 1100, 1500) && (FROM재고상태: 정상 아닐때) && (TO재고상태: 정상)
			 *   >> 저장위치(원자재): 변경없음
			 *   >> 저장위치(세품/상품/반제품): 3000 고정
			 *   
			 * 5. 2023.08.08 제상품외부창고 3300위치 저장위치 미변경
			 * 
			 * */
			if (StringUtils.equals   ( LOTA02, "P400") == false && // P400 플랜트 제외
				StringUtils.equalsAny( WAREKY, "1100", "1500")  && // 거점이 1100, 1500에 해당
				StringUtils.equals   ( LOTA01, "3500") && 		   // 강내창고 3500위치
				StringUtils.equalsAny( LOTA02, "P200", "P300")) {

			}
			else if (StringUtils.equalsAny( WAREKY, "1100")  && 		// 거점이 1100 해당
					StringUtils.equals   ( LOTA01, "3400") && 		   // 영보창고 3400
					StringUtils.equalsAny( LOTA02, "P100")) {
			}
			else if (StringUtils.equals  ( LOTA02, "P400") == false && // P400 플랜트 제외
					StringUtils.equalsAny( WAREKY, "1100")  && 		   // 거점이 1100 해당
					StringUtils.equals   ( LOTA01, "3300") && 		   // 제상품외부창고 3300위치
					StringUtils.equalsAny( LOTA02, "P100")) {
				
			}
			else if (StringUtils.equals   ( LOTA02, "P400") == false && // P400 플랜트 제외
				StringUtils.equalsAny( WAREKY, "1100", "1500")  && 		// 거점이 1100, 1500에 해당
				StringUtils.equalsAny(ALOTA06, "10", "30", "50", "05")  // TO재고상태가 보류, 불용, 폐기, 품질에 해당
			) {
				// 품질
				//System.out.println("753:" + ALOTA06);
				if (StringUtils.equals   ( ALOTA06, "05")) {
					if (!"00".equals(SKUG05)) {
						row.put("ALOTA01", "3800"); // 3800: 제품/상품/반제품
					}
				}
				// 보류, 불용, 폐기
				else {
					row.put("ALOTA01", "00".equals(SKUG05) ? "1900" : "3900");
				}
			}
			else if (StringUtils.equals   ( LOTA02, "P400") == false &&     // P400 플랜트 제외
					 StringUtils.equalsAny( WAREKY, "1100", "1500")  &&     // 거점이 1100, 1500에 해당
					 StringUtils.equalsAny( LOTA06, "00") == false && 		// 재고상태가 정상
					 StringUtils.equals   (ALOTA06, "00")                   // TO재고상태가 정상
			) {
				/*
				row.setModuleCommand("WmsInventory", "WHTRH_ADJDI_LOTA06_00_INFO");
				DataMap data = commonDao.getMap(row);
				if (data != null) {
					row.put("ALOTA01", data.getString("LOTA01"));
				}
				*/
				if (!"00".equals(SKUG05)) {
					row.put("ALOTA01", "3000");
				}
			}
			
			//System.out.println("776:" + row.get("ALOTA01"));
			
			// 재고상태TO가 10(보류)인 경우 LOTA10에 변경사유 setting
			if ("10".equals(ALOTA06)) {
				row.put("ALOTA10", row.getString("AADJRSN"));
			}
			
			/* 2022.06.23 재고상태TO가 50(폐기)인 경우 지번 변경 (SCRLOC: 폐기) */
			if ("50".equals(ALOTA06)) {
				row.put("ALOCAKY", "SCRLOC");
			}
			
			String SAPSTS = getSAPSTS(docuty, row);
			row.put("SAPSTS", SAPSTS);
			
			mList.add(row);
			if (mList.size() == subSize || i == targetList.size() - 1) {
				commonDao.insert("ADJDI_MULTI_STOKKY", mList);
				mList.clear();
			}
			
			/* 인터페이스 데이터 세팅 */
			if (!"X".equals(SAPSTS)) {
				DataMap ifData = setInterfaceData(docuty, row);
				map.clonSessionData(ifData);
				ifList.add(ifData);
			}
		}
		
		if (CollectionUtils.isEmpty(ifList) == false) {
			// 인터페이스 파라미터 설정
			DataMap ifMap = new DataMap();
			map.clonSessionData(ifMap);
			ifMap.put("IFID", getIFID(docuty));
			ifMap.put("list", ifList);
			ifMap.put("LOGSEQNO", this.getIFLogSeqNo());
			ifMap.put(CommonConfig.MENU_ID_KEY, map.get(CommonConfig.MENU_ID_KEY));
			ifService.dataInsertIF(ifMap); // IF DB insert
			ifMap.remove("list"); // sendIF 시 불필요.
			
			// 2022.07.13 동일 트랜잭션으로 처리
			DataMap sapReq = new DataMap();
			sapReq.put("SADJKY", docSeq);
			sapReq.put("ifMap", ifMap);
			DataMap result = sendIF(sapReq);
			
			String SAPRES = result.getString("SAPRES");
			if ("SUCCESS".equals(SAPRES)) {
				ifList.clear();
				transactionSavepoint = transactionStatus.createSavepoint();
			} else {
				transactionStatus.rollbackToSavepoint(transactionSavepoint);
				
				result.put("ZDOCNO", docSeq);
				result.put("ERRTXT", SAPRES);
				result.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
				result.put("PROGID", map.get(CommonConfig.MENU_ID_KEY));
				result.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
				result.setModuleCommand("WmsInventory", "IFSAPLOG");
				commonDao.insert(result);
				
				transactionManager.commit(transactionStatus);
				
				DataMap rsMap = new DataMap();
				rsMap.put("SAPRES", SAPRES);
				return rsMap;
			}
		}
		
		transactionManager.commit(transactionStatus);
		DataMap rsMap = new DataMap();
		rsMap.put("SADJKY", docSeq);
//		rsMap.put("ifMap", ifMap);
		return rsMap;
	}
	
	private DataMap validateAndSortADJ (String docuty, DataMap map) throws Exception {
		DataMap labelMap   = commonLabel.getLabel("KR");
		DataMap messageMap = commonLabel.getMessage("KR");
		
		String message = "";
		String label   = "";

//		String SAPSTS = "";
		List<DataMap> list = map.getList("list");
		if (CollectionUtils.isEmpty(list)) {
			message = messageMap.getString("INV_M0055"); // 기존값과 동일합니다. 확인해주세요.
			message = getMessage(message);
			throw new Exception(message);
		}
		
		/** 문서유형에 따라 SAPSTS 세팅, 데이터 가공
		 * @see 2021. mes-wms 구축\산출물\Ⅱ.수행관리\2.WMS 수행\200.설계단계\04.프로그램 설계\96.깨끗한나라_WMS_문서유형 정의서
		 *  */
		switch(docuty) {
			case "402": // 재고상태변경
				for (int i = 0; i < list.size(); i++) {
					DataMap row = list.get(i).getMap("map");
					String  LOTA06 = row.getString( "LOTA06").trim();
					String ALOTA06 = row.getString("ALOTA06").trim();
					
					if (StringUtils.isEmpty(ALOTA06)) {
						message = messageMap.getString("VALID_required"); // {0} 은(는) 필수 입력항목입니다.
						label   = labelMap.getString("STD_LOTA06");
						message = getMessage(message, label);
						throw new Exception(message);
					}
					if (StringUtils.equals(LOTA06, ALOTA06)) { // FR, TO 재고상태 동일
						message = messageMap.getString("INV_M0055"); // 기존값과 동일합니다. 확인해주세요.
						message = getMessage(message);
						throw new Exception(message);
					}
					
					double AQTADJU = Utils.parseDouble(row.get("AQTADJU"));
					double  QTSIWH = Utils.parseDouble(row.get("QTSIWH"));
					
					if (AQTADJU <= 0) { // 조정수량 <= 0
						message = messageMap.getString("TASK_M0021"); // 작업수량은 {0}보다 커야 됩니다.
						message = message.replace("{0}", "0");
						message = getMessage(message);
						throw new Exception(message);
					}
					if (AQTADJU > QTSIWH) { // 조정수량 > 재고수량
						message = messageMap.getString("INV_M0072"); // 재고수량보다 더 많이 조정할 수 없습니다.
						message = getMessage(message);
						throw new Exception(message);
					}
					
					/* 2022.06.23 재고상태TO가 10, 30, 50인 경우 제품군에 따라 저장위치 변경 (P400 플랜트 제외) */
					String LOTA01 = row.getString("LOTA01");
					String LOTA02 = row.getString("LOTA02");
					String SKUG05 = row.getString("SKUG05");
					String WAREKY = row.getString("WAREKY");
					
					/**
					 * 1. 2023.07.25 강내창고의 상태 변경시 저장위치 미변경
					 *  - (P400 플랜트 제외) && (거점: 1100, 1500) && (강내창고 (P200 OR P300) && 3500 저장위치)
					 *   >> 저장위치 변경없음
					 * 
					 * 2. 2024.12.13 영보창고의 상태 변경시 저장위치 미변경
					 *  - 거점: 1100 && P100 && 3400 저장위치)
					 *   >> 저장위치 변경없음
					 *   
					 * 3. 기존조건
					 *  - (P400 플랜트 제외) && (거점: 1100, 1500) && (TO재고상태: 보류, 불용, 폐기, 품질)
					 *   ㄴ 품질:
					 *   	>> 저장위치(원자재): 저장위치 유지
					 *   	>> 저장위치(세품/상품/반제품): 3800
					 *   ㄴ 그외
					 *   	>> 저장위치(원자재): 1900
					 *   	>> 저장위치(세품/상품/반제품): 3900
					 * 
					 * 4. 2022. 10. 10 재고상태변경 시 보류, 불용, 폐기에서 정상으로 변경되는 경우 기존 정상 상태의 저장위치로 세팅
					 *    2023. 07. 25 재고상태변경 시 보류, 불용, 폐기에서 정상으로 변경되는 경우 저장위치 3000 세팅
					 *  - (P400 플랜트 제외) && (거점: 1100, 1500) && (FROM재고상태: 정상 아닐때) && (TO재고상태: 정상)
					 *   >> 저장위치(원자재): 변경없음
					 *   >> 저장위치(세품/상품/반제품): 3000 고정
					 *   
					 * 5. 2023.08.08 제상품외부창고 3300위치 저장위치 미변경
					 * 
					 * 
					 * */
					if (StringUtils.equals   ( LOTA02, "P400") == false && // P400 플랜트 제외
						StringUtils.equalsAny( WAREKY, "1100", "1500")  && // 거점이 1100, 1500에 해당
						StringUtils.equals   ( LOTA01, "3500") && 		   // 강내창고 3500위치
						StringUtils.equalsAny( LOTA02, "P200", "P300")) {

					}
					else if (StringUtils.equalsAny( WAREKY, "1100")  && 	// 거점이 1100 해당
							StringUtils.equals   ( LOTA01, "3400") && 		// 영보창고 3400위치
							StringUtils.equalsAny( LOTA02, "P100")) {
					}
					else if (StringUtils.equals  ( LOTA02, "P400") == false && // P400 플랜트 제외
							StringUtils.equalsAny( WAREKY, "1100")  && 		   // 거점이 1100 해당
							StringUtils.equals   ( LOTA01, "3300") && 		   // 제상품외부창고 3300위치
							StringUtils.equalsAny( LOTA02, "P100")) {
						
					}
					else if (StringUtils.equals   ( LOTA02, "P400") == false && // P400 플랜트 제외
						StringUtils.equalsAny( WAREKY, "1100", "1500")  && 		// 거점이 1100, 1500에 해당
						StringUtils.equalsAny(ALOTA06, "10", "30", "50", "05")  // TO재고상태가 보류, 불용, 폐기, 품질에 해당
					) {
						// 품질
						if (StringUtils.equals   ( ALOTA06, "05")) {
							if (!"00".equals(SKUG05)) {
								row.put("ALOTA01", "3800"); // 3800: 제품/상품/반제품
							}
						}
						// 보류, 불용, 폐기
						else {
							row.put("ALOTA01", "00".equals(SKUG05) ? "1900" : "3900");
						}
					}
					else if (StringUtils.equals   ( LOTA02, "P400") == false &&     // P400 플랜트 제외
							 StringUtils.equalsAny( WAREKY, "1100", "1500")  &&     // 거점이 1100, 1500에 해당
							 StringUtils.equalsAny( LOTA06, "00") == false && 		// 재고상태가 정상 아니면서
							 StringUtils.equals   (ALOTA06, "00")                   // TO재고상태가 정상
					) {
						/*
						row.setModuleCommand("WmsInventory", "WHTRH_ADJDI_LOTA06_00_INFO");
						DataMap data = commonDao.getMap(row);
						if (data != null) {
							row.put("ALOTA01", data.getString("LOTA01"));
						}
						*/
						if (!"00".equals(SKUG05)) {
							row.put("ALOTA01", "3000");
						}
					}
					
					// 재고상태TO가 10(보류)인 경우 LOTA10에 변경사유 setting
					if ("10".equals(ALOTA06)) {
						row.put("ALOTA10", row.getString("AADJRSN"));
					}
					
					/* 2022.06.23 재고상태TO가 50(폐기)인 경우 지번 변경 (SCRLOC: 폐기) */
					if ("50".equals(ALOTA06)) {
						row.put("ALOCAKY", "SCRLOC");
					}
					
					// 240124 HNW 재고상태(TO) 변경 시, 조정상세사유 세팅(보류 -> 품질, 품질 -> 불용 등 변경하여도 LOTA10이 유지되는 현상 방지)
					row.put("ALOTA10", row.getString("AADJRSN"));	//이전 재고상태값

					list.set(i, row);
				}
				break;
			case "401": // 재고저장위치변경
				DataMap param = new DataMap();
				map.clonSessionData(param);
				param.put("WAREKY", map.get("WAREKY"));
				param.setModuleCommand("WmsInventory", "STLMA"); // 저장위치 리스트 조회
				List<DataMap> STLMAList = commonDao.getList(param);
				
				for (int i = 0; i < list.size(); i++) {
					DataMap row = list.get(i).getMap("map");
					String  LOTA01 = row.getString( "LOTA01").trim();
					String ALOTA01 = row.getString("ALOTA01").trim();
					String  LOTA02 = row.getString( "LOTA02").trim();
					String ALOTA02 = row.getString("ALOTA02").trim();
					double AQTADJU = Utils.parseDouble(row.get("AQTADJU"));
					double  QTSIWH = Utils.parseDouble(row.get("QTSIWH"));
					
					if (StringUtils.isEmpty(ALOTA01)) {
						message = messageMap.getString("VALID_required"); // {0} 은(는) 필수 입력항목입니다.
						label   = labelMap.getString("STD_LOTA01");
						message = getMessage(message, label);
						throw new Exception(message);
					}
					
					if (StringUtils.isEmpty(ALOTA02)) {
						message = messageMap.getString("VALID_required"); // {0} 은(는) 필수 입력항목입니다.
						label   = labelMap.getString("STD_LOTA02");
						message = getMessage(message, label);
						throw new Exception(message);
					}
					
					if (StringUtils.equals(LOTA01, ALOTA01) &&
						StringUtils.equals(LOTA02, ALOTA02)) {
						message = messageMap.getString("INV_M0055"); // 기존값과 동일합니다. 확인해주세요.
						label   = labelMap.getString("STD_LOTA02");
						message = getMessage(message, label);
						throw new Exception(message);
					}
				
					if (
						(StringUtils.equals(LOTA01, "3800") && StringUtils.equals(ALOTA01, "3900")) ||
						(StringUtils.equals(LOTA01, "3900") && StringUtils.equals(ALOTA01, "3800"))
					){
							message = messageMap.getString("INV_M0089"); // 3800 3900 저장위치 불가
							label   = "";
							message = getMessage(message, label);
							throw new Exception(message); 
					}
					
					if (AQTADJU <= 0) { // 조정수량 <= 0
						message = messageMap.getString("TASK_M0021"); // 작업수량은 {0}보다 커야 됩니다.
						message = message.replace("{0}", "0");
						message = getMessage(message);
						throw new Exception(message);
					}
					if (AQTADJU > QTSIWH) { // 조정수량 > 재고수량
						message = messageMap.getString("INV_M0072"); // 재고수량보다 더 많이 조정할 수 없습니다.
						message = getMessage(message);
						throw new Exception(message);
					}
					
					/* 저장위치 validate */
					if(STLMAList != null && STLMAList.size() > 0) {
						boolean valid = false;
						/* 저장위치 리스트에서 PLNTKY == ALOTA02 && STLKY == ALOTA01인 데이터 존재 시 true, 미존재시 false */
						for (DataMap data : STLMAList) {
							if (StringUtils.equals(data.getString("PLNTKY"), ALOTA02) &&
								StringUtils.equals(data.getString("STLKY" ), ALOTA01)) {
								valid = true;
								break;
							}
						}
						
						if (STLMAList != null && STLMAList.size() > 0 && valid == false) {
							message = messageMap.getString("VALID_remote"); // {0} 값이 유효하지 않습니다.
							label   = labelMap.getString("STD_LOTA01_TO");
							message = getMessage(message, label);
							throw new Exception(message);
						}
					}
					
					/* 변경될 플랜트에서 관리되는 품목인지 조회 */
					String  SKUKEY   = row.getString("SKUKEY");
					DataMap validate = commonDao.getMap("WmsInventory.SKUPLT_VALIDATE", row);
					
					if (validate == null || !"1".equals(validate.getString("RESULT"))) {
						throw new Exception("해당 품목(" + SKUKEY  + ")은 플랜트 " + ALOTA02 + "의 관리대상 품목이 아닙니다.");
					}
					
					list.set(i, row);
				}
				break;
			case "421": // 품목코드변경 (MTM)
				for (int i = 0; i < list.size(); i++) {
					DataMap row = list.get(i).getMap("map");
					String  SKUKEY = row.getString( "SKUKEY").trim();
					String ASKUKEY = row.getString("ASKUKEY").trim();
					double AQTADJU = Utils.parseDouble(row.get("AQTADJU"));
					double  QTSIWH = Utils.parseDouble(row.get("QTSIWH"));
					
					if (StringUtils.isEmpty(ASKUKEY)) {
						message = messageMap.getString("VALID_required"); // {0} 은(는) 필수 입력항목입니다.
						label   = labelMap.getString("STD_SKUKEY_TO");
						message = getMessage(message, label);
						throw new Exception(message);
					}
					
					if (StringUtils.equals(SKUKEY, ASKUKEY)) {
						message = messageMap.getString("INV_M0055"); // 기존값과 동일합니다. 확인해주세요.
						message = getMessage(message);
						throw new Exception(message);
					}
					
					if (AQTADJU <= 0) { // 조정수량 <= 0
						message = messageMap.getString("TASK_M0021"); // 작업수량은 {0}보다 커야 됩니다.
						message = message.replace("{0}", "0");
						message = getMessage(message);
						throw new Exception(message);
					}
					
					if (AQTADJU > QTSIWH) { // 조정수량 > 재고수량
						message = messageMap.getString("INV_M0072"); // 재고수량보다 더 많이 조정할 수 없습니다.
						message = getMessage(message);
						throw new Exception(message);
					}
					
					if (StringUtils.equals(SKUKEY, "HWD-Z100001W") && StringUtils.equals(ASKUKEY, "1401048") == false ||
						StringUtils.equals(SKUKEY, "HWD-Z100002W") && StringUtils.equals(ASKUKEY, "1401049") == false ||
						StringUtils.equals(SKUKEY, "HWD-Z100004W") && StringUtils.equals(ASKUKEY, "1300009") == false ||
						StringUtils.equals(SKUKEY, "HWD-Z100005W") && StringUtils.equals(ASKUKEY, "1300010") == false
					) {
						throw new Exception(SKUKEY + "에서 " + ASKUKEY + "로 변경할 수 없습니다.");
					}
					
					/* 변경될 플랜트에서 관리되는 품목인지 조회 */
					String ALOTA02 = row.getString("ALOTA02").trim();
					DataMap validate = commonDao.getMap("WmsInventory.SKUPLT_VALIDATE", row);
					
					if (validate == null || !"1".equals(validate.getString("RESULT"))) {
						throw new Exception("해당 품목(" + SKUKEY  + ")은 플랜트 " + ALOTA02 + "의 관리대상 품목이 아닙니다.");
					}
					/* SKUMA 테이블 정보로 세팅해줘야 함. */
					row.setModuleCommand("WmsInventory", "SKUMA");
					DataMap SKUMA = commonDao.getMap(row);
					row.put("ADUOMKY", SKUMA.getString("ADUOMKY"));
					row.put("AUOMKEY", SKUMA.getString("AUOMKEY"));
					row.put("ADESC01", SKUMA.getString("ADESC01"));
					row.put("ADESC02", SKUMA.getString("ADESC02"));
					
					//2022.11.29 다른 단위 수량으로 변경 불가
					String uomkey = row.getString("UOMKEY").trim();
					String auomkey = SKUMA.getString("AUOMKEY").trim();
					if(!StringUtils.equals(uomkey, auomkey)) {
						throw new Exception("[단위] : "+uomkey + "에서 " + auomkey + "로 변경할 수 없습니다.");
					}
					
					list.set(i, row);
				}
				break;
			case "423": // 재고MTO/MTS변경
				for (int i = 0; i < list.size(); i++) {
					DataMap row = list.get(i).getMap("map");
					String  LOTA06 = row.getString( "LOTA06").trim();
					String  LOTA07 = row.getString( "LOTA07").trim();
					String ALOTA07 = row.getString("ALOTA07").trim();
					String  LOTA09 = row.getString( "LOTA09").trim();
					String ALOTA09 = row.getString("ALOTA09").trim();
					double AQTADJU = Utils.parseDouble(row.get("AQTADJU"));
					double  QTSIWH = Utils.parseDouble(row.get("QTSIWH"));
					
					if (StringUtils.equals(LOTA07, ALOTA07) &&
						StringUtils.equals(LOTA09, ALOTA09)) {
						message = messageMap.getString("INV_M0055"); // 기존값과 동일합니다. 확인해주세요.
						message = getMessage(message);
						throw new Exception(message);
					}
					
					if (AQTADJU <= 0) { // 조정수량 <= 0
						message = messageMap.getString("TASK_M0021"); // 작업수량은 {0}보다 커야 됩니다.
						message = message.replace("{0}", "0");
						message = getMessage(message);
						throw new Exception(message);
					}
					
					if (AQTADJU > QTSIWH) { // 조정수량 > 재고수량
						message = messageMap.getString("INV_M0072"); // 재고수량보다 더 많이 조정할 수 없습니다.
						message = getMessage(message);
						throw new Exception(message);
					}
					
					if ("00".equals(LOTA06) == false) {
						throw new Exception("MTO/MTS 변경은 정상 재고만 처리 가능합니다.");
					}
					
					list.set(i, row);
				}
				break;
			case "422": // 제조LOT변경정보
				for (int i = 0; i < list.size(); i++) {
					DataMap row = list.get(i).getMap("map");
					String  LOTA03 = row.getString( "LOTA03").trim();
					String ALOTA03 = row.getString("ALOTA03").trim();
					String  LOTA04 = row.getString( "LOTA04").trim();
					String ALOTA04 = row.getString("ALOTA04").trim();
					String  LOTA08 = row.getString( "LOTA08").trim();
					String ALOTA08 = row.getString("ALOTA08").trim();
					String  LOTA10 = row.getString( "LOTA10").trim();
					String ALOTA10 = row.getString("ALOTA10").trim();
					String  LOTA11 = row.getString( "LOTA11").trim();
					String ALOTA11 = row.getString("ALOTA11").trim();
					String  LOTA12 = row.getString( "LOTA12").trim();
					String ALOTA12 = row.getString("ALOTA12").trim();
					String  LOTA13 = row.getString( "LOTA13").trim();
					String ALOTA13 = row.getString("ALOTA13").trim();
					String  LOTA14 = row.getString( "LOTA14").trim();
					String ALOTA14 = row.getString("ALOTA14").trim();
					double AQTADJU = Utils.parseDouble(row.get("AQTADJU"));
					double  QTSIWH = Utils.parseDouble(row.get("QTSIWH"));
					
					if (StringUtils.equals(LOTA03, ALOTA03) &&
						StringUtils.equals(LOTA04, ALOTA04) &&
						StringUtils.equals(LOTA08, ALOTA08) &&
						StringUtils.equals(LOTA10, ALOTA10) &&
						StringUtils.equals(LOTA11, ALOTA11) &&
						StringUtils.equals(LOTA12, ALOTA12) &&
						StringUtils.equals(LOTA13, ALOTA13) &&
						StringUtils.equals(LOTA14, ALOTA14)) {
						message = messageMap.getString("INV_M0055"); // 기존값과 동일합니다. 확인해주세요.
						message = getMessage(message);
						throw new Exception(message);
					}
					
					if (AQTADJU <= 0) { // 조정수량 <= 0
						message = messageMap.getString("TASK_M0021"); // 작업수량은 {0}보다 커야 됩니다.
						message = message.replace("{0}", "0");
						message = getMessage(message);
						throw new Exception(message);
					}
					if (AQTADJU > QTSIWH) { // 조정수량 > 재고수량
						message = messageMap.getString("INV_M0072"); // 재고수량보다 더 많이 조정할 수 없습니다.
						message = getMessage(message);
						throw new Exception(message);
					}
					
					list.set(i, row);
				}
				break;
			default: break;
		}
		
		/* 이동유형을 기준으로 정렬 */
		Collections.sort(list, new Comparator<DataMap>() {
			@Override
			public int compare(DataMap o1, DataMap o2) {
				return StringUtils.compare(o1.getString("SAPSTS"), o2.getString("SAPSTS"));
			}
		});
		
		map.put("list", list);
		return map;
	}
	

	/** [MV01] 재고이동 */
//	@Transactional(rollbackFor = Exception.class)
	public DataMap MV01CreatTaskOrder(DataMap map) throws Exception {
		DataMap head = map.getMap("head").getMap("map");
		String docuty = head.getString("DOCUTY");
		String docdat = head.getString("DOCDAT");
		
		List<DataMap> list = map.getList("list");
		list = validateAndSortMV(docuty, list, "LOCATG");
		
		TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
		TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
		Object transactionSavepoint = transactionStatus.createSavepoint();
		
		String docnum = wmsService.getDocSeq(docuty);
		head.put("TSPKEY", head.get("AREAKY"));
		head.put("TASKKY", docnum);
		head.put("TASOTY", docuty);
		head.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		head.setModuleCommand("WmsTask", "TASDH");
		commonDao.insert(head);
		
		int itemCount = 0;
		int successCnt = 0;
		String bfSAPSTS = "";
		List<DataMap> sapResList = new ArrayList<>();
		
		for (int i = 0; i < list.size(); i++) {
			DataMap row = list.get(i).getMap("map");
			
			String SAPSTS = row.getString("SAPSTS");
			if ("320".equals(docuty) && // 재고이동 1Step 완료 시 [SJ03] 저장위치변경 TASK 호출 해야함.
				StringUtils.isNotEmpty(bfSAPSTS) &&
				StringUtils.equals(SAPSTS, bfSAPSTS) == false
			) {
				DataMap param = new DataMap();
				param.put("WAREKY"                    , map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY));
				param.put(CommonConfig.MENU_ID_KEY    , map.get(CommonConfig.MENU_ID_KEY));
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				param.put("DOCDAT"					  , docdat);
				DataMap sapResMap = afterMoveStock(docnum, bfSAPSTS, param);
				sapResList.add(sapResMap);
				
				String SAPRES = sapResMap.getString("SAPRES");
				log.debug("Sap Response : " + SAPRES);
				if("SUCCESS".equals(SAPRES)) {
					successCnt = i;
					transactionSavepoint = transactionStatus.createSavepoint();
				} else {
					transactionStatus.rollbackToSavepoint(transactionSavepoint);
					
					sapResMap.put("ZDOCNO", docnum);
					sapResMap.put("ERRTXT", SAPRES);
					sapResMap.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
					sapResMap.put("PROGID", map.get(CommonConfig.MENU_ID_KEY));
					sapResMap.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
					sapResMap.setModuleCommand("WmsInventory", "IFSAPLOG");
					commonDao.insert(sapResMap);
					
					transactionManager.commit(transactionStatus);
					
					DataMap rsMap = new DataMap();
					rsMap.put("successCnt", successCnt);
					rsMap.put("sapResList", sapResList);
					return rsMap;
				}
			}
			
			itemCount += 10;
			String snum = String.format("%06d", itemCount);
			String qtyStr = row.getString("QTTAOR");
			double qty = Utils.parseDouble(qtyStr);
			
			// TASDI insert parameter 생성
			String uomkey = row.getString("UOMKEY");
			row.put("QTSTKM", row.getString("QTTAOR"));
			row.put("QTSTKC", 0);
			row.put("DROPID", "V");
			row.put("TASKKY", docnum);
			row.put("TASKIT", snum);
			row.put("AUOMKY", uomkey);
			row.put("SUOMKY", uomkey);
			row.put("TUOMKY", uomkey);
			row.put("TRNUAC", row.getString("TRNUTG"));
			row.put("SECTAC", row.getString("SECTTG"));
			row.put("PAIDAC", row.getString("PAIDTG"));
			row.put("AMEAKY", row.getString("TMEAKY"));
			row.put("ATRUTY", row.getString("TTRUTY"));
			row.put("ADUOKY", row.getString("TDUOKY"));
			row.put("QTAPUM", row.getString("QTTPUM"));
			row.put("QTSTKM", qty);
			row.put("QTYUOM", qty);
			row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			
			switch(docuty) {
				case "320" : // 1 step
					row.put("STATIT", "FPC");
					row.put("LOCAAC", row.getString("LOCATG"));
					row.put("QTCOMP", qty);
					row.put("QTSTKC", qty);
					break;
				case "325" : // 2 step
					row.put("STATIT", "NEW");
					row.put("QTCOMP", 0); // 2step의 경우 작업수량이 0으로 insert 이후 재고이동 완료에서 조회되도록 해야함 .
					break;
				default : break;
			}
			row.setModuleCommand("WmsTask", "TASDIEND");
			commonDao.insert(row);
			
			// TASDR 프로시져에서 처리
			
			row.put("TASKIR", "0001"); 

			row.setModuleCommand("WmsTask", "TASDR_INS");
			commonDao.insert(row);
			
//			commonDao.getMap("WmsTask.SAVETK_SZP_INS_TASDR", row);
			
			bfSAPSTS = SAPSTS;
		}
		
		if ("320".equals(docuty)) { // 재고이동 1Step 완료 시 [SJ03] 저장위치변경 TASK 호출 해야함.
			DataMap param = new DataMap();
			param.put("WAREKY"                    , map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY));
			param.put(CommonConfig.MENU_ID_KEY    , map.get(CommonConfig.MENU_ID_KEY));
			param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			param.put("DOCDAT"					  , docdat);
			DataMap sapResMap = afterMoveStock(docnum, bfSAPSTS, param); //////////////////
			sapResList.add(sapResMap);
			
			String SAPRES = sapResMap.getString("SAPRES");
			log.debug("Sap Response : " + SAPRES);
			if("SUCCESS".equals(SAPRES)) {
				successCnt = list.size();
				transactionSavepoint = transactionStatus.createSavepoint();
			} else {
				transactionStatus.rollbackToSavepoint(transactionSavepoint);
				
				// 2022.07.14 WMS, SAP이 1개의 트랜잭션으로 구성된 경우 IFSAPLOG INSERT 추가
				sapResMap.put("ZDOCNO", docnum);
				sapResMap.put("ERRTXT", SAPRES);
				sapResMap.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
				sapResMap.put("PROGID", map.get(CommonConfig.MENU_ID_KEY));
				sapResMap.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
				sapResMap.setModuleCommand("WmsInventory", "IFSAPLOG");
				commonDao.insert(sapResMap);
				
				transactionManager.commit(transactionStatus);
				
				DataMap rsMap = new DataMap();
				rsMap.put("successCnt", successCnt);
				rsMap.put("sapResList", sapResList);
				return rsMap;
			}
		}
		
		transactionManager.commit(transactionStatus);
		DataMap rsMap = new DataMap();
		rsMap.put("successCnt", successCnt);
		rsMap.put("sapResList", sapResList);
		rsMap.put("TASKKY", docnum);
		return rsMap;
	}


