	//	@Transactional(rollbackFor = Exception.class)
	public DataMap MV02CreatTaskOrder(DataMap map) throws Exception {
		List<DataMap> headList = map.getList("head");
		
		if (headList == null || headList.size() < 1) {
			throw new Exception("작업대상이 존재하지 않습니다.");
		}
		
		DataMap head = headList.get(0).getMap("map");
		String TASKKY = head.getString("TASKKY");
		String docuty = head.getString("DOCUTY");
		
		List<DataMap> list = map.getList("list");
		list = validateAndSortMV(docuty, list, "LOCAAC");
		
		if (CollectionUtils.isEmpty(list)) {
			throw new Exception("작업대상이 존재하지 않습니다.");
		}
		
		TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
		TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
		Object transactionSavepoint = transactionStatus.createSavepoint();
		
		String bfSAPSTS = "";
		int successCnt = 0;
		List<DataMap> sapResList = new ArrayList<>();
		for (int i = 0; i < list.size(); i++) {
			DataMap row = list.get(i);
			String SAPSTS = row.getString("SAPSTS");
			
			if (StringUtils.isNotEmpty(bfSAPSTS) &&
				StringUtils.equals(SAPSTS, bfSAPSTS) == false
			) {
				// 재고이동 2Step 이동유형별 [SJ03] 저장위치변경 TASK 호출 해야함.
				DataMap param = new DataMap();
				
				param.put("WAREKY"                    , map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY));
				param.put(CommonConfig.MENU_ID_KEY    , map.get(CommonConfig.MENU_ID_KEY));
				param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				DataMap sapResMap = afterMoveStock(TASKKY, bfSAPSTS, param);
				sapResList.add(sapResMap);
				
				String SAPRES = sapResMap.getString("SAPRES");
				log.debug("Sap Response : " + SAPRES);
				if("SUCCESS".equals(SAPRES)) {
					successCnt = i;
					transactionSavepoint = transactionStatus.createSavepoint();
				} else {
					transactionStatus.rollbackToSavepoint(transactionSavepoint);
					
					sapResMap.put("ZDOCNO", TASKKY);
					sapResMap.put("ERRTXT", SAPRES);
					sapResMap.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
					sapResMap.put("PROGID", map.get(CommonConfig.MENU_ID_KEY));
					sapResMap.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
					sapResMap.setModuleCommand("WmsInventory", "IFSAPLOG");
					commonDao.insert(sapResMap);
					
					transactionManager.commit(transactionStatus);
					
					DataMap rsMap = new DataMap();
					rsMap.put("successCnt", successCnt);
					rsMap.put("sapResList", sapResList);
					return rsMap;
				}
			}
			
			row.setModuleCommand("WmsTask", "TASDIDEL");
			commonDao.delete(row);
			
			String qtcompStr = row.getString("QTCOMP");
			double qtcomp = Utils.parseDouble(qtcompStr);
			if (qtcomp > 0) {
				row.put("STATIT", "FPA");
				row.put("QTTAOR", row.get("QTCOMP"));
				row.put("TRNUTG", row.get("TRNUAC"));
				row.put("QTYUOM", row.get("QTCOMP"));
				
				row.put("SECTAC", row.get("SECTTG"));
				row.put("PAIDAC", row.get("PAIDTG"));
				row.put("ATRUTY", row.get("TTRUTY"));
				row.put("AMEAKY", row.get("TMEAKY"));
				
				row.put("AUOMKY", row.get("TUOMKY"));
				row.put("QTAPUM", row.get("QTTPUM"));
				row.put("ADUOKY", row.get("TDUOKY"));
				row.put("QTADUM", row.get("QTTDUM"));
				
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				row.setModuleCommand("WmsTask", "TASDIEND");
				commonDao.insert(row);
				
				// TASDR 프로시져에서 처리
				row.put("STOKKY", "%");
				commonDao.getMap("WmsTask.DBMSPROC_SZP_INS_TASDR", row);
			}
			
			bfSAPSTS = SAPSTS;
		}
		
		if (successCnt != list.size() &&
			StringUtils.isNotEmpty(bfSAPSTS)
		) {
			// 재고이동 2Step 이동유형별 [SJ03] 저장위치변경 TASK 호출 해야함.
			DataMap param = new DataMap();
			
			param.put("WAREKY"                    , map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY));
			param.put(CommonConfig.MENU_ID_KEY    , map.get(CommonConfig.MENU_ID_KEY));
			param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			DataMap sapResMap = afterMoveStock(TASKKY, bfSAPSTS, param);
			sapResList.add(sapResMap);
			
			String SAPRES = sapResMap.getString("SAPRES");
			log.debug("Sap Response : " + SAPRES);
			if("SUCCESS".equals(SAPRES)) {
				successCnt = list.size();
				transactionSavepoint = transactionStatus.createSavepoint();
			} else {
				transactionStatus.rollbackToSavepoint(transactionSavepoint);
				
				// 2022.07.14 WMS, SAP이 1개의 트랜잭션으로 구성된 경우 IFSAPLOG INSERT 추가
				sapResMap.put("ZDOCNO", TASKKY);
				sapResMap.put("ERRTXT", SAPRES);
				sapResMap.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
				sapResMap.put("PROGID", map.get(CommonConfig.MENU_ID_KEY));
				sapResMap.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
				sapResMap.setModuleCommand("WmsInventory", "IFSAPLOG");
				commonDao.insert(sapResMap);
				
				transactionManager.commit(transactionStatus);
				
				DataMap rsMap = new DataMap();
				rsMap.put("successCnt", successCnt);
				rsMap.put("sapResList", sapResList);
				return rsMap;
			}
		}
		
		transactionManager.commit(transactionStatus);
		
		DataMap rsMap = new DataMap();
		rsMap.put("successCnt", successCnt);
		rsMap.put("sapResList", sapResList);
		return rsMap;
	}
	
	private List<DataMap> validateAndSortMV(String docuty, List<DataMap> list, String targetLocKey) throws Exception {
		List<DataMap> temp = new ArrayList<>();
		
		if (CollectionUtils.isEmpty(list)) {
			throw new Exception("변경된 내역이 존재하지 않습니다.");
		}
		
		for (int i = 0; i < list.size(); i++) {
			DataMap row = list.get(i).getMap("map");
			String WAREKY = row.getString("WAREKY");
			String LOTA02 = row.getString("LOTA02");
			
//			if (StringUtils.equals("1100", WAREKY) &&
//				StringUtils.isBlank(row.getString("LOTA07")) == false
//			) {
//				row.setModuleCommand("WmsInventory", "LOTA07_VALIDATE");
//				DataMap validate = commonDao.getMap(row);
//				if (validate != null && "FAIL".equals(validate.get("RESULT"))) {
//					throw new Exception("해당지번[" + row.getString("LOCAKY") + "]에 다른 MTO 재고가 존재합니다.");
//				}
//			}
			
			// 변경될 플랜트 조회
			DataMap LOCAKYval2param = new DataMap();
			LOCAKYval2param.put("WAREKY", WAREKY);
			LOCAKYval2param.put("ALOCAKY", row.getString(targetLocKey));
			LOCAKYval2param.setModuleCommand("WmsTask", "LOCAKYval2");
			DataMap LOCAKYval2 = commonDao.getMap(LOCAKYval2param);
			
			String ALOTA02 = LOCAKYval2.getString("PLNTKY");
			String ALOTA01 = LOCAKYval2.getString("STLKY");
			if (StringUtils.isBlank(ALOTA02) ||
				StringUtils.isBlank(ALOTA01)
			) {
				ALOTA02 = row.getString("LOTA02");
				ALOTA01 = row.getString("LOTA01");
			}
			row.put("ALOTA02", ALOTA02);
			row.put("ALOTA01", ALOTA01);
			
			/* 2022.09.22 P200 => P300이거나 P300 => P200인 경우 혼적 가능하도록 기존 플랜트로 세팅 */
			if ((StringUtils.equals("P200", LOTA02) && StringUtils.equals("P300", ALOTA02)) ||
				(StringUtils.equals("P300", LOTA02) && StringUtils.equals("P200", ALOTA02))
			) {
				row.put("ALOTA02", LOTA02);
			}
			
			// 변경될 플랜트에서 관리되는 품목인지 VALIDATE
			DataMap validate = commonDao.getMap("WmsInventory.SKUPLT_VALIDATE", row);
			if (validate == null || !"1".equals(validate.getString("RESULT"))) {
//				String ALOTA02 = row.getString("ALOTA02");
				String SKUKEY  = row.getString("SKUKEY");
				throw new Exception("해당 품목(" + SKUKEY  + ")은 플랜트 " + ALOTA02 + "에서 관리중인 품목이 아닙니다.");
			}
			
			List<String> keyList = null;
			validate = new DataMap();;
			if (StringUtils.equals("320", docuty)) { // 재고이동 1Step
				validate = commonDao.getMap("WmsInventory.STKKY_VALIDATE", row);
				keyList = Arrays.asList(
							  row.getString("STOKKY")
						  );
			} else if ( // 재고이동 2Step
				StringUtils.equals("325", docuty) &&
				StringUtils.equals("", row.getString("TASKKY").trim()) == false &&
				StringUtils.equals("", row.getString("TASKIT").trim()) == false
			) {
				validate = commonDao.getMap("WmsInventory.TASK_VALIDATE" , row);
				keyList = Arrays.asList(
							  row.getString("TASKKY")
							, row.getString("TASKIT")
						  );
			}
			
			if (validate == null) {
				throw new Exception("해당 재고를 찾을 수 없습니다." + keyList.toString());
			} else if(StringUtils.isNotEmpty(validate.getString("ERRMSG"))) {
				throw new Exception(validate.getString("ERRMSG") + keyList.toString());
			}
			
			String SAPSTS = getSAPSTS(docuty, row);
			row.put("SAPSTS", SAPSTS);
			temp.add(row);
		}
		
		/* 이동유형을 기준으로 정렬 */
		Collections.sort(temp, new Comparator<DataMap>() {
			@Override
			public int compare(DataMap o1, DataMap o2) {
				return StringUtils.compare(o1.getString("SAPSTS"), o2.getString("SAPSTS"));
			}
		});
		return temp;
	}
	
	/** 재고이동 완료 후<br>
	 *  변경될 저장위치 조회하여 재고저장위치변경 method 호출
	 */
	private DataMap afterMoveStock(String TASKKY, String SAPSTS, DataMap userInfo) throws SQLException {
		// docunum으로 대상 LIST 조회
		DataMap param = new DataMap();
		param.put("TASKKY", TASKKY);
		param.put("SAPSTS", SAPSTS);
		param.setModuleCommand("WmsInventory", "AFTER_MOVE_STOCK");
		List<DataMap> list = commonDao.getList(param);
		
		/* 2022.09.22 P200 => P300이거나 P300 => P200인 경우 혼적 가능하도록 변경 */
		list = list.stream().filter(row -> {
			String  LOTA02 = row.getString( "LOTA02");
			String ALOTA02 = row.getString("ALOTA02");
			String LOTA01  = row.getString( "LOTA01");
			String ALOTA01 = row.getString("ALOTA01");
			
			// 저장위치 (정상, 보류, 품질 상태)에서 재고 이동시 SAP I/F 미연동 처리 (지번만 변경 처리, 20250204 3000번 조건추가)
			if (!StringUtils.equals(LOTA01, ALOTA01) && ("3000".equals(LOTA01) || "3800".equals(LOTA01) || "3900".equals(LOTA01))) {
				// 2025.03.19 kyh 저장위치 변경 수행 (강내 ↔ PS강내)
				if (("3000".equals(LOTA01) && "3400".equals(ALOTA01)) || "3400".equals(LOTA01) && "3000".equals(ALOTA01)) {
				} else {
					return false;
				}
			}
			
			if ((StringUtils.equals("P200", LOTA02) && StringUtils.equals("P300", ALOTA02)) ||
				(StringUtils.equals("P300", LOTA02) && StringUtils.equals("P200", ALOTA02))
			) {
				return !StringUtils.equals(LOTA01, ALOTA01);
			}
			
			return true;
		}).collect(Collectors.toList());
		
		if (CollectionUtils.isEmpty(list)) {
			param.put("SAPRES", "SUCCESS");
			return param;
		}
		
		param = new DataMap();
		param.putAll(userInfo);
		param.put("list", list);
		param.put("DOCUTY", "401"); // 401: 재고저장위치변경
		
		return saveAdjByTask(param);
	}
	
	/** 재고이동 */
	@Transactional(rollbackFor = Exception.class)
	public DataMap RecommendLocation(DataMap map) throws SQLException {
		DataMap rstMap = new DataMap();
		List<DataMap> retList = new ArrayList<>();
		try {
			List<DataMap> list = map.getList("list");
			for (int i = 0; i < list.size(); i++) {
				DataMap row = list.get(i).getMap("map");
				row.put("LOTNUM", row.getString("LOTNUM"));
				row.setModuleCommand("WmsInventory", "GUIDE_LOCATION_PROC_CALL");
				commonDao.update(row);
				retList.add(row);
			}
		} catch (Exception e) {
			rstMap.put("MSG", "FAIL");
			return rstMap;
		}
		rstMap.put("list", retList);
		rstMap.put("MSG", "OK");
		return rstMap;
	}
	
	/** 재고실사지시 */
	@Transactional(rollbackFor = Exception.class)
	public String saveIP01(DataMap map) throws SQLException {
		DataMap head = map.getMap("head").getMap("map");
		List<DataMap> list = map.getList("list");
		
		String docuty = head.getString("DOCUTY");
		String docnum = wmsService.getDocSeq(docuty);
		
		// insert head
		map.clonSessionData(head);
		head.put("PHYIKY", docnum);
		head.setModuleCommand("WmsInventory", "PHYDH");
		commonDao.insert(head);
		
		// insert item
		List<HashMap> mList = new ArrayList<>();
		int subSize = 100;
		for (int i = 0; i < list.size(); i++) {
			DataMap row = list.get(i).getMap("map");
			map.clonSessionData(row);
			
			row.put("PHYIKY", docnum);
			row.put("PHYIIT", String.format("%06d", (i + 1) * 10));
			
			
			mList.add(row);
			if (mList.size() == subSize || i == list.size() - 1) {
				commonDao.insert("PHYDI_MULTI", mList);
				mList.clear();
			}
		}
		return docnum;
	}
	
