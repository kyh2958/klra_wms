@Service
public class InventoryService {

	private static Logger log = Logger.getLogger(InventoryService.class);
	
	@Autowired
	public CommonDAO commonDao;
	
	@Autowired
	private WmsService wmsService;
	
	@Autowired
	private IFService ifService;
	
	@Autowired
	private CommonLabel commonLabel;
	
	@Autowired 
	private PlatformTransactionManager transactionManager;
	
	/** TASK 데이터 생성 이후 재고조정 필요 시
	 * <pre>
	 * DOCUTY     : required String
	 * WAREKY     : required String
	 * SES_USER_ID: required String
	 * list:[{
	 *     TASKKY    : required String
	 *     TASKIT    : required String
	 *     ALOTA01~20: optional String
	 * }]
	 * 
	 * * DOCUTY:{
	 *     401: 재고저장위치변경
	 *     402: 재고상태변경
	 *     421: 재고품목변경(MtoM)
	 *     422: 재고LOT속성변경
	 *     423: 재고MTO변경
	 * }
	 * <pre/>
	 * */
	@Transactional(rollbackFor = Exception.class)
	public DataMap saveAdjByTask (DataMap param) throws SQLException {
		// validate list
		List<DataMap> list = param.getList("list");
		String docuty = param.getString("DOCUTY");
		String wareky = param.getString("WAREKY");
		String userId = param.getString(CommonConfig.SES_USER_ID_KEY);
		
		if (StringUtils    .isEmpty(docuty)) { new SQLException("required DOCUTY"); }
		if (StringUtils    .isEmpty(wareky)) { new SQLException("required WAREKY"); }
		if (StringUtils    .isEmpty(userId)) { new SQLException("required " + CommonConfig.SES_USER_ID_KEY); }
		if (CollectionUtils.isEmpty(list)  ) { new SQLException("empty list"); }
		
		/* 2022.05.20 재고저장위치변경 시 ALOTA01, ALOTA02가 비어있지 않은 데이터만 필터링 */
		if("401".equals(docuty)) {
			list = list.stream().filter(row -> {
				String ALOTA01 = row.getString("ALOTA01").trim();
				String ALOTA02 = row.getString("ALOTA02").trim();
				return StringUtils.isNotEmpty(ALOTA01) && StringUtils.isNotEmpty(ALOTA02);
			}).collect(Collectors.toList());
			
			/* 필터링 후 데이터 없다면 return */
			if (CollectionUtils.isEmpty(list)) {
				return param;
			}
			
			param.put("list", list);
		}
		
		String docSeq = wmsService.getDocSeq(docuty); // 문서번호생성
		log.debug("docSeq: " + docSeq);

		// ADJDH INSERT
		DataMap copyParam = (DataMap) param.clone();
		copyParam.setModuleCommand("WmsInventory", "SJ03");
		List<DataMap> headList = commonDao.getList(copyParam);
		DataMap head = headList.get(0);
		head.put("SADJKY", docSeq);
		head.put(CommonConfig.SES_USER_ID_KEY, userId);
		head.setModuleCommand("WmsInventory", "ADJDH");
		commonDao.update(head);

		// 1. 재고 조정 전 validate
		// 2. I/F대상 조회 (TASKKY, TASKKIT 기준)
		// 3. ADJDI INSERT
		int itemCount = 0;
		List<DataMap> ifList = new ArrayList<>();
		// validate, set interface data
		for (DataMap row : list) {
			String taskky = row.getString("TASKKY");
			String taskit = row.getString("TASKIT");
			
			if (StringUtils.isEmpty(taskky)) { throw new SQLException("required TASKKY"); }
			if (StringUtils.isEmpty(taskit)) { throw new SQLException("required TASKIT"); }
			
			row.put(CommonConfig.SES_USER_ID_KEY, userId);
			row.put("WAREKY", wareky);
			row.put("SADJKY", docSeq);
			
			itemCount += 10;
			row.put("SADJIT", itemCount);
			row.put("SADJIT", String.format("%06d", itemCount));
			row.put("DOCUTY", docuty);
			
			// 재고 조정 전 I/F 대상 조회
			row.setModuleCommand("WmsInventory", "ADJDI_TASKKY");
			List<DataMap> ifDataList = commonDao.getList(row);
			for (int i = 0; i < ifDataList.size(); i++) {
				DataMap data  = ifDataList.get(i);
				
				// 변경될 플랜트에서 관리되는 품목인지 VALIDATE
				DataMap validate = commonDao.getMap("WmsInventory.SKUPLT_VALIDATE", data);
				if (validate == null || !"1".equals(validate.getString("RESULT"))) {
					String ALOTA02 = data.getString("ALOTA02");
					String SKUKEY  = data.getString("SKUKEY");
					
					validate = new DataMap();
					validate.put("SAPRES", "해당 품목(" + SKUKEY  + ")은 플랜트 " + ALOTA02 + "에서 관리중인 품목이 아닙니다.");
					return validate;
				}
				
				String SAPSTS = getSAPSTS(docuty, data);
				row.put("SAPSTS", SAPSTS);
				data.put("SAPSTS", SAPSTS);
				
				boolean SAPIFYN = StringUtils.equals("V", head.getString("SAPIFYN"));
				if (!"X".equals(SAPSTS) && SAPIFYN) {
					ifList.add(setInterfaceData(docuty, data));
				}
			}
			
			// [SJ01] 재고상태변경 - TO재고상태가 50(폐기)인 경우
			/* 저장위치, 보류상태 변경은 파라미터로 값이 안넘어오기 때문에 쿼리수정으로 대체 */
			String ALOTA06 = row.getString("ALOTA06");
			if ("402".equals(docuty) && "50".equals(ALOTA06)) {
				row.put("ALOCAKY", "SCRLOC");
			}
			
			row.setModuleCommand("WmsInventory", "ADJDI_TASKKY");
			int result = (int) commonDao.insert(row);
			
			log.debug("insert result = " + result);
			if (result < 1) {
				throw new SQLException("failed insert - taskky : " + taskky + ", taskit : " + taskit);
			}
			
			itemCount += 10;
		}
		
		DataMap rsMap = new DataMap();
		if (CollectionUtils.isEmpty(ifList) == false) {
			// 인터페이스 파라미터 설정
			DataMap ifMap = new DataMap();
			param.clonSessionData(ifMap);
			ifMap.put("IFID", getIFID(docuty));
			ifMap.put("list", ifList);
			ifMap.put("LOGSEQNO", this.getIFLogSeqNo());
			ifMap.put("DOCDAT", param.getString("DOCDAT"));
			ifMap.put(CommonConfig.MENU_ID_KEY, param.get(CommonConfig.MENU_ID_KEY));
			ifService.dataInsertIF(ifMap); // IF DB insert
			
			ifMap.remove("list"); // sendIF 시 불필요.
			
			rsMap.put("SADJKY", docSeq);
			rsMap.put("ifMap", ifMap);
			
			// 2022.07.13 WMS-SAP 동일 트랜잭션으로 처리
			return sendIF(rsMap);
		}
		
		rsMap.put("SAPRES", "SUCCESS");
		return rsMap;
	}
	
	/**
	 * 재고조정
	 * <br> SJ01 재고 상태변경
	 * <br> SJ03 재고 저장위치변경
	 * <br> SJ04 재고 LOT속성변경
	 * <br> SJ05 재고 품목변경
	 * <br> SJ18 재고MTO/MTS변경
	 * <br> param: DataMap head, List&ltDataMap&gt list
	 */
//	@Transactional(rollbackFor = Exception.class)
	public DataMap saveStock (DataMap map) throws Exception {
		DataMap head = map.getMap("head").getMap("map");
		
		String docuty = head.getString("ADJUCA");
		String docdat = head.getString("DOCDAT");
		if (StringUtils.isEmpty(docuty.trim())) {
			throw new Exception("empty ADJUCA");
		}
		
		/* 문서유형 별 validation, set data */
		map = validateAndSortADJ(docuty, map);
		List<DataMap> list = map.getList("list");
		if (CollectionUtils.isEmpty(list)) {
			throw new Exception("empty list");
		}
		
		TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
		TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
		Object transactionSavepoint = transactionStatus.createSavepoint();

		int successCnt = 0;
		List<DataMap> sapResList = new ArrayList<>();
		String docSeq = "";
		boolean SAPIFYN = StringUtils.equals("V", head.getString("SAPIFYN"));
		
		DataMap rsMap = new DataMap();
		
		DataMap errMap = new DataMap();
		
		try {
			docSeq = wmsService.getDocSeq(docuty);
			map.clonSessionData(head);
			head.put("SADJKY", docSeq); // 문서번호
			head.put("ADJFLG", "M");
			
			if (SAPIFYN == false) {
				String doctxt = head.getString("DOCTXT");
				doctxt += StringUtils.isBlank(doctxt) ? "" : ", ";
				doctxt += "SAP 미연동";
				head.put("DOCTXT", doctxt);
			}
			head.setModuleCommand("WmsInventory", "ADJDH");
			commonDao.update(head);
			
			int itemCount = 0;
			List<DataMap> ifList = new ArrayList<>();
			
			String bfSAPSTS = "";
			
			for (int i = 0; i < list.size(); i++) {
				DataMap row = list.get(i).getMap("map");
				String SAPSTS = getSAPSTS(docuty, row);
				
				if (SAPIFYN &&
					CollectionUtils.isEmpty(ifList) == false &&
					StringUtils.equals(SAPSTS, bfSAPSTS) == false
				) {
					// 인터페이스 파라미터 설정
					DataMap ifMap = new DataMap();
					map.clonSessionData(ifMap);
					ifMap.put("IFID", getIFID(docuty));
					ifMap.put("LOGSEQNO", this.getIFLogSeqNo());
					ifMap.put("list", ifList);
					ifMap.put("DOCDAT", docdat);
					ifMap.put(CommonConfig.MENU_ID_KEY, map.get(CommonConfig.MENU_ID_KEY));
					ifService.dataInsertIF(ifMap); // IF DB insert
										
					ifMap.remove("list"); // sendIF 시 불필요.
					
					// 240126 IF ERROR FLAG UPDATE
					errMap.put("errMap", ifMap);
							
					DataMap sapReq = new DataMap();
					sapReq.put("SADJKY", docSeq);
					sapReq.put("ifMap", ifMap);
					
					// 2022.07.13 동일 트랜잭션으로 처리
					DataMap result = sendIF(sapReq);
					sapResList.add(result);
					
					String SAPRES = result.getString("SAPRES");
					if ("SUCCESS".equals(SAPRES)) {
						successCnt = i;
						ifList.clear();
						transactionSavepoint = transactionStatus.createSavepoint();
					} else {
						throw new Exception("SAP : " + SAPRES);
					}
				}
				
				map.clonSessionData(row);
				row.put("SADJKY", docSeq); // 문서번호SAPSTS
				row.put("SAPSTS", SAPSTS);
				
				String qtyStr = row.getString("AQTADJU");
				double qty = Utils.parseDouble(qtyStr);
				
				if (!row.get("STOKKY").equals(" ")) {
					/* ADJDIOLD paramSet */
					itemCount += 10;
					row.put("SADJIT", String.format("%06d", itemCount));
					row.put("QTADJU", qty * -1);
					row.setModuleCommand("WmsInventory", "ADJDIOLD");
					commonDao.insert(row);
				}
				
				/* ADJDI paramSet */
				itemCount += 10;
				row.put("SADJIT", String.format("%06d", itemCount));
				row.put("QTADJU", qty);
				row.put("STOKKY", " ");
				row.put("LOTNUM", " ");
				
				if (StringUtils.equals(docuty, "421")) { /* 재고 품목변경 */
					row.put("UOMKEY",row.get("AUOMKEY"));
					row.put("DUOMKY",row.get("ADUOMKY"));
					row.put("DESC01",row.get("ADESC01"));
					row.put("DESC02",row.get("ADESC02"));
					
					//231215 제품군 추가("SKUG05" 값 변경 처리). 해당 품목의 제품군을 조회해야함.
					/* SKUMA 테이블 정보로 세팅해줘야 함. */
					row.setModuleCommand("WmsInventory", "SKUMA_SKUG");
					DataMap SKUMA = commonDao.getMap(row);
					row.put("SKUG05", SKUMA.getString("SKUG05"));
					
					String barcodCh = row.getString("BARCODCH");
					if(barcodCh.equals("V")) {
						row.setModuleCommand("WmsInventory", "BARCODE_SEQ");
						commonDao.insert(row);
						row.setModuleCommand("WmsInventory", "BARCODE_SEQ");
						DataMap res;
						res = commonDao.getMap(row);
						String reseq = res.getString("CREDATE").substring(2)+"X";
						String seqno = res.getString("SEQNO");
						String str = String.format("%03d", Integer.parseInt(seqno));
						reseq = reseq.concat(str);
						row.put("ALOTA14", reseq);
					}
				}
				
				row.setModuleCommand("WmsInventory", "ADJDI");
				commonDao.insert(row);
				
				if (!"X".equals(SAPSTS) && SAPIFYN) {
					ifList.add(setInterfaceData(docuty, row));
				}
				
				bfSAPSTS = SAPSTS;
			}
			
			if (CollectionUtils.isEmpty(ifList) == false && SAPIFYN) {
				// 인터페이스 파라미터 설정
				DataMap ifMap = new DataMap();
				map.clonSessionData(ifMap);
				ifMap.put("IFID", getIFID(docuty));
				ifMap.put("LOGSEQNO", this.getIFLogSeqNo());
				ifMap.put("list", ifList);
				ifMap.put("DOCDAT", docdat);
				ifMap.put(CommonConfig.MENU_ID_KEY, map.get(CommonConfig.MENU_ID_KEY));
				ifService.dataInsertIF(ifMap); // IF DB insert
				
				ifMap.remove("list"); // sendIF 시 불필요.

				// 240126 IF ERROR FLAG UPDATE
				errMap.putAll(ifMap);
				
				DataMap sapReq = new DataMap();
				sapReq.put("SADJKY", docSeq);
				sapReq.put("ifMap", ifMap);
								
				// 2022.07.13 동일 트랜잭션으로 처리
				DataMap result = sendIF(sapReq);
				sapResList.add(result);
				
				String SAPRES = result.getString("SAPRES");
				log.debug("Sap Response : " + SAPRES);
				
				if("SUCCESS".equals(SAPRES)) {
					successCnt = list.size();
					ifList.clear();
					transactionSavepoint = transactionStatus.createSavepoint();
				} else {
					throw new Exception("SAP : " + SAPRES);
				}
			}
			
			rsMap.put("SADJKY", docSeq);
			rsMap.remove("ifMap");
		} catch (SQLException e) {
			transactionStatus.rollbackToSavepoint(transactionSavepoint);
			
			String msg = e.getMessage();
			if (msg.length() > 300) {
				msg = msg.substring(0, 300);
			}
			
			DataMap result = new DataMap();
			result.put("ZDOCNO", docSeq);
			result.put("ERRTXT", msg);
			result.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
			result.put("PROGID", map.get(CommonConfig.MENU_ID_KEY));
			result.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
			result.setModuleCommand("WmsInventory", "IFSAPLOG");
			
			commonDao.insert(result);
			
			//240126 SAP 에러 발생 시, flag 갱신처리
			//해당 LOGSEQ 선 조회 후 해당건이 'I'일 때 flag update
			DataMap param = new DataMap();
			param.putAll(errMap);
			//param.put("LOGSEQNO", errMap.getString("LOGSEQNO"));
			param.put("SADJKY", docSeq);
			param.put("IFID", getIFID(docuty));
			param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			param.setModuleCommand("Erpif", "IFWMS223_FLG_NEW"); //전송결과 update
			param.put("PRCFLG", "E");
			param.put("PRCETX", msg);
			commonDao.update(param); // UPDATE IFWMS223
						
			sapResList.add(result);
			
			rsMap.put("successCnt", successCnt);
			rsMap.put("sapResList", sapResList);
		} catch (Exception e) {
			transactionStatus.rollbackToSavepoint(transactionSavepoint);
			
			String msg = e.getMessage();
			if (msg.length() > 300) {
				msg = msg.substring(0, 300);
			}
			
			DataMap result = new DataMap();
			result.put("ZDOCNO", docSeq);
			result.put("ERRTXT", msg);
			result.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
			result.put("PROGID", map.get(CommonConfig.MENU_ID_KEY));
			result.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));
			result.setModuleCommand("WmsInventory", "IFSAPLOG");
			
			commonDao.insert(result);			

			//240126 SAP 에러 발생 시, flag 갱신처리
			//해당 LOGSEQ 선 조회 후 해당건이 'I'일 때 flag update
			DataMap param = new DataMap();
			param.putAll(errMap);
			//param.put("LOGSEQNO", errMap.getString("LOGSEQNO"));
			param.put("SADJKY", docSeq);
			param.put("IFID", getIFID(docuty));
			param.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			param.setModuleCommand("Erpif", "IFWMS223_FLG_NEW"); //전송결과 update
			param.put("PRCFLG", "E");
			param.put("PRCETX", msg);
			commonDao.update(param); // UPDATE IFWMS223
			
			sapResList.add(result);
			
			rsMap.put("successCnt", successCnt);
			rsMap.put("sapResList", sapResList);
		} finally {
			transactionManager.commit(transactionStatus);
		}
		return rsMap;
	}
	
