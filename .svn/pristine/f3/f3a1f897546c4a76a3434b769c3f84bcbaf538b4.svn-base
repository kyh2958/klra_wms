	public DataMap setInterfaceData (String DOCUTY, DataMap row) throws SQLException {
		if (StringUtils.isEmpty(DOCUTY)) { throw new SQLException("empty DOCUTY"); }
		
		DataMap ifData = new DataMap();
		ifData = (DataMap) row.clone();
		ifData.put("MEINS" , row.get("UOMKEY" ));
		ifData.put("TMATNR", row.get("ASKUKEY"));
		
		if ("402".equals(DOCUTY)) { // 재고상태변경
			String  LOTA06 = row.getString( "LOTA06");
			String ALOTA06 = row.getString("ALOTA06");
			ifData.put( "LOTA06", convertALOTA06WmsToSap( LOTA06)); // SAP 재고상태로 변경
			ifData.put("ALOTA06", convertALOTA06WmsToSap(ALOTA06)); // SAP 재고상태로 변경
		}
		
		ifData.put("BWARTSAP", row.getString("SAPSTS"));
		return ifData;
	}
	
	/** 문서유형에 따라 I/F ID 세팅 */
	private String getIFID(String DOCUTY) throws SQLException {
		if (StringUtils.isEmpty(DOCUTY)) { throw new SQLException("empty DOCUTY"); }
		
		switch(DOCUTY) {
			case "402" : return "WMS_IF_401"; // 재고상태변경
			case "423" : return "WMS_IF_402"; // 재고MTO/MTS변경
			case "422" : return "WMS_IF_403"; // 제조LOT변경정보
			case "401" : return "WMS_IF_404"; // 저장위치변경정보
			case "421" : return "WMS_IF_405"; // 품목코드변경 (MTM)
			default    : throw new SQLException("empty IFID"); // quit method
		}
	}
	
	/* 문서유형과 데이터에 따라 SAPSTS 지정 */
	public String getSAPSTS(String docuty, DataMap row) {
		String SAPSTS = "";
		String LOTA06 = row.getString("LOTA06").trim();
		
		switch(docuty) {
			case "402": // 재고상태변경
				String ALOTA06 = row.getString("ALOTA06").trim();
				// FROM재고상태, TO재고상태 값에 따라 SAPSTS 다르게 설정
				SAPSTS = "00".equals(LOTA06) && "05".equals(ALOTA06) ? "322" : // 00       -> 05
						 "00".equals(LOTA06)                         ? "344" : // 00       -> 10, 30, 50
						 "05".equals(LOTA06) && "00".equals(ALOTA06) ? "321" : // 05       -> 00
						 "05".equals(LOTA06)                         ? "350" : // 05       -> 10, 30, 50
						                        "00".equals(ALOTA06) ? "343" : // 10,30,50 -> 00
						                        "05".equals(ALOTA06) ? "349" : // 10,30,50 -> 05
																		 "X" ; // 10,30,50 -> 10,30,50 (SAP 전송X)
				break;
			
			case "320": // 재고이동 1Step
			case "325": // 재고이동 2Step
			case "401": // 재고저장위치변경
				String  LOTA02 = row.getString( "LOTA02").trim();
				String ALOTA02 = row.getString("ALOTA02").trim();
				boolean equalsLOTA02 = StringUtils.equals(LOTA02, ALOTA02);
				SAPSTS = "00".equals(LOTA06) ? (equalsLOTA02 ? "311" : "301") : // 00
						 "05".equals(LOTA06) ? (equalsLOTA02 ? "323" : "324") : // 05
											   (equalsLOTA02 ? "325" : "326") ; // 10, 30, 50
				break;
			case "421": // 품목코드변경 (MTM)
				SAPSTS = "309";
				break;
			case "423": // 재고MTO/MTS변경
				String ALOTA07 = row.getString("ALOTA07").trim();
				// 411: MTO -> MTS
				// 413: MTO -> MTS, MTO -> MTO
				SAPSTS = StringUtils.isEmpty(ALOTA07) ? "411" : "413";
				break;
			case "422": // 제조LOT변경정보
				SAPSTS = "311";
				break;
			default:
				SAPSTS = "X";
				break;
		}
		return SAPSTS;
	}
	
	/** 재고상태 SAP에서 재고상태를 00(정상), 05(품질), 10(보류)만 관리함.<br>
	 *  30(불용), 50(폐기)는 10(보류)로 관리하기 때문에 변환작업 필요.
	 */
	private String convertALOTA06WmsToSap(String LOTA06) {
		String sapLOTA06 = LOTA06;
		switch(LOTA06) {
			case "30": sapLOTA06 = "10"; break;
			case "50": sapLOTA06 = "10"; break;
		}
		return sapLOTA06;
	}
	
	public DataMap sendIF(DataMap map) {
		try { // SAP 연동 실패 시 트랜잭션 ROLLBACK 미적용하기위해 try ~ catch
			DataMap ifMap = map.getMap("ifMap");
			String result = ifService.sendIF(ifMap); // send IF
			map.put("SAPRES", result);
		} catch (Exception e) {
			log.error("Sap Connenct Exception : " + e.getMessage());
		}
		
		map.remove("ifMap"); // 인터페이스 연동내용이 화면까지 나가지않도록 map에서 삭제처리
		return map;
	}
	
	@Transactional(rollbackFor = Exception.class)
	private String getIFLogSeqNo() throws SQLException {
		DataMap logoIdxMap = new DataMap();
		logoIdxMap.setModuleCommand("Erpif", "IFWMSLOGSEQNO");
		logoIdxMap = commonDao.getMap(logoIdxMap);
		return logoIdxMap.getString("LOGSEQNO");
	}
	
	
	private String getMessage(String message) {
		return getMessage(message, "");
	}
	
	private String getMessage(String message, String label) {
		if (StringUtils.isNotEmpty(message) && message.contains("↓")) {
			message = message.split("↓")[1];
		}
		if (StringUtils.isNotEmpty(label) && message.contains("{0}")) {
			message = message.replace("{0}", label);
		}
		return message;
	}
	

	/** 재고조정내역 > 재고조정취소
	 * <pre>
	 * rsList [
	 *   error: {
	 *     901: 존재하지 않는 조정문서입니다.
	 *     902: 이미 취소된 조정문서입니다.
	 *     903: MTO/MTS 변경 문서는 취소 할 수 없습니다.
	 *     904: 시스템에 의해 생성된 조정문서는 취소 할 수 없습니다. // ADJFLG != "M"
	 *     905: 다른 작업에 의해 재고정보가 변경되어 취소 할 수 없습니다. (재고부족)
	 *   }
	 * ]
	 * </pre>
	 */
	@Transactional(rollbackFor = Exception.class)
	public List<DataMap> cancelAdjust(DataMap map) throws SQLException {
		List<DataMap> headList = map.getList("headList");
		List<DataMap> rsList = new ArrayList<>();
		
		for (DataMap head : headList) {
			head = head.getMap("map");
			
			// validation
			String docuty = head.getString("DOCUTY");
			String SADJKY = head.getString("SADJKY");
			String REFCKY = head.getString("REFCKY");
			String CANCEL = head.getString("CANCEL");
			String ADJFLG = head.getString("ADJFLG");
			
			DataMap rsMap = new DataMap();
			if (StringUtils.isNotEmpty(REFCKY.trim()) ||
				StringUtils.isNotEmpty(CANCEL.trim()))           { rsMap.put("ERROR", "902"); rsMap.put("SADJKY", SADJKY); rsList.add(rsMap); continue; }
			if (StringUtils.equals(docuty.trim(), "423"))        { rsMap.put("ERROR", "903"); rsMap.put("SADJKY", SADJKY); rsList.add(rsMap); continue; }
			if (StringUtils.equals(ADJFLG.trim(), "M") == false) { rsMap.put("ERROR", "904"); rsMap.put("SADJKY", SADJKY); rsList.add(rsMap); continue; }
			
			head.setModuleCommand("WmsInventory", "CANCEL_ADJUST");
			List<DataMap> adjList = commonDao.getList(head); // HEAD.SADJKY로 ADJDI 목록 조회 (순서 역순, 수량 * -1)
			
			if (CollectionUtils.isEmpty(adjList))                { rsMap.put("ERROR", "901"); rsMap.put("SADJKY", SADJKY); rsList.add(rsMap); continue; }
			
			boolean validate = true;
			for (int i = 0; i < adjList.size(); i += 2) { // 기존 재고문서의 변경후 데이터만 체크
				DataMap adjTO = adjList.get(i);
				double QTADJU = Utils.parseDouble(adjTO.getString("QTADJU")); // ADJDI 조정수량
				double QTSIWH = Utils.parseDouble(adjTO.getString("QTSIWH")); // STKKY 재고수량
				if (QTADJU * -1 > QTSIWH) { // 조정수량 > 재고수량
					validate = false; break;
				}
			}
			
			if (validate == false)                               { rsMap.put("ERROR", "905"); rsMap.put("SADJKY", SADJKY); rsList.add(rsMap); continue; }
			
			// 문서번호 신규생성
			String docSeq = wmsService.getDocSeq(docuty);
			
			// ADJDH INSERT
			map.clonSessionData(head);
			head.put("SADJKY", docSeq);
			head.put("ADJUTY", docuty);
			head.put("ADJUCA", docuty);
			head.put("ADJFLG", "M");
			head.put("REFCKY", SADJKY);
			head.put("DOCTXT", "취소");
			head.setModuleCommand("WmsInventory", "ADJDH");
			commonDao.update(head);
			
			int itemCount = 0;
			List<String> MBLNRList = new ArrayList<>();
			for (int i = 0; i < adjList.size(); i++) {
				DataMap row = new DataMap();
				itemCount += 10;
				
				row = adjList.get(i);
				map.clonSessionData(row);
				row.put("SADJKY", docSeq);
				row.put("SADJIT", String.format("%06d", itemCount));
				
				if (i % 2 == 0) {
					row.setModuleCommand("WmsInventory", "ADJDIOLD");
					commonDao.insert(row);
				} else {
					// ADJDI INSERT, 인터페이스 데이터 세팅
					DataMap before = adjList.get(i - 1);
					for (int j = 1; j <= 20; j++) { /* LOTA => ALOTA, BEFORE.LOTA => LOTA */
						String num = String.format("%02d", j);
						row.put("ALOTA" + num,    row.getString("LOTA" + num));
						row.put( "LOTA" + num, before.getString("LOTA" + num));
					}
					
					for (int j = 1; j <= 5; j++) { /* BEFORE.ASKU => AASKU */
						String num = String.format("%02d", j);
						row.put("AASKU" + num, before.getString("ASKU" + num));
					}
					
					row.setModuleCommand("WmsInventory", "ADJDI");
					commonDao.insert(row);
					
					// 인터페이스 호출하기 위한 데이터 세팅
					String MBLNR = before.getString("SXBLNR");
					if (StringUtils.isNotBlank(MBLNR) &&
						!MBLNRList.contains(MBLNR)
					) {
						MBLNRList.add(MBLNR);
					}
				}
			}
			
			String IFID  = "WMS_IF_778";
			String BUDAT = head.getString("DOCDAT");
			String MJAHR = BUDAT.substring(0, 4);
			
			for (String MBLNR : MBLNRList) {
				/* 인터페이스 데이터 생성 */
				List<DataMap> ifList  = new ArrayList<>();
				String LOGSEQNO = this.getIFLogSeqNo();
				DataMap ifData = new DataMap();
				ifData.put("BUDAT", BUDAT);  //전표전기일
				ifData.put("MJAHR", MJAHR);  //자재전표연도
				ifData.put("MBLNR", MBLNR);  
				ifData.put("WMSDN", SADJKY); //WMS조정문서번호
				ifList.add(ifData);
				
				/* 인터페이스 로그 생성 */
				DataMap logMap = new DataMap();
				logMap.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
				logMap.put("IFID", IFID);
				logMap.put("SEQNO", LOGSEQNO);
				logMap.put("COMSTAT", "C"); // 호출
				logMap.put("REMARK", SADJKY);
				logMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				commonDao.insert(logMap);
				
				// 인터페이스 파라미터 설정
				DataMap ifMap = new DataMap();
				ifMap.put("I_IF_NAM", IFID);
				ifMap.put("I_IF_KEY", LOGSEQNO);
				
				/* 인터페이스 연동 */
				RfcCallFunction sapConn = new RfcCallFunction();
				DataMap sapResObj = sapConn.rfcCancel("Z_WMS_MAT_DOC_CANCEL", "T_INDATA", ifMap, ifList);
				log.debug("Sap Response : " + sapResObj);
				
				/* 인터페이스 연동 결과 처리 */
				List<DataMap> sapResList = sapResObj.getList("head");
				for (DataMap sapRes : sapResList) {
					String TYPE = sapRes.getString("TYPE");
					
					if ("S".equals(TYPE)) {
						logMap.setModuleCommand("Erpif", "IFWMSLOG_RESULT");
						logMap.put("COMSTAT", TYPE);
						commonDao.update(logMap);
					} else {
						logMap.put("ERRTXT", sapRes.getString("MESSAGE"));
						logMap.put("COMSTAT", TYPE);
						logMap.setModuleCommand("Erpif", "IFWMSLOG");
						commonDao.update(logMap);
					}
				}
			}
			
			// 취소 전 조정문서에 취소여부 UPDATE
			head.put("SADJKY", SADJKY);
			head.setModuleCommand("WmsInventory", "ADJDH_CANCEL");
			commonDao.update(head);
			
			rsMap = new DataMap();
			rsMap.put("SADJKY", docSeq);
			rsList.add(rsMap);
		}
		
		return rsList;
	}
	
