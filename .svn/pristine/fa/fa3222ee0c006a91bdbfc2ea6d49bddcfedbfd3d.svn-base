	<!-- 제조일자 추출 테스트 -->
	<select id="DATE_TEST_MAP" parameterType="Map" resultType="DataMap">
	   SELECT SZF_GET_DOM(#{PTNRKY}, #{SKUG01}, ' ', #{EANCOD}) AS LOTA12
	     FROM DUAL
	</select>
	
	<select id="MTPLNT_LIST" parameterType="Map" resultType="DataMap">
		SELECT WAREKY
			 , MTYPE
			 , PLNTKY
			 , CREDAT, CRETIM, CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = MT.CREUSR),' ') AS CUSRNM
			 , LMODAT, LMOTIM, LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = MT.LMOUSR),' ') AS LUSRNM
		FROM MTPLNT MT
		WHERE 1=1
		<if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		<if test="MTYPE  != null and MTYPE  != ''">AND MTYPE  = #{MTYPE }</if>
		<if test="PLNTKY != null and PLNTKY != ''">AND PLNTKY = #{PLNTKY}</if>
		ORDER BY WAREKY, MTYPE, PLNTKY
	</select>
	
	<insert id="MTPLNT_INSERT" parameterType="Map">
		INSERT INTO MTPLNT (
			  WAREKY
			, MTYPE
			, PLNTKY
			, CREDAT, CRETIM, CREUSR
			, LMODAT, LMOTIM, LMOUSR
		) VALUES (
			  #{WAREKY}
			, #{MTYPE }
			, #{PLNTKY}
			, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
		)
	</insert>
	
	<delete id="MTPLNT_DELETE">
		DELETE FROM MTPLNT
		 WHERE WAREKY = #{WAREKY}
		   AND MTYPE  = #{MTYPE }
		   AND PLNTKY = #{PLNTKY}
	</delete>
	
	<select id="ZPPTM_LIST" parameterType="Map" resultType="DataMap">
		SELECT LOTA02 --플랜트
		     , SZF_GET_CMCDV_CDESC1_TEXT('KR', 'LOTA02', LOTA02) AS PLNTNM
		     , LOTA16 --평량
		     , LOTA17 --컨테이너유형
		     , LOTA03 --포장타입
		     , LOTA09 --납품처(CT)
		     , PALCNT --팔레트수
		     , CREDAT, CRETIM, CREUSR
		     , NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = ZP.CREUSR),' ') AS CUSRNM
		     , LMODAT, LMOTIM, LMOUSR
             , NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = ZP.LMOUSR),' ') AS LUSRNM
		  FROM ZPPTM ZP
		 WHERE 1=1 
		 AND MANDT = '100' 
		 <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
		ORDER BY LOTA02, LOTA16, LOTA17, LOTA03, LOTA09
	</select>
	
</mapper>