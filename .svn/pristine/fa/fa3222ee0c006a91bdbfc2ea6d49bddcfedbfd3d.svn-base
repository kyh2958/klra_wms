	<!-- ==================================================================================================================== -->
	<!-- 마스터관리 - 구성 - [MW01] 물류센터 :: BEGIN -->
	<!-- ==================================================================================================================== -->
	<select id="WAHMA_LIST" parameterType="Map" resultType="DataMap">
		SELECT WAREKY
		     , COMPKY
		     , NAME01
		     , NAME02
		     , ADDR01
		     , POSTCD
		     , NATNKY
		     , VATREG
		     , FAXTL1
		     , TELN01
		     , WADM01
		     , WADN01
		     , TSPKEY
		     , DELMAK
		     , CHKSHA
		     , NAME03
		     , ADDR02
		     , ADDR03
		     , ADDR04
		     , ADDR05
		     , CITY01
		     , REGN01
		     , TELN02
		     , TELN03
		     , FAXTL2
		     , TAXCD1
		     , TAXCD2
		     , POBOX1
		     , POBPC1
		     , WADT01
		     , WADT02
		     , EXCOMK
		     , INDOVA
		     , PLOCOV
		     , DRECLO
		     , INDUAC
		     , DSORKY
		     , DRECLO
		     , CREDAT
		     , CRETIM
		     , CREUSR
		     , NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.CREUSR),' ') AS CUSRNM
		     , LMODAT
		     , LMOTIM
		     , LMOUSR
		     , NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.LMOUSR),' ') AS LUSRNM
		  FROM WAHMA A
		 WHERE 1 = 1
		<if test="COMPKY != null and COMPKY != ''">
		   AND COMPKY = #{COMPKY}
		</if>
		<if test="DELMAK == &quot;V&quot;">
		   AND DELMAK = #{DELMAK}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
		   ${RANGE_SQL}
		</if>
	  ORDER BY COMPKY, WAREKY
	</select> 
	
	<!-- 구성> 거점 validation -->
	<select id="WAHMA_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT CASE
		     WHEN B.LOCAKY IS NULL THEN 'VALID_M0204' || ' ' || A.PLOCOV
		     ELSE 'OK' 
		 END AS MSG
		FROM ( ${VALIDATION_SQL} ) A,
		       LOCMA B
		WHERE 1=1
		AND A.WAREKY = B.WAREKY(+)
		AND A.PLOCOV = B.LOCAKY(+)
	</select>

	<!-- 구성> 거점 수정 -->
	<update id="WAHMA_UPDATE" parameterType="Map">
		UPDATE WAHMA SET 
		 	    LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			  , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			  , LMOUSR = #{SES_USER_ID}
			<if test="TSPKEY != null and TSPKEY != ''">
			  , TSPKEY = #{TSPKEY}
			</if> 
			<if test="DELMAK != null and DELMAK != ''">
			  , DELMAK = #{DELMAK}
			</if> 
			<if test="CHKSHA != null and CHKSHA != ''">
			  , CHKSHA = #{CHKSHA}
			</if> 
			<if test="NAME01 != null and NAME01 != ''">
			  , NAME01 = #{NAME01}
			</if> 
			<if test="NAME02 != null and NAME02 != ''">
			  , NAME02 = #{NAME02}
			</if> 
			<if test="NAME03 != null and NAME03 != ''">
			  , NAME03 = #{NAME03}
			</if> 
			<if test="ADDR01 != null and ADDR01 != ''"> 
			  , ADDR01 = #{ADDR01}
			</if>
				<if test="ADDR02 != null and ADDR02 != ''"> 
			  , ADDR02 = #{ADDR02}
			</if>
				<if test="ADDR03 != null and ADDR03 != ''"> 
			  , ADDR03 = #{ADDR03}
			</if>
				<if test="ADDR04 != null and ADDR04 != ''"> 
			  , ADDR04 = #{ADDR04}
			</if>
				<if test="ADDR05 != null and ADDR05 != ''"> 
			  , ADDR05 = #{ADDR05}
			</if>
			<if test="CITY01 != null and CITY01 != ''">
			  , CITY01 = #{CITY01}
			</if>
			<if test="REGN01 != null and REGN01 != ''">
			  , REGN01 = #{REGN01}
			</if>
			<if test="POSTCD != null and POSTCD != ''">
			  , POSTCD = #{POSTCD}
			</if>
			<if test="NATNKY != null and NATNKY != ''">
			  , NATNKY = #{NATNKY}
			</if>
			<if test="TELN01 != null and TELN01 != ''">
			  , TELN01 = #{TELN01}
			</if>
			<if test="TELN02 != null and TELN02 != ''">
			  , TELN02 = #{TELN02}
			</if>
			<if test="TELN03 != null and TELN03 != ''">
			  , TELN03 = #{TELN03}
			</if>
			<if test="FAXTL1 != null and FAXTL1 != ''">
			  , FAXTL1 = #{FAXTL1}
			</if>
			<if test="FAXTL2 != null and FAXTL2 != ''">
			  , FAXTL2 = #{FAXTL2}
			</if>
			<if test="TAXCD1 != null and TAXCD1 != ''">
			  , TAXCD1 = #{TAXCD1}
			</if>
			<if test="TAXCD2 != null and TAXCD2 != ''">
			  , TAXCD2 = #{TAXCD2}
			</if>
			<if test="VATREG != null and VATREG != ''">
			  , VATREG = #{VATREG}
			</if>
			<if test="POBOX1 != null and POBOX1 != ''">
			  , POBOX1 = #{POBOX1}
			</if>
			<if test="POBPC1 != null and POBPC1 != ''">
			  , POBPC1 = #{POBPC1}
			</if>
			<if test="WADN01 != null and WADN01 != ''">
			  , WADN01 = #{WADN01}
			</if>
			<if test="WADT01 != null and WADT01 != ''">
			  , WADT01 = #{WADT01}
			</if>
			<if test="WADT02 != null and WADT02 != ''">
			  , WADT02 = #{WADT02}
			</if>
			<if test="WADM01 != null and WADM01 != ''">
			  , WADM01 = #{WADM01}
			</if>
			<if test="EXCOMK != null and EXCOMK != ''">
			  , EXCOMK = #{EXCOMK}
			</if>
			<if test="INDOVA != null and INDOVA != ''">
			  , INDOVA = #{INDOVA}
			</if>
			<if test="PLOCOV != null and PLOCOV != ''">
			  , PLOCOV = #{PLOCOV}
			</if>
			<if test="DRECLO != null and DRECLO != ''">
			  , DRECLO = #{DRECLO}
			</if>
			<if test="INDUAC != null and INDUAC != ''">
			  , INDUAC = #{INDUAC}
			</if>
			<if test="DSORKY != null and DSORKY != ''">
			  , DSORKY = #{DSORKY}
			</if>
		  WHERE WAREKY = #{WAREKY}
	</update>
	<!-- ==================================================================================================================== -->
	<!-- 마스터관리 - 구성 - [MW01] 물류센터 :: END -->
	<!-- ==================================================================================================================== -->
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	<sql id="ZONMA_WHERE">
		<if test="WAREKY != null and WAREKY != ''">
			AND Z.WAREKY = #{WAREKY} 
		</if> 
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		<if test="ZONETY != null and ZONETY != ''">
		 AND   Z.ZONETY = #{ZONETY} 
		</if>
	</sql>
	
	<select id="WEIGHTCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT	CMCDVL AS VALUE_COL,
				CDESC1 AS TEXT_COL
		FROM CMCDV
		WHERE 1 = 1
		  AND CMCDKY = 'WEIGHT'
	</select>
	
	<sql id="ZONMA_SELECT">
		SELECT  Z.WAREKY
			   ,' ' AS CHECKDATA
			   ,ROWNUM AS TMPNUM 
		       ,Z.ZONEKY
		       ,Z.ZONETY
		       ,(SELECT CDESC1 FROM CMCDV C WHERE CMCDKY = 'ZONETY' AND C.CMCDVL = Z.ZONETY) AS ZONETYT
		       ,Z.SHORTX
		       ,Z.AREAKY
		       ,(SELECT SHORTX FROM AREMA A WHERE A.WAREKY = Z.WAREKY AND A.AREAKY = Z.AREAKY) AS AREAKYT
		       ,Z.PLNTKY
		       ,Z.STLKY
		       ,S.STLNM
		       ,Z.CREDAT
		       ,Z.CRETIM
		       ,Z.CREUSR
		       ,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = Z.CREUSR),' ') AS CUSRNM
		       ,Z.LMODAT
		       ,Z.LMOTIM
		       ,Z.LMOUSR
		       ,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = Z.LMOUSR),' ') AS LUSRNM
		       ,Z.INDBZL
		       ,Z.INDARC
		       ,Z.UPDCHK
		FROM ZONMA Z
		LEFT OUTER JOIN STLMA S ON S.PLNTKY = Z.PLNTKY
                               AND S.WAREKY = Z.WAREKY
                               AND S.STLKY = Z.STLKY
	</sql>
	
	<select id="ZONMAP_COUNT" parameterType="Map" resultType="Integer">
		SELECT  COUNT(*) 
		FROM ZONMA Z
		WHERE 1 = 1
		<include refid="ZONMA_WHERE"/> 
	</select>
	
	<select id="ZONMAP_LIST" parameterType="Map" resultType="DataMap">
		<include refid="ZONMA_SELECT"/>
		WHERE 1 = 1
		<include refid="ZONMA_WHERE"/>
		ORDER BY ZONEKY
	</select>
	
	<select id="ZONMA_LIST" parameterType="Map" resultType="StringMap">
		<include refid="ZONMA_SELECT"/>
		WHERE 1 = 1
		<include refid="ZONMA_WHERE"/>
		ORDER BY Z.ZONEKY
	</select>
	
	<select id="ZONMA2_LIST" parameterType="Map" resultType="DataMap">
		SELECT   #{WAREKY} AS WAREKY
		       , #{ZONEKY} AS ZONEKY
		       , #{ZONETY} AS ZONETY
		       , #{SHORTX} AS SHORTX
		       , #{AREAKY} AS AREAKY
		       , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT
			   , TO_CHAR(SYSDATE, 'HHMISS') AS CRETIM
			   , #{SES_USER_ID} AS CREUSR
		   	   , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT
			   , TO_CHAR(SYSDATE, 'HHMISS') AS LMOTIM
			   , #{SES_USER_ID} AS LMOUSR
		FROM DUAL
	</select>
	
	<insert id="ZONMA_INSERT" parameterType="Map">
		INSERT INTO ZONMA (WAREKY,AREAKY,ZONEKY,ZONETY,PLNTKY,STLKY,SHORTX,CREDAT,CRETIM,CREUSR,LMODAT,LMOTIM,LMOUSR) 
 		VALUES (#{WAREKY},#{AREAKY},#{ZONEKY},#{ZONETY},#{PLNTKY},#{STLKY},#{SHORTX},
 		TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
 		TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID})
	</insert>
	
	<delete id="ZONMA_DELETE" parameterType="Map">
		DELETE FROM ZONMA 
		 WHERE WAREKY = #{WAREKY} 
	       AND ZONEKY = #{ZONEKY}
	</delete>
	
	<update id="ZONMA_UPDATE" parameterType="Map">
		UPDATE ZONMA SET 
			<if test="ZONETY != null and ZONETY != ''">
				 ZONETY = #{ZONETY},
			</if>
			<if test="SHORTX != null and SHORTX != ''">			
				 SHORTX = #{SHORTX},
			</if> 
			<if test="AREAKY != null and AREAKY != ''">			
				 AREAKY = #{AREAKY},
			</if>
			<if test="PLNTKY != null and PLNTKY != ''">			
				 PLNTKY = #{PLNTKY},
			</if>
			<if test="STLKY != null and STLKY != ''">			
				 STLKY = #{STLKY},
			</if>
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
			LMOUSR = #{SES_USER_ID}
		WHERE WAREKY = #{WAREKY} 
			AND ZONEKY = #{ZONEKY} 
	</update>
	<select id="ZONMA_VALIDATION" parameterType="Map" resultType="DataMap"> 
		SELECT
		  CASE
		    WHEN A.AREAKY IS NULL THEN 'MASTER_M0255' || ' ' || P.AREAKY
		    WHEN Z.ZONEKY IS NOT NULL THEN 'VALID_M0103' || ' ' || P.ZONEKY
		    ELSE 'OK'
		  END AS MSG
		FROM(
		    	${VALIDATION_SQL} 
		    ) P 
		    LEFT OUTER JOIN AREMA A ON A.WAREKY = P.WAREKY AND A.AREAKY = P.AREAKY
		    LEFT OUTER JOIN ZONMA Z ON Z.ZONEKY = P.ZONEKY AND Z.WAREKY = P.WAREKY
		WHERE 1=1
		   OR A.AREAKY IS NULL
		   OR Z.ZONEKY IS NOT NULL
	</select>
	
	<!-- 구성> 구역 삭제 전 Validation 체크-->
	<select id="ZONMAdel_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM LOCMA
		WHERE WAREKY = #{WAREKY}
		AND ZONEKY=#{ZONEKY}
	</select>
	
	<select id="AREAKYCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT
			WAREKY AS GROUP_COL,
		    AREAKY AS VALUE_COL,
		    SHORTX AS TEXT_COL
		FROM AREMA 
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND WAREKY = #{WAREKY} 
		</if> 
	</select>
	
	<select id="ZONEKY_MAP" parameterType="Map" resultType="DataMap">
		SELECT  WAREKY
		       ,ZONEKY
		FROM ZONMA
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND WAREKY = #{WAREKY} 
		</if> 
		<if test="ZONEKY != null and ZONEKY != ''">
			AND ZONEKY = #{ZONEKY} 
		</if> 
	</select>
	
	<select id="PTNRTYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM BZPTN
		<if test="PTNRTY != null and PTNRTY != ''">
		WHERE PTNRTY = #{PTNRTY}
		</if> 
	</select>	
	
	<!-- 구성> 영역 조회 -->
	<select id="AREMA_LIST" parameterType="Map" resultType="DataMap">
		SELECT WAREKY
		, AREAKY
		, AREATY
		,(SELECT CDESC1 FROM CMCDV C WHERE CMCDKY = 'AREATY' AND C.CMCDVL = A.AREATY)
		AS AREATYT
		, SHORTX
		, NEGSTK
		, INDCDO
		, INDAES
		, INDSHW
		, INDULT
		, RDDALL
		, CREDAT
		, CRETIM
		, CREUSR
		, NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.CREUSR),' ') AS CUSRNM
		, LMODAT
		, LMOTIM
		, LMOUSR
		, NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.LMOUSR),' ') AS LUSRNM
		, INDBZL
		, INDARC
		, UPDCHK
		, MAXCPC
		FROM AREMA A
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
		 AND   WAREKY = #{WAREKY} 
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		<if test="AREATY != null and AREATY != ''">
		 AND   AREATY = #{AREATY} 
		</if>
	</select> 
	
	<!-- 구성> 영역 수정 -->
	<update id="AREMA_UPDATE" parameterType="Map">
		 UPDATE AREMA SET 
		        LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			  , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			  , LMOUSR = #{SES_USER_ID}
		 	<if test="AREATY != null and AREATY != ''">
		      , AREATY = #{AREATY}
		    </if>
		    <if test="SHORTX != null and SHORTX != ''">
		      , SHORTX = #{SHORTX}
		    </if>
		    <if test="MAXCPC != null and MAXCPC != ''">
		      , MAXCPC = #{MAXCPC}
		    </if>
		      , NEGSTK = NVL(#{NEGSTK}, ' ')
		      , INDCDO = NVL(#{INDCDO}, ' ')
		      , INDAES = NVL(#{INDAES}, ' ')
		 WHERE WAREKY = #{WAREKY}
		   AND AREAKY = #{AREAKY}
	</update>
	
	<!-- 구성> 영역 신규 -->
		<insert id="AREMA_INSERT" parameterType="Map">
		INSERT INTO AREMA(
					WAREKY,
					AREAKY,
					AREATY,
					SHORTX,
					NEGSTK,
					INDCDO,
					INDAES,
					MAXCPC,
					CREDAT,
					CRETIM,
					CREUSR,
					LMODAT,
					LMOTIM,
					LMOUSR
					)
			VALUES (
					#{WAREKY},
					#{AREAKY},
					#{AREATY},
					#{SHORTX},
					#{NEGSTK},
					#{INDCDO},
					#{INDAES},
					NVL(TRIM(#{MAXCPC}), 0),
					TO_CHAR(SYSDATE, 'YYYYMMDD'),
					TO_CHAR(SYSDATE, 'HH24MISS'),
					#{SES_USER_ID},
					TO_CHAR(SYSDATE, 'YYYYMMDD'),
					TO_CHAR(SYSDATE, 'HH24MISS'),
					#{SES_USER_ID}
					)
	</insert>
	
	 	<!-- 구성> 영역 삭제 전 Validation 체크-->
	<select id="AREMAval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM ZONMA
		WHERE WAREKY  = #{WAREKY}
		AND AREAKY = #{AREAKY}
	</select>
	
	<!-- 구성> 영역 삭제 -->
	<delete id="AREMA_DELETE" parameterType="Map">
		DELETE FROM AREMA
		WHERE WAREKY = #{WAREKY}
		AND AREAKY = #{AREAKY}
	</delete>
	
	<select id="PTNRTYCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT
			CMCDKY AS GROUP_COL,
		    CMCDVL AS VALUE_COL,
		    CDESC1 AS TEXT_COL
		FROM CMCDV 
		WHERE CMCDKY = 'PTNRTY'
	</select>

	<select id="PTNRTYCOMBO2_LIST" parameterType="Map" resultType="DataMap">
		SELECT
			CMCDKY AS GROUP_COL,
			CMCDVL AS VALUE_COL,
			CDESC1 AS TEXT_COL
		FROM CMCDV 
		WHERE CMCDKY = 'PTNRTY'
	</select>
	
	<select id="BZ01COMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT
		    CMCDVL AS VALUE_COL,
		    CDESC1 AS TEXT_COL
		FROM CMCDV 
		WHERE CMCDKY = 'PTNRTY'
	</select>
	
	<!-- 파트너관리> 파트너 조회 -->
	<select id="BZPTN_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
		 SELECT 
				OWNRKY,
				NVL((SELECT NAME01 FROM OWNER O WHERE O.OWNRKY = A.OWNRKY), ' ') AS OWNRNM,
				PTNRTY,
				NVL((SELECT CDESC1 FROM CMCDV C WHERE C.CMCDKY = 'PTNRTY' AND C.CMCDVL = A.PTNRTY),' ') AS PTNRTYT,
				PTNRKY,
				DELMAK,
				NAME01,
				NAME02,
				NAME03,
				ADDR01,
				ADDR02,
				ADDR03,
				ADDR04,
				ADDR05,
				CITY01,
				REGN01,
				POSTCD,
				NATNKY,
				NVL((SELECT CDESC1 FROM CMCDV C WHERE CMCDKY = 'NATNKY' AND C.CMCDVL = A.NATNKY),' ') AS NATNKYT,
				TELN01,
				TELN02,
				TELN03,
				FAXTL1,
				FAXTL2,
				TAXCD1,
				TAXCD2,
				VATREG,
				POBOX1,
				POBPC1,
				EMAIL1,
				EMAIL2,
				CTTN01,
				CTTT01,
				CTTT02,
				CTTM01,
				SALN01,
				SALT01,
				SALT02,
				SALM01,
				EXPTNK,
				CUSTMR,
				PTNG01,
				PTNG02,
				PTNG03,
				PTNG04,
				PTNG05,
				PTNL01,
				NVL((SELECT CDESC1 FROM CMCDV C WHERE CMCDKY = 'PTNL01' AND C.CMCDVL = A.PTNL01),' ') AS PTNL01NM,
				PTNL02,
				PTNL03,
				PTNL04,
				PTNL05,
				WTOPPM,
				WTOPMU,
				WTOPDV,
				PROCHA,
				CREDAT,
			    CRETIM,
				CREUSR,
				NVL((SELECT NMLAST FROM USRMA WHERE USERID = A.CREUSR),' ') AS CUSRNM,
				LMODAT,
				LMOTIM,
				LMOUSR,
				NVL((SELECT NMLAST FROM USRMA WHERE USERID = A.LMOUSR),' ') AS LUSRNM,
				INDBZL,
				INDARC,
				UPDCHK,
				DEPTID,
				USRID1,
				DNAME,
				LOTCD,
				LOTCD2
		 FROM   BZPTN A
		WHERE  1 = 1
		<if test="PTNRKY != null and PTNRKY != ''">
			AND A.PTNRKY = #{PTNRKY}
		</if>
		<if test="PTNRTY != null and PTNRTY != ''">
			AND A.PTNRTY = #{PTNRTY}
		</if>
		<if test="DELMAK != null and DELMAK != ''">
			AND A.DELMAK LIKE DECODE(#{DELMAK},' ','%','V')
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		ORDER BY A.PTNRKY
	</select>  
	
	<!-- 파트너관리> 파트너(거래처 & 공급업체) 조회 -->
	<select id="BZ02_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
		SELECT CDATH.PTNRKY
		     , CDATH.SKUG01
		     , BZPTN.NAME01
		     , BZPTN.POSTCD
		     , BZPTN.ADDR01
		     , BZPTN.ADDR02
		  FROM CDATH
		 INNER JOIN BZPTN
		    ON CDATH.PTNRKY = BZPTN.PTNRKY
		   AND BZPTN.PTNRTY = 'VD'
		 GROUP BY CDATH.PTNRKY
		     , CDATH.SKUG01
		     , BZPTN.NAME01
		     , BZPTN.POSTCD
		     , BZPTN.ADDR01
		     , BZPTN.ADDR02
		 ORDER BY CDATH.SKUG01, CDATH.PTNRKY
	</select>  
	
	
	<!-- 파트너관리> 일자유형 -->
	<select id="CDATH_LIST" parameterType="Map" resultType="DataMap">
		SELECT PTNRKY
		      ,SKUG01
			  ,DATETY
			  ,DESC01
			  ,STRIDX
			  ,CHARLN
			  ,CONVTY
			  ,CREDAT
			  ,CRETIM
			  ,CREUSR
			  ,LMODAT
			  ,LMOTIM
			  ,LMOUSR
		 FROM CDATH
		WHERE PTNRKY = #{PTNRKY}
		  AND SKUG01 = #{SKUG01}
	</select>
	
	<!-- 파트너관리> 상세정보 확인 -->
	<select id="CDATI_LIST" parameterType="Map" resultType="DataMap">
		SELECT PTNRKY
		      ,SKUG01
			  ,DATETY
			  ,TYPENO
			  ,CONVCH
			  ,TARGCH
			  ,CREDAT
			  ,CRETIM
			  ,CREUSR
			  ,LMODAT
			  ,LMOTIM
			  ,LMOUSR
		 FROM CDATI
		WHERE PTNRKY = #{PTNRKY}
		  AND SKUG01 = #{SKUG01}
		  AND DATETY = #{DATETY}
	</select>
	
	<!-- 파트너관리> 파트너  중복 확인 -->
	<select id="BZPTNval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		FROM BZPTN 
		WHERE 1 = 1 
		AND PTNRKY = #{PTNRKY}
		AND PTNRTY = #{PTNRTY}
		AND PTNL05 = #{PTNL05}
	</select>
	
	<select id="BZ02_PTNRNM_MAP" parameterType="Map" resultType="DataMap">
		SELECT NAME01
		      ,NAME02
		      ,POSTCD
		      ,ADDR01
		      ,TELN01
		      ,VATREG
        	  ,EMAIL1
		  FROM BZPTN
		 WHERE PTNRKY = #{PTNRKY}
		   AND OWNRKY = #{OWNRKY}
		   AND PTNRTY = 'VD'
	</select>
	
	<select id="CDATH_CHECK_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) AS CNT
		  FROM CDATH
		 WHERE PTNRKY = #{PTNRKY}
		   AND SKUG01 = #{SKUG01}
	</select>
	
	<!-- 파트너관리> 파트너 validation -->
	<select id="BZPTN_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT
	      CASE
	        WHEN B.PTNRKY IS NOT NULL THEN 'COMMON_M0446' || ' ' || STD.PTNRKY
	        WHEN B.PTNRTY IS NOT NULL THEN 'COMMON_M0446' || ' ' || STD.PTNRTY
	        WHEN C.CMCDVL IS NULL THEN 'IN_M0036' || ' ' || STD.PTNRTY
	        ELSE 'OK'
	      END AS MSG
	    FROM (
	            ${VALIDATION_SQL}
	          ) STD 
	        LEFT OUTER JOIN BZPTN B ON B.PTNRKY = STD.PTNRKY AND B.PTNRTY = STD.PTNRTY 
	        LEFT OUTER JOIN CMCDV C ON C.CMCDVL = STD.PTNRTY AND C.CMCDKY = 'PTNRTY'
	    WHERE 1 = 1
	      AND B.PTNRKY IS NOT NULL
	       OR B.PTNRTY IS NOT NULL
	       OR C.CMCDVL IS NULL
	</select>
	
	<!-- 파트너관리> 파트너 신규 -->
	<insert id="BZPTN_INSERT" parameterType="Map">
		INSERT INTO BZPTN 
		(
			 PTNRKY,PTNRTY,DELMAK,NAME01,NAME02,ADDR01,POSTCD,TELN01,VATREG,PTNL01,PTNL03,PTNL04,PROCHA,PTNG01,EWGUBN
		 ) 
		VALUES 
		(
			 ('BZP' || LPAD(BZP_SEQ.NEXTVAL, 7, '0')),#{PTNRTY},#{DELMAK},#{NAME01},#{NAME02},#{ADDR01},#{POSTCD},#{TELN01},#{VATREG},
			 #{PTNL01},#{PTNL03},#{PTNL04},#{PROCHA},#{PTNG01},'W'
		)
	</insert>
	
	<!-- 파트너관리> 파트너 신규 -->
	<insert id="BZ02_INSERT" parameterType="Map">
		INSERT INTO BZPTN 
		(
			 PTNRKY,NAME01,ADDR01,POSTCD,TELN01
		 ) 
		VALUES 
		(
			 #{PTNRKY},#{NAME01},#{ADDR01},#{TELN01}
		)
	</insert>
	
	<!-- 파트너관리> 파트너 신규 -->
	<insert id="CDATH_INSERT" parameterType="Map">
		INSERT INTO CDATH 
		(
			 PTNRKY,SKUG01,DATETY,DESC01,STRIDX,CHARLN,CONVTY,
			 CREDAT,CRETIM,CREUSR,
			 LMODAT,LMOTIM,LMOUSR
		) 
		VALUES 
		(
			 #{PTNRKY},#{SKUG01},#{DATETY},NVL(#{DESC01}, ' '),NVL(#{STRIDX}, ' '),NVL(#{CHARLN}, ' '),NVL(#{CONVTY}, ' ')
			 ,TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		     ,TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		)
	</insert>
	
	<select id="TYPE_SEQUENCE_OBJECT" parameterType="Map" resultType="String">
		SELECT NVL(TO_NUMBER(MAX(TYPENO))+1, 1) AS TYPENO FROM CDATI
		 WHERE PTNRKY = #{PTNRKY}
		   AND SKUG01 = #{SKUG01}
		   AND DATETY = #{DATETY}
	</select>
	
	<!-- 파트너관리> 파트너 신규 -->
	<insert id="CDATI_INSERT" parameterType="Map">
		INSERT INTO CDATI 
		(
			 PTNRKY,SKUG01,DATETY,TYPENO,CONVCH,TARGCH,
			 CREDAT,CRETIM,CREUSR,
			 LMODAT,LMOTIM,LMOUSR
		 ) 
		VALUES 
		(
			 #{PTNRKY},#{SKUG01},#{DATETY},#{TYPENO},NVL(#{CONVCH}, ' '),NVL(#{TARGCH}, ' ')
			 ,TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		     ,TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		)
	</insert>
	
	<!-- 마스터관리> 마스터수정 -->
	<update id="CDATH_UPDATE" parameterType="Map">
		UPDATE CDATH SET
		 	   LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
			 <if test="CONVTY != null and CONVTY != ''">
		      ,CONVTY = #{CONVTY}
		     </if>
			 <if test="DESC01 != null and DESC01 != ''">
		      ,DESC01 = #{DESC01}
		     </if>
			 <if test="STRIDX != null and STRIDX != ''">
		      ,STRIDX = #{STRIDX}
		     </if>
			 <if test="CHARLN != null and CHARLN != ''">
		      ,CHARLN = #{CHARLN}
		     </if>
		 WHERE 1=1
		   AND PTNRKY = #{PTNRKY} 
		   AND SKUG01 = #{SKUG01}
		   AND DATETY = #{DATETY}
	</update>
	
	<!-- 마스터관리> 마스터수정 -->
	<update id="CDATI_UPDATE" parameterType="Map">
		UPDATE CDATI SET
		 	   LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
			 <if test="CONVCH != null and CONVCH != ''">
		      ,CONVCH = #{CONVCH}
		     </if>
			 <if test="TARGCH != null and TARGCH != ''">
		      ,TARGCH = #{TARGCH}
		     </if>
		 WHERE 1=1
		   AND PTNRKY = #{PTNRKY}
           AND SKUG01 = #{SKUG01}
		   AND DATETY = #{DATETY}
		   AND TYPENO = #{TYPENO} 
	</update>
	
	<!-- 마스터관리> 마스터수정 -->
	<update id="BZ02_UPDATE" parameterType="Map">
		UPDATE BZPTN SET
		 	   LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		      <if test="PTNRKY != null and PTNRKY != ''">
		      ,PTNRKY = #{PTNRKY}
		      </if>
		 WHERE PTNRKY = #{PTNRKY}
	</update>
	
	<!-- 마스터관리> 마스터수정 -->
	<update id="BZPTN_UPDATE" parameterType="Map">
		UPDATE BZPTN SET
		 	   LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		      <if test="PTNRKY != null and PTNRKY != ''">
		      ,PTNRKY = #{PTNRKY}
		      </if>
			  <if test="PTNRTY != null and PTNRTY != ''">
		      ,PTNRTY = #{PTNRTY}
		      </if>
		      <if test="DELMAK != null and DELMAK != ''">
		      ,DELMAK = #{DELMAK}
		      </if>
		      <if test="NAME01 != null and NAME01 != ''">
		      ,NAME01 = #{NAME01}
		      </if>
		      <if test="NAME02 != null and NAME02 != ''">
		      ,NAME02 = #{NAME02}
		       </if>
		      <if test="ADDR01 != null and ADDR01 != ''">
		      ,ADDR01 = #{ADDR01}
		      </if>
		      <if test="POSTCD != null and POSTCD != ''">
		      ,POSTCD = #{POSTCD}
		      </if>
		      <if test="TELN01 != null and TELN01 != ''">
		      ,TELN01 = #{TELN01}
		      </if>
		      <if test="VATREG != null and VATREG != ''">
		      ,VATREG = #{VATREG}
		      </if>
		      <if test="PTNL01 != null and PTNL01 != ''">
		      ,PTNL01 = #{PTNL01}
		      </if>
		      <if test="PTNL3 != null and PTNL3 != ''">
		      ,PTNL3 = #{PTNL3}
		      </if>
		      <if test="PTNL4 != null and PTNL4 != ''">
		      ,PTNL4 = #{PTNL4}
		      </if>
		      <if test="PROCHA1 != null and PROCHA1 != ''">
		      ,PROCHA1 = #{PROCHA1}
		      </if>
		      <if test="EXPTNK != null and EXPTNK != ''">
		      ,EXPTNK = #{EXPTNK}
		      </if>
		      <if test="PTNG01 != null and PTNG01 != ''">
		      ,PTNG01 = #{PTNG01}
		      </if>
		      <if test="PTNL05 != null and PTNL05 != ''">
		      ,PTNL05 = #{PTNL05}
		      </if>
		      <if test="PROCHA != null and PROCHA != ''">
		      ,PROCHA = #{PROCHA}
		      </if>
		      <if test="LOTCD != null and LOTCD != ''">
		      ,LOTCD = #{LOTCD}
		      </if>
		      <if test="LOTCD2 != null and LOTCD2 != ''">
		      ,LOTCD2 = #{LOTCD2}
		      </if>
		 WHERE 1 = 1
		   AND PTNRKY = #{PTNRKY}
		   AND PTNRTY = #{PTNRTY}
	</update>
	
	<!-- 파트너관리> 파트너 삭제 -->
	<delete id="BZPTN_DELETE" parameterType="Map">
		DELETE FROM BZPTN
		WHERE PTNRKY = #{PTNRKY}
		  AND PTNRTY = #{PTNRTY}
		  AND PTNL05 = #{PTNL05}
	</delete>
	
	<!-- 파트너관리> 파트너 삭제 -->
	<delete id="BZ02_DELETE" parameterType="Map">
		DELETE FROM BZPTN
		WHERE PTNRKY = #{PTNRKY}
	</delete>
	
	<!-- 파트너관리> 파트너 삭제 -->
	<delete id="CDATH_DELETE" parameterType="Map">
		DELETE FROM CDATH
		 WHERE PTNRKY = #{PTNRKY}
           AND SKUG01 = #{SKUG01}
		<if test="DATETY != null and DATETY != ''">
		   AND DATETY = #{DATETY}
		</if>
	</delete>
	
	<!-- 파트너관리> 파트너 삭제 -->
	<delete id="CDATI_DELETE" parameterType="Map">
		DELETE FROM CDATI
		 WHERE PTNRKY = #{PTNRKY}
           AND SKUG01 = #{SKUG01}
		<if test="DATETY != null and DATETY != ''">
		  AND DATETY = #{DATETY}
		</if>
		<if test="TYPENO != null and TYPENO != ''">
		  AND TYPENO = #{TYPENO}
		</if>
	</delete>

	<!-- 구성> 지번★ 조회 -->
	<select id="LOCMA_LIST" parameterType="Map" resultType="DataMap">
	  SELECT A.WAREKY
			,LOCAKY
			,LOCAKY AS ALOCAKY
			,LOCATY
			,A.SHORTX
			,ZA.PLNTKY
			,ZA.STLKY
			,NVL((SELECT STLNM FROM STLMA SM WHERE SM.PLNTKY = ZA.PLNTKY AND SM.STLKY = ZA.STLKY), ' ') AS STLKYNM
			,TASKTY
			,ZA.ZONEKY
			,ZA.ZONEKY AS AZONEKY
			,A.AREAKY
			,A.AREAKY AS AAREAKY
			,NVL((SELECT CDESC1 FROM CMCDV C WHERE CMCDKY = 'LOCATY' AND C.CMCDVL = A.LOCATY),' ') AS LOCATYT
			,TKZONE
			,FACLTY
			,ARLVLL
			,INDCPC
			,INDTUT
			,IBROUT
			,OBROUT
			,RPROUT
			,STATUS
			,NVL((SELECT CDESC1 FROM CMCDV C WHERE C.CMCDKY = 'STATUS' AND C.CMCDVL = A.STATUS),' ') AS STATUST
			,ABCANV
			,LENGTH
			,WIDTHW
			,HEIGHT
			,CUBICM
			,MAXCPC
			,MAXQTY
			,MAXWGT
			,MAXLDR
			,MAXSEC
			,MIXSKU
			,MIXLOT
			,RPNCAT
			,INDQTC
			,QTYCHK
			,NEDSID
			,INDUPA
			,INDUPK
			,AUTLOC
			,A.CREDAT
			,A.CRETIM
			,A.CREUSR
			,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.CREUSR),' ') AS CUSRNM
			,A.LMODAT
			,A.LMOTIM
			,A.LMOUSR
			,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.LMOUSR),' ') AS LUSRNM
			,A.INDBZL AS INDBZL
			,A.INDARC AS INDARC
			,A.UPDCHK AS UPDCHK
		FROM LOCMA A
   LEFT JOIN ZONMA ZA ON ZA.ZONEKY = A.ZONEKY AND ZA.WAREKY = A.WAREKY
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND A.WAREKY = #{WAREKY}
		</if>
		<if test="LOCATY != null and LOCATY != ''">
			AND LOCATY = #{LOCATY}
		</if>
		<if test="STATUS != null and STATUS != ''">
			AND STATUS = #{STATUS}
		</if>
		<if test="AREAKY != null and AREAKY != ''">
			AND A.AREAKY = #{AREAKY}
		</if>
		<if test="ZONEKY != null and ZONEKY != ''">
			AND A.ZONEKY = #{ZONEKY}
		</if>
		<if test="INDAVB == &quot;INDUPA&quot;">
			AND INDUPA ='V'
		</if>
		<if test="INDAVB == &quot;INDUPK&quot;">
			AND INDUPK ='V'
		</if>
<!-- 		<isEqual property="INDUPK" compareValue="on"> -->
<!-- 			AND INDUPK ='V' -->
<!-- 		</isEqual> -->
<!-- 		<isNotEqual property="INDUPK" compareValue="on" > -->
<!-- 			AND INDUPK=' ' -->
<!-- 		</isNotEqual> -->
<!-- 		<isEqual property="INDUPA" compareValue="on"> -->
<!-- 			AND INDUPA ='V' -->
<!-- 		</isEqual> -->
<!-- 		<isNotEqual property="INDUPA" compareValue="on" > -->
<!-- 			AND INDUPA=' ' -->
<!-- 		</isNotEqual> -->
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	</select>
	
	<!-- 구성> 지번★ 조회 -->
	<select id="LOCMA_MAP" parameterType="Map" resultType="DataMap">
	SELECT WAREKY
			,LOCAKY
			,LOCATY
			,SHORTX
			,TASKTY
			,ZONEKY
			,AREAKY
			,NVL((SELECT CDESC1 FROM CMCDV C WHERE CMCDKY = 'LOCATY' AND C.CMCDVL = A.LOCATY),' ') AS LOCATYT
			,TKZONE
			,FACLTY
			,ARLVLL
			,INDCPC
			,INDTUT
			,IBROUT
			,OBROUT
			,RPROUT
			,STATUS
			,NVL((SELECT CDESC1 FROM CMCDV C WHERE C.CMCDKY = 'STATUS' AND C.CMCDVL = A.STATUS),' ') AS STATUST
			,ABCANV
			,LENGTH
			,WIDTHW
			,HEIGHT
			,CUBICM
			,MAXCPC
			,MAXQTY
			,MAXWGT
			,MAXLDR
			,MAXSEC
			,MIXSKU
			,MIXLOT
			,RPNCAT
			,INDQTC
			,QTYCHK
			,NEDSID
			,INDUPA
			,INDUPK
			,AUTLOC
			,CREDAT
			,CRETIM
			,CREUSR
			,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.CREUSR),' ') AS CUSRNM
			,LMODAT
			,LMOTIM
			,LMOUSR
			,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.LMOUSR),' ') AS LUSRNM
			,INDBZL AS INDBZL
			,INDARC AS INDARC
			,UPDCHK AS UPDCHK
		FROM LOCMA A
		WHERE 1 = 1
			AND WAREKY = #{WAREKY}
			AND LOCAKY = #{LOCAKY}
	</select>
	
	<select id="LOCMA2_LIST" parameterType="Map" resultType="DataMap">
	     SELECT  #{WAREKY} AS WAREKY
		       , #{LOCAKY} AS LOCAKY
		       , #{LOCATY} AS LOCATY
		       , #{SHORTX} AS SHORTX
		       , #{TASKTY} AS TASKTY
		       , #{ZONEKY} AS ZONEKY
		       , #{ZONEKY} AS ZONEKY2
		       , #{AREAKY} AS AREAKY
		       , #{TKZONE} AS TKZONE
		       , #{FACLTY} AS FACLTY
		       , #{ARLVLL} AS ARLVLL
		       , #{INDCPC} AS INDCPC
		       , #{INDTUT} AS INDTUT
		       , #{IBROUT} AS IBROUT
		       , #{OBROUT} AS OBROUT
		       , #{RPROUT} AS RPROUT
		       , #{STATUS} AS STATUS
		       , #{ABCANV} AS ABCANV
		       , #{LENGTH} AS LENGTH
		       , #{WIDTHW} AS WIDTHW
		       , #{HEIGHT} AS HEIGHT
		       , #{CUBICM} AS CUBICM
		       , #{MAXCPC} AS MAXCPC
		       , #{MAXQTY} AS MAXQTY
		       , #{MAXWGT} AS MAXWGT
		       , #{MAXLDR} AS MAXLDR
		       , #{MAXSEC} AS MAXSEC
		       , #{MIXSKU} AS MIXSKU
		       , #{MIXLOT} AS MIXLOT
		       , #{RPNCAT} AS RPNCAT
		       , #{INDQTC} AS INDQTC
		       , #{QTYCHK} AS QTYCHK
		       , #{NEDSID} AS NEDSID
		       , #{INDUPA} AS INDUPA
		       , #{INDUPK} AS INDUPK
		       , #{AUTLOC} AS AUTLOC
		       , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT
		       , TO_CHAR(SYSDATE, 'HHMISS') AS CRETIM
		       , #{SES_USER_ID} AS CREUSR
		       , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = #{SES_USER_ID}),' ') AS CUSRNM
		       , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT
		       , TO_CHAR(SYSDATE, 'HHMISS') AS LMOTIM
			   , #{SES_USER_ID} AS LMOUSR
			   , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = #{SES_USER_ID}),' ') AS LUSRNM
			   , #{INDBZL} AS INDBZL
			   , #{INDARC} AS INDARC
			   , #{UPDCHK} AS UPDCHK 
		FROM DUAL 
	</select>
	
		<!-- 구성> 지번★  신규 
	<insert id="LOCMA_INSERT" parameterClass="Map">
		INSERT INTO LOCMA 
		    (
		     WAREKY,AREAKY,ZONEKY,LOCAKY,LOCATY,TKZONE,
		     STATUS,INDUPA,INDUPK,INDCPC,MAXCPC,
		     WIDTHW,HEIGHT,MIXSKU,
		     MIXLOT,CREDAT,CRETIM,CREUSR
		    ) 
		 VALUES 
		     (
		      #{WAREKY},#{AREAKY},#{ZONEKY},#{LOCAKY},#{LOCATY},#{TKZONE},
		      #{STATUS},#{INDUPA},#{INDUPK},#{INDCPC},#{MAXCPC},
		      #{WIDTHW},#{HEIGHT},#{MIXSKU},#{MIXLOT},
		      TO_CHAR(SYSDATE, 'YYYYMMDD'),
		      TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}
		     )
	</insert>
	-->
	<insert id="LOCMA_INSERT" parameterType="Map">
		INSERT INTO LOCMA
		(
		    CREDAT, CRETIM, CREUSR
		  , LMODAT, LMOTIM, LMOUSR
		  , INDBZL, INDARC, UPDCHK
		  , WAREKY -- PK_1
		  , LOCAKY -- PK_2
		  <if test="LOCATY != null and LOCATY != ''">, LOCATY</if>
		  <if test="SHORTX != null and SHORTX != ''">, SHORTX</if>
		  <if test="TASKTY != null and TASKTY != ''">, TASKTY</if>
		  <if test="ZONEKY != null and ZONEKY != ''">, ZONEKY</if>
		  <if test="AREAKY != null and AREAKY != ''">, AREAKY</if>
		  <if test="TKZONE != null and TKZONE != ''">, TKZONE</if>
		  <if test="FACLTY != null and FACLTY != ''">, FACLTY</if>
		  <if test="ARLVLL != null and ARLVLL != ''">, ARLVLL</if>
		  <if test="INDCPC != null and INDCPC != ''">, INDCPC</if>
		  <if test="INDTUT != null and INDTUT != ''">, INDTUT</if>
		  <if test="IBROUT != null and IBROUT != ''">, IBROUT</if>
		  <if test="OBROUT != null and OBROUT != ''">, OBROUT</if>
		  <if test="RPROUT != null and RPROUT != ''">, RPROUT</if>
		  <if test="STATUS != null and STATUS != ''">, STATUS</if>
		  <if test="ABCANV != null and ABCANV != ''">, ABCANV</if>
		  <if test="LENGTH != null and LENGTH != ''">, LENGTH</if>
		  <if test="WIDTHW != null and WIDTHW != ''">, WIDTHW</if>
		  <if test="HEIGHT != null and HEIGHT != ''">, HEIGHT</if>
		  <if test="CUBICM != null and CUBICM != ''">, CUBICM</if>
		  <if test="MAXCPC != null and MAXCPC != ''">, MAXCPC</if>
		  <if test="MAXQTY != null and MAXQTY != ''">, MAXQTY</if>
		  <if test="MAXWGT != null and MAXWGT != ''">, MAXWGT</if>
		  <if test="MAXLDR != null and MAXLDR != ''">, MAXLDR</if>
		  <if test="MAXSEC != null and MAXSEC != ''">, MAXSEC</if>
		  <if test="MIXSKU != null and MIXSKU != ''">, MIXSKU</if>
		  <if test="MIXLOT != null and MIXLOT != ''">, MIXLOT</if>
		  <if test="RPNCAT != null and RPNCAT != ''">, RPNCAT</if>
		  <if test="INDQTC != null and INDQTC != ''">, INDQTC</if>
		  <if test="QTYCHK != null and QTYCHK != ''">, QTYCHK</if>
		  <if test="NEDSID != null and NEDSID != ''">, NEDSID</if>
		  <if test="INDUPA != null and INDUPA != ''">, INDUPA</if>
		  <if test="INDUPK != null and INDUPK != ''">, INDUPK</if>
		  <if test="AUTLOC != null and AUTLOC != ''">, AUTLOC</if>
		)
		VALUES(
		    TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
		  , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
		  , ' ', ' ', 0
		  , #{WAREKY} -- PK_1
		  , #{LOCAKY} -- PK_2
		  <if test="LOCATY != null and LOCATY != ''">, #{LOCATY}</if>
		  <if test="SHORTX != null and SHORTX != ''">, #{SHORTX}</if>
		  <if test="TASKTY != null and TASKTY != ''">, #{TASKTY}</if>
		  <if test="ZONEKY != null and ZONEKY != ''">, #{ZONEKY}</if>
		  <if test="AREAKY != null and AREAKY != ''">, #{AREAKY}</if>
		  <if test="TKZONE != null and TKZONE != ''">, #{TKZONE}</if>
		  <if test="FACLTY != null and FACLTY != ''">, #{FACLTY}</if>
		  <if test="ARLVLL != null and ARLVLL != ''">, #{ARLVLL}</if>
		  <if test="INDCPC != null and INDCPC != ''">, #{INDCPC}</if>
		  <if test="INDTUT != null and INDTUT != ''">, #{INDTUT}</if>
		  <if test="IBROUT != null and IBROUT != ''">, #{IBROUT}</if>
		  <if test="OBROUT != null and OBROUT != ''">, #{OBROUT}</if>
		  <if test="RPROUT != null and RPROUT != ''">, #{RPROUT}</if>
		  <if test="STATUS != null and STATUS != ''">, #{STATUS}</if>
		  <if test="ABCANV != null and ABCANV != ''">, #{ABCANV}</if>
		  <if test="LENGTH != null and LENGTH != ''">, #{LENGTH}</if>
		  <if test="WIDTHW != null and WIDTHW != ''">, #{WIDTHW}</if>
		  <if test="HEIGHT != null and HEIGHT != ''">, #{HEIGHT}</if>
		  <if test="CUBICM != null and CUBICM != ''">, #{CUBICM}</if>
		  <if test="MAXCPC != null and MAXCPC != ''">, #{MAXCPC}</if>
		  <if test="MAXQTY != null and MAXQTY != ''">, #{MAXQTY}</if>
		  <if test="MAXWGT != null and MAXWGT != ''">, #{MAXWGT}</if>
		  <if test="MAXLDR != null and MAXLDR != ''">, #{MAXLDR}</if>
		  <if test="MAXSEC != null and MAXSEC != ''">, #{MAXSEC}</if>
		  <if test="MIXSKU != null and MIXSKU != ''">, #{MIXSKU}</if>
		  <if test="MIXLOT != null and MIXLOT != ''">, #{MIXLOT}</if>
		  <if test="RPNCAT != null and RPNCAT != ''">, #{RPNCAT}</if>
		  <if test="INDQTC != null and INDQTC != ''">, #{INDQTC}</if>
		  <if test="QTYCHK != null and QTYCHK != ''">, #{QTYCHK}</if>
		  <if test="NEDSID != null and NEDSID != ''">, #{NEDSID}</if>
		  <if test="INDUPA != null and INDUPA != ''">, #{INDUPA}</if>
		  <if test="INDUPK != null and INDUPK != ''">, #{INDUPK}</if>
		  <if test="AUTLOC != null and AUTLOC != ''">, #{AUTLOC}</if>
		)
	</insert>
	
	
	<select id="LOCMA_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT
			  <!-- CASE
			    WHEN B.ZONEKY IS NULL THEN 'MASTER_M0989' || ' ' || A.ZONEKY
			    WHEN C.LOCAKY IS NOT NULL THEN 'VALID_M0104' || ' ' || A.LOCAKY
			    ELSE 'OK'
			  END AS MSG -->
			  'OK'  AS MSG
		FROM (
			   		${VALIDATION_SQL} 
			 ) A
			  LEFT OUTER JOIN ZONMA B ON B.ZONEKY = A.ZONEKY AND B.WAREKY = A.WAREKY
			  LEFT OUTER JOIN LOCMA C ON C.LOCAKY = A.LOCAKY AND B.WAREKY = A.WAREKY
			  WHERE 1 = 1
			  AND ROWNUM = 1
	</select>
	
	<!-- 구성> 거점명 -->
	<select id="WAREKY_MAP" parameterType="Map" resultType="DataMap">
		SELECT WAREKY, NAME01 
		FROM WAHMA
		WHERE 1 = 1 
		AND WAREKY = #{WAREKY} 
	</select>

	<!-- 구성> 지번★  창고키 -->
	<select id="AREAKY_MAP" parameterType="Map" resultType="DataMap">
		SELECT AREAKY AS AREAKY 
		FROM ZONMA 
		WHERE 1 = 1 
		AND WAREKY = #{WAREKY} 
		AND ZONEKY = #{ZONEKY}
		AND ROWNUM = 1
	</select>
	
	<select id="AREAKY2_MAP" parameterType="Map" resultType="DataMap">
	  	SELECT  SHORTX AS ZONENM, 
                AREAKY AS AREAKY , 
                (SELECT SHORTX FROM AREMA WHERE WAREKY = ZONMA.WAREKY AND AREAKY =  ZONMA.AREAKY) AS AREANM 
	  	  FROM ZONMA 
	  	  WHERE 1 = 1 
  	  	    AND WAREKY = #{WAREKY} 
	  	    AND ZONEKY = #{ZONEKY}
	  	    AND ROWNUM = 1
	</select>
	
	<!-- 구성> 지번★  창고키 유무 확인 -->
	<select id="ZONEKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		  FROM ZONMA 
		 WHERE 1 = 1 
    	   AND WAREKY = #{WAREKY} 
           AND ZONEKY = #{ZONEKY}
	</select>
	
	<!-- 구성> 지번★ 작업구역 유무 확인 -->
	<select id="TKZONEval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		  FROM ZONMA 
		 WHERE 1 = 1 
    	   AND WAREKY = #{WAREKY} 
           AND ZONEKY = #{TKZONE}
	</select>
	
	 	<!-- 구성> 지번★  삭제 전 Validation 체크-->
	<select id="LOCMAval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM LOCMA 
		WHERE 1 = 1
		AND WAREKY = #{WAREKY}
		AND LOCAKY = #{LOCAKY}
	</select>

