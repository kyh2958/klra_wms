		</if>
		<if test="LENGTH != null and LENGTH != ''">
			LENGTH = #{LENGTH},
		</if>
		<if test="WIDTHW != null and WIDTHW != ''">
			WIDTHW = #{WIDTHW},
		</if>
		<if test="HEIGHT != null and HEIGHT != ''">
			HEIGHT = #{HEIGHT},
		</if>
		<if test="CUBICM != null and CUBICM != ''">
			CUBICM = #{CUBICM},
		</if>
		<if test="CAPACT != null and CAPACT != ''">
			CAPACT = #{CAPACT},
		</if>
		<if test="DUOMKY != null and DUOMKY != ''">
			DUOMKY = #{DUOMKY},
		</if>
		<if test="QTDUOM != null and QTDUOM != ''">
			QTDUOM = #{QTDUOM},
		</if>
		<if test="ABCANV != null and ABCANV != ''">
			ABCANV = #{ABCANV},
		</if>
		<if test="LOTL08 != null and LOTL08 != ''">
			LOTL08 = #{LOTL08},
		</if>
		<if test="ECTWD != null and ECTWD != ''">
			SECTWD = #{ECTWD},
		</if>
		<if test="WEIGHT != null and WEIGHT != ''">
			WEIGHT = #{WEIGHT},
		</if>
		<if test="BATMNG != null and BATMNG != ''">
			BATMNG = #{BATMNG},
		</if>
		<if test="ASKU04 != null and ASKU04 != ''">
			ASKU04 = #{ASKU04},
		</if>
		<if test="INNDPT != null and INNDPT != ''">
			INNDPT = #{INNDPT},
		</if>
        <if test="EANCOD != null and EANCOD != ''">
			EANCOD = #{EANCOD},
		</if>
        <if test="GTINCD != null and GTINCD != ''">
			GTINCD = #{GTINCD},
		</if>
        <if test="GRSWGT != null and GRSWGT != ''">
			GRSWGT = #{GRSWGT},
		</if>
        <if test="NETWGT != null and NETWGT != ''">
			NETWGT = #{NETWGT},
		</if>
        <if test="WGTUNT != null and WGTUNT != ''">
			WGTUNT = #{WGTUNT},
		</if>
		<if test="ASKL03 != null and ASKL03 != ''"> 
		 ASKL03 = #{ASKL03} ,
		</if> 
		<if test="BUFMNG != null and BUFMNG != ''">
			BUFMNG = #{BUFMNG}
		</if>
	WHERE 1 = 1
	AND OWNRKY = #{OWNRKY} 
	AND SKUKEY = #{SKUKEY} 
	</update>
	
