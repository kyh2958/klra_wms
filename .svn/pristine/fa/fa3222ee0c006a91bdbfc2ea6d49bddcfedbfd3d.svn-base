	<!-- SKU> SKU★22  삭제 -->
	<delete id="SKUWC_DELETE" parameterType="Map">
		 DELETE FROM SKUWC
 		 WHERE 1 = 1
		 AND WAREKY = #{WAREKY} 
		 AND OWNRKY = #{OWNRKY} 
		 AND SKUKEY = #{SKUKEY} 

	</delete>
	
	<!-- SKU> SKU★  삭제 -->
	<delete id="SKUMA_DELETE" parameterType="Map">
		 DELETE FROM SKUMA
 		 WHERE 1 = 1
		 AND OWNRKY = #{OWNRKY} 
		 AND SKUKEY = #{SKUKEY} 

	</delete>
	
	<select id="SKUPLT_LIST" parameterType="Map" resultType="DataMap" >
		SELECT WAREKY
		      ,PLNTKY
		      ,SZF_GET_CMCDV_CDESC1_TEXT('KR', 'LOTA02', PLNTKY) AS PLNTNM
		      ,SP.SKUKEY
		      ,SM.DESC01
		      ,QRTAYN --품질검사여부
		      ,SHTAYN --즉시불출여부
		      ,SKUG01
		      ,SKUG05
              ,SKUL01
              ,STLKY --입고기본저장위치
              ,NVL((SELECT STLNM FROM STLMA SM WHERE SM.PLNTKY = SP.PLNTKY AND SM.STLKY = SP.STLKY), ' ') AS STLKYNM
		      ,SP.CREDAT
			  ,SP.CRETIM
			  ,SP.CREUSR
			  ,NVL((SELECT NMLAST FROM USRMA D WHERE D.USERID = SP.CREUSR),' ') AS CUSRNM
			  ,SP.LMODAT
			  ,SP.LMOTIM
			  ,SP.LMOUSR
			  ,NVL((SELECT NMLAST FROM USRMA D WHERE D.USERID = SP.LMOUSR),' ') AS LUSRNM
		 FROM SKUPLT SP
   LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = SP.OWNRKY
                           AND SM.SKUKEY = SP.SKUKEY
		WHERE 1=1
		<if test="WAREKY != null and WAREKY != ''">
			AND WAREKY = #{WAREKY}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''"> 
			${RANGE_SQL}
		</if>
		<if test="SKUG01 != null and SKUG01 != ''">
			AND SKUG01 = #{SKUG01}
		</if>
		<if test="SKUL01 != null and SKUL01 != ''">
			AND SKUL01 = #{SKUL01}
		</if>
		<if test="SKUG05 != null and SKUG05 != ''">
			AND SKUG05 = #{SKUG05}
		</if>
	</select>

	
	<select id="UOMKEYCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
		      ,CDESC1 AS TEXT_COL
		FROM CMCDV C
		WHERE C.CMCDKY = 'DUOMKY'
	</select>
	
	<select id="DELMAKCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
		      ,CDESC1 AS TEXT_COL
		FROM CMCDV C
		WHERE C.CMCDKY = 'DELMAK'
	</select>
	
	<select id="IBPROTCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
		      ,CDESC1 AS TEXT_COL
		FROM CMCDV C
		WHERE C.CMCDKY = 'IBPROT'
	</select>
	
	<select id="OBPROTCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
		      ,CDESC1 AS TEXT_COL
		FROM CMCDV C
		WHERE C.CMCDKY = 'OBPROT'
	</select>

	<select id="UOMMA_LIST" parameterType="Map" resultType="DataMap">
		SELECT UOMMA.*
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = UOMMA.CREUSR), ' ') AS CUSRNM
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = UOMMA.LMOUSR), ' ') AS LUSRNM
		  FROM UOMMA
		 WHERE 1 = 1
		   <if test="UOMKEY != null and UOMKEY != ''">AND UOMKEY = #{UOMKEY}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
		 ORDER BY UOMKEY
	</select>
	
	<select id="UOMMA_DUPL_VALIDATION_OBJECT" parameterType="Map" resultType="String">
		SELECT CASE WHEN STATUS_SUM &gt; 1
		                 THEN '단위 [' || UOMKEY || ']이/가 중복 되었습니다.'
		            ELSE ' '
		       END AS VALIDATION_MSG
		  FROM (
		         SELECT UOMKEY, SUM(STATUS) AS STATUS_SUM
		           FROM (
		                  SELECT 1 AS STATUS, UOMKEY FROM UOMMA UNION ALL
		                  ${VALIDATION_DUPL_SQL}
		                )
		          GROUP BY UOMKEY
		         HAVING SUM(STATUS) &gt; 1
		          ORDER BY UOMKEY
		       ) VALID
		 WHERE ROWNUM = 1
	</select>

	<insert id="UOMMA_INSERT" parameterType="Map">
		INSERT INTO UOMMA
		(
		    CREDAT, CRETIM, CREUSR
		  , LMODAT, LMOTIM, LMOUSR
		  , INDBZL, INDARC, UPDCHK
		  , UOMKEY -- PK_1
		  <if test="SHORTX != null and SHORTX != ''">, SHORTX</if>
		  <if test="INDDEC != null and INDDEC != ''">, INDDEC</if>
		)
		VALUES(
		    TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , ' ', ' ', 0
		  , #{UOMKEY} -- PK_1
		  <if test="SHORTX != null and SHORTX != ''">, #{SHORTX}</if>
		  <if test="INDDEC != null and INDDEC != ''">, #{INDDEC}</if>
		)
	</insert>

	<update id="UOMMA_UPDATE" parameterType="Map">
		UPDATE UOMMA
		   SET LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
		     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
		     , LMOUSR = #{SES_USER_ID}
		     <if test="SHORTX != null and SHORTX != ''">, SHORTX = #{SHORTX}</if>
		     <if test="INDDEC != null and INDDEC != ''">, INDDEC = #{INDDEC}</if>
		 WHERE 1 = 1
		   <if test="UOMKEY != null and UOMKEY != ''">AND UOMKEY = #{UOMKEY}</if>
	</update>

	<delete id="UOMMA_DELETE" parameterType="Map">
		DELETE FROM UOMMA
		 WHERE 1 = 1
		   <if test="UOMKEY != null and UOMKEY != ''">AND UOMKEY = #{UOMKEY}</if>
	</delete>
	
	<!-- SKU> 단위구성 조회 상단 -->
	<select id="MEASH_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
		SELECT A.WAREKY
		,A.MEASKY
		,A.SHORTX
		,A.CREDAT
		,A.CRETIM
		,A.CREUSR
		,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.CREUSR),' ') AS CUSRNM
		,A.LMODAT
		,A.LMOTIM
		,A.LMOUSR
		,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.LMOUSR),' ') AS LUSRNM
		,A.INDBZL
		,A.INDARC
		,A.UPDCHK
		,A.WAREKY || A.MEASKY AS KEY
		, ' ' AS STATUS
		FROM MEASH A
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND A.WAREKY = #{WAREKY}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		ORDER BY A.MEASKY
	</select>
	
	<!-- SKU> head 재조회 상단 -->
	<select id="MEASHHEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY
		,A.MEASKY
		,A.SHORTX
		,A.CREDAT
		,A.CRETIM
		,A.CREUSR
		,A.LMODAT
		,A.LMOTIM
		,A.LMOUSR
		,A.INDBZL
		,A.INDARC
		,A.UPDCHK
		,A.WAREKY || A.MEASKY AS KEY
		, ' ' AS STATUS
		FROM MEASH A
		WHERE 1 = 1
		AND WAREKY = #{WAREKY} 
		ORDER BY A.MEASKY
	</select>

	<!-- SKU> 단위구성 조회 하단 -->
	<select id="MEASHSub_LIST" parameterType="Map" resultType="DataMap">
		SELECT  B.WAREKY AS WAREKY
		       ,B.MEASKY AS MEASKY
		       ,B.ITEMNO AS ITEMNO
		       ,B.UOMKEY AS UOMKEY
		       ,B.QTPUOM AS QTPUOM
		       ,NVL((SELECT DUOMKY FROM SKUMA SM WHERE SM.SKUKEY = B.MEASKY), ' ') AS DUOMKY
		       ,B.INDDFU AS INDDFU
		       ,B.DISREC AS DISREC
		       ,B.DISSHP AS DISSHP
		       ,B.DISTAS AS DISTAS
		       ,B.UPDCHK AS UPDCHK
		       ,B.CUBICM AS CUBICM
		       ,B.WAREKY || B.MEASKY AS KEY
		       , ' ' AS STATUS
		       ,B.QTAUOM AS QTAUOM
		       ,A.CREDAT
			   ,A.CRETIM
			   ,A.CREUSR
			   ,A.LMODAT
			   ,A.LMOTIM
			   ,A.LMOUSR
			   ,A.INDBZL
			   ,A.INDARC
			   ,NVL((SELECT NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR),' ') AS CUSRNM
			   ,NVL((SELECT NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR),' ') AS LUSRNM
		FROM  MEASH A
		      INNER JOIN MEASI B
		              ON A.WAREKY = B.WAREKY
		             AND A.MEASKY = B.MEASKY
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND A.WAREKY = #{WAREKY}
		</if>
		<if test="MEASKY != null and MEASKY != ''">
			AND A.MEASKY = #{MEASKY}
		</if>
		ORDER BY B.MEASKY, B.ITEMNO
	</select>
	
	 	<!-- SKU> 단위구성  ITEMNO-->
	<select id="ITEMNO_MAP" parameterType="Map" resultType="DataMap">
	  	SELECT  LPAD(MAX(ITEMNO)+10,6,'0') AS ITEMNO FROM  MEASH A
		      INNER JOIN MEASI B
		              ON A.WAREKY = B.WAREKY
		             AND A.MEASKY = B.MEASKY
		WHERE 1 = 1
			AND A.WAREKY = #{WAREKY}
			AND A.MEASKY = #{MEASKY}
	</select>
	
	<select id="SM01MEASKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM MEASH
		WHERE WAREKY  = #{WAREKY}
		AND MEASKY = #{MEASKY}
		AND ROWNUM = 1
	</select>
    
    
		<!-- SKU> 단위구성  ITEMNO-->
	<select id="ITEMNOval_MAP" parameterType="Map" resultType="DataMap">
	  	SELECT COUNT(*)CNT
		FROM  MEASH A
		      INNER JOIN MEASI B
		              ON A.WAREKY = B.WAREKY
		             AND A.MEASKY = B.MEASKY
		WHERE 1 = 1
		    AND A.WAREKY = #{WAREKY}
			AND A.MEASKY = #{MEASKY}
	</select>
	
	<!-- SKU> 단위구성  상단 신규 -->
	<insert id="MEASH_INSERT" parameterType="Map">
		INSERT INTO MEASH 
			(
			 WAREKY,MEASKY,SHORTX,CREDAT,
			 CRETIM,CREUSR,LMODAT,LMOTIM,LMOUSR
			) 
 		VALUES 
 			(
 			NVL(#{WAREKY},' '),NVL(#{MEASKY},' '),NVL(#{SHORTX},' '),TO_CHAR(SYSDATE, 'YYYYMMDD'),
 			TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
		     TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}
 			 )
	</insert>

	
	<!-- SKU> 단위구성  하단 신규 -->
	<insert id="MEASHSub_INSERT" parameterType="Map">
		INSERT INTO MEASI 
			(
			 WAREKY,MEASKY,ITEMNO,UOMKEY,QTPUOM,INDDFU,
			 DISREC,DISSHP,DISTAS,LENGTH,WIDTHW,HEIGHT,
			 CUBICM,CREDAT,CRETIM,CREUSR,LMODAT,LMOTIM,
			 LMOUSR, QTAUOM
			) 
 		VALUES
 			(
 			 NVL(#{WAREKY},' '),NVL(#{MEASKY},' '),NVL(#{ITEMNO},' '),NVL(#{UOMKEY},' '),TO_NUMBER(NVL(TRIM(#{QTPUOM}), 0)),NVL(#{INDDFU},' '),
 			 NVL(#{DISREC},' '),NVL(#{DISSHP},' '),NVL(#{DISTAS},' '),TO_NUMBER(NVL(#{LENGTH}, 0)),TO_NUMBER(NVL(#{WIDTHW}, 0)),TO_NUMBER(NVL(#{HEIGHT}, 0)),
 			 TO_NUMBER(NVL(#{CUBICM}, 0)),TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
		     TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}, NVL(#{QTAUOM}, ' ')
		     
 			 )
	</insert>
		
	<!-- SKU> 단위구성  상단 삭제 -->
	<delete id="MEASH_DELETE" parameterType="Map">
		 DELETE FROM MEASH
	 	 WHERE 1 = 1
		 AND WAREKY = #{WAREKY} 
		 AND MEASKY = #{MEASKY}
	</delete>
	
	<!-- SKU> 단위구성  하단 삭제 -->
	<delete id="MEASHSub_DELETE" parameterType="Map">
		 DELETE FROM MEASI
 		 WHERE 1 = 1
		 AND WAREKY = #{WAREKY} 
		 AND MEASKY = #{MEASKY}
		 AND ITEMNO = #{ITEMNO}
	</delete>
	
	<!-- SKU> 단위구성 헤드 삭제 -->
	<delete id="MEASHSubAll_DELETE" parameterType="Map">
		 DELETE FROM MEASI
 		 WHERE 1 = 1
		 AND WAREKY = #{WAREKY} 
		 AND MEASKY = #{MEASKY}
	</delete>
	
	<!-- SKU> 단위구성 조회 상단 수정 -->
	<update id="MEASH_UPDATE" parameterType="Map">
		 UPDATE MEASH SET 
	<if test="SHORTX != null and SHORTX != ''"> 
		 SHORTX = #{SHORTX} ,
	</if> 
	<if test="INDBZL != null and INDBZL != ''"> 
		 INDBZL = #{INDBZL} ,
	</if> 
	<if test="INDARC != null and INDARC != ''"> 
		 INDARC = #{INDARC} ,
	</if> 
	<if test="UPDCHK != null and UPDCHK != ''"> 
		 UPDCHK = #{UPDCHK} ,
	</if> 
	LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
	LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
	LMOUSR = #{SES_USER_ID}
 	 WHERE 1 = 1
	 AND WAREKY = #{WAREKY} 
	 AND MEASKY = #{MEASKY} 
		</update>
		
	<!-- SKU> 단위구성 조회 하단 수정 -->
	<update id="MEASHSub_UPDATE" parameterType="Map">
		UPDATE MEASI SET 
		<if test="QTPUOM != null and QTPUOM != ''"> 
			 QTPUOM = #{QTPUOM} ,
		</if> 
		<if test="INDDFU != null and INDDFU != ''"> 
			 INDDFU = #{INDDFU} ,
		</if> 
		<if test="DISREC != null and DISREC != ''"> 
			 DISREC = #{DISREC} ,
		</if> 
		<if test="DISSHP != null and DISSHP != ''"> 
			 DISSHP = #{DISSHP} ,
		</if> 
		<if test="DISTAS != null and DISTAS != ''"> 
			 DISTAS = #{DISTAS} ,
		</if> 
		<if test="UOMKEY != null and UOMKEY != ''"> 
			 UOMKEY = #{UOMKEY} ,
		</if> 
		<if test="LENGTH != null and LENGTH != ''"> 
			 LENGTH = #{LENGTH} ,
		</if> 
		<if test="WIDTHW != null and WIDTHW != ''"> 
			 WIDTHW = #{WIDTHW} ,
		</if> 
		<if test="HEIGHT != null and HEIGHT != ''"> 
			 HEIGHT = #{HEIGHT} ,
		</if> 
		<if test="CUBICM != null and CUBICM != ''"> 
			 CUBICM = #{CUBICM} ,
		</if> 
		<if test="INDBZL != null and INDBZL != ''"> 
			 INDBZL = #{INDBZL} ,
		</if> 
		<if test="INDARC != null and INDARC != ''"> 
			 INDARC = #{INDARC} ,
		</if> 
		<if test="UPDCHK != null and UPDCHK != ''"> 
			 UPDCHK = #{UPDCHK}, 
		</if> 
		LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
		LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
		LMOUSR = #{SES_USER_ID}
 	 WHERE 1 = 1
	 AND WAREKY = #{WAREKY} 
	 AND MEASKY = #{MEASKY} 
	 AND ITEMNO = #{ITEMNO}
		</update>
		
		<!-- SKU> SET/BOM 상단 조회 상단 -->
	<select id="SORTSQ_MAP" parameterType="Map" resultType="DataMap">
	  	SELECT  MAX(SORTSQ)+1 AS SORTSQ FROM PAKMA A
		WHERE  1 = 1
		AND A.WAREKY = #{WAREKY}
		AND A.PACKID = #{PACKID}

	</select>
	
		<!-- SKU> SET/BOM 하단 CNT -->
	<select id="SORTSQval_MAP" parameterType="Map" resultType="DataMap">
	  	SELECT COUNT(*)CNT
		FROM PAKMA A
		   LEFT OUTER JOIN SKUMA SM
		           ON SM.OWNRKY = #{SES_OWNER}
		          AND SM.SKUKEY = A.PACKID
		   LEFT OUTER JOIN SKUMA SM2
		           ON SM2.OWNRKY = #{SES_OWNER}
		          AND SM2.SKUKEY = A.SKUKEY
		   LEFT OUTER JOIN USRMA CU
		           ON CU.USERID = A.CREUSR
		   LEFT OUTER JOIN USRMA LU
		           ON LU.USERID = A.CREUSR
		WHERE  1 = 1
		AND A.WAREKY = #{WAREKY}
		AND A.PACKID = #{PACKID}
	</select>	

	<!-- SKU> SET/BOM 상단 조회 상단 -->
	<select id="PAKMA_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY||A.PACKID AS KEY,
		       A.WAREKY,
		       A.PACKID,
		       NVL(B.DESC01,' ') AS SHORTX,
		       A.PAKQTY AS PAKQTY,
		       ' ' AS STATUS
		  FROM PAKMA A
		       LEFT OUTER JOIN SKUMA B
		               ON B.OWNRKY = #{SES_OWNER}
		              AND B.SKUKEY = A.PACKID
		 WHERE 1=1
		   <if test="WAREKY != null and WAREKY != ''">
			AND A.WAREKY = #{WAREKY}
			</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
			</if>
		 GROUP BY A.WAREKY, A.PACKID, A.PAKQTY, B.DESC01
		 ORDER BY A.WAREKY, A.PACKID, A.PAKQTY
	</select>
	
		<!-- SKU> SET/BOM 하단 조회  -->
	<select id="PAKMAsub_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY||A.PACKID AS KEY,
		       A.WAREKY AS WAREKY,
		       A.PACKID AS PACKID,
		       NVL(SM.DESC01,' ') AS SHORTX,
		       A.PAKQTY AS PAKQTY,
		       A.SKUKEY AS SKUKEY,
		       NVL(SM2.DESC01,' ') AS DESC01,
		       A.UOMQTY AS UOMQTY,
		       A.SORTSQ AS SORTSQ,
		       A.CREDAT AS CREDAT,
		       A.CRETIM AS CRETIM,
		       A.CREUSR AS CREUSR,
		       CU.NMLAST AS CUSRNM,
		       A.LMODAT AS LMODAT,
		       A.LMOTIM AS LMOTIM,
		       A.LMOUSR AS LMOUSR,
		       LU.NMLAST AS LUSRNM, 
		       ' ' AS STATUS
		  FROM PAKMA A
		       LEFT OUTER JOIN SKUMA SM
		               ON SM.OWNRKY = #{SES_OWNER}
		              AND SM.SKUKEY = A.PACKID
		       LEFT OUTER JOIN SKUMA SM2
		               ON SM2.OWNRKY = #{SES_OWNER}
		              AND SM2.SKUKEY = A.SKUKEY
		       LEFT OUTER JOIN USRMA CU
		               ON CU.USERID = A.CREUSR
		       LEFT OUTER JOIN USRMA LU
		               ON LU.USERID = A.CREUSR
		 WHERE  1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND A.WAREKY = #{WAREKY}
		</if>
		<if test="PACKID != null and PACKID != ''">
			AND A.PACKID = #{PACKID}
		</if>
		ORDER BY A.SORTSQ
	</select>
	
		<!-- SKU> SET/BOM 하단 수정 -->
	<update id="PAKMA_UPDATE" parameterType="Map">
			UPDATE PAKMA SET
		<if test="UOMQTY != null and UOMQTY != ''"> 
	 		UOMQTY = #{UOMQTY} ,
		</if> 
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
			LMOUSR = #{SES_USER_ID}
			WHERE 1 = 1
			 AND WAREKY = #{WAREKY} 
			 AND PACKID = #{PACKID} 
			 AND SKUKEY = #{SKUKEY}
	</update>
	
	<!-- SKU> SET/BOM 상단 신규 -->
	<insert id="PAKMA_INSERT" parameterType="Map">
		INSERT INTO PAKMA 
			(
			 WAREKY,PACKID,SKUKEY,SORTSQ,DESC01,
			 SHORTX,UOMQTY,PAKQTY,CREDAT,CRETIM,
			 CREUSR,LMODAT,LMOTIM,LMOUSR
			 )
		 VALUES 
			(
			 #{WAREKY},NVL(#{PACKID},' '),NVL(#{SKUKEY},' '),#{SORTSQ},NVL(#{DESC01},' '),
			 NVL(#{SETSKUNM},' '),TO_NUMBER(NVL(TRIM(#{UOMQTY}), 0)),TO_NUMBER(NVL(TRIM(#{PAKQTY}), 0)),TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),
			 #{SES_USER_ID},TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}
			 )
	</insert>
	
		<!-- SKU> SET/BOM SKUKEY 유무 확인 -->
	<select id="PACKIDval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		  FROM SKUMA
		   WHERE 1 = 1
           AND OWNRKY = #{SES_OWNER}
		   AND SKUKEY = #{PACKID}
	</select>
	
		<!-- SKU> SET/BOM SKUKEY 유무 확인 -->
	<select id="SKUKEY2val_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		  FROM SKUMA
		   WHERE SKUKEY = #{SKUKEY}
	</select>
	
	<select id="PAKMA_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT
		       CASE
		         WHEN SM.SKUKEY IS NULL THEN 'MASTER_M0669' || ' ' || STD.PACKID
		         WHEN SM2.SKUKEY IS NULL THEN 'MASTER_M0669' || ' ' || STD.SKUKEY
		         ELSE 'OK'
		       END AS MSG
		FROM   ( ${VALIDATION_SQL} 
                ) STD 
		        LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{SES_OWNER} AND SM.SKUKEY = STD.PACKID
		       LEFT OUTER JOIN SKUMA SM2
		               ON SM2.OWNRKY = #{SES_OWNER}
		              AND SM2.SKUKEY = STD.SKUKEY
	</select>
	
	<!-- SKU> SET/BOM  아이템리스트 삭제 -->
	<delete id="PAKMA_DELETE" parameterType="Map">
		 DELETE FROM PAKMA
	 	 WHERE 1 = 1
		 AND WAREKY = #{WAREKY} 
		 AND PACKID = #{PACKID}
		 AND SKUKEY = #{SKUKEY}
	</delete>
	
	<!-- SKU> SET/BOM  헤드 삭제 -->
	<delete id="PAKMAHEAD_DELETE" parameterType="Map">
		 DELETE FROM PAKMA
 		 WHERE 1 = 1
		 AND WAREKY = #{WAREKY} 
		 AND PACKID = #{PACKID}
	</delete>
	
	<!-- SKU> SET/BOM  SET재품명 가져오기-->
	<select id="SET_MAP" parameterType="Map" resultType="DataMap">
		 SELECT DESC01 AS SHORTX
		  FROM SKUMA
		 WHERE 1 = 1
		   AND OWNRKY = #{SES_OWNER}
		   AND SKUKEY = #{PACKID}
		   AND ROWNUM = 1
	</select>

	<!-- SKU> SET/BOM  BOM재품명 가져오기-->
	<select id="BOM_MAP" parameterType="Map" resultType="DataMap">
		 SELECT DESC01 AS DESC01
           FROM SKUMA 
           WHERE 1 = 1
           AND SKUKEY = #{SKUKEY}
           AND ROWNUM = 1
	</select>
	
	<!-- SKU> LOT/Information 조회 상단 -->
	<select id="LOTAT_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
		 SELECT LOTNUM
		       ,WAREKY
		       ,OWNRKY
		       ,SKUKEY
		       ,LOTA01
		       ,LOTA02
		       ,LOTA03
		       ,LOTA04
		       ,LOTA05
		       ,LOTA06
		       ,LOTA07
		       ,LOTA08
		       ,LOTA09
		       ,LOTA10
		       ,LOTA11
		       ,LOTA12
		       ,LOTA13
		       ,LOTA14
		       ,LOTA15
		       ,LOTA16
		       ,LOTA17
		       ,LOTA18
		       ,LOTA19
		       ,LOTA20
		       ,CREDAT
		       ,CRETIM
		       ,CREUSR
		       ,NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = LOTAT.CREUSR),' ') AS CUSRNM
		       ,LMODAT
		       ,LMOTIM
		       ,LMOUSR 
		       ,NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = LOTAT.LMOUSR),' ') AS LUSRNM
		       ,INDBZL 
		       ,INDARC
		       ,UPDCHK 
		   FROM LOTAT
		  WHERE 1 = 1
		  <if test="OWNRKY != null and OWNRKY != ''">
		  AND OWNRKY = #{OWNRKY} 
		  </if>
		<if test="WAREKY != null and WAREKY != ''"> 
          AND WAREKY = #{WAREKY}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	</select>
	
	<!-- DT01 문서종류 시작 -->
	<select id="DT01_LIST" parameterType="Map" resultType="DataMap">
		SELECT DT.DOCUTY AS DOCUTY
			 , DT.DOCCAT AS DOCCAT
			 , DT.SHORTX AS SHORTX
			 , DT.ITNINC AS ITNINC
			 , DT.INSINC AS INSINC
			 , DT.CDOCTY AS CDOCTY
			 , DT.TRNHTY AS TRNHTY
			 , DT.SKUVND AS SKUVND
			 , DT.SYSLOC AS SYSLOC
			 , DT.INDCHK AS INDCHK
			 , DT.DOCGRP AS DOCGRP
			 , DT.PRIORT AS PRIORT
			 , DT.CREDAT AS CREDAT
			 , DT.CRETIM AS CRETIM
			 , DT.CREUSR AS CREUSR
			 , DT.LMODAT AS LMODAT
			 , DT.LMOTIM AS LMOTIM
			 , DT.LMOUSR AS LMOUSR
			 , DT.UPDCHK AS UPDCHK
			 , NJ.NUMOBJ AS NUMOBJ
			 , NJ.SHORTX AS NUMOBJNM
			 , NVL((SELECT NMLAST FROM USRMA UA WHERE UA.USERID = DT.CREUSR),' ') AS CUSRNM
			 , NVL((SELECT NMLAST FROM USRMA UA WHERE UA.USERID = DT.LMOUSR),' ') AS LUSRNM
			 , TA.SHORTX AS TRNHTYNM
		FROM DOCTM DT
			LEFT OUTER JOIN NMOBJ NJ ON DT.NUMOBJ = NJ.NUMOBJ
			LEFT OUTER JOIN THTMA TA ON DT.TRNHTY = TA.TRNHTY
		WHERE 1 = 1
		<if test="DOCCAT != null and DOCCAT != ''">
			AND DT.DOCCAT = #{DOCCAT}
		</if>
		ORDER BY DOCUTY ASC
	</select>
	
	<select id="DT01TOP_MAP" parameterType="Map" resultType="DataMap">
		SELECT #{DOCCAT} AS DOCCAT
		  FROM DUAL
	</select>
	
	<select id="DT01_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT *
		  FROM ( SELECT CASE WHEN NM.NUMOBJ IS NULL THEN 'MASTER_M0074' || ' ' ||  STD.NUMOBJ
							 WHEN LC.LOCAKY IS NULL THEN 'MASTER_M0477'  || ' ' || STD.SYSLOC
							 WHEN STD.PRIORT != ' ' AND (SELECT COUNT(*) FROM ALCUS WHERE WAREKY = #{SES_WAREKY} AND SEQCUS = STD.PRIORT) = 0 THEN 'VALID_M0941'
							 ELSE 'OK'
						END AS MSG
				  FROM ( ${VALIDATION_SQL} )STD 
					LEFT OUTER JOIN NMOBJ NM ON NM.NUMOBJ = STD.NUMOBJ
					LEFT OUTER JOIN LOCMA LC ON LC.LOCAKY = STD.SYSLOC AND LC.WAREKY = #{SES_WAREKY}
				)
		WHERE MSG != 'OK'
	<!--   WHERE NM.NUMOBJ IS NULL OR (STD.SYSLOC != ' ' AND LC.LOCAKY IS NULL) -->
	</select>
	
	<update id="DT01_UPDATE" parameterType="Map">
		UPDATE DOCTM SET
			   LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		<if test="SHORTX != null and SHORTX != ''">
			, SHORTX = #{SHORTX}
		</if>
		<if test="NUMOBJ != null and NUMOBJ != ''">
			, NUMOBJ = #{NUMOBJ}
		</if>
		<if test="TRNHTY != null and TRNHTY != ''">
			, TRNHTY = #{TRNHTY}
		</if>
		<if test="SKUVND != null and SKUVND != ''">
			, SKUVND = #{SKUVND}
		</if>
		<if test="SYSLOC != null and SYSLOC != ''">
			, SYSLOC = #{SYSLOC}
		</if>
		<if test="INDCHK != null and INDCHK != ''">
			, INDCHK = #{INDCHK}
		</if>
		<if test="DOCGRP != null and DOCGRP != ''">
			, DOCGRP = #{DOCGRP}
		</if>
		<if test="DOCGRP != null and DOCGRP != ''">
			, PRIORT = #{PRIORT}
		</if>
		WHERE  1 = 1
		  AND  DOCUTY = #{DOCUTY}
	</update>
	
	<insert id="DT01_INSERT" parameterType="Map">
		INSERT
		INTO   DOCTM (DOCCAT, SHORTX, NUMOBJ, ITNINC, INSINC, CDOCTY, TRNHTY, SKUVND, SYSLOC, INDCHK, DOCGRP, PRIORT, CREDAT, CRETIM, CREUSR, LMODAT, LMOTIM, LMOUSR, UPDCHK, DOCUTY )
		VALUES (
					#{DOCCAT},
					NVL(#{SHORTX}, ' '),
					#{NUMOBJ},
					#{ITNINC},
					#{INSINC},
					NVL(#{CDOCTY},' '),
					#{TRNHTY},
					#{SKUVND},
					NVL(#{SYSLOC}, ' '),
					#{INDCHK},
					#{DOCGRP},
					#{PRIORT},
					TO_CHAR(SYSDATE, 'YYYYMMDD'),
					TO_CHAR(SYSDATE, 'HH24MISS'),
					#{SES_USER_ID},
					TO_CHAR(SYSDATE, 'YYYYMMDD'),
					TO_CHAR(SYSDATE, 'HH24MISS'),
					#{SES_USER_ID},
					TO_NUMBER(NVL(TRIM(#{UPDCHK}), 0)),
					#{DOCUTY}
				)
	</insert>
	
	<delete id="DT01_DELETE" parameterType="Map">
		DELETE FROM DOCTM
		 WHERE DOCUTY = #{DOCUTY}
	</delete>
	
	<select id="DOCCATCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT
		    DOCCAT AS VALUE_COL,
		    SHORTX AS TEXT_COL
		FROM DOCCM 
		WHERE 1 = 1
	</select>
	<!-- DT01 문서종류 끝 -->
	
	<!-- 메세지 추가 -->
	<insert id="CreateJMSGM_INSERT" parameterType="Map">
		INSERT INTO JMSGM
			(
			   LANGKY, MESGGR, MESGKY, MESGTX, CREDAT, CRETIM, CREUSR
			)VALUES(
			   'KO', 'MASTER', 'M0991', '*작업구역을 입력해 주세요.' , '00000000', '000000', 'DEV'
			)
	</insert>

	<!-- 전략규칙> 전략연결 조회 상단 -->
	<select id="ALCUS_LIST" parameterType="Map" resultType="DataMap">
	 SELECT A.WAREKY,
			A.SEQCUS,
			A.CUSTMR,
			(SELECT B.NAME01 FROM BZPTN B WHERE A.CUSTMR = B.PTNRKY AND B.PTNRTY = 'CT') AS CUSTMRNM,
			A.ALSTKY ,
			A.OWNRKY ,
			NVL((SELECT NAME01 FROM OWNER O WHERE O.OWNRKY = A.OWNRKY), ' ') AS OWNRNM,
			(SELECT SHORTX FROM ALSTH D	WHERE A.ALSTKY = D.ALSTKY AND A.WAREKY = D.WAREKY) AS SHORTX,
			A.REGN01 ,
			A.NATNKY ,
			NVL((SELECT CDESC1 FROM CMCDV C WHERE CMCDKY = 'NATNKY' AND C.CMCDVL = A.NATNKY),' ') AS NATNKYT,
			NVL((SELECT CDESC1 FROM CMCDV C WHERE C.CMCDKY = 'NATNKY' AND A.NATNKY = C.CMCDVL),' ') AS NATNKYNM,
			A.DOCUTY,
			NVL((SELECT SHORTX FROM DOCTM D WHERE D.DOCUTY = A.DOCUTY), ' ') AS DOCUNM,
			A.SLGORT,
			A.CHANEL, 
			NVL((SELECT CDESC1 FROM CMCDV C WHERE C.CMCDKY = 'KVGR1' AND A.CHANEL = C.CMCDVL),' ') AS CHANNM,
			A.SLGORT,
			A.LASTOB,
			A.CREDAT,
			A.CRETIM ,
			A.CREUSR ,
			NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.CREUSR),' ') AS CUSRNM,
			A.LMODAT ,
			A.LMOTIM ,
			A.LMOUSR ,
			NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.LMOUSR),' ') AS LUSRNM,
			A.INDBZL ,
			A.INDARC ,
			A.UPDCHK
		FROM ALCUS A
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND A.WAREKY = #{WAREKY}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	</select>
	
	<!-- 전략규칙> 전략연결 조회 체크 -->
	<select id="ALCUS_VALIDATION" parameterType="Map" resultType="DataMap">    
	 	SELECT
		  CASE
		    WHEN E.ALSTKY IS NULL THEN 'MASTER_M0287' || ' ' || STD.ALSTKY
		    WHEN A.ALSTKY IS NOT NULL THEN 'MASTER_M0581' || ' ' || STD.ALSTKY
		    WHEN A.NATNKY IS NOT NULL THEN 'MASTER_M0581' || ' ' || STD.NATNKY
		    WHEN A.WAREKY IS NOT NULL THEN 'MASTER_M0581' || ' ' || STD.ALSTKY
		    WHEN B.PTNRKY IS NULL THEN 'VALID_M0205' || ' ' || STD.CUSTMR
		    WHEN N.NATNKY IS NULL THEN 'MASTER_M0583' || ' ' || STD.NATNKY
		    ELSE 'OK'
		  END AS MSG
		FROM (
		   		${VALIDATION_SQL} 
		   	) STD LEFT OUTER JOIN ALSTH E ON E.ALSTKY = STD.ALSTKY
		  AND E.WAREKY = STD.WAREKY LEFT OUTER JOIN ALCUS A ON A.ALSTKY = STD.ALSTKY
		  AND A.CUSTMR = STD.CUSTMR
		  AND A.NATNKY = STD.NATNKY
		  AND A.WAREKY = STD.WAREKY LEFT OUTER JOIN VNATNKY N ON N.NATNKY = STD.NATNKY 
		  LEFT OUTER JOIN BZPTN B ON B.PTNRKY = STD.CUSTMR
		WHERE 1 = 2 --2017.05.22 comment
		 -- AND E.ALSTKY IS NULL
		--  OR (STD.ALSTKY != ' ' AND A.ALSTKY IS NULL)
		--  OR (STD.CUSTMR != ' ' AND A.CUSTMR IS NOT NULL OR B.PTNRKY IS NULL)
		--  OR (STD.NATNKY != ' ' AND A.NATNKY IS NOT NULL OR N.NATNKY IS NULL)

	</select>
	
		<!-- 전략규칙> 전략연결  신규 -->
	<insert id="ALCUS_INSERT" parameterType="Map">
		INSERT INTO ALCUS
		    (
		     WAREKY,SEQCUS,OWNRKY,CUSTMR,ALSTKY,REGN01,
		     CHANEL,NATNKY,DOCUTY,SLGORT,LASTOB,CREDAT,CRETIM,
		     CREUSR,LMODAT,LMOTIM,LMOUSR,INDBZL,
		     INDARC,UPDCHK
		    ) 
		 VALUES
		    (
		     #{WAREKY},
		     <if test="ALSTKY != 'STD'">
		     (SELECT LPAD(NVL(MAX(SEQCUS),0)+1,10,'0') FROM ALCUS WHERE WAREKY = #{WAREKY} AND ALSTKY != 'STD'),
		     </if>
		     <if test="ALSTKY == 'STD'">
		     (SELECT RPAD(NVL(MAX(0),0)+1,10,'0') FROM DUAL),
		     </if>
		     #{OWNRKY},
		     NVL(#{CUSTMR},' '),
		     NVL(#{ALSTKY},' '),
		     NVL(#{REGN01},' '),
		     NVL(#{CHANEL},' '),
		     NVL(#{NATNKY},' '),
		     NVL(#{DOCUTY},' '),
		     NVL(#{SLGORT},' '),
		     NVL(#{LASTOB},' '),
		     TO_CHAR(SYSDATE, 'YYYYMMDD'),
		     TO_CHAR(SYSDATE, 'HH24MISS'),
			 #{SES_USER_ID},
			 TO_CHAR(SYSDATE, 'YYYYMMDD'),
			 TO_CHAR(SYSDATE, 'HH24MISS'),
			 #{SES_USER_ID},
			 NVL(#{INDBZL},' '),
		     NVL(#{INDARC},' '),
		     TO_NUMBER(NVL(TRIM(#{UPDCHK}), 0))
		    )
	</insert>
	
	<!-- 전략규칙> 전략연결  신규 -->
	<update id="ALCUS_UPDATE" parameterType="Map">
			UPDATE ALCUS SET 
		<if test="WAREKY != null and WAREKY != ''"> 
			 WAREKY = #{WAREKY} ,
		</if> 
		<if test="OWNRKY != null and OWNRKY != ''"> 
			 OWNRKY = #{OWNRKY} ,
		</if> 
		<if test="SEQCUS != null and SEQCUS != ''"> 
			 SEQCUS = #{SEQCUS} ,
		</if> 
		<if test="CUSTMR != null and CUSTMR != ''"> 
			 CUSTMR = #{CUSTMR} ,
		</if> 
		<if test="ALSTKY != null and ALSTKY != ''"> 
			 ALSTKY = #{ALSTKY} ,
		</if> 
		<if test="REGN01 != null and REGN01 != ''"> 
			 REGN01 = #{REGN01} ,
		</if> 
		<if test="NATNKY != null and NATNKY != ''"> 
			 NATNKY = #{NATNKY} ,
		</if> 
		<if test="DOCUTY != null and DOCUTY != ''"> 
			 DOCUTY = #{DOCUTY} ,
		</if> 
		<if test="SLGORT != null and SLGORT != ''"> 
			 SLGORT = #{SLGORT} ,
		</if> 
		<if test="CHANEL != null and CHANEL != ''"> 
			 CHANEL = #{CHANEL} ,
		</if> 
		<if test="LASTOB != null and LASTOB != ''"> 
			 LASTOB = #{LASTOB} ,
		</if> 
		LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
	         LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
	         LMOUSR = #{SES_USER_ID}
		 WHERE 1 = 1
		 AND WAREKY = #{WAREKY} 
		 AND SEQCUS = #{SEQCUS} 
	</update>

	<!-- 전략규칙> 전략연결  삭제 -->
	<delete id="ALCUS_DELETE" parameterType="Map">
		 DELETE FROM ALCUS
 		 WHERE 1 = 1
		 AND WAREKY = #{WAREKY} 
		 AND SEQCUS = #{SEQCUS} 
	</delete>

	<!-- 전략규칙> 전략연결  설명 -->
	<select id="SHORTX_MAP" parameterType="Map" resultType="DataMap">
	 	SELECT SHORTX 
		  FROM ALSTH 
		 WHERE 1 = 1
			AND WAREKY = #{WAREKY}
		   AND ALSTKY = #{ALSTKY}
	</select>

	<!-- 전략규칙> 전략연결  거래처명22 -->
	<select id="NAME012_MAP" parameterType="Map" resultType="DataMap">
	 	   SELECT B.NAME01 
	 	     FROM BZPTN B
			WHERE 1 = 1
			  AND B.PTNRKY = #{CUSTMR}
			  AND ROWNUM = 1
	</select>
	
	<!-- 전략규칙> 전략연결  국가명 -->
	<select id="NATNKY_MAP" parameterType="Map" resultType="DataMap">
	 	SELECT DESC01 
		  FROM VNATNKY 
		 WHERE 1 = 1 
		   AND NATNKY = #{NATNKY}
	</select>
		<!-- 전략규칙> 전략연결 유무 확인 -->
	<select id="ALSTKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		  FROM ALSTH 
		WHERE 1 = 1
		AND WAREKY = #{WAREKY}
		AND	ALSTKY = #{ALSTKY}
	</select>
	
	<select id="ALSTKYY_MAP" parameterType="Map" resultType="DataMap">
		SELECT SHORTX AS SHORTX
		  FROM ALSTH 
		 WHERE 1 = 1 
		   AND WAREKY = #{WAREKY}
           AND ALSTKY = #{ALSTKY}
           AND ROWNUM = 1
	</select>
		<!-- 전략규칙> 전략연결 유무 확인 -->
	<select id="PTNRKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		  FROM BZPTN 
		 WHERE 1 = 1 
           AND PTNRKY = #{CUSTMR}
	</select>
	<!-- 전략규칙> 전략연결 유무 확인 -->
	<select id="DOCUTYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		  FROM DOCTM
		 WHERE 1 = 1 
           AND DOCCAT = '200'
           AND DOCUTY = #{DOCUTY}
	</select>

		<!-- 전략규칙> 전략연결 유무 확인 -->
	<select id="NATNKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		  FROM VNATNKY 
		 WHERE 1 = 1 
           AND NATNKY = #{NATNKY}
	</select>
	
	<!-- 전략규칙> Sorting Rule 조회 상단 -->
	
	<!-- RC01 사유코드 시작 -->
    <select id="RC01_LIST" parameterType="Map" resultType="DataMap">
       SELECT  A.OWNRKY AS OWNRKY
          , A.DOCCAT AS DOCCAT
          , A.DOCUTY AS DOCUTY
          , A.RSNCOD AS RSNCOD
          , A.SHORTX AS DOCCATNM
          , B.SHORTX AS DOCTYPNM
          , C.SHORTX AS SHORTX
          , A.DIFLOC AS DIFLOC
          , A.CREDAT AS CREDAT
		  , A.CRETIM AS CRETIM
		  , A.CREUSR AS CREUSR
          , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = A.CREUSR),' ') AS CUSRNM
          , A.LMODAT AS LMODAT
	      , A.LMOTIM AS LMOTIM
	      , A.LMOUSR AS LMOUSR
		  , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = A.LMOUSR),' ') AS LUSRNM
      FROM RSNCD A, DOCTM B, DOCCM C
      WHERE A.DOCUTY = B.DOCUTY
      AND   A.DOCCAT = C.DOCCAT 
      AND   A.OWNRKY = #{SES_OWNER}
      <if test="DOCCAT != null and DOCCAT != ''">
         AND   A.DOCCAT = #{DOCCAT}
      </if>
      <if test="DOCUTY != null and DOCUTY != ''">
         AND   A.DOCUTY = #{DOCUTY}
      </if>
      ORDER BY A.DOCCAT, A.DOCUTY, A.RSNCOD
    </select>
   
	<select id="RC01RSNCODval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM RSNCD
		WHERE DOCCAT  = #{DOCCAT}
		AND OWNRKY = #{OWNRKY}
		AND DOCUTY = #{DOCUTY}
		AND RSNCOD = #{RSNCOD}
		AND ROWNUM = 1
	</select>
	
	<select id="RC01DOCCATNM_MAP" parameterType="Map" resultType="DataMap">
	  	SELECT SHORTX AS SHORTX
	  	  FROM DOCCM 
	  	  WHERE 1 = 1 
	  	    AND DOCCAT = #{DOCCAT} 
	</select>
	
	<select id="RC01DOCCATval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		FROM RSNCD 
		WHERE 1 = 1 
		AND DOCCAT = #{DOCCAT}
	</select>
	
	<select id="RC01DOCTYPNM_MAP" parameterType="Map" resultType="DataMap">
	  	SELECT SHORTX AS DOCTYPNM
	  	  FROM DOCTM 
	  	  WHERE 1 = 1 
	  	    AND DOCUTY = #{DOCUTY}
	  	    AND DOCCAT = #{DOCCAT}
	</select>
	
	<select id="RC01DOCUTYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT
		FROM DOCTM 
		WHERE 1 = 1 
		AND DOCUTY = #{DOCUTY}
		AND DOCCAT = #{DOCCAT}
	</select>
	
	<select id="RC01_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT
	    CASE
	    	WHEN B.OWNRKY IS NULL
	            THEN 'MASTER_M0023' || ' ' || A.OWNRKY
	        WHEN B.DOCCAT IS NULL
	            THEN 'MASTER_M0677' || ' ' || A.DOCCAT
	        WHEN B.DOCUTY IS NULL
	            THEN 'MASTER_M0415' || ' ' || A.DOCUTY
	        WHEN B.RSNCOD IS NULL
	            THEN 'IN_M0021' || ' ' || A.RSNCOD
	        ELSE 'OK'
	    END AS MSG
	    FROM(
	        ${VALIDATION_SQL}
	    ) A
	    LEFT OUTER JOIN RSNCD B ON B.DOCCAT = A.DOCCAT AND B.DOCUTY = A.DOCUTY
	    WHERE B.RSNCOD IS NULL
	</select>
	
	<update id="RC01_UPDATE" parameterType="Map">
       UPDATE RSNCD SET 
		<if test="DOCCATNM != null and DOCCATNM != ''">			
              SHORTX = #{DOCCATNM},
              DIFLOC = #{DIFLOC},
		</if> 
              LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
              LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
              LMOUSR = #{SES_USER_ID}
        WHERE DOCCAT = #{DOCCAT} 
          AND DOCUTY = #{DOCUTY} 
          AND OWNRKY = #{OWNRKY} <!-- 2020.04.10 LHJ수정 후 update오류 수정 -->
          AND RSNCOD = #{RSNCOD}
	</update> 
	
	<insert id="RC01_INSERT" parameterType="Map">
	INSERT INTO RSNCD ( 
		SHORTX, 
		INDBZL, 
		INDARC, 
		OWNRKY, 
		DOCCAT, 
		DOCUTY, 
		RSNCOD,
		DIFLOC,
		CREDAT, 
		CRETIM, 
		CREUSR, 
		LMODAT, 
		LMOTIM, 
		LMOUSR 
		) VALUES (
		#{DOCCATNM}, 
		NVL(#{INDBZL},' '),
		NVL(#{INDARC},' '), 
		#{OWNRKY}, 
		#{DOCCAT}, 
		#{DOCUTY}, 
		#{RSNCOD},
		NVL(#{DIFLOC},' '), 
		TO_CHAR(SYSDATE, 'YYYYMMDD'),
		TO_CHAR(SYSDATE, 'HH24MISS'),
		#{SES_USER_ID},
		TO_CHAR(SYSDATE, 'YYYYMMDD'),
		TO_CHAR(SYSDATE, 'HH24MISS'),
		#{SES_USER_ID}
		)
	</insert>
	
	<delete id="RC01_DELETE" parameterType="Map">   <!-- 2020.04.01 -->
		DELETE FROM RSNCD
		WHERE DOCCAT = #{DOCCAT}
		AND DOCUTY = #{DOCUTY}
		AND OWNRKY = #{OWNRKY}
		AND RSNCOD = #{RSNCOD}
	</delete>
	<!-- RC01 사유코드 끝 -->
	
	<!-- DC01 문서유형 시작 -->
	<select id="DC01_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.DOCCAT AS DOCCAT,
		       A.SHORTX AS SHORTX,
		       A.DOCUFM AS DOCUFM,
		       A.DEFLIN AS DEFLIN,
		       A.CREDAT AS CREDAT,
		       A.CRETIM AS CRETIM,
		       NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = A.CREUSR),' ') AS CUSRNM,
		       A.CREUSR AS CREUSR,
		       A.LMODAT AS LMODAT,
		       A.LMOTIM AS LMOTIM,
		       A.LMOUSR AS LMOUSR,
		       NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = A.LMOUSR),' ') AS LUSRNM
		  FROM DOCCM A
		 ORDER BY DOCCAT ASC
	</select>
	
	<insert id="DC01_INSERT" parameterType="Map">
		INSERT
		INTO   DOCCM (
		SHORTX, 
		DOCUFM, 
		DEFLIN, 
		CREDAT, 
		CRETIM, 
		CREUSR, 
		LMODAT, 
		LMOTIM, 
		LMOUSR, 
		DOCCAT 
		) VALUES (
		#{SHORTX},
		NVL(#{DOCUFM},'10'), 
		NVL(#{DEFLIN},'50'), 
		TO_CHAR(SYSDATE, 'YYYYMMDD'),
		TO_CHAR(SYSDATE, 'HH24MISS'),
		#{SES_USER_ID},
		TO_CHAR(SYSDATE, 'YYYYMMDD'),
		TO_CHAR(SYSDATE, 'HH24MISS'),
		#{SES_USER_ID},
		#{DOCCAT})
	</insert>
	
	<delete id="DC01_DELETE" parameterType="Map">
		DELETE FROM DOCCM WHERE DOCCAT=#{DOCCAT}
	</delete>
	
	<update id="DC01_UPDATE" parameterType="Map">
		UPDATE DOCCM SET 
		<if test="DOCCAT != null and DOCCAT != ''"> 
			 DOCCAT = #{DOCCAT} ,
		</if> 
		<if test="SHORTX != null and SHORTX != ''"> 
			 SHORTX = #{SHORTX}
		</if> 
		 WHERE 
			 DOCCAT = #{DOCCAT} 
	</update>
	
	<select id="RSNCD_DUPL_VALIDATION_MAP" parameterType="Map" resultType="DataMap">
		<!-- SELECT
		    CASE
		        WHEN B.DOCCAT IS NULL
		            THEN 'MASTER_M0414' || ' ' || A.DOCCAT
		        ELSE 'OK'
		    END AS MSG
	    FROM(
	        ${VALIDATION_SQL}
	    ) A
	    LEFT OUTER JOIN DOCCM B ON A.DOCCAT = B.DOCCAT
	    WHERE B.DOCCAT IS NULL -->
	    SELECT CASE WHEN STATUS_SUM &gt; 1
		                 THEN '사유코드 [' || OWNRKY || DOCCAT || '-' || DOCUTY || '-' || RSNCOD || ']이/가 중복 되었습니다.'
		            ELSE ' '
		       END AS VALIDATION_MSG
		  FROM (
		         SELECT OWNRKY, DOCCAT, DOCUTY, RSNCOD, SUM(STATUS) AS STATUS_SUM
		           FROM (
		                  SELECT 1 AS STATUS, OWNRKY, DOCCAT, DOCUTY, RSNCOD FROM RSNCD UNION ALL
		                  ${VALIDATION_DUPL_SQL}
		                )  A
		          GROUP BY OWNRKY, DOCCAT, DOCUTY, RSNCOD
		         HAVING SUM(STATUS) &gt; 1
		          <!-- ORDER BY DOCCAT, DOCUTY, RSNCOD  -->
		       ) VALID
		 WHERE 1=1
	</select>
	<!-- DC01 문서유형 끝 -->
	
	<!-- CC01 공통코드 위에 그리드 시작-->
	<select id="CC01_LIST" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT
		    CM.CMCDKY AS "CMCDKY"
		  , CM.SHORTX AS "SHORTX"
		  , CM.DBFILD AS "DBFILD"
		  , CM.USARL1 AS "USARL1"
		  , CM.USARL2 AS "USARL2"
		  , CM.USARL3 AS "USARL3"
		  , CM.USARL4 AS "USARL4"
		  , CM.USARL5 AS "USARL5"
		  , CM.SYONLY AS "SYONLY"
		  , CM.CREDAT AS "CREDAT"
		  , CM.CRETIM AS "CRETIM"
		  , CM.CREUSR AS "CREUSR"
		  , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = CM.CREUSR),' ') AS "CUSRNM"
		  , CM.LMODAT AS "LMODAT"
		  , CM.LMOTIM AS "LMOTIM"
		  , CM.LMOUSR AS "LMOUSR"
		  , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = CM.LMOUSR),' ') AS "LUSRNM"
		  , CM.CMCDKY AS "KEY"
		  , ' ' AS STATUS
		FROM CMCDM CM
		INNER JOIN CMCDV CV
		ON CM.CMCDKY = CV.CMCDKY
		WHERE 1 = 1		
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		 ORDER BY CM.CMCDKY ASC
	</select>
	
	<select id="CC01CMCDKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM CMCDM
		WHERE CMCDKY = #{CMCDKY}
	</select>
	
	<select id="BZ02PTNRKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM BZPTN
		WHERE PTNRKY = #{PTNRKY}
	</select>
	
	<!-- CC01 공통코드 아래 그리드 시작-->
	<select id="CC01Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT  CV.CMCDKY AS "CMCDKY"
			  , CV.CMCDVL AS "CMCDVL"
			  , CV.CDESC1 AS "CDESC1"
			  , CV.CDESC2 AS "CDESC2"
			  , CV.USARG1 AS "USARG1"
			  , CV.USARG2 AS "USARG2"
			  , CV.USARG3 AS "USARG3"
			  , CV.USARG4 AS "USARG4"
			  , CV.USARG5 AS "USARG5"
			  , CV.CREDAT AS "CREDAT"
		      , CV.CRETIM AS "CRETIM"
		      , CV.CREUSR AS "CREUSR"
		      , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = CV.CREUSR),' ') AS "CUSRNM"
		      , CV.LMODAT AS "LMODAT"
	          , CV.LMOTIM AS "LMOTIM"
		      , CV.LMOUSR AS "LMOUSR"
		      , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = CV.LMOUSR),' ') AS "LUSRNM"
			  , CV.CMCDKY AS "KEY"
			  , ' ' AS STATUS
		 FROM   CMCDV CV
		WHERE   1 = 1	
		  AND   CV.CMCDKY = #{CMCDKY}	
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	</select>
	
	<select id="CMCDVDESC_MAP" parameterType="Map" resultType="DataMap">
		SELECT CDESC1
		FROM CMCDV
		WHERE CMCDKY = 'PTNL01'
		  AND CMCDVL = #{CMCDVL}
	</select>
	
	<select id="CC01CMCDVLval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM CMCDV
		WHERE CMCDKY = #{CMCDKY}
		AND CMCDVL = #{CMCDVL}
	</select>

	<insert id="CC01_INSERT" parameterType="Map">
		INSERT INTO CMCDM
		(
			CMCDKY,
			SHORTX,
			DBFILD,
			USARL1,
			USARL2,
			USARL3,
			USARL4,
			USARL5,
			SYONLY,
			CREDAT,
			CRETIM,
			CREUSR,
			LMODAT,
			LMOTIM,
			LMOUSR
		)VALUES(
			#{CMCDKY},
			NVL(#{SHORTX},' '),
			NVL(#{DBFILD},' '),
			NVL(#{USARL1},' '),
			NVL(#{USARL2},' '),
			NVL(#{USARL3},' '),
			NVL(#{USARL4},' '),
			NVL(#{USARL5},' '),
			NVL(#{SYONLY},' '),
			TO_CHAR(SYSDATE, 'YYYYMMDD'),
			TO_CHAR(SYSDATE, 'HH24MISS'),
			#{SES_USER_ID},
			TO_CHAR(SYSDATE, 'YYYYMMDD'),
			TO_CHAR(SYSDATE, 'HH24MISS'),
			#{SES_USER_ID}
		)
	</insert>
	
	<insert id="CC01Sub_INSERT" parameterType="Map">
		INSERT INTO CMCDV
			(
			   CMCDKY,
			   CMCDVL,
			   CDESC1,
			   CDESC2,
			   USARG1,
			   USARG2,
			   USARG3,
			   USARG4,
			   USARG5,
			   CREDAT,
			   CRETIM,
			   CREUSR,
			   LMODAT,
			   LMOTIM,
			   LMOUSR
			)VALUES(
			   #{CMCDKY},
			   #{CMCDVL},
			   NVL(#{CDESC1},' '),
			   NVL(#{CDESC2},' '),
			   NVL(#{USARG1},' '),
			   NVL(#{USARG2},' '),
			   NVL(#{USARG3},' '),
			   NVL(#{USARG4},' '),
			   NVL(#{USARG5},' '),
			   TO_CHAR(SYSDATE, 'YYYYMMDD'),
			   TO_CHAR(SYSDATE, 'HH24MISS'),
			   #{SES_USER_ID},
			   TO_CHAR(SYSDATE, 'YYYYMMDD'),
			   TO_CHAR(SYSDATE, 'HH24MISS'),
			   #{SES_USER_ID}
			)
	</insert>
	
	<update id="CC01_UPDATE" parameterType="Map">
		UPDATE	CMCDM
		SET		
		<if test="SHORTX != null and SHORTX != ''">
				SHORTX = #{SHORTX},
		</if>
		<if test="DBFILD != null and DBFILD != ''">
				DBFILD = #{DBFILD},
		</if>
		<if test="USARL1 != null and USARL1 != ''">
				USARL1 = #{USARL1},
		</if>
		<if test="USARL2 != null and USARL2 != ''">
				USARL2 = #{USARL2},
		</if>
		<if test="USARL3 != null and USARL3 != ''">
				USARL3 = #{USARL3},
		</if>
		<if test="USARL4 != null and USARL4 != ''">
				USARL4 = #{USARL4},
		</if>
		<if test="USARL5 != null and USARL5 != ''">
				USARL5 = #{USARL5},
		</if>
		<if test="SYONLY != null and SYONLY != ''">
				SYONLY = #{SYONLY},
		</if>
				LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
				LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
				LMOUSR = #{SES_USER_ID}
		WHERE	CMCDKY = #{CMCDKY}
	</update>
	
	<update id="CC01Sub_UPDATE" parameterType="Map">
		UPDATE	CMCDV
		SET		
		<if test="CDESC1 != null and CDESC1 != ''">
				CDESC1 = #{CDESC1},
		</if>
		<if test="CDESC2 != null and CDESC2 != ''">
				CDESC2 = #{CDESC2},
		</if>
		<if test="USARG1 != null and USARG1 != ''">
				USARG1 = #{USARG1},
		</if>
		<if test="USARG2 != null and USARG2 != ''">
				USARG2 = #{USARG2},
		</if>
		<if test="USARG3 != null and USARG3 != ''">
				USARG3 = #{USARG3},
		</if>
		<if test="USARG4 != null and USARG4 != ''">
				USARG4 = #{USARG4},
		</if>
		<if test="USARG5 != null and USARG5 != ''">
				USARG5 = #{USARG5},
		</if>
				LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
				LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
				LMOUSR = #{SES_USER_ID}
		WHERE	CMCDKY = #{CMCDKY}
		AND		CMCDVL = #{CMCDVL}
	</update>
	
	
	<delete id="CC01_DELETE" parameterType="Map">
		DELETE	
		FROM	CMCDM
		WHERE	CMCDKY = #{CMCDKY}
	</delete>
	
	<delete id="CC01Sub_DELETE" parameterType="Map">
		DELETE	
		FROM	CMCDV
		WHERE	CMCDKY = #{CMCDKY}
	<if test="CMCDVL != null and CMCDVL != ''"> <!-- 2020.04.13 LHJ -->
		AND		CMCDVL = #{CMCDVL}
	</if>
	</delete>
	
	<select id="CC01_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT CASE
         	WHEN A.CMCDKY IS NULL THEN 'MASTER_M0097' || ' ' ||  STD.CMCDKY
         	ELSE 'OK'
		END AS MSG
		FROM (  
			 ${VALIDATION_SQL} 
		) STD 
		LEFT OUTER JOIN CMCDM A
		     ON A.CMCDKY = STD.CMCDKY
		WHERE A.CMCDKY IS NULL
	</select>
	
	<select id="CC01Sub_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT CASE
         	WHEN A.CMCDVL IS NULL THEN 'MASTER_M0097' || ' ' ||  STD.CMCDVL
         	ELSE 'OK'
		END AS MSG
		FROM (  
			 ${VALIDATION_SQL} 
		) STD 
		LEFT OUTER JOIN CMCDV A
		     ON A.CMCDKY = STD.CMCDKY AND A.CMCDVL = STD.CMCDVL
		WHERE A.CMCDVL IS NULL
	</select>
	<!-- ADMIN CC01 끝-->

	<!-- TA01 -->
	<select id="TA01_LIST" parameterType="Map" resultType="DataMap">
		SELECT
			WAREKY,
			ALSTKY,
			SHORTX,
			CREDAT,
			CRETIM,
			CREUSR,
			NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = ALSTH.CREUSR),' ') AS CUSRNM,
			LMODAT,
			LMOTIM,
			LMOUSR,
			NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = ALSTH.LMOUSR),' ') AS LUSRNM,
			WAREKY || ALSTKY AS KEY,
			' ' AS STATUS
		FROM ALSTH
		WHERE 1=1
		<if test="WAREKY != null and WAREKY != ''">
			AND WAREKY = #{WAREKY}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	</select>
	
	<update id="TA01_UPDATE" parameterType="Map">
			UPDATE ALSTH SET 
	 		SHORTX = #{SHORTX},
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
			LMOUSR = #{SES_USER_ID}
			WHERE 1 = 1
			 AND WAREKY = #{WAREKY} 
			 AND ALSTKY = #{ALSTKY} 
	</update>
	
	<insert id="TA01_INSERT" parameterType="Map">
		INSERT INTO ALSTH
			(
			   WAREKY,
			   ALSTKY,
			   SHORTX,
			   CREDAT,
			   CRETIM,
			   CREUSR,
			   LMODAT,
			   LMOTIM,
			   LMOUSR
			)VALUES(
			   #{WAREKY},
			   #{ALSTKY},
			   NVL(#{SHORTX},' '),
			   TO_CHAR(SYSDATE, 'YYYYMMDD'),
			   TO_CHAR(SYSDATE, 'HH24MISS'),
			   #{SES_USER_ID},
			   TO_CHAR(SYSDATE, 'YYYYMMDD'),
			   TO_CHAR(SYSDATE, 'HH24MISS'),
			   #{SES_USER_ID}
			)
	</insert>
	
	<delete id="TA01_DELETE" parameterType="Map">
		DELETE FROM ALSTH 
		WHERE WAREKY = #{WAREKY}
			AND ALSTKY = #{ALSTKY}
	</delete>
	
	<select id="TA01ALFTKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM RLRRH
		WHERE WAREKY = #{WAREKY}
		AND LOTRKY = #{LOTRKY}
	</select>	
	
	<select id="TA01_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT CASE
         	WHEN A.ALSTKY IS NULL THEN 'MASTER_M0097' || ' ' ||  STD.ALSTKY
         	ELSE 'OK'
		END AS MSG
		FROM (  
			 ${VALIDATION_SQL} 
		) STD 
		LEFT OUTER JOIN ALSTH A
		     ON A.ALSTKY = STD.ALSTKY AND A.WAREKY = STD.WAREKY
		WHERE A.ALSTKY IS NULL
	</select>
	
	<select id="TA01Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT
			WAREKY,
			ALSTKY,
			STEPNO,
			SSORKY,
			ALFTKY,
			ALORTO,
			ALUNIT,
			SUALKY,
			CREDAT,
			CRETIM,
			CREUSR,
			NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = ALSTI.CREUSR),' ') AS CREUNM,
			LMODAT,
			LMOTIM,
			LMOUSR,
			NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = ALSTI.LMOUSR),' ') AS LUSRNM,
			WAREKY || ALSTKY AS KEY,
			' ' AS STATUS
		FROM ALSTI
		WHERE 1 = 1
			AND WAREKY = #{WAREKY}
			AND ALSTKY = #{ALSTKY}
	</select>
	
	<update id="TA01Sub_UPDATE" parameterType="Map">
			UPDATE ALSTI SET 
	 		STEPNO = #{STEPNO},
	 		SSORKY = #{SSORKY},
	 		ALFTKY = #{ALFTKY},
	 		ALORTO = #{ALORTO},
	 		ALUNIT = #{ALUNIT},
	 		SUALKY = #{SUALKY},
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
			LMOUSR = #{SES_USER_ID}
			WHERE 1 = 1
			 AND WAREKY = #{WAREKY} 
			 AND ALSTKY = #{ALSTKY} 
			 AND STEPNO = #{STEPNO}
	</update>
	
	<insert id="TA01Sub_INSERT" parameterType="Map">
		INSERT INTO ALSTI
			(
			   WAREKY,
			   ALSTKY,
			   STEPNO,
			   SSORKY,
			   ALFTKY,
			   ALORTO,
			   ALUNIT,
			   SUALKY,
			   CREDAT,
			   CRETIM,
			   CREUSR,
			   LMODAT,
			   LMOTIM,
			   LMOUSR
			)VALUES(
			   #{WAREKY},
			   #{ALSTKY},
			   #{STEPNO},
			   #{SSORKY},
			   #{ALFTKY},
			   NVL(#{ALORTO},'100'),
			   NVL(#{ALUNIT},'1'),
			   NVL(#{SUALKY},' '),
			   TO_CHAR(SYSDATE, 'YYYYMMDD'),
			   TO_CHAR(SYSDATE, 'HH24MISS'),
			   #{SES_USER_ID},
			   TO_CHAR(SYSDATE, 'YYYYMMDD'),
			   TO_CHAR(SYSDATE, 'HH24MISS'),
			   #{SES_USER_ID}
			)
	</insert>
	
	<delete id="TA01Sub_DELETE" parameterType="Map">
		DELETE FROM ALSTI 
		WHERE WAREKY = #{WAREKY} 
			AND ALSTKY = #{ALSTKY}
		<if test="STEPNO != null and STEPNO != ''">
			AND STEPNO = #{STEPNO}
		</if>
	</delete>
	
	<select id="TA01Sub_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT CASE
         	WHEN A.ALSTKY IS NULL THEN 'MASTER_M0097' || ' ' ||  STD.ALSTKY
         	WHEN A.STEPNO IS NULL THEN 'OUT_M0020' || ' ' ||  STD.STEPNO
         	ELSE 'OK'
		END AS MSG
		FROM (  
			 ${VALIDATION_SQL} 
		) STD 
		LEFT OUTER JOIN ALSTI A
		     ON A.ALSTKY = STD.ALSTKY AND A.STEPNO = STD.STEPNO
		WHERE A.ALSTKY IS NULL
	</select>
	
	<!-- TA01 끝 -->

 	<select id="TP01PASTHval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM PASTH
		WHERE WAREKY  = #{WAREKY}
		AND PASTKY = #{PASTKY}
	</select>
	
	<select id="LOCAval_MAP" parameterType="Map" resultType="DataMap">
		SELECT	COUNT(*) CNT 
		  FROM	LOCMA
		 WHERE	LOCAKY = #{LOCASR}
		   AND	ROWNUM = 1
	</select>
	
	<select id="LOCATGval_MAP" parameterType="Map" resultType="DataMap">
		SELECT	COUNT(*) CNT 
		  FROM  LOCMA
		 WHERE	LOCAKY = #{LOCATG}
		   AND	ROWNUM = 1
	</select>
	
	<select id="ZONETGval_MAP" parameterType="Map" resultType="DataMap">
		SELECT	COUNT(*) CNT 
		  FROM	ZONMA
		 WHERE	ZONEKY = #{ZONETG}
		   AND	ROWNUM = 1
	</select>
	<!-- TP01 Grid -->
	<!-- <select id="TP01_LIST" parameterClass="Map" resultClass="DataMap">
		SELECT
			 WAREKY
			,PASTKY
			,SHORTX
			,CREDAT
			,CRETIM
			,CREUSR
			,NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = PASTH.CREUSR),' ') AS CUSRNM
			,LMODAT
			,LMOTIM
			,LMOUSR
			,NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = PASTH.LMOUSR),' ') AS LUSRNM
			,WAREKY|| PASTKY AS KEY
			,' ' AS STATUS
		FROM PASTH
			WHERE 1=1
		<isNotEmpty property="WAREKY">
			AND WAREKY = #{WAREKY}
		</isNotEmpty>
		<isNotEmpty property="RANGE_SQL">
			${RANGE_SQL}
		</isNotEmpty>
	</select> -->
	
	<select id="TP01_LIST" parameterType="Map" resultType="DataMap">
		SELECT   DISTINCT
		         H.WAREKY
		       , H.PASTKY
		       , H.SHORTX
		       , H.CREDAT
		       , H.CRETIM
		       , H.CREUSR
		       , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = H.CREUSR),' ') AS CUSRNM
		       , H.LMODAT
		       , H.LMOTIM
		       , H.LMOUSR
		       , NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = H.LMOUSR),' ') AS LUSRNM
		       , H.WAREKY || H.PASTKY AS KEY
		       , ' ' AS STATUS
		  FROM  PASTH H
	  		<if test="ZONE == &quot;V&quot;">
		       ,(SELECT * FROM PASTI WHERE LOCASR = #{AREAKY} AND RMTGLS = '02' AND ZONETG = ' ') Z
	        </if>
	        <if test="LOC == &quot;V&quot;">
		       ,(SELECT * FROM PASTI WHERE LOCASR = #{AREAKY} AND RMTGLS = '01' AND LOCATG = ' ') L
	        </if>
		 WHERE  1 = 1
		   AND  H.WAREKY = #{WAREKY}
		   <if test="ZONE == &quot;V&quot;">
		   AND  H.WAREKY = Z.WAREKY
		   AND  H.PASTKY = Z.PASTKY
		   </if>
		   <if test="LOC == &quot;V&quot;">
		   AND  H.WAREKY = L.WAREKY
		   AND  H.PASTKY = L.PASTKY
		   </if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		   </if>
	</select>
	
	<select id="TF01_LIST" parameterType="Map" resultType="DataMap">
		SELECT RLRRH.*
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RLRRH.CREUSR), ' ') AS CUSRNM
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RLRRH.LMOUSR), ' ') AS LUSRNM
		  FROM RLRRH
		 WHERE 1=1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
	</select>
	
	<insert id="TP01_INSERT" parameterType="Map">
		INSERT
		INTO PASTH
		(
		WAREKY,
		PASTKY,
		SHORTX,
		CREDAT,
		CRETIM,
		CREUSR,
		LMODAT,
		LMOTIM,
		LMOUSR
		)
		VALUES(
		#{WAREKY},
		#{PASTKY},
		NVL(#{SHORTX},' '),
		TO_CHAR(SYSDATE,'YYYYMMDD'),
		TO_CHAR(SYSDATE, 'HH24MISS'),
		#{SES_USER_ID},
		TO_CHAR(SYSDATE, 'YYYYMMDD'),
		TO_CHAR(SYSDATE, 'HH24MISS'),
		#{SES_USER_ID}
		)
	</insert>
	
	<insert id="TS01_INSERT" parameterType="Map">
		INSERT
		INTO STSRH
		(
			WAREKY, SSORKY, SHORTX, STLCAT,
			CREDAT,	CRETIM,	CREUSR,
			LMODAT,	LMOTIM,	LMOUSR,
			INDBZL, INDARC, UPDCHK
		)
		VALUES(
		  #{WAREKY} , #{SSORKY}, NVL(#{SHORTX}, ' '), NVL(#{STLCAT}, ' ')
		  , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , ' ', ' ', 0
		)
	</insert>

	<delete id="TP01_DELETE" parameterType="Map">
		DELETE 
		FROM PASTH 
		WHERE PASTKY=#{PASTKY}
		AND WAREKY=#{WAREKY}
	</delete>
	
	<delete id="TS01_DELETE" parameterType="Map">
		DELETE 
		FROM STSRH 
		WHERE SSORKY=#{SSORKY}
		AND WAREKY=#{WAREKY}
	</delete>
	
	<!-- TP01 하단그리드 -->
	<select id="TP01Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT 	WAREKY,
				PASTKY,
				STEPNO,
				SRMEKY,
				USDOCT,
				LOCASR,
				RMTGLS,
				LOCATG,
				AREATG,
				ZONETG,
				CAPACR,
				CREDAT,
				CRETIM,
				CREUSR,
				NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = PASTI.CREUSR),' ') AS CUSRNM,
				LMODAT,
				LMOTIM,
				LMOUSR,
				NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = PASTI.LMOUSR),' ') AS LUSRNM,
				WAREKY || PASTKY,
				' ' AS STATUS
		 FROM 	PASTI
		WHERE 	WAREKY = #{WAREKY}
		  AND 	PASTKY = #{PASTKY}
	</select>
	
	<insert id="TS01Sub_INSERT" parameterType="Map">
		INSERT INTO STSRI
	    (
	        WAREKY, SSORKY, ITEMNO, FIELDN, FLDCMT
	      , TABLEN, ACTVAT, SORTSQ, INDASD
	      , CREDAT, CRETIM, CREUSR
	      , LMODAT, LMOTIM, LMOUSR
	      , INDBZL, INDARC, UPDCHK
	    )
	    VALUES(
	         #{WAREKY}, #{SSORKY}, NVL(#{ITEMNO}, ' '), NVL(#{FIELDN}, ' '), NVL(#{FLDCMT}, ' ')
	        ,NVL(#{TABLEN}, ' '), NVL(#{ACTVAT}, ' '), NVL(#{SORTSQ}, ' '), NVL(#{INDASD}, ' ')
	        , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  	, TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  	, ' ', ' ', 0
	    )
	</insert>
	
	<insert id="TP01Sub_INSERT" parameterType="Map">
		INSERT INTO PASTI
		(
		WAREKY,
		PASTKY,
		STEPNO,
		SRMEKY,
		USDOCT,
		LOCASR,
		AREATG,
		RMTGLS,
		LOCATG,
		ZONETG,
		CAPACR,
		CREDAT,
		CRETIM,
		CREUSR,
		LMODAT,
		LMOTIM,
		LMOUSR
		)
		VALUES(
		#{WAREKY},
		#{PASTKY},
		#{STEPNO},
		NVL(#{SRMEKY}, ' '),
		NVL(#{USDOCT}, ' '),
		NVL(#{LOCASR}, ' '),
		NVL(#{AREATG}, ' '),
		NVL(#{RMTGLS}, ' '),
		NVL(#{LOCATG}, ' '),
		NVL(#{ZONETG}, ' '),
		NVL(#{CAPACR}, ' '),
		TO_CHAR(SYSDATE, 'YYYYMMDD'),
		TO_CHAR(SYSDATE,'HH24MISS'),
		#{SES_USER_ID},
		TO_CHAR(SYSDATE,'YYYYMMDD'),
		TO_CHAR(SYSDATE,'HH24MISS'),
		#{SES_USER_ID}
		)
	</insert>

	<delete id="TP01Sub_DELETE" parameterType="Map">
		DELETE 
		  FROM	PASTI
		 WHERE	WAREKY = #{WAREKY}
		   AND	PASTKY = #{PASTKY}
		<if test="STEPNO != null and STEPNO != ''">
		   AND	STEPNO = #{STEPNO}
		</if>
	</delete>
	
	<delete id="TS01Sub_DELETE" parameterType="Map">
		DELETE 
		  FROM	STSRI
		 WHERE	WAREKY = #{WAREKY}
		   AND	SSORKY = #{SSORKY}
		<if test="ITEMNO != null and ITEMNO != ''">
		   AND	ITEMNO = #{ITEMNO}
		</if>
	</delete>
	
	<select id="TP01STEPNOval_MAP" parameterType="Map" resultType="DataMap">
		SELECT	COUNT(*) CNT 
		  FROM	PASTI
		 WHERE 	WAREKY = #{WAREKY}
		   AND 	PASTKY = #{PASTKY}
		   AND 	STEPNO = #{STEPNO}
		   AND 	ROWNUM = 1
	</select>

	<!-- TF01 Util -->
	<select id="TF01_MAP" parameterType="Map" resultType="DataMap">
		SELECT
		    LOTRKY,
		    WAREKY,
		    SHORTX
		FROM RLRRH
		WHERE LOTRKY = #{LOTRKY}
		   AND WAREKY = #{WAREKY}
	</select>
	
	 <select id="TF01New_MAP" parameterType="Map" resultType="DataMap">
		SELECT
			#{WAREKY} AS WAREKY,
			#{LOTRKY} AS LOTRKY
		FROM DUAL
	</select> 
	
	<!-- TF01 field -->
	<select id="TF01SUB_LIST" parameterType="Map" resultType="DataMap">
	SELECT  A.WAREKY 
	       ,A.LOTRKY 
	       ,A.ITEMNO 
	       ,A.DBFILD 
	       ,A.RNGVIE 
	       ,A.RNGVOP 
	       ,A.RNGVMI 
	       ,A.RNGVMX 
	       ,A.LGCOPT
	       ,A.CREDAT 
	       ,A.CRETIM 
	       ,A.CREUSR 
	       ,A.LMODAT 
	       ,A.LMOTIM 
	       ,A.LMOUSR 
	       ,A.INDBZL 
	       ,A.INDARC 
	       ,A.UPDCHK 
	FROM RLRRI A
	WHERE 1 = 1
		AND   A.LOTRKY = #{LOTRKY}
		AND   A.WAREKY = #{WAREKY}
	</select>
	<select id="TF01SubNew_MAP" parameterType="Map" resultType="DataMap">
	SELECT  #{WAREKY} AS WAREKY
	       ,#{LOTRKY} AS LOTRKY
	       ,#{ITEMNO} AS ITEMNO
	       ,#{DBFILD} AS DBFILD
	       ,#{RNGVIE} AS RNGVIE
	       ,#{RNGVOP} AS RNGVOP
	       ,#{RNGVMI} AS RNGVMI
	       ,#{RNGVMX} AS RNGVMX
	       ,#{LGCOPT} AS LGCOPT
	       , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT
		   , TO_CHAR(SYSDATE, 'HHMISS') AS CRETIM
		   , #{SES_USER_ID} AS CREUSR
		   , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT
		   , TO_CHAR(SYSDATE, 'HHMISS') AS LMOTIM
		   , #{SES_USER_ID} AS LMOUSR
	       ,#{INDBZL} AS INDBZL
	       ,#{INDARC} AS INDARC
	       ,#{UPDCHK} AS UPDCHK
	FROM DUAL 
	</select>

	<insert id="TF01I_UPDATE" parameterType="Map">
		INSERT INTO RLRRH
		(
			 SHORTX,
			 WAREKY,
			 LOTRKY,
			 CREDAT,
		     CRETIM,
			 CREUSR,
			 LMODAT,
			 LMOTIM,
			 LMOUSR,
			 INDBZL,
			 INDARC,
			 UPDCHK
		)
		VALUES
		(
			 NVL(#{SHORTX},' ')
		   , #{WAREKY}
		   , #{LOTRKY}
		   , TO_CHAR(SYSDATE, 'YYYYMMDD')
		   , TO_CHAR(SYSDATE, 'HHMISS')
		   , #{SES_USER_ID}
		   , TO_CHAR(SYSDATE, 'YYYYMMDD')
		   , TO_CHAR(SYSDATE, 'HHMISS')
		   , #{SES_USER_ID}
	       , ' '
	       , ' ' 
	       , 0 
		)
	</insert>
	<insert id="TF01SubI_UPDATE" parameterType="Map">
	INSERT INTO RLRRI(
			  DBFILD
		    , RNGVIE
   	        , RNGVOP
            , RNGVMI
      	    , RNGVMX
      	    , LGCOPT
	        , CREDAT
	        , CRETIM
            , CREUSR
            , LMODAT
		    , LMOTIM
		    , LMOUSR
            , INDBZL
            , INDARC
            , UPDCHK
	        , WAREKY
	        , LOTRKY
	        , ITEMNO)
	VALUES
		(
			 #{DBFILD}
			,#{RNGVIE}	
			,#{RNGVOP}
			,#{RNGVMI}
			,#{RNGVMX}
			,#{LGCOPT}
			, TO_CHAR(SYSDATE, 'YYYYMMDD')
		   , TO_CHAR(SYSDATE, 'HHMISS')
		   , #{SES_USER_ID}
		   , TO_CHAR(SYSDATE, 'YYYYMMDD')
		   , TO_CHAR(SYSDATE, 'HHMISS')
		   , #{SES_USER_ID}
		   ,' '
		   ,' '
		   ,'0'
		   ,#{WAREKY}
		   ,#{LOTRKY}
		   ,LPAD(#{ITEMNO},6,'0')
		)
	</insert>
	<delete id="TF01I_DELETE" parameterType="Map">
		DELETE FROM
			RLRRH
		WHERE WAREKY=#{WAREKY}
			AND LOTRKY=#{LOTRKY}
	</delete>
	<delete id="TF01SubI_DELETE" parameterType="Map">
		DELETE FROM
			RLRRI
		WHERE WAREKY=#{WAREKY}
			AND LOTRKY=#{LOTRKY}
	</delete>
	<select id="LOTRKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
        FROM   
        	RLRRH
		WHERE  
			LOTRKY = #{LOTRKY}
			AND WAREKY =#{WAREKY} 
	</select>
	<!-- NR01 -->
	<select id="NR01_MAP" parameterType="Map" resultType="DataMap">
		SELECT NUMOBJ
		 	  ,SHORTX
			  ,NUMBFR
			  ,NUMBTO
			  ,NUMBST
			  ,CREDAT
			  ,CRETIM
			  ,CREUSR
			  ,NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = NMOBJ.CREUSR),' ') AS CUSRNM
			  ,LMODAT
			  ,LMOTIM
			  ,LMOUSR
			  ,NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = NMOBJ.LMOUSR),' ') AS LUSRNM
			  ,INDBZL
			  ,INDARC
			  ,UPDCHK
		FROM   NMOBJ
		WHERE  NUMOBJ = #{NUMOBJ}
	</select>
	
	<update id="NR01UP_UPDATE" parameterType="Map">
		UPDATE NMOBJ
		SET    SHORTX=#{SHORTX},
		       NUMBST=#{NUMBST}
		WHERE  NUMOBJ=#{NUMOBJ}
	</update>

	<delete id="NR01DEL_DELETE" parameterType="Map">
		DELETE FROM NMOBJ
		WHERE  NUMOBJ=#{NUMOBJ}
	</delete>
	<select id="TF01val_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		FROM   RLRRI
		WHERE  WAREKY = #{WAREKY}
	</select>
	<select id="NUMOBJval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*)CNT
		FROM   NMOBJ
		WHERE  NUMOBJ = #{NUMOBJ}
	</select>
	<insert id="NR01UP_INSERT" parameterType="Map">
		INSERT INTO NMOBJ
		(NUMOBJ
		,SHORTX
		,NUMBFR
		,NUMBTO
		,NUMBST
		,CREDAT
		,CRETIM
		,CREUSR
		,NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID =NMOBJ.CREUSR),' ') AS NMLAST1
		,LMODAT
		,LMOTIM
		,LMOUSR
		,NVL((SELECT NMLAST FROM USRMA WHERE USRMA.USERID = NMOBJ.LMOUSR),' ') AS NMLAST2
		,INDBZL
		,INDARC
		,UPDCHK)
		VALUES(
		#{NUMOBJ},
		#{SHORTXTO},
		#{NUMBFR},
		#{NUMBTO},
		#{NUMBST},
		#{NMLAST},
		TO_CHAR(SYSDATE, 'YYYYMMDD'),
		TO_CHAR(SYSDATE, 'HH24MISS'),
		#{SES_USER_ID},
		TO_CHAR(SYSDATE, 'YYYYMMDD'),
		TO_CHAR(SYSDATE, 'HH24MISS'),
		#{SES_USER_ID},
		#{NMLAST},
		NVL(#{INDBZL}, ' '),
		NVL(#{INDARC}, ' '),
		TO_NUMBER(NVL(TRIM(#{UPDCHK}), 0)))
	</insert>
	<!-- VALIDATION -->
	<select id="TS01_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL , '['|| CMCDVL || '] ' || CDESC1 AS TEXT_COL
		FROM CMCDV WHERE CMCDKY = 'INDASD'
	</select>

	<select id="PATYPECOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL , CDESC1 AS
		TEXT_COL FROM CMCDV WHERE CMCDKY = 'PATYPE'
	</select>
	
	<select id="TKZONECOMBO_LIST" parameterType="Map" resultType="DataMap">
