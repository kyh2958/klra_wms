			 #{SES_USER_ID} AS CREUSR,
			 NVL((SELECT NMLAST FROM USRMA D WHERE D.USERID = #{SES_USER_ID}),' ') AS CUSRNM,
			 TO_CHAR(SYSDATE,'YYYYMMDD') AS LMODAT,
			 TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM,
			 #{SES_USER_ID} AS LMOUSR,
			 NVL((SELECT NMLAST FROM USRMA D WHERE D.USERID = #{SES_USER_ID}),' ') AS LUSRNM
		FROM DUAL
	</select>
	
	<select id="SK03SKUKEY_MAP" parameterType="Map" resultType="DataMap">
		SELECT  COUNT(*) CNT
		FROM	VSKUMA
		WHERE	1 = 1
		AND		OWNRKY = #{SES_OWNER}
		AND		WAREKY = #{WAREKY}
		AND		SKUKEY = #{SKUKEY}
	</select>
	
	<update id="SK03SKU_UPDATE" parameterType="Map">
	 UPDATE SKUMA SET 
		    LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD') ,
	        LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS') ,
	        LMOUSR = #{SES_USER_ID} ,
	    <if test="OWNRKY != null and OWNRKY != ''">
			OWNRKY = #{OWNRKY},
		</if>
	    <if test="SKUKEY != null and SKUKEY != ''">
			SKUKEY = #{SKUKEY},
		</if>
	    <if test="DELMAK != null and DELMAK != ''">
			DELMAK = #{DELMAK},
		</if>
	    <if test="DESC01 != null and DESC01 != ''">
			DESC01 = #{DESC01},
		</if>
	    <if test="DESC02 != null and DESC02 != ''">
			DESC02 = #{DESC02},
		</if>
	    <if test="DESC03 != null and DESC03 != ''">
			DESC03 = #{DESC03},
		</if>
	    <if test="DESC04 != null and DESC04 != ''">
			DESC04 = #{DESC04},
		</if>
	    <if test="DUOMKY != null and DUOMKY != ''">
			DUOMKY = #{DUOMKY},
		</if>
	    <if test="ABCANV != null and ABCANV != ''">
			ABCANV = #{ABCANV},
		</if>
	    <if test="SKUG01 != null and SKUG01 != ''">
			SKUG01 = #{SKUG01},
		</if>
	    <if test="SKUG02 != null and SKUG02 != ''">
			SKUG02 = #{SKUG02},
		</if>
	    <if test="SKUG03 != null and SKUG03 != ''">
			SKUG03 = #{SKUG03},
		</if>
	    <if test="SKUG04 != null and SKUG04 != ''">
			SKUG04 = #{SKUG04},
		</if>
	    <if test="SKUG05 != null and SKUG05 != ''">
			SKUG05 = #{SKUG05},
		</if>
	    <if test="SKUL01 != null and SKUL01 != ''">
			SKUL01 = #{SKUL01},
		</if>
	    <if test="SKUL02 != null and SKUL02 != ''">
			SKUL02 = #{SKUL02},
		</if>
	    <if test="LOTL01 != null and LOTL01 != ''">
			LOTL01 = #{LOTL01},
		</if>
	    <if test="LOTL02 != null and LOTL02 != ''">
			LOTL02 = #{LOTL02},
		</if>
	    <if test="LOTL03 != null and LOTL03 != ''">
			LOTL03 = #{LOTL03},
		</if>
	    <if test="LOTL04 != null and LOTL04 != ''">
			LOTL04 = #{LOTL04},
		</if>
	    <if test="LOTL05 != null and LOTL05 != ''">
			LOTL05 = #{LOTL05},
		</if>
	    <if test="LOTL06 != null and LOTL06 != ''">
			LOTL06 = #{LOTL06},
		</if>
	    <if test="LOTL07 != null and LOTL07 != ''">
			LOTL07 = #{LOTL07},
		</if>
	    <if test="LOTL08 != null and LOTL08 != ''">
			LOTL08 = #{LOTL08},
		</if>
	    <if test="EANCOD != null and EANCOD != ''">
			EANCOD = #{EANCOD},
		</if>
	    <if test="GTINCD != null and GTINCD != ''">
			GTINCD = #{GTINCD},
		</if>
	    <if test="WEIGHT != null and WEIGHT != ''">
			WEIGHT = #{WEIGHT},
		</if>
	    <if test="GRSWGT != null and GRSWGT != ''">
			GRSWGT = #{GRSWGT},
		</if>
	    <if test="NETWGT != null and NETWGT != ''">
			NETWGT = #{NETWGT},
		</if>
	    <if test="WGTUNT != null and WGTUNT != ''">
