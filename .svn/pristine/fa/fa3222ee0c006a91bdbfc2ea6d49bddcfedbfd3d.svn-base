	WHERE 1 = 1
 	  AND   OWNRKY = #{OWNRKY} 
	  AND   SKUKEY = #{SKUKEY} 
	</update>
	
	<select id="SK04_LIST" parameterType="Map" resultType="DataMap">
		SELECT B.MATNR,
			B.SKUKEY,
			NVL((SELECT DESC01 FROM SKUMA WHERE 1=1 AND OWNRKY = #{SES_OWNER} AND SKUKEY =  B.SKUKEY),' ') AS DESC01
		FROM BUYER B
		WHERE 1 = 1
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	</select>
	
	<select id="VH01_LIST" parameterType="Map" resultType="DataMap">
		SELECT	
			  VEHIID
			, VEHINO
			, VEHINM
			, VEHIOW
			, VEHITY
			, VEHIWG
			, DRIVER
			, TELN01
			, VEHSTS
			, CREDAT
			, CRETIM
			, CREUSR
			, LMODAT
			, LMOTIM
			, LMOUSR
		FROM VEHMA
		WHERE 1 = 1
		<if test="VEHIOW != null and VEHIOW != ''">
			AND VEHIOW = #{VEHIOW}
		</if>
		<if test="VEHITY != null and VEHITY != ''">
			AND VEHITY = #{VEHITY}
		</if>
		<if test="VEHIWG != null and VEHIWG != ''">
			AND VEHIWG = #{VEHIWG}
		</if>
		<if test="VEHSTS != null and VEHSTS != ''">
			AND VEHSTS = #{VEHSTS}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		ORDER BY VEHINO, VEHIID 
	</select>
	
	<delete id="VH01_DELETE" parameterType="Map">
		DELETE FROM VEHMA
		 WHERE VEHIID = #{VEHIID} 
	</delete>
	
	<update id="VH01_UPDATE" parameterType="Map">
		UPDATE VEHMA SET 
			<if test="VEHINO != null and VEHINO != ''">
				 VEHINO = #{VEHINO},
			</if>
			<if test="VEHINM != null and VEHINM != ''">			
				 VEHINM = #{VEHINM},
			</if> 
			<if test="VEHIOW != null and VEHIOW != ''">			
				 VEHIOW = #{VEHIOW},
			</if>
			<if test="VEHITY != null and VEHITY != ''">
				 VEHITY = #{VEHITY},
			</if>
			<if test="VEHIWG != null and VEHIWG != ''">			
				 VEHIWG = #{VEHIWG},
			</if> 
			<if test="DRIVER != null and DRIVER != ''">			
				 DRIVER = #{DRIVER},
			</if>
			<if test="TELN01 != null and TELN01 != ''">
				 TELN01 = #{TELN01},
			</if>
			<if test="VEHSTS != null and VEHSTS != ''">			
				 VEHSTS = #{VEHSTS},
			</if> 
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
			LMOUSR = #{SES_USER_ID}
		WHERE VEHIID = #{VEHIID} 
	</update>
	
	<insert id="VH01_INSERT" parameterType="Map">
		INSERT INTO VEHMA
			(	 VEHIID, VEHINO, VEHINM, VEHIOW, VEHITY,
				 VEHIWG, DRIVER, TELN01, VEHSTS, CREDAT,
				 CRETIM, CREUSR, LMODAT, LMOTIM, LMOUSR  ) 
 		VALUES 
 			(   #{VEHIID}, #{VEHINO}, #{VEHINM}, #{VEHIOW}, #{VEHITY},
 				#{VEHIWG}, #{DRIVER}, #{TELN01}, #{VEHSTS}, TO_CHAR(SYSDATE, 'YYYYMMDD'),
 				TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},	TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID})
	</insert>
	
	<select id="STORY_LIST" parameterType="Map" resultType="StringMap">
		SELECT  WAREKY
			   ,ROWNUM AS TMPNUM 
		       ,LSTORY
		       ,LSTOTY
		       ,SHORTX
		       ,LBUILD
			   ,ZONEKY
			   ,NVL((SELECT SHORTX FROM ZONMA Z WHERE Z.WAREKY = S.WAREKY AND Z.ZONEKY = S.ZONEKY),' ') AS ZONENM
		       ,AREAKY
			   ,NVL((SELECT SHORTX FROM AREMA A WHERE A.WAREKY = S.WAREKY AND A.AREAKY = S.AREAKY),' ') AS AREANM
		       ,CREDAT
		       ,CRETIM
		       ,CREUSR
		       ,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = S.CREUSR),' ') AS CUSRNM
		       ,LMODAT
		       ,LMOTIM
		       ,LMOUSR
		       ,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = S.LMOUSR),' ') AS LUSRNM
		       ,INDBZL
		       ,INDARC
		       ,UPDCHK
		FROM STORY S
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">			
			AND WAREKY = #{WAREKY} 
		</if> 
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		ORDER BY LSTORY
	</select>
	
	<insert id="STORY_INSERT" parameterType="Map">
	INSERT INTO 
		STORY  (WAREKY,LSTORY,LSTOTY,SHORTX,LBUILD,AREAKY,ZONEKY,
		        CREDAT,CRETIM,CREUSR,LMODAT,LMOTIM,LMOUSR) 
 		VALUES (#{WAREKY},#{LSTORY},#{LSTOTY},#{SHORTX},#{LBUILD},#{AREAKY},#{ZONEKY},
		 		TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
		 		TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID})
	</insert>
	
	<delete id="STORY_DELETE" parameterType="Map">
		DELETE FROM STORY 
		 WHERE WAREKY = #{WAREKY} 
		   AND LSTORY = #{LSTORY}
	       AND ZONEKY = #{ZONEKY}
	</delete>
	
	<update id="STORY_UPDATE" parameterType="Map">
		UPDATE STORY SET 
			<if test="LSTOTY != null and LSTOTY != ''">
			   LSTOTY = #{LSTOTY},
			</if>
			<if test="SHORTX != null and SHORTX != ''">			
			   SHORTX = #{SHORTX},
			</if> 
			<if test="LBUILD != null and LBUILD != ''">			
			   LBUILD = #{LBUILD},
			</if>			
			  LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			  LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS'),
			  LMOUSR = #{SES_USER_ID}
		WHERE WAREKY = #{WAREKY} 
		AND   LSTORY = #{LSTORY}
	    AND   ZONEKY = #{ZONEKY}
	</update>	

	<select id="STORY_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT *
		  FROM (
		         SELECT CASE WHEN NOT EXISTS ( SELECT '1' FROM CMCDV  WHERE CMCDKY = 'LSTOTY'  AND CMCDVL = STD.LSTOTY )
		                          THEN 'VALID_M1574†' || STD.LSTOTY
		                     WHEN NOT EXISTS ( SELECT '1' FROM ZONMA WHERE WAREKY = STD.WAREKY AND ZONEKY = STD.ZONEKY )
		                          THEN 'VALID_M1575†' || STD.ZONEKY
		                     WHEN NOT EXISTS ( SELECT '1' FROM AREMA WHERE WAREKY = STD.WAREKY AND AREAKY = STD.AREAKY )
		                          THEN 'VALID_M1576†' || STD.AREAKY
		                     ELSE 'OK'
		                  END AS RESULTMSG
		           FROM (
		                  ${APPEND_QUERY}
		                ) STD
		       )
		 WHERE RESULTMSG != 'OK'
	</select>
	
	<select id="LOCAKYCOMBO_LIST" parameterType="Map" resultType="DataMap">
        SELECT LOCAKY AS VALUE_COL,
		       LOCAKY AS TEXT_COL
		FROM   LOCMA 
		WHERE  AREAKY = 'RCV'
	   <if test="WAREKY != null and WAREKY != ''">
         AND   WAREKY = #{WAREKY} 
       </if>
    </select>	

	<select id="LT01_LIST" parameterType="Map" resultType="DataMap">
		SELECT WAREKY AS STCKEY
		     , AREAKY || '_WMS' AS ITFSID
		     , INFUSE
		     , OTRUSE
		     , STCSTS
		 FROM KT000
		WHERE 1 = 1
	 <if test="STCKEY != null and STCKEY != ''">			
		AND   WAREKY = #{STCKEY} 
	 </if> 
	 <if test="IFID != null and IFID != ''">			
		AND   AREAKY||'_WMS' = #{IFID} 
	 </if>
	 <if test="INFUSE != null and INFUSE != ''">			
		AND   INFUSE = #{INFUSE} 
	 </if>
	 <if test="OTRUSE != null and OTRUSE != ''">			
		AND   OTRUSE = #{OTRUSE} 
	 </if>				
		ORDER BY STCKEY
	</select>
	
	<sql id="LT01_MERGE">
		MERGE INTO KT000 A 
		USING DUAL B ON (A.STCKEY = B.STCKEY)
		WHEN MATCHED THEN
			UPDATE SET ITFSID = #{ITFSID}
			         , INFUSE = #{INFUSE}
					 , OTRUSE = #{OTRUSE}
					 , STCSTS = #{STCSTS}
		WHEN NOT MATCHED THEN
			INSERT (STCKEY, ITFSID, INFUSE, OTRUSE, STCSTS)
			VALUES (#{STCKEY}, #{ITFSID}, #{INFUSE}, #{OTRUSE}, #{STCSTS})
	</sql>
	
	<insert id="LT01_INSERT" parameterType="Map">
		<include refid="LT01_MERGE"/>
	</insert>		
	
	<update id="LT01_UPDATE" parameterType="Map">
		<include refid="LT01_MERGE"/>
	</update>
	
	<delete id="LT01_DELETE" parameterType="Map">
		DELETE FROM KT000 
		WHERE WAREKY = #{STCKEY} 
	</delete>
	
	<select id="UOMKEYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM MEASI
		WHERE WAREKY  = #{WAREKY}
		AND MEASKY = #{MEASKY}
		AND UOMKEY = #{UOMKEY}
		AND ROWNUM = 1
	</select>
	
	<select id="TR01ALSTKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) AS CNT
		FROM   ALSTH
		WHERE  WAREKY = #{WAREKY}
		AND    ALSTKY = #{ALSTKY}
	</select>
	
	<select id="PTNRKYchk_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) AS CNT
		FROM   ALCUS
		WHERE  WAREKY = #{WAREKY}
		AND    CUSTMR = #{CUSTMR}
	</select>
	
	<select id="DOCUTYchk_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) AS CNT
		FROM   ALCUS
		WHERE  WAREKY = #{WAREKY}
		AND    DOCUTY = #{DOCUTY}
	</select>
	
	<!--2020.04.08 LHJ할당필터링 키validation추가-->
	<select id="TA01ALSTKYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM ALSTH
		WHERE WAREKY = #{WAREKY}
		AND ALSTKY = #{ALSTKY}
	</select>

	<!--2020.04.08 LHJ 재고정렬 키validation추가-->
	<select id="TA01STSRHval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM STSRH
		WHERE WAREKY = #{WAREKY}
		AND SSORKY = #{SSORKY}
	</select>
	
	<!--2020.04.10 LHJ 할당필터링 키, 재고정렬 키 존재validation추가-->
	<select id="TA01SSOALFTval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) AS CNT
		FROM ALSTI
		WHERE WAREKY = #{WAREKY}
		AND ALSTKY = #{ALSTKY}
		AND ALFTKY = #{ALFTKY}
		AND SSORKY = #{SSORKY}
	</select>
	<!-- 2020.04.16 구역Validation추가 -->
	<select id="ZONMAval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM ZONMA
		WHERE WAREKY = #{WAREKY}
		AND ZONEKY= #{ZONEKY}
	</select>
	<select id="STLMAYval_MAP" parameterType="Map" resultType="DataMap">
		SELECT STLNM 
		FROM STLMA
		WHERE OWNRKY = #{OWNRKY}
		AND STLKY= #{STLKY}
	</select>
	<!-- 2020.04.16 문서유형Validation추가 -->
	<select id="DOCCval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT
		FROM DOCCM
		WHERE DOCCAT = #{DOCCAT}
	</select>

	<!-- 2020.06.08 [ML01]구역업데이트 시 새로바뀐 구역값 적용쿼리-->
	<update id="SAVEML01_UPDATE" parameterType="Map">
		UPDATE STKKY 
		   SET AREAKY = #{AREAKY} <!--#수정한 AREAKY-->
			  ,ZONEKY = #{ZONEKY} <!--#수정한 ZONEKY-->
		 WHERE WAREKY = #{WAREKY}
		   AND OWNRKY = #{OWNRKY}
		   AND AREAKY = #{AAREAKY} <!--#기존의OWNRKY에 대한 AREAKY-->
		   AND ZONEKY = #{AZONEKY} <!--#기존ZONEKY-->
		   AND LOCAKY = #{ALOCAKY} <!--#기존LOCAKY-->
		   AND LOCAKY != 'SHPLOC'
		   AND LOTA06 IN ('00')
		   AND AREAKY NOT IN ('SYS','SHP')
		   AND QTSIWH &gt; 0
		   AND QTSALO = 0
		   AND QTSPMO = 0
		   AND QTSPMI = 0
		   AND QTSBLK = 0
	</update>
	
	<select id="MB01_LIST" parameterType="Map" resultType="DataMap">
		SELECT  WAREKY
		       ,BUILDG
		       ,MAX(NAMEBD) NAMEBD
		       ,STOREY
		       ,MAX(NAMEST) NAMEST
		       ,MAX(CREDAT) CREDAT
		       ,MAX(CRETIM) CRETIM
		       ,MAX(CREUSR) CREUSR
		       ,MAX(LMODAT) LMODAT
		       ,MAX(LMOTIM) LMOTIM
		       ,MAX(LMOUSR) LMOUSR
		       ,' 'INDBZL
		       ,' ' INDARC
       ,0 UPDCHK
		FROM FACLT Z
		WHERE WAREKY = #{WAREKY} 
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>	
		GROUP BY WAREKY,BUILDG,STOREY
	</select>	
	
		
	<select id="MB01Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			DECODE(F.BUILDG,NULL,'N','Y') ROWCHECK
			,#{BUILDG} AS BUILDG
			,#{NAMEBD} AS NAMEBD
			,#{STOREY} AS STOREY
			,#{NAMEST} AS NAMEST
			,Z.WAREKY
			,Z.AREAKY
			,Z.ZONEKY
			,Z.SHORTX 
		FROM  ZONMA Z
		LEFT OUTER JOIN FACLT F ON  Z.WAREKY = F.WAREKY 
								AND Z.ZONEKY = F.ZONEKY 
								AND F.BUILDG = #{BUILDG} 
								AND F.STOREY = #{STOREY}
		WHERE Z.WAREKY =  #{WAREKY}	
		<if test="ALL == &quot;N&quot;">		
	        AND (Z.ZONEKY,Z.AREAKY) NOT IN 
	            (SELECT ZONEKY,AREAKY
	             FROM FACLT 
	             WHERE WAREKY = #{WAREKY}
	             AND ( BUILDG != #{BUILDG} OR STOREY != #{STOREY}) )
	    </if>            
		ORDER BY Z.AREAKY,F.ZONEKY
	</select>	
	<delete id="DELMB01_DELETE" parameterType="Map">
		DELETE 	FROM FACLT
		WHERE WAREKY = #{WAREKY} 
		<if test="ZONEKY != null and ZONEKY != ''">	
			AND ZONEKY = #{ZONEKY} 
		</if>	
		AND BUILDG = #{BUILDG} 
		AND STOREY = #{STOREY}
	</delete>

	<insert id="AGNMB01_INSERT" parameterType="Map">
		INSERT INTO FACLT
		(WAREKY, BUILDG, NAMEBD, STOREY, NAMEST, AREAKY, ZONEKY,
		 CREDAT, CRETIM, CREUSR,
		 LMODAT, LMOTIM, LMOUSR,
		 INDBZL, INDARC, UPDCHK )
		VALUES
		(#{WAREKY}, #{BUILDG}, #{NAMEBD}, #{STOREY}, #{NAMEST}, #{AREAKY}, #{ZONEKY},
		 TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
		 TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID},
		 ' ',' ',0 )
	</insert>
	
	<select id="MB01RE_LIST" parameterType="Map" resultType="DataMap">
		SELECT  WAREKY
		       ,BUILDG
		       ,MAX(NAMEBD) NAMEBD
		       ,STOREY
		       ,MAX(NAMEST) NAMEST
		       ,MAX(CREDAT) CREDAT
		       ,MAX(CRETIM) CRETIM
		       ,MAX(CREUSR) CREUSR
		       ,MAX(LMODAT) LMODAT
		       ,MAX(LMOTIM) LMOTIM
		       ,MAX(LMOUSR) LMOUSR
		       ,' 'INDBZL
		       ,' ' INDARC
       ,0 UPDCHK
		FROM FACLT Z
		WHERE (WAREKY,BUILDG,STOREY) IN ( ${APPEND_QUERY} )
		GROUP BY WAREKY,BUILDG,STOREY
		ORDER BY WAREKY,BUILDG,STOREY
	</select>
	
	<select id="RLRRH_LIST" parameterType="Map" resultType="DataMap">
		SELECT RLRRH.*
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RLRRH.CREUSR), ' ') AS CUSRNM
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RLRRH.LMOUSR), ' ') AS LUSRNM
		  FROM RLRRH
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="LOTRKY != null and LOTRKY != ''">AND LOTRKY = #{LOTRKY}</if>
	</select>
	
	<select id="ALSTI_COUNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS COUNT
		  FROM ALSTI
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="SSORKY != null and SSORKY != ''">AND SSORKY = #{SSORKY}</if>
		   <if test="LOTRKY != null and LOTRKY != ''">AND ALFTKY = #{LOTRKY}</if>
	</select>
	
	<delete id="RLRRH_RLRRI_DEL_DELETE" parameterType="Map">
		BEGIN
		    DELETE FROM RLRRH WHERE WAREKY = #{WAREKY} AND LOTRKY = #{LOTRKY};
		    DELETE FROM RLRRI WHERE WAREKY = #{WAREKY} AND LOTRKY = #{LOTRKY};
		END;
	</delete>
	
	<select id="STSRH_LIST" parameterType="Map" resultType="DataMap">
		SELECT STSRH.*
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STSRH.CREUSR), ' ') AS CUSRNM
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STSRH.LMOUSR), ' ') AS LUSRNM
		     , ' ' AS STATUS
		  FROM STSRH
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="SSORKY != null and SSORKY != ''">AND SSORKY = #{SSORKY}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
	</select>
	
	<select id="STSRI_LIST" parameterType="Map" resultType="DataMap">
		SELECT STSRI.*
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STSRI.CREUSR), ' ') AS CUSRNM
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STSRI.LMOUSR), ' ') AS LUSRNM
		  FROM STSRI
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="WAREKY == null or WAREKY == ''">AND WAREKY = ' '</if>
		   <if test="SSORKY != null and SSORKY != ''">AND SSORKY = #{SSORKY}</if>
		   <if test="WAREKY == null or WAREKY == ''">AND SSORKY = ' '</if>
		   <if test="ITEMNO != null and ITEMNO != ''">AND ITEMNO = #{ITEMNO}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
	</select>
	
	<select id="STSRI_DATA_VALIDATION_OBJECT" parameterType="Map" resultType="String">
		SELECT VALIDATION_MSG
		  FROM (
		         SELECT VALIDATION_MSG
		           FROM (
		                  SELECT CASE WHEN EXISTS (SELECT COUNT(SORTSQ) FROM (${VALIDATION_DATA_SQL}) WHERE SORTSQ != 0 GROUP BY SORTSQ HAVING COUNT(SORTSQ) &gt; 1)
		                                   THEN '할당정렬키 [' || VALID.SSORKY || ']에 중복되는 정렬순서가 있습니다.'
		                         END AS VALIDATION_MSG
		                    FROM (
		                           ${VALIDATION_DATA_SQL}
		                         ) VALID
		                )
		          WHERE TRIM(VALIDATION_MSG) IS NOT NULL
		       )
		 WHERE ROWNUM = 1
	</select>
	
	<update id="STSRH_MERGE_UPDATE" parameterType="Map">
		MERGE INTO STSRH T 
		USING ( 
		        SELECT #{WAREKY} AS WAREKY, #{SSORKY} AS SSORKY, #{SHORTX} AS SHORTX
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE,'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE,'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
		             , ' ' AS INDBZL, ' ' AS INDARC, 0 AS UPDCHK
		          FROM DUAL
		      ) S ON ( S.WAREKY = T.WAREKY AND S.SSORKY = T.SSORKY )
		WHEN MATCHED THEN 
		    UPDATE 
		       SET SHORTX = S.SHORTX
		         , LMODAT = S.LMODAT
		         , LMOTIM = S.LMOTIM
		         , LMOUSR = S.LMOUSR
		WHEN NOT MATCHED THEN 
		    INSERT
		    (
		        WAREKY, SSORKY, SHORTX
		      , CREDAT, CRETIM, CREUSR
		      , LMODAT, LMOTIM, LMOUSR
		      , INDBZL, INDARC, UPDCHK
		    )
		    VALUES(
		              S.WAREKY, S.SSORKY, S.SHORTX
		            , S.CREDAT, S.CRETIM, S.CREUSR
		            , S.LMODAT, S.LMOTIM, S.LMOUSR
		            , S.INDBZL, S.INDARC, S.UPDCHK
		    )
	</update>
	
	<update id="STSRI_MERGE_UPDATE" parameterType="Map">
		MERGE INTO STSRI T 
		USING ( 
		        SELECT #{WAREKY} AS WAREKY, #{SSORKY} AS SSORKY, #{ITEMNO} AS ITEMNO
		             , NVL(#{FIELDN}, ' ') AS FIELDN, NVL(#{FLDCMT}, ' ') AS FLDCMT
		             , NVL(#{TABLEN},' ') AS TABLEN
		             , NVL(#{ACTVAT},' ') AS ACTVAT
		             , NVL(#{SORTSQ}, 0) AS SORTSQ
		             , NVL(#{INDASD},' ') AS INDASD
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE,'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE,'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
		             , ' ' AS INDBZL, ' ' AS INDARC, 0 AS UPDCHK
		          FROM DUAL
		      ) S ON ( S.WAREKY = T.WAREKY AND S.SSORKY = T.SSORKY AND S.ITEMNO = T.ITEMNO )
		WHEN MATCHED THEN 
		    UPDATE 
		       SET TABLEN = S.TABLEN
		         , ACTVAT = S.ACTVAT
		         , SORTSQ = S.SORTSQ
		         , INDASD = S.INDASD
		         , LMODAT = S.LMODAT
		         , LMOTIM = S.LMOTIM
		         , LMOUSR = S.LMOUSR
		WHEN NOT MATCHED THEN 
		    INSERT
		    (
		        WAREKY, SSORKY, ITEMNO, FIELDN, FLDCMT
		      , TABLEN, ACTVAT, SORTSQ, INDASD
		      , CREDAT, CRETIM, CREUSR
		      , LMODAT, LMOTIM, LMOUSR
		      , INDBZL, INDARC, UPDCHK
		    )
		    VALUES(
		              S.WAREKY, S.SSORKY, S.ITEMNO, S.FIELDN, S.FLDCMT
		            , S.TABLEN, S.ACTVAT, S.SORTSQ, S.INDASD
		            , S.CREDAT, S.CRETIM, S.CREUSR
		            , S.LMODAT, S.LMOTIM, S.LMOUSR
		            , S.INDBZL, S.INDARC, S.UPDCHK
		    )
	</update>
	
	<delete id="STSRH_STSRI_DEL_DELETE" parameterType="Map">
		BEGIN
		    DELETE FROM STSRH WHERE WAREKY = #{WAREKY} AND SSORKY = #{SSORKY};
		    DELETE FROM STSRI WHERE WAREKY = #{WAREKY} AND SSORKY = #{SSORKY};
		END;
	</delete>
	
	<!-- TR02 START -->	
	<select id="ORDPR_LIST" parameterType="Map" resultType="DataMap">
		SELECT  ORDPR.WAREKY      AS WAREKY
		       ,ORDPR.PRIORT      AS PRIORT
		       ,MAX(ORDPR.CDESC1) AS CDESC1
		       ,WAREKY || PRIORT  AS KEY		       
		  FROM ORDPR
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="PRIORT != null and PRIORT != ''">AND PRIORT = #{PRIORT}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
		 GROUP BY WAREKY, PRIORT  
	</select>
	
	<!-- SKU> 단위구성 조회 하단 -->
	<select id="ORDPRSub_LIST" parameterType="Map" resultType="DataMap">
		SELECT  WAREKY AS WAREKY
		       ,PRIORT AS PRIORT
		       ,ITEMNO AS ITEMNO
		       ,CDESC1 AS CDESC1
		       ,CDESC2 AS CDESC2
		       ,FIELDN AS FIELDN
		       ,FLDCMT AS FLDCMT
		       ,TABLEN AS TABLEN
		       ,ACTVAT AS ACTVAT
		       ,SORTSQ AS SORTSQ	
		       ,INDASD AS INDASD		       	       
		       ,UPDCHK AS UPDCHK
			   ,CREDAT
			   ,CRETIM
			   ,CREUSR
			   ,LMODAT
			   ,LMOTIM
			   ,LMOUSR
			   ,INDBZL
			   ,INDARC
			   ,UPDCHK		       
		FROM  ORDPR
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND WAREKY = #{WAREKY}
		</if>
		<if test="PRIORT != null and PRIORT != ''">
			AND PRIORT = #{PRIORT}
		</if>
		ORDER BY WAREKY, PRIORT  
	</select>	
	
	<select id="TR02PRIORTval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM ORDPR
		WHERE WAREKY  = #{WAREKY}
		AND PRIORT = #{PRIORT}
		AND ROWNUM = 1
	</select>	
	
	<!-- TR02> 분배오더우선순위  ITEMNO-->
	<select id="TR02ITEMNOval_MAP" parameterType="Map" resultType="DataMap">
	  	SELECT COUNT(*)CNT
		FROM ORDPR	  	
		WHERE 1 = 1
		AND WAREKY = #{WAREKY}
		AND PRIORT = #{PRIORT}
		AND ITEMNO = #{ITEMNO}		
	</select>	
	
	<!-- TR02> 분배오더우선순위  FIELDN-->	
	<select id="TR02FIELDNval_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) CNT 
		FROM ORDPR
		WHERE WAREKY  = #{WAREKY}
		AND PRIORT = #{PRIORT}
		AND FIELDN = #{FIELDN}
		AND ROWNUM = 1
	</select>	
	
	<select id="ORDPR_DUPL_VALIDATION_OBJECT" parameterType="Map" resultType="String">
		SELECT CASE WHEN STATUS_SUM &gt; 1
		                 THEN '물류센터  [' || WAREKY || ']이/가 중복 되었습니다.'
		            ELSE ' '
		       END AS VALIDATION_MSG
		  FROM (
		         SELECT WAREKY, PRIORT, SUM(STATUS) AS STATUS_SUM
		           FROM (
		                  SELECT 1 AS STATUS, WAREKY, PRIORT FROM ORDPR UNION ALL
		                  ${VALIDATION_DUPL_SQL}
		                )
		          GROUP BY WAREKY, PRIORT
		         HAVING SUM(STATUS) &gt; 1
		          ORDER BY WAREKY, PRIORT
		       ) VALID
		 WHERE ROWNUM = 1
	</select>
	
	<select id="ORDPR_DATA_VALIDATION_OBJECT" parameterType="Map" resultType="String">
		SELECT VALIDATION_MSG
		  FROM (
		         SELECT VALIDATION_MSG
		           FROM (
		                  SELECT CASE WHEN VALID.STATUS IN ('C','U') AND VALID.OWNRKY != ' ' AND NOT EXISTS (SELECT 1 FROM OWNWC WHERE WAREKY = VALID.WAREKY AND OWNRKY = VALID.OWNRKY)
		                                   THEN '화주 [' || VALID.OWNRKY || ']는 존재하지 않습니다.'
		                              WHEN VALID.STATUS IN ('C','U') AND VALID.PTNRKY != ' ' AND NOT EXISTS (SELECT 1 FROM BZPTN WHERE OWNRKY = VALID.OWNRKY AND PTNRKY = VALID.PTNRKY)
		                                   THEN '거래처 [' || VALID.PTNRKY || ']는 존재하지 않습니다.'
		                              WHEN VALID.STATUS IN ('C','U') AND VALID.ORDTYP != ' ' AND NOT EXISTS (SELECT 1 FROM DOCTM WHERE DOCCAT = '200' AND DOCUTY = VALID.ORDTYP)
		                                   THEN '문서타입 [' || VALID.ORDTYP || ']는 유효하지 않습니다.'
		                         END AS VALIDATION_MSG
		                    FROM (
		                           ${VALIDATION_DATA_SQL}
		                         ) VALID
		                )
		          WHERE TRIM(VALIDATION_MSG) IS NOT NULL
		       )
		 WHERE ROWNUM = 1
	</select>
	
	<delete id="ORDPR_DELETE" parameterType="Map">
		DELETE FROM ORDPR
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="PRIORT != null and PRIORT != ''">AND PRIORT = #{PRIORT}</if>
	</delete>
	
	<insert id="ORDPR_INSERT" parameterType="Map">
		INSERT INTO ORDPR
		( 
		    CREDAT, CRETIM, CREUSR
		  , LMODAT, LMOTIM, LMOUSR
		  , INDBZL, INDARC, UPDCHK
		  , WAREKY -- PK_1
		  , PRIORT -- PK_2
		  <if test="OWNRKY != null and OWNRKY != ''">, OWNRKY</if>
		  <if test="ORDTYP != null and ORDTYP != ''">, ORDTYP</if>
		  <if test="CHANEL != null and CHANEL != ''">, CHANEL</if>
		  <if test="PTNRKY != null and PTNRKY != ''">, PTNRKY</if>
		) 
		VALUES( 
		    TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , ' ', ' ', 0 
		  , #{WAREKY} -- PK_1
		  , #{PRIORT} -- PK_2
		  <if test="OWNRKY != null and OWNRKY != ''">, #{OWNRKY}</if>
		  <if test="ORDTYP != null and ORDTYP != ''">, #{ORDTYP}</if>
		  <if test="CHANEL != null and CHANEL != ''">, #{CHANEL}</if>
		  <if test="PTNRKY != null and PTNRKY != ''">, #{PTNRKY}</if>
		)
	</insert>
	
	<update id="ORDPR_UPDATE" parameterType="Map">
		UPDATE ORDPR
		   SET CDESC1 = NVL(#{CDESC1},' ')
		     , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
		     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
		     , LMOUSR = #{SES_USER_ID}
		     <if test="OWNRKY != null and OWNRKY != ''">, OWNRKY = #{OWNRKY}</if>
		     <if test="ORDTYP != null and ORDTYP != ''">, ORDTYP = #{ORDTYP}</if>
		     <if test="CHANEL != null and CHANEL != ''">, CHANEL = #{CHANEL}</if>
		     <if test="PTNRKY != null and PTNRKY != ''">, PTNRKY = #{PTNRKY}</if>
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="PRIORT != null and PRIORT != ''">AND PRIORT = #{PRIORT}</if>
	</update>
	
	<!-- TS02 START -->
	<insert id="STORH_INSERT" parameterType="Map">
		INSERT INTO STORH
		(
		    CREDAT, CRETIM, CREUSR
		  , LMODAT, LMOTIM, LMOUSR
		  , INDBZL, INDARC, UPDCHK
		  , WAREKY
		  , SHSTKY
		  <if test="SHORTX != null and SHORTX != ''">, SHORTX</if>
		  <if test="SHLCAT != null and SHLCAT != ''">, SHLCAT</if>
		)
		VALUES(
		    TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , ' ', ' ', 0
		  , #{WAREKY}
		  , #{SHSTKY}
		  <if test="SHORTX != null and SHORTX != ''">, #{SHORTX}</if>
		  <if test="SHLCAT != null and SHLCAT != ''">, #{SHLCAT}</if>
		)
	</insert>
	
	<insert id="STORI_INSERT" parameterType="Map">
		INSERT INTO STORI
		(
		    CREDAT, CRETIM, CREUSR
		  , LMODAT, LMOTIM, LMOUSR
		  , INDBZL, INDARC, UPDCHK
		  , WAREKY
		  , SHSTKY
		  , ITEMNO
		  <if test="FIELDN != null and FIELDN != ''">, FIELDN</if>
		  <if test="FLDCMT != null and FLDCMT != ''">, FLDCMT</if>
		  <if test="TABLEN != null and TABLEN != ''">, TABLEN</if>
		  <if test="ACTVAT != null and ACTVAT != ''">, ACTVAT</if>
		  <if test="SORTSQ != null and SORTSQ != ''">, SORTSQ</if>
		  <if test="INDASD != null and INDASD != ''">, INDASD</if>
		)
		VALUES(
		    TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , ' ', ' ', 0
		  , #{WAREKY}
		  , #{SHSTKY}
		  , #{ITEMNO}
		  <if test="FIELDN != null and FIELDN != ''">, #{FIELDN}</if>
		  <if test="FLDCMT != null and FLDCMT != ''">, #{FLDCMT}</if>
		  <if test="TABLEN != null and TABLEN != ''">, #{TABLEN}</if>
		  <if test="ACTVAT != null and ACTVAT != ''">, #{ACTVAT}</if>
		  <if test="SORTSQ != null and SORTSQ != ''">, #{SORTSQ}</if>
		  <if test="INDASD != null and INDASD != ''">, #{INDASD}</if>
		)
	</insert>
	
	<select id="ALSTI2_COUNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(1) AS COUNT
		  FROM ALSTI
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="SSORKY != null and SSORKY != ''">AND SSORKY = #{SHSTKY}</if>
		   <if test="LOTRKY != null and LOTRKY != ''">AND ALFTKY = #{LOTRKY}</if>
	</select>
	
	<select id="STORH_LIST" parameterType="Map" resultType="DataMap">
		SELECT WAREKY
		     , SHSTKY
		     , SHORTX
		     , SHLCAT
		     , CREDAT
		     , CRETIM
		     , CREUSR
		     , LMODAT
		     , LMOTIM
		     , LMOUSR
		     , INDBZL
		     , INDARC
		     , UPDCHK
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STORH.CREUSR), ' ') AS CUSRNM
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STORH.LMOUSR), ' ') AS LUSRNM
		  FROM STORH
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="SHSTKY != null and SHSTKY != ''">AND SHSTKY = #{SHSTKY}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
	</select>
	
	<select id="STORI_LIST" parameterType="Map" resultType="DataMap">
		SELECT WAREKY
		     , SHSTKY
		     , ITEMNO
		     , TABLEN
		     , FIELDN
		     , FLDCMT
		     , ACTVAT
		     , SORTSQ
		     , INDASD
		     , CREDAT
		     , CRETIM
		     , CREUSR
		     , LMODAT
		     , LMOTIM
		     , LMOUSR
		     , INDBZL
		     , INDARC
		     , UPDCHK
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STORI.CREUSR), ' ') AS CUSRNM
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STORI.LMOUSR), ' ') AS LUSRNM
		  FROM STORI
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="WAREKY == null or WAREKY == ''">AND WAREKY = ' '</if>
		   <if test="SHSTKY != null and SHSTKY != ''">AND SHSTKY = #{SHSTKY}</if>
		   <if test="WAREKY == null or WAREKY == ''">AND SHSTKY = ' '</if>
		   <if test="ITEMNO != null and ITEMNO != ''">AND ITEMNO = #{ITEMNO}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
	</select>
	
	<select id="STORR_LIST" parameterType="Map" resultType="DataMap">
		SELECT WAREKY
		     , SHSTKY
		     , FIELDN
		     , STEPNO
		     , REFVAL
		     , ACTVAT
		     , CREDAT
		     , CRETIM
		     , CREUSR
		     , LMODAT
		     , LMOTIM
		     , LMOUSR
		     , INDBZL
		     , INDARC
		     , UPDCHK
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STORR.CREUSR), ' ') AS CUSRNM
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = STORR.LMOUSR), ' ') AS LUSRNM
		  FROM STORR
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="WAREKY == null or WAREKY == ''">AND WAREKY = ' '</if>
		   <if test="SHSTKY != null and SHSTKY != ''">AND SHSTKY = #{SHSTKY}</if>
		   <if test="WAREKY == null or WAREKY == ''">AND SHSTKY = ' '</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
	</select>
	
	<select id="STORI_DATA_VALIDATION_OBJECT" parameterType="Map" resultType="String">
		SELECT VALIDATION_MSG
		  FROM (
		         SELECT VALIDATION_MSG
		           FROM (
		                  SELECT CASE WHEN EXISTS (SELECT COUNT(SORTSQ) FROM (${VALIDATION_DATA_SQL}) WHERE SORTSQ != 0 GROUP BY SORTSQ HAVING COUNT(SORTSQ) &gt; 1)
		                                   THEN '할당정렬키 [' || VALID.SHSTKY || ']에 중복되는 정렬순서가 있습니다.'
		                         END AS VALIDATION_MSG
		                    FROM (
		                           ${VALIDATION_DATA_SQL}
		                         ) VALID
		                )
		          WHERE TRIM(VALIDATION_MSG) IS NOT NULL
		       )
		 WHERE ROWNUM = 1
	</select>
	
	<update id="STORH_MERGE_UPDATE" parameterType="Map">
		MERGE INTO STORH T 
		USING ( 
		        SELECT #{WAREKY} AS WAREKY, #{SHSTKY} AS SHSTKY, #{SHORTX} AS SHORTX, #{SHLCAT} AS SHLCAT
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE,'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE,'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
		             , ' ' AS INDBZL, ' ' AS INDARC, 0 AS UPDCHK
		          FROM DUAL
		      ) S ON ( S.WAREKY = T.WAREKY AND S.SHSTKY = T.SHSTKY )
		WHEN MATCHED THEN 
		    UPDATE 
		       SET SHORTX = S.SHORTX
		         , SHLCAT = S.SHLCAT
		         , LMODAT = S.LMODAT
		         , LMOTIM = S.LMOTIM
		         , LMOUSR = S.LMOUSR
		WHEN NOT MATCHED THEN 
		    INSERT
		    (
		        WAREKY, SHSTKY, SHORTX, SHLCAT
		      , CREDAT, CRETIM, CREUSR
		      , LMODAT, LMOTIM, LMOUSR
		      , INDBZL, INDARC, UPDCHK
		    )
		    VALUES(
		              S.WAREKY, S.SHSTKY, S.SHORTX, S.SHLCAT
		            , S.CREDAT, S.CRETIM, S.CREUSR
		            , S.LMODAT, S.LMOTIM, S.LMOUSR
		            , S.INDBZL, S.INDARC, S.UPDCHK
		    )
	</update>
	
	<update id="STORI_MERGE_UPDATE" parameterType="Map">
		MERGE INTO STORI T 
		USING ( 
		        SELECT #{WAREKY} AS WAREKY, #{SHSTKY} AS SHSTKY, #{ITEMNO} AS ITEMNO
		             , #{FIELDN} AS FIELDN, #{FLDCMT} AS FLDCMT
		             , NVL(#{TABLEN},' ') AS TABLEN
		             , NVL(#{ACTVAT},' ') AS ACTVAT
		             , NVL(#{SORTSQ}, 0) AS SORTSQ
		             , NVL(#{INDASD},' ') AS INDASD
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE,'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE,'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
		             , ' ' AS INDBZL, ' ' AS INDARC, 0 AS UPDCHK
		          FROM DUAL
		      ) S ON ( S.WAREKY = T.WAREKY AND S.SHSTKY = T.SHSTKY AND S.ITEMNO = T.ITEMNO )
		WHEN MATCHED THEN 
		    UPDATE 
		       SET TABLEN = S.TABLEN
		         , ACTVAT = S.ACTVAT
		         , SORTSQ = S.SORTSQ
		         , INDASD = S.INDASD
		         , LMODAT = S.LMODAT
		         , LMOTIM = S.LMOTIM
		         , LMOUSR = S.LMOUSR
		WHEN NOT MATCHED THEN 
		    INSERT
		    (
		        WAREKY, SHSTKY, ITEMNO, FIELDN, FLDCMT
		      , TABLEN, ACTVAT, SORTSQ, INDASD
		      , CREDAT, CRETIM, CREUSR
		      , LMODAT, LMOTIM, LMOUSR
		      , INDBZL, INDARC, UPDCHK
		    )
		    VALUES(
		              S.WAREKY, S.SHSTKY, S.ITEMNO, S.FIELDN, S.FLDCMT
		            , S.TABLEN, S.ACTVAT, S.SORTSQ, S.INDASD
		            , S.CREDAT, S.CRETIM, S.CREUSR
		            , S.LMODAT, S.LMOTIM, S.LMOUSR
		            , S.INDBZL, S.INDARC, S.UPDCHK
		    )
	</update>
	
	<delete id="STORH_STORI_DEL_DELETE" parameterType="Map">
		BEGIN
		    DELETE FROM STORH WHERE WAREKY = #{WAREKY} AND SHSTKY = #{SHSTKY};
		    DELETE FROM STORI WHERE WAREKY = #{WAREKY} AND SHSTKY = #{SHSTKY};
		END;
	</delete>
	
	<update id="ORDPR_MERGE_UPDATE" parameterType="Map">
		MERGE INTO ORDPR T 
		USING ( 
		        SELECT #{WAREKY} AS WAREKY, #{PRIORT} AS PRIORT, #{ITEMNO} AS ITEMNO
		             , NVL(#{CDESC1},' ') AS CDESC1
		             , NVL(#{CDESC2},' ') AS CDESC2 
		             , NVL(#{FIELDN},' ') AS FIELDN		             
		             , NVL(#{FLDCMT},' ') AS FLDCMT
		             , NVL(#{TABLEN},' ') AS TABLEN
		             , NVL(#{ACTVAT},' ') AS ACTVAT
		             , NVL(#{SORTSQ}, 0)  AS SORTSQ
		             , NVL(#{INDASD},' ') AS INDASD
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE,'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE,'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
		             , ' ' AS INDBZL, ' ' AS INDARC, 0 AS UPDCHK
		          FROM DUAL
		      ) S ON ( S.WAREKY = T.WAREKY AND S.PRIORT = T.PRIORT AND S.ITEMNO = T.ITEMNO )
		WHEN MATCHED THEN 
		    UPDATE 
		       SET FIELDN = S.FIELDN
		         , FLDCMT = S.FLDCMT
		         , TABLEN = S.TABLEN
		         , ACTVAT = S.ACTVAT
		         , SORTSQ = S.SORTSQ
		         , INDASD = S.INDASD
		         , LMODAT = S.LMODAT
		         , LMOTIM = S.LMOTIM
		         , LMOUSR = S.LMOUSR
		WHEN NOT MATCHED THEN 
		    INSERT
		    (
		        WAREKY, PRIORT, ITEMNO
		      , CDESC1, CDESC2  
		      , FIELDN, FLDCMT
		      , TABLEN, ACTVAT, SORTSQ, INDASD
		      , CREDAT, CRETIM, CREUSR
		      , LMODAT, LMOTIM, LMOUSR
		      , INDBZL, INDARC, UPDCHK
		    )
		    VALUES(
		              S.WAREKY, S.PRIORT, S.ITEMNO
		            , S.CDESC1, S.CDESC2 
		            , S.FIELDN, S.FLDCMT
		            , S.TABLEN, S.ACTVAT, S.SORTSQ, S.INDASD
		            , S.CREDAT, S.CRETIM, S.CREUSR
		            , S.LMODAT, S.LMOTIM, S.LMOUSR
		            , S.INDBZL, S.INDARC, S.UPDCHK
		    )
	</update>
	
	<select id="RLRRI_DATA_VALIDATION_OBJECT" parameterType="Map" resultType="String">
		SELECT VALIDATION_MSG
		  FROM (
		         SELECT VALIDATION_MSG
		           FROM (
		                  SELECT CASE WHEN VALID.STATUS IN ('C','U') AND EXISTS (SELECT 1 FROM RLRRH WHERE WAREKY = VALID.WAREKY AND LOTRKY = VALID.LOTRKY AND VALID.DBFILD = 'LOTA11' AND VALID.RNGVMI = '0' AND VALID.RNGVOP = 'GT')
		                                   THEN '할당필터링키 [' || VALID.LOTRKY || ']의 월기한이 [' || VALID.RNGVMI || ']개월 보다 길어야 합니다.'
		                              WHEN VALID.STATUS IN ('C','U') AND EXISTS (SELECT 1 FROM RLRRH WHERE WAREKY = VALID.WAREKY AND LOTRKY = VALID.LOTRKY AND VALID.DBFILD = 'LOTA11' AND VALID.RNGVMI = ' ' AND VALID.RNGVOP = 'GT')
		                                   THEN '할당필터링키 [' || VALID.LOTRKY || ']의 월기한이 [0]개월보다 길어야 합니다.'
		                              WHEN VALID.STATUS IN ('C','U') AND VALID.DBFILD = 'AREAKY' AND NOT EXISTS (SELECT 1 FROM AREMA WHERE WAREKY = VALID.WAREKY AND AREAKY = VALID.RNGVMI)
		                                   THEN '할당필터링키 [' || VALID.LOTRKY || ']의 위치정보에 입력한 [' || VALID.RNGVMI || ']는 존재하지 않는 영역입니다.'
		                              WHEN VALID.STATUS IN ('C','U') AND VALID.DBFILD = 'ZONEKY' AND NOT EXISTS (SELECT 1 FROM ZONMA WHERE WAREKY = VALID.WAREKY AND ZONEKY = VALID.RNGVMI)
		                                   THEN '할당필터링키 [' || VALID.LOTRKY || ']의 위치정보에 입력한 [' || VALID.RNGVMI || ']는 존재하지 않는 구역입니다.'
		                              WHEN VALID.STATUS IN ('C','U') AND VALID.DBFILD = 'LOCAKY' AND NOT EXISTS (SELECT 1 FROM LOCMA WHERE WAREKY = VALID.WAREKY AND LOCAKY = VALID.RNGVMI)
		                                   THEN '할당필터링키 [' || VALID.LOTRKY || ']의 위치정보에 입력한 [' || VALID.RNGVMI || ']는 존재하지 않는 지번입니다.'
		                         END AS VALIDATION_MSG
		                    FROM (
		                           ${VALIDATION_DATA_SQL}
		                         ) VALID
		                )
		          WHERE TRIM(VALIDATION_MSG) IS NOT NULL
		       )
		 WHERE ROWNUM = 1
	</select>
	
	<update id="RLRRH_MERGE_UPDATE" parameterType="Map">
		MERGE INTO RLRRH T 
		USING ( 
		        SELECT #{WAREKY} AS WAREKY, #{LOTRKY} AS LOTRKY, NVL(#{SHORTX}, ' ') AS SHORTX
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE,'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE,'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
		             , ' ' AS INDBZL, ' ' AS INDARC, 0 AS UPDCHK
		          FROM DUAL
		      ) S ON ( S.WAREKY = T.WAREKY AND S.LOTRKY = T.LOTRKY )
		WHEN MATCHED THEN 
		    UPDATE 
		       SET SHORTX = S.SHORTX
		         , LMODAT = S.LMODAT
		         , LMOTIM = S.LMOTIM
		         , LMOUSR = S.LMOUSR
		WHEN NOT MATCHED THEN 
		    INSERT
		    (
		        WAREKY, LOTRKY, SHORTX
		      , CREDAT, CRETIM, CREUSR
		      , LMODAT, LMOTIM, LMOUSR
		      , INDBZL, INDARC, UPDCHK
		    )
		    VALUES(
		              S.WAREKY, S.LOTRKY, S.SHORTX
		            , S.CREDAT, S.CRETIM, S.CREUSR
		            , S.LMODAT, S.LMOTIM, S.LMOUSR
		            , S.INDBZL, S.INDARC, S.UPDCHK
		    )
	</update>
	
	<insert id="RLRRH_INSERT" parameterType="Map">
		INSERT INTO RLRRH
		(
		    CREDAT, CRETIM, CREUSR
		  , LMODAT, LMOTIM, LMOUSR
		  , INDBZL, INDARC, UPDCHK
		  , WAREKY -- PK_1
		  , LOTRKY -- PK_2
		  <if test="SHORTX != null and SHORTX != ''">, SHORTX</if>
		)
		VALUES(
		    TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , ' ', ' ', 0
		  , #{WAREKY} -- PK_1
		  , #{LOTRKY} -- PK_2
		  <if test="SHORTX != null and SHORTX != ''">, #{SHORTX}</if>
		)
	</insert>
	
	<select id="RLRRI_LIST" parameterType="Map" resultType="DataMap">
		SELECT RLRRI.*
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RLRRI.CREUSR), ' ') AS CUSRNM
		     , NVL((SELECT NMLAST FROM USRMA WHERE USERID = RLRRI.LMOUSR), ' ') AS LUSRNM
		  FROM RLRRI
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="LOTRKY != null and LOTRKY != ''">AND LOTRKY = #{LOTRKY}</if>
		   <if test="ITEMNO != null and ITEMNO != ''">AND ITEMNO = #{ITEMNO}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
	</select>
	
	<insert id="RLRRI_INSERT" parameterType="Map">
		INSERT INTO RLRRI
		(
		    CREDAT, CRETIM, CREUSR
		  , LMODAT, LMOTIM, LMOUSR
		  , INDBZL, INDARC, UPDCHK
		  , WAREKY -- PK_1
		  , LOTRKY -- PK_2
		  , ITEMNO -- PK_3
		  <if test="DBFILD != null and DBFILD != ''">, DBFILD</if>
		  <if test="RNGVIE != null and RNGVIE != ''">, RNGVIE</if>
		  <if test="RNGVOP != null and RNGVOP != ''">, RNGVOP</if>
		  <if test="RNGVMI != null and RNGVMI != ''">, RNGVMI</if>
		  <if test="RNGVMX != null and RNGVMX != ''">, RNGVMX</if>
		  <if test="LGCOPT != null and LGCOPT != ''">, LGCOPT</if>
		)
		VALUES(
		    TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), #{SES_USER_ID}
		  , ' ', ' ', 0
		  , #{WAREKY} -- PK_1
		  , #{LOTRKY} -- PK_2
		  , #{ITEMNO} -- PK_3
		  <if test="DBFILD != null and DBFILD != ''">, #{DBFILD}</if>
		  <if test="RNGVIE != null and RNGVIE != ''">, #{RNGVIE}</if>
		  <if test="RNGVOP != null and RNGVOP != ''">, #{RNGVOP}</if>
		  <if test="RNGVMI != null and RNGVMI != ''">, #{RNGVMI}</if>
		  <if test="RNGVMX != null and RNGVMX != ''">, #{RNGVMX}</if>
		  <if test="LGCOPT != null and LGCOPT != ''">, #{LGCOPT}</if>
		)
	</insert>
	
	<delete id="RLRRI_DELETE" parameterType="Map">
		DELETE FROM RLRRI
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="LOTRKY != null and LOTRKY != ''">AND LOTRKY = #{LOTRKY}</if>
		   <if test="ITEMNO != null and ITEMNO != ''">AND ITEMNO = #{ITEMNO}</if>
	</delete>
	
	<update id="RLRRI_UPDATE" parameterType="Map">
		UPDATE RLRRI
		   SET LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
		     , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
		     , LMOUSR = #{SES_USER_ID}
		     <if test="DBFILD != null and DBFILD != ''">, DBFILD = #{DBFILD}</if>
		     <if test="RNGVIE != null and RNGVIE != ''">, RNGVIE = #{RNGVIE}</if>
		     <if test="RNGVOP != null and RNGVOP != ''">, RNGVOP = #{RNGVOP}</if>
		     <if test="RNGVMI != null and RNGVMI != ''">, RNGVMI = #{RNGVMI}</if>
		     <if test="RNGVMX != null and RNGVMX != ''">, RNGVMX = #{RNGVMX}</if>
		     <if test="LGCOPT != null and LGCOPT != ''">, LGCOPT = #{LGCOPT}</if>
		 WHERE 1 = 1
		   <if test="WAREKY != null and WAREKY != ''">AND WAREKY = #{WAREKY}</if>
		   <if test="LOTRKY != null and LOTRKY != ''">AND LOTRKY = #{LOTRKY}</if>
		   <if test="ITEMNO != null and ITEMNO != ''">AND ITEMNO = #{ITEMNO}</if>
	</update>
	
	<update id="RLRRI_MERGE_UPDATE" parameterType="Map">
		MERGE INTO RLRRI T 
		USING ( 
		        SELECT #{WAREKY} AS WAREKY, #{LOTRKY} AS LOTRKY, #{ITEMNO} AS ITEMNO
		             , NVL(#{DBFILD},' ') AS DBFILD
		             , NVL(#{RNGVIE},'signIn') AS RNGVIE
		             , NVL(#{RNGVOP},' ') AS RNGVOP
		             , NVL(#{RNGVMI},' ') AS RNGVMI
		             , NVL(#{RNGVMX},' ') AS RNGVMX
		             , NVL(#{LGCOPT},' ') AS LGCOPT
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE,'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
		             , TO_CHAR(SYSDATE,'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE,'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
		             , ' ' AS INDBZL, ' ' AS INDARC, 0 AS UPDCHK
		          FROM DUAL
		      ) S ON ( S.WAREKY = T.WAREKY AND S.LOTRKY = T.LOTRKY AND S.ITEMNO = T.ITEMNO )
		WHEN MATCHED THEN 
		    UPDATE 
		       SET DBFILD = S.DBFILD
		         , RNGVIE = S.RNGVIE
		         , RNGVOP = S.RNGVOP
		         , RNGVMI = S.RNGVMI
		         , RNGVMX = S.RNGVMX
		         , LGCOPT = S.LGCOPT
		         , LMODAT = S.LMODAT
		         , LMOTIM = S.LMOTIM
		         , LMOUSR = S.LMOUSR
		WHEN NOT MATCHED THEN 
		    INSERT
		    (
		        WAREKY, LOTRKY, ITEMNO, DBFILD
		      , RNGVIE, RNGVOP, RNGVMI, RNGVMX, LGCOPT
		      , CREDAT, CRETIM, CREUSR
		      , LMODAT, LMOTIM, LMOUSR
		      , INDBZL, INDARC, UPDCHK
		    )
		    VALUES(
		              S.WAREKY, S.LOTRKY, S.ITEMNO, S.DBFILD
		            , S.RNGVIE, S.RNGVOP, S.RNGVMI, S.RNGVMX, S.LGCOPT
		            , S.CREDAT, S.CRETIM, S.CREUSR
		            , S.LMODAT, S.LMOTIM, S.LMOUSR
		            , S.INDBZL, S.INDARC, S.UPDCHK
		    )
	</update> 
	
	<!-- ==================================================================================================================== -->
    <!-- 마스터관리 - 구성 - [MS01] 저장위치 :: BEGIN -->
    <!-- ==================================================================================================================== -->
    <select id="STLMA_LIST" parameterType="Map" resultType="DataMap">
        SELECT MS.OWNRKY
             , MS.PLNTKY
             , SZF_GET_CMCDV_CDESC1_TEXT('KR', 'LOTA02', MS.PLNTKY) AS PLNTNM
             , MS.STLKY
             , MS.STLNM
             , MS.WAREKY
             , WA.NAME01 AS WARENM
             , MS.DELMAK
             , MS.CREDAT
             , MS.CRETIM
             , MS.CREUSR
             , MS.LMODAT
             , MS.LMOTIM
             , MS.LMOUSR
             , MS.INDBZL
             , MS.INDARC
             , MS.UPDCHK
             , MS.WMSMAK
             , NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = MS.CREUSR),' ') AS CUSRNM
             , NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = MS.LMOUSR),' ') AS LUSRNM
          FROM STLMA MS
            LEFT OUTER JOIN WAHMA WA
                         ON WA.WAREKY = MS.WAREKY
         WHERE TRIM(MS.DELMAK) IS NULL
           <if test="WAREKY != null and WAREKY != ''">AND MS.WAREKY = #{WAREKY}</if>
           <if test="RANGE_SQL != null and RANGE_SQL != ''"> ${RANGE_SQL} </if>
         ORDER BY MS.OWNRKY, MS.PLNTKY, MS.STLKY, MS.STLNM, MS.WAREKY
    </select>
    
    <insert id="STLMA_INSERT" parameterType="Map">
        INSERT INTO STLMA
        (
            CREDAT, CRETIM, CREUSR
          , LMODAT, LMOTIM, LMOUSR
          , INDBZL, INDARC, UPDCHK
          , OWNRKY -- PK_1
          , PLNTKY -- PK_2
          , STLKY -- PK_3
          <if test="STLNM != null and STLNM != ''">, STLNM</if>
          <if test="WAREKY != null and WAREKY != ''">, WAREKY</if>
          <if test="DELMAK != null and DELMAK != ''">, DELMAK</if>
        )
        VALUES(
            TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
          , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
          , ' ', ' ', 0
          , #{OWNRKY} -- PK_1
          , #{PLNTKY} -- PK_2
          , #{STLKY} -- PK_3
          <if test="STLNM != null and STLNM != ''">, #{STLNM}</if>
          <if test="WAREKY != null and WAREKY != ''">, #{WAREKY}</if>
          <if test="DELMAK != null and DELMAK != ''">, #{DELMAK}</if>
        )
    </insert>
    
    <update id="STLMA_UPDATE" parameterType="Map">
        UPDATE STLMA
           SET LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
             , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
             , LMOUSR = #{SES_USER_ID}
             , WAREKY = NVL(#{WAREKY}, ' ')
             , WMSMAK = NVL(REPLACE(#{WMSMAK}, ' ', ''), 'X')
         WHERE 1 = 1
           AND OWNRKY = #{OWNRKY}
           AND PLNTKY = #{PLNTKY}
           AND STLKY = #{STLKY}
    </update>
    
    <delete id="STLMA_DELETE" parameterType="Map">
        DELETE FROM STLMA
        WHERE 1 = 1
          AND OWNRKY = #{OWNRKY}
          AND PLNTKY = #{PLNTKY}
          AND STLKY = #{STLKY}
    </delete>
    
    <select id="STLMA_DUPL_VALIDATION_OBJECT" parameterType="Map" resultType="String">
        SELECT CASE WHEN STATUS_SUM &gt; 1
                         THEN '플랜트, 저장위치, 거점 [' || PLNTKY || ',' || STLKY || ',' || WAREKY || ']이/가 중복 되었습니다.'
                    ELSE ' '
               END AS VALIDATION_MSG
          FROM (
                 SELECT OWNRKY,PLNTKY,STLKY,WAREKY, SUM(STATUS) AS STATUS_SUM
                   FROM (
                          SELECT 1 AS STATUS,OWNRKY,PLNTKY,STLKY,WAREKY FROM STLMA UNION ALL
                          ${VALIDATION_DUPL_SQL}
                        ) A
                  GROUP BY OWNRKY,PLNTKY,STLKY,WAREKY
                 HAVING SUM(STATUS) &gt; 1
               ) VALID
         WHERE ROWNUM = 1
    </select>
    
    <!-- ==================================================================================================================== -->
    <!-- 마스터관리 - 구성 - [MS01] 저장위치 :: END -->
    <!-- ==================================================================================================================== -->
    
    <!-- ==================================================================================================================== -->
    <!-- 마스터관리 - 구성 - [DT02] 문서 유형 연결 :: BEGIN -->
    <!-- ==================================================================================================================== -->
    
    <select id="DOCPG_H_LIST" parameterType="Map" resultType="DataMap">
        SELECT T1.PROGID
             , T1.CRETIM
             , T1.CREDAT
             , T1.LMOTIM
             , T1.LMODAT
             , (
                 SELECT NVL(SL.LABEL, T3.MENUNAME)
				FROM SYSLABEL SL
				WHERE SL.LABELGID = 'MENU'
				  AND SL.LANGCODE = #{LANGKY}
				  AND SL.LABELID = T1.PROGID
               ) AS PROGNM
        FROM (
            SELECT DT.PROGID
                 , MIN(TRIM(DT.LMOTIM)) KEEP(DENSE_RANK FIRST ORDER BY TRIM(DT.CREDAT) ASC, TRIM(DT.CRETIM) ASC) AS CRETIM
                 , MIN(TRIM(DT.CREDAT)) AS CREDAT
                 , MAX(DT.LMOTIM) KEEP(DENSE_RANK FIRST ORDER BY DT.LMODAT DESC, DT.LMOTIM DESC) AS LMOTIM
                 , MAX(DT.LMODAT) AS LMODAT
            FROM DOCPG DT
            GROUP BY DT.PROGID
        ) T1
          LEFT OUTER JOIN MSTMENU T3 
                       ON T3.COMPID = #{OWNRKY}
                      AND T3.MENUID = T1.PROGID
         ORDER BY T1.PROGID
    </select>
    
    <select id="DOCPG_LIST" parameterType="Map" resultType="DataMap">
        SELECT DT.PROGID
             , DT.DOCCAT
             , SZF_GET_DOCCAT_TEXT(#{LANGKY}, DT.DOCCAT) AS DOCCATNM
             , DT.DOCUTY
             , SZF_GET_DOCUTY_TEXT(#{LANGKY}, DT.DOCUTY) AS DOCUTYNM
             , DT.CREDAT
             , DT.CRETIM
             , DT.CREUSR
             , DT.LMODAT
             , DT.LMOTIM
             , DT.LMOUSR
             , DT.INDBZL
             , DT.INDARC
             , DT.UPDCHK
             , DM.SHORTX
             , DM.NUMOBJ
             , DM.TRNHTY
             , DM.SYSLOC
             , NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = DT.CREUSR),' ') AS CUSRNM
             , NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = DT.LMOUSR),' ') AS LUSRNM
        FROM DOCPG DT
          LEFT OUTER JOIN DOCTM DM
                       ON DM.DOCUTY = DT.DOCUTY
                      AND DM.DOCCAT = DT.DOCCAT
        WHERE DT.PROGID = #{PROGID} 
    </select>
    
    <insert id="DOCPG_INSERT" parameterType="Map">
        INSERT INTO DOCPG
        (
            CREDAT, CRETIM, CREUSR
          , LMODAT, LMOTIM, LMOUSR
          , INDBZL, INDARC, UPDCHK
          , PROGID -- PK_1
          , DOCCAT -- PK_2
          , DOCUTY -- PK_3
        )
        VALUES(
            TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
          , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
          , ' ', ' ', 0
          , #{PROGID} -- PK_1
          , #{DOCCAT} -- PK_2
          , #{DOCUTY} -- PK_3
        )
    </insert>
    
    <update id="DOCPG_UPDATE" parameterType="Map">
        UPDATE DOCPG
           SET LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
             , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
             , LMOUSR = #{SES_USER_ID}
             <if test="PROGID != null and PROGID != ''">, PROGID = #{PROGID}</if>
             <if test="DOCCAT != null and DOCCAT != ''">, DOCUFM = #{DOCCAT}</if>
             <if test="DOCUTY != null and DOCUTY != ''">, DEFLIN = #{DOCUTY}</if>
         WHERE 1 = 1
           AND PROGID = #{PROGID}
           AND DOCCAT = #{DOCCAT}
           AND DOCUTY = #{DOCUTY}
    </update>
    
    <delete id="DOCPG_DELETE" parameterType="Map">
        DELETE FROM DOCPG
         WHERE 1 = 1
           AND PROGID = #{PROGID}
           AND DOCCAT = #{DOCCAT}
           AND DOCUTY = #{DOCUTY}
    </delete>
    
    <select id="DOCPG_DUPL_VALIDATION_OBJECT" parameterType="Map" resultType="String">
        SELECT CASE WHEN STATUS_SUM &gt; 1
                         THEN '프로그램ID, 문서 카테고리, 문서유형 [' || PROGID || ',' || DOCCAT || ',' || DOCUTY || ']이/가 중복 되었습니다.'
                    ELSE ' '
               END AS VALIDATION_MSG
          FROM (
                 SELECT PROGID, DOCCAT, DOCUTY, SUM(STATUS) AS STATUS_SUM
                   FROM (
                          SELECT 1 AS STATUS, PROGID, DOCCAT, DOCUTY FROM DOCPG UNION ALL
                          ${VALIDATION_DUPL_SQL}
                        ) A
                  GROUP BY PROGID, DOCCAT, DOCUTY
                 HAVING SUM(STATUS) &gt; 1
                  <!-- ORDER BY DOCCAT  -->
               ) VALID
         WHERE ROWNUM=1
    </select>
     
     
    <select id="DT02_PROGNM_MAP" parameterType="Map" resultType="DataMap">
        SELECT MTM.COMPID
		     , MTM.MENUID
		     , NVL(SL.LABEL, MM.MENUNAME) AS MENUNAME
		     , MTM.SORTORDER 
		FROM MSTMENU MTM
		  LEFT OUTER JOIN MSTMENU MM ON MM.MENUID=MTM.MENUID
		  LEFT OUTER JOIN SYSLABEL SL 
		               ON SL.LABELGID = 'MENU'
				      AND SL.LANGCODE = #{LANGKY}
				      AND SL.LABELID = MTM.MENUID
		WHERE 1=1
		  AND MTM.COMPID = #{OWNRKY}
		  AND MTM.MENUID = #{PROGID}
    </select>
    
    <select id="DT02_PROGNM_MAP_20220404" parameterType="Map" resultType="DataMap">
        SELECT MGL.COMPID
		     , MGL.MENUGID
		     , MGL.MENUID
		     , NVL(JM.LBLTXL, MM.MENUNAME) AS MENUNAME
		     , MGL.SORTORDER     
		FROM(
		    SELECT MG.COMPID, MG.MENUGID, MG.MENUID, MAX(MG.SORTORDER) AS SORTORDER
			FROM MSTMENUGL MG
			WHERE 1=1
			  AND MG.COMPID = #{OWNRKY}
		      AND MG.MENUGID = #{MENUKY}
		      AND MG.MENUID = #{PROGID}
		      AND EXISTS (
		                   SELECT 'X'
		                   FROM MSTMENU X
		                   WHERE X.COMPID=MG.COMPID
		                     AND X.MENUID = MG.MENUID
		                     AND X.URI IS NOT NULL
		                 )
			GROUP BY MG.COMPID, MG.MENUGID, MG.MENUID
		) MGL
		LEFT OUTER JOIN MSTMENU MM ON MM.MENUID=MGL.MENUID
		LEFT OUTER JOIN JLBLM JM ON JM.LANGKY=#{LANGKY} AND JM.LABLGR='MENU' AND JM.LABLKY=MM.MENULABEL
    </select>
    
    <select id="DT02_DOCCATNM_MAP" parameterType="Map" resultType="DataMap">
        SELECT SZF_GET_DOCCAT_TEXT(#{LANGKY}, #{DOCCAT}) AS DOCCATNM FROM DUAL
    </select>
    
    <select id="DT02_DOCUTYNM_MAP" parameterType="Map" resultType="DataMap">
        SELECT SZF_GET_DOCUTY_TEXT(#{LANGKY}, #{DOCUTY}) AS DOCUTYNM
             , DM.SHORTX
             , DM.NUMOBJ
             , DM.TRNHTY
             , DM.SYSLOC
        FROM DOCTM DM
        WHERE DM.DOCUTY = #{DOCUTY}
          AND DM.DOCCAT = #{DOCCAT}
    </select>
    
    <!-- ==================================================================================================================== -->
    <!-- 마스터관리 - 구성 - [DT02] 문서 유형 연결 :: END -->
