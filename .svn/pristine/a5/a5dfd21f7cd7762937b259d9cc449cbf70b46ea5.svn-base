<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Grid default</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<script type="text/javascript" src="/common/js/ezgencontrol.js"></script>
<%@ page import="project.common.airfw.*"%>
<link rel="stylesheet" type="text/css" href="/common/theme/webdek/css/demo_layout.css?ver=<%=dateTime%>">

<style>
	input[type="checkbox"]{height:unset;}
</style>
<script type="text/javascript">
	
	$(document).ready(function(){
		
		gridList.setGrid({
	    	id : "gridList",
			//editable : true,
			module : "WmsInbound",
			command : "GR09",
			//validation : "INDRCN,RECVKY",  //공통으로 쓰는 경우 사용
			itemGrid : "gridListSub",
			itemSearch : true
	    });
		gridList.setGrid({
	    	id : "gridListSub",
			//editable : true,
			module : "WmsInbound",
			command : "GR09Sub"
	    });
		
		initSearchArea();
		gridList.setReadOnly("gridList", true, ['INDRCN', 'COAYN']);
		gridList.setReadOnly("gridListSub", true, ['LOTA04', 'LOTA06']);
		
		/*
		playAlert = setInterval(function() {
			searchList();
		}, 60000);
		*/
	});
	
	function initSearchArea() {
	  // 플랜트
      <%if(null!=plant && plant.trim().equals("")){%>
        $('select[id="PLNTKY"]').multipleSelect('checkAll');
      <%}else{%>
        $('select[id="PLNTKY"]').multipleSelect('setSelects', ['<%=plant%>']);
      <%}%>
   	  // 입고유형
	  var $selRCPTTY = $('select[id="RCPTTY"]');
	  $selRCPTTY.multipleSelect('checkAll');
      //$('select[id="SKUL01"]').val("");
    }
	
	function commonBtnClick(btnName){
		if(btnName == "Search"){
			searchList();
		}else if(btnName == "Wcancle"){
			deleteData();
		}else if(btnName == "Print"){
			printList();
		}else if(btnName == "IPrint"){
			IprintList();	
		}else if(btnName == "Ptldle"){
			setDeadLine();
		}else if(btnName == "Ptldlecel"){
			setDeadLineCancel();
		}
	}
	
	function searchList(){
		if(validate.check("searchArea")){
			var param = inputList.setRangeParam("searchArea");
			param.put("PROGID", configData.MENU_ID);
			
			//ksa
			//console.log("ksa");
			//console.log(param);
			
			gridList.resetGrid("gridList");
			gridList.resetGrid("gridListSub");
			
			gridList.gridList({
		    	id : "gridList",
		    	param : param,
		    });
		}
	
		gridList.setReadOnly("gridListSub", true, ['LOTA06']);
	}
	
	function getItemSearchParam(rowNum){
		var rowData = gridList.getRowData("gridList", rowNum);
	    var param = inputList.setRangeParam("searchArea");
	    param.putAll(rowData);
	    
	    return param;
	}
	
	function gridListEventItemGridSearch(gridId, rowNum, itemGridList){
		if(gridId == "gridList"){
	        var param = getItemSearchParam(rowNum);
	        param.put("LANGKY", "<%=langky%>");
	        gridList.gridList({
	           id : "gridListSub",
	           param : param
	        });
		}
	}
	
	function gridListEventRowClick(gridId, rowNum, colName){
        if(gridId == "gridList"){
        
            if(colName=="FILEPOP01"||colName=="FILEPOP02"){
                popGrFile(gridId, rowNum, colName);
            }
            
        }
    }
	
	function gridListEventRowDblclick(gridId, rowNum, colName, colValue){
		if(gridId == "gridList"){
			
		}
	}
		
	function gridExcelDownloadEventBefore(gridId){
		
		var param = new DataMap();
		
		if(gridId == "gridList"){
			var param = inputList.setRangeParam("searchArea");
			param.put("dataGridExcel", "입고내역_리스트");
		}else if(gridId == "gridListSub"){
			 var rowNum = gridList.getSearchRowNum("gridList");
			 if(rowNum == -1){
				 return false;
			 }else{
				 var param = getItemSearchParam(rowNum);
			 }
			 param.put("dataGridExcel", "입고내역_상세_리스트");
		}
		
		return param;
	}
	
	function popGrFile(gridId, rowNum, colName){
        var rowData = gridList.getRowData(gridId, rowNum);
        page.linkPopOpen("/wms/inbound/GRFILEPOP.page", rowData);
    }
	
	function printList(){
		var list = gridList.getSelectData("gridList");
		var Sublist = gridList.getSelectData("gridListSub");
		
		if (list.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		} 
		
		var param = new DataMap();
		param.put("list",list);
		param.put("columnList", "WAREKY,RECVKY");
		param.put("PRTTYP","RCP_LB");
		param.put("OWNRKY", "<%=ownrky%>");
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		
		var url = "Receipt_GR09_Label_Print.ezg?ver=0.19";
		var where =   "AND RI.RECVKY IN (" ;
		var where2 =   "AND RI.AR_NO IN (" ;		
		var orderby = "";
		var language = "<%=langky%>";
		var map = new DataMap();
		var query = "";
		var query2 = "SELECT 0   AS PRINT_CNT, " +
						        "' ' AS WRECVIT, " +
						        "' ' AS WRECVKY " +
						 "FROM   DUAL"; ;
		//var query3 = "";
		var Keywareky  = "";
		var skug05 = "";
		var ARNO = "";
		var keySkug05 = "";
		var ownrky = "<%=ownrky%>";
		var recvky = "(";
		var frecvky = "";
		var ebeln = "(";
		for(var j=0; j<Sublist.length; j++){
			var row = Sublist[j];
			var RECVKY = row.get("RECVKY");
			var RECVIT = row.get("RECVIT");
			var QTDPRT = row.get("QTDPRT");
			
			if(list.length >= 1){
				query2 += "\n UNION ALL \n SELECT LEVEL AS PRINT_CNT, '" + RECVIT + "' AS WRECVIT, '" + RECVKY + "' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '" + QTDPRT +"'";
			}
			frecvky = RECVKY;
		}
		
		for(var i=0; i<list.length; i++){
			var row = list[i];
			var RECVKY = row.get("RECVKY");
			var WAREKY = row.get("WAREKY");
			var SEBELN = row.get("SEBELN");
			
			var param2 = new DataMap();
			
			param2.put("RECVKY",RECVKY);
			var json = netUtil.sendData({
				module : "WmsInbound",
				command : "SKUG05val",
				sendType : "map",
				param : param2
			});
			
			var json2 = netUtil.sendData({
				module : "WmsInbound",
				command : "Arnoval",
				sendType : "map",
				param : param2
			});
			
			skug05 = json.data["FLG"];
			ARNO = json2.data["ARNO"];
			
			if(i==0){
				keySkug05 = json.data["FLG"];
			}
			if(keySkug05!=skug05){
				commonUtil.msgBox("VALID_M2098"); // 같은 제품군의 상품만 출력이 가능합니다.
				return false;
			}
			
			if(list.length == 1){
				if(Sublist.length > 0){
					query += "SELECT LEVEL AS PRINT_CNT, ' ' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '1'";
				}else{
					query += "SELECT LEVEL AS PRINT_CNT, '" + RECVKY + "' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '1'";
				}
				recvky += "'" + RECVKY +"'";
				where += "'" + RECVKY +"'"; 
				ebeln += "'" + SEBELN +"'";
			}else if(list.length > 1){
				if(frecvky == RECVKY){
					if(i>0){
						where += ", ";
						ebeln += ", ";
						recvky += ", ";
						query += "\n UNION ALL \n";
					}
					where += "'" + RECVKY +"'"; 
					ebeln += "'" + SEBELN +"'";
					recvky += "'" + RECVKY +"'";
					query += "SELECT LEVEL AS PRINT_CNT, ' ' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '1'";
				}else{
					if(i>0){
						where += ", ";
						ebeln += ", ";						
						recvky += ", ";
						query += "\n UNION ALL \n";
					}
					where += "'" + RECVKY +"'";
					ebeln += "'" + SEBELN +"'";
					recvky += "'" + RECVKY +"'";
					query += "SELECT LEVEL AS PRINT_CNT, '" + RECVKY + "' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '1'";
				}
			}

		}
		recvky += " )";
		ebeln += " )";
		
		where += ") AND RH.WAREKY = '"+ WAREKY + "' AND RH.OWNRKY = '" + ownrky +"' ";
		where2 += ") AND RH.WAREKY = '"+ WAREKY + "' AND RH.OWNRKY = '" + ownrky +"' ";
		map.put("i_query", query);
		map.put("i_query2", query2);
		var width = '850';
		var height = '680';
		map.put("WAREKY", Keywareky);
		map.put("RECVKY", recvky);
		map.put("OWNRKY", "<%=ownrky%>");
		map.put("EBELN", ebeln);
		
		WriteEZgenElement(url, where, orderby, language, map, width, height);
	}
	
	function IprintList(){
		var list = gridList.getSelectData("gridList");
		var Sublist = gridList.getSelectData("gridListSub");
		
		if (list.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		} 
		
		var param = new DataMap();
		param.put("list",list);
		param.put("columnList", "WAREKY,RECVKY");
		param.put("PRTTYP","RCP_LB");
		param.put("OWNRKY", "<%=ownrky%>");
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		
		var url = "자재입고라벨GR09.ezg?ver=0.11";
		var where =   "AND RI.RECVKY IN (" ;
		var where2 =   "AND RI.AR_NO IN (" ;	
		var orderby = "";
		var language = "<%=langky%>";
		var map = new DataMap();
		var query = "";
		var query2 = "SELECT 0   AS PRINT_CNT, " +
						        "' ' AS WRECVIT, " +
						        "' ' AS WRECVKY " +
						 "FROM   DUAL"; ;
		//var query3 = "";
		var Keywareky  = "";
		var skug05 = "";
		var ownrky = "<%=ownrky%>";
		var recvky = "(";
		var frecvky = "";
		var ebeln = "(";
		
		for(var j=0; j<Sublist.length; j++){
			var row = Sublist[j];
			var RECVKY = row.get("RECVKY");
			var RECVIT = row.get("RECVIT");
			var QTDPRT = row.get("QTDPRT");
			
			query2 += "\n UNION ALL \n SELECT LEVEL AS PRINT_CNT, '" + RECVIT + "' AS WRECVIT, '" + RECVKY + "' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '" + QTDPRT +"'";

			frecvky = RECVKY;
		}
		
		for(var i=0; i<list.length; i++){
			var row = list[i];
			var RECVKY = row.get("RECVKY");
			var WAREKY = row.get("WAREKY");
			var SEBELN = row.get("SEBELN");
			
			var param2 = new DataMap();
			
			param2.put("RECVKY",RECVKY);
			var json = netUtil.sendData({
				module : "WmsInbound",
				command : "SKUG05Check",
				sendType : "map",
				param : param2
			});
			
			var json2 = netUtil.sendData({
				module : "WmsInbound",
				command : "Arnoval",
				sendType : "map",
				param : param2
			});
			
			skug05 = json.data["FLG"];
			ARNO = json2.data["ARNO"];
			
			if(skug05 != "OT"){
				commonUtil.msgBox("VALID_M2111");// 제품군이 자재인것만 출력이 가능합니다.
				return false;
			}
			
			if(list.length == 1){
				if(Sublist.length > 0){
					query += "SELECT LEVEL AS PRINT_CNT, ' ' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '1'";
				}else{
					query += "SELECT LEVEL AS PRINT_CNT, '" + RECVKY + "' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '1'";
				}
				recvky += "'" + RECVKY +"'";
				where += "'" + RECVKY +"'"; 
				ebeln += "'" + SEBELN +"'";
			}else if(list.length > 1){
				if(frecvky == RECVKY){
					if(i>0){
						where += ", ";
						ebeln += ", ";
						recvky += ", ";
						query += "\n UNION ALL \n";
					}
					where += "'" + RECVKY +"'"; 
					ebeln += "'" + SEBELN +"'";
					recvky += "'" + RECVKY +"'";
					query += "SELECT LEVEL AS PRINT_CNT, ' ' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '1'";
				}else{
					if(i>0){
						where += ", ";
						ebeln += ", ";						
						recvky += ", ";
						query += "\n UNION ALL \n";
					}
					where += "'" + RECVKY +"'";
					ebeln += "'" + SEBELN +"'";
					recvky += "'" + RECVKY +"'";
					query += "SELECT LEVEL AS PRINT_CNT, '" + RECVKY + "' AS WRECVKY FROM DUAL CONNECT BY LEVEL &lt;= '1'";
				}
			}
		}
		recvky += " )";
		ebeln += " )";
		
		where += ") AND RH.WAREKY = '"+ WAREKY + "' AND RH.OWNRKY = '" + ownrky +"' ";
		where2 += ") AND RH.WAREKY = '"+ WAREKY + "' AND RH.OWNRKY = '" + ownrky +"' ";
		map.put("i_query", query);
		map.put("i_query2", query2);
		var width = '850';
		var height = '680';
		map.put("WAREKY", Keywareky);
		map.put("RECVKY", recvky);
		map.put("OWNRKY", "<%=ownrky%>");
		map.put("EBELN", ebeln);
		
		WriteEZgenElement(url, where, orderby, language, map, width, height);
	}
	
	function deleteData(){
		
		var head = gridList.getSelectData("gridList");
		var list = gridList.getSelectData("gridListSub");
		
		var itemGrdViewYn = gridList.getItemGridViewCheck("gridList");
		
		if(itemGrdViewYn && list.length == 0){
			//commonUtil.msgBox("VALID_M2067");// 선택된 아이템이 없습니다.
			//return;
		}
		
		if(head.length==0){
			commonUtil.msgBox("VALID_M2061");// 현재 진행중인 데이터의 헤더 체크박스를 선택하여주세요.
			return;
		}
		
		var headRecvky = "";
		
		/*
		// 헤더단위로만 입고 취소 가능함.SAP에서 아이템별로 안받음.
		if(itemGrdViewYn){
			var rowNum = gridList.getFocusRowNum("gridList")
			headRecvky = gridList.getColData("gridList", rowNum, "RECVKY");			
		}
		*/
		var RECVKY = "";
		var SEBELN = "";
		// 헤더 취소여부 확인
		for(var i=0;i<head.length;i++){
			
			var rowData = head[i];
			var rowNum = rowData.get("GRowNum");
			var STATDO = rowData.get("STATDO");
			var INDRCN = rowData.get("INDRCN");
			var RCPTTY = rowData.get("RCPTTY");
			
			if(i==0){
				RECVKY = rowData.get("RECVKY");
			}
			
			if(i==0 || SEBELN=="" ){
				SEBELN = rowData.get("SEBELN");
			}
			
			if( $.trim(INDRCN)!="" || STATDO=="RCN" ){
				gridList.setColFocus("gridList", rowNum, "rowCheck");
				commonUtil.msgBox("MASTER_M0690", [rowData.get("RECVKY")]); // 입고문서번호 {0}은 이미 입고취소가 되었습니다.
				return;
			}
			
			var DLEFLG = rowData.get("DLEFLG"); // 구매포탈 마감여부
        	if(DLEFLG=="Y"){
        		gridList.setColFocus("gridList", rowNum, "rowCheck");
        		commonUtil.msgBox("VALID_M0961", [rowData.get("RECVKY")]); // [{0}]마감된 문서는 입고 취소 할 수 없습니다.
        		return;
        	}
			
			if(RCPTTY=="114"){
				gridList.setColFocus("gridList", rowNum, "rowCheck");
        		//commonUtil.msgBox("VALID_M0962"); // 고지 입고는 입고 취소 할 수없습니다.
        		commonUtil.msgBox("VALID_M2123", [rowData.get("RECVKY")]); // [{0}]고지 입고는 입고 취소 할 수없습니다.
        		return;
			}
        	
		}
		
		// 아이템 취소여부 확인
		for(var i=0;i<list.length;i++){
			
			var rowData = list[i];
			var rowNum = rowData.get("GRowNum");
			var STATIT = rowData.get("STATIT");
			var INDRCN = rowData.get("INDRCN");
			
			if( $.trim(INDRCN)!="" || STATIT=="FCV" ){
				commonUtil.msgBox("MASTER_M0690");
				gridList.setColFocus("gridListSub", rowNum, "rowCheck");
				return;
			}
			
		}
		
		var vparam = new DataMap();
		//vparam.put("list", head);
		//vparam.put("key", "RECVKY,INDRCN");
		vparam.put("OWNRKY", "<%=ownrky%>");
		vparam.put("head", head);
		vparam.put("list", list);
		vparam.put("headRecvky", headRecvky);
		
		var json = netUtil.sendData({
			url : "/wms/inbound/json/validationGR09.data",
			param : vparam
		});
		//console.log("json : " + JSON.stringify(json));
		if(json.data != "OK"){
			var msgList = json.data.split(" ");
			var msgParam = new Array();
			if(msgList.length > 1){
				for(var i=1;i<msgList.length;i++){
					msgParam.push(msgList[i]);
				}
			}
			//var msgTxt = commonUtil.getMsg(msgList[0], msgList.pop());
			var msgTxt = commonUtil.getMsg(msgList[0], msgParam);
			commonUtil.msg(msgTxt);
			return false;
		}
		
		if(!commonUtil.msgConfirm("VALID_M2104",[SEBELN,(head.length-1)])){ // 입고문서[{0}] 외 [{1}] 건 전체 취소 합니다. 입고 취소하시겠습니까?
			return;
		}
		
		var param = new DataMap();
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("head", head);
		param.put("list", list);
		param.put("headRecvky", headRecvky);
		param.put("PROGID", configData.MENU_ID);
		
		param.put("headList", head);
		param.put("messageOption", {
            total_count : param.map.headList.length,
            current_count : 1,
            message   : commonUtil.getMsg("IN_M0154")//"입고 취소 진행중입니다."
        })
        
        sucCount = 0;
        errCount = 0;
        msgHtml = "";
		var json = sendDelete(param);
		
	}
	
	var sucCount = 0;
    var errCount = 0;
    var msgHtml = "";
    // 20220907 저장방식 변경됨.
	function sendDelete(param, recall){
        
		var current_count = param.map.messageOption.current_count;
		var total_count = param.map.messageOption.total_count;
		
    	if(total_count == 1){
    		sucCount = 0; 
    	    errCount = 0;
    	    msgHtml = "";
    	}
		
		if(param.map.messageOption){
        	netUtil.processMessage(param);
	    }
		
		var loopHeadList = new Array();
		loopHeadList.push(param.map.headList[current_count-1]);
		param.put("head", loopHeadList);
		
        var json;
		
        setTimeout(function(){
        	json = netUtil.sendData({
                url : "/wms/inbound/json/deleteGR09New.data",
                param : param,
                async : true,       // 응답없는 메시지 제거를위해 비동기 처리
                loading : true,     // 전체완료될때까지 로딩 유지
                recall : recall,    // 로딩이미지 적용을위해 재귀호출시 필요
                callBackFunction : function(returnData){
                	
                	var inRsCode = returnData.data.inRsCode; // 입고저장 결과코드
                    var inRsMsg = returnData.data.inRsMsg;   // 입고저장 결과 메시지
    				
    				var ifRsCode = returnData.data.ifRsCode; // 인터페이스 전송 결과코드
                    var ifRsMsg = returnData.data.ifRsMsg;   // 인터페이스 전송 결과 메시지
                    
                    var totCnt = returnData.data.totCnt;     // 입고 전체 건수
                    var sucCnt = returnData.data.sucCnt;     // 입고 성공 건수
                    var failCnt = returnData.data.failCnt;   // 입고 실패 건수
                    
                    console.log("전체 : " + totCnt + " - 성공 : " + sucCnt + " - 실패 : " + failCnt);
                	console.log("inRsCode : " + inRsCode);
                	console.log("ifRsCode : " + ifRsCode);
                	console.log("inRsMsg : " + inRsMsg);
                	console.log("ifRsMsg : " + ifRsMsg);
                	//console.log("sucList : " + sucList);
                	
                	if(inRsCode != "S" && ifRsCode != "S"){
                		msgHtml += "\n" + inRsMsg + "" + ifRsMsg;
                		errCount++;
                	}else if(inRsCode != "S"){
                    	msgHtml += "\n" + inRsMsg;
                    	errCount++;
                	}else if(ifRsCode != "S"){
                    	msgHtml += "\n" + ifRsMsg;
                    	errCount++;
                    }else{
                    	sucCount++;
                    }
                	
                	if(total_count > current_count){
                		sendDelete(param, true);
                    }else{
                    	netUtil.processMessageOff();
                        commonUtil.msgBox("실패:"+errCount +", 성공:"+sucCount+msgHtml); //관리자에게 문의 바랍니다.
                        
                    	searchList();
                    }
                }
            });
        }, 100);
    }
	
	function saveRsReadonly(sucList,chkHeadList,headSebeln){
		
		if(sucList!=undefined && sucList.length > 0){
    		// 완료된 데이터 잠금
    		for(i=0;i<sucList.length;i++){
    			var sucRow = sucList[i];
    			var recvky = sucRow.RECVKY; 
    			//console.log(i + " - sucList - recvky : " + recvky + " - chkHeadList.length : " + chkHeadList.length);
    			
    			for(var j=0;j<chkHeadList.length;j++){
                	var rowData = chkHeadList[j];
                	var rowNum = rowData.get("GRowNum");
                	var hRecvky = rowData.get("RECVKY");
                	//console.log(j + " - chkHeadList - hSebeln : " + hSebeln);
                    if(recvky==hRecvky){
                    	//console.log(j + " - chkHeadList matching - hSebeln : " + hSebeln);
                    	gridList.setRowCheck("gridList", rowNum, false);
                    	gridList.setColValue("gridList", rowNum, "STATDO", "FRV");
                    	gridList.setColValue("gridList", rowNum, "STATDONM", "입고완료");
                    	gridList.setRowReadOnly("gridList", rowNum, true, ['rowCheck',"DOCDAT","DOCTXT"]);
                    	gridList.setRowState("gridList", configData.GRID_ROW_STATE_READ, rowNum) ;
                    	gridList.reloadAll("gridList");
                    	
                    	if(headSebeln!="" && headSebeln==hSebeln){
                    		gridList.resetGrid("gridListSub");
                    		gridList.resetGrid("gridConfirmList");
                    		gridListEventItemGridSearch("gridList", rowNum);
                    	}
                    	
                    	break;
                    }
                }
    			
    		}
    		
    	}
		
	}
		
	function gridListEventDataBindEnd(gridId, dataLength){
		if(gridId == "gridList" && dataLength > 0){
			var dataList = gridList.getGridData(gridId);
			var rowData;
		}
	}
	
	function getRsnComboList(DOCUTY){
		
		var param = new DataMap();
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("DOCUTY", DOCUTY);
		var json = netUtil.sendData({
			module : "WmsInbound",
			command : "GR09RSNCODCOMBO",
			sendType : "list",
			param : param
		});
		var optionHtml = inputList.selectHtml(json.data, true);
		
		return optionHtml;
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType){
		var param = new DataMap();
		if(searchCode == "SHSTLMAP"){
			var PLNTKY = $('select[id="PLNTKY"]').val();
        	param.put("LANGKY", "<%=langky%>");
            param.put("OWNRKY", "<%=ownrky%>");
            param.put("WAREKY", "<%=wareky%>");
            param.put("PLNTKY", PLNTKY);
            if(PLNTKY==null || $.trim(PLNTKY)==""){
            	return false;
            }
            return param;
		}
	}
	
	function comboEventDataBindeBefore(comboAtt){
		
		if(comboAtt == "WmsOrder,RCPTTYCOMBO"){
			var param = new DataMap();
			param.put("DOCCAT", "100");
			param.put("PROGID", configData.MENU_ID);
			return param;
		}else if(comboAtt == "Wms,PLNTKYCOMBO"){
			var param = new DataMap();
			
			//var WAREKY_LIST = ['<%= wareky%>'];
			//param.put("WAREKY_LIST", WAREKY_LIST);
			
			var WAREKYS = "'<%= wareky%>'";
			param.put("WAREKYS", WAREKYS);
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
			
			return param;
		}
		
	}
	
	function setDeadLine(){

		var gridId = "gridList";
		var headChkLen = gridList.getSelectRowNumList(gridId).length;
		if(headChkLen == 0){
			commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
			return;
		}
		
		var sebeln = "";
		
		var chkHeadList = gridList.getSelectData(gridId);
		for(var i=0;i<chkHeadList.length;i++){
			var rowData = chkHeadList[i];
			var rowNum = rowData.get("GRowNum");
			
			var rcptty = rowData.get("RCPTTY");
			var dleflg = rowData.get("DLEFLG");
			
			if(rcptty!="111"){
			    gridList.setColFocus(gridId, rowNum, "rowCheck");
				var STD_PTLDLE = commonLabel.getLabel("STD_PTLDLE", 1);
				commonUtil.msgBox("VALID_M0957",[STD_PTLDLE]); // [{0}]은(는) 구매입고만 가능합니다.
			    return;
			}
			
			if(dleflg == "Y"){
				gridList.setColFocus(gridId, rowNum, "rowCheck");
				var STD_PTLDLE = commonLabel.getLabel("STD_PTLDLE", 1);
				commonUtil.msgBox("VALID_M0958",[STD_PTLDLE]); // 이미 마감한 문서는 마감 할 수 없습니다.
			    return;
			}
			
			if(i==0){
				sebeln = rowData.get("SEBELN");
			}
			
		}
		
		// [{0}] 외 [{1}]건 오더단위로 마감 됩니다.마감하시겠습니까?
		if(!commonUtil.msgConfirm("VALID_M2107",[sebeln,(chkHeadList.length-1)])){
			return;
		}
		
		var param = new DataMap();
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("head", chkHeadList);
		
		var json = netUtil.sendData({
			url : "/wms/inbound/json/deadlineGR02.data",
			param : param
		});
		
		if(json.data && json.data.RESULTMSG ){
			var msgList = json.data.RESULTMSG.split("†");
			var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
			commonUtil.msg(msgTxt);
			return;
		}
		
		if(json && json.data){
			commonUtil.msgBox("VALID_M0968"); // 마감이 완료되었습니다.
			
			gridList.resetGrid("gridList");
			gridList.resetGrid("gridListSub");
			searchList();
		}

	}
	
	
	function setDeadLineCancel(){

		var gridId = "gridList";
		var headChkLen = gridList.getSelectRowNumList(gridId).length;
		if(headChkLen == 0){
			commonUtil.msgBox("VALID_M0006");// 선택된 아이템이 없습니다.
			return;
		}
		
		var sebeln = "";
		
		var chkHeadList = gridList.getSelectData(gridId);
		for(var i=0;i<chkHeadList.length;i++){
			var rowData = chkHeadList[i];
			var rowNum = rowData.get("GRowNum");
			
			var rcptty = rowData.get("RCPTTY");
			var dleflg = rowData.get("DLEFLG");
			
			if(rcptty!="111"){
			    gridList.setColFocus(gridId, rowNum, "rowCheck");
				var STD_PTLDLE = commonLabel.getLabel("STD_PTLDLE", 1);
				commonUtil.msgBox("VALID_M0957",[STD_PTLDLE]); // [{0}]은(는) 구매입고만 가능합니다.
			    return;
			}
			
			if(dleflg != "Y"){
				gridList.setColFocus(gridId, rowNum, "rowCheck");
				commonUtil.msgBox("VALID_M0959"); // 마감된 문서만 취소 할 수 있습니다.
			    return;
			}
			
			if(i==0){
				sebeln = rowData.get("SEBELN");
			}
			
		}
		/*
		// 마감취소하시겠습니까?
		if(!commonUtil.msgConfirm("VALID_M0969")){
			return;
		}
		*/
		// [{0}] 외 [{1}]건 오더단위로 마감 취소됩니다.마감취소하시겠습니까?
		if(!commonUtil.msgConfirm("VALID_M2108",[sebeln,(chkHeadList.length-1)])){
			return;
		}
		
		var param = new DataMap();
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("head", chkHeadList);
		
		var json = netUtil.sendData({
			url : "/wms/inbound/json/deadlineCancelGR02.data",
			param : param
		});
		
		if(json.data && json.data.RESULTMSG ){
			var msgList = json.data.RESULTMSG.split("†");
			var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
			commonUtil.msg(msgTxt);
			return;
		}
		
		if(json && json.data){
			commonUtil.msgBox("VALID_M0970"); // 마감취소가 완료되었습니다.
			
			gridList.resetGrid("gridList");
			gridList.resetGrid("gridListSub");
			searchList();
		}

	}
	
</script>
</head>
