	@Transactional(rollbackFor = Exception.class)
	public DataMap PDPK05DETAIL02_DELETE(DataMap map) throws Exception {				
			
			DataMap rsMap = new DataMap();
			
			SimpleDateFormat fmDate = new SimpleDateFormat("yyyyMMdd", Locale.KOREA);
			String date = fmDate.format(new Date());
			SimpleDateFormat fmTime = new SimpleDateFormat("HHmmss", Locale.KOREA);
			String time = fmTime.format(new Date());
			
			map.put("OWNRKY", map.get(CommonConfig.SES_USER_OWNER_KEY));
			
			String MSG = "FAIL";
			String USER = map.getString(CommonConfig.SES_USER_ID_KEY);
						
			String STKNUM = map.getString("STKNUM");
			String SKUKEY = map.getString("SKUKEY");
			String WAREKY = map.getString("WAREKY");
			String DPTNKY = map.getString("DPTNKY");
			String LOCAKY = map.getString("LOCAKY");
			String BARCOD = map.getString("BARCOD");
			String LOTA07 = map.getString("LOTA07");
			
			int SUCESS_CCOUNT = 0;
			
			List<DataMap> taskinfo; 
			List<DataMap> taskAllinfo;
			List<DataMap> shpdiInfoList;
			
			map.setModuleCommand("WmsMobileOutboundPicking_COPY", "PDPK05_DELETE_TASDI_INFO");
			
			taskinfo = commonDao.getList(map);
						
			
			
			for(DataMap tasdiMap : taskinfo) {				
				
				tasdiMap.put("OLDLOC", "V");					
				tasdiMap.put(CommonConfig.SES_USER_ID_KEY, USER);
				tasdiMap.put("STKNUM", STKNUM);
				tasdiMap.put("SKUKEY", SKUKEY);
				tasdiMap.put("LOCAKY", LOCAKY);
				tasdiMap.put("BARCOD", BARCOD);
				tasdiMap.put("WAREKY", WAREKY);
				tasdiMap.put("DPTNKY", DPTNKY);
				tasdiMap.put("LOTA07", LOTA07);
				
				if(!tasdiMap.getString("STATIT").equals("NEW")) {
					
					commonDao.getMap("WmsOutbound.CALL_PICKING_CANCEL_PROC_DL06", tasdiMap);
				}
				
				
				tasdiMap.setModuleCommand("WmsMobileOutboundPicking_COPY", "PDPK05_ALL_TASDI_INFO");
				
				taskAllinfo = commonDao.getList(tasdiMap);
				
				for(DataMap tasdiAllMap : taskAllinfo) {
					
					if(tasdiAllMap.getString("STATIT").equals("NEW") || tasdiAllMap.getString("STATIT").equals("FCN")) {
//					commonDao.delete("WmsMobileOutboundPicking_COPY.PDPK05_TASDRDEL", tasdiAllMap);
					commonDao.delete("WmsMobileOutboundPicking_COPY.PDPK05_TASDIDEL", tasdiAllMap);
					
						SUCESS_CCOUNT++;
					}
					
					if(taskAllinfo.size() == SUCESS_CCOUNT) {
						MSG = "OK";
					}
				}
				
				
			}
			
					
			
			if(!MSG.equals("OK")) {MSG = "OUT_M0255";}
					
			rsMap.put("MSG", MSG);
			
		return rsMap;
	}
	
	@Transactional
	public DataMap PDPK05StockValidation(DataMap map) throws SQLException {

		List<DataMap> head = map.getList("head");		
		List<DataMap> saveItemList = new ArrayList<DataMap>();
		List<DataMap> shpdiInfoList = new ArrayList<DataMap>();
		List<DataMap> addStkkyList = new ArrayList<DataMap>();
		DataMap rsMap = new DataMap();				
		String MSG = "FAIL";
		int diffCnt = 0;
		int ingCnt = 0;
		
		SimpleDateFormat fmDate = new SimpleDateFormat("yyyyMMdd", Locale.KOREA);
		String date = fmDate.format(new Date());
		SimpleDateFormat fmTime = new SimpleDateFormat("HHmmss", Locale.KOREA);
		String time = fmTime.format(new Date());
		
		String USER = map.getString(CommonConfig.SES_USER_ID_KEY);
		String PROGID = map.getString("PROGID");
		
