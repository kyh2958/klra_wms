	@Transactional(rollbackFor = Exception.class)
	public DataMap mtoChangeData(DataMap map) throws Exception {	
		DataMap rsMap = new DataMap();
		
		int successCnt = 0;
		List<DataMap> sapResList = new ArrayList<>();
		List<DataMap> stkList = new ArrayList<>();
		String docSeq = "";
		
		TransactionDefinition transactionDefinition = new DefaultTransactionDefinition();
		TransactionStatus transactionStatus = transactionManager.getTransaction(transactionDefinition);
		Object transactionSavepoint = transactionStatus.createSavepoint();

		String ifmsg = "";
		boolean commitFlag = true;
		try {
			
			// 재고조정(MTO&MTS 변경) 헤더 생성
			map.setModuleCommand("WmsMobileOutboundPicking_COPY", "ADJDH");
			commonDao.insert(map);

			String lota07 = "";
			String lota15 = "";
			int itemCount = 0;
			int sadjit = 0;
			double changeQty = Double.valueOf(map.getString("CHGQTY"));
			double stokkyQty = 0;
			double totalQty = 0;
			List<DataMap> ifList = new ArrayList<>();
			DataMap ifMap = null;
			DataMap logMap = null;
			
			
			String logseqno = "";
			boolean ifsendFlag = false;
			
			map.setModuleCommand("WmsMobileOutboundPicking_COPY", "selectMtoMtsStkky");
			stkList = commonDao.getList(map);
			for(DataMap dataMap : stkList) {
				if(changeQty <= 0) {
					continue;
				}

				// insertMtoMtsChange 등록하기전에 동일조건으로 MTO 조정이력 (1분이내) 존재하는경우 요청 실패처리 (기존요청 정상 처리중으로 중복재고 생성발생)
				List<DataMap> checkMtoMts = new ArrayList<>();
				dataMap.setModuleCommand("WmsMobileOutboundPicking_COPY", "checkMtoMts_IFWMS223");
				checkMtoMts = commonDao.getList(dataMap);
				
				if(checkMtoMts != null && checkMtoMts.size() > 0) {
					ifmsg = "WMS: 1분이내 동일 개별바코드의 MTO/MTS 변경 이력이 확인되어 해당요청은 종료되었습니다.";
					continue;
				}
				
				// mto정보 또는 lot번호가 달라지면 인터페이 처리
				if( !lota07.contentEquals(dataMap.getString("LOTA07")) ||
					!lota15.contentEquals(dataMap.getString("LOTA15"))	){
					
					if(!lota07.contentEquals("")) {
						commitFlag = false;
						ifMap.put("IFID","WMS_IF_402");
						ifMap.put("RETRYYN", "Y");
						ifmsg = ifservice.sendIF(ifMap);
						
						if(!ifmsg.equals("SUCCESS")) {
							
							ifmsg = "SAP : " + ifmsg;
							
							throw new Exception();
						}
						ifsendFlag = false;
					}
					
					transactionSavepoint = transactionStatus.createSavepoint();
					
					lota07 = dataMap.getString("LOTA07");
					lota15 = dataMap.getString("LOTA15");
					
					map.setModuleCommand("WmsMobileOutboundPicking_COPY", "selectLogseqno");
					logMap = commonDao.getMap(map);
					
					logseqno = logMap.getString("LOGSEQNO");
					ifsendFlag = true;
				}
				
				stokkyQty = Double.valueOf(dataMap.getString("QTSIWH"));
				
				if( changeQty >= stokkyQty) {
					dataMap.put("MTOQTY", stokkyQty);
					changeQty -= stokkyQty;
					totalQty += stokkyQty;
				}else {
					totalQty += changeQty;
					dataMap.put("MTOQTY", changeQty);
					changeQty = 0;
				}
				
				dataMap.put("SADJKY", map.getString("SADJKY") );
				dataMap.put("SADJIT", sadjit);
				dataMap.put("LOTA07_TO", map.getString("LOTA07") );

				//System.out.println(dataMap.getString("STOKKY") + "[ "+totalQty+" ] : " + dataMap.get("MTOQTY"));
				map.clonSessionData(dataMap);
				dataMap.setModuleCommand("WmsMobileOutboundPicking_COPY", "insertMtoMtsChange");
				commonDao.insert(dataMap);
				
				ifMap = dataMap;
				ifMap.put("SADJKY", map.getString("SADJKY") );
				ifMap.put("WMSDN", map.getString("SADJKY") );
				ifMap.put("LOGSEQNO", logseqno);
				ifMap.setModuleCommand("WmsMobileOutboundPicking_COPY", "insertMtoMts_IFWMS223");
				commonDao.insert(ifMap);
				
				
				sadjit += 20;
			}
			
			if(ifsendFlag) {
				commitFlag = false;
				ifMap.put("IFID","WMS_IF_402");
				ifMap.put("RETRYYN", "Y");
				ifmsg = ifservice.sendIF(ifMap);
				
				if(!ifmsg.equals("SUCCESS")) {
					
					ifmsg = "SAP : " + ifmsg;
					
					throw new Exception();
				}
			}
		} catch (Exception e) {
			transactionStatus.rollbackToSavepoint(transactionSavepoint);
			commitFlag = true;
			e.printStackTrace();
		}
		finally {
			if(commitFlag == false) {
				transactionManager.commit(transactionStatus);
			}
			rsMap.put("O_MSG", ifmsg);
		}
		return rsMap;
	}
	
	@Transactional(rollbackFor = Exception.class)
	public DataMap PDPK05DETAIL02_SAVECNT(DataMap map) throws Exception {				
			
			DataMap rsMap = new DataMap();
			
			SimpleDateFormat fmDate = new SimpleDateFormat("yyyyMMdd", Locale.KOREA);
			String date = fmDate.format(new Date());
			SimpleDateFormat fmTime = new SimpleDateFormat("HHmmss", Locale.KOREA);
			String time = fmTime.format(new Date());
			
			map.put("OWNRKY", map.get(CommonConfig.SES_USER_OWNER_KEY));
			
			String MSG = "FAIL";
			String USER = map.getString(CommonConfig.SES_USER_ID_KEY);
			String PROGID = map.getString("PROGID");
						
			String STKNUM = map.getString("STKNUM");
			String SKUKEY = map.getString("SKUKEY");
			String WAREKY = map.getString("WAREKY");
			String LOCAKY = map.getString("LOCAKY");
			String DPTNKY = map.getString("DPTNKY");
			String BARCOD = map.getString("BARCOD");
			String QTSPUT = map.getString("QTSPUT");
			String LOTA07 = map.getString("LOTA07");
			String ROW_QTCOMP = map.getString("ROW_QTCOMP");
			
			List<DataMap> taskinfo; 
			List<DataMap> taskAllinfo;
			List<DataMap> shpdiInfoList;
			
			map.setModuleCommand("WmsMobileOutboundPicking_COPY", "PDPK05_TASDI_INFO");
			
			taskinfo = commonDao.getList(map);
			
			double TOT_USEQTY = Double.parseDouble(QTSPUT.replace(",", ""));
			
			
			
			for(DataMap tasdiMap : taskinfo) {				
				
				tasdiMap.put("OLDLOC", "V");					
				tasdiMap.put(CommonConfig.SES_USER_ID_KEY, USER);
				tasdiMap.put("STKNUM", STKNUM);
				tasdiMap.put("SKUKEY", SKUKEY);
				tasdiMap.put("LOCAKY", LOCAKY);
				tasdiMap.put("BARCOD", BARCOD);
				tasdiMap.put("WAREKY", WAREKY);
				tasdiMap.put("DPTNKY", DPTNKY);
				tasdiMap.put("LOTA07", LOTA07);
				
				if(!tasdiMap.getString("STATIT").equals("NEW")) {
					
					commonDao.getMap("WmsOutbound.CALL_PICKING_CANCEL_PROC_DL06", tasdiMap);
				}
				
				
				tasdiMap.setModuleCommand("WmsMobileOutboundPicking_COPY", "PDPK05_ALL_TASDI_INFO");
				
				taskAllinfo = commonDao.getList(tasdiMap);
				
				for(DataMap tasdiAllMap : taskAllinfo) {
					
					if(tasdiAllMap.getString("STATIT").equals("NEW")) {
//					commonDao.delete("WmsMobileOutboundPicking_COPY.PDPK05_TASDRDEL", tasdiAllMap);
					commonDao.delete("WmsMobileOutboundPicking_COPY.PDPK05_TASDIDEL", tasdiAllMap);
					}
					
					
					
				}
			}
			
			// 재고 셀렉트 
			map.setModuleCommand("WmsMobileOutboundPicking_COPY","MANUALALLOCATE_AVAILABLE_STOCK2");
			List<DataMap> stockMapList = commonDao.getList(map);
			
			if(stockMapList != null) {
				
				
				
				
				for(int i=0; i<stockMapList.size(); i++) {
					
					double menuQTCOMP=0;
					
					double STKKY_USEQTY = Double.parseDouble(stockMapList.get(i).getString("USEQTY").replace(",", ""));					
					double TASDI_QTCOMP = 0;
					
					
					if(STKKY_USEQTY <= 0) {continue;}
					if(TOT_USEQTY <= 0) {continue;}
					
					//할당할 출하정보 조회 
				    map.setModuleCommand("WmsMobileOutboundPicking_COPY", "PDPK05_COPY_SHPDI_INFO");
					shpdiInfoList = commonDao.getList(map);
									
					for(int j=0; j<shpdiInfoList.size(); j++) {															
												
						if(!stockMapList.get(i).getString("LOTA01").equals(shpdiInfoList.get(j).getString("LOTA01")) ||   
						   !stockMapList.get(i).getString("LOTA02").equals(shpdiInfoList.get(j).getString("LOTA02")) ||
						   !stockMapList.get(i).getString("LOTA07").equals(shpdiInfoList.get(j).getString("LOTA07"))) {  	
							continue;
						}
							
						
						double SHPDI_NEED = Double.parseDouble(shpdiInfoList.get(j).getString("NEEDQTY").replace(",", ""));															
						
						if(TOT_USEQTY <= 0 && j != 0 || SHPDI_NEED == 0) {continue;}
						
						if(STKKY_USEQTY < SHPDI_NEED && TOT_USEQTY == STKKY_USEQTY) {
							
							TASDI_QTCOMP = STKKY_USEQTY;
							
						}else if(STKKY_USEQTY > SHPDI_NEED) {
							
							TASDI_QTCOMP = SHPDI_NEED;
						}else if(STKKY_USEQTY < TOT_USEQTY){
							TASDI_QTCOMP = STKKY_USEQTY;
						}else {
							TASDI_QTCOMP = TOT_USEQTY;
						}
						
						TOT_USEQTY -= TASDI_QTCOMP;
						TOT_USEQTY = Math.round(TOT_USEQTY * 1000) / 1000.0;
						STKKY_USEQTY -= TASDI_QTCOMP;
						
						menuQTCOMP += TASDI_QTCOMP;
						
						
						if(TASDI_QTCOMP <= 0) {continue;}
						
						DataMap shpdiRow = shpdiInfoList.get(j);
						
						
						
