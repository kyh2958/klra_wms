					tasdiRow.put("CREUSR", USER);
					tasdiRow.put("LMODAT", date);
					tasdiRow.put("LMOTIM", time);
					tasdiRow.put("LMOUSR", USER);
					tasdiRow.put("INDBZL", " ");
					tasdiRow.put("INDARC", " ");
					tasdiRow.put("UPDCHK", "0");
					tasdiRow.put(CommonConfig.SES_USER_ID_KEY, USER);
	
					//TASDI 생성
					tasdiRow.setModuleCommand("WmsOutbound", "TASDI"); 
					commonDao.insert(tasdiRow);
					
					//TASDR 생성
					tasdiRow.put("STOKKY", stockMapList.get(i).get("STOKKY"));				
					commonDao.getMap("WmsTask.DBMSPROC_SZP_INS_TASDR", tasdiRow);		

					//지정피킹 FLAG
					DataMap appointMap = new DataMap();
					appointMap.put("SHPOKY", shpdiInfoList.get(j).getString("SHPOKY"));
					appointMap.put("SHPOIT", shpdiInfoList.get(j).getString("SHPOIT"));
					appointMap.put("SKUKEY", shpdiInfoList.get(j).getString("SKUKEY"));
					commonDao.update("WmsMobileOutboundPicking_COPY.APPOINTPICKINGFLAG", appointMap);	
				}
				
				if(menuQTCOMP > 0) {
					stockMapList.get(i).put("QTCOMP", menuQTCOMP);
					double ratio =  Double.valueOf(Double.parseDouble(stockMapList.get(i).getString("USEQTY")) / Double.parseDouble(stockMapList.get(i).getString("QTJCMPBOX")));
					
					DataMap snedMap = new DataMap(); 
					snedMap.put("QTCOMP", stockMapList.get(i).get("QTCOMP"));
					snedMap.put("LOCAKY", stockMapList.get(i).get("LOCAKY"));
					snedMap.put("LOTA01", stockMapList.get(i).get("LOTA01"));
					snedMap.put("LOTA02", stockMapList.get(i).get("LOTA02"));
					snedMap.put("LOTA04", stockMapList.get(i).get("LOTA04"));
					snedMap.put("LOTA07", stockMapList.get(i).get("LOTA07"));
					snedMap.put("LOTA14", stockMapList.get(i).get("LOTA14"));
					snedMap.put("LOTA11", stockMapList.get(i).get("LOTA11"));
					snedMap.put("SKUKEY", stockMapList.get(i).get("SKUKEY"));
					snedMap.put("DUOMKY", stockMapList.get(i).get("DUOMKY"));
					snedMap.put("QTJCMPBOX", (menuQTCOMP / ratio));
					
					// 스캔된 개별바코드의 제조일보다 빠른 제조일자의 재고가 존재하는 경우 알림노출 (생리대, 물티슈 품목대상)
					if (("SN".equals(shpdiInfoList.get(0).getString("SKUL01")) || "WT".equals(shpdiInfoList.get(0).getString("SKUL01")) ) && Integer.parseInt(stockMapList.get(i).getString("LOTA11")) > Integer.parseInt(shpdiInfoList.get(0).getString("LOTA11"))) {
						snedMap.put("PRE_EXIST_LOTA11", "TRUE");
					} else {
						snedMap.put("PRE_EXIST_LOTA11", "FALSE");
					}
					
					// STKKY테이블 정보
					snedMap.put("PRE_ZONEKY", shpdiInfoList.get(0).get("ZONEKY"));
					snedMap.put("PRE_AREAKY", shpdiInfoList.get(0).get("AREAKY"));
					snedMap.put("PRE_LOCAKY", shpdiInfoList.get(0).get("LOCAKY"));
					snedMap.put("PRE_LOTA11", shpdiInfoList.get(0).get("LOTA11"));
					snedMap.put("PRE_LOTA14", shpdiInfoList.get(0).get("LOTA14"));
					
					addStkkyList.add(snedMap);
					
					MSG = "OK";
				}
			}
		} else {
			// * 조회된 재고가 없습니다.
			MSG = "TASK_M0015";
		}

		if(addStkkyList.size() > 1) {
			for(int j=addStkkyList.size()-1; j >= 0; j--) {
				if(j != 0) {
					if(!addStkkyList.get(j).getString("LOCAKY").equals(addStkkyList.get(j-1).getString("LOCAKY")) ||
					   !addStkkyList.get(j).getString("LOTA01").equals(addStkkyList.get(j-1).getString("LOTA01")) ||
					   !addStkkyList.get(j).getString("LOTA02").equals(addStkkyList.get(j-1).getString("LOTA02")) ||
					   !addStkkyList.get(j).getString("LOTA14").equals(addStkkyList.get(j-1).getString("LOTA14"))) {
					
					}else {
						addStkkyList.get(j-1).put("QTCOMP", Double.parseDouble(addStkkyList.get(j).getString("QTCOMP")) + Double.parseDouble(addStkkyList.get(j-1).getString("QTCOMP")));
						addStkkyList.get(j-1).put("QTJCMPBOX", Double.parseDouble(addStkkyList.get(j).getString("QTJCMPBOX")) + Double.parseDouble(addStkkyList.get(j-1).getString("QTJCMPBOX")));
						addStkkyList.remove(j);
					}
				}
			}
		}
		
		// 할당정보와 다른 바코드입니다.
		if(!"TASK_M0015".equals(MSG) && (stockMapList.size() <= 0 && diffCnt == 0) || (diffCnt > 0 && diffCnt == ingCnt)) {
			MSG="OK";
			//MSG="MOBILE_M0046";
		}

		// 이미 피킹완료된 데이터입니다. 
		if(stockMapList.size() > 0 && !MSG.equals("OK") && diffCnt == 0) {
			MSG = "OUT_M0175";
		}
	
		rsMap.put("MSG", MSG);
		rsMap.put("StkkyList", addStkkyList);
		
		return rsMap ;
	}
	
	/* 할당(선적단위) PC지정피킹 */
	@Transactional
	public DataMap DL061REAPPLY(DataMap map) throws SQLException {

		List<DataMap> shpdiInfoList = new ArrayList<DataMap>();
		List<DataMap> addStkkyList = new ArrayList<DataMap>();
		DataMap rsMap = new DataMap();				
		String MSG = "FAIL";
		int diffCnt = 0;
		int ingCnt = 0;
		
		SimpleDateFormat fmDate = new SimpleDateFormat("yyyyMMdd", Locale.KOREA);
		String date = fmDate.format(new Date());
		SimpleDateFormat fmTime = new SimpleDateFormat("HHmmss", Locale.KOREA);
		String time = fmTime.format(new Date());
		
		String USER = map.getString(CommonConfig.SES_USER_ID_KEY);
		String PROGID = map.getString("PROGID");
		String QTSPUT = map.getString("QTSPUT");
		double TOT_USEQTY = Double.parseDouble(QTSPUT.replace(",", ""));
		
		System.out.println("@@@@@@>> " + TOT_USEQTY);
		

		// 개별바코드 할당취소 처리 (미작업 대상만 지정피킹 하기떄문에 false 처리)
		if (false) {
			map.put("METHOD", "barcodCheck");
			map.setModuleCommand("WmsMobileOutboundPicking_COPY", "UNALLOCATE_TARGET");
			List<DataMap> unlocateTarketList = commonDao.getList(map);

			if(unlocateTarketList.size() > 0 && unlocateTarketList.get(0) != null) {
				DataMap rowSub;
				rowSub = map;
				
				// 품목 + 개별바코드 대상 부분할당취소처리 
				for(int i=0; i<unlocateTarketList.size(); i++) {

					if ("PPC".equals(unlocateTarketList.get(i).getString("STATIT")) && !"NEW".equals(unlocateTarketList.get(i).getString("STATIT"))) {
						continue;
					}
					
					rowSub.put("SHPOKY", unlocateTarketList.get(i).getString("SHPOKY"));
					rowSub.put("SHPOIT", unlocateTarketList.get(i).getString("SHPOIT"));
					rowSub.put("LOTA14", unlocateTarketList.get(i).getString("LOTA14"));
					rowSub.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					
					commonDao.delete("WmsOutbound.DL04REMOVE1", rowSub); // TASDI 부분 삭제 DELTEE
					commonDao.update("WmsOutbound.DL04SHPDI", rowSub); // SHPDI 수정 정보 UPDATE
					commonDao.update("WmsOutbound.DL04SHPDH", rowSub); // SHPDH 수정 정보 UPDATE
				}
			}
		}
		
		// 재고조회 후 피킹처리 
		map.setModuleCommand("WmsMobileOutboundPicking_COPY","MANUALALLOCATE_AVAILABLE_STOCK");
		List<DataMap> stockMapList = commonDao.getList(map);
		
		if(stockMapList != null && stockMapList.size() > 0) {
			for(int i=0; i<stockMapList.size(); i++) {
				
				double menuQTCOMP=0;
				
				double STKKY_USEQTY = Double.parseDouble(stockMapList.get(i).getString("USEQTY").replace(",", ""));					
				double TASDI_QTCOMP = 0;
				
				
				if(STKKY_USEQTY <= 0) {continue;}
				if(TOT_USEQTY <= 0) {continue;}
				
				//할당할 출하정보 조회 
			    map.setModuleCommand("WmsMobileOutboundPicking_COPY", "PDPK05_COPY_SHPDI_INFO");
				shpdiInfoList = commonDao.getList(map);

				for(int j=0; j<shpdiInfoList.size(); j++) {															
					ingCnt++;

					if(!stockMapList.get(i).getString("LOTA01").equals(shpdiInfoList.get(j).getString("LOTA01")) ||   
					   !stockMapList.get(i).getString("LOTA02").equals(shpdiInfoList.get(j).getString("LOTA02")) ||
					   !stockMapList.get(i).getString("LOTA07").equals(shpdiInfoList.get(j).getString("LOTA07"))) {  	
						continue;
					}

					double SHPDI_NEED = Double.parseDouble(shpdiInfoList.get(j).getString("NEEDQTY").replace(",", ""));															
					
					if(TOT_USEQTY <= 0 && j != 0 || SHPDI_NEED == 0) {continue;}
					
					if(STKKY_USEQTY < SHPDI_NEED && TOT_USEQTY == STKKY_USEQTY) {
						
						TASDI_QTCOMP = STKKY_USEQTY;
						
					}else if(STKKY_USEQTY > SHPDI_NEED) {
						
						TASDI_QTCOMP = SHPDI_NEED;
					}else if(STKKY_USEQTY < TOT_USEQTY){
						TASDI_QTCOMP = STKKY_USEQTY;
					}else {
						TASDI_QTCOMP = TOT_USEQTY;
					}
					
					TOT_USEQTY -= TASDI_QTCOMP;
					TOT_USEQTY = Math.round(TOT_USEQTY * 1000) / 1000.0;
					STKKY_USEQTY -= TASDI_QTCOMP;
					
					menuQTCOMP += TASDI_QTCOMP;
					
					
					if(TASDI_QTCOMP <= 0) {continue;}
					
					DataMap shpdiRow = shpdiInfoList.get(j);

					//기존 TASDH 있나 확인
					shpdiRow.setModuleCommand("WmsMobileOutboundPicking_COPY", "TASDH_INFO"); 
					List<DataMap> taskList = commonDao.getList(shpdiRow); 
					
					String taskky;
					String taskit;

					if(taskList.size() > 0 && taskList.get(0) != null) {
						  taskky = 	taskList.get(0).getString("TASKKY");
						  
