				row.put("PLNTKY", map.get("PLNTKY"));				
				row.put("STKNUM", map.get("STKNUM"));
				row.put("DPTNKY", map.get("DPTNKY"));
				row.put("LOCAKY", map.get("LOCAKY"));
				row.put("SKUKEY", map.get("SKUKEY"));
				
				row.setModuleCommand("WmsMobileOutboundPicking_COPY", "PDPK05_SAVE");
				rowList = commonDao.getList(row);
				
