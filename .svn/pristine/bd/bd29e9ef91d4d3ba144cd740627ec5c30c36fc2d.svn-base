						  tasdhRow.put("PTNRKY", shpdiRow.getString("PTNRKY"));
						  tasdhRow.put(CommonConfig.SES_USER_ID_KEY,	map.get(CommonConfig.SES_USER_ID_KEY));
	                      
						  commonDao.insert(tasdhRow); 						  						  
						  
						  taskit = leftPad((10)+"", "0", 6);						  
					}

					DataMap tasdiRow = new DataMap();										  				  			  			 					 
					  
					tasdiRow.put("TASKKY", taskky);
