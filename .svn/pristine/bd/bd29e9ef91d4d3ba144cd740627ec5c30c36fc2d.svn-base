		// -> 할당된 바코드 입니다. (처리 불가)
		// -> 미할당 바코드인 경우 재고수량 체크 > 선적의 품목 부분피킹취소 > 할당+피킹 프로세스 호출
		
		// System.out.println("지정피킹 MAP: " + map.toString());
		// 지정피킹 MAP: {SES_WARENMKY=, WAREKY=1100, SES_USER_IP=0:0:0:0:0:0:0:1, LOCAKY=T1-01, OWNRKY=KN, SKUKEY=FRT-ADO0013A, SES_USER_ID=kyh, SES_USER_INFO_ID=, SES_WAREKY=1100, DPTNKY=P1200, SES_MTYPE=%, SES_OWNER=KN, SES_USER_COMPANY=KN, SES_DEVICE_TYPE=W, SES_SCHEMA=kn, STKNUM=1001541932, menuId=PDPK05_DETAIL02_COPY, isMobile=true, SES_USER_TYPE_ID=, SES_LANGUAGE=KR, SES_USER_EMPL_ID=, BARCOD=H20240206R60208}
	
		// 재고 셀렉트 
		map.setModuleCommand("WmsMobileOutboundPicking_COPY","MANUALALLOCATE_AVAILABLE_STOCK");
		List<DataMap> stockMapList = commonDao.getList(map);
		
		if(stockMapList != null && stockMapList.size() > 0) {
			
			// 부분할당 취소 (선적번호 + 품목코드 + 납품처코드) 
			if (true) {
				map.put("METHOD", "PDPK05StockValidation");
				map.setModuleCommand("WmsMobileOutboundPicking_COPY", "UNALLOCATE_TARGET");
				List<DataMap> unlocateTarketList = commonDao.getList(map);
				//System.out.println("지정피킹 할당취소 대상: " + unlocateTarketList);

				if(unlocateTarketList.size() > 0 && unlocateTarketList.get(0) != null) {
					DataMap rowSub;
					rowSub = map;
					
					// 선적 + 품목 + 납품처 코드의 부분할당취소처리 
					for(int i=0; i<unlocateTarketList.size(); i++) {
						rowSub.put("SHPOKY", unlocateTarketList.get(i).getString("SHPOKY"));
						rowSub.put("SHPOIT", unlocateTarketList.get(i).getString("SHPOIT"));
						rowSub.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						
						commonDao.delete("WmsOutbound.DL04REMOVE1", rowSub); // TASDI 부분 삭제 DELTEE
						commonDao.update("WmsOutbound.DL04SHPDI", rowSub); // SHPDI 수정 정보 UPDATE
						commonDao.update("WmsOutbound.DL04SHPDH", rowSub); // SHPDH 수정 정보 UPDATE
						
					}
				}
			}
			
			for(int i=0; i<stockMapList.size(); i++) {
				double menuQTCOMP=0;
				double STKKY_USEQTY = Double.parseDouble(stockMapList.get(i).getString("USEQTY").replace(",", ""));
				double TOT_USEQTY = Double.parseDouble(stockMapList.get(i).getString("USEQTY").replace(",", ""));
				double TASDI_QTCOMP = 0;

				if(STKKY_USEQTY <= 0) {
					continue;
				}

				//할당할 출하정보 조회 
			    map.setModuleCommand("WmsMobileOutboundPicking_COPY", "PDPK05_COPY_SHPDI_INFO");
				shpdiInfoList = commonDao.getList(map);
			
				//지정피킹 2457 stockMapList: {DUOMKY=BAG, LOTA01=3000, TKZONE=T1, LOTA02=P200, LOTA03= , STRAID= , GRPOIT= , LOTA04=RT6, LOTA05= , LOTA06=00, CREUSR=khl43, LOTA07= , LOTA08= , LOTA09= , QTSALO=0, ZONEKY=T1, RECVKY=10000000000001422333, SECTID= , SSORNU=2100021209, SMBLNR= , LSTTFL= , SADJIT= , SMANDT= , QTDUOM=1, ASNDIT= , TKFLKY= , AREAKY=220, SHPOKY= , CUBICM=0.05, LENGTH=374, RECVIT=000010, SAPSTS=311, STOKKY=20000000000015055831, QTSBLK=0, STDLNR= , WGTUNT=KG, GTINCD=18801260114037, SDIFIT= , TRUNTY= , LOTA20=0, TRNUID= , LOTA11=20240206, TASKIT=000020, LOTA12=20240206, LOTA13= , LOTA14=H20240206R60208, LOTA15=FR24206601, LOTA16=0, LOCAKY=T1-01, LOTA17=3000, LOTA18=0, LOTA19=0, GRSWGT=5, USEQTY=48, SZMIPNO= , ASNDKY= , STKNUM= , LOCATG= , LOTA10= , ASKU03= , SHPOIT= , ASKU02= , SKUG01=FERT, ASKU01= , WAREKY=1100, SKUG04= , REFDKY=3002739038, SKUG05=20, SKUG02= , SKUG03= , CAPACT=0, PHYIIT= , EANCOD=8801260114030, STPNUM= , SBKTXT=3003002739038, SADJKY= , SVBELN= , QTYUOM=48, QTSPMO=0, SDIFKY= , TASKKY=3002739038, QTSPMI=0, LOTNUM=20000000000002672101, OWNRKY=KN, SPOSNR= , DESC01=깨끗한나라 촉앤감케어 와이드 30m 30롤(P), DESC02= , SZEILE= , PURCKY= , QTSIWH=48, SWERKS= , REFCAT=300, QTPUOM=1, ASKU05= , ASKU04=0, PACKID= , AWMSNO= , SZMBLNO= , REFDIT=000020, SKUKEY=FRT-ADO0013A, GRPOKY= , UOMDOC=BAG, NUPDPS= , SEBELP=1, LMOUSR=khl43, PHYIKY= , LMOTIM=211357, SEBELN=MIF40224020621137279, SMJAHR= , LMODAT=20240206, UOMKEY=BAG, MEASKY=FRT-ADO0013A, NETWGT=5, SXBLNR= , WIDTHW=250, HEIGHT=537, STEPNO= , SLGORT= , CNTBSK=0, PURCIT= , SDATBG= , SSORIT=1, SRCSKY= , CREDAT=20240206, CRETIM=211357, REFDAT=20240206}
