						  //기존 TASDH 있나 확인
						  taskkyMap.setModuleCommand("WmsMobileOutboundPicking_COPY", "TASDR_MAXINFO");
						  taskkyMap.put("TASKKY", taskky);
						  List<DataMap> taskList2 = commonDao.getList(taskkyMap); 
						
						  taskit = leftPad((Integer.parseInt(taskList2.get(0).getString("TASKIT"))+10)+"", "0", 6); 
					}else {
						  DataMap tasdhRow = new DataMap();

						  tasdhRow.setModuleCommand("WmsMobileOutboundPicking_COPY", "TASKKY");
						  tasdhRow = commonDao.getMap(tasdhRow);
						  
						  taskky = tasdhRow.getString("TASKKY");
	
						  tasdhRow.setModuleCommand("WmsMobileOutboundPicking_COPY", "TASDHEND");
