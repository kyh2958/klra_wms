					tasdiRow.put("DOORKY", PROGID);	// 2024.04.18 서비스 요청 화면 기로
					tasdiRow.put("PTLT01", stockMapList.get(i).get("LOTA01"));
					tasdiRow.put("PTLT02", stockMapList.get(i).get("LOTA02"));
					tasdiRow.put("PTLT03", stockMapList.get(i).get("LOTA03"));
					tasdiRow.put("PTLT04", stockMapList.get(i).get("LOTA04"));
					tasdiRow.put("PTLT05", stockMapList.get(i).get("LOTA05"));
					tasdiRow.put("PTLT06", stockMapList.get(i).get("LOTA06"));
					tasdiRow.put("PTLT07", stockMapList.get(i).get("LOTA07"));
					tasdiRow.put("PTLT08", stockMapList.get(i).get("LOTA08"));
					tasdiRow.put("PTLT09", stockMapList.get(i).get("LOTA09"));
					tasdiRow.put("PTLT10", stockMapList.get(i).get("LOTA10"));
					tasdiRow.put("PTLT11", stockMapList.get(i).get("LOTA11"));
					tasdiRow.put("PTLT12", stockMapList.get(i).get("LOTA12"));
					tasdiRow.put("PTLT13", stockMapList.get(i).get("LOTA13"));
					tasdiRow.put("PTLT14", stockMapList.get(i).get("LOTA14"));
					tasdiRow.put("PTLT15", stockMapList.get(i).get("LOTA15"));
					tasdiRow.put("PTLT16", stockMapList.get(i).get("LOTA16"));
					tasdiRow.put("PTLT17", stockMapList.get(i).get("LOTA17"));
					tasdiRow.put("PTLT18", stockMapList.get(i).get("LOTA18"));
					tasdiRow.put("PTLT19", stockMapList.get(i).get("LOTA19"));
					tasdiRow.put("PTLT20", stockMapList.get(i).get("LOTA20"));
					tasdiRow.put("PASTKY", " ");
					tasdiRow.put("ALSTKY", " ");
					tasdiRow.put("SBKTXT", " ");
					tasdiRow.put("TASRSN", " ");
					tasdiRow.put("CREDAT", date);
					tasdiRow.put("CRETIM", time);
					tasdiRow.put("CREUSR", USER);
					tasdiRow.put("LMODAT", date);
					tasdiRow.put("LMOTIM", time);
					tasdiRow.put("LMOUSR", USER);
					tasdiRow.put("INDBZL", " ");
					tasdiRow.put("INDARC", " ");
					tasdiRow.put("UPDCHK", "0");
					tasdiRow.put(CommonConfig.SES_USER_ID_KEY, USER);
	
					//TASDI 생성
					tasdiRow.setModuleCommand("WmsOutbound", "TASDI"); 
					commonDao.insert(tasdiRow);
					
					//TASDR 생성
					tasdiRow.put("STOKKY", stockMapList.get(i).get("STOKKY"));				
					commonDao.getMap("WmsTask.DBMSPROC_SZP_INS_TASDR", tasdiRow);		

					//지정피킹 FLAG
					DataMap appointMap = new DataMap();
					appointMap.put("SHPOKY", shpdiInfoList.get(j).getString("SHPOKY"));
					appointMap.put("SHPOIT", shpdiInfoList.get(j).getString("SHPOIT"));
					appointMap.put("SKUKEY", shpdiInfoList.get(j).getString("SKUKEY"));
					commonDao.update("WmsMobileOutboundPicking_COPY.APPOINTPICKINGFLAG", appointMap);	
					
					MSG = "OK";
				}
			}
		} else {
			// * 조회된 재고가 없습니다.
			MSG = "TASK_M0015";
		}

		if(!MSG.equals("OK")) {MSG = "OUT_M0252";}
		if(MSG.equals("OK") && TOT_USEQTY > 0) {MSG = "OUT_M0254";}
				
		rsMap.put("MSG", MSG);
		
		return rsMap ;
	}
	
