<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@page import="project.common.airfw.User"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Grid default</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<%@ page import="project.common.airfw.*"%>
<%@ include file="/common/include/webdek/layout.jsp" %>
<%
	User user = (User)request.getSession().getAttribute(CommonConfig.SES_USER_OBJECT_KEY);
	String str = "";
%>
<style>
input[name="ST.SKUKEY"]~input{
	display: inline-block;
	width : 60px !important;
}
input[name="ST.SKUKEY"]+input{
	display: inline-block;
	width : 131px !important;
}
input[name="ST.LOTA15"]~input{
	display: inline-block;
	width : 60px !important;
}
input[name="ST.LOTA15"]+input{
	display: inline-block;
	width : 131px !important;
}
</style>
<script type="text/javascript">
	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",
			editable : true,
// 			pkcol : "STOKKY",
			module : "WmsInventory",
			command : "SD07",
			dataRequest : true
		});
		
		gridList.setReadOnly("gridList", true, ['LOTA06']);
		
// 		initSearchArea();
// 		initTime();
	});
	
	function initSearchArea() {
		<%if(plant.equals("")){%>
			$('select[name="ST.LOTA02"]').multipleSelect('checkAll');
		<%}else{%>
			$('select[name="ST.LOTA02"]').multipleSelect('setSelects', ['<%=plant%>']);
		<%}%>
// 		$('select[name="SM.SKUL01"]').val("");
	}
	
// 	function initTime() {
// 		$("#frTime").val('00:00');
// 		$("#toTime").val('23:59');
// 	}
	
	function searchList(){
		if(validate.check("searchArea")){
// 			callSapFunc(); 

			var param = inputList.setRangeParam("searchArea");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
			
			gridList.gridList({
				id : "gridList",
				param : param
			});
		}
		gridList.setReadOnly("gridList", true, ['LOTA06']);
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType){
		if(searchCode == "SHSKUMA"){ // 품목코드
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			return param;
		}else if(searchCode == "SHZONMA"){ // 구역
			return dataBind.paramData("searchArea");
		}else if(searchCode == "SHSTLMAP"){ // 저장위치
			var param = new DataMap();
			var PLNTKY = $('select[name="ST.LOTA02"]').val();
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("PLNTKY", PLNTKY);
			return param;
		}else if(searchCode == "SHCMCDV"){ // 재고상태
			var param = new DataMap();
			param.put("CMCDKY", "LOTA06");
			return param;
		}else if(searchCode == "SHLOCMA_PT"){ // 로케이션
			var param = dataBind.paramData("searchArea");
			var plntkyArr = $('select[name="ST.LOTA02"]').val();
			plntkyArr = plntkyArr ? plntkyArr : [];
			plntkyArr.push(' ');
			
			param.put("PLNTKY", plntkyArr);
			return param;
		}
	}
	function saveData(){
		var list = gridList.getSelectData("gridList");

		if(list.length > 0){
			
			if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){
				return;
			}
			var param = new DataMap();
			param.put("list", list);
			param.put("PROGID", "<%=menuId%>");	
			
		    var json = netUtil.sendData({
	            url : "/wms/task/json/saveTKSD.data",           
	            param : param
	           });
		    
		    if(json.data["suCnt"]){
// 				commonUtil.msgBox("REPORT_M0021"); //* 재고 저장이 성공하였습니다.
//    	        commonUtil.msgBox("수신 ["+sCnt+"]건, 미수신 ["+fCnt+"]건" + (fCnt > 0 ? " ("+fArr.toString()+")": "" ));
				if(json.data["MSG"]){
					commonUtil.msgBox("수신 ["+json.data["suCnt"]+"]건 : "+json.data["MSG"]); //* 재고 저장이 성공하였습니다.);
				}else{
					commonUtil.msgBox("수신 ["+json.data["suCnt"]+"]건"); //* 재고 저장이 성공하였습니다.
				}
				callSapFunc();
			}else if(json.data["error"]){
				commonUtil.msgBox(json.data["error"]);
			}
		}else{
			commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
			return false;
		}
	}
	function callSapFunc() {
		if(validate.check("searchArea")){
			var search = inputList.setRangeParam("searchArea");
			
			commonUtil.msgBox("COMMON_M0049", "SAP재고 수신"); //{0} 하시겠습니까?
			
			var param = new DataMap();
			param.put("IFID", "WMS_IF_900");
			param.put("IFTBL", "IFWMS113");
			param.put("BWART", "");
	 		param.put("RFCFN", "Z_WMS_SAP_INV_INFO");
	 		param.put("RFCTBL", "ET_DATA");
	 		param.put("RFCP1", "");
	 		param.put("RFCP2", "");
	 		param.put("OWNRKY", "<%=ownrky%>");
	 		param.put("WERKS", search.get("LOTA02")); // SAP재고 수신 : 플랜트 셋팅 
	 		
			var json = netUtil.sendData({
				url : "/rfc/json/rfcCall.data",
				param : param,
			});	
	 		
	 		if(json.row_count>0){
				commonUtil.msgBox("ITF_M0035"); //데이터 수신 완료했습니다.
	 			searchList();
	 		}else{
				commonUtil.msgBox("ITF_M0036"); //수신된 데이터가 없습니다.
	 			
	 		}
			
		}
	}
	
	function commonBtnClick(btnName){
		if(btnName == "Search"){
			searchList();
		}else if(btnName == "RcvSap") {
			callSapFunc();
		}else if(btnName == "Save") {
			saveData();
		}
	}
	
	function comboEventDataBindeBefore(comboAtt){
		var param = new DataMap();
		if(comboAtt == "Wms,PLNTKYCOMBO"){
			param.put("WAREKYS", "'<%=wareky%>'");
			param.put("OWNRKY", "<%=ownrky%>");
			param.put("LANGKY", "<%=langky%>");
		} else if(comboAtt == "airfw,COMCOMBO"){
			param.put("CODE", "TRNHTY");
		}
		return param;
	}
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
	<div class="content_inner">
		<%@ include file="/common/include/webdek/title.jsp" %>
		<div class="content_serch" id="searchArea">
			<div class="btn_wrap">
				<div class="fl_l"></div>
				<div class="fl_r">
					<input type="button" CB="Search SEARCH BTN_SEARCH" />
					<input type="button" CB="RcvSap PRINT BTN_STOSAP"/><!-- SAP FUNC 호출 -->
                    <input type="button" CB="Save SAVE STD_ADJUST" />  <!-- 출고완료 -->	                   
					
				</div>
			</div>
			<div class="search_inner">
				<div class="search_wrap ">
					<dl>
						<dt CL="STD_WAREKY">거점</dt>
						<dd>
							<input type="text" class="input" name="WAREKY" value="<%=wareky%>" readonly="readonly" validate="required" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA02">플랜트</dt>
						<dd>
							<select name="LOTA02" class="input" Combo="Wms,PLNTKYCOMBO" validate="required">
								<option value="">Please Select</option>
							</select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA01">저장위치</dt>
						<dd>
							<input type="text" class="input" name="K.LOTA01" UIInput="R,SHSTLMAP" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_SKUKEY">품목코드</dt>
						<dd>
							<input type="text" class="input" name="K.SKUKEY" UIInput="R,SHSKUMA" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_DESC01">품목명</dt>
						<dd>
							<input type="text" class="input" name="K.DESC01"/>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA06">재고상태</dt>
						<dd>
							<select name="ST.LOTA06" class="input" CommonCombo="LOTA06" ComboType="MS"></select>
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA15">LOT 번호</dt>
						<dd>
							<input type="text" class="input" name="K.LOTA15" UIInput="R" IAname="Search" />
						</dd>
					</dl>
				</div>
				<div class="btn_tab">
					<input type="button" class="btn_more" value="more" onclick="searchMore()"/>
				</div>
			</div>
		</div>
		<div class="search_next_wrap">
			<div class="content_layout tabs top_layout">
				<ul class="tab tab_style02">
					<li><a href="#tab1-1"><span CL="STD_LIST">리스트</span></a></li>
					<li class="btn_zoom_wrap">
						<ul>
							<li><button class="btn btn_bigger"><span>확대</span></button></li>
						</ul>
					</li>
				</ul>
				<div class="table_box section" id="tab1-1">
					<div class="table_list01">
						<div class="scroll">
							<table class="table_c">
								<tbody id="gridList">
									<tr CGRow="true">
										<td GH='40 STD_NUMBER'		GCol="rownum">1</td>
                                       	<td GH="40" GCol="rowCheck"></td>
										<td GH="150 STD_SKUKEY"		GCol="text,SKUKEY"				>품목코드		</td>
										<td GH="200 STD_DESC01"		GCol="text,DESC01"				>품명			</td>
										<td GH="100 STD_DOCDAT" 	GCol="input,DOCDAT" GF="C"		>전기일자		</td>
										<td GH="100 STD_LOTA15"		GCol="text,LOTA15"				>SAP배치번호	</td>
										<td GH="70 STD_WAREKY"		GCol="text,WAREKY"				>거점			</td>
										<td GH="100 STD_WARENM"		GCol="text,WARENM"				>거점명		</td>
										<td GH="70 STD_LOTA02"		GCol="text,LOTA02"				>플랜트		</td>
										<td GH="70 STD_LOTA01"		GCol="text,LOTA01"				>저장위치		</td>
										<td GH="100 STD_LOTA07"		Gcol="text,LOTA07"				>주문번호		</td>
										<td GH="100 STD_KDAUF"		Gcol="text,KDAUF"			    >SAP주문번호    </td>
										<td GH="100 STD_KDPOS"		Gcol="text,KDPOS"			    >SAP품목번호	</td>
										<td GH="50 STD_LOTA06"		GCol="text,LOTA06NM"			>재고상태		</td>
										<td GH="100 STD_STOCK"		GCol="text,QTSIWH" GF="N 30"	>재고	</td>
										<td GH="50 STD_UOMKEY"		GCol="text,UOMKEY"				>단위			</td>
										
										<td GH="100 STD_CHARG"		GCol="text,CHARG"				>배치번호	    </td>
										<td GH="70 STD_SAPWERKS"	GCol="text,WERKS"				>SAP플랜트	</td>
										<td GH="70 STD_SAPLGORT"	GCol="text,LGORT"				>SAP저장위치	</td>
										<td GH="100 STD_SAPSTQTY"	GCol="text,STQTY" GF="N 30,3"   >SAP가용재고	</td>
										<td GH="100 STD_SAPSPEME"	GCol="text,SPEME" GF="N 30,3"   >SAP보류재고	</td>
										<td GH="100 STD_SAPINSME"	GCol="text,INSME" GF="N 30,3"   >SAP품질재고	</td>
										<td GH="50 STD_SAPMEINS"	GCol="text,MEINS"				>SAP 단위		</td>
										<td GH="100 STD_QTYGAP"		Gcol="text,QTYGAP" GF="N 20,3"	>차이수량 		</td>
										<td GH="100 STD_QTYGAPT"	Gcol="text,QTYGAPT" GF="N 20,3"	>확인필요수량		</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="btn_lit tableUtil">
						<button type="button" GBtn="find"></button>
						<button type="button" GBtn="sortReset"></button>
						<button type="button" GBtn="layout"></button>
						<button type="button" GBtn="total"></button>
						<button type="button" GBtn="excel"></button>
						<span class='txt_total' >총 건수 : <span GInfoArea='true'>0</span></span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- // content -->
<%@ include file="/common/include/webdek/bottom.jsp" %>
</body>
</html>