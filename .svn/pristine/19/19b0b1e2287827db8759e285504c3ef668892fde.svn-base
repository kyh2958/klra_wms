	@Transactional
	public DataMap PDLD21SaveEnd(DataMap map) throws SQLException {
		List<DataMap> head = map.getList("head");
		DataMap itemRow;
		DataMap row;
		List shpokyList = new ArrayList();
		DataMap validMap = new DataMap();
		DataMap totalQtyMap = new DataMap();
		int validationCount = 0;

		DataMap rsRowMap = new DataMap();
		DataMap rsMap = new DataMap();
		DataMap rqMap = new DataMap();

		int count = 0;
		StringBuilder sb = new StringBuilder();

		for (int i = 0; i < head.size(); i++) {
			itemRow = head.get(i).getMap("map");

			itemRow.put("WAREKY", map.getString("WAREKY"));
			itemRow.put("OWNRKY", map.getString("OWNRKY"));
			itemRow.put("PLNTKY", map.getString("PLNTKY"));

			if (itemRow.get("FCKCOM").equals("V")) {
				continue;
			}

			String shpokyNum = head.get(i).getMap("map").getString("SHPOKY");

			if (!shpokyNum.isEmpty() && !shpokyNum.equals("")) {

				// SHPDH I/F CHECK
				for (int j = 0; j < head.size(); j++) {
					rsRowMap = head.get(j).getMap("map");
					rsRowMap.put("SHOPKY", shpokyNum);

					rsMap.setModuleCommand("WmsTask", "VALIDATION_SHPDH");
					rsMap.put("SHPOKY", rsRowMap.get("SHPOKY"));
					rqMap = commonDao.getMap(rsMap);

					if (rsRowMap.get("FCKCOM").equals("V")) {
						continue;
					}

					if (rqMap != null && !rqMap.getString("SHPOKY").equals(" ")) {
						rsMap.put("SHPOKY", rqMap.getString("SHPOKY"));

						return rsMap;
					}

				}

				// validation
				validMap = commonDao.getMap("WmsMobileOutboundPicking.PDLD21Validation1", itemRow);

				String validMsg = validMap.getString("MSG");

				if ("OK".equals(validMsg)) {

					itemRow.put("QTSHPC", Double.parseDouble((String) itemRow.get("QTCOMP")));
					itemRow.put("LSTTFL", "V");
					itemRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
					itemRow.put("PLNTKY", map.getString("PLNTKY"));
					itemRow.put("SES_MTYPE", map.getString("SES_MTYPE"));

					commonDao.update("WmsMobileOutboundPicking.PDLD21Sub", itemRow);

					totalQtyMap = commonDao.getMap("WmsMobileOutboundPicking.TOTAL_QTCOMP", itemRow);
					itemRow.put("QTSHPC", totalQtyMap.get("QTCOMP"));
					commonDao.update("WmsOutbound.DL05Sub", itemRow);

					rsMap.put("MSG", validMsg);

					count++;

				} else {
					rsMap.put("MSG", validMsg);
					validationCount++;
					break;
				}

			} else {

				List<DataMap> selectList = new ArrayList<>();
				itemRow.put("SES_MTYPE", map.getString("SES_MTYPE"));
				// SHPDH, SHPDI SELECT
				itemRow.setModuleCommand("WmsMobileOutboundPicking", "PDLD21SUB");
				selectList = commonDao.getList(itemRow);

				// SHPDH I/F CHECK
				for (int j = 0; j < selectList.size(); j++) {
					rsRowMap = selectList.get(j).getMap("map");
					rsMap.setModuleCommand("WmsTask", "VALIDATION_SHPDH");
					rsMap.put("SHPOKY", rsRowMap.get("SHPOKY"));
					rqMap = commonDao.getMap(rsMap);

					if (rsRowMap.get("FCKCOM").equals("V")) {
						continue;
					}

					if (rqMap != null && !rqMap.getString("SHPOKY").equals(" ")) {
						rsMap.put("SHPOKY", rqMap.getString("SHPOKY"));

						return rsMap;
					}

				}

				for (int j = 0; j < selectList.size(); j++) {

					row = selectList.get(j);

					// validation
					row.put("WAREKY", map.getString("WAREKY"));
					row.put("OWNRKY", map.getString("OWNRKY"));
					row.put("PLNTKY", map.getString("PLNTKY"));
					validMap = commonDao.getMap("WmsMobileOutboundPicking.PDLD21Validation1", itemRow);

					String validMsg = validMap.getString("MSG");

					if ("OK".equals(validMsg)) {

						row.put("LSTTFL", "V");
						row.put(CommonConfig.SES_USER_WHAREHOUSE_KEY, map.get(CommonConfig.SES_USER_WHAREHOUSE_KEY));
						row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						row.put("SES_MTYPE", map.getString("SES_MTYPE"));

						commonDao.update("WmsMobileOutboundPicking.PDLD21Sub", row);

						totalQtyMap = commonDao.getMap("WmsMobileOutboundPicking.TOTAL_QTCOMP", row);
						row.put("QTSHPC", Double.parseDouble((String) totalQtyMap.get("QTCOMP")));

						commonDao.update("WmsOutbound.DL05Sub", row);

						// WCS MOVE 처리대상 바코드
						// WCS 호출조건: 3000 / P200 / RT3 or RT6 / LOCAKY NOT IN ('SHPLOC', 'RCVLOC')
						if ("3000".equals(row.get("LOTA01")) && "P200".equals(row.get("LOTA02"))
								&& "0".equals(row.get("COUNT_LOCAKY"))
								&& ("RT3".equals(row.get("LOTA04")) || "RT6".equals(row.get("LOTA04")))) {
							if (j != 0) {
								sb.append(",");
							}

							System.out.println(row.toString());
							sb.append(row.get("LOTA14"));
						}

						count++;

					} else {
						rsMap.put("MSG", validMsg);
						validationCount++;
						break;
					}
				}
			}
			rsMap.put("BARCODS", sb.toString());
			rsMap.put("CNT", count);

		}
		try {
			String wareky = map.getString("WAREKY");
			String ownrky = map.getString("OWNRKY");
			String topic = "BOARDSTEP_" + wareky + "_" + ownrky;

			List<DataMap> pushList = new ArrayList<DataMap>();

			DataMap pushMap = new DataMap();
			pushMap.put("WAREKY", wareky);
			pushMap.put("OWNRKY", ownrky);
			pushMap.put("STEP", "LOAD");

			pushList.add(pushMap);

			SseEventManager.sendEvent(topic, "BoardStep.refresh", pushList);
		} catch (Exception e) {
			e.printStackTrace();
		}
		return rsMap;
	}

