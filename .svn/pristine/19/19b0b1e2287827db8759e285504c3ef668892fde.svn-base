//					/*  Tasdr 인써트 */
//					tasdiInfo.put("STOKKY", "%");
//					commonDao.getMap("WmsTask.DBMSPROC_SZP_INS_TASDR", tasdiInfo);
//										
//					
//				}
//				
//				
//				
//			 }
//		 }

		rsMap.put("CNT", count);

		// =========================
		// 현황판 SSE PUSH
		// 피킹완료 저장 완료시에 전송
		// =========================
		try {

			String wareky = map.getString("WAREKY");
			String ownrky = map.getString("OWNRKY");

			String topic = "BOARDSTEP_" + wareky + "_" + ownrky;

			List<DataMap> pushList = new ArrayList<DataMap>();

			DataMap pushMap = new DataMap();
			pushMap.put("WAREKY", wareky);
			pushMap.put("OWNRKY", ownrky);
			pushMap.put("STEP", "PREPARING");

			pushList.add(pushMap);

			
			SseEventManager.sendEvent(topic, "BoardStep.refresh", pushList);

		} catch (Exception e) {
			e.printStackTrace();
		}

		return rsMap;
	}

	@Transactional
	public DataMap PDPK05SaveEnd_TEST(DataMap map) throws SQLException {

		List<DataMap> headList = map.getList("head");
		List<DataMap> realList = new ArrayList<DataMap>();

		List<DataMap> saveItemList = new ArrayList<DataMap>();
		List<DataMap> taskkyList = new ArrayList<DataMap>();

		String stdTaskky = map.getString("TASKKY");
		String stdTaskit = map.getString("TASKIT");
		String stdShpoky = map.getString("SHPOKY");
		String stdShpoit = map.getString("SHPOIT");

		DataMap HeadRowMap = new DataMap();

