	@Transactional
	public DataMap saveKioskPrintLog(DataMap map) throws SQLException {

	    DataMap rsMap = new DataMap();

	    try {
	        List<DataMap> list = map.getList("list");
	        String docCd = map.getString("DOC_CD");

	       

	        if (list == null || list.size() == 0) {
	            rsMap.put("RESULT", "NO_DATA");
	            rsMap.put("CNT", 0);
	            return rsMap;
	        }

	        int insertCnt = 0;

	        for (int i = 0; i < list.size(); i++) {

	            DataMap row = list.get(i);
	            if (row == null) {
	                continue;
	            }

	            DataMap rowMap = row;
	            if (row.get("map") != null) {
	                rowMap = row.getMap("map");
	            }

	            String stknum = rowMap.getString("STKNUM");
	            String wareky = map.getString("WAREKY");
	            String ownrky = map.getString("OWNRKY");
	            String prtseq = rowMap.getString("PRTSEQ");

	            

	            if ("".equals(stknum)) {
	                continue;
	            }

	            DataMap logMap = new DataMap();
	            map.clonSessionData(logMap);

	            logMap.put("PRTSEQ", prtseq);
	            logMap.put("DOC_CD", docCd);
	            logMap.put("STKNUM", stknum);
	            logMap.put("WAREKY", wareky);
	            logMap.put("OWNRKY", ownrky);
	            logMap.put("CREUSR", map.getString("SES_USER_ID"));

	            

	            logMap.setModuleCommand("WmsMobileOutboundPicking_COPY", "PRTLG_KIOSK");

	            Object insertResultObj = commonDao.insert(logMap);
	            int result = 0;

	            if (insertResultObj instanceof Number) {
	            	result = ((Number) insertResultObj).intValue();
	            } else if (insertResultObj != null && !"".equals(insertResultObj.toString())) {
	            	result = Integer.parseInt(insertResultObj.toString());
	            }

	            insertCnt += result;
	        }

	        // =========================
	        // 현황판 SSE PUSH
	        // 출고지시서(DOC_CD=1) 이고
	        // 실제 신규 저장된 건이 있을 때만 전송
	        // =========================
	        if ("1".equals(docCd) && insertCnt > 0) {

	            String wareky = map.getString("WAREKY");
	            String ownrky = map.getString("OWNRKY");

	            String topic = "BOARDSTEP_" + wareky + "_" + ownrky;

	            List<DataMap> pushList = new ArrayList<DataMap>();

	            DataMap pushMap = new DataMap();
	            pushMap.put("WAREKY", wareky);
	            pushMap.put("OWNRKY", ownrky);
	            pushMap.put("DOC_CD", docCd);

	            pushList.add(pushMap);

	            SseEventManager.sendEvent(topic, "BoardStep.refresh", pushList);
	        }

	        rsMap.put("RESULT", "OK");
	        rsMap.put("CNT", insertCnt);

	    } catch (Exception e) {
	        e.printStackTrace();
	        rsMap.put("RESULT", "FAIL");
	        rsMap.put("MSG", e.getMessage());
	        throw e;
	    }

	    return rsMap;
	}
	
	

