				commonDao.insert(row);

				/* Tasdr 인써트 */
				// row.put("STOKKY", "%");
				row.put("STOKKY", stockMapList.get(j).get("STOKKY"));
				commonDao.getMap("WmsTask.SAVETK_SZP_INS_TASDR", row);

			}

			String firstSkukey = row.getString("SKUKEY").substring(0, 2);
			String stkkyLota01 = row.getString("LOTA01");
			String stkkyLOTA02 = row.getString("LOTA02");
			String sendLota01 = row.getString("TOWAREKY");

			if ((firstSkukey.equals("S0") || firstSkukey.equals("S9")) && stkkyLota01.equals("2400")
					&& stkkyLOTA02.equals("P100") && sendLota01.equals("2400")) {
				row.put("IFID", row.getString("IFID").split(",", 0)[1]);
			}
			// 입고 취소시 실적 IF 데이터 추출
			String I_RCPTTY = row.getString("TASKTY");
			String I_IFID = row.getString("IFID");
			String I_OWNRKY = row.getString("OWNRKY");
			String I_RECVKY = row.getString("TASKKY");

			List<String> rcpttyList = new ArrayList<String>(); // IF 실적 : 작업유형
			List<DataMap> ifidList = new ArrayList<DataMap>(); // IFID : 인터페이스 전송 목록

			DataMap rcpttyMap = new DataMap(); // IF 실적 : 작업유형별 TASK헤더키

			// IF 실적 입고유형별 입고키 넣기
			if (!rcpttyList.contains(I_RCPTTY)) {
				rcpttyList.add(I_RCPTTY);
				rcpttyMap.put(I_RCPTTY, "" + I_RECVKY + "");
				rcpttyMap.put(I_RCPTTY + "_IFID", I_IFID);
				rcpttyMap.put(I_RCPTTY + "_OWNRKY", I_OWNRKY);
			} else {
				String docNums = rcpttyMap.getString(I_RCPTTY);
				if (docNums != null && !"".contentEquals(docNums.trim())) {
					docNums += "," + I_RECVKY + "";
				} else {
					docNums += "" + I_RECVKY + "";
				}
				rcpttyMap.put(I_RCPTTY, docNums);
			}
			count++;

			String SAPIFYN = headRow.getString("SAPIFYN");

			if (SAPIFYN.equals("V")) {
				// 실적 인터페이스 저장
				outboundService.dataInsertIF(map, rcpttyList, rcpttyMap, ifidList, false);
				try {
					DataMap resultMap;
					// 인터페이스 전송
					for (DataMap item : ifidList) {
						item.put("ownrky", map.getString("OWNRKY"));
						item.put("IFID", item.getString("IFID"));
						item.put("RCPTTY", item.getString("RCPTTY"));
						item.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
						resultMap = outboundService.sendIf(item);

						if (item.getString("RFCTYPE").equals("SAP") && ("S".equals(resultMap.getString("sendMsg"))
								|| "SUCCESS".equals(resultMap.getString("sendMsg")))) {

							transactionManager.commit(transactionStatus);

						} else if (1 == ifidList.size() && item.getString("RFCTYPE").equals("MES")) {

							transactionManager.commit(transactionStatus);

						} else if (!"S".equals(resultMap.getString("sendMsg"))
								&& !"SUCCESS".equals(resultMap.getString("sendMsg"))) {
							String RFCTYPE;

							if (item.getString("RFCTYPE").equals("SAP")) {

								transactionManager.rollback(transactionStatus);

								RFCTYPE = "SAP : ";
								MSG = RFCTYPE + resultMap.getString("sendMsg");
								rsMap.put("MSG", MSG);
								rsMap.put("ERRTXT", resultMap.getString("sendMsg"));
								rsMap.put("ZDOCNO", seq);
								rsMap.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
								rsMap.put("PROGID", map.getString("menuId"));
								rsMap.put(CommonConfig.SES_USER_ID_KEY, map.getString(CommonConfig.SES_USER_ID_KEY));

								gridRowNumList.add(gridRowNum);
								break;
							} else {

								RFCTYPE = "MES";
								MSG = resultMap.getString("sendMsg");

								rsMap.put("MSG", MSG);
								rsMap.put("MSG_TYPE", RFCTYPE);
								rsMap.put("MSG_DOC_NO", seq);

							}
						}

					} // SEND FOR
				} catch (Exception e) {
					throw new SQLException(e.getMessage());
				}
			}

		} // list for

		// 실적 인터페이스 전송 목록
		rsMap.put("GROWNUM_LIST", gridRowNumList);
		// rsMap.put("ifidList",ifidList);
		// rsMap.put("TASKKY", seq);

		return rsMap;
	}

	@Transactional(rollbackFor = Exception.class)
	public DataMap barcodCheck(DataMap map) throws SQLException {

		DataMap rsMap = new DataMap();

		map.setModuleCommand("WmsMobileOutboundPicking", "BARCOD_CHECK");

		map.put("OWNRKY", map.get(CommonConfig.SES_USER_OWNER_KEY));
		map.put("PLNTKY", map.get(CommonConfig.SES_USER_PLANT_KEY));

		DataMap row = commonDao.getMap(map);

		rsMap.put("MSG", row.getString("MSG"));

		return rsMap;
	}

	@Transactional(rollbackFor = Exception.class)
	public DataMap taskLockCheck(DataMap map) throws SQLException {

		DataMap dataMap = map.getMap("data");

		DataMap rsMap = new DataMap();
		DataMap rowMap = new DataMap();
		DataMap rowsubMap = new DataMap();
		List<DataMap> taskkyList;

		String DPTNKY = map.getString("DPTNKY");

		rowMap = dataMap;

		rowMap.put("DPTNKY", DPTNKY);
		rowMap.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
		rowMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
		rowMap.put("SES_MTYPE", map.getString("SES_MTYPE"));

		rowMap.setModuleCommand("WmsMobileOutboundPicking", "TASDI_LOCK_INFO");

		taskkyList = commonDao.getList(rowMap);

		for (int j = 0; j < taskkyList.size(); j++) {

			rowsubMap = taskkyList.get(j).getMap("map");

			if (!rowsubMap.getString("PAIDSR").equals(" ")) {

				rsMap.put("PAIDSR", rowsubMap.getString("PAIDSR"));

				return rsMap;
			}
		}

		return rsMap;
	}

	@Transactional(rollbackFor = Exception.class)
	public DataMap taskLockUpdate(DataMap map) throws SQLException {

		DataMap rsMap = new DataMap();
		DataMap rowsubMap = new DataMap();
		List<DataMap> taskkyList;

		String DPTNKY = map.getString("DPTNKY");
		String STKNUM = map.getString("STKNUM");
		String LOCAKY = map.getString("LOCAKY");
		String SKUKEY = map.getString("SKUKEY");

		String INOUTCHK = map.getString("INOUTCHK");

		int count = 0;

		map.put("DPTNKY", DPTNKY);
		map.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
		// map.put("SES_MTYPE", map.getString("SES_MTYPE"));

		map.setModuleCommand("WmsMobileOutboundPicking", "TASDI_LOCK_INFO");

		taskkyList = commonDao.getList(map);

		for (int j = 0; j < taskkyList.size(); j++) {

			rowsubMap = taskkyList.get(j).getMap("map");

			rowsubMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			rowsubMap.put("INOUTCHK", INOUTCHK);

			rowsubMap.setModuleCommand("WmsMobileOutboundPicking", "TASDI_LOCK_INFO");
			commonDao.update(rowsubMap);

			count++;
		}

		rsMap.put("CNT", count);

		return rsMap;
	}

	@Transactional(rollbackFor = Exception.class)
	public DataMap OrderCheck(DataMap map) throws SQLException {

		DataMap rsMap = new DataMap();
		List<DataMap> rsList;

		map.setModuleCommand("WmsMobileOutboundPicking", "STKNUM_ORDER_INFO");
		map.put("OWNRKY", map.get(CommonConfig.SES_USER_OWNER_KEY));

		rsList = commonDao.getList(map);

		rsMap.put("CNT", rsList.size());

		if (rsList.size() > 0) {
			DataMap valid = rsList.get(0);

			rsMap.put("MSG", valid.getString("MSGRESULT"));

		}

		return rsMap;
	}

	/**
	 * @methodName sendStknumInfo
	 * @param map 선적번호
	 * @return DataMap {"MSG":"SUCCESS"} or {"MSG" : "SAP : " + resultMsg}
	 * @throws Exception
	 * @description 선적번호(STKNUM)값을 선적통제(IFWMS333) 등록, RFC SEND (Z_WMS_SHIPMENT_INFO)
	 *              등록
	 * @history __DATE_______AUTHOR__NOTE__________________________________<br>
	 *          * 2023.10.20 KYH if(CheckCount > 0) 조건 추가<br>
	 */
	@Transactional(rollbackFor = Exception.class)
	public DataMap sendStknumInfo(DataMap map) throws Exception {

		DataMap rsMap = new DataMap();
		DataMap ifMap = new DataMap();
		List<DataMap> stknumInfoList = null;

		String DPTNKY = map.getString("DPTNKY");
		String STKNUM = map.getString("STKNUM");
		String LOCAKY = map.getString("LOCAKY");
		String SKUKEY = map.getString("SKUKEY");

		int count = 0;
		String MSG = "SUCCESS";

		map.put("STATUS", "C");
		map.put("DPTNKY", DPTNKY);
		map.put("WAREKY", map.getString(CommonConfig.SES_USER_WHAREHOUSE_KEY));
		// map.put("SES_MTYPE", map.getString("SES_MTYPE"));

		map.setModuleCommand("WmsMobileOutboundPicking", "SHPDI_STKNUM_INFO");

		stknumInfoList = commonDao.getList(map);

		if (stknumInfoList.size() > 0) {

			// 선적번호기준 선적통제 이력존재 체크
			List<DataMap> checkList = map.getList("list");
			DataMap checkRow = new DataMap();
			checkRow.setModuleCommand("Erpif", "IFWMS333_CHECK");
			checkRow.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
			checkRow.put("TKNUM", stknumInfoList.get(0).getString("TKNUM"));

			if (commonDao.getCount(checkRow) > 0) {
				rsMap.put("MSG", "SUCCESS");

			} else {
				ifMap.put("list", stknumInfoList);
				ifMap.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));

				try {

					String resultMsg = ifservice.send_TK_CONTROL(ifMap);

					if (!"SUCCESS".equals(resultMsg)) {
						rsMap.put("MSG", "SAP : " + resultMsg);
					} else {
						rsMap.put("MSG", resultMsg);
					}

				} catch (Exception e) {
					throw new SQLException(e.getMessage());
				}
			}
		}

		return rsMap;
	}

	public static boolean isNull(String value) {
		return (value == null);
	}

	public static String leftPad(String stringToPad, String padder, int size) {
		StringBuffer strb;
		StringCharacterIterator sci;

		if (padder.length() == 0)
			return stringToPad;

		if (isNull(stringToPad)) {
			char[] t = new char[size];
			for (int i = 0; i < t.length; i++)
				t[i] = padder.charAt(0);

			stringToPad = String.valueOf(t);
		}

		strb = new StringBuffer(size);
		sci = new StringCharacterIterator(padder);

		while (strb.length() < (size - stringToPad.length()))
			for (char ch = sci.first(); ch != CharacterIterator.DONE; ch = sci.next())
				if (strb.length() < size - stringToPad.length())
					strb.insert(strb.length(), String.valueOf(ch));
		return strb.append(stringToPad).toString();
	}
}