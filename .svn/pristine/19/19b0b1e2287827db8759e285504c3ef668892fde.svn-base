	@Transactional
	public DataMap resendPalletIf(DataMap map) throws SQLException {

	    List<DataMap> list = map.getList("list");

	    DataMap rsMap = new DataMap();

	    int successCnt = 0;
	    int failCnt = 0;

	    for (int i = 0; i < list.size(); i++) {

	        DataMap row = list.get(i).getMap("map");
	        map.clonSessionData(row);

	        DataMap selOne = new DataMap();
	        map.clonSessionData(selOne);

	        selOne.put("IF_VNDR_CD", row.getString("IF_VNDR_CD"));
	        selOne.put("CST_COD", row.getString("CST_COD"));
	        selOne.put("SEND_DAT", row.getString("SEND_DAT"));
	        selOne.put("SEND_SEQ", row.get("SEND_SEQ"));
	        selOne.put("IF_KEY", row.getString("IF_KEY"));

	        selOne.setModuleCommand("WmsMobileOutboundPicking_COPY", "TB_WMS_PALLET_IF_ONE");
	        DataMap wmsRow = commonDao.getMap(selOne);

	        if (wmsRow == null) {
	            failCnt++;
	            continue;
	        }

	        try {

	            String vndrCd = wmsRow.getString("IF_VNDR_CD");

	            if ("AJ".equals(vndrCd)) {

	                DataMap ajIfMap = buildAjIfMapForLoad(wmsRow);
	                callAjApi(ajIfMap);

	            } else {

	                DataMap ifData = new DataMap();
	                map.clonSessionData(ifData);

	                ifData.putAll(wmsRow);
	                ifData.put("IF_KEY", wmsRow.getString("EXT_IF_KEY"));
	                ifData.put("PRD_COD", wmsRow.getString("ITEM"));
	                ifData.put("ITEM", wmsRow.getString("ITEM"));
	                ifData.put("KPP_GET_YN", "N");

	                ifData.setModuleCommand("KppIF", "KPP_TB_IF_DATA");
	                kppDao.insert(ifData);
	            }

	            DataMap upd = new DataMap();
	            map.clonSessionData(upd);

	            upd.put("IF_VNDR_CD", wmsRow.getString("IF_VNDR_CD"));
	            upd.put("CST_COD", wmsRow.getString("CST_COD"));
	            upd.put("SEND_DAT", wmsRow.getString("SEND_DAT"));
	            upd.put("SEND_SEQ", wmsRow.get("SEND_SEQ"));
	            upd.put("IF_KEY", wmsRow.getString("IF_KEY"));

	            upd.put("IF_STATUS", "S");
	            upd.put("IF_ERR_MSG", null);

	            upd.setModuleCommand("WmsMobileOutboundPicking_COPY", "TB_WMS_PALLET_IF_STATUS");
	            commonDao.update(upd);

	            successCnt++;

	        } catch (Exception e) {

	            failCnt++;

	            DataMap upd = new DataMap();
	            map.clonSessionData(upd);

	            upd.put("IF_VNDR_CD", wmsRow.getString("IF_VNDR_CD"));
	            upd.put("CST_COD", wmsRow.getString("CST_COD"));
	            upd.put("SEND_DAT", wmsRow.getString("SEND_DAT"));
	            upd.put("SEND_SEQ", wmsRow.get("SEND_SEQ"));
	            upd.put("IF_KEY", wmsRow.getString("IF_KEY"));

	            String errMsg = e.getMessage() == null ? "ERROR" : e.getMessage();

	            if (errMsg.length() > 900) {
	                errMsg = errMsg.substring(0, 900);
	            }

	            upd.put("IF_STATUS", "E");
	            upd.put("IF_ERR_MSG", errMsg);

	            upd.setModuleCommand("WmsMobileOutboundPicking_COPY", "TB_WMS_PALLET_IF_STATUS");
	            commonDao.update(upd);
	        }
	    }

	    rsMap.put("MSG", "OK");
	    rsMap.put("SUCCESS_CNT", successCnt);
	    rsMap.put("FAIL_CNT", failCnt);

	    return rsMap;
	}
	
	
	@Transactional
	public DataMap PDLD21KioskSaveEnd(DataMap map) throws SQLException {
		
		String SERVER_TYPE =  PropertyUtil.getProperty("commonconfig.properties", "server.type");

		List<DataMap> head = map.getList("head");
		List<DataMap> plt = map.getList("plt");

		List<DataMap> list = new ArrayList<DataMap>();
		DataMap itemRowP;

		DataMap rsMap = new DataMap();
		int count = 0;
		StringBuilder sb = new StringBuilder();

		for (int i = 0; i < head.size(); i++) {

			DataMap itemRow = head.get(i).getMap("map");

			itemRow.put("WAREKY", map.getString("WAREKY"));
			itemRow.put("OWNRKY", map.getString("OWNRKY"));
			itemRow.put("PLNTKY", map.getString("PLNTKY"));

			if ("V".equals(itemRow.getString("FCKCOM")))
				continue;

			// ===============================
			// 출고 대상 조회 (팔렛트 정보 포함)
			// ===============================
			itemRow.put("SES_MTYPE", map.getString("SES_MTYPE"));
			itemRow.setModuleCommand("WmsMobileOutboundPicking", "PDLD21SUB_PLT");
			List<DataMap> selectList = commonDao.getList(itemRow);

			// SHPDH I/F CHECK 등 기존 로직이 더 있으면 여기 위쪽에 그대로 두면 됨

			for (int j = 0; j < selectList.size(); j++) {

				DataMap row = selectList.get(j);

				// ===============================
				// validation
				// ===============================
				row.put("WAREKY", map.getString("WAREKY"));
				row.put("OWNRKY", map.getString("OWNRKY"));
				row.put("PLNTKY", map.getString("PLNTKY"));

				DataMap validMap = commonDao.getMap("WmsMobileOutboundPicking.PDLD21Validation1", row);
				String validMsg = validMap.getString("MSG");

				if (!"OK".equals(validMsg)) {
					rsMap.put("MSG", validMsg);
					return rsMap;
				}

				// ===============================
				// 출고 확정 처리
				// ===============================
				row.put("LSTTFL", "V");
				row.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));
				row.put("SES_MTYPE", map.getString("SES_MTYPE"));

				commonDao.update("WmsMobileOutboundPicking.PDLD21Sub", row);

				DataMap totalQtyMap = commonDao.getMap("WmsMobileOutboundPicking.TOTAL_QTCOMP", row);
				row.put("QTSHPC", totalQtyMap.get("QTCOMP"));
				commonDao.update("WmsOutbound.DL05Sub", row);

				// WCS MOVE 처리대상 바코드 기존 로직 유지
				if ("3000".equals(row.getString("LOTA01")) && "P200".equals(row.getString("LOTA02"))
						&& "0".equals(row.getString("COUNT_LOCAKY"))
						&& ("RT3".equals(row.getString("LOTA04")) || "RT6".equals(row.getString("LOTA04")))) {
					if (sb.length() > 0)
						sb.append(",");
					sb.append(row.getString("LOTA14"));
				}

				// ===============================
				// 마지막 출하문서 처리후 파레트 등록 + KPP 연동
				// ===============================
				if (selectList.size() - 1 == j) {

					// =========================================================
					// 서명 저장 + SHPDI 팔렛트 라인 생성
					// =========================================================

					// 서명 삭제하고 저장하기
					row.setModuleCommand("WmsOutboundDL082", "SHPDH_SIGN");
					commonDao.delete(row);

					// 서명 저장하기
					row.setModuleCommand("WmsOutboundDL082", "SHPDH_SIGN");
					row.put("SIGN", plt.get(0).getMap("map").get("SIGN").toString());
					commonDao.insert(row);

					// 선적의 파레트 정보 모두 삭제후 실행하기
					row.setModuleCommand("WmsOutboundDL082", "PDADL08Sub");
					commonDao.delete(row);

					for (int p = 0; p < plt.size(); p++) {

						// 1) 바깥 wrapper
						DataMap wrapperMap = plt.get(p).getMap("map");

						// 2) 실제 팔레트 리스트: wrapperMap 안의 "PLT_LIST"
						Object innerObj = wrapperMap.get("PLT_LIST");
						if (!(innerObj instanceof List)) {
							continue; // 구조가 다르면 스킵
						}

						@SuppressWarnings("unchecked")
						List<DataMap> pltList = (List<DataMap>) innerObj;

						// 3) 실제 팔레트 row 반복
						for (int p1 = 0; p1 < pltList.size(); p1++) {

							itemRowP = pltList.get(p1);

							// 값 추출 (빈값/널 방어)
							String plt_skukey = itemRowP.getString("SKUKEY");
							String qtyStr = itemRowP.getString("QTY");

							if (qtyStr == null || qtyStr.trim().isEmpty()) {
								continue;
							}

							int plt_qty;
							try {
								plt_qty = Integer.parseInt(qtyStr.trim());
							} catch (NumberFormatException e) {
								continue;
							}

							// 수량 1 미만이면 스킵
							if (plt_qty < 1) {
								continue;
							}

							// ===== INSERT 파라미터 구성 =====
							DataMap itemPltRow = new DataMap();
							map.clonSessionData(itemPltRow);

							itemPltRow.put("SHPOKY", row.get("SHPOKY"));
							itemPltRow.put("SVBELN", row.get("SVBELN"));
							itemPltRow.put("STKNUM", row.get("STKNUM"));
							itemPltRow.put("LOTA01", row.get("LOTA01"));
							itemPltRow.put("LOTA02", row.get("LOTA02"));

							itemPltRow.put("SKUKEY", plt_skukey);
							itemPltRow.put("DESC01", plt_skukey);
							itemPltRow.put("DUOMKY", "EA");
							itemPltRow.put("QTSHPD", plt_qty);

							// ===== SHPOIT 채번 =====
							itemPltRow.setModuleCommand("WmsOutboundDL082", "SEARCHMAXSHPOIT");
							List<DataMap> shpdiMaxList = commonDao.getList(itemPltRow);

							int shpoit = Integer.parseInt(shpdiMaxList.get(0).getString("SHPOIT")) + 10;
							itemPltRow.put("SHPOIT", "1" + leftPad(String.valueOf(shpoit), "0", 5));

							// ===== INSERT =====
							itemPltRow.setModuleCommand("WmsOutboundDL082", "DL08Sub");
							commonDao.insert(itemPltRow);

							// SAP 팔레트 I/F 아래 로직 구현
							// outboundServiceDL082.saveDL081(map)
						}

					}

					// =========================================================
					// SAP I/F : 팔레트 라인 전부 INSERT 후 1번만 처리
					// =========================================================


					if (true) {

					    DataMap ifRow = new DataMap();

					    ifRow.put("SHPOKY", row.get("SHPOKY"));
					    ifRow.setModuleCommand("WmsOutbound", "DL08_PT");

					    List<DataMap> palletMapList = commonDao.getList(ifRow);

					    list.clear();
					    list = palletMapList;

					    String logseq;
					    logseq = ifRow.getString("LOGSEQNO");

					    ifRow.setModuleCommand("Erpif", "IFWMSLOGSEQNO");
					    logseq = commonDao.getMap(ifRow).getString("LOGSEQNO");

					    ifRow = new DataMap();

					    List<DataMap> chkList = new ArrayList<DataMap>();

					    for (DataMap chkRow : list) {

					        chkRow.getMap("map").put("STATE", "C");
					        chkRow.getMap("map").put("QTSHPD",
					                Double.parseDouble(chkRow.getMap("map").getString("QTSHPD")));

					        if (chkRow.getMap("map").getString("SHPOIT").substring(0, 1).equals("1")) {
					            chkList.add(chkRow);
					        }
					    }

					    // SAP 기존 파레트 입력정보 삭제 추가 필요

					    ifRow.put("list", chkList);
					    ifRow.put("STATE", "C");
					    ifRow.put("ownrky", "KN");
					    ifRow.put("IFID", "WMS_IF_780");
					    ifRow.put("LOGSEQNO", logseq);
					    ifRow.put(CommonConfig.SES_USER_ID_KEY,
					            map.get(CommonConfig.SES_USER_ID_KEY));

					    // 출고실적등록 인터페이스 호출
					    String insertErrMsg = ifservice.dataInsertIF(ifRow);

					    if (insertErrMsg != null) {
					        insertErrMsg = insertErrMsg.trim();
					    }

					    if (insertErrMsg != null && insertErrMsg.length() > 0
					            && !"SUCCESS".equalsIgnoreCase(insertErrMsg)
					            && !"OK".equalsIgnoreCase(insertErrMsg)) {

					        throw new RuntimeException("SAP IF INSERT ERROR : " + insertErrMsg);
					    }

					    DataMap resultMap = new DataMap();

					    resultMap = outboundService.sendIf(ifRow);

					    String sapResult = resultMap.getString("RESULT");
					    String sapMsg = resultMap.getString("MSG");
					    String sendMsg = resultMap.getString("sendMsg");

					    // 1. RESULT 기반 에러 판정
					    if ("E".equalsIgnoreCase(sapResult)
					            || "ERROR".equalsIgnoreCase(sapResult)
					            || "FAIL".equalsIgnoreCase(sapResult)) {

					        throw new RuntimeException("SAP IF SEND ERROR : " + sapMsg);
					    }

					    // 2. sendMsg 기준 판정 (실제 로그 기준)
					    if (sendMsg != null && sendMsg.trim().length() > 0) {

					        String chkMsg = sendMsg.trim();

					        if (chkMsg.contains("실패")
					                || chkMsg.contains("ERROR")
					                || chkMsg.contains("FAIL")
					                || chkMsg.contains("에러")) {

					            throw new RuntimeException("SAP IF SEND ERROR : " + chkMsg);
					        }
					    }

					    // 3. MSG 기반 보조 판정
					    if (sapMsg != null && sapMsg.trim().length() > 0
					            && !"OK".equalsIgnoreCase(sapMsg)
					            && !"SUCCESS".equalsIgnoreCase(sapMsg)
					            && !"S".equalsIgnoreCase(sapMsg)) {

					        throw new RuntimeException("SAP IF SEND ERROR : " + sapMsg);
					    }
					}
					// =========================================================
					// (0) 기존 생성(A) 건을 D로 변경 (STKNUM 기준) 추가
					// =========================================================
					try {
						DataMap del2 = new DataMap();
						map.clonSessionData(del2);

						del2.put("CST_COD", map.getString("CST_COD"));
						del2.put("WMS_STKNUM", row.getString("STKNUM"));
						del2.put("WMS_STATUS", "D");

						del2.setModuleCommand("WmsMobileOutboundPicking_COPY", "TB_WMS_PALLET_IF_WMS_STATUS_BY_STKNUM");
						commonDao.update(del2);

					
					} catch (Exception e) {
						System.out.println("[IF][WMS_STATUS->D][BY_STKNUM] ERROR=" + e.getMessage());
					}

					// =========================================================
					// (1) 팔렛트 입력 리스트 평탄화 (신규: map.PLT_LIST 우선)
					// =========================================================
					List<DataMap> pltListFlat = map.getList("PLT_LIST");

					if (pltListFlat == null || pltListFlat.size() == 0) {
						List<DataMap> tmp = new ArrayList<>();

						if (plt != null) {
							for (DataMap pltWrap : plt) {
								DataMap wrapMap = pltWrap.getMap("map");
								Object innerObj = wrapMap.get("PLT_LIST");
								if (innerObj instanceof List) {
									@SuppressWarnings("unchecked")
									List<DataMap> inner = (List<DataMap>) innerObj;
									tmp.addAll(inner);
								}
							}
						}
						pltListFlat = tmp;
					}

					// =========================================================
					// (2) 파레트 요약 (PRD_COD + DPTNKY 기준 집계)
					// key = "SKUKEY|PTNRKY"
					// =========================================================
					Map<String, Integer> palletSummary = new HashMap<String, Integer>();
					Map<String, DataMap> summaryInfoMap = new HashMap<String, DataMap>();
					List<String> keyOrder = new ArrayList<String>();

					for (DataMap pRow : pltListFlat) {

						String skuKey = pRow.getString("SKUKEY"); // 화면표시용
						String ifCode = pRow.getString("IFCODE"); // I/F용
						String vendor = pRow.getString("VENDOR"); // AJ/KPP
						String dptnky = pRow.getString("PTNRKY");
						String qtyStr = pRow.getString("QTY");

						if (ifCode == null || ifCode.trim().length() == 0)
							continue;
						if (qtyStr == null || qtyStr.trim().length() == 0)
							continue;
						if (vendor == null)
							vendor = "";
						if (dptnky == null)
							dptnky = "";

						int qty;
						try {
							qty = Integer.parseInt(qtyStr.trim());
						} catch (Exception e) {
							continue;
						}

						if (qty < 1)
							continue;

						String key = ifCode + "|" + dptnky + "|" + vendor;

						Integer oldQty = palletSummary.get(key);
						if (oldQty == null) {
							palletSummary.put(key, qty);
							keyOrder.add(key);

							DataMap infoRow = new DataMap();
							infoRow.put("SKUKEY", skuKey);
							infoRow.put("IFCODE", ifCode);
							infoRow.put("VENDOR", vendor);
							infoRow.put("PTNRKY", dptnky);

							summaryInfoMap.put(key, infoRow);
						} else {
							palletSummary.put(key, oldQty + qty);
						}
					}

					// =========================================================
					// (3) SEND_SEQ 시작값 조회 + IF_KEY 묶음키 생성
					// WMS IF_KEY = 전체 묶음키 유지
					// EXT_IF_KEY = 업체+납품처별 묶음키
					// =========================================================
					DataMap seqMap = new DataMap();
					map.clonSessionData(seqMap);
					seqMap.setModuleCommand("KppIF", "IFKPPSEQNO");

					int sendSeq = Integer.parseInt(commonDao.getMap(seqMap).getString("SEND_SEQ"));
					String sendDat = toDayYYYYMMDD();
					String ifKeyBundle = sendDat + String.format("%06d", sendSeq); // WMS 내부 묶음키

					// 업체+납품처별 EXT_IF_KEY 재사용용
					Map<String, String> extIfKeyMap = new HashMap<String, String>();

					// =========================================================
					// (4) WMS 테이블(TB_WMS_PALLET_IF)에 먼저 INSERT (품목+납품처별)
					// =========================================================
					List<DataMap> insertedWmsKeys = new ArrayList<DataMap>();

					for (int k = 0; k < keyOrder.size(); k++) {

					    String key = keyOrder.get(k);
					    int dlvQty = palletSummary.get(key);

					    DataMap sumInfo = summaryInfoMap.get(key);

					    String ifCode = sumInfo.getString("IFCODE");
					    String skuKey = sumInfo.getString("SKUKEY");
					    String dptnky = sumInfo.getString("PTNRKY");
					    String vndrCd = sumInfo.getString("VENDOR");

					    String prdCod = skuKey == null ? "" : skuKey.trim();
					    String itemCd = ifCode == null ? "" : ifCode.trim();
					    String prdCodNoHyphen = prdCod.replace("-", "");

					    String addr = row.getString("CST_ARV_CST_ADDR");
					    addr = addr == null ? " " : addr.substring(0, Math.min(addr.length(), 100));

					    // =========================
					    // EXT_IF_KEY = 업체+납품처별 묶음키
					    // =========================
					    String extGroupKey = (vndrCd == null ? "" : vndrCd.trim()) + "|" + (dptnky == null ? "" : dptnky.trim());

					    int currentSendSeq = sendSeq++;

					    String extIfKey = extIfKeyMap.get(extGroupKey);
					    if (extIfKey == null) {
					        extIfKey = sendDat + String.format("%06d", currentSendSeq);
					        extIfKeyMap.put(extGroupKey, extIfKey);
					    }

					    DataMap wmsIfRow = new DataMap();
					    map.clonSessionData(wmsIfRow);

					    String palletGb = map.getString("PALLET_GB");

					    String cstCod = "";
					    String cstSndCstCod = "";

					    if ("AJ".equals(vndrCd)) {
					        cstCod = "P015753";
					        cstSndCstCod = "P015753";
					    } else {
					        if ("20".equals(palletGb)) {
					            cstCod = "290398";
					            cstSndCstCod = "290398";
					        } else if ("10".equals(palletGb)) {
					            cstCod = "239239";
					            cstSndCstCod = "239239";
					        }
					    }

					    wmsIfRow.put("IF_VNDR_CD", vndrCd);
					    wmsIfRow.put("OWNRKY", map.getString("OWNRKY"));
					    wmsIfRow.put("CST_COD", cstCod);
					    wmsIfRow.put("SEND_DAT", sendDat);

					    // SEND_SEQ는 EXT_IF_KEY 채번에 사용된 업체+납품처 기준 seq
					    wmsIfRow.put("SEND_SEQ", currentSendSeq);
					    wmsIfRow.put("IF_KEY", ifKeyBundle);   // 내부 묶음키 유지
					    wmsIfRow.put("EXT_IF_KEY", extIfKey);  // 외부 전달용 납품처별 묶음키

					    wmsIfRow.put("WMS_STKNUM", row.getString("STKNUM"));
					    wmsIfRow.put("WMS_DPTNKY", dptnky);

					    if ("AJ".equals(vndrCd)) {
					        if (prdCod.length() <= 3) {
					            wmsIfRow.put("CHIT_NUM", row.getString("STKNUM") + prdCod);
					        } else {
					            wmsIfRow.put("CHIT_NUM", row.getString("STKNUM") + prdCod.substring(prdCod.length() - 3));
					        }
					    } else {
					        wmsIfRow.put("CHIT_NUM", row.getString("STKNUM") + prdCodNoHyphen);
					    }

					    wmsIfRow.put("WMS_STATUS", "A");
					    wmsIfRow.put("DATA_TYP", "01");
					    if ("KPP".equals(vndrCd)) {
					        wmsIfRow.put("DOC_TYP", "01");
					    } else {
					        wmsIfRow.put("DOC_TYP", "21");
					    }

					    wmsIfRow.put("MOVE_DATE", row.get("MOVE_DATE"));
					    wmsIfRow.put("SND_DAT", sendDat);
					    wmsIfRow.put("ARV_DAT", sendDat);
					    wmsIfRow.put("CST_SND_CST_COD", cstSndCstCod);
					    wmsIfRow.put("CST_SND_CST_NAM", "깨끗한나라(청주공장)");
					    wmsIfRow.put("CST_SND_CST_TEL", "043-230-7200");
					    wmsIfRow.put("CST_SND_CST_ADDR", "충북 청주시 흥덕구 강내면 태성1길 64 깨끗한나라 청주공장");

					    wmsIfRow.put("CST_ARV_CST_COD", row.getString("CST_ARV_CST_COD"));
					    wmsIfRow.put("CST_ARV_CST_NAM", row.getString("CST_ARV_CST_NAM"));
					    wmsIfRow.put("CST_ARV_CST_TEL", row.getString("CST_ARV_CST_TEL"));
					    wmsIfRow.put("CST_ARV_CST_ADDR", addr);

					    wmsIfRow.put("PRD_COD", prdCod);
					    wmsIfRow.put("DLV_QTY", dlvQty);

					    wmsIfRow.put("IF_STATUS", "N");
					    wmsIfRow.put("IF_ERR_MSG", " ");
					    wmsIfRow.put("REG_USR", map.get(CommonConfig.SES_USER_ID_KEY));

					    wmsIfRow.put("CST_ORD_CST_COD", row.getString("CST_ARV_CST_COD"));
					    wmsIfRow.put("CST_ORD_CST_NAM", row.getString("CST_ARV_CST_NAM"));
					    wmsIfRow.put("CST_ORD_CST_TEL", row.getString("CST_ARV_CST_TEL"));
					    wmsIfRow.put("CST_ORD_CST_ADDR", addr);

					    wmsIfRow.put("CAR_NUM", row.getString("CARNO"));
					    wmsIfRow.put("TRN_CST_NAM", " ");
					    wmsIfRow.put("DRIVER_NAM", " ");
					    wmsIfRow.put("DRIVER_TEL", row.getString("DRIVERCEL"));
					    wmsIfRow.put("ITEM", itemCd);
					    wmsIfRow.put("ETC_DESC", " ");
					    wmsIfRow.put("IF_ERR_MSG", " ");

					    wmsIfRow.setModuleCommand("WmsMobileOutboundPicking_COPY", "TB_WMS_PALLET_IF");
					    commonDao.insert(wmsIfRow);

						/*
						 * String ifVndrCd = wmsIfRow.getString("IF_VNDR_CD");
						 * 
						 * if ("AJ".equals(ifVndrCd)) { DataMap ajIfMap = new DataMap();
						 * 
						 * ajIfMap.put("ifKey", wmsIfRow.getString("EXT_IF_KEY"));
						 * ajIfMap.put("dataType", "01");
						 * 
						 * ajIfMap.put("sendDate", wmsIfRow.getString("SEND_DAT"));
						 * ajIfMap.put("storDate", wmsIfRow.getString("SEND_DAT"));
						 * 
						 * ajIfMap.put("delvCode", wmsIfRow.getString("CST_ARV_CST_COD"));
						 * ajIfMap.put("delvName", wmsIfRow.getString("CST_ARV_CST_NAM"));
						 * ajIfMap.put("delvTeln", wmsIfRow.getString("CST_ARV_CST_TEL"));
						 * ajIfMap.put("delvAddr", wmsIfRow.getString("CST_ARV_CST_ADDR"));
						 * 
						 * ajIfMap.put("ordeCode", wmsIfRow.getString("CST_ORD_CST_COD"));
						 * ajIfMap.put("ordeName", wmsIfRow.getString("CST_ORD_CST_NAM"));
						 * ajIfMap.put("ordeTeln", wmsIfRow.getString("CST_ORD_CST_TEL"));
						 * ajIfMap.put("ordeAddr", wmsIfRow.getString("CST_ORD_CST_ADDR"));
						 * 
						 * ajIfMap.put("storCode", wmsIfRow.getString("CST_ORD_CST_COD"));
						 * ajIfMap.put("storName", wmsIfRow.getString("CST_ORD_CST_NAM"));
						 * ajIfMap.put("storTeln", wmsIfRow.getString("CST_ORD_CST_TEL"));
						 * ajIfMap.put("storAddr", wmsIfRow.getString("CST_ORD_CST_ADDR"));
						 * 
						 * String ajPrdCod = wmsIfRow.getString("PRD_COD"); String ajPrdCodNoHyphen =
						 * ajPrdCod == null ? "" : ajPrdCod.replace("-", "");
						 * 
						 * ajIfMap.put("itemName", ajPrdCodNoHyphen); ajIfMap.put("itemCode",
						 * wmsIfRow.getString("ITEM")); ajIfMap.put("moveVolm",
						 * wmsIfRow.getString("DLV_QTY")); ajIfMap.put("moveBill",
						 * wmsIfRow.getString("CHIT_NUM"));
						 * 
						 * ajIfMap.put("carsCode", " "); ajIfMap.put("carsInfo",
						 * wmsIfRow.getString("CAR_NUM")); ajIfMap.put("driverName",
						 * wmsIfRow.getString("DRIVER_NAM")); ajIfMap.put("driverTeln",
						 * wmsIfRow.getString("DRIVER_TEL"));
						 * 
						 * String apiUrl =
						 * "http://aj-api-hub-stg.ajway.kr/aj/move/kleannara/postApi.do";
						 * HttpURLConnection conn = null; InputStream is = null;
						 * 
						 * try { URL url = new URL(apiUrl); conn = (HttpURLConnection)
						 * url.openConnection();
						 * 
						 * conn.setRequestMethod("POST"); conn.setRequestProperty("Content-Type",
						 * "application/json; charset=UTF-8"); conn.setDoOutput(true);
						 * 
						 * ObjectMapper mapper = new ObjectMapper(); String jsonBody =
						 * mapper.writeValueAsString(ajIfMap);
						 * 
						 * OutputStream os = conn.getOutputStream();
						 * os.write(jsonBody.getBytes("UTF-8")); os.flush(); os.close();
						 * 
						 * int responseCode = conn.getResponseCode();
						 * 
						 * try { if (responseCode >= 200 && responseCode < 300) { is =
						 * conn.getInputStream(); } else { is = conn.getErrorStream(); }
						 * 
						 * if (is != null) { BufferedReader br = new BufferedReader(new
						 * InputStreamReader(is, "UTF-8")); String line; StringBuffer response = new
						 * StringBuffer(); while ((line = br.readLine()) != null) {
						 * response.append(line); } br.close(); } } finally { if (is != null) try {
						 * is.close(); } catch (Exception ignore) {} }
						 * 
						 * } catch (Exception e) { e.printStackTrace(); } finally { if (conn != null) {
						 * conn.disconnect(); } } }
						 */

					    insertedWmsKeys.add(wmsIfRow);
					}
					for (DataMap wmsKey : insertedWmsKeys) {

						DataMap selOne = new DataMap();
						map.clonSessionData(selOne);

						selOne.put("IF_VNDR_CD", wmsKey.getString("IF_VNDR_CD"));
						selOne.put("CST_COD", wmsKey.getString("CST_COD"));
						selOne.put("SEND_DAT", wmsKey.getString("SEND_DAT"));
						selOne.put("SEND_SEQ", wmsKey.get("SEND_SEQ"));
						selOne.put("IF_KEY", wmsKey.getString("IF_KEY"));

						selOne.setModuleCommand("WmsMobileOutboundPicking_COPY", "TB_WMS_PALLET_IF_ONE");
						DataMap wmsRow = commonDao.getMap(selOne);

						if (wmsRow == null)
							continue;

						if (!"prod".equals(SERVER_TYPE)) {
							continue;
						}
						// TB_WMS_PALLET_IF에 저장된 업체코드 기준 AJ/KPP 판별
						String calVndrCd = wmsRow.getString("IF_VNDR_CD");

						try {

							// =====================================================
							// AJ / KPP 분기
							// =====================================================
							if ("AJ".equals(calVndrCd)) {

								// 상차처리는 dataType = "01"
								DataMap ajIfMap = buildAjIfMapForLoad(wmsRow); // dataType=01
								int rc = callAjApi(ajIfMap); // 2xx면 성공

							} else {

								// KPP: TB_IF_DATA INSERT
								DataMap ifData = new DataMap();
								map.clonSessionData(ifData);
								ifData.putAll(wmsRow);
								ifData.put("IF_KEY", wmsRow.getString("EXT_IF_KEY"));
								ifData.put("PRD_COD", wmsRow.getString("ITEM"));
								ifData.put("ITEM", wmsRow.getString("ITEM"));
								ifData.put("KPP_GET_YN", "N");
								ifData.setModuleCommand("KppIF", "KPP_TB_IF_DATA");

								

								kppDao.insert(ifData);
							}

							// =====================================================
							// 공통 성공 업데이트 (AJ/KPP 모두)
							// =====================================================
							DataMap upd = new DataMap();
							map.clonSessionData(upd);

							upd.put("IF_VNDR_CD", wmsKey.getString("IF_VNDR_CD"));
							upd.put("CST_COD", wmsKey.getString("CST_COD"));
							upd.put("SEND_DAT", wmsKey.getString("SEND_DAT"));
							upd.put("SEND_SEQ", wmsKey.get("SEND_SEQ"));
							upd.put("IF_KEY", wmsKey.getString("IF_KEY"));

							upd.put("IF_STATUS", "S");
							upd.put("IF_ERR_MSG", null);

							upd.setModuleCommand("WmsMobileOutboundPicking_COPY", "TB_WMS_PALLET_IF_STATUS");
							commonDao.update(upd);

						} catch (Exception e) {

							// =====================================================
							// 공통 실패 업데이트
							// =====================================================
							DataMap upd = new DataMap();
							map.clonSessionData(upd);

							upd.put("IF_VNDR_CD", wmsKey.getString("IF_VNDR_CD"));
							upd.put("CST_COD", wmsKey.getString("CST_COD"));
							upd.put("SEND_DAT", wmsKey.getString("SEND_DAT"));
							upd.put("SEND_SEQ", wmsKey.get("SEND_SEQ"));
							upd.put("IF_KEY", wmsKey.getString("IF_KEY"));

							String errMsg = (e.getMessage() == null ? "ERROR" : e.getMessage());
							if (errMsg.length() > 900) {
								errMsg = errMsg.substring(0, 900);
							}

							upd.put("IF_STATUS", "E");
							upd.put("IF_ERR_MSG", errMsg);

							upd.setModuleCommand("WmsMobileOutboundPicking_COPY", "TB_WMS_PALLET_IF_STATUS");
							commonDao.update(upd);

							throw new RuntimeException("LOAD IF FAIL: " + wmsKey.getString("IF_KEY"), e);
						}
					}
				}

				count++;
			}
		}

		rsMap.put("CNT", count);
		rsMap.put("BARCODS", sb.toString());
		rsMap.put("MSG", "OK");
		try {
			String wareky = map.getString("WAREKY");
			String ownrky = map.getString("OWNRKY");
			String topic = "BOARDSTEP_" + wareky + "_" + ownrky;

			List<DataMap> pushList = new ArrayList<DataMap>();

			DataMap pushMap = new DataMap();
			pushMap.put("WAREKY", wareky);
			pushMap.put("OWNRKY", ownrky);
			pushMap.put("STEP", "LOAD");

			pushList.add(pushMap);

			SseEventManager.sendEvent(topic, "BoardStep.refresh", pushList);
		} catch (Exception e) {
			e.printStackTrace();
		}
		return rsMap;
	}

	private int callAjApi(DataMap ajIfMap) throws Exception {

		//String apiUrl = "https://api-pub-kafka.stg.ajias.co.kr/aj/move/kleannara/postApi.do"; //개발 
		String apiUrl = "https://api-pub-kafka.ajias.co.kr/aj/move/kleannara/postApi.do"; //운영 

		HttpURLConnection conn = null;
		InputStream is = null;

		try {
			URL url = new URL(apiUrl);
			conn = (HttpURLConnection) url.openConnection();

			conn.setRequestMethod("POST");
			conn.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
			conn.setDoOutput(true);

			conn.setConnectTimeout(5000);
			conn.setReadTimeout(10000);

			ObjectMapper mapper = new ObjectMapper();
			String jsonBody = mapper.writeValueAsString(ajIfMap);

			System.out.println("[AJ API] Request JSON : " + jsonBody);

			OutputStream os = conn.getOutputStream();
			os.write(jsonBody.getBytes("UTF-8"));
			os.flush();
			os.close();

			int responseCode = conn.getResponseCode();
			System.out.println("[AJ API] Response Code : " + responseCode);

			// 2xx 성공 처리
			if (responseCode >= 200 && responseCode < 300) {
				is = conn.getInputStream(); // 204면 null일 수 있음
				String body = readStream(is);
				System.out
						.println("[AJ API] Response Body : " + (body == null || body.length() == 0 ? "(empty)" : body));
				return responseCode;
			}

			// 실패 처리(비-2xx)
			is = conn.getErrorStream();
			String errBody = readStream(is);
			throw new RuntimeException("AJ API FAIL rc=" + responseCode + ", body=" + errBody);

		} finally {
			if (is != null)
				try {
					is.close();
				} catch (Exception ignore) {
				}
			if (conn != null)
				conn.disconnect();
		}
	}

	private String readStream(InputStream is) throws Exception {
		if (is == null)
			return "";
		BufferedReader br = new BufferedReader(new InputStreamReader(is, "UTF-8"));
		String line;
		StringBuffer sb = new StringBuffer();
		while ((line = br.readLine()) != null)
			sb.append(line);
		br.close();
		return sb.toString();
	}

	private DataMap buildAjIfMapForLoad(DataMap wmsRow) {

		DataMap ajIfMap = new DataMap();

		ajIfMap.put("ifKey", wmsRow.getString("EXT_IF_KEY"));
		ajIfMap.put("dataType", "01"); // 상차처리

		ajIfMap.put("sendDate", wmsRow.getString("SEND_DAT"));
		ajIfMap.put("storDate", wmsRow.getString("ARV_DAT"));

		ajIfMap.put("delvCode", wmsRow.getString("CST_SND_CST_COD"));
		ajIfMap.put("delvName", wmsRow.getString("CST_SND_CST_NAM"));
		ajIfMap.put("delvTeln", wmsRow.getString("CST_SND_CST_TEL"));
		ajIfMap.put("delvAddr", wmsRow.getString("CST_SND_CST_ADDR"));

		ajIfMap.put("ordeCode", wmsRow.getString("CST_ORD_CST_COD"));
		ajIfMap.put("ordeName", wmsRow.getString("CST_ORD_CST_NAM"));
		ajIfMap.put("ordeTeln", wmsRow.getString("CST_ORD_CST_TEL"));
		ajIfMap.put("ordeAddr", wmsRow.getString("CST_ORD_CST_ADDR"));

		ajIfMap.put("storCode", wmsRow.getString("CST_ORD_CST_COD"));
		ajIfMap.put("storName", wmsRow.getString("CST_ORD_CST_NAM"));
		ajIfMap.put("storTeln", wmsRow.getString("CST_ORD_CST_TEL"));
		ajIfMap.put("storAddr", wmsRow.getString("CST_ORD_CST_ADDR"));

		 String prdCod = wmsRow.getString("PRD_COD");
		 String prdCodNoHyphen = prdCod == null ? "" : prdCod.replace("-", "");

		ajIfMap.put("itemName", prdCodNoHyphen);
			/* ajIfMap.put("itemName", wmsRow.getString("ITEM")); */
		ajIfMap.put("itemCode", wmsRow.getString("ITEM"));

		ajIfMap.put("moveVolm", String.valueOf(wmsRow.get("DLV_QTY")));
		ajIfMap.put("moveBill", wmsRow.getString("CHIT_NUM"));

		ajIfMap.put("carsCode", "");
		ajIfMap.put("carsInfo", wmsRow.getString("CAR_NUM"));
		ajIfMap.put("driverName", wmsRow.getString("DRIVER_NAM"));
		ajIfMap.put("driverTeln", wmsRow.getString("DRIVER_TEL"));

		return ajIfMap;
	}

