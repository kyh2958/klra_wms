	@Transactional(rollbackFor = Exception.class)
	public DataMap PDPK05SaveEnd(DataMap map) throws SQLException {

		List<DataMap> headList = map.getList("head");
		List<DataMap> realList = new ArrayList<DataMap>();

		List<DataMap> saveItemList = new ArrayList<DataMap>();
		List<DataMap> taskkyList = new ArrayList<DataMap>();

		String stdTaskky = map.getString("TASKKY");
		String stdTaskit = map.getString("TASKIT");
		String stdShpoky = map.getString("SHPOKY");
		String stdShpoit = map.getString("SHPOIT");
		String stdLocaky = map.getString("LOCAKY");

		DataMap HeadRowMap = new DataMap();

		int count = 1;
		String shpmty = "";
		String svbeln = "";
		String sposnr = "";
		String stknum = "";
		String stpnum = "";
		String ssornu = "";
		String ssorit = "";

		DataMap rowTot = new DataMap();

		DataMap rsRowMap = new DataMap();
		DataMap rsMap = new DataMap();
		DataMap rqMap = new DataMap();

		SimpleDateFormat fmDate = new SimpleDateFormat("yyyyMMdd", Locale.KOREA);
		String date = fmDate.format(new Date());
		SimpleDateFormat fmTime = new SimpleDateFormat("HHmmss", Locale.KOREA);
		String time = fmTime.format(new Date());

		boolean insFlag = false;

		// SHPDH I/F CHECK
		for (int j = 0; j < headList.size(); j++) {
			rsRowMap = headList.get(j).getMap("map");
			rsMap.setModuleCommand("WmsTask", "VALIDATION_SHPDH");
			rsMap.put("SHPOKY", rsRowMap.get("SHPOKY"));
			rqMap = commonDao.getMap(rsMap);

			if (rqMap != null && !rqMap.getString("SHPOKY").equals(" ")) {
				rsMap.put("SHPOKY", rqMap.getString("SHPOKY"));

				return rsMap;
			}

		}

		DataMap rsRowsMap = new DataMap();
		DataMap taskRowMap = new DataMap();

		List<DataMap> headsList = map.getList("head");

		// 2.TASK 정보 조회
		map.setModuleCommand("WmsMobileOutboundPicking", "PDPK05_SAVE");
		List<DataMap> taskList = commonDao.getList(map);

		double pikQty = 0;
		double taskPikQty = 0;

		double totalQttoar = Double.valueOf(map.getString("TOTQTTAOR").replace(",", ""));
		double totalQtcomp = Double.valueOf(map.getString("TOTQTTAOR").replace(",", ""));
		double sumTotalQtcomp = 0;

		boolean delFlag = false;
		boolean cancelFlag = false;

		for (int j = 0; j < headList.size(); j++) {
			rsRowMap = headList.get(j).getMap("map");

			pikQty = Double.valueOf(rsRowMap.getString("QTCOMP").replace(",", ""));
			double totpikQty = pikQty;

			delFlag = true;

			for (int i = 0; i < taskList.size(); i++) {
				taskRowMap = taskList.get(i).getMap("map");

				if (rsRowMap.getString("LOTA14").equals(taskRowMap.getString("LOTA14"))
						&& rsRowMap.getString("SKUKEY").equals(taskRowMap.getString("SKUKEY"))
						&& rsRowMap.getString("LOCAKY").equals(taskRowMap.getString("LOCASR"))) {
					// System.out.println("TASK : " + taskRowMap.getString("TASKKY") + " : " +
					// taskRowMap.getString("TASKIT"));

					delFlag = false;

					if (totpikQty <= 0) {
						continue;
					}

					if (Double.valueOf(taskRowMap.getString("QTTAOR").replace(",", "")) > 0) {
						if (pikQty > Double.valueOf(taskRowMap.getString("QTTAOR").replace(",", ""))) {
							pikQty = pikQty - Double.valueOf(taskRowMap.getString("QTTAOR").replace(",", ""));
							taskPikQty = Double.valueOf(taskRowMap.getString("QTTAOR").replace(",", ""));
						} else {
							taskPikQty = pikQty;
						}
					} else {
						// taskPikQty = pikQty;
						taskPikQty = Double.valueOf(taskRowMap.getString("QTCOMP").replace(",", ""));
					}

					totpikQty -= taskPikQty;
					sumTotalQtcomp += taskPikQty;

					// update task : taskPikQty

