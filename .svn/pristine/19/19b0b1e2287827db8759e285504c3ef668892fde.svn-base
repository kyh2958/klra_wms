		String date = fmDate.format(new Date());
		SimpleDateFormat fmTime = new SimpleDateFormat("HHmmss", Locale.KOREA);
		String time = fmTime.format(new Date());

		boolean insFlag = false;

		// SHPDH I/F CHECK
		for (int j = 0; j < headList.size(); j++) {
			rsRowMap = headList.get(j).getMap("map");
			rsMap.setModuleCommand("WmsTask", "VALIDATION_SHPDH");
			rsMap.put("SHPOKY", rsRowMap.get("SHPOKY"));
			rqMap = commonDao.getMap(rsMap);

			if (rqMap != null && !rqMap.getString("SHPOKY").equals(" ")) {
				rsMap.put("SHPOKY", rqMap.getString("SHPOKY"));

				return rsMap;
			}

		}

		for (int m = 0; m < headList.size(); m++) {

			HeadRowMap = headList.get(m).getMap("map");

			String shpoky = HeadRowMap.getString("SHPOKY");
			String shpoit = HeadRowMap.getString("SHPOIT");
			String taskkyHead = HeadRowMap.getString("TASKKY");
			String taskitHead = HeadRowMap.getString("TASKIT");
			Double qty = Double.parseDouble((String) HeadRowMap.get("QTTAOR"));
			Double qttaor = Double.parseDouble((String) HeadRowMap.get("QTTAOR"));
			Double qtcomp = Double.parseDouble((String) HeadRowMap.get("QTCOMP"));

			if (qtcomp == 0) {
				continue;
			}

			map.put("SHPOKY", shpoky);
			map.put("SHPOIT", shpoit);

			rowTot.put("TASKKY", taskkyHead);
			rowTot.put(CommonConfig.SES_USER_ID_KEY, map.get(CommonConfig.SES_USER_ID_KEY));

			// 1. SHPDH, SHPDI, TASDI 정보 조회
			HeadRowMap.setModuleCommand("WmsOutbound", "SEARCHSHPDH");
			DataMap shpdhMap = commonDao.getMap(HeadRowMap);
			HeadRowMap.setModuleCommand("WmsOutbound", "SEARCHSHPDI");
