													</dd>
												</dl>
												
												<dl>
													<dt CL="STD_ZONEKY">구역</dt>
													<dd>
														<input type="text" class="input" name="ZONEKY" UIInput="R,SHZONMA" UIFormat="S 10" />
													</dd>
												</dl>
												
												<dl>
													<dt CL="STD_LOCAKY">지번</dt>
													<dd>
														<input type="text" class="input" name="LOCAKY" UIInput="R,SHLOCMA" UIFormat="S 10" />
													</dd>
												</dl>
												
												<dl>
													<dt CL="STD_TKZONE">작업구역</dt>
													<dd>
														<input type="text" class="input" name="TKZONE" id="TKZONE" UIInput="R,SHZONMA" UIFormat="S 10" />
													</dd>
												</dl>
											</div>
										</div>
										
