													<dd>
														<input type="text" class="input" name="LOTA13" UIFormat="N 10" id="LOTA13RD" />&nbsp;<label CL="STD_DAY" />
													</dd>
												</dl>
												
												<dl>
													<dt CL="STD_SKUL01">품목구분</dt>
													<dd>
