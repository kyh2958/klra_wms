<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!doctype html>
<head>
<style type="text/css">
button {
	vertical-align: bottom;
	height: 37px;
}
</style>
<meta charset="utf-8">
<meta name="viewport" content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width, target-densitydpi=medium-dpi" />
<meta name="format-detection" content="telephone=no" />
<title>Smile Mobile WMS</title>
<%@ include file="/mobile/include/head.jsp" %>
<script>
	//var chkFlag = true;
	var chkObjId = "";
	var isGhostBarcod = false;
	
	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",
			module : "WmsInventory",
			command : "PDST01",
			gridMobileType : true
		});
		
		gridList.setGrid({
			id : "gridListSkuSum",
			module : "WmsInventory",
			command : "PDST01SKUSUM",
			gridMobileType : true
		});

		$("#BARCOD").focus();
		
		$(".tableWrap_search").scroll(function(){
			$(".tableWrap_search").scrollLeft($(".tableWrap_search").scrollLeft());
		})
	})
	
	function onReadBarcode() {
		var param = inputList.setRangeParam("searchArea");
		var BARCOD = param.get('BARCOD');
		if (!BARCOD) {
			commonUtil.msgBox("COMMON_M0009", '바코드', null, function() {
				$('#BARCOD').focus();
			}); // {0}을(를) 입력해주세요.
			return false;
		}
		
		var BARCOD = $('#BARCOD').val();
		
		var gridDataList = gridList.getGridData('gridList');
		var finded = gridDataList.find(x => { return x.get("LOTA14") == BARCOD })
		if (finded) {
			gridList.setColFocus('gridList', finded.get('GRowNum'), 'LOTA14');
			$(".tableWrap_search:eq(1)").animate(({scrollTop: $("#gridList tr:eq(0)").outerHeight() * finded.get('GRowNum')}), 100);
		} else {
			searchList();
		}
		
		$("#BARCOD").focus();
	}
	
	function onReadLocaky(type){
		var param = inputList.setRangeParam("searchArea");
		var targetLOCAKY = param.get("LOCAKY");

		if (targetLOCAKY != undefined && targetLOCAKY != "") {
			targetLOCAKY = targetLOCAKY.toUpperCase();
		}
		
		param.remove('BARCOD');
		param.remove('LOCAKY');
		param.put('WAREKY', '<%=wareky%>');
		param.put("OWNRKY", "<%=ownrky%>");
		
		var json = netUtil.sendData({
			module : "WmsInventory",
			command : "PDMV01LOCMA",
			param : param
		});
		
		if (!json ||
			!json.data ||
			json.data.length == 0
		) { // 미조회 시
			commonUtil.msgBox("VALID_M0005");
			return;
		} else {
			
			if (type == 'find') {
				param.put("json", json);

				var finded = json.data.find(
					x => { return x.LOCAKY == targetLOCAKY }
				);
				
				if (finded) {
					param.put("AREAKY", finded.AREAKY);
					param.put("ZONEKY", finded.ZONEKY);
				}

				mobile.linkPopOpen('/mobile/PDLOC_POP.page', param);
			} else {
				param.put("LOCAKY", targetLOCAKY);
				LocPopCallback(param)
			}
		}
	}
	
	function LocPopCallback(data) {
		$('#LOCAKY').val(data.get("LOCAKY"));
		searchList();
	}

	function searchList(){
		var param = inputList.setRangeParam("searchArea");
		param.put("WAREKY", "<%=wareky%>");
		param.put("OWNRKY", "<%=ownrky%>");
		
		gridList.gridList({
			id : "gridList",
			param : param
		});
		
		gridList.gridList({
			id : "gridListSkuSum",
			param : param
		});
		
		$("#BARCOD").focus();
		
		
		// gridList.prependJson('gridList', jsonObj);
	}
	
	function searchEndEventFunction(){
		$("#BARCOD").focus();
	}
	
	function gridListEventDataBindEnd(gridId, dataLength){
		
		if (gridId == "gridList") {
			if (dataLength == 0) {
				PlaySound('e');
			} else {
				PlaySound('s');
				
				var gridDataList = gridList.getGridData('gridList');
				var finded = gridDataList.find(x => { return x.get("LOTA14") == $('#BARCOD').val() })
				if (finded) {
					gridList.setColFocus('gridList', finded.get('GRowNum'), 'LOTA14');
				} else {
					isGhostBarcod = true;
				}
				
				var tdDesc01Index = $("#tableHeader th").filter(function(i){
					if($(this).attr('CL') == 'STD_DESC01'){
						return i;
					}
				}).index();
	
				for(var i = 0; i< dataLength;i++){
					$("#gridList tr:eq("+i+") td:eq("+tdDesc01Index+")").text(gridList.getColData(gridId,i,"DESC01").replace(/깨끗한나라|보솜이|프레미뇽|디어스킨|메디프렌즈/g, ""));
				}
				
				if ($('#BARCOD').val() && !isGhostBarcod) {
					// 바코드 포커싱을 위한 호출
					onReadBarcode()
				}
			}
			
			$('#BARCOD').focus();
		}else if (gridId == "gridListSkuSum") {
			if (dataLength > 1) {

				//var totalSum = gridList.getRowData(gridId, 0);
				var totalSum = new DataMap();

				totalSum.put("SKUKEY", " ");
				totalSum.put("DESC01", "총합계");
				totalSum.put("BAGQT", 0);
				totalSum.put("BOXQT", 0);
				totalSum.put("EAQTY", 0);
				totalSum.put("PLTQT", 0);
				totalSum.put("QTSALO", 0);
				totalSum.put("QTSBLK", 0);
				totalSum.put("QTSCNU", 0);
				totalSum.put("QTSHQT", 0);
				totalSum.put("QTSIQT", 0);
				totalSum.put("QTSIWH", 0);
				totalSum.put("QTSPMI", 0);
				totalSum.put("QTSPMO", 0);
				totalSum.put("QTSWQT", 0);
				totalSum.put("SOKQT", 0);
				totalSum.put("TOTWG", 0);
				totalSum.put("USEQTY", 0);
				totalSum.put("LOTA14", 0);

				for(var i = 0; i< dataLength;i++){
					totalSum.map["BAGQT"] += Number(gridList.getColData(gridId,i,"BAGQT"));
					totalSum.map["BOXQT"] += Number(gridList.getColData(gridId,i,"BOXQT"));
					totalSum.map["EAQTY"] += Number(gridList.getColData(gridId,i,"EAQTY"));
					totalSum.map["PLTQT"] += Number(gridList.getColData(gridId,i,"PLTQT"));
					totalSum.map["QTSALO"] += Number(gridList.getColData(gridId,i,"QTSALO"));
					totalSum.map["QTSBLK"] += Number(gridList.getColData(gridId,i,"QTSBLK"));
					totalSum.map["QTSCNU"] += Number(gridList.getColData(gridId,i,"QTSCNU"));
					totalSum.map["QTSHQT"] += Number(gridList.getColData(gridId,i,"QTSHQT"));
					totalSum.map["QTSIQT"] += Number(gridList.getColData(gridId,i,"QTSIQT"));
					totalSum.map["QTSIWH"] += Number(gridList.getColData(gridId,i,"QTSIWH"));
					totalSum.map["QTSPMI"] += Number(gridList.getColData(gridId,i,"QTSPMI"));
					totalSum.map["QTSPMO"] += Number(gridList.getColData(gridId,i,"QTSPMO"));
					totalSum.map["QTSWQT"] += Number(gridList.getColData(gridId,i,"QTSWQT"));
					totalSum.map["SOKQT"] += Number(gridList.getColData(gridId,i,"SOKQT"));
					totalSum.map["TOTWG"] += Number(gridList.getColData(gridId,i,"TOTWG"));
					totalSum.map["USEQTY"] += Number(gridList.getColData(gridId,i,"USEQTY"));
					totalSum.map["LOTA14"] += Number(gridList.getColData(gridId,i,"LOTA14"));
				}

				for (var key in totalSum.map) {
					if (totalSum.map[key] > 0) {
						totalSum.map[key] = totalSum.map[key].toFixed(1);
					}
				} 
				
				gridList.addNewRow(gridId, totalSum);
			}
		}
		
	}
	
	function gridListEventRowDblclick(gridId, rowNum, colName, colValue) {
		
		if (gridId == 'gridList') {
			var fRow = gridList.getFocusRowNum("gridList");
			var row  = gridList.getRowData("gridList", fRow);
			mobile.linkPopOpen('/mobile/PDST01_POP.page',row);
		}
	}
	
	function fn_onfocus(objId){
		$("#"+objId).select();
	}
	
</script>
</head>
<body>
	<div class="main_wrap">
		<div class="tem4_content">
			<div class="select_box">
				<table>
					<colgroup>
					<col width="25%" />
					<col width="25%" />
					<col width="25%" />
					<col width="25%" />
					</colgroup>
					<tbody id="searchArea">
						<tr>
							<th CL="STD_LOCAKY">로케이션</th>
							<td colspan="2">
								<input type="text" class="text" name="LOCAKY" id="LOCAKY" onfocus="fn_onfocus(this.id)" onkeypress="commonUtil.enterKeyCheck(event, 'onReadLocaky()')"/>
								
							</td>
							<td onclick ="onReadLocaky('find')">
								<button class="bt" style="height: 32px;"><p CL='BTN_FINDDATA'></p></button>
							</td>
						</tr>
						<tr>
							<th CL="STD_BARCOD">바코드</th>
							<td colspan="3">
								<input type="text" class="text" name="BARCOD" id="BARCOD" onfocus="fn_onfocus(this.id)" inputmode="none" onkeypress="commonUtil.enterKeyCheck(event, 'onReadBarcode()')" />
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="tableWrap_search section">
				<div class="tableHeader" id='tableHeader'>
					<table style="width: 100%">
						<colgroup>
							<col width="40px" />
							<col width="130px" />
							<col width="130px" />
							<col width="70px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="55px" />
							<col width="40px" />
							<col width="120px" />
							<col width="80px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="90px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="80px" />
						</colgroup>
						<thead>
							<tr>
								<th CL="STD_NUMBER">1</th>
								<th CL="STD_SKUKEY">품목코드</th>
								<th CL="STD_DESC01">품목명</th>
								<th CL="STD_LOCAKY">지번</th>
								<th CL='STD_BOXQT'>BAG/BOX</th>
								<th CL='STD_PLTQT'>BOX/Pallet</th>
								<th CL="STD_LOTA06">재고상태</th>
								<th CL="STD_QTSIWH">재고수량</th>
								<th CL="STD_UOMKEY">단위</th>
								<th CL="STD_LOTA14">개별바코드</th>
								<th CL="STD_USEQTY">가용수량</th>
								<th CL="STD_QTSCNU">불용수량</th> <!-- Can Not Use -->
								<th CL="STD_QTSIQT">품질수량</th> <!-- Inspection QuanTity -->
								<th CL="STD_QTSWQT">폐기수량</th> <!-- Wasted     QuanTity -->
								<th CL='STD_QTSHQT'>보류수량</th> <!-- Hold       QuanTity -->
								<th CL="STD_QTSALO">할당수량</th>
								<th CL='STD_TOTWG'>총중량</th>
								<th CL="STD_QTSPMO">이동OUT</th>
								<th CL="STD_QTSPMI">이동IN</th>
								<th CL="STD_SKUL01">품목구분</th>
								<th CL="STD_WAREKY">거점</th>
								<th CL="STD_WARENM">거점명</th>
								<th CL="STD_LOTA02">플랜트</th>
								<th CL="STD_ZONEKY">구역</th>
								<th CL='STD_BAGQT'>EA/BAG</th>
								<th CL='STD_SOKQT'>속(개/BALE)</th>
								<th CL='STD_EAQTY'>매(sheet/속)</th>
							</tr>
						</thead>
					</table>
				</div>
			</div>
			<div class="tableWrap_search section">
				<div class="tableBody">
					<table style="width: 100%">
						<colgroup>
							<col width="40px" />
							<col width="130px" />
							<col width="130px" />
							<col width="70px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="55px" />
							<col width="40px" />
							<col width="120px" />
							<col width="80px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="90px" />
							<col width="50px" />
							<col width="50px" />
							<col width="50px" />
							<col width="80px" />
							<col width="50px" />
						</colgroup>
						<tbody id="gridList">
							<tr CGRow="true">
								<td GCol="rownum">1</td>
								<td GCol="text,SKUKEY">품목코드</td>
								<td GCol="text,DESC01">품목명</td>
								<td GCol="text,LOCAKY">지번</td>
								<td Gcol="text,BOXQT">BOXQT</td>
								<td Gcol="text,PLTQT">BOX/Pallet</td>
								<td Gcol="text,LOTA06NM">재고상태</td>
								<td GCol="text,QTSIWH" GF="N 20,2">재고수량</td>
								<td GCol="text,UOMKEY">단위</td>
								<td GCol="text,LOTA14">개별바코드</td>
								<td GCol="text,USEQTY" GF="N 20,2">가용수량</td>
								<td GCol="text,QTSCNU" GF="N 20,2">불용수량</td> <!-- Can Not Use -->
								<td GCol="text,QTSIQT" GF="N 20,2">품질수량</td> <!-- Inspection QuanTity -->
								<td GCol="text,QTSWQT" GF="N 20,2">폐기수량</td> <!-- Wasted     QuanTity -->
								<td GCol="text,QTSHQT" GF="N 20,2">보류수량</td> <!-- Hold       QuanTity -->
								<td GCol="text,QTSALO" GF="N 20,2">할당수량</td>
								<td Gcol="text,TOTWG">총중량</td>
								<td GCol="text,QTSPMO" GF="N 20,2">이동OUT</td>
								<td GCol="text,QTSPMI" GF="N 20,2">이동IN</td>
								<td GCol="text,SKUL01NM">품목구분</td>
								<td Gcol="text,WAREKY">거점</td>
								<td Gcol="text,WARENM">거점명</td>
								<td Gcol="text,LOTA02">플랜트</td>
								<td GCol="text,ZONEKY">구역</td>
								<td Gcol="text,BAGQT">EA/BAG</td>
								<td Gcol="text,EAQTY">매(sheet/속)</td>
								<td Gcol="text,SOKQT">>속(개/BALE)</td>
							</tr>
						</tbody>
					</table>
					<%
				if(mtype.equals("P")){
			%>
		            <jsp:include page="./PDST01_PS.jsp" flush="false"/>
			<%
				}else {
			%>
		        	<jsp:include page="./PDST01_ELSE.jsp" flush="false"/>
			<% 
				}
			%>  
				</div>
			</div>
		</div>
		<div class="footer_5" style="position:fixed;">
			<table>
				<tr>
					<td class=f_1 width="50%" onclick="window.top.closePage()">
						<label CL='BTN_CLOSE'></label>
					</td>
				</tr>
			</table>
		</div>
	</div>
</body>