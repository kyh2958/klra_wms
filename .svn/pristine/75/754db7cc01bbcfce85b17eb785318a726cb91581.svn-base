							</tr>
						</tbody>
					</table>
				</div>
			</div>
			
			<!-- end table_body -->
			<div class="select_box">
				<table>
					<colgroup>
						<col width="25%" />
						<col width="25%" />
						<col width="25%" />
						<col width="25%" />
					</colgroup>
					<tbody>
						<!-- 수작업인 경우 WCS입고 로케이션 정보 선택필요, 기본값은 수작업 A구역 -->
						<tr style='visibility: hidden;' id='wcsManual'>
							<th CL='WCS_LOCATG'>수작업 로케이션</th>
							<td colspan="3">
								<select id='WCS_LOC' name='WCS_LOC'>
									<option value='' selected>선택</option>
									<option value='A'>A</option>
									<option value='B'>B</option>
								</select>
							</td>
						</tr>
						<tr>
							<th CL='STD_LOCATG'>To 로케이션</th>
							<td colspan="2">
								<input type="text" class="text" name="LOC_TEMP" id="LOC_TEMP" onfocus="fn_onfocus(this.id)" onchange="onReadTargetLocation(this.value)" value='RCVLOC'/>
							</td>
							<td onclick ="searchLocMstList()">
								<button class="bt" style="height: 32px;">
									<p CL='BTN_FINDDATA'></p>
								</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="footer_5" style="position:fixed;">
<!-- 			<div class="footer_5" "> -->
				<table>
					<tr>
						<td class=f_1 onclick="showMain()" width="33.3%"><label CL='BTN_CLOSE'></label></td>
						<td class=f_1 onclick="clearData()" width="33.3%"><label CL='BTN_CLEAR'></label></td>
						<td class=f_1 onclick="saveData()" width="33.3%"><label CL='STD_INBOUND'></label></td>
					</tr>
				</table>
			</div><!-- end footer_5 -->	
		</div>
	</div>
</body>