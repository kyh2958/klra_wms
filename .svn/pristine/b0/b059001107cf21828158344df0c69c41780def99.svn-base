	<select id="DBMSPROC_SZP_INS_TASDR_MAP" parameterType="Map" resultType="DataMap">
		{ call SZP_INS_TASDR(#{TASKKY}, #{TASKIT}, #{STOKKY}, #{QTTAOR}, #{QTCOMP}) }
	</select>
	<!-- ================================================================================================== -->
	<!-- PDPKRM01 라이펜뮐러 팔레트별 피킹 : END-->
	<!-- ================================================================================================== -->
	
	
	<!-- ================================================================================================== -->
	<!-- PDDL05 WAVE별 출고검수 : START-->
	<!-- ================================================================================================== -->
	<!-- PDDL05 WAVE별 출고검수 조회-->
	<select id="PDDL05_LIST" parameterType="Map" resultType="DataMap">
		SELECT SI.SHPOKY AS SHPOKY
				, SI.SHPOIT AS SHPOIT
				, SH.WAREKY AS WAREKY
				, SH.OWNRKY AS OWNRKY
				, SI.QTYORG AS QTYORG
				, SI.QTSHPO AS QTSHPO
				, (SI.QTSHPO-SI.QTALOC) AS QTUALO
				, SI.QTALOC AS QTALOC
				, SI.QTSHPD AS QTSHPD
				, SI.QTSHPC AS QTSHPC
				, SI.QTJCMP AS QTJCMP
				, SI.SKUKEY AS SKUKEY
				, SI.DESC01 AS DESC01
				, CT.NAME01 AS PTNRNM
				, SI.STATIT AS STATIT
				, NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = SI.STATIT),' ') AS STATNM
                , SI.ESHPKY AS ESHPKY
                , SI.ESHPIT AS ESHPIT				
		  FROM SHPDI SI
			INNER JOIN SHPDH SH ON SH.SHPOKY = SI.SHPOKY
			LEFT OUTER JOIN BZPTN CT ON CT.PTNRKY = SH.DPTNKY AND CT.PTNRTY = 'CT' AND CT.OWNRKY = SH.OWNRKY
		 WHERE SI.SHPOKY = #{SHPOKY}
		<if test="SKUKEY != null and SKUKEY != ''">
		   AND SI.SKUKEY = #{SKUKEY}
		</if>
	</select>
	
	<!-- 분배우선순위 쿼리 -->
	<select id="PDDL05SEQ_LIST" parameterType="Map" resultType="DataMap">
		SELECT SEQCUS
		 FROM SHPDH SH
			LEFT OUTER JOIN ALCUS AL ON AL.WAREKY = #{SES_WAREKY} AND AL.DOCUTY = SH.SHPMTY
		WHERE SH.WAREKY = #{SES_WAREKY}
		  AND SHPOKY = #{SHPOKY}
	</select>
	
	<!-- 분배 조회 -->
	<select id="PDDL05Detail_LIST" parameterType="Map" resultType="DataMap">
		SELECT SI.ESHPKY --그룹오더번호
			 , SI.ESHPIT
			 , SI.SHPOKY --출하문서번호
			 , SI.SHPOIT
			 , IFW.KUNAG AS PTNRKY  --거래처
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'CT' AND PTNRKY = IFW.KUNAG AND ROWNUM = 1) AS PTNRNM
			 , SM.SKUKEY
			 , SM.DESC01
			 , SM.DESC02
			 , SI.QTYORG
			 , SI.QTSHPO
			 , SI.QTJCMP
			 , SI.QTSHPC
		 FROM SHPDH SH
			LEFT OUTER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
			LEFT OUTER JOIN SKUMA SM ON SM.SKUKEY = SI.SKUKEY AND SM.OWNRKY = SH.OWNRKY
			LEFT OUTER JOIN IFWMS113 IFW ON IFW.VBELN = SI.REFDKY AND IFW.SKUKEY = SI.SKUKEY AND IFW.WAREKY = SH.WAREKY
		WHERE SI.ESHPKY = #{S_SHPOKY}
		  AND SM.SKUKEY = #{S_SKUKEY}
	</select>
	
	<!-- 저장시 검수수량 update -->
	<update id="PDDL05_UPDATE" parameterType="Map">
		UPDATE SHPDI
		   SET QTSHPC = #{QTSHPC}
			 , STATIT = #{STATIT}
			 , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		 WHERE SHPOKY = #{SHPOKY}
		   AND SHPOIT = #{SHPOIT}
	</update>
	<!-- ================================================================================================== -->
	<!-- PDDL05 WAVE별 출고검수 : END -->
	<!-- ================================================================================================== -->
	
	
	<!-- ================================================================================================== -->
	<!-- PDPK05 지시번호별 피킹 : END-->
	<!-- ================================================================================================== -->
	<select id="PDPK05_DOC_LIST" parameterType="Map" resultType="DataMap">
	SELECT STKNUM 
		, STKNUM_STATUS
		, (SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = STATDO) AS TASKSTATDONM 
		, (SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATDO' AND CMCDVL = STATDO2) AS STATDONM 
	FROM (
        
		SELECT STKNUM , CASE WHEN STKNUM_STATUS = 'O' THEN '오더번호'
                             WHEN STKNUM_STATUS = 'S' THEN '선적번호'   
                             WHEN STKNUM_STATUS = 'T' THEN '토탈피킹번호'
                        END STKNUM_STATUS
                       ,CASE WHEN STATDO LIKE '%FPC%' AND STATDO LIKE '%PPC%'
							                         THEN 'PPC'					                       					                                                                
		                                           WHEN STATDO LIKE '%FPC%'
							                         THEN 'FPC'					                       					                                                                       
		                                           WHEN STATDO LIKE '%PPC%'
							                         THEN 'PPC'					                       					                                                                         
		                                           WHEN STATDO LIKE '%NEW%'
							                         THEN 'NEW'					                       					                                                                           
							                  	  ELSE STATDO  
		                 END STATDO
		                 , STATDO2
		FROM (
		
				SELECT NVL(TRIM(TI.STKNUM), TI.SVBELN) AS STKNUM, DECODE(TRIM(TI.STKNUM), '', 'O', 'S') STKNUM_STATUS, TI.STATIT, LISTAGG(TI.STATIT,',') WITHIN GROUP (ORDER BY NULL) OVER (PARTITION BY  TI.STKNUM) AS STATDO
				<if test="STATIT != 'FPC'">
			        	   	 , '' AS STATDO2
       		  	</if>
				<if test="STATIT == 'FPC'">
							 , SH.STATDO AS STATDO2
				</if>	
				  FROM TASDH TH INNER JOIN TASDI TI				  
				                ON TI.TASKKY = TH.TASKKY
				               AND TI.TASKTY IN ('PK')
				               AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
			              <if test="STATIT != 'FPC'">
			        	   	 AND TI.STATIT IN(#{STATIT}) 	
		        		  </if>
					      <if test="STATIT == 'FPC'">
				         	INNER JOIN SHPDI  SI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT				         
				         	INNER JOIN SHPDH  SH ON SH.SHPOKY = SI.SHPOKY 
				        	  AND TI.STATIT IN('FPC', 'PPC') 	
                              --AND SI.STATIT IN('FPC', 'PPC', 'PCK')
                              AND SH.SHPMTY NOT IN('205')				        	   
					      </if> 
				             WHERE TH.WAREKY = #{WAREKY}             
				               AND TH.DOCDAT = #{ORDDAT}							
				UNION ALL
				
				SELECT TP.STKNUM, 'T' AS STKNUM_STATUS, TI.STATIT, LISTAGG(TI.STATIT,',') WITHIN GROUP (ORDER BY NULL) OVER (PARTITION BY  TI.STKNUM) AS STATDO	
				<if test="STATIT != 'FPC'">
			        	   	 , '' AS STATDO2
       		  	</if>
				<if test="STATIT == 'FPC'">
							 , SH.STATDO AS STATDO2
				</if>    
				FROM TASTP TP 
				INNER JOIN TASDI TI ON TI.SHPOKY = TP.SHPOKY AND TI.TASKTY IN ('PK') AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
	              <if test="STATIT != 'FPC'">
	        	   	 AND TI.STATIT IN(#{STATIT}) 	
        		  </if>
			      <if test="STATIT == 'FPC'">
		         	INNER JOIN SHPDI  SI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
		         	INNER JOIN SHPDH  SH ON SH.SHPOKY = SI.SHPOKY				         
		        	  AND TI.STATIT IN('FPC', 'PPC') 	
                            --AND SI.STATIT IN('FPC', 'PPC', 'PCK')		
                            AND SH.SHPMTY NOT IN('205')			        	   
			      </if>    
		             WHERE TP.WAREKY = #{WAREKY}
		               AND TP.CREDAT = #{ORDDAT}
				)       
   
		) GROUP BY STKNUM, STKNUM_STATUS,STATDO, STATDO2     
	</select>
	
	<select id="PDPK05_DOC2_LIST" parameterType="Map" resultType="DataMap">
	
		SELECT C.STKNUM, C.TASKKY,
			   (SELECT CDESC1         
                FROM CMCDV WHERE CMCDKY = 'STATDO' 
                AND CMCDVL = C.STATDO
                ) AS STATDONM
        FROM (       
			    SELECT   DISTINCT    A.STKNUM,
                                     A.TASKKY,
                                     <if test="STATIT != 'FPC'">
				        	  	 	  CASE WHEN A.STATDO LIKE '%${STATIT}%'
					                         THEN #{STATIT}					                       					                                                                
					                  	  ELSE A.STATDO
				        			 </if>
				        			 <if test="STATIT == 'FPC'">
				        	  	 	  CASE WHEN A.STATDO LIKE '%FPC%' AND A.STATDO LIKE '%PPC%'
					                         THEN 'PPC'					                       					                                                                
                                           WHEN A.STATDO LIKE '%FPC%'
					                         THEN 'FPC'					                       					                                                                       
                                           WHEN A.STATDO LIKE '%PPC%'
					                         THEN 'PPC'					                       					                                                                         
					                  	  ELSE A.STATDO
				        			 </if>
					                      
					                 END AS STATDO
		     	FROM ( SELECT  
				               NVL(TRIM(TI.STKNUM), '') AS STKNUM,
				               TI.SHPOKY,
				               TI.SHPOIT,
                               TI.TASKKY,
				               LISTAGG(TI.STATIT,',') WITHIN GROUP (ORDER BY NULL) OVER (PARTITION BY  TI.STKNUM) AS STATDO		       
				        FROM  TASDH TH                                       
				        INNER JOIN TASDI TI
				              ON TI.TASKKY = TH.TASKKY
				               AND TI.TASKTY IN ('PK')
				               AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
				               
				        <if test="STATIT != 'FPC'">
				        	  AND TI.STATIT IN(#{STATIT}) 	
				        </if>
				        <if test="STATIT == 'FPC'">
				         INNER JOIN SHPDI  SI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT				         
				        	  AND TI.STATIT IN('FPC', 'PPC') 	
                              AND SI.STATIT IN('FPC', 'PPC', 'PCK')				        	   
				        </if>	                    
						WHERE TH.WAREKY = #{WAREKY}
						AND TI.TASKTY IN ('PK')	
			            <if test="ORDDAT != null and ORDDAT != ''">
						AND TH.DOCDAT = #{ORDDAT}
						</if>
				     ) A  
				        
				
						      
		 )    C	 
		 
		 ORDER BY C.TASKKY ASC
	</select>
	
	<select id="PDPK05_LIST" parameterType="Map" resultType="DataMap">    

         <choose>
		 	<!-- AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) OR TI.SVBELN = #{STKNUM}) 조건 UNION 분리 -->
			<when test="STKNUM != null and STKNUM != ''">
			SELECT TH.PTNRKY, TH.PTNRNM, #{STKNUM} AS STKNUM
		      	,CASE WHEN SUM(TI.QTTAOR) = NVL(SUM(TI.QTCOMP),0) THEN 'Y' 
					  WHEN MAX(TI.QTTAOR) = NVL(SUM(TI.QTCOMP), 0) THEN 'Y' 
					  ELSE 'N' END CMPYN
				,CASE WHEN (SELECT COUNT(*) FROM TASTP WHERE STKNUM = #{STKNUM} ) > 0 THEN 'Y' 
					  ELSE 'N' END TPYN	  
	        FROM TASDH  TH
	              INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY   
         	WHERE TH.WAREKY = #{WAREKY}
	           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
	           AND TI.OWNRKY = #{OWNRKY}                           
	           AND TI.STATIT IN('NEW', 'PPC', 'FPC')
	           AND TI.TASKTY IN ('PK')       
	           AND TI.STKNUM = #{STKNUM}
         	GROUP BY TH.PTNRKY, TH.PTNRNM 
	         
            UNION 
              
            SELECT TH.PTNRKY, TH.PTNRNM, #{STKNUM} AS STKNUM
		      	,CASE WHEN SUM(TI.QTTAOR) = NVL(SUM(TI.QTCOMP),0) THEN 'Y' 
					  WHEN MAX(TI.QTTAOR) = NVL(SUM(TI.QTCOMP), 0) THEN 'Y' 
					  ELSE 'N' END CMPYN
				,CASE WHEN (SELECT COUNT(*) FROM TASTP WHERE STKNUM = #{STKNUM} ) > 0 THEN 'Y' 
					  ELSE 'N' END TPYN	  
	        FROM TASDH  TH
	              INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY   
         	WHERE TH.WAREKY = #{WAREKY}
	           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
	           AND TI.OWNRKY = #{OWNRKY}                           
	           AND TI.STATIT IN('NEW', 'PPC', 'FPC')
	           AND TI.TASKTY IN ('PK')       
	           AND TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} )
         	GROUP BY TH.PTNRKY, TH.PTNRNM 
			</when>
			<otherwise>
			SELECT TH.PTNRKY, TH.PTNRNM, #{STKNUM} AS STKNUM
		      	,CASE WHEN SUM(TI.QTTAOR) = NVL(SUM(TI.QTCOMP),0) THEN 'Y' 
					  WHEN MAX(TI.QTTAOR) = NVL(SUM(TI.QTCOMP), 0) THEN 'Y' ELSE 'N' END CMPYN
				,CASE WHEN (SELECT COUNT(*) FROM TASTP WHERE STKNUM = #{STKNUM} ) > 0 THEN 'Y' 
					  ELSE 'N' END TPYN	  
	        FROM TASDH  TH
	              INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY   
         	WHERE TH.WAREKY = #{WAREKY}
	           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
	           AND TI.OWNRKY = #{OWNRKY}                           
	           AND TI.STATIT IN('NEW', 'PPC', 'FPC')
	           AND TI.TASKTY IN ('PK')       
	           AND 1 = 0
         	GROUP BY TH.PTNRKY, TH.PTNRNM 
			</otherwise>
		</choose>		
                                                 	
    </select>
            		
	
	<select id="PDPK05_COUNT_LIST" parameterType="Map" resultType="DataMap">
		 SELECT   COUNT(CASE WHEN CMPYN = 'Y' THEN 1 END) AS NOWCOMPCNT
			 	 ,COUNT(PTNRKY) AS TOTCOMPCNT 
		  FROM 
			  (
		        <choose>
				 	<!-- AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) OR TI.SVBELN = #{STKNUM}) 조건 UNION 분리 -->
					<when test="STKNUM != null and STKNUM != ''">
						SELECT   TH.PTNRKY, TH.PTNRNM, #{STKNUM} AS STKNUM
						      	,CASE WHEN SUM(TI.QTTAOR) = NVL(SUM(TI.QTCOMP),0) THEN 'Y' 
									  WHEN MAX(TI.QTTAOR) = NVL(SUM(TI.QTCOMP), 0) THEN 'Y' ELSE 'N' END CMPYN
								,CASE WHEN (SELECT COUNT(*) FROM TASTP WHERE STKNUM = #{STKNUM} ) > 0 THEN 'Y' 
									  ELSE 'N' END TPYN	  
				        FROM TASDH  TH
				              INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY 
				        WHERE TH.WAREKY = #{WAREKY}
				           AND TI.OWNRKY = #{OWNRKY}  
				           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})               
				           AND TI.STATIT IN('NEW', 'PPC', 'FPC')
				           AND TI.TASKTY IN ('PK')       
				           AND TI.STKNUM = #{STKNUM} 
				        GROUP BY TH.PTNRKY, TH.PTNRNM, TI.STKNUM
				         
			            UNION 
			              
			            SELECT   TH.PTNRKY, TH.PTNRNM, #{STKNUM} AS STKNUM
						      	,CASE WHEN SUM(TI.QTTAOR) = NVL(SUM(TI.QTCOMP),0) THEN 'Y' 
									  WHEN MAX(TI.QTTAOR) = NVL(SUM(TI.QTCOMP), 0) THEN 'Y' ELSE 'N' END CMPYN
								,CASE WHEN (SELECT COUNT(*) FROM TASTP WHERE STKNUM = #{STKNUM} ) > 0 THEN 'Y' 
									  ELSE 'N' END TPYN	  
				        FROM TASDH  TH
				              INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY 
				        WHERE TH.WAREKY = #{WAREKY}
				           AND TI.OWNRKY = #{OWNRKY}  
				           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})               
				           AND TI.STATIT IN('NEW', 'PPC', 'FPC')
				           AND TI.TASKTY IN ('PK')       
				           AND TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} )
				        GROUP BY TH.PTNRKY, TH.PTNRNM, TI.STKNUM
					</when>
					<otherwise>
						SELECT   TH.PTNRKY, TH.PTNRNM, #{STKNUM} AS STKNUM
						      	,CASE WHEN SUM(TI.QTTAOR) = NVL(SUM(TI.QTCOMP),0) THEN 'Y' 
									  WHEN MAX(TI.QTTAOR) = NVL(SUM(TI.QTCOMP), 0) THEN 'Y' ELSE 'N' END CMPYN
								,CASE WHEN (SELECT COUNT(*) FROM TASTP WHERE STKNUM = #{STKNUM} ) > 0 THEN 'Y' 
									  ELSE 'N' END TPYN	  
				        FROM TASDH  TH
				              INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY 
				        WHERE TH.WAREKY = #{WAREKY}
				           AND TI.OWNRKY = #{OWNRKY}  
				           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})               
				           AND TI.STATIT IN('NEW', 'PPC', 'FPC')
				           AND TI.TASKTY IN ('PK')       
				           AND 1 = 0 
				        GROUP BY TH.PTNRKY, TH.PTNRNM, TI.STKNUM
					</otherwise>
				</choose>	
			  )
	</select>	
	
	<select id="PDPK05_DETAIL_LIST" parameterType="Map" resultType="DataMap">
   		SELECT A.LOCAKY                            
			 , A.SKUKEY AS SKUKEY
			 , #{STKNUM} AS STKNUM
			 , A.DESC01 AS DESC01
			 , SUM(A.QTTAOR) QTTAOR
			 , SUM(A.QTCOMP) QTCOMP					 
	         , A.DUOMKY
             , NVL(TRIM(SZF_GET_CONVERT_QTY(#{WAREKY}, A.SKUKEY, SUM(A.QTTAOR), A.DUOMKY, A.UOMKEY)), 0) AS QTYORG
             , A.UOMKEY
             , (SELECT CDESC1         
		                 FROM CMCDV WHERE CMCDKY = 'STATDO' 
		                	   AND CMCDVL =  CASE  WHEN A.STATDO LIKE '%PPC%' AND A.STATDO LIKE '%NEW%'
							                         THEN 'PPC'
		                                           WHEN A.STATDO LIKE '%FPC%' AND A.STATDO LIKE '%NEW%'
							                         THEN 'PPC'  
							                       WHEN A.STATDO LIKE '%PPC%'
							                         THEN 'PPC'                                             
							                       WHEN A.STATDO LIKE '%FPC%'
							                         THEN 'FPC'
							                       WHEN A.STATDO NOT LIKE '%PPC%' AND A.STATDO NOT LIKE '%FPC%' AND A.STATDO LIKE '%NEW%'
							                         THEN 'NEW'                            					                           
							                  	  ELSE A.STATDO    
							                 END 
		     ) AS STATDONM     
		FROM (
				 <choose>
				 	<!-- AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) OR TI.SVBELN = #{STKNUM}) 조건 UNION 분리 -->
					<when test="STKNUM != null and STKNUM != ''">
					SELECT         
					   NVL(TRIM(TI.ASKU01), TI.LOCASR) AS LOCAKY                             
					 , TI.SKUKEY AS SKUKEY
					 , #{STKNUM} AS STKNUM
					 , SM.DESC01 AS DESC01
					 , TI.QTTAOR
                     , TI.QTCOMP						 
			         , SI.DUOMKY                                                  
                     --, SUM(NVL(SI.QTYORG,0)) OVER (PARTITION BY   TI.SKUKEY, LM.LOCAKY) AS QTYORG
                     , NVL(SI.QTYORG,0) AS QTYORG
                     , SI.UOMKEY
                     , TH.STATDO
					FROM SHPDH SH
					   INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
					   INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
					   INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
					   INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
					   INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY
					WHERE 1 = 1
		               AND TH.WAREKY = #{WAREKY}
		               AND TH.TASOTY = '330'
		               AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		               AND SM.MTYPE LIKE #{SES_MTYPE}               
		               AND TI.STATIT IN('NEW', 'PPC', 'FPC')
		               AND TI.TASKTY IN ('PK') 
		               AND TI.STKNUM = #{STKNUM}
		               <if test="DPTNKY != null and DPTNKY != ''">
					   AND TH.PTNRKY = #{DPTNKY}
					   </if>
	               UNION 
	               SELECT         
					   NVL(TRIM(TI.ASKU01), TI.LOCASR) AS LOCAKY                             
					 , TI.SKUKEY AS SKUKEY
					 , #{STKNUM} AS STKNUM
					 , SM.DESC01 AS DESC01
					 , TI.QTTAOR
                     , TI.QTCOMP						 
			         , SI.DUOMKY                                                  
                     --, SUM(NVL(SI.QTYORG,0)) OVER (PARTITION BY   TI.SKUKEY, LM.LOCAKY) AS QTYORG
                     , NVL(SI.QTYORG,0) AS QTYORG
                     , SI.UOMKEY
                     , TH.STATDO
					FROM SHPDH SH
					   INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
					   INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
					   INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
					   INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
					   INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY
					WHERE 1 = 1
		               AND TH.WAREKY = #{WAREKY}
		               AND TH.TASOTY = '330'
		               AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		               AND SM.MTYPE LIKE #{SES_MTYPE}               
		               AND TI.STATIT IN('NEW', 'PPC', 'FPC')
		               AND TI.TASKTY IN ('PK') 
		               AND TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} )
		               <if test="DPTNKY != null and DPTNKY != ''">
					   AND TH.PTNRKY = #{DPTNKY}
					   </if>
					</when>
					<otherwise>
					SELECT         
					   NVL(TRIM(TI.ASKU01), TI.LOCASR) AS LOCAKY                             
					 , TI.SKUKEY AS SKUKEY
					 , #{STKNUM} AS STKNUM
					 , SM.DESC01 AS DESC01
					 , TI.QTTAOR
                     , TI.QTCOMP						 
			         , SI.DUOMKY                                                  
                     --, SUM(NVL(SI.QTYORG,0)) OVER (PARTITION BY   TI.SKUKEY, LM.LOCAKY) AS QTYORG
                     , NVL(SI.QTYORG,0) AS QTYORG
                     , SI.UOMKEY
                     , TH.STATDO
					FROM SHPDH SH
					   INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
					   INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
					   INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
					   INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
					   INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY AND SM.SKUKEY = SI.SKUKEY
					WHERE 1 = 1
		               AND TH.WAREKY = #{WAREKY}
		               AND TH.TASOTY = '330'
		               AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		               AND SM.MTYPE LIKE #{SES_MTYPE}               
		               AND TI.STATIT IN('NEW', 'PPC', 'FPC')
		               AND TI.TASKTY IN ('PK')          
		             <if test="DPTNKY != null and DPTNKY != ''">
					   AND TH.PTNRKY = #{DPTNKY}
					 </if>
					</otherwise>
				</choose>		
	   
			) A GROUP BY A.LOCAKY, A.SKUKEY	, A.STKNUM , A.DESC01, A.STATDO,  A.DUOMKY, A.UOMKEY
			ORDER BY DECODE(STATDONM, '피킹완료', 1, 0) ASC, A.SKUKEY DESC, A.DESC01 DESC 
	</select>
	
	<select id="PDPK05_DETAIL2_LIST" parameterType="Map" resultType="DataMap">
    SELECT Z.LOCAKY,
           Z.SKUKEY,
           Z.STKNUM,
           Z.DESC01,
           SUM(Z.QTTAOR) QTTAOR,
           Z.EANCOD,
		   Z.GTINCD, 
           Z.STATDONM,
           SUM(Z.QTCOMP) QTCOMP, 
           Z.LOTA01,
           Z.LOTA02,
           Z.LOTA07,
           Z.TASKKY,
           Z.UOMKEY,
           Z.DUOMKY,
           Z.QTYORG,
           Z.SHPOKY
	FROM
	(
    
    	SELECT A.LOCAKY,
           A.SKUKEY,
           A.STKNUM,
           A.DESC01,
           A.QTTAOR,
           A.EANCOD,
		   A.GTINCD, 
           A.STATDONM,
           A.QTCOMP, 
           A.LOTA01,
           A.LOTA02,
           A.LOTA07,
           A.TASKKY,
           A.UOMKEY,
           A.DUOMKY,
           A.QTYORG,
           A.SHPOKY
   		FROM (   

    	   SELECT DISTINCT
    	   				B.TASKKY, 
    	   				B.LOCAKY,
		                B.SKUKEY,
		                B.STKNUM,
		                B.DESC01,
		                B.QTTAOR,
		                B.QTCOMP,
		                B.EANCOD,
					    B.GTINCD,
					    B.LOTA01,
				        B.LOTA02,
				        B.LOTA07,
		                (SELECT CDESC1         
		                 FROM CMCDV WHERE CMCDKY = 'STATDO' 
		                	   AND CMCDVL =  CASE  WHEN B.STATDO LIKE '%PPC%' AND B.STATDO LIKE '%NEW%'
							                         THEN 'PPC'
		                                           WHEN B.STATDO LIKE '%FPC%' AND B.STATDO LIKE '%NEW%'
							                         THEN 'PPC'  
							                       WHEN B.STATDO LIKE '%PPC%'
							                         THEN 'PPC'                                             
							                       WHEN B.STATDO LIKE '%FPC%'
							                         THEN 'FPC'
							                       WHEN B.STATDO NOT LIKE '%PPC%' AND B.STATDO NOT LIKE '%FPC%' AND B.STATDO LIKE '%NEW%'
							                         THEN 'NEW'                            					                           
							                  	  ELSE B.STATDO    
							                 END 
		                ) AS STATDONM,  
		                B.UOMKEY,
			            B.DUOMKY,
			            B.QTYORG,
			            B.SHPOKY
		                                   
           FROM(

					SELECT       
						   TH.TASKKY AS TASKKY
						 , LM.LOCAKY AS LOCAKY                             
						 , SI.SKUKEY AS SKUKEY
						 , SI.STKNUM AS STKNUM
						 , SM.DESC01 AS DESC01
						 , SUM(NVL(TI.QTTAOR,0)) OVER (PARTITION BY    TI.SKUKEY, LM.LOCAKY) AS QTTAOR
						 , SUM(NVL(TI.QTCOMP,0)) OVER (PARTITION BY    TI.SKUKEY, LM.LOCAKY) AS QTCOMP
						 , SM.EANCOD AS EANCOD
						 , SM.GTINCD AS GTINCD
						 , TI.LOTA01
			           	 , TI.LOTA02
			           	 , TI.LOTA07
						 , LISTAGG(TI.STATIT,',') WITHIN GROUP (ORDER BY NULL) OVER (PARTITION BY  TI.TASKKY, TI.SHPOKY, TI.SHPOIT, TI.SKUKEY, LM.LOCAKY) AS STATDO
						 , SI.UOMKEY
				         , SI.DUOMKY
				         , SUM(NVL(SI.QTYORG, 0)) OVER (PARTITION BY    TI.SKUKEY, NVL(TRIM(TI.ASKU01), TI.LOCASR)) AS QTYORG				         
				         , SH.SHPOKY
					FROM SHPDH SH
						   INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
						   INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
						   INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
						   INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
						   INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY
						                      AND SM.SKUKEY = SI.SKUKEY
					WHERE 1 = 1
			               AND TH.WAREKY = #{WAREKY}
			               AND TH.TASOTY = '330'
		                   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		                   AND SM.MTYPE LIKE #{SES_MTYPE}               
			               AND TI.STATIT IN('NEW', 'PPC', 'FPC')
			               AND TI.TASKTY IN ('PK')
			               <if test="STKNUM != null and STKNUM != ''">
			               AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
			               </if>             
			               <if test="DPTNKY != null and DPTNKY != ''">
							AND TH.PTNRKY = #{DPTNKY}
						   </if>
					   
			) B
			
         )A                  
         
         )Z
         
       GROUP BY    Z.LOCAKY,
                   Z.SKUKEY,
                   Z.STKNUM,
                   Z.DESC01,
                   Z.EANCOD,
                   Z.GTINCD, 
                   Z.STATDONM,
                   Z.LOTA01,
                   Z.LOTA02,
                   Z.LOTA07,
                   Z.TASKKY,
                   Z.UOMKEY,
                   Z.DUOMKY,
                   Z.QTYORG,
                   Z.SHPOKY
                   
                   
        ORDER BY  Z.TASKKY, Z.SKUKEY, Z.LOCAKY ASC
         
	</select>
	
	<select id="PDPK05_DETAIL_SUB_LIST" parameterType="Map" resultType="DataMap">
	SELECT TH.TASKKY
					 , TI.TASKIT
				     , LM.LOCAKY AS LOCAKY
				     , TI.SKUKEY AS SKUKEY
				     , #{STKNUM} AS STKNUM
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA07 AS LOTA07
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.EANCOD AS EANCOD
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY
				     , TI.STATIT AS STATIT    		
				     , TI.SHPOKY AS SHPOKY		     
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
		           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		           AND SM.MTYPE LIKE #{SES_MTYPE}               
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN('NEW', 'PPC', 'FPC')
				<if test="STKNUM != null and STKNUM != ''">   	  
				   AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})	
				</if>
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				<if test="TASKKY != null and TASKKY != ''">
					AND TH.TASKKY = #{TASKKY}
				</if>
			 	ORDER BY  LM.LOCAKY, TI.SKUKEY DESC
	</select>
			 	
	<select id="PDPK05DETAILCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT        COUNT(*) AS CNT
		            , COUNT(CASE WHEN NVL(QTTAOR, 0) = NVL(QTCOMP, 0) THEN 1 END) AS COMPCNT2              
		            , SUM(NVL(QTTAOR,0)) AS QTTAOR
		            , SUM(NVL(QTCOMP,0)) AS QTCOMP
		            , MAX(UOMKEY) AS UOMKEY            
    	FROM (
     
					SELECT A.LOCAKY                            
			 , A.SKUKEY AS SKUKEY
			 , #{STKNUM} AS STKNUM
			 , A.DESC01 AS DESC01
			 , A.QTTAOR
			 , A.QTCOMP						 
	         , A.DUOMKY
             , A.QTYORG
             , A.UOMKEY
             , (SELECT CDESC1         
		                 FROM CMCDV WHERE CMCDKY = 'STATDO' 
		                	   AND CMCDVL =  CASE  WHEN A.STATDO LIKE '%PPC%' AND A.STATDO LIKE '%NEW%'
							                         THEN 'PPC'
		                                           WHEN A.STATDO LIKE '%FPC%' AND A.STATDO LIKE '%NEW%'
							                         THEN 'PPC'  
							                       WHEN A.STATDO LIKE '%PPC%'
							                         THEN 'PPC'                                             
							                       WHEN A.STATDO LIKE '%FPC%'
							                         THEN 'FPC'
							                       WHEN A.STATDO NOT LIKE '%PPC%' AND A.STATDO NOT LIKE '%FPC%' AND A.STATDO LIKE '%NEW%'
							                         THEN 'NEW'                            					                           
							                  	  ELSE A.STATDO    
							                 END 
		     ) AS STATDONM     
		FROM (

                   SELECT /*+ USE_CONCAT INDEX(@SEL$1 PLAN_TABLE@SEL$1) */  
					   NVL(TRIM(TI.ASKU01), TI.LOCASR) AS LOCAKY                            
					 , SI.SKUKEY AS SKUKEY
					 , #{STKNUM} AS STKNUM
					 , SM.DESC01 AS DESC01
					 , SUM(NVL(TI.QTTAOR,0)) OVER (PARTITION BY   TI.SKUKEY, NVL(TRIM(TI.ASKU01), TI.LOCASR)) AS QTTAOR
					 , SUM(NVL(TI.QTCOMP,0)) OVER (PARTITION BY   TI.SKUKEY, NVL(TRIM(TI.ASKU01), TI.LOCASR)) AS QTCOMP					 
			         , SI.DUOMKY                                                  
                     , SUM(NVL(SI.QTYORG,0)) OVER (PARTITION BY   TI.SKUKEY, NVL(TRIM(TI.ASKU01), TI.LOCASR)) AS QTYORG
                     , SI.UOMKEY
                     , LISTAGG(CASE WHEN TI.STATIT = 'NEW' AND TI.QTCOMP > 0 THEN 'PPC' 
                                ELSE TI.STATIT
                                END ,',') WITHIN GROUP (ORDER BY NULL) OVER (PARTITION BY  TI.SKUKEY, LM.LOCAKY) AS STATDO
				FROM SHPDH SH
					   INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
					   INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
					   INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY
					   INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
					   INNER JOIN SKUMA SM ON SM.OWNRKY = SH.OWNRKY
					                      AND SM.SKUKEY = SI.SKUKEY
				WHERE 1 = 1
		               AND TH.WAREKY = #{WAREKY}
		               AND TH.TASOTY = '330'
		               AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		               AND SM.MTYPE LIKE #{SES_MTYPE}               
		               AND TI.STATIT IN('NEW', 'PPC', 'FPC')
		               AND TI.TASKTY IN ('PK')
		               
	                 <if test="STKNUM != null and STKNUM != ''">
		               AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
		             </if>             
		             <if test="DPTNKY != null and DPTNKY != ''">
					   AND TH.PTNRKY = #{DPTNKY}
					 </if>

						   
			) A 
			GROUP BY A.LOCAKY, A.SKUKEY	, A.STKNUM , A.DESC01, A.STATDO,  A.QTTAOR,  A.QTCOMP, A.DUOMKY, A.QTYORG, A.UOMKEY	
			)			 
	</select>
	
	<select id="PDPK05DETAIL02HEAD_MAP" parameterType="Map" resultType="DataMap">
		SELECT        SUM(NVL(QTTAOR,0)) AS QTTAOR
		            , SUM(NVL(QTCOMP,0)) AS QTCOMP
		            , MAX(SKUKEY) AS SKUKEY
		            , MAX(DESC01) AS DESC01
		            , MAX(UOMKEY) AS UOMKEY
		            , MAX(LOCASR) AS LOCASR  
		            , MAX(ALOTPCK) AS ALOTPCK    
		            , MAX(SHPOKY) AS SHPOKY
		            , MAX(SHPOIT) AS SHPOIT   
		            , SUM(NVL(BQTTAOR,0)) AS BQTTAOR
                    , MAX(BUOMKEY) AS BUOMKEY   
                    , MAX(NVL(QTPUOM, 0)) AS QTPUOM
    	FROM (
     
				 SELECT TH.TASKKY AS TASKKY
					     , TI.TASKIT AS TASKIT
					     , LM.LOCAKY AS LOCASR
					     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),' ') AS STATIT
					     , TI.SKUKEY AS SKUKEY
					     , SM.DESC01 AS DESC01
					     , SM.EANCOD AS EANCOD
					     , SM.GTINCD AS GTINCD
					     , TI.QTTAOR AS QTTAOR
					     , TI.QTCOMP AS QTCOMP
					     , SM.DUOMKY AS UOMKEY	
					     , TRIM(SM.SKUG05) || TRIM(SM.SKUL01) AS ALOTPCK
					     , TI.SHPOKY
                         , TI.SHPOIT	   
                         , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTTAOR, TI.SUOMKY, 'BOX')),'0') AS BQTTAOR
                         , MS.UOMKEY AS BUOMKEY
                         , MS.QTPUOM AS QTPUOM
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				       LEFT JOIN MEASI MS ON MS.WAREKY = TH.WAREKY AND MS.MEASKY = TI.SKUKEY AND MS.UOMKEY = 'BOX'                                      
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
				   AND SM.MTYPE LIKE #{SES_MTYPE}               
				   AND TH.TASOTY = '330'
				   AND TI.STATIT IN('NEW', 'PPC', 'FPC')
				   <if test="STKNUM != null and STKNUM != ''">
				   AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
				   </if>
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="SHPOKY != null and SHPOKY != ''">
				   AND TI.SHPOKY = #{SHPOKY}
				</if>   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})				   
				</if>				
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
				 ORDER BY TH.TASKKY, TI.TASKIT, LM.OBROUT, LM.LOCAKY, TI.SHPOKY, TI.SHPOIT
			)			 
	</select>
	
	<select id="PDPK05DETAIL02CNT_LIST" parameterType="Map" resultType="DataMap">
	  SELECT          SUM(NVL(QTTAOR,0)) AS QTCOMP_L7141
		            , SUM(NVL(QTCOMP,0)) AS QTCOMP_L7141_2
		            , MAX(SKUKEY) AS SKUKEY
		            , MAX(DESC01) AS DESC01
		            , MAX(UOMKEY) AS UOMKEY2
		            , MAX(UOMKEY) AS UOMKEY3
		            , MAX(LOCASR) AS LOCASR            
    	FROM (
     
				 SELECT TH.TASKKY AS TASKKY
					     , TI.TASKIT AS TASKIT
					     , LM.LOCAKY AS LOCASR
					     , NVL((SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'STATIT' AND CMCDVL = TI.STATIT),' ') AS STATIT
					     , TI.SKUKEY AS SKUKEY
					     , SM.DESC01 AS DESC01
					     , SM.EANCOD AS EANCOD
					     , SM.GTINCD AS GTINCD
					     , TI.QTTAOR AS QTTAOR
					     , TI.QTCOMP AS QTCOMP
					     , SM.DUOMKY AS UOMKEY		   
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
				   AND SM.MTYPE LIKE #{SES_MTYPE}               
				   AND TH.TASOTY = '330'
				   AND TI.STATIT IN('NEW', 'PPC', 'FPC', 'FIN')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
				</if>   
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="SHPOKY != null and SHPOKY != ''">
				   AND TI.SHPOKY = #{SHPOKY}
				</if>   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})
				</if>				
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			)				
	</select>
	
	<select id="PDPK05_DETAIL02_LIST" parameterType="Map" resultType="DataMap">
		 SELECT   LOCAKY	        
		        , SKUKEY 
		        , DESC01 
		        , QTTAOR     
		        , QTCOMP    
		        , DQTCOMP	
		        , LOTA01 
		        , LOTA02 
		        , LOTA03 
		        , LOTA09 
		        , LOTA11 
		        , LOTA12 
		        , LOTA13 
		        , LOTA14	
		        , GTINCD 
		        , PACKID                 
		        , TRNUID                 
		        , STKNUM          
		        , WAREKY          
		        , DPTNKY			
		        , BARCOD          
		        , UOMKEY          
		        , DUOMKY
		        , SUM(QTYORG) AS QTYORG
		        , LASTOB 
		        , ALOTPCK                   
		        , ALOTPCK_YN		                                           
		        , CHKQTCOMP
		        , ASKU01 		                                                       
		FROM            
	        (
				SELECT 
				       LM.LOCAKY AS LOCAKY		         
				     , TI.SKUKEY AS SKUKEY
		             , SM.DESC01 AS DESC01
				     , SUM(NVL(TI.QTTAOR,0)) OVER (PARTITION BY  LM.LOCAKY, TI.SKUKEY, TI.LOTA14) AS QTTAOR
            		 , SUM(NVL(TI.QTCOMP ,0)) OVER (PARTITION BY  LM.LOCAKY, TI.SKUKEY, TI.LOTA14) AS QTCOMP
            		 , SUM(NVL(TI.QTCOMP ,0)) OVER (PARTITION BY  LM.LOCAKY, TI.SKUKEY, TI.LOTA14) AS DQTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		             		    
		             , SM.GTINCD AS GTINCD
				     , '' AS PACKID
				     , '' AS TRNUID
				     , #{STKNUM} AS STKNUM
				     , #{WAREKY} AS WAREKY
				     , #{DPTNKY} AS DPTNKY				     
				     , #{BARCOD} AS BARCOD
				     , SI.UOMKEY AS UOMKEY
                     , SI.DUOMKY AS DUOMKY                     
                     , NVL(TRIM(SZF_GET_CONVERT_QTY(SH.WAREKY, SI.SKUKEY, TI.QTTAOR, SI.DUOMKY, SI.UOMKEY)),'0') AS QTYORG		
				     , SZF_GET_ORDER_ALSTKY_LASTOB(SH.WAREKY, SH.OWNRKY, SH.KVGR1, SH.DPTNKY, ' ', ' ', SH.DOCUTY, ' ', SI.ALSTKY) AS LASTOB
				     , TRIM(SM.SKUG05) || TRIM(SM.SKUL01) AS ALOTPCK
				     , ( SELECT USARG1 FROM CMCDV CM
		                         WHERE CMCDKY = 'ALOTPCK'
		                         AND TRIM(SM.SKUG05) || TRIM(SM.SKUL01) = CM.CMCDVL
		               )AS ALOTPCK_YN		
		             , 0 AS CHKQTCOMP   
		             , NVL(TRIM(TI.ASKU01), ' ') ASKU01      
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				       INNER JOIN SHPDH SH ON SH.SHPOKY = TI.SHPOKY
                       INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY AND SI.SHPOKY = TI.SHPOKY 
                                          AND SI.SHPOIT = TI.SHPOIT AND SI.SKUKEY = TI.SKUKEY
				                          
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				   AND SM.MTYPE LIKE #{SES_MTYPE}              
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN('NEW', 'PPC', 'FPC', 'FIN') AND TI.TASKTY IN ('PK')	
				<if test="STKNUM != null and STKNUM != ''">     
				   AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				    
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})
				</if>
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			)  GROUP BY   LOCAKY 		            
				        , SKUKEY 
				        , DESC01 
				        , QTTAOR     
				        , QTCOMP    
				        , DQTCOMP	
				        , LOTA01 
				        , LOTA02 
				        , LOTA03 
				        , LOTA09 
				        , LOTA11 
				        , LOTA12 
				        , LOTA13 
				        , LOTA14	
				        , GTINCD 
				        , PACKID                 
				        , TRNUID                 
				        , STKNUM          
				        , WAREKY          
				        , DPTNKY			
				        , BARCOD          
				        , UOMKEY          
				        , DUOMKY
				        , LASTOB 
				        , ALOTPCK                   
				        , ALOTPCK_YN		                                           
				        , CHKQTCOMP
				        , ASKU01
			ORDER BY CASE WHEN QTTAOR = 0 THEN 1 ELSE 0 END, LOTA14 ASC        
				         	
	</select>
		
	<select id="PDPK05_DETAIL02_SUB_LIST" parameterType="Map" resultType="DataMap">

				SELECT TH.TASKKY
					 , TI.TASKIT
					 , TI.SHPOKY
					 , TI.SHPOIT
				     , NVL(TRIM(TI.ASKU01), TI.LOCASR) AS LOCASR
				     , TI.LOCASR AS LOCAKY
				     , TI.ASKU01
				     , TI.SKUKEY AS SKUKEY
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY 
				     , TI.STATIT				      
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				   AND SM.MTYPE LIKE #{SES_MTYPE} 
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN ('NEW', 'FPC', 'PPC', 'FIN') 
				   AND TI.TASKTY IN ('PK')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})
				</if>
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			 	ORDER BY TI.LOTA14 ASC
			
	</select>
	
	<select id="PDPK05_DETAIL02_TASKINFO_LIST" parameterType="Map" resultType="DataMap">
 		SELECT  TASKKY, TASKIT, QTTAOR
 		  FROM(
				SELECT TH.TASKKY
					 , TI.TASKIT
					 , TI.SHPOKY
					 , TI.SHPOIT
				     , LM.LOCAKY AS LOCASR
				     , TI.SKUKEY AS SKUKEY
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY 
				     , TI.STATIT				      
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				   AND SM.MTYPE LIKE #{SES_MTYPE} 
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN ('NEW', 'FPC', 'PPC') 
				   AND TI.TASKTY IN ('PK')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})	
				</if>
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			 	ORDER BY TI.LOTA14 ASC
			) GROUP BY TASKKY, TASKIT, QTTAOR			
	</select>
	
	<select id="PDPK05_DETAIL02_TASKKY_LIST" parameterType="Map" resultType="DataMap">
 		SELECT  TASKKY
 		  FROM(
				SELECT TH.TASKKY
					 , TI.TASKIT
					 , TI.SHPOKY
					 , TI.SHPOIT
				     , LM.LOCAKY AS LOCASR
				     , TI.SKUKEY AS SKUKEY
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY 
				     , TI.STATIT				      
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				   AND SM.MTYPE LIKE #{SES_MTYPE} 
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN ('NEW', 'FPC', 'PPC') 
				   AND TI.TASKTY IN ('PK')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})	
				</if>
				<if test="BARCOD != null and BARCOD != ''">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			 	ORDER BY TI.LOTA14 ASC
			) GROUP BY TASKKY	
	</select>
	
	<select id="PDPK05_SAVE_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.WAREKY AS WAREKY,
		       B.TASKKY AS TASKKY,
		       B.TASKIT AS TASKIT,
		       B.TASKTY AS TASKTY,
		       B.RSNCOD AS RSNCOD,
		       B.TASRSN AS TASRSN,
		       B.STATIT AS STATIT,
		       (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = B.STATIT) AS STATITNM,
		       B.QTTAOR AS QTTAOR,
		       B.QTCOMP AS QTCOMP,
		       B.OWNRKY AS OWNRKY,
		       B.SKUKEY AS SKUKEY,
		       B.LOTNUM AS LOTNUM,
		       B.ACTCDT AS ACTCDT,
		       B.ACTCTI AS ACTCTI,
