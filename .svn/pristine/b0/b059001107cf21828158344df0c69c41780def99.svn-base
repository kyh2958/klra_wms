		       B.AWMSNO AS AWMSNO,
		       B.AWMSTS AS AWMSTS,
		       B.SMANDT AS SMANDT,
		       B.SEBELN AS SEBELN,
		       B.SEBELP AS SEBELP,
		       B.SZMBLNO AS SZMBLNO,
		       B.SZMIPNO AS SZMIPNO,
		       B.STRAID AS STRAID,
		       B.SVBELN AS SVBELN,
		       B.SPOSNR AS SPOSNR,
		       B.STKNUM AS STKNUM,
		       B.STPNUM AS STPNUM,
		       B.SWERKS AS SWERKS,
		       B.SLGORT AS SLGORT,
		       B.SDATBG AS SDATBG,
		       B.STDLNR AS STDLNR,
		       B.SSORNU AS SSORNU,
		       B.SSORIT AS SSORIT,
		       B.SMBLNR AS SMBLNR,
		       B.SZEILE AS SZEILE,
		       B.SMJAHR AS SMJAHR,
		       B.SXBLNR AS SXBLNR,
		       B.SAPSTS AS SAPSTS,
		       B.DOORKY AS DOORKY,
		       B.PTLT01 AS PTLT01,
		       B.PTLT02 AS PTLT02,
		       B.PTLT03 AS PTLT03,
		       B.PTLT04 AS PTLT04,
		       B.PTLT05 AS PTLT05,
		       B.PTLT06 AS PTLT06,
		       B.PTLT07 AS PTLT07,
		       B.PTLT08 AS PTLT08,
		       B.PTLT09 AS PTLT09,
		       B.PTLT10 AS PTLT10,
		       B.PTLT11 AS PTLT11,
		       B.PTLT12 AS PTLT12,
		       B.PTLT13 AS PTLT13,
		       B.PTLT14 AS PTLT14,
		       B.PTLT15 AS PTLT15,
		       B.PTLT16 AS PTLT16,
		       B.PTLT17 AS PTLT17,
		       B.PTLT18 AS PTLT18,
		       B.PTLT19 AS PTLT19,
		       B.PTLT20 AS PTLT20,
		       C.AUTLOC AS AUTLOC,
		       B.CREDAT AS CREDAT,
		       B.CRETIM AS CRETIM,
		       B.CREUSR AS CREUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.CREUSR) AS CUSRNM,
		       B.LMODAT AS LMODAT,
		       B.LMOTIM AS LMOTIM,
		       B.LMOUSR AS LMOUSR,
		       (SELECT X.NMLAST FROM USRMA X WHERE X.USERID = B.LMOUSR) AS LUSRNM,
		       B.INDBZL AS INDBZL,
		       B.INDARC AS INDARC,
		       B.UPDCHK AS UPDCHK,
		       C.LOCAKY AS LOCAKY
		  FROM TASDH A,
		       TASDI B,
		       LOCMA C
		 WHERE 1 = 1
		   AND A.TASKKY = B.TASKKY
           AND A.WAREKY = C.WAREKY
		   AND B.LOCASR = C.LOCAKY
		   AND A.WAREKY = #{WAREKY}
		   AND B.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
		   AND A.TASOTY = '330'	
		   AND B.STATIT IN ('NEW', 'FPC', 'PPC', 'FIN') 
		   AND B.TASKTY IN ('PK')
		<if test="STKNUM != null and STKNUM != ''">   
		   AND (B.STKNUM = #{STKNUM}  OR B.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
		</if>    
		<if test="DPTNKY != null and DPTNKY != ''">
		   AND A.PTNRKY = #{DPTNKY}
		</if>				   
		<if test="LOCAKY != null and LOCAKY != ''">
		   AND (B.LOCASR = #{LOCAKY} OR B.ASKU01 = #{LOCAKY} )		   
		   AND #{LOCAKY} = NVL(TRIM(B.ASKU01), #{LOCAKY})	
		</if>
		<if test="SKUKEY != null and SKUKEY != ''">
		   AND B.SKUKEY= #{SKUKEY}
		</if>
		<if test="TASKKY != null and TASKKY != ''">
		   AND B.TASKKY= #{TASKKY}
		</if>
		<if test="TASKIT != null and TASKIT != ''">
		   AND B.TASKIT= #{TASKIT}
		</if>
		 ORDER BY B.TASKKY, B.TASKIT
	</select>
	
	<select id="PDPK05StockValidation_LIST" parameterType="Map" resultType="DataMap">
	
		SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
			 , TB.LOTNUM
			 , TB.SKUKEY
			 , TB.DESC01
			 , TB.UOMKEY
			 , SUM(TB.QTSIWH) AS QTSIWH
			 , SUM(TB.USEQTY) AS USEQTY
			 , SUM(TB.QTSCNU) AS QTSCNU
			 , SUM(TB.QTSIQT) AS QTSIQT
			 , SUM(TB.QTSWQT) AS QTSWQT
			 , SUM(TB.QTSHQT) AS QTSHQT
			 , SUM(TB.QTSALO) AS QTSALO
			 , SUM(TB.QTSPMO) AS QTSPMO
			 , SUM(TB.QTSPMI) AS QTSPMI
			 , SUM(TB.QTSBLK) AS QTSBLK
			 , SUM(TB.USEQTY) AS USEQTY   																			 /* 가용수량 */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'KG')), 0) AS TOT /* 총중량		  */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'BAG')), 0) AS BAG /* EA/BAG		*/
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'BOX')), 0) AS BOX /* BAG/BOX	   */
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'PAL')), 0) AS PLT /* BOX/Pallet	*/
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'SOK')), 0) AS SOK /* 속(개/BALE)	*/
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIWH), TB.UOMKEY, 'EA' )), 0) AS EA/* 매(sheet/속)   */
			 , TB.WAREKY
			 , (SELECT NAME01 FROM WAHMA WHERE WAREKY = TB.WAREKY) AS WARENM
			 , TB.LOTA01
			 , TB.LOTA02
			 , TB.LOTA03
             , TB.LOTA04
             , TB.LOTA05
             , TB.LOTA06
             , TB.LOTA07
             , TB.LOTA08
			 , TB.LOTA09
             , TB.LOTA10
			 , TB.LOTA11
			 , TB.LOTA12
			 , TB.LOTA13
			 , TB.LOTA14
			 , TB.LOTA15			 
             , TB.LOTA16
             , TB.LOTA17
             , TB.LOTA18
             , TB.LOTA19
             , TB.LOTA20             			
             , TB.LOCAKY
             , TB.OWNRKY
             , TB.PACKID
             , TB.TRNUID             
             <!-- , CASE WHEN (TB.LIMITQT &lt; = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) AND TB.LIMITQT &lt;&gt; 0  AND MOD(TB.LIMITQT + TB.INPUTQTY, TB.LIMITQT) = 0 ) AND  TB.INPUTQTY = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) THEN TB.LIMITQT
                    WHEN (TB.LIMITQT &gt; (SUM(TB.QTSALO) - MAX(TB.QTSPUT))  AND TB.LIMITQT &lt;&gt; 0 AND  TB.INPUTQTY = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) )  OR TB.INPUTQTY = 0 THEN (SUM(TB.QTSALO) - MAX(TB.QTSPUT))                    
                    WHEN  MOD(TB.LIMITQT + TB.INPUTQTY, TB.LIMITQT) &lt;&gt; 0  OR TB.LIMITQT = 0 THEN TB.INPUTQTY                    
               END AS  QTSPUT -->
              , CASE WHEN (TB.LIMITQT &lt; = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) AND TB.LIMITQT &lt;&gt; 0  AND MOD(TB.LIMITQT + TB.INPUTQTY, TB.LIMITQT) = 0 ) AND  TB.INPUTQTY = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) THEN TB.LIMITQT
                    <!-- WHEN (TB.LIMITQT &gt; (SUM(TB.QTSALO) - MAX(TB.QTSPUT))  AND TB.LIMITQT &lt;&gt; 0 AND  TB.INPUTQTY = (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) )  THEN (SUM(TB.QTSALO) - MAX(TB.QTSPUT)) -->                                        
                   <choose>
					<when test='SAMETYPE == "Y"'> 
						WHEN TB.INPUTQTY =0 AND TB.LIMITQT = 0 AND  TB.INPUTQTY  &lt;&gt;(SUM(TB.QTSALO) - MAX(TB.QTSPUT))   THEN (SUM(TB.QTSALO) - MAX(TB.QTSPUT))                   
					</when>
					<otherwise>
						WHEN (TB.INPUTQTY = 0 AND TB.LIMITQT = 0) OR TB.USEQTY &lt; TB.INPUTQTY THEN TB.USEQTY
					</otherwise> 	
					</choose>	                                       
                    WHEN  MOD(TB.LIMITQT + TB.INPUTQTY, TB.LIMITQT) &lt;&gt; 0  OR TB.LIMITQT = 0 THEN TB.INPUTQTY
               END AS  QTSPUT         
             , TB.ALOTPCK
			 , TB.ALOTPCK_YN  
			 , TB.AREAKY 
			                        
		  FROM (
				SELECT  
					  S.WAREKY							AS WAREKY
					 , M.SKUL01							AS SKUL01
					 , S.LOTNUM  					   
					 , S.SKUKEY							AS SKUKEY
					 , M.DESC01							AS DESC01
					 , S.UOMKEY							AS UOMKEY
					 , S.LOTA01
					 , S.LOTA02
					 , S.LOTA03
		             , S.LOTA04
		             , S.LOTA05
		             , S.LOTA06
		             , S.LOTA07
		             , S.LOTA08
					 , S.LOTA09
		             , S.LOTA10
					 , S.LOTA11
					 , S.LOTA12
					 , S.LOTA13
					 , S.LOTA14
					 , S.LOTA15			 
		             , S.LOTA16
		             , S.LOTA17
		             , S.LOTA18
		             , S.LOTA19
		             , S.LOTA20
					 , S.QTSIWH							AS QTSIWH
					 , S.QTSALO							AS QTSALO					 
					 , S.QTSPMI							AS QTSPMI
					 , S.QTSPMO							AS QTSPMO
					 , DECODE(S.LOTA06, '05', S.QTSIWH, 0) AS QTSIQT /* 품질 : Inspection QuanTity */
					 , DECODE(S.LOTA06, '10', S.QTSIWH, 0) AS QTSHQT /* 보류 : Hold	   QuanTity */
					 , DECODE(S.LOTA06, '30', S.QTSIWH, 0) AS QTSCNU /* 불용 : Can Not Use		 */
					 , DECODE(S.LOTA06, '50', S.QTSIWH, 0) AS QTSWQT /* 폐기 : Wasted	 QuanTity */
					 , CASE WHEN S.LOTA06 IN ('00', '05', '10', '30', '50') THEN 0
							ELSE S.QTSIWH
					   END								 AS QTSBLK
					 , CASE WHEN S.AREAKY = 'SHP' THEN S.QTSIWH
							ELSE 0
					   END								 AS QTSOUT
					 , CASE WHEN S.AREAKY = 'SHP' THEN 0
							ELSE S.QTSIWH - S.QTSBLK
										  - GREATEST(S.QTSALO, S.QTSPMO)
										  - (CASE WHEN S.LOTA06 IN ('00') OR S.QTSPMO > 0 THEN 0
												  ELSE S.QTSIWH
											 END)
					   END								 AS USEQTY
					 , S.AREAKY							AS AREAKY
					 , S.ZONEKY							AS ZONEKY
					 , S.LOCAKY							AS LOCAKY
					 , S.OWNRKY							AS OWNRKY
					 , S.TRNUID							AS TRNUID
					 , S.PACKID							AS PACKID
					 , NVL((SELECT DECODE(SUM(QTTAOR)  OVER (PARTITION BY  TASKKY, TASKIT),0,0,SUM(QTCOMP)  OVER (PARTITION BY  TASKKY, TASKIT)) FROM TASDI WHERE TASKKY=S.TASKKY AND TASKIT=S.TASKIT AND STATIT NOT IN('FCN')),0)  AS QTSPUT
                     , NVL(DECODE(S.SKUG05, '10', ZP.PALCNT, 0), 0) AS LIMITQT                     
                     , TO_NUMBER(NVL(TRIM(#{INPUTQTY}), 0)) AS INPUTQTY
                     , TRIM(M.SKUG05) || TRIM(M.SKUL01) AS ALOTPCK
		             , ( SELECT USARG1 FROM CMCDV CM
		                         WHERE CMCDKY = 'ALOTPCK'
		                         AND TRIM(M.SKUG05) || TRIM(M.SKUL01) = CM.CMCDVL
		               )AS ALOTPCK_YN 
				FROM STKKY S
					INNER JOIN SKUMA M ON M.OWNRKY = S.OWNRKY AND M.SKUKEY = S.SKUKEY	
					LEFT JOIN ZPPTM  ZP ON S.LOTA02 = ZP.LOTA02 AND S.LOTA03 = ZP.LOTA03 AND S.LOTA09 = ZP.LOTA09 AND S.LOTA16 = ZP.LOTA16 AND S.LOTA17 = ZP.LOTA17							
				WHERE 1=1
				  AND S.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				  AND M.MTYPE LIKE #{SES_MTYPE} 
				  AND S.QTSIWH &gt; 0
				  <if test="SKUKEY != null and SKUKEY != ''">
				  AND S.SKUKEY = #{SKUKEY}
				  </if>
				  <if test="LOTA01 != null and LOTA01 != ''">
				  AND S.LOTA01 = #{LOTA01}
				  </if>	
				  <if test="LOTA02 != null and LOTA02 != ''">
				  AND S.LOTA02 = #{LOTA02}
				  </if>		
				  <if test="LOTA07 != null and LOTA07 != ''">
				  AND S.LOTA07 = #{LOTA07}
				  </if>
				  <if test="LOTA09 != null and LOTA09 != ''">
				  AND S.LOTA09 = #{LOTA09}
				  </if>			  
				  <if test="LOCAKY != null and LOCAKY != ''">
				  AND S.LOCAKY = #{LOCAKY}
				  </if>			
				  <if test="BARCOD != null and BARCOD != ''">
				  AND S.LOTA14 = #{BARCOD}
				  </if>		
				  
				  <if test="LASTOB == &quot;V&quot;">
				  AND S.LOTA11 &gt;= #{LLOTA11}
				  </if>
				  				  		  			
				  <if test="SAMETYPE != null and SAMETYPE != ''">
					  <if test="STKNUM != null and STKNUM != ''">
					  AND S.QTSALO &gt; 0
					  AND S.QTSPMO &gt; 0
					  AND (S.STKNUM = #{STKNUM} 
					   OR S.STKNUM IN (
					  	  SELECT DISTINCT SI.STKNUM 
						  	FROM SHPDI SI 
						  LEFT OUTER JOIN TASTP TP 
						  	  ON TP.SHPOKY = SI.SHPOKY
						   WHERE TP.STKNUM = #{STKNUM}) )
					  <!-- AND NVL(TRIM(S.TASKKY), ' ') = ' ' -->
					  </if>	
			  
				  </if>
				
			) TB
		WHERE 1=1
				<if test="SAMETYPE == null or SAMETYPE == ''">
				 AND TB.USEQTY &gt; 0
				</if>	
		GROUP BY TB.SKUL01
			   , TB.LOTNUM
			   , TB.SKUKEY
			   , TB.DESC01
			   , TB.UOMKEY
			   , TB.WAREKY
			   , TB.LOTA01
			   , TB.LOTA02
			   , TB.LOTA03
               , TB.LOTA04
               , TB.LOTA05
               , TB.LOTA06
               , TB.LOTA07
               , TB.LOTA08
			   , TB.LOTA09
               , TB.LOTA10
			   , TB.LOTA11
			   , TB.LOTA12
			   , TB.LOTA13
			   , TB.LOTA14
			   , TB.LOTA15			 
               , TB.LOTA16
               , TB.LOTA17
               , TB.LOTA18
               , TB.LOTA19
               , TB.LOTA20		 
		       , TB.LOCAKY
		       , TB.OWNRKY
		       , TB.TRNUID
		       , TB.PACKID
			   , TB.LIMITQT
			   , TB.INPUTQTY
			   , TB.ALOTPCK
			   , TB.ALOTPCK_YN
			   , TB.AREAKY
			   , TB.USEQTY
	</select>
	
	<select id="PDPK05_SHPDI_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY
					 , TI.TASKIT
					 , TI.SHPOKY
					 , TI.SHPOIT
				     , NVL(TRIM(TI.ASKU01), TI.LOCASR) AS LOCASR
				     , TI.SKUKEY AS SKUKEY
		             , SM.DESC01 AS DESC01
				     , TI.QTTAOR AS QTTAOR
				     , TI.QTCOMP AS QTCOMP		     
				     , TI.LOTA01 AS LOTA01
		             , TI.LOTA02 AS LOTA02
		             , TI.LOTA03 AS LOTA03
		             , TI.LOTA09 AS LOTA09
		             , TI.LOTA11 AS LOTA11
		             , TI.LOTA12 AS LOTA12
		             , TI.LOTA13 AS LOTA13
		             , TI.LOTA14 AS LOTA14		     
		             , SM.GTINCD AS GTINCD
				     , SM.DUOMKY AS UOMKEY 
				     , TI.STATIT
				     , TH.WAREKY
				     , SI.ALSTKY		
				     , NVL(TRIM(#{STKNUM}), ' ') AS STKNUM		      
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				       INNER JOIN SHPDI SI ON SI.SHPOKY = TI.SHPOKY AND SI.SHPOIT = TI.SHPOIT
				       INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
				       INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY
				                          AND SM.SKUKEY = TI.SKUKEY
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 
				   AND SM.MTYPE LIKE #{SES_MTYPE} 
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN ('NEW', 'FPC', 'PPC', 'FIN') 
				   AND TI.TASKTY IN ('PK')
				<if test="STKNUM != null and STKNUM != ''">   
				   AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				   AND #{LOCAKY} = NVL(TRIM(TI.ASKU01), #{LOCAKY})
				</if>
				<if test="BARCOD != null and BARCOD != '' and ETCLOTA14 != &quot;Y&quot;">
				   AND (TI.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>
				
			 	ORDER BY TI.LOTA14 ASC
	
	</select>
	
	<select id="PDPK05StockLota11Validation_LIST" parameterType="Map" resultType="DataMap">
	 SELECT
			    B.*,
			    CASE
			        WHEN RNGVOP = 'LS' THEN
			                CASE
			                    WHEN A.LOTA11 LIKE TO_CHAR(ADD_MONTHS(SYSDATE, - 12), 'YYYY')
			                                       || '%' THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        WHEN RNGVOP = 'TS' THEN
			                CASE
			                    WHEN A.LOTA11 LIKE TO_CHAR(SYSDATE, 'YYYY')
			                                       || '%' THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        WHEN RNGVOP = 'GT' THEN
			                CASE
			                    WHEN A.LOTA11 >= TO_CHAR(SYSDATE - RNGVMI, 'YYYYMMDD') THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        ELSE
			            'Y'
			    END AS CHECK_LOTA11
			FROM
			         STKKY A
			    INNER JOIN SHPDI SI ON SI.SHPOKY = A.SHPOKY
			                           AND SI.SHPOIT = A.SHPOIT
			    LEFT OUTER JOIN (
			        SELECT
			            RNGVOP,
			            NVL(RNGVMI, 0) AS RNGVMI
			        FROM
			            RLRRI
			        WHERE
			                WAREKY = #{WAREKY}
			            AND LOTRKY = #{ALSTKY}
			            AND DBFILD = 'LOTA11'
			    )     B ON 1 = 1
			WHERE
			        SI.STKNUM = #{STKNUM}
			    AND SI.SKUKEY = #{SKUKEY}
			    AND A.LOTA14 = #{LOTA14}
		        <if test="SHPOKY != null and SHPOKY != ''">	 
			    AND SI.SHPOKY = #{SHPOKY}
			    AND SI.SHPOIT = #{SHPOIT}
			    </if>
			    AND A.QTSIWH > 0
			    AND A.QTSALO > 0
			    AND A.QTSIWH = A.QTSALO
				
	</select>
	
	<select id="PDPK05StockEtcLota11Validation_LIST" parameterType="Map" resultType="DataMap">
	 SELECT
			    B.*,
			    CASE
			        WHEN RNGVOP = 'LS' THEN
			                CASE
			                    WHEN A.LOTA11 LIKE TO_CHAR(ADD_MONTHS(SYSDATE, - 12), 'YYYY')
			                                       || '%' THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        WHEN RNGVOP = 'TS' THEN
			                CASE
			                    WHEN A.LOTA11 LIKE TO_CHAR(SYSDATE, 'YYYY')
			                                       || '%' THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        WHEN RNGVOP = 'GT' THEN
			                CASE
			                    WHEN A.LOTA11 >= TO_CHAR(SYSDATE - RNGVMI, 'YYYYMMDD') THEN
			                        'Y'
			                    ELSE
			                        'N'
			                END
			        ELSE
			            'Y'
			    END AS CHECK_LOTA11
			FROM
			         STKKY A
			    LEFT OUTER JOIN (
			        SELECT
			            RNGVOP,
			            NVL(RNGVMI, 0) AS RNGVMI
			        FROM
			            RLRRI
			        WHERE
			                WAREKY = #{WAREKY}
			            AND LOTRKY = #{ALSTKY}
			            AND DBFILD = 'LOTA11'
			    )     B ON 1 = 1
			WHERE A.LOTA14 = #{BARCOD}		       				
	</select>
	
	<!-- ================================================================================================== -->
	<!-- PDPK05 지시번호별 피킹 : END-->
	<!-- ================================================================================================== -->
	
	
	<!-- ================================================================================================== -->
	<!-- PDLD21 지시번호별 피킹 : START-->
	<!-- ================================================================================================== -->
	<select id="STKNUM_ORDER_INFO_LIST" parameterType="Map" resultType="DataMap">
		SELECT * FROM
		
		(	    
			SELECT CASE WHEN COUNT(*) = 0   THEN 'N'
			            WHEN COUNT(CASE WHEN KEEPIT = 'V' THEN 1 END) > 0 THEN 'OUT_M0195†' || SHPOKY 			
		            	WHEN STATDO NOT IN ('FPC', 'PPC') THEN 'MOBILE_M0048†' || SHPOKY || '/' || STATDONM
		           		ELSE 'Y'
		        	END MSGRESULT
	        	FROM (
	        	
                 SELECT   SH.SHPOKY
                        , SH.STATDO
                        , (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATDO' AND X.CMCDVL = SH.STATDO) AS STATDONM
                        , SI.STKNUM
                        , SI.KEEPIT
                   FROM SHPDH  SH 
                  INNER JOIN SHPDI  SI ON SH.SHPOKY = SI.SHPOKY 
                  WHERE SH.WAREKY = #{WAREKY}
		           	AND SH.OWNRKY = #{OWNRKY}  
		            AND SI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})  				   	
		           	AND SH.STATDO NOT IN('OCN') 		            	
		           	AND (SI.STKNUM = #{STKNUM} OR SI.STLNUM = #{STKNUM})
                    
                    
	)	            
		    		GROUP BY SHPOKY, STATDO, STATDONM, STKNUM ORDER BY MSGRESULT DESC
                    ) WHERE ROWNUM = 1
                    
		   
    </select>
	
	<select id="PDLD21_LIST" parameterType="Map" resultType="DataMap">    
	 SELECT    A.PTNRKY
                , A.PTNRNM
                , A.STKNUM
                , A.TASKKY                
                , CASE WHEN   A.TOTQTSHPC = A.TOTQTCOMP THEN 'FCK'
		                	   WHEN SUM(A.QTSHPC) = 0 THEN 'FPC'
		                       ELSE 'PCK' 
                  END AS STATIT
                , (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = 
                	(CASE WHEN A.TOTQTSHPC = A.TOTQTCOMP THEN 'FCK'
                    	  WHEN A.TOTQTSHPC =0 THEN 'FPC'
                		  ELSE 'PCK' 
                	END)) AS STATITNM
                , CASE WHEN A.TOTQTSHPC = A.TOTQTCOMP THEN 'V' 
                    ELSE ' '
                  END  AS FCKCOM
    	FROM (
                 SELECT   TH.PTNRKY, CT.NAME01 AS PTNRNM, #{STKNUM} AS STKNUM		      	
                        , TH.TASKKY
                        , SUM(TI.QTCOMP) OVER (PARTITION BY   TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT) AS QTCOMP
                        , SUM(CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP ELSE 0 END) OVER (PARTITION BY   TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT)   AS QTSHPC
                        , SUM(TI.QTCOMP) OVER (PARTITION BY SI.SHPOKY) AS TOTQTCOMP
                        , SH.QTSHPC AS TOTQTSHPC
                        , TI.LSTTFL   
                 FROM TASDH  TH
                      INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY  AND TI.TASKTY IN ('PK')                       
                      INNER JOIN SHPDH  SH ON SH.SHPOKY = TI.SHPOKY
                      INNER JOIN SHPDI  SI ON SH.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
                      LEFT OUTER JOIN BZPTN CT ON CT.PTNRKY = SH.DPTNKY AND CT.PTNRTY = 'CT' AND CT.OWNRKY = SH.OWNRKY                      
                      LEFT OUTER JOIN TASTP TP ON TP.SHPOKY = SH.SHPOKY                        
                 WHERE TH.WAREKY = #{WAREKY}
		           	AND TI.OWNRKY = #{OWNRKY}  
		            AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})  
				   	AND TI.STATIT IN('FPC', 'PPC', 'PCK', 'FCK')          		     
		           	AND SH.STATDO IN('FPC', 'PPC', 'PCK', 'FCK') 
		           <if test="STKNUM != null and STKNUM != ''">	 
		           	AND (TI.STKNUM = #{STKNUM} OR TP.STKNUM = #{STKNUM} )
		           </if>
		           <if test="TASKKY != null and TASKKY != ''">
				    AND TH.TASKKY = #{TASKKY}
				   </if> 
			             
           ) A
           
          GROUP BY A.PTNRKY, A.PTNRNM, A.STKNUM, A.TASKKY, A.TOTQTSHPC, A.TOTQTCOMP     
          ORDER BY DECODE(FCKCOM, 'V', 1, 0) ASC    
    </select>
    
    <select id="PDLD21SUB_LIST" parameterType="Map" resultType="DataMap">    
		
		SELECT    TH.TASKKY                
                , TI.TASKIT
                , TI.SHPOKY
                , TI.SHPOIT
                , #{STKNUM} AS STKNUM      
        FROM TASDH  TH
              INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY                         
              INNER JOIN SHPDH  SH ON SH.SHPOKY = TI.SHPOKY
              INNER JOIN SHPDI  SI ON SH.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
              LEFT OUTER JOIN TASTP TP ON TP.SHPOKY = SH.SHPOKY                                                              
         WHERE TH.WAREKY = #{WAREKY}
           AND TI.OWNRKY = #{OWNRKY}       
		   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})            
		   AND TI.STATIT IN('FPC', 'PPC')  AND TI.TASKTY IN ('PK') 
		   AND SH.STATDO IN('FPC', 'PPC', 'FCK', 'PCK')      		     
           AND SI.STATIT IN('PAL', 'FAL','FPC', 'PPC', 'FCK', 'PCK')             
           AND TI.LSTTFL != 'V'
           <if test="STKNUM != null and STKNUM != ''">
		   AND (TI.STKNUM = #{STKNUM} OR TP.STKNUM = #{STKNUM} )
           </if>
           <if test="TASKKY != null and TASKKY != ''">
		    AND TH.TASKKY = #{TASKKY}
		   </if>  
		   <if test="LOTA14 != null and LOTA14 != ''">
			AND TI.LOTA14= #{LOTA14}
		   </if>                  		
    </select>
    
    <select id="PDLD21_COUNT_LIST" parameterType="Map" resultType="DataMap">
		 SELECT   COUNT(CASE WHEN STATIT = 'FCK' THEN 1 END) AS NOWCOMPCNT
			 	 ,COUNT(*) AS TOTCOMPCNT 
		  FROM 
			  (
			  	SELECT    A.PTNRKY
		                , A.PTNRNM
		                , A.STKNUM
		                , A.TASKKY                
		                , CASE WHEN SUM(A.QTCOMP) = SUM(A.QTSHPC) THEN 'FCK'
		                	   WHEN SUM(A.QTSHPC) = 0 THEN 'FPC'
		                       ELSE 'PCK' 
		                  END AS STATIT
		                , (SELECT X.CDESC1 FROM CMCDV X WHERE X.CMCDKY = 'STATIT' AND X.CMCDVL = 
		                	(CASE WHEN A.TOTQTSHPC = A.TOTQTCOMP THEN 'FCK'
		                    	  WHEN A.TOTQTSHPC =0 THEN 'FPC'
		                		  ELSE 'PCK' 
		                	END)) AS STATITNM
		                , ' ' AS FCKCOM
		    	FROM (
		                 SELECT   TH.PTNRKY, TH.PTNRNM, #{STKNUM} AS STKNUM		      	
		                        , TH.TASKKY
		                        , SUM(TI.QTCOMP) OVER (PARTITION BY   TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT) AS QTCOMP
		                        , SUM(CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP ELSE 0 END) OVER (PARTITION BY   TI.TASKKY, TI.TASKIT, TI.SHPOKY, TI.SHPOIT)   AS QTSHPC
                        		, SUM(TI.QTCOMP) OVER (PARTITION BY SI.SHPOKY) AS TOTQTCOMP
		                        , SH.QTSHPC TOTQTSHPC
		                        , TI.LSTTFL
		                 FROM TASDH  TH
		                      INNER JOIN TASDI  TI ON TH.TASKKY = TI.TASKKY   AND TI.TASKTY IN ('PK')                      
		                      INNER JOIN SHPDH  SH ON SH.SHPOKY = TI.SHPOKY
		                      INNER JOIN SHPDI  SI ON SH.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT
		                      LEFT OUTER JOIN TASTP TP ON TP.SHPOKY = SH.SHPOKY                                                              		                                              
		                 WHERE TH.WAREKY = #{WAREKY}
					           AND TI.OWNRKY = #{OWNRKY}
	           				   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 					                
							   AND TI.STATIT IN('FPC', 'PPC')          		     
					           AND SI.STATIT IN('FPC', 'PPC', 'FCK', 'PCK')  
					           <if test="STKNUM != null and STKNUM != ''">
		  					   AND (TI.STKNUM = #{STKNUM} OR TP.STKNUM = #{STKNUM} )
					           </if>
					           <if test="TASKKY != null and TASKKY != ''">
							    AND TH.TASKKY = #{TASKKY}
							   </if>
		           ) A
		           
		          GROUP BY A.PTNRKY, A.PTNRNM, A.STKNUM, A.TASKKY, A.TOTQTCOMP, A.TOTQTSHPC
			  )
	</select>
	
	<select id="PDLD21_DETAIL_LIST" parameterType="Map" resultType="DataMap">
     SELECT    
     		CASE WHEN COUNT(*) = COUNT(CASE WHEN A.FCKCOM ='V' THEN 1 END) THEN 'V' ELSE ' '  END AS FCKCOM
             , A.SKUKEY   
             , SUM(A.QTCOMP) QTCOMP
             , A.DESC01 
             , SUM(A.QTSHPC) QTSHPC
             , A.UOMKEY
             , SUM(A.BOX) BOX
             , SUM(A.PLT) PLT
             , A.LOTA01 AS LOTA01
			 , A.LOTA02 AS LOTA02
			 , A.LOTA03 AS LOTA03			 
			 --, A.LOTA09 AS LOTA09
			 --, A.LOTA11 AS LOTA11
			 --, A.LOTA12 AS LOTA12
			 --, A.LOTA13 AS LOTA13
			 --, A.LOTA14 AS LOTA14
			 --, A.LOTA15 AS LOTA15
             --, A.SHPOKY AS SHPOKY             
             --, A.SHPOIT AS SHPOIT  
             --, A.TASKKY AS TASKKY
             --, A.TASKIT AS TASKIT
			 , A.STKNUM AS STKNUM            
             , A.PTNRKY AS PTNRKY 
             , A.WAREKY AS WAREKY
             , A.PTNRNM AS PTNRNM 
             , CM.USARG2 AS TEMP_ORDER -- 출고지시서와 동일한 정렬조건 적용
          FROM   (

				SELECT 
		               TI.SKUKEY   
		             , TI.QTCOMP
		             , SZF_GET_SKU_DESC01_TEXT('KR', TI.OWNRKY, TI.SKUKEY) AS DESC01 
		             , CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP 
		                ELSE 0
		                END AS QTSHPC 
		             , TI.SUOMKY AS UOMKEY
		             , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTCOMP, TI.SUOMKY, 'BOX')),'0') AS BOX
		             , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTCOMP, TI.SUOMKY, 'PAL')),'0') AS PLT
		             , TI.LOTA01 AS LOTA01
					 , TI.LOTA02 AS LOTA02
					 , TI.LOTA03 AS LOTA03			 
					 , TI.LOTA09 AS LOTA09
					 , TI.LOTA11 AS LOTA11
					 , TI.LOTA12 AS LOTA12
					 , TI.LOTA13 AS LOTA13
					 , TI.LOTA14 AS LOTA14
					 , TI.LOTA15 AS LOTA15
					 , TI.SHPOKY AS SHPOKY	 		  					
		             , TI.SHPOIT AS SHPOIT
		             , TI.LSTTFL AS FCKCOM
		             , #{STKNUM} AS STKNUM	
		             , TI.TASKKY AS TASKKY
                     , TI.TASKIT AS TASKIT 	
                     , TI.OWNRKY AS OWNRKY
                     , TH.PTNRKY AS PTNRKY 
                     , TH.WAREKY AS WAREKY
                     , CT.NAME01 AS PTNRNM 
		        FROM SHPDH SH
		               INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
		               INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT AND TI.TASKTY IN ('PK')
		               INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY 
		               LEFT OUTER JOIN BZPTN CT ON CT.PTNRKY = SH.DPTNKY AND CT.PTNRTY = 'CT' AND CT.OWNRKY = SH.OWNRKY 
		               LEFT OUTER JOIN TASTP TP ON TP.SHPOKY = SH.SHPOKY                                                              
				WHERE 1 = 1
					AND TH.WAREKY = #{WAREKY}		
				    AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 						
	                AND TI.STATIT IN('PPC', 'FPC')
	               <if test="STKNUM != null and STKNUM != ''"> 
 					   AND TI.STKNUM = #{STKNUM}
	               </if>           
   				   <if test="DPTNKY != null and DPTNKY != ''">
					AND TH.PTNRKY = #{DPTNKY}
				   </if>
				   <if test="TASKKY != null and TASKKY != ''">
					AND TH.TASKKY = #{TASKKY}
				   </if>
				   
				UNION 
				
				SELECT 
		               TI.SKUKEY   
		             , TI.QTCOMP
		             , SZF_GET_SKU_DESC01_TEXT('KR', TI.OWNRKY, TI.SKUKEY) AS DESC01 
		             , CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP 
		                ELSE 0
		                END AS QTSHPC 
		             , TI.SUOMKY AS UOMKEY
		             , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTCOMP, TI.SUOMKY, 'BOX')),'0') AS BOX
		             , NVL(TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TI.QTCOMP, TI.SUOMKY, 'PAL')),'0') AS PLT
		             , TI.LOTA01 AS LOTA01
					 , TI.LOTA02 AS LOTA02
					 , TI.LOTA03 AS LOTA03			 
					 , TI.LOTA09 AS LOTA09
					 , TI.LOTA11 AS LOTA11
					 , TI.LOTA12 AS LOTA12
					 , TI.LOTA13 AS LOTA13
					 , TI.LOTA14 AS LOTA14
					 , TI.LOTA15 AS LOTA15
					 , TI.SHPOKY AS SHPOKY	 		  					
		             , TI.SHPOIT AS SHPOIT
		             , TI.LSTTFL AS FCKCOM
		             , #{STKNUM} AS STKNUM	
		             , TI.TASKKY AS TASKKY
                     , TI.TASKIT AS TASKIT 	
                     , TI.OWNRKY AS OWNRKY
                     , TH.PTNRKY AS PTNRKY 
                     , TH.WAREKY AS WAREKY
                     , CT.NAME01 AS PTNRNM 
		        FROM SHPDH SH
		               INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
		               INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT AND TI.TASKTY IN ('PK')
		               INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY 
		               LEFT OUTER JOIN BZPTN CT ON CT.PTNRKY = SH.DPTNKY AND CT.PTNRTY = 'CT' AND CT.OWNRKY = SH.OWNRKY 
		               LEFT OUTER JOIN TASTP TP ON TP.SHPOKY = SH.SHPOKY                                                              
				WHERE 1 = 1
					AND TH.WAREKY = #{WAREKY}		
				    AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE}) 						
	                AND TI.STATIT IN('PPC', 'FPC')
	               <if test="STKNUM != null and STKNUM != ''"> 
					AND TP.STKNUM = #{STKNUM}
	               </if>           
   				   <if test="DPTNKY != null and DPTNKY != ''">
					AND TH.PTNRKY = #{DPTNKY}
				   </if>
				   <if test="TASKKY != null and TASKKY != ''">
					AND TH.TASKKY = #{TASKKY}
				   </if>
							   
                 ) A 
                 INNER JOIN SKUMA SM ON SM.OWNRKY = A.OWNRKY AND SM.SKUKEY = A.SKUKEY 
				 LEFT JOIN CMCDV CM ON SM.SKUL01 = CM.CMCDVL AND CM.CMCDKY = 'SKUL01' 
                 
                 	<if test="checkFck != null and checkFck != ''">
						WHERE A.FCKCOM ='V'
				    </if>
                        
        GROUP BY     A.SKUKEY, A.DESC01, A.UOMKEY, A.LOTA01, A.LOTA02, A.LOTA03, 
        		  -- A.LOTA09, A.LOTA11, A.LOTA12, A.LOTA13, A.LOTA14, A.LOTA15, A.SHPOKY, A.SHPOIT, A.TASKKY, A.TASKIT, 
        			 A.STKNUM, A.PTNRKY, A.WAREKY, A.PTNRNM, CM.USARG2 
        ORDER BY DECODE(FCKCOM, 'V', 1, 0) ASC, TEMP_ORDER, A.SKUKEY 
	</select>
	
	<select id="PDLD21DETAILCNT_MAP" parameterType="Map" resultType="DataMap">
		SELECT        COUNT(*) AS CNT
		            , COUNT(CASE WHEN NVL(QTCOMP, 0) = NVL(QTSHPC, 0) THEN 1 END) AS COMPCNT2              
		            , NVL(SUM(NVL(QTCOMP,0)), 0) AS QTCOMP
		            , NVL(SUM(NVL(QTSHPC,0)), 0)AS QTSHPC
		            , NVL(MAX(UOMKEY), 'PAL') AS UOMKEY           
    	FROM (
     
			SELECT    CASE WHEN COUNT(*) = COUNT(CASE WHEN A.FCKCOM ='V' THEN 1 END) THEN 'V'
		               		ELSE ' ' 
		               END AS FCKCOM
		             , A.SKUKEY   
		             , SUM(A.QTCOMP) QTCOMP
		             , A.DESC01 
		             , SUM(A.QTSHPC) QTSHPC
		             , A.UOMKEY
		             , A.LOTA01 AS LOTA01
					 , A.LOTA02 AS LOTA02
					 , A.LOTA03 AS LOTA03			 
					 , A.LOTA09 AS LOTA09
					 , A.LOTA11 AS LOTA11
					 , A.LOTA12 AS LOTA12
					 , A.LOTA13 AS LOTA13
					 , A.LOTA14 AS LOTA14
					 , A.LOTA15 AS LOTA15
		             , A.STKNUM AS STKNUM
		             , A.TASKKY AS TASKKY	 		  					
            
          FROM   (

				SELECT 
		               TI.SKUKEY   
		             , TI.QTCOMP
		             , SZF_GET_SKU_DESC01_TEXT('KR', TI.OWNRKY, TI.SKUKEY) AS DESC01 
		             , CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP 
		                ELSE 0
		                END AS QTSHPC 
		             , TI.SUOMKY AS UOMKEY
		             , TI.LOTA01 AS LOTA01
					 , TI.LOTA02 AS LOTA02
					 , TI.LOTA03 AS LOTA03			 
					 , TI.LOTA09 AS LOTA09
					 , TI.LOTA11 AS LOTA11
					 , TI.LOTA12 AS LOTA12
					 , TI.LOTA13 AS LOTA13
					 , TI.LOTA14 AS LOTA14
					 , TI.LOTA15 AS LOTA15
					 , TI.SHPOKY AS SHPOKY	 		  					
		             , TI.SHPOIT AS SHPOIT
		             , TI.TASKKY AS TASKKY	 		  					
		             , TI.TASKIT AS TASKIT  
		             , TI.LSTTFL AS FCKCOM	
		             , #{STKNUM} AS STKNUM 		  					 
		        FROM SHPDH SH
		               INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
		               INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT AND TI.TASKTY IN ('PK')
		               INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY               
					   LEFT OUTER JOIN TASTP TP ON TP.SHPOKY = SH.SHPOKY	
							WHERE 1 = 1
								
								AND TH.WAREKY = #{WAREKY}
							    AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})								
				                AND TI.STATIT IN('PPC', 'FPC')
				                <if test="STKNUM != null and STKNUM != ''">
		  					    AND (TI.STKNUM = #{STKNUM} OR TP.STKNUM = #{STKNUM} )
				                </if>
		    				    <if test="DPTNKY != null and DPTNKY != ''">
								AND TH.PTNRKY = #{DPTNKY}
							    </if>
							    <if test="TASKKY != null and TASKKY != ''">
								AND TH.TASKKY = #{TASKKY}
							    </if>
							   
                 ) A 
                        
	        GROUP BY     A.SKUKEY, A.DESC01, A.UOMKEY, A.LOTA01, 
	                     A.LOTA02, A.LOTA03, A.LOTA09, A.LOTA11, A.LOTA12, 
	                     A.LOTA13, A.LOTA14, A.LOTA15, A.STKNUM, A.TASKKY 	
			)		
	</select>
	
	<!-- PDLD21 검수 밸리데이션 -->
	<select id="PDLD21Validation1_MAP" parameterType="Map" resultType="DataMap">
		SELECT NVL(MAX(TI.SHPOKY), 'OK') AS MSG
		  FROM TASDH TH
                    INNER JOIN TASDI TI
		  	   		   ON TI.TASKKY = TH.TASKKY        
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TI.SHPOKY = #{SHPOKY}
		   AND TI.SHPOIT = #{SHPOIT}		
		   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})   
           AND TI.STATIT NOT IN ('FPC', 'PPC')
           AND TI.TASKTY IN ('PK')       
          AND (TI.QTTAOR &gt; TI.QTCOMP OR TI.QTTAOR = 0 OR TI.QTCOMP = 0)
	</select>
	
	
	<!-- 검수완료시 TASDI에 검수여부 업데이트-->
	<update id="PDLD21Sub_UPDATE" parameterType="Map">
		UPDATE TASDI
		   SET LSTTFL = #{LSTTFL}
			 , LMODAT = TO_CHAR(SYSDATE,'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE,'HH24MISS')
			 , LMOUSR = #{SES_USER_ID}
		 WHERE SHPOKY = #{SHPOKY}
		   AND SHPOIT = #{SHPOIT}
		   AND TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}
		   AND STATIT IN ('FPC', 'PPC')
		   AND TASKTY IN ('PK')
		   
	</update>
	
	<!-- 검수수량 합산-->
	<select id="TOTAL_QTCOMP_MAP" parameterType="Map" resultType="DataMap">
		SELECT NVL(SUM(NVL(QTCOMP, 0)),0) AS QTCOMP
		FROM TASDI
		WHERE 1=1
		   AND LSTTFL = 'V'
		   AND STATIT IN('FPC', 'PPC')
		   AND TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}	
		   AND TASKTY IN ('PK')
		   AND LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})		   
	</select>
	
	<select id="PDLD21LISTValidation_LIST" parameterType="Map" resultType="DataMap">
     SELECT 
               CASE WHEN TI.LSTTFL = 'V' THEN 'Y'
                    ELSE 'N' END AS LOADYN
             , TI.SKUKEY   
             , TI.QTCOMP
             , SZF_GET_SKU_DESC01_TEXT(#{LANGKY}, TI.OWNRKY, TI.SKUKEY) AS DESC01 
             , CASE WHEN TI.LSTTFL = 'V' THEN TI.QTCOMP 
                ELSE 0
                END AS QTSHPC 
             , TI.SUOMKY AS UOMKEY
             , TI.LOTA01 AS LOTA01
			 , TI.LOTA02 AS LOTA02
			 , TI.LOTA03 AS LOTA03			 
			 , TI.LOTA09 AS LOTA09
			 , TI.LOTA11 AS LOTA11
			 , TI.LOTA12 AS LOTA12
			 , TI.LOTA13 AS LOTA13
			 , TI.LOTA14 AS LOTA14
			 , TI.LOTA15 AS LOTA15
             , TI.SHPOKY AS SHPOKY	 		  					
             , TI.SHPOIT AS SHPOIT
             , TI.TASKKY AS TASKKY	 		  					
             , TI.TASKIT AS TASKIT 
        FROM SHPDH SH
               INNER JOIN SHPDI SI ON SI.SHPOKY = SH.SHPOKY
               INNER JOIN TASDI TI ON TI.SHPOKY = SI.SHPOKY AND TI.SHPOIT = SI.SHPOIT AND TI.TASKTY IN ('PK')
               INNER JOIN TASDH TH ON TH.TASKKY = TI.TASKKY               

					WHERE 1 = 1
						AND TH.WAREKY = #{WAREKY}		
						AND TI.LSTTFL != 'V' 
						AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
		                AND TI.STATIT IN('PPC', 'FPC')
		                AND TI.TASKTY IN ('PK')
		                <if test="STKNUM != null and STKNUM != ''">
		                AND (TI.STKNUM = #{STKNUM} )               
		                </if>
    				   <if test="DPTNKY != null and DPTNKY != ''">
						AND TH.PTNRKY = #{DPTNKY}
					   </if>
					   <if test="BARCOD != null and BARCOD != ''">
						AND TI.LOTA14= #{BARCOD}
					   </if>					


		ORDER BY TI.LMODAT, TI.LMOTIM ASC			   
	</select>
	
	<update id="PDPK05_DETAIL_UPDATE" parameterType="Map">
		UPDATE TASDI
		SET QTCOMP = #{QTCOMP}	
		WHERE TASKKY = #{TASKKY}
			AND TASKIT = #{TASKIT}
	</update>
	
	
	<delete id="PDPK05_DETAIL_DELETE" parameterType="Map">
		DELETE TASDI		
		WHERE TASKKY = #{TASKKY}
			AND TASKIT = #{TASKIT}
	</delete>
	
	<!-- 저장위치 콤보 리스트 조회 -->
    <select id="LOTA01COMBO_LIST" parameterType="Map" resultType="DataMap">   
    	SELECT 
			  STLKY AS VALUE_COL
			, STLNM AS TEXT_COL			
		FROM STLMA
		WHERE 1=1 
			AND WAREKY = #{WAREKY}  
			AND OWNRKY = #{OWNRKY} 
			AND PLNTKY = #{PLNTKY}
			<choose>
				<when test='PLNTKY == "P100" and STLKY == "2400" and FIRSTSKUKEY == "S"'>
				AND STLKY = #{STLKY}
				ORDER BY DECODE(STLKY, '2400', 1) ASC, STLKY ASC
				</when>
				<otherwise>
				AND WMSMAK = #{WMSMAK}
				ORDER BY DECODE(STLKY, '3100', 1) ASC, STLKY ASC
				</otherwise>
			</choose>					
		
	</select>
	
	<select id="PDTK10_LIST" parameterType="Map" resultType="DataMap">
		WITH PDTK10 AS (
			SELECT T1.PROGID
			     , T1.DOCCAT 
			     , T1.DOCUTY 
			FROM DOCPG T1
			WHERE T1.PROGID=#{PROGID}
			  AND ROWNUM=1
		)
		SELECT ' ' AS SHPOKY
			 , #{WAREKY} AS WAREKY
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}),' ') AS WARENM
			 , NVL(#{OWNRKY},' ') AS OWNRKY
			 , NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = NVL(#{OWNRKY},' ')),' ') AS OWNRNM
			 , TO_CHAR(SYSDATE,'YYYYMMDD') AS DOCDAT
			 , (SELECT X.DOCCAT FROM PDTK10 X) AS DOCCAT
			 , SZF_GET_DOCCAT_TEXT(#{LANGKY}, (SELECT X.DOCCAT FROM PDTK10 X)) AS DOCCATNM
			 , (SELECT X.DOCUTY FROM PDTK10 X) AS DOCUTY
			 , SZF_GET_DOCUTY_TEXT(#{LANGKY}, (SELECT X.DOCUTY FROM PDTK10 X)) AS DOCUTYNM
			 , 'NEW' AS STATDO
			 ,(SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', 'NEW') FROM DUAL) AS STATDONM
			 , ' ' AS DOCTXT
			 , ' ' AS PTNRTY
			 , ' ' AS DPTNKY
		     , ' ' AS DPTNKYNM
		     , ' ' AS LOTA01
		     , ' ' AS LOTA01NM
		     , 'V' AS SAPIFYN
		     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS ASNDAT
		     , 'WMS_IF_320,WMS_IF_322' AS IFID
		FROM DUAL
	</select>
	
	<select id="PDTK10StockValidation_LIST" parameterType="Map" resultType="DataMap">  
	SELECT  
			A.LOCASR,
			A.AREAKY,
        	A.ZONEKY,
	        A.SKUKEY,
	        A.DESC01,
	        SUM(A.QTSIWH) AS QTSIWH,
	        A.UOMKEY,
	        A.LOTA01,
	        A.LOTA02,
	        A.LOTA14,
	        A.TOWAREKY,
	        A.LIMITQT,
	        CASE   WHEN A.LIMITQT &lt; = SUM(A.SHPQTY) AND A.LIMITQT &lt;&gt; 0 THEN A.LIMITQT
                   WHEN (A.LIMITQT &gt; SUM(A.SHPQTY)  AND A.LIMITQT &lt;&gt; 0 ) OR A.LIMITQT = 0 THEN SUM(A.SHPQTY)                                                           
            END AS  SHPQTY,
            NVL(TRIM(SUBSTR(A.SKUKEY, 0 , 1)), ' ') AS FIRSTSKUKEY,
            A.LOTA01 AS STLKY                 
	FROM (
	
			SELECT     B.STOKKY
			 	   	 , B.WAREKY	  		 
			  		 , B.AREAKY  
					 , B.ZONEKY  
					 , B.LOTNUM  
					 , B.LOCASR 
					 , B.LOCAKY 
					 , B.TRNUSR  
			  		 , B.LOCATG
			  		 , B.TRNUTG 
			  		 , B.LOCAAC
			  		 , B.TRNUAC	
			  		 , B.OWNRKY 
					 , B.SKUKEY 
			  		 , B.DESC01
			  		 , B.DESC02
			  		 , B.QTSIWH
			  		 , B.QTABLE
			  		 , B.SHPQTY
			  		 , B.QTSPUT
			  		 , B.QTSWQT
			  		 , B.UOMKEY
					 , B.SHPOKY
					 , B.SHPOIT
					 , B.DROPID
			  		 , B.LOTA01
					 , B.LOTA02
					 , B.LOTA03
					 , B.LOTA04
					 , B.LOTA05
					 , B.LOTA06
					 , B.LOTA06NM     
					 , B.LOTA07
					 , B.LOTA08
					 , B.LOTA09
					 , B.LOTA10
					 , B.LOTA11
					 , B.LOTA12
					 , B.LOTA13
					 , B.LOTA14
					 , B.LOTA15
					 , B.LOTA16
					 , B.LOTA17
					 , B.LOTA18
					 , B.LOTA19
					 , B.LOTA20
			  		 , B.RSNCOD
			  		 , B.RSNTXT
			  		 , B.SKUL01	
					 , B.TOT   
					 , B.BAG  
					 , B.BOX  
					 , B.PLT  
					 , B.SOK  
					 , B.EA	
					 , B.USEQTY  
					 , B.TOWAREKY
					 , B.LIMITQT
			 FROM(
			 
					WITH PDTK10 AS (
						SELECT T1.PROGID
						     , T1.DOCCAT 
						     , T1.DOCUTY 
						FROM DOCPG T1
						WHERE T1.DOCUTY = #{TASOTY}
						  AND ROWNUM=1
					)
					
					SELECT ST.STOKKY AS STOKKY
					     , ST.WAREKY AS WAREKY
					     , ST.AREAKY AS AREAKY
					     , ST.ZONEKY AS ZONEKY
					     , ST.LOTNUM AS LOTNUM
					     , ST.LOCAKY AS LOCASR
					     , ST.LOCAKY AS LOCAKY
					     , ST.TRNUID AS TRNUSR
					     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM PDTK10 X)),' ') AS LOCATG
					     , ' ' AS TRNUTG
					     , NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = (SELECT X.DOCUTY FROM PDTK10 X)),' ') AS LOCAAC
					     , ' ' AS TRNUAC
					     , ST.OWNRKY AS OWNRKY
					     , ST.SKUKEY AS SKUKEY
					     , SZF_GET_SKU_DESC01_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC01
					     , SZF_GET_SKU_DESC02_TEXT(#{LANGKY}, ST.OWNRKY, SM.SKUKEY) AS DESC02
					     , ST.QTSIWH AS QTSIWH
					     , ((ST.QTSIWH) - GREATEST((ST.QTSALO),(ST.QTSPMO)) - (ST.QTSBLK)) AS QTABLE
					     , ST.QTSIWH AS SHPQTY
					     , ST.QTSIWH AS QTSPUT
					     , DECODE(ST.LOTA06, '50', ST.QTSIWH, 0) AS QTSWQT /* 폐기 : Wasted     QuanTity */
					     , SM.DUOMKY AS UOMKEY		     
					     , ST.SHPOKY AS SHPOKY
					     , ST.SHPOIT AS SHPOIT
					     , ' ' AS DROPID
					     , CASE WHEN ST.LOTA01 = '2400' AND ST.LOTA02 = 'P100' AND NVL(TRIM(SUBSTR(ST.SKUKEY, 0, 1)), ' ') = 'S' THEN '2400'
					            ELSE '3100' 
					       END  AS TOWAREKY
					     , ST.LOTA01 AS LOTA01
					     , ST.LOTA02 AS LOTA02
					     , ST.LOTA03 AS LOTA03
					     , ST.LOTA04 AS LOTA04
					     , ST.LOTA05 AS LOTA05
					     , ST.LOTA06
					     , (SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', ST.LOTA06) FROM DUAL) AS LOTA06NM
					     , ST.LOTA07 AS LOTA07
					     , ST.LOTA08 AS LOTA08
					     , ST.LOTA09 AS LOTA09
					     , ST.LOTA10 AS LOTA10
					     , ST.LOTA11 AS LOTA11
					     , ST.LOTA12 AS LOTA12
					     , ST.LOTA13 AS LOTA13
					     , ST.LOTA14 AS LOTA14
					     , ST.LOTA15 AS LOTA15
					     , ST.LOTA16 AS LOTA16
					     , ST.LOTA17 AS LOTA17
					     , ST.LOTA18 AS LOTA18
					     , ST.LOTA19 AS LOTA19
					     , ST.LOTA20 AS LOTA20	
					     , ' ' AS RSNCOD
					     , ' ' AS RSNTXT
					     , NVL((SELECT SKUL01 FROM SKUMA WHERE SKUKEY = ST.SKUKEY AND OWNRKY = #{OWNRKY}),' ') AS SKUL01			 
						 , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'KG')),'0') AS TOT
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BAG')),'0') AS BAG
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'BOX')),'0') AS BOX
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'PAL')),'0') AS PLT
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'SOK')),'0') AS SOK
			             , NVL(TRIM(SZF_GET_CONVERT_QTY(ST.WAREKY, ST.SKUKEY, ST.QTSIWH, SM.DUOMKY, 'EA')),'0') AS EA
			             , CASE WHEN ST.AREAKY = 'SHP' THEN 0
							ELSE ST.QTSIWH - ST.QTSBLK
										  - GREATEST(ST.QTSALO, ST.QTSPMO)
										  - (CASE WHEN ST.LOTA06 IN ('00') OR ST.QTSPMO > 0 THEN 0
												  ELSE ST.QTSIWH
											 END)
					   		END AS USEQTY
					   	 , NVL((SELECT MEAS.QTPUOM FROM MEASI MEAS WHERE MEAS.MEASKY = ST.SKUKEY AND MEAS.WAREKY= #{WAREKY} AND MEAS.UOMKEY = 'PAL'), 0) AS LIMITQT   
					  FROM STKKY ST
					       INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY
					                          AND SM.SKUKEY = ST.SKUKEY
					 WHERE 1 = 1
					   AND ST.QTSIWH > 0
					   AND ST.QTSPMO = 0
					   AND ST.QTSBLK = 0
					   AND ST.AREAKY NOT IN ('SYS', 'SHP','CRT','RTS')
					   AND ST.LOCAKY NOT IN ('RTNLOC','SCRLOC')
					   AND ST.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
					   <!--정상재고만 조회 가능 -->
					   AND ST.LOTA06 IN ('00')
					   <if test="WAREKY != null and WAREKY != ''"> 
					   AND ST.WAREKY = #{WAREKY}
					   </if>
					   <if test="OWNRKY != null and OWNRKY != ''"> 
					   AND ST.OWNRKY = #{OWNRKY}
					   </if>					   
					   <if test="BARCOD != null and BARCOD != ''"> 
					   AND ST.LOTA14 = #{BARCOD}
					   </if>	
					) B 
		) A
            GROUP BY A.LOCASR,A.AREAKY, A.ZONEKY, A.SKUKEY, A.DESC01,  A.UOMKEY, A.LOTA01, A.LOTA02, A.LOTA14, A.TOWAREKY, A.LIMITQT
            ORDER BY A.LOCASR,A.AREAKY, A.ZONEKY
	</select>
	
	<select id="PDTK10_AVAILABLE_STOCK_LIST" parameterType="Map" resultType="DataMap">
	SELECT     ST.STOKKY  AS "STOKKY",
		       ST.WAREKY  AS "WAREKY",
		       ST.LOTNUM  AS "LOTNUM",
		       ST.LOCAKY  AS "LOCAKY",
		       ST.TRNUID  AS "TRNUID",
		       ST.SECTID  AS "SECTID",
		       ST.PACKID  AS "PACKID",
		       ST.QTSIWH  AS "QTSIWH",
		       ST.QTSALO  AS "QTSALO",
		       ST.QTSPMO  AS "QTSPMO",
		       ST.QTSPMI  AS "QTSPMI",
		       ST.QTSBLK  AS "QTSBLK",
		       ST.QTYUOM  AS "QTYUOM",
		       ST.TRUNTY  AS "TRUNTY",
		       ST.MEASKY  AS "MEASKY",
		       ST.UOMKEY  AS "UOMKEY",
		       ST.QTPUOM  AS "QTPUOM",
		       ST.DUOMKY  AS "DUOMKY",
		       ST.QTDUOM  AS "QTDUOM",
		       ST.TKFLKY  AS "TKFLKY",
		       ST.STEPNO  AS "STEPNO",
		       ST.LSTTFL  AS "LSTTFL",
		       ST.SRCSKY  AS "SRCSKY",
		       ST.UOMDOC  AS "UOMDOC",
		       ST.CNTBSK  AS "CNTBSK",
		       ST.NUPDPS  AS "NUPDPS",
		       ST.REFDKY  AS "REFDKY",
		       ST.REFDIT  AS "REFDIT",
		       ST.REFCAT  AS "REFCAT",
		       ST.REFDAT  AS "REFDAT",
		       ST.PURCKY  AS "PURCKY",
		       ST.PURCIT  AS "PURCIT",
		       ST.ASNDKY  AS "ASNDKY",
		       ST.ASNDIT  AS "ASNDIT",
		       ST.RECVKY  AS "RECVKY",
		       ST.RECVIT  AS "RECVIT",
		       ST.SHPOKY  AS "SHPOKY",
		       ST.SHPOIT  AS "SHPOIT",
		       ST.GRPOKY  AS "GRPOKY",
		       ST.GRPOIT  AS "GRPOIT",
		       ST.TASKKY  AS "TASKKY",
		       ST.TASKIT  AS "TASKIT",
		       ST.SADJKY  AS "SADJKY",
		       ST.SADJIT  AS "SADJIT",
		       ST.SDIFKY  AS "SDIFKY",
		       ST.SDIFIT  AS "SDIFIT",
		       ST.PHYIKY  AS "PHYIKY",
		       ST.PHYIIT  AS "PHYIIT",
		       ST.OWNRKY  AS "OWNRKY",
		       ST.SKUKEY  AS "SKUKEY",
		       ST.LOTA01  AS "LOTA01",
		       ST.LOTA02  AS "LOTA02",
		       ST.LOTA03  AS "LOTA03",
		       ST.LOTA04  AS "LOTA04",
		       ST.LOTA05  AS "LOTA05",
		       ST.LOTA06  AS "LOTA06",
		       ST.LOTA07  AS "LOTA07",
		       ST.LOTA08  AS "LOTA08",
		       ST.LOTA09  AS "LOTA09",
		       ST.LOTA10  AS "LOTA10",
		       ST.LOTA11  AS "LOTA11",
		       ST.LOTA12  AS "LOTA12",
		       ST.LOTA13  AS "LOTA13",
		       ST.LOTA14  AS "LOTA14",
		       ST.LOTA15  AS "LOTA15",
		       ST.LOTA16  AS "LOTA16",
		       ST.LOTA17  AS "LOTA17",
		       ST.LOTA18  AS "LOTA18",
		       ST.LOTA19  AS "LOTA19",
		       ST.LOTA20  AS "LOTA20",
		       ST.AWMSNO  AS "AWMSNO",
		       ST.DESC01  AS "DESC01",
		       ST.DESC02  AS "DESC02",
		       ST.ASKU01  AS "ASKU01",
		       ST.ASKU02  AS "ASKU02",
		       ST.ASKU03  AS "ASKU03",
		       ST.ASKU04  AS "ASKU04",
		       ST.ASKU05  AS "ASKU05",
		       ST.EANCOD  AS "EANCOD",
		       ST.GTINCD  AS "GTINCD",
		       ST.SKUG01  AS "SKUG01",
		       ST.SKUG02  AS "SKUG02",
		       ST.SKUG03  AS "SKUG03",
		       ST.SKUG04  AS "SKUG04",
		       ST.SKUG05  AS "SKUG05",
		       ST.GRSWGT  AS "GRSWGT",
		       ST.NETWGT  AS "NETWGT",
		       ST.WGTUNT  AS "WGTUNT",
		       ST.LENGTH  AS "LENGTH",
		       ST.WIDTHW  AS "WIDTHW",
		       ST.HEIGHT  AS "HEIGHT",
		       ST.CUBICM  AS "CUBICM",
		       ST.CAPACT  AS "CAPACT",
		       ST.ZONEKY  AS "ZONEKY",
		       ST.TKZONE  AS "TKZONE",
		       ST.AREAKY  AS "AREAKY",
		       ST.SMANDT  AS "SMANDT",
		       ST.SEBELN  AS "SEBELN",
		       ST.SEBELP  AS "SEBELP",
		       ST.SZMBLNO AS "SZMBLNO",
		       ST.SZMIPNO AS "SZMIPNO",
		       ST.STRAID  AS "STRAID",
		       ST.SVBELN  AS "SVBELN",
		       ST.SPOSNR  AS "SPOSNR",
		       ST.STKNUM  AS "STKNUM",
		       ST.STPNUM  AS "STPNUM",
		       ST.SWERKS  AS "SWERKS",
		       ST.SLGORT  AS "SLGORT",
		       ST.SDATBG  AS "SDATBG",
		       ST.STDLNR  AS "STDLNR",
		       ST.SSORNU  AS "SSORNU",
		       ST.SSORIT  AS "SSORIT",
		       ST.SMBLNR  AS "SMBLNR",
		       ST.SZEILE  AS "SZEILE",
		       ST.SMJAHR  AS "SMJAHR",
		       ST.SXBLNR  AS "SXBLNR",
		       ST.SAPSTS  AS "SAPSTS",
		       ST.SBKTXT  AS "SBKTXT",
		       ST.CREDAT  AS "CREDAT",
		       ST.CRETIM  AS "CRETIM",
		       ST.CREUSR  AS "CREUSR",
		       ST.LMODAT  AS "LMODAT",
		       ST.LMOTIM  AS "LMOTIM",
		       ST.LMOUSR  AS "LMOUSR",
		       NVL((SELECT SYSLOC FROM DOCTM WHERE DOCUTY = #{TASOTY}), ' ') AS "LOCATG"
		  FROM STKKY ST
		       INNER JOIN LOCMA L
		               ON L.WAREKY = ST.WAREKY
		              AND L.LOCAKY = ST.LOCAKY
		 WHERE 1 = 1
			   AND ST.QTSIWH > 0
			   AND ST.QTSPMO = 0
			   AND ST.QTSBLK = 0
			  
			   <if test="WAREKY != null and WAREKY != ''"> 
			   AND ST.WAREKY = #{WAREKY}
			   </if>
			   <if test="OWNRKY != null and OWNRKY != ''"> 
			   AND ST.OWNRKY = #{OWNRKY}
			   </if>		   
			   <if test="STOKKY != null and STOKKY != ''">		   
				AND ST.STOKKY = #{STOKKY}
			   </if>
			   <if test="LOTA01 != null and LOTA01 != ''">		   
				AND ST.LOTA01 = #{LOTA01}
			   </if>
			   <if test="LOTA02 != null and LOTA02 != ''">		   
				AND ST.LOTA02 = #{LOTA02}
			   </if>
			   <if test="LOTA14 != null and LOTA14 != ''">		   
				AND ST.LOTA14 = #{LOTA14}
			   </if>
			   <if test="LOCASR != null and LOCASR != ''">		   
				AND ST.LOCAKY = #{LOCASR}
			   </if>
			   <if test="AREAKY != null and AREAKY != ''">		   
				AND ST.AREAKY = #{AREAKY}
			   </if>
			   <if test="ZONEKY != null and ZONEKY != ''">		   
				AND ST.ZONEKY = #{ZONEKY}
			   </if>
			   <if test="SKUKEY != null and SKUKEY != ''">		   
				AND ST.SKUKEY = #{SKUKEY}
			   </if>
			   
		   
		 ORDER BY ST.LOCAKY, ST.AREAKY, ST.ZONEKY
	</select>
	
	<select id="BARCOD_CHECK_MAP" parameterType="Map" resultType="DataMap">
	 SELECT MSG FROM 
	 (
	 	WITH CHK1 AS ( 
	 
	        SELECT 'MOBILE_M0031' AS MSG
	          FROM DUAL
	 		 WHERE NOT EXISTS(
		        SELECT ST.LOTA14
				  FROM STKKY ST
				  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY}  
						                  AND SM.SKUKEY = ST.SKUKEY
		          LEFT OUTER JOIN TASDI TI ON TI.LOTA14 = ST.LOTA14 
		                                  AND TI.TASKTY IN('PK')                      
		                                  AND TI.STATIT IN('NEW', 'FIN')                      
				 WHERE 1 = 1
					   AND ST.WAREKY = #{WAREKY}
					   AND ST.QTSIWH &gt;= 0
					   AND ST.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
					   AND SM.MTYPE LIKE #{SES_MTYPE}
					   AND ST.OWNRKY = #{OWNRKY}
					   AND (ST.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})		           
			           GROUP BY ST.LOTA14, TI.LOTA14
		         				)
	    ), 
		CHK2 AS (
		
			SELECT  CASE WHEN SUM(TI.QTTAOR) =  SUM(TI.QTCOMP) THEN 'MOBILE_M0045' 
			        END AS MSG
	                
					  FROM TASDH TH				 
			          INNER JOIN TASDI TI ON TH.TASKKY = TI.TASKKY
			                                  AND TI.TASKTY IN('PK')                      
			                                                      
					 WHERE 1 = 1
					   AND TH.WAREKY = #{WAREKY}			    		   
					   <if test="SKUKEY != null and SKUKEY != ''">		   
					   AND TI.SKUKEY = #{SKUKEY}
					   </if>
					   <if test="LOCAKY != null and LOCAKY != ''">		   
					   AND TI.LOCASR = #{LOCAKY}
					   </if>	
					    		   		   
					   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
					   AND TI.OWNRKY = #{OWNRKY}
					   AND TI.LOTA14 = #{BARCOD}
			           AND TI.STKNUM = #{STKNUM}
	                   AND TI.STATIT IN ('PPC','FPC','NEW')	
	                   	
					   AND NOT EXISTS
					   		(
			      			SELECT MSG FROM CHK1                                   
			      			)	
			      			
			UNION  ALL 
			SELECT MSG FROM CHK1                   
			
		), CHK3 AS (
			
			SELECT  CASE WHEN COUNT(TI.LOTA01)  &lt;= 0 THEN 'MOBILE_M0051'
			        	 ELSE 'Y' 
			        END AS MSG
	                
					  FROM TASDI TI				                                         
			                                                      
					 WHERE 1 = 1
					   AND TI.TASKTY IN('PK')
					   <if test="SKUKEY != null and SKUKEY != ''">		   
					   AND TI.SKUKEY = #{SKUKEY}
					   </if>					    					    		   
					   <if test="LOCAKY != null and LOCAKY != ''">		   
					   AND TI.LOCASR = #{LOCAKY}
					   </if>
					    	
					    		   		   
					   AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
					   AND TI.OWNRKY = #{OWNRKY}					           
			           AND (TI.STKNUM = #{STKNUM} OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM IN(#{STKNUM})))
                       AND TI.LOTA01 IN(SELECT ST.LOTA01 FROM STKKY ST  WHERE ST.LOTA14 =#{BARCOD})                   

			UNION  ALL 
			SELECT MSG FROM CHK2                   
			
		),
		CHK4 AS ( 
			SELECT 'MOBILE_M0043' AS MSG 
			  FROM DUAL
			 WHERE NOT EXISTS(
				        SELECT ST.LOTA14
						  FROM STKKY ST
						  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY}  
								                  AND SM.SKUKEY = ST.SKUKEY
				          LEFT OUTER JOIN TASDI TI ON TI.LOTA14 = ST.LOTA14 
				                                  AND TI.TASKTY IN('PK')                      
				                                  AND TI.STATIT IN('NEW', 'FIN')                      
						 WHERE 1 = 1
							   AND ST.WAREKY = #{WAREKY}
							   AND ST.QTSIWH &gt; 0
							   <if test="SKUKEY != null and SKUKEY != ''">		   
							   AND ST.SKUKEY = #{SKUKEY}
							   </if>
							   <if test="LOCAKY != null and LOCAKY != ''">		   
							   AND ST.LOCAKY = #{LOCAKY}
							   </if>	
							   AND ST.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
							   AND SM.MTYPE LIKE #{SES_MTYPE}
							   AND ST.OWNRKY = #{OWNRKY}
							   AND (ST.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
					           
					           GROUP BY ST.LOTA14, TI.LOTA14
				           )
							   AND NOT EXISTS(
							      SELECT MSG FROM CHK3                                   
							      			)			
	                   		   
			UNION  ALL 
			SELECT MSG FROM CHK3                         
			
			), 
		CHK5 AS ( 
			
			
			SELECT CASE WHEN NVL(TRIM(ST.LOTA14), ' ') != ' ' AND NVL(TRIM(TI.LOTA14), ' ') = ' '
				 												 
							  <if test="DIFFRENT_STKKY == &quot;Y&quot;">
							   AND ( SELECT USARG1 FROM CMCDV CM
									                         WHERE CMCDKY = 'ALOTPCK'
									                         AND TRIM(SM.SKUG05) || TRIM(SM.SKUL01) = CM.CMCDVL
									) =  'Y'
								THEN 'MOBILE_M0040' 
									  
							   </if>														
							   <if test="DIFFRENT_STKKY == &quot;N&quot;">
			
								THEN 'MOBILE_M0046'
									  
							   </if>														
				 		ELSE 'Y' 
			        END AS MSG
					  FROM STKKY ST
					  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY}
							                  AND SM.SKUKEY = ST.SKUKEY
			          LEFT OUTER JOIN TASDI TI ON TI.LOTA14 = ST.LOTA14 
			          						  AND TI.LOTA01 = ST.LOTA01		
			                                  AND TI.TASKTY IN('PK')                      
			                                  AND TI.STATIT IN('NEW', 'FIN')                      
					 WHERE 1 = 1
					   AND ST.WAREKY = #{WAREKY}
					   AND ST.QTSIWH &gt; 0
					   <if test="SKUKEY != null and SKUKEY != ''">		   
					   AND ST.SKUKEY = #{SKUKEY}
					   </if>
					   <if test="LOCAKY != null and LOCAKY != ''">		   
					   AND ST.LOCAKY = #{LOCAKY}
					   </if>		   		   
					   AND ST.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
					   AND SM.MTYPE LIKE #{SES_MTYPE}
					   AND ST.OWNRKY = #{OWNRKY}
					   AND (ST.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
			           AND NOT EXISTS(
			           					SELECT CASE WHEN NVL(TRIM(ST.LOTA14), ' ') != ' ' AND NVL(TRIM(TI.LOTA14), ' ') != ' ' AND ST.LOTA14 = TI.LOTA14										 
									 												 
											  <if test="DIFFRENT_STKKY == &quot;Y&quot;">
											   AND ( SELECT USARG1 FROM CMCDV CM
													                         WHERE CMCDKY = 'ALOTPCK'
													                         AND TRIM(SM.SKUG05) || TRIM(SM.SKUL01) = CM.CMCDVL
													) =  'Y'  
											   </if>						
											   									 																
										 		THEN 'MOBILE_M0045' 
									        END AS MSG
											  FROM STKKY ST
											  LEFT OUTER JOIN SKUMA SM ON SM.OWNRKY = #{OWNRKY}
													                  AND SM.SKUKEY = ST.SKUKEY
									          LEFT OUTER JOIN TASDI TI ON TI.LOTA14 = ST.LOTA14 
									                                  AND TI.TASKTY IN('PK')                      
									                                  AND TI.STATIT IN('FPC')                      
											 WHERE 1 = 1
											   AND ST.WAREKY = #{WAREKY}
											   AND ST.QTSIWH &gt; 0
											   <if test="SKUKEY != null and SKUKEY != ''">		   
											   AND ST.SKUKEY = #{SKUKEY}
											   </if>
											   <if test="LOCAKY != null and LOCAKY != ''">		   
											   AND ST.LOCAKY = #{LOCAKY}
											   </if>		   		   
											   AND ST.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
											   AND SM.MTYPE LIKE #{SES_MTYPE}
											   AND ST.OWNRKY = #{OWNRKY}
											   AND (ST.LOTA14 = #{BARCOD} OR SM.EANCOD = #{BARCOD} OR SM.GTINCD = #{BARCOD})
									           AND TI.STKNUM = #{STKNUM}
									           GROUP BY ST.LOTA14, TI.LOTA14, SM.SKUG05, SM.SKUL01
			           				 )
			           	AND NOT EXISTS(
							      SELECT MSG FROM CHK4                                  
							      			)		
			           GROUP BY ST.LOTA14, TI.LOTA14, SM.SKUG05, SM.SKUL01
			            
			UNION  ALL 
			SELECT MSG FROM CHK4                         
			
			)
		 
		SELECT NVL(TRIM(MSG), 'Y') MSG FROM CHK5 ORDER BY MSG ASC 
		
      ) WHERE ROWNUM =1

	</select>
	
	
	<select id="TASDI_LOCK_INFO_LIST" parameterType="Map" resultType="DataMap">
				SELECT TH.TASKKY
					 , TI.TASKIT
				     , CASE WHEN NVL(TRIM(TI.PAIDSR), ' ') != ' ' AND TI.PAIDSR = #{SES_USER_ID} THEN ' '
							WHEN NVL(TRIM(TI.PAIDSR), ' ') != ' ' AND TI.PAIDSR != #{SES_USER_ID} THEN TI.PAIDSR
						    ELSE ' '
					   END AS PAIDSR				          
				  FROM TASDH TH
				       INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY AND TI.TASKTY IN ('PK')
				 WHERE 1 = 1
				   AND TH.WAREKY = #{WAREKY}
		           AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})
				   AND TH.TASOTY = '330'	
				   AND TI.STATIT IN('NEW', 'PPC', 'FPC')
				<if test="STKNUM != null and STKNUM != ''">   	  
				   AND (TI.STKNUM = #{STKNUM}  OR TI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ) )
				</if>    
				<if test="DPTNKY != null and DPTNKY != ''">
				   AND TH.PTNRKY = #{DPTNKY}
				</if>				   
				<if test="LOCAKY != null and LOCAKY != ''">
				   AND (TI.LOCASR = #{LOCAKY} OR TI.ASKU01 = #{LOCAKY})
				</if>
				<if test="SKUKEY != null and SKUKEY != ''">
				   AND TI.SKUKEY= #{SKUKEY}
				</if>			
			 	ORDER BY  TH.TASKKY DESC, TI.TASKIT ASC
	</select>
	
	<update id="TASDI_LOCK_INFO_UPDATE" parameterType="Map">
				UPDATE TASDI
				   SET PAIDSR = CASE WHEN #{INOUTCHK} = 'IN' THEN #{SES_USER_ID}
				   					 WHEN #{INOUTCHK} = 'OUT' THEN ' '
				   					 ELSE ' '
				   				END	
				 WHERE TASKKY = #{TASKKY}
				   AND TASKIT = #{TASKIT} 
				   <if test="INOUTCHK == &quot;RESET&quot;">
				   AND PAIDSR = #{SES_USER_ID}
				   </if>
	</update>
	
	<select id="SHPDI_STKNUM_INFO_LIST" parameterType="Map" resultType="DataMap">
				SELECT SI.STKNUM AS TKNUM
					 , SI.SVBELN AS VBELN
					 , #{WAREKY} AS WAREKY	
					 , #{STATUS} AS STATUS					 				          	
				  FROM SHPDH SH
                 INNER JOIN SHPDI SI ON SH.SHPOKY = SI.SHPOKY				       
				 WHERE 1 = 1
				   AND SH.WAREKY = #{WAREKY}
		           AND SI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE #{SES_MTYPE})				   
				   AND (SI.STKNUM = #{STKNUM}  OR SI.SHPOKY IN (SELECT SHPOKY FROM TASTP WHERE STKNUM = #{STKNUM} ))
				   AND SUBSTR(SI.SHPOIT, 0, 1) != 1 
				   AND SI.STATIT IN('NEW','PAL', 'FAL', 'PPC', 'FPC')                   
			   	   AND NVL(TRIM(SI.SAPSTS), NULL) IS NOT NULL
			   <if test="DPTNKY != null and DPTNKY != ''">
				   AND SH.DPTNKY = #{DPTNKY}
			   </if>

       			 GROUP BY SI.STKNUM, SI.SVBELN 								   				
	</select>
	
	<select id="PDPK05_PDA_PICKING_MAP" parameterType="Map" resultType="DataMap">
		 { call P_PDA_PICKING_COMPLETE( #{STKNUM}, #{SKUKEY}, #{LOCAKY}, #{DPTNKY}, #{SES_USER_ID}) }
	</select>
	
	
	
</mapper>