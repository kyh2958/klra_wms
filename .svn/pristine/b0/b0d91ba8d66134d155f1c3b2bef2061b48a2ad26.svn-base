<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>WMS</title>
<%@ include file="/common/include/webdek/head.jsp" %>
<%@ page import="project.common.airfw.*"%>
<link rel="stylesheet" type="text/css" href="/common/theme/webdek/css/demo_layout.css">
<style>
	input[type="checkbox"]{height:unset;}
</style> 
<script type="text/javascript">
	
	var dblIdx = 0;
	var subIdx = 0;
	var searchType = 0;
	var paramH = new DataMap();
	var menuky = configData.MENU_ID;

	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",			
			module : "WmsTask",
			command : "DL06POPH",
			itemGrid : "gridListSub",
	        itemSearch : true
		});
		
		gridList.setGrid({
			id : "gridListSub",
			module : "WmsTask",
			command : "DL06POPD"
		});
		
		
		inputList.setInput("tab2_area");
		
		//오라클 버전으로 있음
		var data = page.getLinkPopData();	
		
		var param = new DataMap();
		param.put("data", data);	
		
		searchList(data);
		
	});
	
	function searchList(data){
		var param = data;
		searchType = 1;
		
		gridList.gridList({
			id : "gridList",
			url : "/wms/outbound/json/DL06POPH.data",
			param : param
		});
	}
	
	function gridListEventDataBindEnd(gridId, dataLength){
		if(gridId == "gridList" && dataLength > 0){
	        headFocusNum = 0;
	        
	        if(searchType == 1){
	        	searchSubItemList(0);
	        }else if(searchType == 2){
	            searchSubItemList(0);
	        }
	    }else if(gridId == "gridListSub" && dataLength == 0){
// 	    	fn_closing()
	    }
	}
	
	function gridListEventItemGridSearch(gridId, rowNum, itemGridList){
	   /*  if(gridId == "gridList"){
	        var param = getItemSearchParam(rowNum);
	
	        gridList.gridList({
	            id : "gridListSub",
	            param : param
	        });
	        dblIdx = rowNum;
	        subIdx = rowNum;
	    } */
	}
	
	function getItemSearchParam(rowNum){
	    var rowData = gridList.getRowData("gridList", rowNum);
	    var param = new DataMap();
	    param.putAll(rowData);
	
	    return param;
	}
	
	 function searchSubItemList(rowNum, locaky){
	    gridList.resetGrid("gridListSub");
	    
	    var SKUKEY = gridList.getColData("gridList", rowNum, "SKUKEY");
	    var LOTA01 = gridList.getColData("gridList", rowNum, "LOTA01");
	    var LOTA02 = gridList.getColData("gridList", rowNum, "LOTA02");
	    var LOTA03 = gridList.getColData("gridList", rowNum, "LOTA03");	    
	    var LOTA07 = gridList.getColData("gridList", rowNum, "LOTA07");
	    var LOTA08 = gridList.getColData("gridList", rowNum, "LOTA08");
	    var LOTA09 = gridList.getColData("gridList", rowNum, "LOTA09");
	    var LOTA16 = gridList.getColData("gridList", rowNum, "LOTA16");
	    var LOTA17 = gridList.getColData("gridList", rowNum, "LOTA17");
	    var TASKKY = gridList.getColData("gridList", rowNum, "TASKKY");
 	    var TASKIT = gridList.getColData("gridList", rowNum, "TASKIT");
 	    var LOTNUM = gridList.getColData("gridList", rowNum, "LOTNUM");
	    var LOCASR = gridList.getColData("gridList", rowNum, "LOCASR");
	    var LASTOB = gridList.getColData("gridList", rowNum, "LASTOB");
	    var DPTNKY = gridList.getColData("gridList", rowNum, "DPTNKY");
	    
	    
	    var param = inputList.setRangeParam("searchArea"); 
	    param.put("SKUKEY", SKUKEY);
	    param.put("LOTA01", LOTA01);
		param.put("LOTA02", LOTA02);
		param.put("LOTA03", LOTA03);
		param.put("LOTA07", LOTA07);
		param.put("LOTA08", LOTA08);
	    param.put("LOTA09", LOTA09);
	    param.put("LOTA16", LOTA16);
	    //param.put("LOTA17", LOTA17);
	    
	    param.put("TASKKY", TASKKY);
	    param.put("TASKIT", TASKIT);
	    param.put("LOTNUM", LOTNUM);
	    param.put("LOCASR", LOCASR);	    	    
	    param.put("DPTNKY", DPTNKY);
	    
	    
	    if(locaky){
	    	param.put("LOCAKY", locaky);	
	    }
	    
	    
	    if(LASTOB == 'V'){
	    	
    	//작업문서번호, 작업번호순번, 출고문서번호, 출고문서아이템번호, 그리드 데이터 
		var json = netUtil.sendData({
			url : "/wms/outbound/json/DL06MAXLOTA11.data",
			param : param
		});		
	    
		if(json && json.data){
				    	
	    	param.put("LASTOB", LASTOB);
	    	param.put("LLOTA11", json.data.LLOTA11);
	    	
			}
	    }
	    
	    gridList.gridList({
	        id : "gridListSub",
	        command : "DL06POPD",
	        param : param
	    });
	
	    headFocusNum = rowNum;
	    dblIdx = rowNum;
	    subIdx = rowNum;
	    	   
	} 
	 
	
	function fn_closing(){
		this.close();
	}

	function fn_reflect(){
		if(gridList.validationCheck("gridList", "modify")){
			
			if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){ //저장하시겠습니까?
				return;
			}
			
			var cnt = gridList.getModifyRowCount("gridList");
			if(cnt < 1){
				commonUtil.msgBox("MASTER_M0545"); //변경된 데이터가 없습니다.
				return;
			}
			
			var headData = inputList.setRangeParam("dl06POP");
			var list = gridList.getGridData("gridList");
			var param = inputList.setRangeParam("searchArea")
			
			var totalInputQtt = 0;
			for(var i = 0; i < list.length; i++){
				totalInputQtt += (Number)(list[i].get("QTSPUT"));
			}
			
			if(totalInputQtt > (Number)(headData.get("QTCOMP"))){
				var index = 0;
				for(var i = 0; i < list.length; i++){
					if(gridList.getRowState("gridList", i) == "U"){
						index = i;
						break;
					}
				}
				
				//입력가능수량보다 입력수량이 더 클수 없음
				commonUtil.msgBox("OUT_M0136"); //지시수량보다 할당수량이 클 수 없습니다.
				setTimeout(function(){
					gridList.setColFocus("gridList", index, "QTSPUT");
				}, 1);
				return;
			}
			
			for(var i = 0; i < list.length; i++) {
				list[i].put("TASKKY", headData.get("TASKKY")); //작업문서번호
				list[i].put("TASKIT", headData.get("TASKIT")); //작업번호순번
			}
			
			param.put("list", list);
			param.put("headData", headData);
			param.put("SHPOKY", headData.get("SHPOKY"));
			param.put("SHPOIT", headData.get("SHPOIT"));
			
			
			//작업문서번호, 작업번호순번, 출고문서번호, 출고문서아이템번호, 그리드 데이터 
			var json = netUtil.sendData({
				url : "/wms/outbound/json/DL06StockValidation.data",
				param : param
			});
			
			if(json.data != "OK"){
				var msgList = json.data.split("†");
				var msgTxt = commonUtil.getMsg(msgList[0], (msgList.length > 1 ? msgList[1].split("/") : null));
				commonUtil.msg(msgTxt);
				return;
			}
			
			var json = netUtil.sendData({
				url : "/wms/outbound/json/DL06POPSave.data",
				param : param
			});
			
			if(json && json.data){
				var data = page.getLinkPopData();
				page.linkPopClose(param);
			}
		}
	}
	
	function gridListEventColValueChange(gridId, rowNum, colName, colValue){
		
		if(gridId == "gridListSub" && colName == "QTSPUT"){
			
			var HeadRowNum=gridList.getFocusRowNum("gridList");	
			
			var qtsPUT = new Number(gridList.getColData(gridId, rowNum, colName));
			var useQty = new Number(gridList.getColData(gridId, rowNum, "USEQTY"));
			var qtcomp = new Number(gridList.getColData("gridList", HeadRowNum, "QTCOMP"));;
			
		}
	}
	
	function commonBtnClick(btnName){
		if(btnName == "SAVE"){
			saveData();
		}else if(btnName == "Search"){
			var locaky;
			
			if($.trim($('input[name="S.LOCAKY"]').val()) != ''){
				locaky = $('input[name="S.LOCAKY"]').val();
			}
						
			searchSubItemList(0, locaky);
	    }
	    	 
	}
	
	function saveData() {
						
		var head = gridList.getSelectData("gridList");
	    var list = gridList.getSelectData("gridListSub");	    	    		
	    var rowNum=gridList.getFocusRowNum("gridList");	    	    	    
	    
			if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){ //저장하시겠습니까?
				return;
			}								
			
			if(head.length == 0){
		        commonUtil.msgBox("VALID_M0006"); //선택된 데이터가 없습니다.
		        return;
		    }
		    
		    if(list.length == 0){
		        commonUtil.msgBox("OUT_M0045");  //처리를 위한 아이템이 존재하지 않습니다.
		        return;
		    }
		    
			var totalInputQtt = 0;
			var useInputQtt = new Number(gridList.getColData("gridList", 0, "QTCOMP"));
			
			for(var i = 0; i < list.length; i++){
				
				totalInputQtt += (Number)(list[i].get("QTSPUT"));				
				
			}
		
			if(totalInputQtt > useInputQtt){
				
				commonUtil.msgBox("OUT_M0230"); //입력수량이 입력가능수량보다 더 많습니다.
				return;
			}
			
			
			
	    var param = new DataMap();
	    param.put("head", head[rowNum]);
	    param.put("list", list);
        param.put("SHPOKY", head[rowNum].get("SHPOKY"));
        param.put("SHPOIT", head[rowNum].get("SHPOIT"));
        param.put("TASKKY", head[rowNum].get("TASKKY"));
	            
        json = netUtil.sendData({
	        url : "/wms/outbound/json/DL06POPSave.data",
	        param : param
	    });
	    
	    if(json && json.data){
	    	
	    	
	        gridList.resetGrid("gridList");
	        gridList.resetGrid("gridListSub");
	        commonUtil.msgBox("COOMON_M0463"); //저장이 완료되었습니다.
	        //searchList();
	        callback();
	    }	
	}
	
	function callback () {
		
		window.opener.DocPopCallback();
		self.close();
		
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType, obj, rowNum){
		
		if(searchCode == "SHLOCMA"){
			var param = new DataMap();
			var WAREKY = gridList.getColData("gridList", 0, "WAREKY");
			if(!WAREKY) {
				var label = commonLabel.getLabel("STD_WAREKY", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("WAREKY", WAREKY);
			return param;
        }
	}
	
</script>
</head>
<body>
