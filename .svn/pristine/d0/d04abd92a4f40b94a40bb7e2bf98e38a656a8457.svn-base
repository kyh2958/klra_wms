							<select type="text" class="input" Combo="Wms,PLNTKYCOMBO" name="TI.LOTA02" id="TI.LOTA02" ComboType="MS" style="width: 160px;" validate="required">
                            </select>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_LOTA01">저장위치</dt>
