                            <input type="text" class="input" name="TI.LOTA01" UIInput="R,SHSTLMAP" />
                        </dd>
                    </dl>
                                                            
                    <dl>
						<dt CL="STD_DOCDAT">전기일자</dt>
						<dd>
							<input type="text" class="input" name="TH.DOCDAT" id="TH.DOCDAT" UIFormat="C 0" UIInput="R" validate="required""/>
