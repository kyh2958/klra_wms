<div id="outOrderHlPageBreak" style="page-break-before: always; break-before: page;"></div>
<style>
.out-order-paper {
    width: 100%;
    font-family: "Malgun Gothic", Arial, sans-serif;
    font-size: 12px;
    color: #000;
    box-sizing: border-box;

    page-break-after: always;
    break-after: page;
}

.out-order-paper:last-child {
    page-break-after: auto;
    break-after: auto;
}

.out-order-paper table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

.out-order-paper th,
.out-order-paper td {
    border: 1px solid #000;
    padding: 3px;
    height: 28px;
    text-align: center;
    vertical-align: middle;
    word-break: break-all;
}

.out-order-paper th {
    font-weight: bold;
    background: #f5f5f5;
}

.out-order-paper .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 8px;
}

.out-order-paper .safety-box {
    width: 30%;
    font-size: 9px;
}

.out-order-paper .safety-box {
    width: 22%;
}

.out-order-paper .vehicle-notice-img {
    width: 120%;
    height: auto;
    display: block;
}



.out-order-paper .title-box {
    width: 38%;
    text-align: center;
    padding-top: 28px;
}

.out-order-paper .title {
    font-size: 28px;
    letter-spacing: 12px;
    padding-left: 12px;
}

.out-order-paper .confirm-wrap table th,
.out-order-paper .confirm-wrap table td {
    font-size: 10px;
    height: 24px;
    padding: 1px;
    word-break: keep-all;
}

.out-order-paper .confirm-wrap table th {
    line-height: 1.1;
}

.out-order-paper .confirm-wrap table td:first-child {
    font-size: 9px;
    letter-spacing: -0.8px;
}

.out-order-paper .confirm-wrap table th:nth-child(6) {
    font-size: 8px;
    letter-spacing: -0.8px;
}
.out-order-paper .barcode-box {
    width: 32%;
    text-align: center;
}

.out-order-paper .fake-barcode {
    width: 280px;
    height: 95px;
    margin: 0 auto;
    background: none;
    overflow: hidden;
}

#out_stknum_top {
    margin-top: -18px;
    text-align: center;
    font-size: 12px;
    line-height: 12px;
}
.out-order-paper .meta-line {
    display: flex;
    justify-content: space-between;
    margin: 6px 0;
}

.out-order-paper .vertical {
    writing-mode: vertical-rl;
    text-orientation: upright;
    letter-spacing: 1px;
    font-size: 10px;
    line-height: 1.1;
    font-weight: bold;
    background: #fff;
}

.out-order-paper .left {
    text-align: left !important;
}

.out-order-paper .right {
    text-align: right !important;
}

.out-order-paper .item-table th,
.out-order-paper .item-table td {
    height: 31px;
    padding: 2px;
    font-size: 13px;
}

.out-order-paper .item-name {
    font-weight: bold;
    text-align: left !important;
    letter-spacing: -0.5px;
}

.out-order-paper .sign-area {
    margin-top: 10px;
}

.out-order-paper .confirm-wrap {
    width: 56%;
    margin-left: auto;
    margin-top: 14px;
}

.out-order-paper .notice {
    margin-top: 8px;
    font-size: 12px;
      text-align: center;
    letter-spacing: 2px;
}

.out-order-paper .driver-sign {
    text-align: right;
    margin-top: 6px;
}

.out-order-paper .small {
    font-size: 10px;
}
.out-order-paper .vehicle-inner {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

.out-order-paper .vehicle-inner td {
