<style>
#outOrderHlPageBreak,
#invoicePageBreak,
#linerPageBreak,
#transferPageBreak,
#outOrderHlArea,
#invoiceArea,
#linerArea,
#transferArea {
    display: none;
}

.kiosk-paper-doc {
    width: 100%;
    font-family: "Malgun Gothic", Arial, sans-serif;
    font-size: 11px;
    color: #000;
    box-sizing: border-box;
    background: #fff;
}

.kiosk-paper-page {
    width: 100%;
    box-sizing: border-box;
    page-break-after: always;
    break-after: page;
}

.kiosk-paper-page:last-child {
    page-break-after: auto;
    break-after: auto;
}

.kiosk-paper-doc table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

/* 거래명세서 마스터 정보  */
.kiosk-paper-doc th,
.kiosk-paper-doc td {
    border: 1px solid #000;
    padding: 1px 3px;
    height: 15px;
    text-align: center;
    vertical-align: middle;
    word-break: break-all;
    font-size: 10px;
}

.kiosk-paper-doc th {
    background: #f1f1f1;
    font-weight: bold;
}

.kiosk-paper-doc .left {
    text-align: left !important;
}

.kiosk-paper-doc .right {
    text-align: right !important;
}

.kiosk-paper-doc .center {
    text-align: center !important;
}

.kiosk-paper-header {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 6px;
}

.kiosk-paper-header > div {
    width: 30%;
}

.kiosk-paper-title {
    width: 40% !important;
    text-align: center;
    padding-top: 8px;
}

.kiosk-paper-title p {
    margin: 0;
    font-size: 26px;
    font-weight: bold;
    letter-spacing: 6px;
    white-space: nowrap;
}

.kiosk-paper-title span {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    font-weight: bold;
}

.kiosk-paper-header ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0 0;
}

.kiosk-paper-header li {
    height: 20px;
    line-height: 20px;
}


.kiosk-paper-barcode {
    width: 230px;
    height: 55px;
    margin-left: auto;
    overflow: hidden;
}

.kiosk-paper-barcode > div,
.kiosk-paper-barcode canvas,
.kiosk-paper-barcode img {
    max-width: 100% !important;
}

.kiosk-paper-header .ship-no {
    margin-top: 4px;
    text-align: right;
}

.kiosk-paper-title {
    width: 40% !important;
    text-align: center;
    padding-top: 8px;
    position: relative;
}
/* 도장 위치는 right: 340px; */
.kiosk-paper-stamp {
    display: block;
    position: absolute;
    top: 90px;
    right: 340px;
    width: 55px;
    height: 55px;
    z-index: 5;
}
/* 인수증 top */
.kiosk-paper-stamp.receipt {
    top: 120px;
}
.kiosk-paper-doc .vertical {
    writing-mode: vertical-rl;
    text-orientation: upright;
    letter-spacing: 2px;
    font-weight: bold;
}

.kiosk-paper-doc .memo {
    height: 20px;
}

/* 거래명세서 제품정보 */
.kiosk-paper-doc .item-table th,
.kiosk-paper-doc .item-table td {
    height: 35px;
    font-size: 13px;
    padding: 2px;
}
.kiosk-paper-doc .takeout-title {
    margin: 0 0 4px 0;
    text-align: center;
    font-size: 20px;
    font-weight: bold;
}

.kiosk-paper-doc .time-table {
    margin-top: 2px;
}

.kiosk-paper-doc .sign-row td {
    height: 36px;
}

.kiosk-paper-doc td[id^='inv_supplier_'],
.kiosk-paper-doc td[id^='inv_client_'],
.kiosk-paper-doc td[id^='inv_delivery_'],
.kiosk-paper-doc td[id^='inv_driver_'],
.kiosk-paper-doc td[id^='inv_return_'],
.kiosk-paper-doc td[id^='inv_employee_'] {
    text-align: left !important;
}

.no-bottom {
    border-bottom: none !important;
}
/* 이송바코드 */
/* 이송명세서 바코드 - 거래명세서 크기 기준 */
#transferArea #trn_barcode_1,
#transferArea #trn_barcode_2,
#transferArea #trn_barcode_3 {
    width: 230px;
    height: 55px;
    margin-left: auto;
    overflow: hidden;
}

/* 이송명세서 바코드 하단 선적번호 텍스트 */
#transferArea .transfer-barcode-text {
    width: 110px;
    text-align: center;
    margin-left: auto;
    margin-right: 0;
    margin-top: -4px;
    font-size: 11px;
    line-height: 12px;
}

/* 이송명세서 헤더와 표 사이 간격 */
#transferArea .kiosk-paper-header {
    margin-bottom: 14px;
}

#transferArea #trn_barcode_1 > div,
#transferArea #trn_barcode_2 > div,
#transferArea #trn_barcode_3 > div,
#transferArea #trn_barcode_1 canvas,
#transferArea #trn_barcode_2 canvas,
#transferArea #trn_barcode_3 canvas,
#transferArea #trn_barcode_1 img,
#transferArea #trn_barcode_2 img,
#transferArea #trn_barcode_3 img {
    max-width: 100% !important;
}
</style>
