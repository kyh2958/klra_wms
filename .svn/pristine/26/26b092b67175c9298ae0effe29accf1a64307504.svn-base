		}
	</select>	
	
	<!-- 제조일자 기준 조회 -->
	<select id="SD11_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
	  SELECT WAREKY,	DATEYM,	SKUKEY,	DESC01,	UOMKEY,	LOCAKY,	OWNRKY,	LOTA01,	LOTA02,	LOTA11,	LOTA12,	LOTA14,	LOTA15,	QTSIWH,
          CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 1    AND 30 THEN QTSIWH ELSE 0 END AS M1,
 		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 31   AND 60 THEN QTSIWH ELSE 0 END AS M2,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 61   AND 90 THEN QTSIWH ELSE 0 END AS M3,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 91   AND 120 THEN QTSIWH ELSE 0 END AS M4,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 121  AND 150 THEN QTSIWH ELSE 0 END AS M5,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 151  AND 180 THEN QTSIWH ELSE 0 END AS M6,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 181  AND 210 THEN QTSIWH ELSE 0 END AS M7,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 211  AND 240 THEN QTSIWH ELSE 0 END AS M8,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 241  AND 270 THEN QTSIWH ELSE 0 END AS M9,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 271  AND 300 THEN QTSIWH ELSE 0 END AS M10,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 301  AND 330 THEN QTSIWH ELSE 0 END AS M11,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  BETWEEN 331  AND 365 THEN QTSIWH ELSE 0 END AS M12,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))  > 365 THEN QTSIWH ELSE 0 END AS M12OVER
  FROM ( SELECT  WAREKY,	
  		  TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
  		  SKUKEY,	
  		  DESC01,	
  		  UOMKEY,	
  		  LOCAKY,	
  		  OWNRKY,	
  		  LOTA01,	
  		  LOTA02,	
  		  LOTA11,	
  		  LOTA12,	
  		  LOTA14,	
  		  LOTA15,	
  		  sum(QTSIWH) AS QTSIWH
   FROM STKKY 
  WHERE 1=1
	<if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
		 AND LOTA11 NOT LIKE '9999%'
		 AND QTSIWH > 0 
		 AND OWNRKY = 'KN'
	GROUP BY WAREKY,	
  		  TO_CHAR(SYSDATE, 'YYYYMM') ,	
  		  SKUKEY,	
  		  DESC01,	
  		  UOMKEY,	
  		  LOCAKY,	
  		  OWNRKY,	
  		  LOTA01,	
  		  LOTA02,	
  		  LOTA11,	
  		  LOTA12,	
  		  LOTA14,	
  		  LOTA15
  		) ITEM
	
	</select>	
	
	<!-- 입고일자 기준 조회 -->
	<select id="SD11_LOTA12_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
	  SELECT WAREKY,	DATEYM,	SKUKEY,	DESC01,SKUG01, SKUL01,	UOMKEY,	LOCAKY,	OWNRKY,	LOTA01,	LOTA02,	LOTA11,	LOTA12,	LOTA14,	LOTA15,	QTSIWH,
          CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 1    AND 30 THEN QTSIWH ELSE 0 END AS M1,
 		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 31   AND 60 THEN QTSIWH ELSE 0 END AS M2,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 61   AND 90 THEN QTSIWH ELSE 0 END AS M3,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 91   AND 120 THEN QTSIWH ELSE 0 END AS M4,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 121  AND 150 THEN QTSIWH ELSE 0 END AS M5,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 151  AND 180 THEN QTSIWH ELSE 0 END AS M6,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 181  AND 210 THEN QTSIWH ELSE 0 END AS M7,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 211  AND 240 THEN QTSIWH ELSE 0 END AS M8,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 241  AND 270 THEN QTSIWH ELSE 0 END AS M9,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 271  AND 300 THEN QTSIWH ELSE 0 END AS M10,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 301  AND 330 THEN QTSIWH ELSE 0 END AS M11,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  BETWEEN 331  AND 365 THEN QTSIWH ELSE 0 END AS M12,
		  CASE WHEN  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD'))  > 365 THEN QTSIWH ELSE 0 END AS M12OVER
  FROM ( SELECT  S.WAREKY,	
  		  TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
  		  S.SKUKEY,	
  		  S.DESC01,	
  		  S.UOMKEY,	
  		  S.LOCAKY,	
  		  S.OWNRKY,	
  		  S.LOTA01,	
  		  S.LOTA02,	
  		  S.LOTA11,	
  		  S.LOTA12,	
  		  S.LOTA14,	
  		  S.LOTA15,	
  		  SUM(S.QTSIWH) AS QTSIWH,
  		  M.SKUG01,
  		  M.SKUL01
   FROM STKKY S
  INNER JOIN SKUMA M ON M.OWNRKY = S.OWNRKY AND M.SKUKEY = S.SKUKEY
  WHERE 1=1
	<if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
	<if test="SKUG01 != null and SKUG01 != ''">AND M.SKUG01 = #{SKUG01}</if>
	<if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
	<if test="DESC01 != null and DESC01 != ''">AND UPPER(S.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
	     AND S.LOTA11 NOT LIKE '9999%'
		 AND S.QTSIWH > 0 
		 AND S.OWNRKY = 'KN'
	GROUP BY S.WAREKY,	
  		  TO_CHAR(SYSDATE, 'YYYYMM') ,	
  		  S.SKUKEY,	
  		  S.DESC01,	
  		  S.UOMKEY,	
  		  S.LOCAKY,	
  		  S.OWNRKY,	
  		  S.LOTA01,	
  		  S.LOTA02,	
  		  S.LOTA11,	
  		  S.LOTA12,	
  		  S.LOTA14,	
  		  S.LOTA15,
  		  M.SKUG01,
  		  M.SKUL01
  		) ITEM 
	
	</select>	
	
	
	<!-- 입고일자 기준 조회 -->
	<select id="SD12_LOTA12_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
	SELECT WAREKY,	DATEYM,	SKUKEY,	DESC01,SKUG01, SKUL01,	UOMKEY,	LOCAKY,	OWNRKY,	LOTA01,	LOTA02,	LOTA11,	LOTA12,	LOTA14,	LOTA15,	QTSIWH, SINCE_LOTA11
  FROM ( SELECT  S.WAREKY,	
  		  TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
  		  S.SKUKEY,	
  		  S.DESC01,	
  		  S.UOMKEY,	
  		  S.LOCAKY,	
  		  S.OWNRKY,	
  		  S.LOTA01,	
  		  S.LOTA02,	
  		  S.LOTA11,	
  		  S.LOTA12,	
  		  S.LOTA14,	
  		  S.LOTA15,	
  		  SUM(S.QTSIWH) AS QTSIWH,
  		  M.SKUG01,
  		  M.SKUL01,
  		  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD')) AS SINCE_LOTA11
  		 
   FROM STKKY S
  INNER JOIN SKUMA M ON M.OWNRKY = S.OWNRKY AND M.SKUKEY = S.SKUKEY
  WHERE 1=1
  <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
	<if test="SKUG01 != null and SKUG01 != ''">AND M.SKUG01 = #{SKUG01}</if>
	<if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
	<if test="DESC01 != null and DESC01 != ''">AND UPPER(S.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
	     AND S.LOTA11 NOT LIKE '9999%'
		 AND S.QTSIWH > 0 
		 AND S.OWNRKY = 'KN'
	GROUP BY S.WAREKY,	
  		  TO_CHAR(SYSDATE, 'YYYYMM') ,	
  		  S.SKUKEY,	
  		  S.DESC01,	
  		  S.UOMKEY,	
  		  S.LOCAKY,	
  		  S.OWNRKY,	
  		  S.LOTA01,	
  		  S.LOTA02,	
  		  S.LOTA11,	
  		  S.LOTA12,	
  		  S.LOTA14,	
  		  S.LOTA15,
  		  M.SKUG01,
  		  M.SKUL01
  		) ITEM 
  	WHERE  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD')) >= (SELECT USARG2 
 																	 FROM CMCDV A 
 																	WHERE CMCDKY = 'MONTH' 
  																	  AND CDESC2 = #{DATEYM2})
	</select>		
	
	<select id="SD11_LASTMONTH_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
	SELECT  WAREKY,	DATEYM,	SKUKEY,	DESC01,	UOMKEY,	LOCAKY,	OWNRKY,	LOTA01,	LOTA02,	LOTA11,	LOTA12,	LOTA14,	LOTA15,	QTSIWH,	M1,	M2,	M3,	M4,	M5,	M6,	M7,	M8,	M9,	M10,M11,M12,M12OVER
      FROM STKSUM 
 	 WHERE 1=1 
 	   AND QTSIWH > 0 
       AND DATEYM  = #{DATEYM}
   <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
   	</select>	
	
	<select id="MONTHCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CDESC2 AS VALUE_COL
			 , CDESC1 AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'MONTH'
		 ORDER BY CMCDVL
	</select>
	
	<select id="MONTHCOMBOCMCDVL_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
			 , CDESC1 AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'MONTH'
		 ORDER BY CMCDVL
	</select>
	
		<!-- 장기재고추세 기준 조회 -->
	<select id="SD13_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
	WITH ITEM AS(SELECT  SKUG05, SKUL01 ,  SKUKEY, OWNRKY, SKUG01 FROM SKUMA M WHERE  M.SKUG05 != '00')
       SELECT SKUG05, SKUL01, 
              CASE WHEN SKUG05 = '10' THEN SUM(QTSIWH)/1000 ELSE SUM(QTSIWH) END  AS QTSIWH, 
	 		  CASE WHEN SKUG05 = '10' THEN SUM(STKQTY)/1000 ELSE SUM(STKQTY) END  AS STKQTY, 
	 		  CASE WHEN SKUG05 = '10' THEN SUM(M1QTY)/1000  ELSE SUM(M1QTY)  END  AS M1QTY, 
	 		  CASE WHEN SKUG05 = '10' THEN SUM(M2QTY)/1000  ELSE SUM(M2QTY)  END  AS M2QTY, 
	 		  CASE WHEN SKUG05 = '10' THEN SUM(M3QTY)/1000  ELSE SUM(M3QTY)  END  AS M3QTY,
	 		  CASE WHEN SKUG05 = '10' THEN SUM(M4QTY)/1000  ELSE SUM(M4QTY)  END  AS M4QTY,
	 		  CASE WHEN SKUG05 = '10' THEN SUM(M5QTY)/1000  ELSE SUM(M5QTY)  END  AS M5QTY 
	 		FROM 
     (SELECT '10' AS SKUG05 ,	'PS' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY ,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0  AS M5QTY FROM DUAL 
      	  UNION 
      	  SELECT '20' AS SKUG05,	'AD' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0  AS M5QTY FROM DUAL 
      	    UNION 
      	  SELECT '20' AS SKUG05,	'BD' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0  AS M5QTY FROM DUAL 
      	    UNION 
      	  SELECT '20' AS SKUG05,	'ET' AS SKUL01  ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0  AS M5QTY FROM DUAL 
      	    UNION 
      	  SELECT '20' AS SKUG05,	'FT' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0 AS M5QTY  FROM DUAL 
      	    UNION 
      	  SELECT '20' AS SKUG05,	'KT' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0 AS M5QTY  FROM DUAL 
      	   UNION 
      	  SELECT '20' AS SKUG05,	'RT' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0 AS M5QTY  FROM DUAL 
      	   UNION 
      	  SELECT '20' AS SKUG05,	'SN' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0 AS M5QTY  FROM DUAL
      	  UNION
      	  SELECT '20' AS SKUG05,	'AF' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0 AS M5QTY  FROM DUAL
      	  UNION
      	   SELECT '20' AS SKUG05,	'BW' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0 AS M5QTY  FROM DUAL
      	  UNION
      	   SELECT '20' AS SKUG05,	'WT' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0 AS M5QTY  FROM DUAL
      	  UNION
      	   SELECT '20' AS SKUG05,	'OF' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0 AS M5QTY  FROM DUAL
      	  UNION
      	   SELECT '20' AS SKUG05,	'WD' AS SKUL01 ,	0 AS QTSIWH,	0 AS STKQTY,	0 AS M1QTY,	0 AS M2QTY,	0 AS M3QTY,	0 AS M4QTY,	0 AS M5QTY  FROM DUAL
      	  UNION
		 SELECT  SKUG05, SKUL01, SUM(QTSIWH) AS QTSIWH  , 
		 		 SUM(STKQTY) AS STKQTY , SUM(M1QTY) AS M1QTY, SUM(M2QTY) AS M2QTY , SUM(M3QTY) AS M3QTY,SUM(M4QTY) AS M4QTY,SUM(M5QTY) AS M5QTY
	 	   FROM ( 
	   			  --해당 월 가져오기
				 SELECT  S.WAREKY AS WAREKY ,
				 	
			  	     TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
			         S.LOTA02 AS LOTA02 ,
			  	     M.SKUG05 AS SKUG05 , 
			  	     CASE WHEN NVL(M.SKUL01,' ') = ' ' THEN 'PS' ELSE M.SKUL01 END AS SKUL01, --제품군
			  	     SUM(S.QTSIWH) AS QTSIWH,
			  	     SUM(NVL(DECODE(M.SKUG05, '10',S.QTSIWH, '20', /*PS인 경우는 재고수량 HL인 경우 BAG수량 */
							 DECODE(S.UOMKEY, 'BOX', S.QTSIWH
								 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = M.SKUKEY AND INDDFU = 'V')
							   							   , TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
							   							   , TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, M.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3)) )
															   FROM MEASI MI
															  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = M.SKUKEY AND MI.UOMKEY = 'BOX'
															)
							   ), 0), 0)) AS STKQTY,
				 	 0 AS M1QTY,
					 0 AS M2QTY,
					 0 AS M3QTY,
					 0 AS M4QTY,
					 0 AS M5QTY
				  FROM STKKY S
				  JOIN SKUMA M ON M.OWNRKY = S.OWNRKY AND M.SKUKEY = S.SKUKEY
				 WHERE 1=1
				   <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
				   <if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
				   AND M.SKUG05 != '00'
				   AND S.LOTA11 NOT LIKE '9999%'
				   AND S.QTSIWH > 0 
				   AND S.OWNRKY = 'KN'
				   AND TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD')) >= (SELECT USARG2 
				 																	 FROM CMCDV A 
				 																	WHERE CMCDKY = 'MONTH' 
				  																	  AND CDESC2 = #{DATEYM2})
				GROUP BY S.WAREKY,
				  		 TO_CHAR(SYSDATE, 'YYYYMM') ,	
				  		 S.LOTA02 ,
				  		 M.SKUG05,
				  		 M.SKUL01
				    
			    UNION ALL
			     -- -1월
			    
			     SELECT  M.WAREKY AS WAREKY ,	
			  	     TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
			         M.LOTA02 AS LOTA02 ,
			  	     M.SKUG05 AS SKUG05 , 
			  	     CASE WHEN NVL(SKUL01,' ') = ' ' THEN 'PS' ELSE SKUL01 END AS SKUL01, --제품군
			  	     SUM(M.QTSIWH) AS QTSIWH,
			  	     0 AS STKQTY,
				 	 SUM(NVL(DECODE(M.SKUG05, '10',(${DATEYM2}), '20', /*PS인 경우는 재고수량 HL인 경우 BAG수량 */
							 DECODE(M.UOMKEY, 'BOX', (${DATEYM2})
								 , (SELECT DECODE(M.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = M.WAREKY AND MEASKY = M.SKUKEY AND INDDFU = 'V')
							   							   , TO_NUMBER(ROUND((${DATEYM2})                                                             / (MI.QTPUOM / MI.QTAUOM), 0))
							   							   , TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(M.WAREKY, M.SKUKEY, (${DATEYM2}), M.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 0)) )
															   FROM MEASI MI
															  WHERE MI.WAREKY = M.WAREKY AND MI.MEASKY = M.SKUKEY AND MI.UOMKEY = 'BOX'
															)
							   ), 0), 0)) AS M1QTY,
					 0 AS M2QTY,
					 0 AS M3QTY,
					 0 AS M4QTY,
					 0 AS M5QTY
				  FROM STKSUM M
				--  JOIN ITEM M ON M.OWNRKY = M.OWNRKY AND M.SKUKEY = M.SKUKEY
				 WHERE 1=1
				   <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
				   <if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
				   AND M.SKUG05 != '00'
				   AND M.LOTA11 NOT LIKE '9999%'
				   AND M.QTSIWH > 0 
				   AND M.OWNRKY = 'KN'
				   AND M.DATEYM  = TO_CHAR(ADD_MONTHS(TO_DATE(SYSDATE),-1),'YYYYMM') 
				     <!-- AND TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD')) >= (SELECT USARG2 
				 																	 FROM CMCDV A 
				 																	WHERE CMCDKY = 'MONTH' 
				  																	  AND CMCDVL = #{DATEYM2}) -->
				GROUP BY M.WAREKY,
				  		 TO_CHAR(SYSDATE, 'YYYYMM') ,	
				  		 M.LOTA02 ,
				  		 SKUG05,
				  		 SKUL01
			    
			    UNION ALL
			     -- -2월
			    
			     SELECT  M.WAREKY AS WAREKY ,	
			  	     TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
			         M.LOTA02 AS LOTA02 ,
			  	     M.SKUG05 AS SKUG05 , 
			  	     CASE WHEN NVL(SKUL01,' ') = ' ' THEN 'PS' ELSE SKUL01 END AS SKUL01, --제품군
			  	     SUM(M.QTSIWH) AS QTSIWH,
			  	     0 AS STKQTY,
				 	 0 AS M1QTY,
					 SUM(NVL(DECODE(M.SKUG05, '10',(${DATEYM2}), '20', /*PS인 경우는 재고수량 HL인 경우 BAG수량 */
							 DECODE(M.UOMKEY, 'BOX', (${DATEYM2})
								 , (SELECT DECODE(M.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = M.WAREKY AND MEASKY = M.SKUKEY AND INDDFU = 'V')
							   							   , TO_NUMBER(ROUND((${DATEYM2})                                                            / (MI.QTPUOM / MI.QTAUOM), 0))
							   							   , TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(M.WAREKY, M.SKUKEY, (${DATEYM2}), M.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 0)) )
															   FROM MEASI MI
															  WHERE MI.WAREKY = M.WAREKY AND MI.MEASKY = M.SKUKEY AND MI.UOMKEY = 'BOX'
															)
							   ), 0), 0)) AS M2QTY,
					 0 AS M3QTY,
					 0 AS M4QTY,
					 0 AS M5QTY
				  FROM STKSUM M
				--  JOIN ITEM M ON M.OWNRKY = M.OWNRKY AND M.SKUKEY = M.SKUKEY
				 WHERE 1=1
				   <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
				   <if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
				   AND M.SKUG05 != '00'
				   AND M.LOTA11 NOT LIKE '9999%'
				   AND M.QTSIWH > 0 
				   AND M.OWNRKY = 'KN'
				   AND M.DATEYM  = TO_CHAR(ADD_MONTHS(TO_DATE(SYSDATE),-2),'YYYYMM') 
				     <!-- AND TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD')) >= (SELECT USARG2 
				 																	 FROM CMCDV A 
				 																	WHERE CMCDKY = 'MONTH' 
				  																	  AND CMCDVL = #{DATEYM2}) -->
				GROUP BY M.WAREKY,
				  		 TO_CHAR(SYSDATE, 'YYYYMM') ,	
				  		 M.LOTA02 ,
				  		 SKUG05,
				  		 SKUL01
			    
			    UNION ALL
			     -- -3월
			    
			    SELECT  M.WAREKY AS WAREKY ,	
			  	     TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
			         M.LOTA02 AS LOTA02 ,
			  	     M.SKUG05 AS SKUG05 , 
			  	     CASE WHEN NVL(SKUL01,' ') = ' ' THEN 'PS' ELSE SKUL01 END AS SKUL01, --제품군
			  	     SUM(M.QTSIWH) AS QTSIWH,
			  	     0 AS STKQTY,
				 	 0 AS M1QTY,
					 0 AS M2QTY,
					 SUM(NVL(DECODE(M.SKUG05, '10',(${DATEYM2}), '20', /*PS인 경우는 재고수량 HL인 경우 BAG수량 */
							 DECODE(M.UOMKEY, 'BOX', (${DATEYM2})
								 , (SELECT DECODE(M.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = M.WAREKY AND MEASKY = M.SKUKEY AND INDDFU = 'V')
							   							   , TO_NUMBER(ROUND((${DATEYM2})                                                            / (MI.QTPUOM / MI.QTAUOM), 0))
							   							   , TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(M.WAREKY, M.SKUKEY,(${DATEYM2}), M.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 0)) )
															   FROM MEASI MI
															  WHERE MI.WAREKY = M.WAREKY AND MI.MEASKY = M.SKUKEY AND MI.UOMKEY = 'BOX'
															)
							   ), 0), 0)) AS  M3QTY,
					 0 AS M4QTY,
					 0 AS M5QTY
				  FROM STKSUM M
				--  JOIN ITEM M ON M.OWNRKY = M.OWNRKY AND M.SKUKEY = M.SKUKEY
				 WHERE 1=1
				    <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
				   <if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
				   AND M.SKUG05 != '00'
				   AND M.LOTA11 NOT LIKE '9999%'
				   AND M.QTSIWH > 0 
				   AND M.OWNRKY = 'KN'
				   AND M.DATEYM  = TO_CHAR(ADD_MONTHS(TO_DATE(SYSDATE),-3),'YYYYMM') 
				     <!-- AND TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD')) >= (SELECT USARG2 
				 																	 FROM CMCDV A 
				 																	WHERE CMCDKY = 'MONTH' 
				  																	  AND CMCDVL = #{DATEYM2}) -->
				GROUP BY M.WAREKY,
				  		 TO_CHAR(SYSDATE, 'YYYYMM') ,	
				  		 M.LOTA02 ,
				  		 SKUG05,
				  		 SKUL01
			    UNION ALL
			     -- -4월
			    
			      SELECT  M.WAREKY AS WAREKY ,	
			  	     TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
			         M.LOTA02 AS LOTA02 ,
			  	     M.SKUG05 AS SKUG05 , 
			  	     CASE WHEN NVL(SKUL01,' ') = ' ' THEN 'PS' ELSE SKUL01 END AS SKUL01, --제품군
			  	     SUM(M.QTSIWH) AS QTSIWH,
			  	     0 AS STKQTY,
				 	 0 AS M1QTY,
					 0 AS M2QTY,
					 0 AS M3QTY,
					SUM(NVL(DECODE(M.SKUG05, '10',(${DATEYM2}), '20', /*PS인 경우는 재고수량 HL인 경우 BAG수량 */
							 DECODE(M.UOMKEY, 'BOX', (${DATEYM2})
								 , (SELECT DECODE(M.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = M.WAREKY AND MEASKY = M.SKUKEY AND INDDFU = 'V')
							   							   , TO_NUMBER(ROUND((${DATEYM2})                                                           / (MI.QTPUOM / MI.QTAUOM), 0))
							   							   , TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(M.WAREKY, M.SKUKEY,(${DATEYM2}), M.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 0)) )
															   FROM MEASI MI
															  WHERE MI.WAREKY = M.WAREKY AND MI.MEASKY = M.SKUKEY AND MI.UOMKEY = 'BOX'
															)
							   ), 0), 0))  AS M4QTY,
					 0 AS M5QTY
				  FROM STKSUM M
				--  JOIN ITEM M ON M.OWNRKY = M.OWNRKY AND M.SKUKEY = M.SKUKEY
				 WHERE 1=1
				    <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
				   <if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
				   AND M.SKUG05 != '00'
				   AND M.LOTA11 NOT LIKE '9999%'
				   AND M.QTSIWH > 0 
				   AND M.OWNRKY = 'KN'
				   AND M.DATEYM  = TO_CHAR(ADD_MONTHS(TO_DATE(SYSDATE),-4),'YYYYMM') 
				     <!-- AND TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD')) >= (SELECT USARG2 
				 																	 FROM CMCDV A 
				 																	WHERE CMCDKY = 'MONTH' 
				  																	  AND CMCDVL = #{DATEYM2}) -->
				GROUP BY M.WAREKY,
				  		 TO_CHAR(SYSDATE, 'YYYYMM') ,	
				  		 M.LOTA02 ,
				  		 SKUG05,
				  		 SKUL01
			    UNION ALL
			     -- -5월
			    
			      SELECT  M.WAREKY AS WAREKY ,	
			  	     TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
			         M.LOTA02 AS LOTA02 ,
			  	     M.SKUG05 AS SKUG05 , 
			  	     CASE WHEN NVL(SKUL01,' ') = ' ' THEN 'PS' ELSE SKUL01 END AS SKUL01, --제품군
			  	     SUM(M.QTSIWH) AS QTSIWH,
			  	     0 AS STKQTY,
				 	 0 AS M1QTY,
					 0 AS M2QTY,
					 0 AS M3QTY,
					 0 AS M4QTY,
					<!--  SUM(${DATEYM2}) AS  M5QTY -->
				 SUM(NVL(DECODE(M.SKUG05, '10',(${DATEYM2}), '20', /*PS인 경우는 재고수량 HL인 경우 BAG수량 */
							 DECODE(M.UOMKEY, 'BOX', (${DATEYM2})
								 , (SELECT DECODE(M.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = M.WAREKY AND MEASKY = M.SKUKEY AND INDDFU = 'V')
							   							   , TO_NUMBER(ROUND((${DATEYM2})                                                           / (MI.QTPUOM / MI.QTAUOM), 0))
							   							   , TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(M.WAREKY, M.SKUKEY, (${DATEYM2}), M.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 0)) )
															   FROM MEASI MI
															  WHERE MI.WAREKY = M.WAREKY AND MI.MEASKY = M.SKUKEY AND MI.UOMKEY = 'BOX'
															)
							   ), 0), 0)) AS  M5QTY
					 
				  FROM STKSUM M
				--  JOIN ITEM M ON M.OWNRKY = M.OWNRKY AND M.SKUKEY = M.SKUKEY
				 WHERE 1=1
				    <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
				   <if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
				   AND M.SKUG05 != '00'
				   AND M.LOTA11 NOT LIKE '9999%'
				   AND M.QTSIWH > 0 
				   AND M.OWNRKY = 'KN'
				   AND M.DATEYM  = TO_CHAR(ADD_MONTHS(TO_DATE(SYSDATE),-5),'YYYYMM') 
				   <!-- AND TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD')) >= (SELECT USARG2 
				 																	 FROM CMCDV A 
				 																	WHERE CMCDKY = 'MONTH' 
				  																	  AND CMCDVL = #{DATEYM2}) -->
				GROUP BY M.WAREKY,
				  		 TO_CHAR(SYSDATE, 'YYYYMM') ,	
				  		 M.LOTA02 ,
				  		 SKUG05,
				  		 SKUL01			  		 
	       )	  		    
	  	 GROUP BY SKUG05, SKUL01 	   ) 
	  	 GROUP BY SKUG05, SKUL01 	  
  	 	 ORDER BY SKUG05, SKUL01
	</select>	
	
	
		<!-- 입고일자 기준 조회 -->
	<select id="SD14_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
	SELECT WAREKY,	DATEYM,	SKUKEY,	DESC01,SKUG01, SKUL01,	UOMKEY,	LOCAKY,	OWNRKY,	LOTA01,	LOTA02,	LOTA11,	LOTA12,	LOTA14,	LOTA15,	QTSIWH, SINCE_LOTA11
  FROM ( SELECT  S.WAREKY,	
  		  TO_CHAR(SYSDATE, 'YYYYMM') AS DATEYM,	
  		  S.SKUKEY,	
  		  S.DESC01,	
  		  S.UOMKEY,	
  		  S.LOCAKY,	
  		  S.OWNRKY,	
  		  S.LOTA01,	
  		  S.LOTA02,	
  		  S.LOTA11,	
  		  R.DOCDAT AS LOTA12,	
  		  S.LOTA14,	
  		  S.LOTA15,	
  		  SUM(S.QTSIWH) AS QTSIWH,
  		  M.SKUG01,
  		  M.SKUL01,
  		  TRUNC(SYSDATE) - TRUNC(TO_DATE(R.DOCDAT , 'YYYYMMDD')) AS SINCE_LOTA11
  		 
   FROM STKKY S
  INNER JOIN SKUMA M ON M.OWNRKY = S.OWNRKY AND M.SKUKEY = S.SKUKEY
  INNER JOIN RECDH R ON S.RECVKY = R.RECVKY AND R.RCPTTY ='135' AND R.STATDO ='FRV'
  WHERE 1=1
  <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
	<if test="SKUG01 != null and SKUG01 != ''">AND M.SKUG01 = #{SKUG01}</if>
	<if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
	<if test="DESC01 != null and DESC01 != ''">AND UPPER(S.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
	     AND S.LOTA11 NOT LIKE '9999%'
		 AND S.QTSIWH > 0 
		 AND S.OWNRKY = 'KN'
	GROUP BY S.WAREKY,	
  		  TO_CHAR(SYSDATE, 'YYYYMM') ,	
  		  S.SKUKEY,	
  		  S.DESC01,	
  		  S.UOMKEY,	
  		  S.LOCAKY,	
  		  S.OWNRKY,	
  		  S.LOTA01,	
  		  S.LOTA02,	
  		  S.LOTA11,	
  		  R.DOCDAT,	
  		  S.LOTA14,	
  		  S.LOTA15,
  		  M.SKUG01,
  		  M.SKUL01
  		) ITEM 
  	WHERE  TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA12, 'YYYYMMDD')) >= (SELECT USARG2 
 																	 FROM CMCDV A 
 																	WHERE CMCDKY = 'MONTH' 
  																	  AND CDESC2 = #{DATEYM2})
	</select>	
	
	<select id="ZONEPCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
			 , CDESC1 AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'ZONEP' AND USARG1 = 'Y'
	</select>
	
	<select id="LOCAPCOMBO_LIST" parameterType="Map" resultType="DataMap">
		  SELECT A.LOCAKY AS VALUE_COL
				,A.SHORTX AS TEXT_COL
		FROM LOCMA A
   		LEFT JOIN ZONMA ZA ON ZA.ZONEKY = A.ZONEKY AND ZA.WAREKY = A.WAREKY
		WHERE 1 = 1
		AND A.WAREKY = #{WAREKY} 
		AND A.AREAKY = 'PPR'
		<if test="ZONEKY != null and ZONEKY != ''">
			AND A.ZONEKY = #{ZONEKY}
		</if>
		<if test="LOCATY != null and LOCATY != ''">
			AND LOCATY = #{LOCATY}
		</if>
	</select>
	
	
	<!-- 종이자원 기번목록 -->
	<select id="LOCMA_PPR_LIST" parameterType="Map" resultType="DataMap">
	  SELECT A.WAREKY
			,A.LOCAKY
			,LOCATY
			,A.SHORTX
			,ZA.PLNTKY
			,ZA.STLKY
			,NVL((SELECT STLNM FROM STLMA SM WHERE SM.PLNTKY = ZA.PLNTKY AND SM.STLKY = ZA.STLKY), ' ') AS STLKYNM
			,ZA.ZONEKY
			,ZA.SHORTX AS ZONEKY_SHORTX
			,A.AREAKY
			,NVL((SELECT CDESC1 FROM CMCDV C WHERE CMCDKY = 'LOCATY' AND C.CMCDVL = A.LOCATY),' ') AS LOCATYT
			,STATUS
			,NVL((SELECT CDESC1 FROM CMCDV C WHERE C.CMCDKY = 'STATUS' AND C.CMCDVL = A.STATUS),' ') AS STATUST
			,MAXCPC	-- 최대중량
			,MAXWGT	-- 가용중량
			,A.CREDAT
			,A.CRETIM
			,A.CREUSR
			,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.CREUSR),' ') AS CUSRNM
			,A.LMODAT
			,A.LMOTIM
			,A.LMOUSR
			,NVL((SELECT NMLAST FROM USRMA B WHERE B.USERID = A.LMOUSR),' ') AS LUSRNM
			,STP.QTSIWH
			,(STP.GRSWGT / 1000) AS TOTWG
			,CASE 
		        WHEN NVL(A.MAXCPC, 0) = 0 OR NVL(STP.GRSWGT, 0) = 0 THEN ' '
        		ELSE TO_CHAR(ROUND( ( (STP.GRSWGT/1000) / A.MAXCPC ) * 100, 2 ), 'FM99999900D00' ) || '%'
	         END AS PERLOD 
		FROM LOCMA A
   		LEFT JOIN ZONMA ZA ON ZA.ZONEKY = A.ZONEKY AND ZA.WAREKY = A.WAREKY 
   		LEFT JOIN (
			SELECT 
				STP.LOCAKY, 
				-- SUM(QTSIWH),
				SUM(DECODE(STP.TASKTY, 'GR', NVL(STP.QTSIWH,0), 'GI', -NVL(STP.QTSIWH,0), 0)) AS QTSIWH,
				SUM(DECODE(STP.TASKTY, 'GR', NVL(STP.GRSWGT,0), 'GI', -NVL(STP.GRSWGT,0), 0)) AS GRSWGT
			 FROM STKPPR STP 
			WHERE 1=1 
			 
			GROUP BY STP.LOCAKY
		) STP ON (STP.LOCAKY = A.LOCAKY)
		WHERE 1 = 1
		<if test="WAREKY != null and WAREKY != ''">
			AND A.WAREKY = #{WAREKY}
		</if>
		<if test="LOCATY != null and LOCATY != ''">
			AND LOCATY = #{LOCATY}
		</if>
		<if test="AREAKY != null and AREAKY != ''">
			AND A.AREAKY = #{AREAKY}
		</if>
		<if test="ZONEKY != null and ZONEKY != ''">
			AND A.ZONEKY = #{ZONEKY}
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		ORDER BY A.SHORTX, A.LOCAKY ASC
	</select>
	
	<!-- 종이자원 입고대상 ID 변경필요, 조건 수정필요 KYH -->
	<select id="PULPIN_LIST" parameterType="Map" resultType="DataMap">
		SELECT IF_SEQ AS STOKKY
			, ' ' AS LOCAKY 
			, 'GR' AS TASKTY
			--, TO_CHAR(IF_DATE, 'YYYYMMDD') AS LOTA12
			--, TO_CHAR(IF_DATE, 'HH24:MI:SS') AS CRETIM
			<![CDATA[
			, CASE
		         WHEN TO_CHAR(IF_DATE, 'HH24MISS') < '070000'
		           THEN TO_CHAR(TRUNC(IF_DATE - 1) + INTERVAL '23:59:59' HOUR TO SECOND, 'YYYYMMDD')
		         ELSE TO_CHAR(IF_DATE, 'YYYYMMDD')
		       END AS LOTA12
	        , CASE
		         WHEN TO_CHAR(IF_DATE, 'HH24MISS') < '070000'
		           THEN TO_CHAR(TRUNC(IF_DATE - 1) + INTERVAL '23:59:59' HOUR TO SECOND, 'HH24:MI:SS')
		         ELSE TO_CHAR(IF_DATE, 'HH24:MI:SS')
		       END AS CRETIM
	       ]]>
			, RECV_FLAG
			, IV_EBELN
			, IV_MBLNR
			, IV_WERKS
			, IV_BEDAT
			, IV_LIFNR
			, IV_SEQ
			, IV_MATNR AS SKUKEY
			, (SELECT NVL(SUM(QTSIWH), 0) FROM STKPPR WHERE STOKKY = PPI.IF_SEQ AND TASKTY = 'GR') AS MENGE_B -- 기입고 수량
			, (IV_BALE_CNT-(SELECT NVL(SUM(QTSIWH), 0) FROM STKPPR WHERE STOKKY = PPI.IF_SEQ AND TASKTY = 'GR')) AS QTSIWH -- 입고 가능 수량
			, IV_GR_MENGE
			--, IV_GR_MENGE AS GRSWGT -- 입고처리 할 중량
			--, (IV_BALE_CNT-(SELECT NVL(SUM(QTSIWH), 0) FROM STKPPR WHERE STOKKY = PPI.IF_SEQ AND TASKTY = 'GR')) * ROUND(NVL(IV_GR_MENGE, 0) / NVL(NULLIF(IV_BALE_CNT, 0), 1), 2) AS GRSWGT
			, ROUND((IV_BALE_CNT-(SELECT NVL(SUM(QTSIWH), 0) FROM STKPPR WHERE STOKKY = PPI.IF_SEQ AND TASKTY = 'GR')) * ROUND(NVL(IV_GR_MENGE, 0) / NVL(NULLIF(IV_BALE_CNT, 0), 1), 2), 0) AS GRSWGT
			, IV_MEINS AS UOMKEY
			, IV_CAR_NUMBER
			, IV_CHECKER
			, IV_LIFNR
			, ROUND(NVL(IV_GR_MENGE, 0) / NVL(NULLIF(IV_BALE_CNT, 0), 1), 2) AS BALE_KG
			, SM.DESC01 
			, BT.NAME01  
			, BT.NAME02  
			, BT.TELN01  
			, BT.PTNL03  
			, BT.PTNL04  
		FROM PULPIN PPI
		INNER JOIN SKUMA SM ON (PPI.IV_MATNR = SM.SKUKEY) 
		LEFT JOIN BZPTN BT ON (PPI.IV_LIFNR = BT.PTNRKY)
		WHERE PPI.IV_STATUS = 'C' 
			AND PPI.IV_EBELN IS NOT NULL 
			
			AND PPI.IF_DATE >= TO_CHAR(SYSDATE - NVL(#{DAYS_FROM}, 7), 'YYYY-MM-DD') 
			AND (PPI.IV_BALE_CNT - (SELECT NVL(SUM(QTSIWH), 0) FROM STKPPR WHERE STOKKY = PPI.IF_SEQ AND TASKTY = 'GR')) > 0 
			<if test="LOTA12 != null and LOTA12 != ''">
				AND IF_DATE &gt;= TO_DATE(#{LOTA12}, 'YYYYMMDD')
      			AND IF_DATE &lt;  TO_DATE(#{LOTA12}, 'YYYYMMDD') + 1
			</if>
			<if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			</if> 
		ORDER BY PPI.IF_SEQ DESC 
	</select>
	
	<!-- 종이자원 재고목록 -->
	<select id="STKPPR_LIST" parameterType="Map" resultType="DataMap">
		/* ▼ 남은 재고의 마지막 입고일(LAST_GR_CREDAT) 계산을 기존 재고 집계에 결합 */
		WITH F AS (
		  SELECT *
		  FROM STKPPR STP
		  WHERE REGEXP_LIKE(STP.CREDAT, '^\d{8}$') -- 안전 가드(선택) 
		  <if test="LOCAKY != null and LOCAKY != ''">
			AND STP.LOCAKY = #{LOCAKY}
			</if>
			<if test="CREDAT_TO != null and CREDAT_TO != ''">
				AND STP.CREDAT &lt;= #{CREDAT_TO}
			</if>
			<if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			</if>
		),
		STK_SUM AS (
			SELECT SKUKEY, SUM(GRSWGT)/SUM(QTSIWH) AVG_GRSWGT 
			FROM STKPPR STP 
			WHERE REGEXP_LIKE(STP.CREDAT, '^\d{8}$') -- 안전 가드(선택) 
		   <if test="LOCAKY != null and LOCAKY != ''">
			AND STP.LOCAKY = #{LOCAKY}
			</if>
			<if test="CREDAT_TO != null and CREDAT_TO != ''">
				AND STP.CREDAT &lt;= #{CREDAT_TO}
			</if>
			<if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			</if>
			AND STP.CREDAT &lt;= TO_CHAR(TRUNC(SYSDATE) - 0, 'YYYYMMDD')
		GROUP BY SKUKEY 
		),
		TOT AS (      -- 키 단위 총 입고/출고
		  SELECT STOKKY, WAREKY, SKUKEY, LOCAKY,
		         SUM(CASE WHEN TASKTY='GR' THEN NVL(QTSIWH,0) ELSE 0 END) AS SUM_GR,
		         SUM(CASE WHEN TASKTY='GI' THEN NVL(QTSIWH,0) ELSE 0 END) AS SUM_GI
		  FROM F
		  GROUP BY STOKKY, WAREKY, SKUKEY, LOCAKY
		),
		GR_ROWS AS (  -- 입고만, 입고순서 정렬용 컬럼 준비
		  SELECT STOKKY, WAREKY, SKUKEY, LOCAKY,
		         TO_DATE(CREDAT,'YYYYMMDD') AS CREDAT_D,
		         CREDAT,
		         NVL(STOSEQ,0)        AS STOSEQ,
		         NVL(CRETIM,'000000') AS CRETIM,
		         NVL(QTSIWH,0)        AS QTY
		  FROM F
		  WHERE TASKTY='GR'
		),
		/* FIFO: 오래된 입고부터 누적 */
		GR_CUM AS (
		  SELECT g.*,
		         SUM(QTY) OVER (
		           PARTITION BY STOKKY, WAREKY, SKUKEY, LOCAKY
		           ORDER BY CREDAT_D, STOSEQ, CRETIM
		           ROWS UNBOUNDED PRECEDING
		         ) AS CUM_GR
		  FROM GR_ROWS g
		),
		LAST_GR_FIFO AS (  -- 잔존을 포함하는 가장 오래된(경계) 입고일
		  SELECT
		    t.STOKKY, t.WAREKY, t.SKUKEY, t.LOCAKY,
		    MIN(c.CREDAT_D) KEEP (DENSE_RANK FIRST ORDER BY c.CUM_GR) AS FIFO_DATE
		  FROM TOT t
		  JOIN GR_CUM c
		    ON c.STOKKY=t.STOKKY AND c.WAREKY=t.WAREKY AND c.SKUKEY=t.SKUKEY AND c.LOCAKY=t.LOCAKY
		  WHERE t.SUM_GR > t.SUM_GI   -- 잔존 있음
		    AND c.CUM_GR > t.SUM_GI   -- 누적입고가 총출고 초과하는 최초 지점
		  GROUP BY t.STOKKY, t.WAREKY, t.SKUKEY, t.LOCAKY
		),
		/* LIFO: 최신 입고부터 역누적 */
		GR_CUM_REV AS (
		  SELECT g.*,
		         SUM(QTY) OVER (
		           PARTITION BY STOKKY, WAREKY, SKUKEY, LOCAKY
		           ORDER BY CREDAT_D DESC, STOSEQ DESC, CRETIM DESC
		           ROWS UNBOUNDED PRECEDING
		         ) AS CUM_GR_REV
		  FROM GR_ROWS g
		),
		LAST_GR_LIFO AS (
		  SELECT
		    t.STOKKY, t.WAREKY, t.SKUKEY, t.LOCAKY,
		    MIN(c.CREDAT_D) KEEP (DENSE_RANK FIRST ORDER BY c.CUM_GR) AS LIFO_DATE
		  FROM TOT t
		  JOIN GR_CUM c
		    ON c.STOKKY=t.STOKKY AND c.WAREKY=t.WAREKY AND c.SKUKEY=t.SKUKEY AND c.LOCAKY=t.LOCAKY
		  WHERE t.SUM_GR > t.SUM_GI
		    AND ROUND(c.CUM_GR,6) >= ROUND(t.SUM_GR - t.SUM_GI,6)
		  GROUP BY t.STOKKY, t.WAREKY, t.SKUKEY, t.LOCAKY
		),
		AGG AS (  -- 현재 재고 집계
		  SELECT 
		      STP.STOKKY,
		      STP.WAREKY, 
		      STP.SKUKEY, 
		      STP.LOCAKY, 
		      MIN(STP.IF_DATE) AS LOTA12, 
		      STP.UOMKEY,
		      STP.PTNRKY AS IV_LIFNR,
		      MIN(STP.CREDAT) AS CREDAT, 
		      MAX(STP.CRETIM) AS CRETIM, 
		      SUM(CASE WHEN STP.TASKTY='GR' THEN NVL(STP.QTSIWH,0)
		               WHEN STP.TASKTY='GI' THEN -NVL(STP.QTSIWH,0)
		               ELSE 0 END) AS QTSIWH,
		      TO_CHAR(ROUND(
              	SUM(CASE WHEN STP.TASKTY='GR' THEN NVL(STP.GRSWGT,0)
		               WHEN STP.TASKTY='GI' THEN -NVL(STP.GRSWGT,0)
		               ELSE 0 END) 
              , 2), 'FM999999990.00') AS GRSWGT,
		      COUNT(*) AS ROWS_CNT
		  FROM F STP
		  GROUP BY STP.STOKKY, STP.WAREKY, STP.SKUKEY, STP.LOCAKY, STP.UOMKEY, STP.PTNRKY 
		  HAVING SUM(CASE WHEN STP.TASKTY='GR' THEN NVL(STP.QTSIWH,0)
                  WHEN STP.TASKTY='GI' THEN -NVL(STP.QTSIWH,0)
                  ELSE 0 END) > 0  -- 재고 있는 키만
		)
		SELECT 
		    A.*,
		    A.QTSIWH AS TOTQTY,
		    0        AS OUTQTY,
		    0        AS MOVEQT,
		    ' '      AS LOCATG,
		    'GI'     AS TASKTY,
		    LM.SHORTX AS SHORTX,
		    -- FIFO 기준 경계 입고일/경과일
		    TO_CHAR(NVL(ff.FIFO_DATE, TO_DATE(A.CREDAT,'YYYYMMDD')), 'YYYYMMDD') AS FIFO_GR_CREDAT,
		    TRUNC(SYSDATE) - TRUNC(NVL(ff.FIFO_DATE, TO_DATE(A.CREDAT,'YYYYMMDD'))) AS FIFO_SINCE_DAYS,
		    -- LIFO 기준 경계 입고일/경과일
		    TO_CHAR(NVL(lf.LIFO_DATE, TO_DATE(A.CREDAT,'YYYYMMDD')), 'YYYYMMDD') AS LIFO_GR_CREDAT,
		    TRUNC(SYSDATE) - TRUNC(NVL(lf.LIFO_DATE, TO_DATE(A.CREDAT,'YYYYMMDD'))) AS LIFO_SINCE_DAYS,
		    -- 기타 지표
		    KNRAWMS.F_SET_DATE(SYSDATE) AS DOCDAT,
		    TO_CHAR(
			    ROUND(NVL(A.GRSWGT, 0) / NULLIF(A.QTSIWH, 0), 2),
			    'FM999999990.00'
			) AS BALE_KG,
		    TO_CHAR(
			    ROUND(SS.AVG_GRSWGT, 2),
			    'FM999999990.00'
			) AS AVG_GRSWGT,
		    SM.DESC01,
		    BT.NAME01,
		    BT.NAME02,
		    BT.TELN01,
		    BT.PTNL03,
		    BT.PTNL04
		FROM AGG A
		LEFT JOIN LAST_GR_FIFO ff ON ff.STOKKY=A.STOKKY AND ff.WAREKY=A.WAREKY AND ff.SKUKEY=A.SKUKEY AND ff.LOCAKY=A.LOCAKY
	LEFT JOIN LAST_GR_LIFO lf ON lf.STOKKY=A.STOKKY AND lf.WAREKY=A.WAREKY AND lf.SKUKEY=A.SKUKEY AND lf.LOCAKY=A.LOCAKY
	INNER JOIN SKUMA SM ON A.SKUKEY = SM.SKUKEY
	INNER JOIN LOCMA LM ON A.LOCAKY = LM.LOCAKY AND LM.WAREKY = '1100' AND LM.AREAKY = 'PPR'
	LEFT JOIN BZPTN BT ON A.IV_LIFNR = BT.PTNRKY
	LEFT JOIN STK_SUM SS ON A.SKUKEY = SS.SKUKEY
		WHERE A.QTSIWH > 0
		ORDER BY A.STOKKY DESC
	</select>
	<select id="STKPPR_LIST_ORIGIN" parameterType="Map" resultType="DataMap">
		
		SELECT 
			STP.* 
			, STP.QTSIWH AS TOTQTY
			, 0 AS OUTQTY 
			, 'GI' AS TASKTY 
			, TRUNC(SYSDATE) - TRUNC(TO_DATE(STP.CREDAT, 'YYYYMMDD')) AS SINCE_DAYS
			, F_SET_DATE(SYSDATE) AS DOCDAT
			--, PPI.RECV_FLAG
			--, PPI.IV_EBELN
			--, PPI.IV_MBLNR
			--, PPI.IV_WERKS
			--, PPI.IV_BEDAT
			--, PPI.IV_LIFNR
			--, PPI.IV_SEQ
			--, PPI.IV_BALE_CNT
			--, PPI.IV_GR_MENGE
			--, PPI.IV_MEINS
			--, PPI.IV_CAR_NUMBER
			--, PPI.IV_CHECKER
			--, ROUND(NVL(PPI.IV_GR_MENGE, 0) / NVL(NULLIF(PPI.IV_BALE_CNT, 0), 1), 2) AS BALE_KG
			--, ROUND(NVL(PPI.IV_GR_MENGE, 0) / NVL(NULLIF(PPI.IV_BALE_CNT, 0), 1), 2) * STP.QTSIWH AS BALE_SUM_KG
			, ROUND(NVL(STP.GRSWGT, 0) / NVL(NULLIF(STP.QTSIWH, 0), 1), 2) AS BALE_KG
			, SM.DESC01 
			, BT.NAME01  
			, BT.NAME02  
			, BT.TELN01  
			, BT.PTNL03  
			, BT.PTNL04 
		FROM ( 
			SELECT 
				STP.STOKKY,
				STP.WAREKY, 
				STP.SKUKEY, 
				STP.LOCAKY, 
				STP.IF_DATE AS LOTA12, 
				STP.UOMKEY,
				STP.PTNRKY AS IV_LIFNR,
				MIN(STP.CREDAT) CREDAT, 
				MIN(STP.CRETIM) CRETIM, 
				-- SUM(QTSIWH),
				SUM(DECODE(STP.TASKTY, 'GR', NVL(STP.QTSIWH,0), 'GI', -NVL(STP.QTSIWH,0), 0)) AS QTSIWH,
				SUM(DECODE(STP.TASKTY, 'GR', NVL(STP.GRSWGT,0), 'GI', -NVL(STP.GRSWGT,0), 0)) AS GRSWGT
			FROM STKPPR STP 
			WHERE 1=1 
			<if test="LOCAKY != null and LOCAKY != ''">
				AND STP.LOCAKY = #{LOCAKY}
			</if>
			<if test="CREDAT_TO != null and CREDAT_TO != ''">
				AND STP.CREDAT &lt;= #{CREDAT_TO}
			</if>
			<if test="RANGE_SQL != null and RANGE_SQL != ''">
				${RANGE_SQL}
			</if>
			GROUP BY STP.STOKKY, STP.WAREKY, STP.SKUKEY, STP.LOCAKY, STP.IF_DATE, STP.UOMKEY, STP.PTNRKY
		) STP 
		-- INNER JOIN PULPIN PPI ON (PPI.IF_SEQ = STP.STOKKY AND PPI.IV_STATUS = 'C' AND PPI.IV_EBELN IS NOT NULL AND PPI.IV_BALE_CNT > 0 ) 
		INNER JOIN SKUMA SM ON (STP.SKUKEY = SM.SKUKEY) 
		LEFT JOIN BZPTN BT ON (STP.IV_LIFNR = BT.PTNRKY)
		WHERE STP.QTSIWH > 0 
		ORDER BY LOTA12 DESC, STOKKY DESC 
		
	</select>
	
	<!-- 종이자원 입출고내역 -->
	<select id="STKPPRGRGI_LIST" parameterType="Map" resultType="DataMap">
		
		SELECT 
			STP.STOKKY,
			STP.STOSEQ,
			LPAD(STP.STOSEQ, 4, '1000') AS TASKKY_1,
			DECODE(STP.TASKTY, 'GR', '입고', 'GI', '출고') AS TASKTY,
			STP.WAREKY, 
			STP.SKUKEY, 
			STP.LOCAKY, 
			--STP.IF_DATE AS LOTA12,
			STP.CREDAT AS GRGI_DAT,  
			STP.UOMKEY,
			STP.CREDAT, 
			STP.CRETIM, 
			STP.CREUSR,
			DECODE(STP.TASKTY, 'GR', STP.QTSIWH, 'GI', STP.QTSIWH * -1) AS QTSIWH,
			--STP.QTSIWH, 
			STP.GRSWGT,
			SM.DESC01, 
			BT.NAME01,  
			BT.NAME02, 
			BT.TELN01,  
			BT.PTNL03,  
			BT.PTNL04   
		FROM STKPPR STP 
		INNER JOIN SKUMA SM ON (STP.SKUKEY = SM.SKUKEY) 
		LEFT JOIN BZPTN BT ON (STP.PTNRKY = BT.PTNRKY)
		WHERE 1=1 
		<if test="LOCAKY != null and LOCAKY != ''">
			AND STP.LOCAKY = #{LOCAKY}
		</if> 
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
		ORDER BY STP.LMODAT DESC, STP.LMOTIM DESC, STP.STOSEQ DESC 
		
	</select>
	
	<select id="STKPPR_GROUP_LIST" parameterType="Map" resultType="DataMap">
		WITH BND AS (
		  SELECT 
		  		-- TRUNC(SYSDATE-1) + 7/24 AS Y07,   -- 어제 07:00
		        -- TRUNC(SYSDATE)   + 7/24 AS T07    -- 오늘 07:00 
		        TRUNC(TO_DATE(NVL(#{CREDAT_TO}, TO_CHAR(SYSDATE, 'YYYYMMDD')), 'YYYYMMDD') + 0) + 7/24 AS Y07,  -- 전일 07:00
    			TRUNC(TO_DATE(NVL(#{CREDAT_TO}, TO_CHAR(SYSDATE, 'YYYYMMDD')), 'YYYYMMDD') + 1) + 7/24 AS T07,
    			TRUNC(TO_DATE(NVL(#{CREDAT_TO}, TO_CHAR(SYSDATE, 'YYYYMMDD')), 'YYYYMMDD') - 1) + 7/24 AS Y07_GI,  -- 전일 07:00
    			TRUNC(TO_DATE(NVL(#{CREDAT_TO}, TO_CHAR(SYSDATE, 'YYYYMMDD')), 'YYYYMMDD') + 0) + 7/24 AS T07_GI     
		  FROM DUAL
		),
		F AS (         -- 타임스탬프 정규화
		  SELECT
		    WAREKY, SKUKEY, TASKTY,
		    NVL(QTSIWH,0) AS Q,
		    NVL(GRSWGT,0) AS W,
		    CASE
		      WHEN REGEXP_LIKE(CREDAT,'^\d{8}$')
		       AND REGEXP_LIKE(NVL(CRETIM,'000000'), '^\d{6}$')
		      THEN TO_DATE(CREDAT||NVL(CRETIM,'000000'),'YYYYMMDDHH24MISS')
		    END AS TS
		  FROM STKPPR 
		  WHERE 1=1 
		  <if test="LOCAKY != null and LOCAKY != ''">
			AND LOCAKY = #{LOCAKY}
			</if>
			<if test="CREDAT_TO != null and CREDAT_TO != ''">
				AND STKPPR.CREDAT &lt;= #{CREDAT_TO}
			</if>
		),
		AGG AS (       -- 한 번에 집계
		  SELECT
		    f.WAREKY, f.SKUKEY,
		    SUM(CASE WHEN f.TS &lt;  b.Y07 AND f.TASKTY='GR' THEN f.Q
		             WHEN f.TS &lt;  b.Y07 AND f.TASKTY='GI' THEN -f.Q ELSE 0 END) AS Q_BASE_Y,
		    SUM(CASE WHEN f.TS &lt;  b.Y07 AND f.TASKTY='GR' THEN f.W
		             WHEN f.TS &lt;  b.Y07 AND f.TASKTY='GI' THEN -f.W ELSE 0 END) AS W_BASE_Y,
		    SUM(CASE WHEN f.TS &gt;= b.Y07 AND f.TS &lt; b.T07 AND f.TASKTY='GR' THEN f.Q ELSE 0 END) AS Q_GR,
		    SUM(CASE WHEN f.TS &gt;= b.Y07 AND f.TS &lt; b.T07 AND f.TASKTY='GR' THEN f.W ELSE 0 END) AS W_GR,
		    SUM(CASE WHEN f.TS &gt;= b.Y07_GI AND f.TS &lt; b.T07_GI AND f.TASKTY='GI' THEN f.Q ELSE 0 END) AS Q_GI,
		    SUM(CASE WHEN f.TS &gt;= b.Y07_GI AND f.TS &lt; b.T07_GI AND f.TASKTY='GI' THEN f.W ELSE 0 END) AS W_GI
		  FROM F f, BND b
		  WHERE f.TS IS NOT NULL
		  GROUP BY f.WAREKY, f.SKUKEY
		)
		SELECT
		  AGG.WAREKY,
		  AGG.SKUKEY,
		  SM.DESC01,
		  NVL(Q_BASE_Y,0)                                        AS QTSIWH_BASE_Y,
		  NVL(W_BASE_Y,0)                                        AS GRSWGT_BASE_Y,
		  ROUND(NVL(NVL(W_BASE_Y,0) / NULLIF(Q_BASE_Y,0),0),1)   AS AVGKG_BASE_Y,
		  
		  NVL(Q_GR,0)                                            AS QTSIWH_GR,
		  NVL(W_GR,0)                                            AS GRSWGT_GR,
		  ROUND(NVL(NVL(W_GR,0) / NULLIF(Q_GR,0),0),1)           AS AVGKG_GR,
		  
		  NVL(Q_GI,0)                                            AS QTSIWH_GI,
		  NVL(W_GI,0)                                            AS GRSWGT_GI,
		  ROUND(NVL(NVL(W_GI,0) / NULLIF(Q_GI,0),0),1)           AS AVGKG_GI,
		  
		  NVL(Q_BASE_Y,0) + NVL(Q_GR,0) - NVL(Q_GI,0)            AS QTSIWH_BASE_T,
		  NVL(W_BASE_Y,0) + NVL(W_GR,0) - NVL(W_GI,0)            AS GRSWGT_BASE_T,
		  ROUND(
		    NVL(
		      (NVL(W_BASE_Y,0) + NVL(W_GR,0) - NVL(W_GI,0)) /
		      NULLIF(NVL(Q_BASE_Y,0) + NVL(Q_GR,0) - NVL(Q_GI,0), 0)
		    ,0)
		  ,1)                                                     AS AVGKG_BASE_T
		FROM AGG 
		INNER JOIN SKUMA SM ON (AGG.SKUKEY = SM.SKUKEY)
		ORDER BY WAREKY, SKUKEY
	</select>
	
	<insert id="SD82SubMulti_INSERT" parameterType="Map">
		INSERT INTO STKPPR 
		(
			STOKKY,STOSEQ,TASKTY,WAREKY,OWNRKY,
			LOTNUM,SKUKEY,UOMKEY,LOCAKY,QTSIWH,
			
			LOTA01,LOTA02,LOTA03,LOTA04,LOTA05,
			IF_DATE,LOTA14,LOTA15,GRSWGT,NETWGT,
			
			WGTUNT,CAPACT,SEBELN,SEBELP,CREDAT,
			CRETIM,CREUSR,LMODAT,LMOTIM,LMOUSR,
			
			PTNRKY 
		) 
		<foreach item="item" index="index" collection="list" open=" " separator=" UNION ALL " close="">
			SELECT  
				#{item.STOKKY, jdbcType=VARCHAR}, (SELECT NVL(MAX(STOSEQ)+1, 1) FROM STKPPR WHERE STOKKY = #{item.STOKKY, jdbcType=NUMERIC}) ,NVL(#{item.TASKTY, jdbcType=VARCHAR},'GR'),NVL(#{item.WAREKY, jdbcType=VARCHAR},'1100'),NVL(#{item.OWNRKY, jdbcType=VARCHAR},'KN'),
				' ',NVL(#{item.SKUKEY, jdbcType=VARCHAR}, ' '), #{item.UOMKEY, jdbcType=VARCHAR}, #{item.LOCAKY, jdbcType=VARCHAR}, NVL(#{item.QTSIWH, jdbcType=NUMERIC},0),
				
				NVL(#{item.LOTA01, jdbcType=VARCHAR},' '),NVL(#{item.LOTA02, jdbcType=VARCHAR},' ' ),NVL(#{item.LOTA03, jdbcType=VARCHAR},' ' ),NVL(#{item.LOTA04, jdbcType=VARCHAR},' ' ), NVL(#{item.LOTA05, jdbcType=VARCHAR},' '),
				NVL(#{item.LOTA12, jdbcType=VARCHAR},' '),NVL(#{item.LOTA14, jdbcType=VARCHAR},' '), NVL(#{item.LOTA15, jdbcType=VARCHAR},' '), NVL(#{item.GRSWGT, jdbcType=VARCHAR},' '), 0, 
					
				' ', 0, NVL(#{item.SEBELN, jdbcType=VARCHAR}, ' '), NVL(#{item.SEBELP, jdbcType=VARCHAR}, ' '), NVL(#{item.DOCDAT, jdbcType=VARCHAR}, TO_CHAR(SYSDATE, 'YYYYMMDD')),
				TO_CHAR(SYSDATE, 'HH24MISS'), NVL(#{item.SES_USER_ID, jdbcType=VARCHAR}, ' '), TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'), NVL(#{item.SES_USER_ID, jdbcType=VARCHAR}, ' '), 

				NVL(#{item.IV_LIFNR, jdbcType=VARCHAR},' ')
 			 FROM DUAL 
		</foreach>
		
	</insert>
	
	<!-- 종이자원 출고이력 삭제 -->
	<delete id="SD82_DELETE" parameterType="Map">
		DELETE STKPPR
 		 WHERE STOKKY = #{STOKKY}
 		   AND STOSEQ = #{STOSEQ}
 		   AND TASKTY = 'GI' 
	</delete>
	
	<!-- 종이재고 수동입고 -->
	<insert id="SD82_INSERT" parameterType="Map">
				
		INSERT INTO STKPPR 
		(
		STOKKY, STOSEQ, TASKTY, WAREKY, OWNRKY, 
		LOTNUM, SKUKEY, UOMKEY, LOCAKY, QTSIWH, 
		LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, 
		IF_DATE, LOTA14, LOTA15, GRSWGT, NETWGT, 
		WGTUNT, CAPACT, SEBELN, SEBELP, CREDAT, 
		CRETIM, CREUSR, LMODAT, LMOTIM, LMOUSR, 
		PTNRKY
		)
 		VALUES
		(
   	      '00001', NVL((SELECT MAX(STOSEQ) + 1 FROM STKPPR WHERE STOKKY = 00001), 1), 'GR', '1100', 'KN', 
   	      ' ', #{SKUKEY}, 'KG', #{LOCAKY}, #{QTSIWH}, 
   	      ' ', ' ', ' ', ' ', ' ', 
   	      TO_CHAR(NVL(TO_DATE(#{LOTA12}, 'YYYYMMDD'), SYSDATE), 'YYYYMMDD'), ' ', ' ', #{GRSWGT}, 0, 
   	      ' ', 0, ' ', ' ', TO_CHAR(NVL(TO_DATE(#{LOTA12}, 'YYYYMMDD'), SYSDATE), 'YYYYMMDD'), 
   	      TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}, 
   	      ' '				              
		)
	</insert>
	
	<!-- 종이재고 수동입고 시간업뎃하기, 작업자 넣기-->
	<update id="SD82_MOVESTK_UPDATE" parameterType="Map">
				
		UPDATE STKPPR 
			SET LMOUSR = #{SES_USER_ID} 
			<if test="LOCATG != null and LOCATG != ''">, LOCAKY = #{LOCATG}</if>
			<if test="QTSIWH != null and QTSIWH != ''">, QTSIWH = #{QTSIWH}</if>
			<if test="GRSWGT != null and GRSWGT != ''">, GRSWGT = #{GRSWGT}</if>
			, LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			, LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
		WHERE 
			STOKKY = #{STOKKY} 
			AND LOCAKY = #{LOCAKY} 
			AND SKUKEY = #{SKUKEY} 
	</update>
	
	<!-- 종이재고 수동입고 시간업뎃하기, 작업자 넣기-->
	<insert id="SD82_SELECT_INSERT" parameterType="Map">
				
		INSERT INTO STKPPR 
		(
		STOKKY, STOSEQ, TASKTY, WAREKY, OWNRKY, 
		LOTNUM, SKUKEY, UOMKEY, LOCAKY, QTSIWH, 
		LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, 
		IF_DATE, LOTA14, LOTA15, GRSWGT, NETWGT, 
		WGTUNT, CAPACT, SEBELN, SEBELP, CREDAT, 
		CRETIM, CREUSR, LMODAT, LMOTIM, LMOUSR, 
		PTNRKY
		)
  	    SELECT 
  	      	STOKKY, (SELECT MAX(STOSEQ) + 1 FROM STKPPR WHERE STOKKY = #{STOKKY}), TASKTY, WAREKY, OWNRKY, 
			LOTNUM, SKUKEY, UOMKEY, #{LOCATG}, #{MOVEQT}, 
			LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, 
			IF_DATE, LOTA14, LOTA15, #{GRSWGT}, NETWGT, 
			WGTUNT, CAPACT, SEBELN, SEBELP, TO_CHAR(NVL(TO_DATE(#{LOTA12}, 'YYYYMMDD'), SYSDATE), 'YYYYMMDD'), 
			TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}, 
			PTNRKY 
		FROM STKPPR 
		WHERE 
  	      	STOKKY = #{STOKKY} 
 	      	AND LOCAKY = #{LOCAKY}  
 	      	AND SKUKEY = #{SKUKEY}
 	      	AND TASKTY = 'GR'   
		
	</insert>
	
	
	<!-- 종이자원 입고대상 ID 변경필요, 조건 수정필요 KYH -->
	<select id="DUAL_LIST" parameterType="Map" resultType="DataMap">
		SELECT 2 FROM DUAL
	</select>
</mapper>