<?xml version="1.0" encoding="UTF-8"?><!--Converted at: Wed Feb 23 09:49:03 KST 2022-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="WmsInventory">

	<!-- PDLOC -->
	<select id="AREACOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT AM.AREAKY AS VALUE_COL
			 , AM.SHORTX AS TEXT_COL
			 , AM.WAREKY AS GROUP_COL
			 , COUNT(0) OVER (ORDER BY DECODE(TRIM(MAX(ZM.PLNTKY)), NULL, 1, 2) DESC, AM.AREAKY) AS ORD
		  FROM AREMA AM
		  INNER JOIN ZONMA ZM ON AM.WAREKY = ZM.WAREKY AND AM.AREAKY = ZM.AREAKY
		 WHERE AM.AREAKY != 'SYS'
		   AND AM.WAREKY = #{SES_WAREKY}
		   AND (PLNTKY IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{SES_WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE}) OR PLNTKY = ' ')
		 GROUP BY AM.AREAKY
			    , AM.SHORTX
			    , AM.WAREKY
		ORDER BY ORD
	</select>

	<!-- PDLOC -->
	<select id="ZONECOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT ZM.ZONEKY AS VALUE_COL
			 , ZM.SHORTX AS TEXT_COL
			 , ZM.PLNTKY AS PLNTKY
			 , (SELECT CDESC1 FROM CMCDV WHERE CMCDKY = 'LOTA02' AND CMCDVL = ZM.PLNTKY) AS PLNTNM
		  FROM AREMA AM
		  INNER JOIN ZONMA ZM ON AM.WAREKY = ZM.WAREKY AND AM.AREAKY = ZM.AREAKY
		 WHERE AM.AREAKY != 'SYS'
		   AND AM.WAREKY = #{SES_WAREKY}
		   AND (PLNTKY IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{SES_WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE}) OR PLNTKY = ' ')
		   <if test="AREAKY != null and AREAKY != ''">AND AM.AREAKY = #{AREAKY}</if>
		 GROUP BY ZM.SHORTX
			    , ZM.PLNTKY
			    , ZM.ZONEKY
		ORDER BY DECODE(TRIM(ZM.PLNTKY), NULL, 1, 2) DESC
				, ZM.ZONEKY
	</select>

	<select id="SKUL01COMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
			 , CDESC1 AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'SKUL01'
	</select>
	
	<select id="SKUG01COMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
			 , CDESC1 AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'SKUG01' AND USARG1 = 'V'
	</select>
	
	<!-- 2022.07.13 SJ01, PDSJ01 품질 제외한 재고상태 목록 -->
	<select id="LOTA06COMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT CMCDVL AS VALUE_COL
			 , CDESC1 AS TEXT_COL
		  FROM CMCDV
		 WHERE CMCDKY = 'LOTA06'
	</select>
	
	<select id="DOCTCOMBO_LIST" parameterType="Map" resultType="DataMap">
		SELECT DOCUTY AS VALUE_COL
			 , SHORTX AS TEXT_COL
			 , DOCUTY AS GROUP_COL
		FROM DOCTM
		WHERE 1 =1
		   AND DOCUTY IN (SELECT DOCUTY FROM DOCPG WHERE PROGID = #{menuId})
<!-- 		<if test="menuId == 'MV01'">AND DOCUTY IN ('320', '325')</if> -->
<!-- 		<if test="menuId == 'IP01'">AND DOCUTY IN ('510', '511')</if> -->
		ORDER BY DOCUTY
	</select>
	
	<!-- BOX단위 -->
	<sql id="WITH_BOXUOM">
		SELECT MI.MEASKY, MI.WAREKY
			 , SUM(NVL(TRIM(DECODE(MI.UOMKEY, 'BAG', MI.QTPUOM * (SELECT QTAUOM FROM MEASI WHERE UOMKEY = 'EA'  AND WAREKY = MI.WAREKY AND MEASKY = MI.MEASKY))), 0)) AS BOXEA  /* BAG.QTPUOM / EA .QTAUOM */
			 , SUM(NVL(TRIM(DECODE(MI.UOMKEY, 'BOX', MI.QTPUOM                                                                                                )), 0)) AS BOXBAG /* BOX.QTPUOM              */
			 , SUM(NVL(TRIM(DECODE(MI.UOMKEY, 'PAL', MI.QTPUOM / (SELECT QTPUOM FROM MEASI WHERE UOMKEY = 'BOX' AND WAREKY = MI.WAREKY AND MEASKY = MI.MEASKY))), 0)) AS BOXPAL /* PAL.QTPUOM * BOX.QTPUOM */
		  FROM MEASI MI
		 WHERE EXISTS (SELECT 1
						 FROM SKUMA SM
						WHERE SM.OWNRKY = #{OWNRKY} AND SM.SKUKEY = MI.MEASKY
						  AND SM.SKUG05 = '20' /* SKUMA 테이블에 존재하면서 HL 상품만 대상 */
						  AND EXISTS(SELECT 1
									   FROM STKKY ST
									  WHERE ST.OWNRKY = SM.OWNRKY AND ST.SKUKEY = SM.SKUKEY AND ST.WAREKY = MI.WAREKY
									    AND ST.QTSIWH > 0  /* STKKY 테이블에 재고가 존재하는 상품만 대상 */
									)
				)
		 GROUP BY MI.MEASKY, MI.WAREKY
	</sql>
	
	<sql id="SD01_BASE">
		SELECT S.WAREKY
		     , S.STOKKY
			 , M.SKUL01
			 , M.SKUG05
			 , S.SKUKEY
			 , S.DESC01
			 , S.UOMKEY
			 , S.LOTNUM
			 , S.LOTA01, S.LOTA02, S.LOTA03, S.LOTA04, S.LOTA05
			 , S.LOTA06, S.LOTA07, S.LOTA08, S.LOTA09, S.LOTA10
			 , S.LOTA11, S.LOTA12, S.LOTA13, S.LOTA14, S.LOTA15
			 , S.LOTA16, S.LOTA17, S.LOTA18, S.LOTA19, S.LOTA20
			 , S.QTSIWH
			 , S.QTSALO
			 , S.QTSPMI
			 , S.QTSPMO
			 , S.AREAKY
			 , S.ZONEKY
			 , S.LOCAKY
			 , DECODE(S.LOTA06, '05', S.QTSIWH, 0) AS QTSIQT /* 품질 : Inspection QuanTity */
			 , DECODE(S.LOTA06, '10', S.QTSIWH, 0) AS QTSHQT /* 보류 : Hold       QuanTity */
			 , DECODE(S.LOTA06, '30', S.QTSIWH, 0) AS QTSCNU /* 불용 : Can Not Use         */
			 , DECODE(S.LOTA06, '50', S.QTSIWH, 0) AS QTSWQT /* 폐기 : Wasted     QuanTity */
			 , CASE WHEN S.LOTA06 IN ('00', '05', '10', '30', '50') THEN 0 ELSE S.QTSIWH END  AS QTSBLK
			 , CASE WHEN S.AREAKY = 'SHP' THEN S.QTSIWH ELSE 0 END AS QTSOUT
			 , CASE WHEN S.AREAKY = 'SHP' THEN 0
					ELSE S.QTSIWH - S.QTSBLK
								  - GREATEST(S.QTSALO, S.QTSPMO)
								  - (CASE WHEN S.LOTA06 IN ('00') OR S.QTSPMO > 0 THEN 0
										  ELSE S.QTSIWH
									 END)
			   END AS USEQTY 
		   	 , NVL(O.QTSIWH,0) AS QTSOALO
			 , R.RCPRSN
		FROM STKKY S
		INNER JOIN SKUMA M ON M.OWNRKY = S.OWNRKY AND M.SKUKEY = S.SKUKEY
		LEFT OUTER JOIN RECDI R ON R.RECVKY = S.RECVKY AND R.RECVIT = S.RECVIT 
		LEFT OUTER JOIN OMSALO O ON S.LOTA14 = O.LOTA14 AND S.WAREKY = O.WAREKY AND S.LOTA02 = O.LOTA02  AND S.LOTA01 = O.LOTA01 AND O.ALOYN = 'N'
		WHERE 1=1
		  AND S.QTSIWH > 0
		<if test="WAREKY != null and WAREKY != ''">AND S.WAREKY = #{WAREKY}</if>
		<if test="OWNRKY != null and OWNRKY != ''">AND S.OWNRKY = #{OWNRKY}</if>
		<if test="SKUG01 != null and SKUG01 != ''">AND M.SKUG01 = #{SKUG01}</if>
		<if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
		<if test="DESC01 != null and DESC01 != ''">AND UPPER(S.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		<if test="ASKL03 != null and ASKL03 != ''">
			AND TO_NUMBER(M.ASKL03) 
				BETWEEN TO_NUMBER(#{ASKL03}) * 0.95
				    AND TO_NUMBER(#{ASKL03}) * 1.05
		</if>
		<if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
		<if test="RANGE_SQL1 != null and RANGE_SQL1 != ''">AND ( S.LOCAKY != 'SHPLOC') OR ((S.LOCAKY =  'SHPLOC') AND ${RANGE_SQL1})</if>

		<if test="LOCAKY != null and LOCAKY != ''">AND S.LOCAKY = #{LOCAKY}</if>
		<if test='BARCOD != null and BARCOD != "" and !"P".equals(SEARCHTYPE)'>
			AND S.LOTA14 = #{BARCOD}
		</if>
		<if test='BARCOD != null and BARCOD != "" and "P".equals(SEARCHTYPE)'>
			AND S.SKUKEY IN (SELECT SKUKEY FROM STKKY WHERE LOTA14 = #{BARCOD})
		</if>
		<if test="SKUKEY != null and SKUKEY != ''">
			AND S.SKUKEY = #{SKUKEY}
		</if>
		<if test='LOTA11_LT != null and LOTA11_LT != "" and !"00".equals(LOTA11_LT)'>
			AND S.LOTA11 <![CDATA[<]]> TO_CHAR(ADD_MONTHS(SYSDATE, -#{LOTA11_LT}), 'YYYYMMDD')
		</if>
		<if test='SES_DEVICE_TYPE == "M"'>
			AND S.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{SES_WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE})
		</if>
	</sql>
	
	<select id="SD01TAB1_LIST" parameterType="Map" resultType="DataMap">
		WITH BOXUOM AS (
			<include refid="WITH_BOXUOM"/>
		)
		
		SELECT 
			TB.* 
			 , NVL(BU.BOXEA , 0) AS BOXEA
			 , NVL(BU.BOXBAG, 0) AS BOXBAG
			 , NVL(BU.BOXPAL, 0) AS BOXPAL
			 , CASE WHEN TB.WAREKY = '4000' THEN 0 ELSE TB.QTSIWH * NVL(DECODE(MV.PEINH, 0, 0, MV.STPRS / MV.PEINH), 0) END AS STKAMT
			 , CASE WHEN TB.WAREKY = '4000' THEN 0 ELSE NVL(BU.BOXBAG, 0) * NVL(DECODE(MV.PEINH, 0, 0, MV.STPRS / MV.PEINH), 0) END AS STKUNITAMT
		FROM (
			SELECT TB.*
				 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS TOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS BAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS BOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS PLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS SOKQT /* 속(개/BALE) */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS USETOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS USEBAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS USEBOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS USEPLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS USESOKQT /* 속(개/BALE) */
				 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			  FROM (
				SELECT SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
					 , TB.SKUKEY
					 , TB.DESC01
					 , TB.UOMKEY
					 , SUM(TB.QTSIWH) AS QTSIWH
					 , SUM(TB.USEQTY) AS USEQTY
					 , SUM(TB.QTSCNU) AS QTSCNU
					 , SUM(TB.QTSIQT) AS QTSIQT
					 , SUM(TB.QTSWQT) AS QTSWQT
					 , SUM(TB.QTSHQT) AS QTSHQT
					 , SUM(TB.QTSALO) AS QTSALO
					 , SUM(TB.QTSOALO) AS QTSOALO
					 , SUM(TB.QTSPMO) AS QTSPMO
					 , SUM(TB.QTSPMI) AS QTSPMI
					 , SUM(TB.QTSBLK) AS QTSBLK
					 , TB.WAREKY
					 , (SELECT NAME01 FROM WAHMA WHERE WAREKY = TB.WAREKY) AS WARENM
					 , TB.LOTA02
					 , TB.SKUG05
				  FROM (
					<include refid="SD01_BASE"/>
					) TB
				GROUP BY TB.SKUL01
					   , TB.SKUKEY
					   , TB.DESC01
					   , TB.UOMKEY
					   , TB.WAREKY
					   , TB.LOTA02
					   , TB.SKUG05
			) TB
		) TB 
			LEFT JOIN BOXUOM BU ON TB.WAREKY = BU.WAREKY AND TB.SKUKEY = BU.MEASKY
			LEFT JOIN MATVAL MV ON MV.MATNR  = TB.SKUKEY AND MV.BWKEY  = TB.LOTA02 AND MV.MEINS = TB.UOMKEY 
		ORDER BY SKUL01NM
			   , TB.SKUKEY
			   , TB.DESC01
			   , TB.UOMKEY
			   , QTSIWH DESC
	</select>

	<select id="SD01TAB2_LIST" parameterType="Map" resultType="DataMap">
		WITH BOXUOM AS (
			<include refid="WITH_BOXUOM"/>
		)
		
		SELECT 
			TB.* 
			, NVL(BU.BOXEA , 0) AS BOXEA
		 	, NVL(BU.BOXBAG, 0) AS BOXBAG
		 	, NVL(BU.BOXPAL, 0) AS BOXPAL
		 	, TB.QTSIWH * NVL(DECODE(MV.PEINH, 0, 0, MV.STPRS / MV.PEINH), 0) AS STKAMT
		FROM (
			SELECT TB.*
				 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS TOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS BAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS BOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS PLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS SOKQT /* 속(개/BALE) */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS USETOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS USEBAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS USEBOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS USEPLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS USESOKQT /* 속(개/BALE) */
				 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			  FROM (
				SELECT TB.AREAKY, NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = TB.WAREKY AND AREAKY = TB.AREAKY),' ') AS AREANM
					 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
					 , TB.SKUKEY
					 , TB.DESC01
					 , TB.UOMKEY
					 , SUM(TB.QTSIWH) AS QTSIWH
					 , SUM(TB.USEQTY) AS USEQTY
					 , SUM(TB.QTSCNU) AS QTSCNU
					 , SUM(TB.QTSIQT) AS QTSIQT
					 , SUM(TB.QTSWQT) AS QTSWQT
					 , SUM(TB.QTSHQT) AS QTSHQT
					 , SUM(TB.QTSALO) AS QTSALO
					 , SUM(TB.QTSPMO) AS QTSPMO
					 , SUM(TB.QTSPMI) AS QTSPMI
					 , TB.WAREKY
					 , (SELECT NAME01 FROM WAHMA WHERE WAREKY = TB.WAREKY) AS WARENM
					 , TB.LOTA02
					 , TB.SKUG05
				  FROM (
					<include refid="SD01_BASE"/>
					) TB
				GROUP BY TB.AREAKY
					   , TB.SKUL01
					   , TB.SKUKEY
					   , TB.DESC01
					   , TB.UOMKEY
					   , TB.WAREKY
					   , TB.LOTA02
					   , TB.SKUG05
			) TB
		) TB
			LEFT JOIN BOXUOM BU ON TB.WAREKY = BU.WAREKY AND TB.SKUKEY = BU.MEASKY
			LEFT JOIN MATVAL MV ON MV.MATNR  = TB.SKUKEY AND MV.BWKEY  = TB.LOTA02 AND MV.MEINS = TB.UOMKEY 
		ORDER BY TB.AREAKY
			   , SKUL01NM
			   , TB.SKUKEY
			   , TB.DESC01
			   , TB.UOMKEY
			   , QTSIWH DESC
		
		
	</select>

	<select id="SD01TAB3_LIST" parameterType="Map" resultType="DataMap">
		WITH BOXUOM AS (
			<include refid="WITH_BOXUOM"/>
		)
		
		SELECT 
			TB.* 
			, NVL(BU.BOXEA , 0) AS BOXEA
		 	, NVL(BU.BOXBAG, 0) AS BOXBAG
		 	, NVL(BU.BOXPAL, 0) AS BOXPAL
		 	, TB.QTSIWH * NVL(DECODE(MV.PEINH, 0, 0, MV.STPRS / MV.PEINH), 0) AS STKAMT
		FROM (
			SELECT TB.*
				 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS TOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS BAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS BOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS PLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS SOKQT /* 속(개/BALE) */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS USETOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS USEBAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS USEBOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS USEPLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS USESOKQT /* 속(개/BALE) */
				 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			  FROM (
				SELECT TB.ZONEKY
					 , TB.AREAKY, NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = TB.WAREKY AND AREAKY = TB.AREAKY),' ') AS AREANM
					 , TB.LOCAKY
					 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
					 , TB.SKUKEY
					 , TB.DESC01
					 , TB.UOMKEY
					 , SUM(TB.QTSIWH) AS QTSIWH
					 , SUM(TB.USEQTY) AS USEQTY
					 , SUM(TB.QTSCNU) AS QTSCNU
					 , SUM(TB.QTSIQT) AS QTSIQT
					 , SUM(TB.QTSWQT) AS QTSWQT
					 , SUM(TB.QTSHQT) AS QTSHQT
					 , SUM(TB.QTSALO) AS QTSALO
					 , SUM(TB.QTSPMO) AS QTSPMO
					 , SUM(TB.QTSPMI) AS QTSPMI
					 , SUM(TB.QTSBLK) AS QTSBLK
					 , TB.WAREKY
					 , (SELECT NAME01 FROM WAHMA WHERE WAREKY = TB.WAREKY) AS WARENM
					 , TB.LOTA02
					 , TB.SKUG05
				  FROM (
					<include refid="SD01_BASE"/>
					) TB
				 GROUP BY TB.ZONEKY
						, TB.AREAKY
						, TB.LOCAKY
						, TB.SKUL01
						, TB.SKUKEY
						, TB.DESC01
						, TB.UOMKEY
						, TB.WAREKY
						, TB.LOTA02
						, TB.SKUG05
			) TB
		) TB 
			LEFT JOIN BOXUOM BU ON TB.WAREKY = BU.WAREKY AND TB.SKUKEY = BU.MEASKY
			LEFT JOIN MATVAL MV ON MV.MATNR  = TB.SKUKEY AND MV.BWKEY  = TB.LOTA02 AND MV.MEINS = TB.UOMKEY 
		ORDER BY TB.ZONEKY
				, TB.AREAKY
				, TB.LOCAKY
				, SKUL01NM
				, TB.SKUKEY
				, TB.DESC01
				, TB.UOMKEY
				, QTSIWH DESC
	</select>


	
	    <select id="SD01TAB4_SUB_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
    	SELECT S.WAREKY
    		 , S.STOKKY
			 , M.SKUL01
			 , M.SKUG05
			 , S.SKUKEY
			 , S.DESC01
			 , S.UOMKEY
			 , S.LOTNUM
			 , S.LOTA01, S.LOTA02, S.LOTA03, S.LOTA04, S.LOTA05
			 , S.LOTA06, S.LOTA07, S.LOTA08, S.LOTA09, S.LOTA10
			 , S.LOTA11, S.LOTA12, S.LOTA13, S.LOTA14, S.LOTA15
			 , S.LOTA16, S.LOTA17, S.LOTA18, S.LOTA19, S.LOTA20
			 , S.QTSIWH
			 , S.QTSALO
			 , S.QTSPMI
			 , S.QTSPMO
			 , S.AREAKY
			 , S.ZONEKY
			 , S.LOCAKY
			 , DECODE(S.LOTA06, '05', S.QTSIWH, 0) AS QTSIQT /* 품질 : Inspection QuanTity */
			 , DECODE(S.LOTA06, '10', S.QTSIWH, 0) AS QTSHQT /* 보류 : Hold       QuanTity */
			 , DECODE(S.LOTA06, '30', S.QTSIWH, 0) AS QTSCNU /* 불용 : Can Not Use         */
			 , DECODE(S.LOTA06, '50', S.QTSIWH, 0) AS QTSWQT /* 폐기 : Wasted     QuanTity */
			 , CASE WHEN S.LOTA06 IN ('00', '05', '10', '30', '50') THEN 0 ELSE S.QTSIWH END  AS QTSBLK
			 , CASE WHEN S.AREAKY = 'SHP' THEN S.QTSIWH ELSE 0 END AS QTSOUT
			 , CASE WHEN S.AREAKY = 'SHP' THEN 0
					ELSE S.QTSIWH - S.QTSBLK
								  - GREATEST(S.QTSALO, S.QTSPMO)
								  - (CASE WHEN S.LOTA06 IN ('00') OR S.QTSPMO > 0 THEN 0
										  ELSE S.QTSIWH
									 END)
			   END AS USEQTY
			  , R.RCPRSN
			  ,NVL(K.SEQNO,0) AS SEQNO
			  ,NVL(K.REMARK,' ') AS REMARK
			  ,NVL(K.LMOUSR,' ') AS LMOUSR
  			  ,NVL(K.LMOTIM,' ') AS LMOTIM	
			  ,NVL(K.LMODAT,' ') AS LMODAT	
			  ,NVL(K.CREUSR,' ') AS CREUSR	
			  ,NVL(K.CRETIM,' ') AS CRETIM	
			  ,NVL(K.CREDAT,' ') AS CREDAT
			  ,NVL(S.NMLAST,' ') AS LUSRNM
			  ,NVL(U.NMLAST,' ') AS CUSRNM 	
			  
		FROM STKKY S
		INNER JOIN SKUMA M ON M.OWNRKY = S.OWNRKY AND M.SKUKEY = S.SKUKEY
		LEFT OUTER JOIN RECDI R ON R.RECVKY = S.RECVKY AND R.RECVIT = S.RECVIT 
		LEFT OUTER JOIN STKREMARK K ON S.WAREKY = K.WAREKY AND S.STOKKY = K.STOKKY
		LEFT OUTER JOIN USRMA     U ON K.CREUSR = U.USERID 
		LEFT OUTER JOIN USRMA     S ON K.LMOUSR = S.USERID  
		WHERE 1=1
		 AND S.QTSIWH > 0 
		<if test="WAREKY != null and WAREKY != ''">AND S.WAREKY = #{WAREKY}</if>
		<if test="OWNRKY != null and OWNRKY != ''">AND S.OWNRKY = #{OWNRKY}</if>
		<if test="LOTA11 != null and LOTA11 != ''">AND S.LOTA11 = #{LOTA11}</if>
		<if test="LOTA12 != null and LOTA12 != ''">AND S.LOTA12 = #{LOTA12}</if>
		<if test="LOTA13 != null and LOTA13 != ''">AND S.LOTA13 = #{LOTA13}</if>
		<if test="LOTA14 != null and LOTA14 != ''">AND S.LOTA14 = #{LOTA14}</if>
		<if test="LOTA15 != null and LOTA15 != ''">AND S.LOTA15 = #{LOTA15}</if>
		<if test="AREAKY != null and AREAKY != ''">AND S.AREAKY = #{AREAKY}</if>
		<if test="SKUKEY != null and SKUKEY != ''">AND S.SKUKEY = #{SKUKEY}</if>
	</select>
	
	
	
	<select id="SD01TAB4_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
		<!-- 품목 환산단위 조회방법 변경필요 (성능 느림)
		WITH BOXUOM AS (
			<include refid="WITH_BOXUOM"/>
		)
		 -->
		SELECT 
			TB.* 
			, NVL(DECODE(TB.SKUG05, '10', ZP.PALCNT                      , 0), 0) AS RBALE /* PS인 경우만 노출 */
		 	, NVL(DECODE(TB.SKUG05, '10', ROUND(TB.QTSIWH / ZP.PALCNT, 3), 0), 0) AS BALE  /* PS인 경우만 노출 */
		 	, CASE WHEN TB.WAREKY = '4000' THEN 0 ELSE TB.QTSIWH * NVL(DECODE(MV.PEINH, 0, 0, MV.STPRS / MV.PEINH), 0) END AS STKAMT
		 	, CASE
				  WHEN SINCE_LOTA11  <![CDATA[<=]]> 30 THEN '30일 이하' 
				  WHEN SINCE_LOTA11  <![CDATA[>]]> 180 THEN '180일 초과'
				  ELSE TO_CHAR(TRUNC(SINCE_LOTA11 / 30) * 30) || '일 초과'
				END AS LOTA11_GROUP
		FROM (
			SELECT TB.*
				 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS TOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS BAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS BOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS PLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS SOKQT /* 속(개/BALE) */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS USETOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS USEBAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS USEBOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS USEPLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS USESOKQT /* 속(개/BALE) */
				 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
				 , CEIL(NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'PAL')), 1)) AS QTDPRT
				 -- , TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD')) AS SINCE_LOTA11
				 , CASE 
				    WHEN REGEXP_LIKE(LOTA11, '^[0-9]{8}$')  
				    THEN TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD'))
				    ELSE 0  -- 잘못된 날짜 처리
				END AS SINCE_LOTA11
			  FROM (
				SELECT TB.ZONEKY
					 , TB.AREAKY, NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = TB.WAREKY AND AREAKY = TB.AREAKY),' ') AS AREANM
					 , TB.LOCAKY
					 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
					 , TB.SKUKEY
					 , TB.DESC01
					 , TB.UOMKEY
					 , SUM(TB.QTSIWH) AS QTSIWH
					 , SUM(TB.USEQTY) AS USEQTY
	--				 , SUM(TB.QTSCNU) AS QTSCNU
	--				 , SUM(TB.QTSIQT) AS QTSIQT
	--				 , SUM(TB.QTSWQT) AS QTSWQT
	--				 , SUM(TB.QTSHQT) AS QTSHQT
					 , SUM(TB.QTSALO) AS QTSALO
					 , MAX(TB.QTSOALO) AS QTSOALO
					 , SUM(TB.QTSPMO) AS QTSPMO
					 , SUM(TB.QTSPMI) AS QTSPMI
					 , SUM(TB.QTSBLK) AS QTSBLK
					 , TB.LOTA01, TB.LOTA02, TB.LOTA03, TB.LOTA04, TB.LOTA05
					 , TB.LOTA06, TB.LOTA07, TB.LOTA08, TB.LOTA09, TB.LOTA10
					 , TB.LOTA11, TB.LOTA12, TB.LOTA13, TB.LOTA14, TB.LOTA15
					 , TB.LOTA16, TB.LOTA17, TB.LOTA18, TB.LOTA19, TB.LOTA20
					 , LT.LOTA21, LT.LOTA22, LT.LOTA23, LT.LOTA24
					 , LT.LOTA41, LT.LOTA42, LT.LOTA43, LT.LOTA44, LT.LOTA45
					 , LT.LOTA46, LT.LOTA47, LT.LOTA48, LT.LOTA49
					 , CASE WHEN TB.SKUG05 = '10' AND #{SearchType} = 'SearchJR' THEN (SELECT NVL(FN_GET_JROLL_BARCODE@MESLINK(TB.LOTA14), ' ') FROM DUAL)
				     		ELSE ' '
		     			END AS JRLOT -- 점버롤 LOT번호
					 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TB.LOTA06) AS LOTA06NM
					 , TB.WAREKY
					 , (SELECT NAME01 FROM WAHMA WHERE WAREKY = TB.WAREKY) AS WARENM
					 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = TB.LOTA09 AND PTNRTY = 'CT') AS LOTA09NM
					 , TB.SKUG05
					 , TB.RCPRSN
					 , SUM(NVL(TRIM(DECODE(MI.UOMKEY, 'BAG', MI.QTPUOM * (SELECT QTAUOM FROM MEASI WHERE UOMKEY = 'EA'  AND WAREKY = MI.WAREKY AND MEASKY = MI.MEASKY))), 0)) AS BOXEA  /* BAG.QTPUOM / EA .QTAUOM */
					 --, SUM(NVL(TRIM(DECODE(MI.UOMKEY, 'BOX', MI.QTPUOM                                                                                                )), 0)) AS BOXBAG /* BOX.QTPUOM              */
					 , MAX((SELECT QTPUOM FROM MEASI WHERE UOMKEY = 'BOX'  AND WAREKY = MI.WAREKY AND MEASKY = MI.MEASKY)) AS BOXBAG 
					 , SUM(NVL(TRIM(DECODE(MI.UOMKEY, 'PAL', MI.QTPUOM / (SELECT QTPUOM FROM MEASI WHERE UOMKEY = 'BOX' AND WAREKY = MI.WAREKY AND MEASKY = MI.MEASKY))), 0)) AS BOXPAL /* PAL.QTPUOM * BOX.QTPUOM */
				 
				  FROM (
					<include refid="SD01_BASE"/>
					) TB
				  INNER JOIN LOTAT LT ON TB.LOTNUM = LT.LOTNUM 
				  LEFT JOIN MEASI MI ON TB.WAREKY = MI.WAREKY AND TB.SKUKEY = MI.MEASKY AND MI.UOMKEY = TB.UOMKEY
				GROUP BY TB.ZONEKY
					   , TB.AREAKY
					   , TB.LOCAKY
					   , TB.SKUL01
					   , TB.SKUKEY
					   , TB.DESC01
					   , TB.UOMKEY
					   , TB.WAREKY
					   , TB.LOTA01, TB.LOTA02, TB.LOTA03, TB.LOTA04, TB.LOTA05
					   , TB.LOTA06, TB.LOTA07, TB.LOTA08, TB.LOTA09, TB.LOTA10
					   , TB.LOTA11, TB.LOTA12, TB.LOTA13, TB.LOTA14, TB.LOTA15
					   , TB.LOTA16, TB.LOTA17, TB.LOTA18, TB.LOTA19, TB.LOTA20
					   , LT.LOTA21, LT.LOTA22, LT.LOTA23, LT.LOTA24
					   , LT.LOTA41, LT.LOTA42, LT.LOTA43, LT.LOTA44, LT.LOTA45
					   , LT.LOTA46, LT.LOTA47, LT.LOTA48, LT.LOTA49
					   , TB.SKUG05, TB.RCPRSN
			  ) TB
		
		) TB 
		  	LEFT JOIN MATVAL MV ON MV.MATNR  = TB.SKUKEY AND MV.BWKEY  = TB.LOTA02 AND MV.MEINS = TB.UOMKEY
		  	LEFT JOIN ZPPTM  ZP ON ZP.MANDT = '100' AND TB.LOTA02 = ZP.LOTA02 AND TB.LOTA03 = ZP.LOTA03 AND TB.LOTA09 = ZP.LOTA09 AND TB.LOTA16 = ZP.LOTA16 AND TB.LOTA17 = ZP.LOTA17
		ORDER BY TB.ZONEKY
				   , TB.AREAKY
				   , TB.LOCAKY
				   , SKUL01NM
				   , TB.SKUKEY
				   , TB.DESC01
				   , TB.UOMKEY
				   , QTSIWH DESC
		
		  
	</select>
	
	

	<!-- SD02 : 문서별재고 추적 -->
	<select id="SD02_LIST" parameterType="Map" resultType="DataMap">
		WITH WHTRH_CURRENT AS (
			SELECT WH.TRNHKY
			 , WH.ITEMNO
			 , WH.TRNHTY || WH.TASKTY AS TRNHTY, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'TRNHTY', WH.TRNHTY || WH.TASKTY) AS TRNHTYNM
			 , WH.AREAKY
			 , WH.ZONEKY
			 , WH.LOCAKY
			 , WH.TRNUID
			 , SM.SKUL05 -- P-CODE
			 , WH.WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = WH.WAREKY),' ') AS WARENM
			 , WH.OWNRKY, NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = WH.OWNRKY),' ') AS OWNRNM
			 , WH.SKUKEY
			 , SM.EANCOD
			 , WH.QTPROC
			 , SM.DUOMKY AS UOMKEY
			 , WH.DESC01 AS DESC01
			 , SM.SKUL01, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , WH.STOKKY
			 , WH.LOTA01, WH.LOTA02, WH.LOTA03, WH.LOTA04, WH.LOTA05
			 , WH.LOTA06, WH.LOTA07, WH.LOTA08, WH.LOTA09, WH.LOTA10
			 , WH.LOTA11, WH.LOTA12, WH.LOTA13, WH.LOTA14, WH.LOTA15
			 , WH.LOTA16, WH.LOTA17, WH.LOTA18, WH.LOTA19, WH.LOTA20
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', WH.LOTA06) AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = WH.LOTA09 AND PTNRTY = 'CT')     AS LOTA09NM
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(SM.DUOMKY, 'KG' , WH.QTPROC
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'BAG', WH.QTPROC
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'BOX', WH.QTPROC
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(SM.DUOMKY, 'PAL', WH.QTPROC
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(SM.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'SOK', WH.QTPROC
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , NVL(DECODE(SM.SKUG05, '10', ZP.PALCNT                      , 0), 0) AS RBALE /* PS인 경우만 노출 */
			 , NVL(DECODE(SM.SKUG05, '10', ROUND(WH.QTPROC / ZP.PALCNT, 3), 0), 0) AS BALE  /* PS인 경우만 노출 */
			 , NVL(BU.BOXEA , 0) AS BOXEA
			 , NVL(BU.BOXBAG, 0) AS BOXBAG
			 , NVL(BU.BOXPAL, 0) AS BOXPAL
			 , WH.RECVKY, WH.RECVIT
			 , WH.SHPOKY, WH.SHPOIT
			 , WH.TASKKY, WH.TASKIT
			 , WH.SADJKY, WH.SADJIT
			 , WH.CREDAT, WH.CRETIM, WH.CREUSR, (SELECT NMLAST FROM USRMA WHERE USERID = WH.CREUSR) AS CUSRNM
			 , WH.LMODAT, WH.LMOTIM, WH.LMOUSR, (SELECT NMLAST FROM USRMA WHERE USERID = WH.LMOUSR) AS LUSRNM
			 , WH.REFDAT
			 , NVL(DECODE(TI.DOORKY, 'PDPK06', '지정피킹', 'PDPK06_', '피킹완료'), TI.DOORKY) TASCAT 
		  FROM WHTRH WH
		   LEFT JOIN SKUMA  SM ON SM.OWNRKY = WH.OWNRKY AND SM.SKUKEY = WH.SKUKEY
		   LEFT JOIN (<include refid="WITH_BOXUOM"/>) BU ON WH.WAREKY = BU.WAREKY AND SM.SKUKEY = BU.MEASKY
		   LEFT JOIN CMCDV  CM ON CM.CMCDKY = 'TRNHTY'  AND CM.USARG2 = WH.TRNHTY AND CM.USARG3 = WH.TASKTY
		   LEFT JOIN ZPPTM  ZP ON ZP.MANDT = '100' AND  WH.LOTA02 = ZP.LOTA02 AND WH.LOTA03 = ZP.LOTA03 AND WH.LOTA09 = ZP.LOTA09 AND WH.LOTA16 = ZP.LOTA16 AND WH.LOTA17 = ZP.LOTA17 
		   LEFT JOIN TASDI  TI ON WH.TASKKY  = TI.TASKKY AND WH.TASKIT  = TI.TASKIT AND TI.TASKTY = 'PK' AND WH.LOTA14 = TI.LOTA14 
		 WHERE 1 = 1
		   AND WH.WAREKY = #{WAREKY}
		   AND WH.OWNRKY = #{OWNRKY}
		   AND WH.CRETIM BETWEEN #{FRCRETIM} AND #{TOCRETIM}
		   <if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		   <if test="TRNHTY != null and TRNHTY != ''">AND CM.CMCDVL LIKE '%' || TRIM(#{TRNHTY}) || '%'</if>
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(WH.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		)
		
	   <if test="USEBACKUP != null and USEBACKUP != ''">
	   , WHTRH_PAST AS (
		   SELECT WH.TRNHKY
				 , WH.ITEMNO
				 , WH.TRNHTY || WH.TASKTY AS TRNHTY, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'TRNHTY', WH.TRNHTY || WH.TASKTY) AS TRNHTYNM
				 , WH.AREAKY
				 , WH.ZONEKY
				 , WH.LOCAKY
				 , WH.TRNUID
				 , SM.SKUL05 -- P-CODE
				 , WH.WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = WH.WAREKY),' ') AS WARENM
				 , WH.OWNRKY, NVL((SELECT NAME01 FROM OWNER WHERE OWNRKY = WH.OWNRKY),' ') AS OWNRNM
				 , WH.SKUKEY
				 , SM.EANCOD
				 , WH.QTPROC
				 , SM.DUOMKY AS UOMKEY
				 , WH.DESC01 AS DESC01
				 , SM.SKUL01, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
				 , WH.STOKKY
				 , WH.LOTA01, WH.LOTA02, WH.LOTA03, WH.LOTA04, WH.LOTA05
				 , WH.LOTA06, WH.LOTA07, WH.LOTA08, WH.LOTA09, WH.LOTA10
				 , WH.LOTA11, WH.LOTA12, WH.LOTA13, WH.LOTA14, WH.LOTA15
				 , WH.LOTA16, WH.LOTA17, WH.LOTA18, WH.LOTA19, WH.LOTA20
				 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', WH.LOTA06) AS LOTA06NM
				 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = WH.LOTA09 AND PTNRTY = 'CT')     AS LOTA09NM
				 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
				 , NVL(DECODE(SM.DUOMKY, 'KG' , WH.QTPROC
											  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS TOTWG /* 총중량 */
				 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(SM.DUOMKY, 'BAG', WH.QTPROC
											  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS BAGQT /* EA/BAG */
				 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(SM.DUOMKY, 'BOX', WH.QTPROC
											  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS BOXQT /* BAG/BOX */
				 , NVL(DECODE(SM.DUOMKY, 'PAL', WH.QTPROC
											  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS PLTQT /* BOX/Pallet */
				 , NVL(DECODE(SM.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(SM.DUOMKY, 'SOK', WH.QTPROC
											  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = WH.WAREKY AND MEASKY = WH.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(WH.QTPROC                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = WH.WAREKY AND MI.MEASKY = WH.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS SOKQT /* 속(개/BALE) */
				 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(WH.WAREKY, WH.SKUKEY, WH.QTPROC, SM.DUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
				 , NVL(DECODE(SM.SKUG05, '10', ZP.PALCNT                      , 0), 0) AS RBALE /* PS인 경우만 노출 */
				 , NVL(DECODE(SM.SKUG05, '10', ROUND(WH.QTPROC / ZP.PALCNT, 3), 0), 0) AS BALE  /* PS인 경우만 노출 */
				 , NVL(BU.BOXEA , 0) AS BOXEA
				 , NVL(BU.BOXBAG, 0) AS BOXBAG
				 , NVL(BU.BOXPAL, 0) AS BOXPAL
				 , WH.RECVKY, WH.RECVIT
				 , WH.SHPOKY, WH.SHPOIT
				 , WH.TASKKY, WH.TASKIT
				 , WH.SADJKY, WH.SADJIT
				 , WH.CREDAT, WH.CRETIM, WH.CREUSR, (SELECT NMLAST FROM USRMA WHERE USERID = WH.CREUSR) AS CUSRNM
				 , WH.LMODAT, WH.LMOTIM, WH.LMOUSR, (SELECT NMLAST FROM USRMA WHERE USERID = WH.LMOUSR) AS LUSRNM
				 , WH.REFDAT
				 , NVL(DECODE(TI.DOORKY, 'PDPK06', '지정피킹', 'PDPK06_', '피킹완료'), ' ') TASCAT 
			  FROM WHTRH_BACKUP WH
			   LEFT JOIN SKUMA  SM ON SM.OWNRKY = WH.OWNRKY AND SM.SKUKEY = WH.SKUKEY
			   LEFT JOIN (<include refid="WITH_BOXUOM"/>) BU ON WH.WAREKY = BU.WAREKY AND SM.SKUKEY = BU.MEASKY
			   LEFT JOIN CMCDV  CM ON CM.CMCDKY = 'TRNHTY'  AND CM.USARG2 = WH.TRNHTY AND CM.USARG3 = WH.TASKTY
			   LEFT JOIN ZPPTM  ZP ON ZP.MANDT = '100' AND WH.LOTA02 = ZP.LOTA02 AND WH.LOTA03 = ZP.LOTA03 AND WH.LOTA09 = ZP.LOTA09 AND WH.LOTA16 = ZP.LOTA16 AND WH.LOTA17 = ZP.LOTA17 
			   LEFT JOIN TASDI  TI ON WH.TASKKY  = TI.TASKKY AND WH.TASKIT  = TI.TASKIT AND TI.TASKTY = 'PK' AND WH.LOTA14 = TI.LOTA14 
			 WHERE 1 = 1
			   AND WH.WAREKY = #{WAREKY}
			   AND WH.OWNRKY = #{OWNRKY}
			   AND WH.CRETIM BETWEEN #{FRCRETIM} AND #{TOCRETIM}
			   <if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
			   <if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
			   <if test="TRNHTY != null and TRNHTY != ''">AND CM.CMCDVL LIKE '%' || TRIM(#{TRNHTY}) || '%'</if>
			   <if test="DESC01 != null and DESC01 != ''">AND UPPER(WH.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
			   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		   )
	   	</if>
	   	SELECT * FROM WHTRH_CURRENT 
	   	<if test="USEBACKUP != null and USEBACKUP != ''">
	   		UNION ALL 
   		SELECT * FROM WHTRH_PAST
	   	</if>
	</select>

	<select id="PDST01LOC_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.AREAKY, TB.ZONEKY, TB.LOCAKY
		  FROM (
			<include refid="SD01_BASE"/>
			) TB
		GROUP BY TB.ZONEKY, TB.AREAKY, TB.LOCAKY
		ORDER BY 1, 2, 3
	</select>

	<select id="PDST01_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.*
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , NVL(SUBSTR(TB.LOTA07, 1, 10), ' ') AS SALENO
			 , NVL(SUBSTR(TB.LOTA07, 11   ), ' ') AS SKUNUM
		  FROM (
			SELECT TB.LOTA14
				 , TB.ZONEKY
				 , TB.LOCAKY
				 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
				 , TB.SKUKEY
				 , TB.DESC01
				 , TB.UOMKEY
				 , TB.WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = TB.WAREKY) AS WARENM
				 , TB.LOTA02
				 , SUM(TB.QTSIWH) AS QTSIWH
				 --, SUM(TB.USEQTY) AS USEQTY
				 --, SUM(TB.QTSCNU) AS QTSCNU
				 --, SUM(TB.QTSIQT) AS QTSIQT
				 --, SUM(TB.QTSWQT) AS QTSWQT
				 --, SUM(TB.QTSHQT) AS QTSHQT
				 --, SUM(TB.QTSALO) AS QTSALO
				 --, SUM(TB.QTSPMO) AS QTSPMO
				 --, SUM(TB.QTSPMI) AS QTSPMI
				 --, SUM(TB.QTSBLK) AS QTSBLK
				 , (CASE WHEN SUM(TB.USEQTY) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.USEQTY), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.USEQTY)
			 		END) AS USEQTY 
				 , (CASE WHEN SUM(TB.QTSCNU) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSCNU), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSCNU)
			 		END) AS QTSCNU 
				 , (CASE WHEN SUM(TB.QTSIQT) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIQT), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSIQT)
			 		END) AS QTSIQT 
				 , (CASE WHEN SUM(TB.QTSWQT) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSWQT), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSWQT)
			 		END) AS QTSWQT 
				 , (CASE WHEN SUM(TB.QTSHQT) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSHQT), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSHQT)
			 		END) AS QTSHQT 
				 , (CASE WHEN SUM(TB.QTSALO) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSALO), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSALO)
			 		END) AS QTSALO 
				 , (CASE WHEN SUM(TB.QTSOALO) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSOALO), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSOALO)
			 		END) AS QTSOALO 
				 , (CASE WHEN SUM(TB.QTSPMO) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSPMO), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSPMO)
			 		END) AS QTSPMO 
				 , (CASE WHEN SUM(TB.QTSPMI) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSPMI), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSPMI)
			 		END) AS QTSPMI 
				 , (CASE WHEN SUM(TB.QTSBLK) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSBLK), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSBLK)
			 		END) AS QTSBLK 
				 , TB.SKUG05
				 , SZF_GET_CMCDV_CDESC1_TEXT('', 'LOTA06', TB.LOTA06) AS LOTA06NM
				 , TB.LOTA07
				 , TB.LOTA08
				 , TB.LOTA09
				 , TB.LOTA11
				 , TB.LOTA12
				 , TB.LOTA13
			  FROM (
				<include refid="SD01_BASE"/>
				) TB
			GROUP BY TB.LOTA14
				   , TB.ZONEKY
				   , TB.LOCAKY
				   , TB.SKUL01
				   , TB.SKUKEY
				   , TB.DESC01
				   , TB.UOMKEY
				   , TB.WAREKY
				   , TB.LOTA02
				   , TB.SKUG05
				   , TB.LOTA06
				   , TB.LOTA07
				   , TB.LOTA08
				   , TB.LOTA09
				   , TB.LOTA11
				   , TB.LOTA12
				   , TB.LOTA13
			ORDER BY TB.LOTA14
				   , TB.ZONEKY
				   , TB.LOCAKY
				   , TB.SKUL01
				   , TB.SKUKEY
				   , TB.DESC01
				   , TB.UOMKEY
				   , TB.WAREKY
				   , TB.LOTA02
		  ) TB
	</select>
	
	<select id="PDST01SKUSUM_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.*
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , ' ' AS SALENO
			 , ' ' AS SKUNUM
			 , LOTA14
		  FROM (
			SELECT COUNT(DISTINCT(TB.LOTA14 || TB.ZONEKY)) AS LOTA14
				 , ' ' AS ZONEKY
				 , ' ' AS LOCAKY
				 , ' ' AS SKUL01NM
				 , TB.SKUKEY
				 , '합계' AS DESC01
				 , TB.UOMKEY
				 , TB.WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = TB.WAREKY) AS WARENM
				 , ' ' AS LOTA02
				 , SUM(TB.QTSIWH) AS QTSIWH
				 --, SUM(TB.USEQTY) AS USEQTY
				 --, SUM(TB.QTSCNU) AS QTSCNU
				 --, SUM(TB.QTSIQT) AS QTSIQT
				 --, SUM(TB.QTSWQT) AS QTSWQT
				 --, SUM(TB.QTSHQT) AS QTSHQT
				 --, SUM(TB.QTSALO) AS QTSALO
				 --, SUM(TB.QTSPMO) AS QTSPMO
				 --, SUM(TB.QTSPMI) AS QTSPMI
				 --, SUM(TB.QTSBLK) AS QTSBLK
				 , (CASE WHEN SUM(TB.USEQTY) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.USEQTY), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.USEQTY)
			 		END) AS USEQTY 
				 , (CASE WHEN SUM(TB.QTSCNU) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSCNU), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSCNU)
			 		END) AS QTSCNU 
				 , (CASE WHEN SUM(TB.QTSIQT) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSIQT), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSIQT)
			 		END) AS QTSIQT 
				 , (CASE WHEN SUM(TB.QTSWQT) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSWQT), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSWQT)
			 		END) AS QTSWQT 
				 , (CASE WHEN SUM(TB.QTSHQT) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSHQT), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSHQT)
			 		END) AS QTSHQT 
				 , (CASE WHEN SUM(TB.QTSALO) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSALO), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSALO)
			 		END) AS QTSALO 
				 , (CASE WHEN SUM(TB.QTSOALO) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSOALO), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSOALO)
			 		END) AS QTSOALO 
				 , (CASE WHEN SUM(TB.QTSPMO) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSPMO), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSPMO)
			 		END) AS QTSPMO 
				 , (CASE WHEN SUM(TB.QTSPMI) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSPMI), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSPMI)
			 		END) AS QTSPMI 
				 , (CASE WHEN SUM(TB.QTSBLK) != 0 AND TB.SKUG05 = '20' THEN NVL(TO_NUMBER(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, SUM(TB.QTSBLK), TB.UOMKEY, 'BOX')),'0') 
				 		ELSE SUM(TB.QTSBLK)
			 		END) AS QTSBLK
				 , TB.SKUG05
				 , ' ' AS LOTA06NM
				 , ' ' AS LOTA07
				 , ' ' AS LOTA08
				 , ' ' AS LOTA09
				 , ' ' AS LOTA11
				 , ' ' AS LOTA12
				 , ' ' AS LOTA13
			  FROM (
				<include refid="SD01_BASE"/>
				) TB
			GROUP BY 
				    TB.SKUKEY
				   , TB.UOMKEY
				   , TB.WAREKY
				   , TB.SKUG05
			ORDER BY  TB.SKUKEY
				   , TB.UOMKEY
				   , TB.WAREKY
				   , TB.SKUG05
		  ) TB
	</select>
	
	<!--  재고조정
		  SJ01 재고 상태변경
		  SJ03 재고 저장위치변경
		  SJ04 재고 LOT속성변경
		  SJ05 재고 품목변경
		  SJ18 재고MTO/MTS변경
	 -->
	<select id="SJ03_LIST" parameterType="Map" resultType="DataMap">
		SELECT ' ' AS SADJKY
			 , ' ' AS ADJDSC
			 , F_SET_DATE(SYSDATE) AS DOCDAT
			 , '400'     AS DOCCAT, (SELECT SHORTX FROM DOCCM WHERE DOCCAT = '400') AS DOCCATNM
			 , #{DOCUTY} AS ADJUTY
			 , #{DOCUTY} AS ADJUCA, (SELECT SHORTX FROM DOCTM WHERE DOCUTY = #{DOCUTY}) AS ADJUCANM
			 , #{WAREKY} AS WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}) AS WAREKYNM
			 , ' ' 	AS DOCTXT
			 , TO_CHAR(SYSDATE,'YYYY-MM-DD') AS CREDAT, TO_CHAR(SYSDATE,'HH24:MI:SS') AS CRETIM, #{SES_USER_ID} AS CREUSR, (SELECT NMLAST FROM USRMA WHERE USERID = #{SES_USER_ID} AND ROWNUM = 1)  AS CUSRNM
			 , TO_CHAR(SYSDATE,'YYYY-MM-DD') AS LMODAT, TO_CHAR(SYSDATE,'HH24:MI:SS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR, (SELECT NMLAST FROM USRMA WHERE USERID = #{SES_USER_ID} AND ROWNUM = 1)  AS LUSRNM
			 , 'V' AS SAPIFYN
		FROM DUAL
	</select>
	
	<!--  재고조정
		  SJ01 재고 상태변경
		  SJ03 재고 저장위치변경
		  SJ04 재고 LOT속성변경
		  SJ05 재고 품목변경
		  SJ18 재고MTO/MTS변경
		  PDSJ01 PDA 재고상태변경
	 -->
	<sql id="STKKY_BASE">
		SELECT ' ' AS AADJRSN
			 , ' ' AS ASTOKKY
			 , ' ' AS ALOTNUM
			 , ' ' AS ADJRSN
			 , ' ' AS ARSNADJ
			 , ' ' AS BARCODCH
			 , ' ' AS RELRSN
			 , '0' AS QTADJU
			 , '0' AS QTBLKD
			 , S.AREAKY AS AAREAKY
			 , M.DUOMKY AS ADUOMKY
			 , M.EANCOD AS AEANCOD
			 , M.GRSWGT AS AGRSWGT
			 , M.GTINCD AS AGTINCD
			 , CASE WHEN #{menuId} IN ('SJ03')           THEN ' ' ELSE S.LOTA01 END AS ALOTA01
			 , CASE WHEN #{menuId} IN ('SJ03')           THEN ' ' ELSE S.LOTA02 END AS ALOTA02
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA03 END AS ALOTA03
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA04 END AS ALOTA04
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA05 END AS ALOTA05
			 , CASE WHEN #{menuId} IN ('SJ01', 'PDSJ01') THEN ' ' ELSE S.LOTA06 END AS ALOTA06
			 , CASE WHEN #{menuId} IN ('SJ18', 'SJ19') 	 THEN ' ' ELSE S.LOTA07 END AS ALOTA07
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA08 END AS ALOTA08
			 , CASE WHEN #{menuId} IN ('SJ18', 'SJ19')   THEN ' ' ELSE S.LOTA09 END AS ALOTA09
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA10 END AS ALOTA10
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA11 END AS ALOTA11
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA12 END AS ALOTA12
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA13 END AS ALOTA13
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA14 END AS ALOTA14
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA15 END AS ALOTA15
			 , CASE WHEN #{menuId} IN (' ')              THEN 0   ELSE S.LOTA16 END AS ALOTA16
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA17 END AS ALOTA17
			 , CASE WHEN #{menuId} IN (' ')              THEN 0   ELSE S.LOTA18 END AS ALOTA18
			 , CASE WHEN #{menuId} IN (' ')              THEN 0   ELSE S.LOTA19 END AS ALOTA19
			 , CASE WHEN #{menuId} IN (' ')              THEN 0   ELSE S.LOTA20 END AS ALOTA20
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOCAKY END AS ALOCAKY
			 , CASE WHEN #{menuId} IN ('SJ05')           THEN ' ' ELSE S.SKUKEY END AS ASKUKEY
			 , CASE WHEN #{menuId} IN ('SJ05')           THEN ' ' ELSE S.DESC01 END AS ADESC01
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.DESC02 END AS ADESC02
			 , S.ASKU01 AS AASKU01, S.ASKU02 AS AASKU02, M.ASKU03 AS AASKU03, S.ASKU04 AS AASKU04, S.ASKU05 AS AASKU05
			 , S.SKUG01 AS ASKUG01, S.SKUG02 AS ASKUG02, S.SKUG03 AS ASKUG03, S.SKUG04 AS ASKUG04, S.SKUG05 AS ASKUG05
			 , S.MEASKY AS AMEASKY
			 , M.NETWGT AS ANETWGT
			 , S.OWNRKY AS AOWNRKY
			 , S.PACKID AS APACKID
			 , S.QTSBLK AS AQTBLKD
			 , S.QTPUOM AS AQTPUOM
			 , S.QTYUOM AS AQTYUOM
			 , S.SECTID AS ASECTID
			 , S.TRNUID AS ATRNUID
			 , S.TRUNTY AS ATRUNTY
			 , M.DUOMKY AS AUOMKEY
			 , S.AREAKY
			 , S.ASNDIT
			 , S.ASNDKY
			 , S.AWMSNO
			 , S.CAPACT
			 , S.CUBICM
			 , S.DESC01, S.DESC02
			 , S.DUOMKY
			 , S.EANCOD
			 , S.GRSWGT
			 , S.GTINCD
			 , S.HEIGHT
			 , S.LENGTH
			 , S.LOCAKY
			 , S.LOTA01, S.LOTA02, S.LOTA03, S.LOTA04, S.LOTA05
			 , S.LOTA06, S.LOTA07, S.LOTA08, S.LOTA09, S.LOTA10
			 , S.LOTA11, S.LOTA12, S.LOTA13, S.LOTA14, S.LOTA15
			 , S.LOTA16, S.LOTA17, S.LOTA18, S.LOTA19, S.LOTA20
			 , S.ASKU01, S.ASKU02, M.ASKU03, S.ASKU04, S.ASKU05
			 , S.SKUG01, S.SKUG02, S.SKUG03, S.SKUG04, S.SKUG05
			 , S.CREDAT, S.CRETIM, S.CREUSR
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'DP' AND PTNRKY = S.LOTA02) AS LOTA02NM
			 , S.QTSIWH AS AQTADJU
			 , S.LOTNUM
			 , S.MEASKY
			 , S.NETWGT
			 , S.OWNRKY
			 , S.PACKID
			 , S.QTDUOM
			 , S.QTPUOM
			 , S.QTSBLK
			 , S.QTSIWH
			 , S.QTYUOM
			 , S.REFCAT
			 , S.REFDAT
			 , S.REFDIT
			 , S.REFDKY
			 , S.SADJIT
			 , S.SADJKY
			 , S.SAPSTS
			 , S.SDATBG
			 , S.SEBELN
			 , S.SEBELP
			 , S.SECTID
			 , S.SKUKEY
			 , S.SLGORT
			 , S.SMANDT
			 , S.SMBLNR
			 , S.SMJAHR
			 , S.SPOSNR
			 , S.SSORIT
			 , S.SSORNU
			 , S.STDLNR
			 , S.STKNUM
			 , S.STOKKY
			 , S.STPNUM
			 , S.STRAID
			 , S.SVBELN
			 , S.SWERKS
			 , S.SXBLNR
			 , S.SZEILE
			 , S.SZMBLNO
			 , S.SZMIPNO
			 , S.TRNUID
			 , S.TRUNTY
			 , S.UOMKEY
			 , NVL((S.QTSIWH - GREATEST(S.QTSALO,S.QTSPMO) - S.QTSBLK),0) AS QTABLE
			 , S.WGTUNT
			 , S.WIDTHW
			 , S.ZONEKY
			 , S.STOKKY AS REFSTK
			 , S.WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = S.WAREKY)             AS WARENM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', M.SKUL01)                 AS SKUL01NM
			 , (SELECT STLNM  FROM STLMA WHERE STLKY  = S.LOTA01 AND PLNTKY = S.LOTA02) AS LOTA01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', S.LOTA06)                 AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = S.LOTA09 AND PTNRTY = 'CT')     AS LOTA09NM
			 , ' '                                                                      AS ALOTA01NM
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(S.UOMKEY, 'KG' , S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(M.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(S.UOMKEY, 'BAG', S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(M.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(S.UOMKEY, 'BOX', S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(S.UOMKEY, 'PAL', S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(M.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(S.UOMKEY, 'SOK', S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , CASE WHEN S.QTSIWH = 0 THEN 0 
			 		ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.DUOMKY, 'BOX'))),'0') 
		 		END AS BOXBAG
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , QTSIWH - QTSBLK
					  - GREATEST(QTSALO,QTSPMO)
					  - (CASE WHEN LOTA06 IN ('00') OR QTSPMO > 0 THEN 0 ELSE QTSIWH END)
			   AS USEQTY
			
		  FROM STKKY S
		  INNER JOIN SKUMA M ON (S.OWNRKY = M.OWNRKY AND S.SKUKEY = M.SKUKEY)
		  WHERE 1=1
		   AND S.QTSIWH - (S.QTSALO + S.QTSBLK) > 0
		   AND S.QTSIWH - (S.QTSPMO + S.QTSBLK) > 0
		   AND S.AREAKY NOT IN ('SYS', 'SHP','CRT','RTS')
		   <if test="WAREKY != null and WAREKY != ''">AND S.WAREKY = #{WAREKY}</if>
		   <if test="OWNRKY != null and OWNRKY != ''">AND S.OWNRKY = #{OWNRKY}</if>
		   <if test="PLNTKY != null and PLNTKY != ''">AND S.LOTA02 = #{PLNTKY}</if>
		   <if test="LOTA06 != null and LOTA06 != ''">AND S.LOTA06 = #{LOTA06}</if>
		   <if test="BARCOD != null and BARCOD != ''">AND S.LOTA14 = #{BARCOD}</if>
		   <if test="STOKKY != null and STOKKY != ''">AND S.STOKKY = #{STOKKY}</if>
		   <if test="SKUG01 != null and SKUG01 != ''">AND M.SKUG01 = #{SKUG01}</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
		   <if test="LOCAKY != null and LOCAKY != ''">AND S.LOCAKY = #{LOCAKY}</if><!-- PDA -->
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(S.DESC01) LIKE '%'|| UPPER(#{DESC01}) || '%'</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
	</sql>
	
	<select id="SJ03Sub_LIST" parameterType="Map" resultType="DataMap">
	WITH STKItem AS (
	SELECT ' ' AS AADJRSN
			 , ' ' AS ASTOKKY
			 , ' ' AS ALOTNUM
			 , ' ' AS ADJRSN
			 , ' ' AS ARSNADJ
			 , ' ' AS BARCODCH
			 , ' ' AS RELRSN
			 , '0' AS QTADJU
			 , '0' AS QTBLKD
			 , S.AREAKY AS AAREAKY
			 , M.DUOMKY AS ADUOMKY
			 , M.EANCOD AS AEANCOD
			 , M.GRSWGT AS AGRSWGT
			 , M.GTINCD AS AGTINCD
			 , CASE WHEN #{menuId} IN ('SJ03')           THEN ' ' ELSE S.LOTA01 END AS ALOTA01
			 , CASE WHEN #{menuId} IN ('SJ03')           THEN ' ' ELSE S.LOTA02 END AS ALOTA02
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA03 END AS ALOTA03
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA04 END AS ALOTA04
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA05 END AS ALOTA05
			 , CASE WHEN #{menuId} IN ('SJ01', 'PDSJ01') THEN ' ' ELSE S.LOTA06 END AS ALOTA06
			 , CASE WHEN #{menuId} IN ('SJ18', 'SJ19') 	 THEN ' ' ELSE S.LOTA07 END AS ALOTA07
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA08 END AS ALOTA08
			 , CASE WHEN #{menuId} IN ('SJ18', 'SJ19')   THEN ' ' ELSE S.LOTA09 END AS ALOTA09
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA10 END AS ALOTA10
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA11 END AS ALOTA11
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA12 END AS ALOTA12
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA13 END AS ALOTA13
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA14 END AS ALOTA14
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA15 END AS ALOTA15
			 , CASE WHEN #{menuId} IN (' ')              THEN 0   ELSE S.LOTA16 END AS ALOTA16
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOTA17 END AS ALOTA17
			 , CASE WHEN #{menuId} IN (' ')              THEN 0   ELSE S.LOTA18 END AS ALOTA18
			 , CASE WHEN #{menuId} IN (' ')              THEN 0   ELSE S.LOTA19 END AS ALOTA19
			 , CASE WHEN #{menuId} IN (' ')              THEN 0   ELSE S.LOTA20 END AS ALOTA20
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.LOCAKY END AS ALOCAKY
			 , CASE WHEN #{menuId} IN ('SJ05')           THEN ' ' ELSE S.SKUKEY END AS ASKUKEY
			 , CASE WHEN #{menuId} IN ('SJ05')           THEN ' ' ELSE S.DESC01 END AS ADESC01
			 , CASE WHEN #{menuId} IN (' ')              THEN ' ' ELSE S.DESC02 END AS ADESC02
			 , S.ASKU01 AS AASKU01, S.ASKU02 AS AASKU02, M.ASKU03 AS AASKU03, S.ASKU04 AS AASKU04, S.ASKU05 AS AASKU05
			 , S.SKUG01 AS ASKUG01, S.SKUG02 AS ASKUG02, S.SKUG03 AS ASKUG03, S.SKUG04 AS ASKUG04, S.SKUG05 AS ASKUG05
			 , S.MEASKY AS AMEASKY
			 , M.NETWGT AS ANETWGT
			 , S.OWNRKY AS AOWNRKY
			 , S.PACKID AS APACKID
			 , S.QTSBLK AS AQTBLKD
			 , S.QTPUOM AS AQTPUOM
			 , S.QTYUOM AS AQTYUOM
			 , S.SECTID AS ASECTID
			 , S.TRNUID AS ATRNUID
			 , S.TRUNTY AS ATRUNTY
			 , M.DUOMKY AS AUOMKEY
			 , S.AREAKY
			 , S.ASNDIT
			 , S.ASNDKY
			 , S.AWMSNO
			 , S.CAPACT
			 , S.CUBICM
			 , S.DESC01, S.DESC02
			 , S.DUOMKY
			 , S.EANCOD
			 , S.GRSWGT
			 , S.GTINCD
			 , S.HEIGHT
			 , S.LENGTH
			 , S.LOCAKY
			 , S.LOTA01, S.LOTA02, S.LOTA03, S.LOTA04, S.LOTA05
			 , S.LOTA06, S.LOTA07, S.LOTA08, S.LOTA09, S.LOTA10
			 , S.LOTA11, S.LOTA12, S.LOTA13, S.LOTA14, S.LOTA15
			 , S.LOTA16, S.LOTA17, S.LOTA18, S.LOTA19, S.LOTA20
			 , S.ASKU01, S.ASKU02, M.ASKU03, S.ASKU04, S.ASKU05
			 , S.SKUG01, S.SKUG02, S.SKUG03, S.SKUG04, S.SKUG05
			 , S.CREDAT, S.CRETIM, S.CREUSR
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'DP' AND PTNRKY = S.LOTA02) AS LOTA02NM
			 , S.QTSIWH AS AQTADJU
			 , S.LOTNUM
			 , S.MEASKY
			 , S.NETWGT
			 , S.OWNRKY
			 , S.PACKID
			 , S.QTDUOM
			 , S.QTPUOM
			 , S.QTSBLK
			 , S.QTSIWH
			 , S.QTYUOM
			 , S.REFCAT
			 , S.REFDAT
			 , S.REFDIT
			 , S.REFDKY
			 , S.SADJIT
			 , S.SADJKY
			 , S.SAPSTS
			 , S.SDATBG
			 , S.SEBELN
			 , S.SEBELP
			 , S.SECTID
			 , S.SKUKEY
			 , S.SLGORT
			 , S.SMANDT
			 , S.SMBLNR
			 , S.SMJAHR
			 , S.SPOSNR
			 , S.SSORIT
			 , S.SSORNU
			 , S.STDLNR
			 , S.STKNUM
			 , S.STOKKY
			 , S.STPNUM
			 , S.STRAID
			 , S.SVBELN
			 , S.SWERKS
			 , S.SXBLNR
			 , S.SZEILE
			 , S.SZMBLNO
			 , S.SZMIPNO
			 , S.TRNUID
			 , S.TRUNTY
			 , S.UOMKEY
			 , NVL((S.QTSIWH - GREATEST(S.QTSALO,S.QTSPMO) - S.QTSBLK),0) AS QTABLE
			 , S.WGTUNT
			 , S.WIDTHW
			 , S.ZONEKY
			 , S.STOKKY AS REFSTK
			 , S.WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = S.WAREKY)             AS WARENM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', M.SKUL01)                 AS SKUL01NM
			 , (SELECT STLNM  FROM STLMA WHERE STLKY  = S.LOTA01 AND PLNTKY = S.LOTA02) AS LOTA01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', S.LOTA06)                 AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = S.LOTA09 AND PTNRTY = 'CT')     AS LOTA09NM
			 , ' '                                                                      AS ALOTA01NM
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(S.UOMKEY, 'KG' , S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(M.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(S.UOMKEY, 'BAG', S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(M.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(S.UOMKEY, 'BOX', S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(S.UOMKEY, 'PAL', S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(M.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(S.UOMKEY, 'SOK', S.QTSIWH
										 , (SELECT DECODE(S.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = S.WAREKY AND MEASKY = S.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(S.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = S.WAREKY AND MI.MEASKY = S.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , CASE WHEN S.QTSIWH = 0 THEN 0 
			 		ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.DUOMKY, 'BOX'))),'0') 
		 		END AS BOXBAG
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , S.QTSIWH - S.QTSBLK
					  - GREATEST(S.QTSALO,S.QTSPMO)
					  - (CASE WHEN S.LOTA06 IN ('00') OR S.QTSPMO > 0 THEN 0 ELSE S.QTSIWH END)
			   AS USEQTY
			 , (SELECT MAX(RI.CRETIM) FROM RECDI RI WHERE S.LOTA02 = RI.LOTA02 AND S.LOTA14 = RI.LOTA14 AND S.LOTA15 = RI.LOTA15 AND S.SKUKEY = RI.SKUKEY AND RI.STATIT = 'FRV' AND S.SEBELN = RI.SEBELN)  AS RECDI_CRETIM 
		  FROM STKKY S
		  INNER JOIN SKUMA M ON (S.OWNRKY = M.OWNRKY AND S.SKUKEY = M.SKUKEY) 
		  
		  WHERE 1=1
		   AND S.QTSIWH - (S.QTSALO + S.QTSBLK) > 0
		   AND S.QTSIWH - (S.QTSPMO + S.QTSBLK) > 0
		   AND S.AREAKY NOT IN ('SYS', 'SHP','CRT','RTS')
		   <if test="WAREKY != null and WAREKY != ''">AND S.WAREKY = #{WAREKY}</if>
		   <if test="OWNRKY != null and OWNRKY != ''">AND S.OWNRKY = #{OWNRKY}</if>
		   <if test="PLNTKY != null and PLNTKY != ''">AND S.LOTA02 = #{PLNTKY}</if>
		   <if test="LOTA06 != null and LOTA06 != ''">AND S.LOTA06 = #{LOTA06}</if>
		   <if test="BARCOD != null and BARCOD != ''">AND S.LOTA14 = #{BARCOD}</if>
		   <if test="SEBELN != null and SEBELN != ''">AND S.SEBELN = #{SEBELN}</if>
		   <if test="STOKKY != null and STOKKY != ''">AND S.STOKKY = #{STOKKY}</if>
		   <if test="SKUG01 != null and SKUG01 != ''">AND M.SKUG01 = #{SKUG01}</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
		   <if test="LOCAKY != null and LOCAKY != ''">AND S.LOCAKY = #{LOCAKY}</if><!-- PDA -->
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(S.DESC01) LIKE '%'|| UPPER(#{DESC01}) || '%'</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
	     )
		   SELECT S.*,
		           CASE WHEN S.QTSIWH = 0 OR UOMKEY != 'BAG' THEN 0 
					   ELSE QTSIWH/  NVL((TRIM(SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.QTSIWH, S.UOMKEY, 'BOX'))),'0') END AS STKBOXQT ,
		   		  CASE WHEN S.USEQTY = 0  OR UOMKEY != 'BAG'  THEN 0 
					   ELSE USEQTY/ NVL((TRIM(SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.USEQTY, S.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(S.WAREKY, S.SKUKEY, S.USEQTY, S.UOMKEY, 'BOX'))),'0') END AS USEBOXQT   
			FROM STKItem S		   
		<!-- <include refid="STKKY_BASE"/> -->
	</select>
	
	<!-- SJ03 LOTA01(저장위치) validate -->
	<select id="LOTA01val_MAP" parameterType="Map" resultType="DataMap">
		SELECT WAREKY, OWNRKY, PLNTKY, STLKY, STLNM, WMSMAK
		FROM STLMA
		WHERE WMSMAK = 'V'
		  AND WAREKY = #{WAREKY}
		  AND PLNTKY = #{PLNTKY}
		  AND STLKY  = #{STLKY }
	</select>
	
	<!-- SJ18 -->
	<select id="SJ18Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.*
			 , SUBSTR(TB.LOTA07, 1, 10) AS SALENO
			 , SUBSTR(TB.LOTA07, 11   ) AS SKUNUM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = TB.LOTA09 AND PTNRTY = 'CT') AS LOTA09NM
			 , ' ' AS ALOTA09NM
			 , ' ' AS ASALENO
			 , ' ' AS ASKUNUM
			 , ' ' AS SBWART
		 FROM (
			<include refid="STKKY_BASE"/>
		) TB
	</select>
	
	<!-- SJ18 -->
	<select id="SHPDI_LOTA09_MAP" parameterType="Map" resultType="DataMap">
		SELECT LOTA09 AS LOTA09
		  FROM SHPDI SI
		 WHERE LOTA07 = #{LOTA07}
		   AND SKUKEY = #{SKUKEY}
		   AND ROWNUM = 1
	</select>
	
	<!-- SJ18 -->
	<select id="BZBTN_NAME_MAP" parameterType="Map" resultType="DataMap">
		SELECT NAME01 AS LOTA09NM
		  FROM BZPTN
		 WHERE PTNRKY = #{LOTA09}
		   AND PTNRTY = 'CT'
	</select>
	
	<select id="STLMA_LIST" parameterType="Map" resultType="DataMap">
		SELECT WAREKY
			 , OWNRKY
			 , PLNTKY
			 , STLKY
			 , STLNM
			 , WMSMAK
		FROM STLMA
		WHERE 1=1 
		  AND WMSMAK = 'V'
		  AND WAREKY = #{WAREKY}
	</select>
	
	<update id="ADJDH_UPDATE" parameterType="Map">
		INSERT INTO ADJDH (
			 SADJKY,WAREKY,ADJUTY,DOCDAT,DOCCAT,ADJUCA,DOCTXT
			,CREDAT,CRETIM,CREUSR
			,LMODAT,LMOTIM,LMOUSR
			,ADJFLG
			,REFCKY,REFCDT
			,SAPIFYN
		) VALUES (
			 #{SADJKY},#{WAREKY},#{ADJUTY},#{DOCDAT},#{DOCCAT},#{ADJUCA},#{DOCTXT}
			,TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}
			,TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}
			,NVL(#{ADJFLG}, ' ')
			,NVL(#{REFCKY}, ' '),DECODE(NVL(#{REFCKY}, ' '), ' ', ' ', TO_CHAR(SYSDATE, 'YYYYMMDD'))
			,NVL(#{SAPIFYN}, ' ')
		)
	</update>

	<insert id="ADJDIOLD_INSERT" parameterType="Map">
		INSERT INTO ADJDI (
			 SADJKY,SADJIT
			,LOTA01,LOTA02,LOTA03,LOTA04,LOTA05,LOTA06,LOTA07,LOTA08,LOTA09,LOTA10
			,LOTA11,LOTA12,LOTA13,LOTA14,LOTA15,LOTA16,LOTA17,LOTA18,LOTA19,LOTA20
			,ASKU01,ASKU02,ASKU03,ASKU04,ASKU05,SKUG01,SKUG02,SKUG03,SKUG04,SKUG05
			,RSNADJ,STOKKY,LOTNUM,LOCAKY,TRNUID,SECTID,PACKID
			,QTADJU,QTYUOM,TRUNTY,MEASKY,UOMKEY,QTPUOM,DUOMKY,QTDUOM
			,REFDKY,REFDIT,REFCAT,OWNRKY,SKUKEY,DESC01,DESC02
			,AWMSNO,AREAKY,EANCOD,GTINCD,GRSWGT,NETWGT,WGTUNT,LENGTH,WIDTHW,HEIGHT,CUBICM,CAPACT
			,SMANDT,SEBELN,SEBELP,SZMBLNO,SZMIPNO,STRAID,SVBELN,SPOSNR,STKNUM
			,STPNUM,SWERKS,SLGORT,SDATBG,STDLNR,SSORNU,SSORIT,SMBLNR,SZEILE
			,SMJAHR,SXBLNR,SAPSTS,ADJRSN,RELRSN,RELDAT,RELUSR
			,CREDAT,CRETIM,CREUSR
			,LMODAT,LMOTIM,LMOUSR
			,REFSTK
		) VALUES (
			 #{SADJKY},#{SADJIT}
			,#{LOTA01},#{LOTA02},#{LOTA03},#{LOTA04},#{LOTA05},#{LOTA06},#{LOTA07},#{LOTA08},#{LOTA09},#{LOTA10}
			,#{LOTA11},#{LOTA12},#{LOTA13},#{LOTA14},#{LOTA15},#{LOTA16},#{LOTA17},#{LOTA18},#{LOTA19},#{LOTA20}
			,#{ASKU01},#{ASKU02},#{ASKU03},#{ASKU04},#{ASKU05},#{SKUG01},#{SKUG02},#{SKUG03},#{SKUG04},#{SKUG05}
			,#{ARSNADJ},#{STOKKY},#{LOTNUM},#{LOCAKY},#{TRNUID},#{SECTID},#{PACKID}
			,#{QTADJU},#{QTADJU},#{TRUNTY},#{MEASKY},#{UOMKEY},#{QTPUOM},#{DUOMKY},#{QTDUOM}
			,#{REFDKY},#{REFDIT},#{REFCAT},#{OWNRKY},#{SKUKEY},#{DESC01},#{DESC02}
			,#{AWMSNO},#{AREAKY},#{EANCOD},#{GTINCD},#{GRSWGT},#{NETWGT},#{WGTUNT},#{LENGTH},#{WIDTHW},#{HEIGHT},#{CUBICM},#{CAPACT}
			,#{SMANDT},#{SEBELN},#{SEBELP},#{SZMBLNO},#{SZMIPNO},#{STRAID},#{SVBELN},#{SPOSNR},#{STKNUM}
			,#{STPNUM},#{SWERKS},#{SLGORT},#{SDATBG},#{STDLNR},#{SSORNU},#{SSORIT},#{SMBLNR},#{SZEILE}
			,#{SMJAHR},#{SXBLNR},#{SAPSTS},' ',#{RELRSN},TO_CHAR(SYSDATE, 'YYYYMMDD'),NVL(#{RELUSR}, ' ')
			,TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}
			,TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}
			,NVL(#{REFSTK},' ')
		)
	</insert>
	
	<select id="WHTRH_ADJDI_LOTA06_00_INFO_MAP" parameterType="Map" resultType="DataMap">
		SELECT *
		  FROM WHTRH
		 WHERE 1=1
		   AND TRNHTY = 'ADJU'
		   AND TASKTY = '402'
		   AND LOCAKY = #{LOCAKY}
		   AND SKUKEY = #{SKUKEY}
		   AND LOTA14 = #{LOTA14}
		   AND LOTA06 = '00'
		   AND ROWNUM = 1
		 ORDER BY CREDAT DESC, CRETIM DESC
	</select>
	
	<select id="ADJDI_LOTAT_LIST" parameterType="Map" resultType="DataMap">
		SELECT ST.STOKKY
			 , ST.LOTNUM
		FROM STKKY ST
		WHERE 1=1
		  AND ST.STOKKY != #{STOKKY}
		  AND ST.LOCAKY  = #{LOCAKY}
		  AND ST.LOTNUM IN (
			SELECT LT.LOTNUM
			  FROM LOTAT LT
			 WHERE 1=1
			   AND LT.LOTA01 = NVL(#{ALOTA01}, ' ')
			   AND LT.LOTA02 = NVL(#{ALOTA02}, ' ')
			   AND LT.LOTA03 = NVL(#{ALOTA03}, ' ')
			   AND LT.LOTA04 = NVL(#{ALOTA04}, ' ')
			   AND LT.LOTA05 = NVL(#{ALOTA05}, ' ')
			   AND LT.LOTA06 = NVL(#{ALOTA06}, ' ')
			   AND LT.LOTA07 = NVL(#{ALOTA07}, ' ')
			   AND LT.LOTA08 = NVL(#{ALOTA08}, ' ')
			   AND LT.LOTA09 = NVL(#{ALOTA09}, ' ')
			   AND LT.LOTA10 = NVL(#{ALOTA10}, ' ')
			   AND LT.LOTA11 = NVL(#{ALOTA11}, ' ')
			   AND LT.LOTA12 = NVL(#{ALOTA12}, ' ')
			   AND LT.LOTA13 = NVL(#{ALOTA13}, ' ')
			   AND LT.LOTA14 = NVL(#{ALOTA14}, ' ')
			   AND LT.LOTA15 = NVL(#{ALOTA15}, ' ')
			   AND LT.LOTA16 = NVL(#{ALOTA16}, ' ')
			   AND LT.LOTA17 = NVL(#{ALOTA17}, ' ')
			   AND LT.LOTA18 = NVL(#{ALOTA18}, ' ')
			   AND LT.LOTA19 = NVL(#{ALOTA19}, ' ')
			   AND LT.LOTA20 = NVL(#{ALOTA20}, ' ')
		  )
		ORDER BY CREDAT DESC, CRETIM DESC
	</select>
	
	<insert id="BARCODE_SEQ_INSERT" parameterType="Map">
		MERGE 
		 INTO BARCODE_SEQ A
		USING DUAL B
		   ON (A.CREDATE = TO_CHAR(SYSDATE,'YYYYMMDD'))
		 WHEN MATCHED THEN 
		      UPDATE
		      SET A.SEQNO = A.SEQNO+1
		 WHEN NOT MATCHED THEN 
		      INSERT (SEQNO, CREDATE) VALUES ('1', TO_CHAR(SYSDATE, 'YYYYMMDD'))
	</insert>
	
	<select id="BARCODE_SEQ_MAP" parameterType="Map" resultType="DataMap">
		SELECT * FROM BARCODE_SEQ
		 WHERE CREDATE = TO_CHAR(SYSDATE, 'YYYYMMDD')
	</select>
	
	<insert id="ADJDI_INSERT" parameterType="Map">
		INSERT INTO ADJDI (
			 SADJKY,SADJIT
			,LOTA01,LOTA02,LOTA03,LOTA04,LOTA05,LOTA06,LOTA07,LOTA08,LOTA09,LOTA10
			,LOTA11,LOTA12,LOTA13,LOTA14,LOTA15,LOTA16,LOTA17,LOTA18,LOTA19,LOTA20
			,ASKU01,ASKU02,ASKU03,ASKU04,ASKU05,SKUG01,SKUG02,SKUG03,SKUG04,SKUG05
			,RSNADJ,STOKKY,LOTNUM,LOCAKY,TRNUID,SECTID,PACKID
			,QTADJU,QTYUOM,TRUNTY,MEASKY,UOMKEY,QTPUOM,DUOMKY,QTDUOM
			,REFDKY,REFDIT,REFCAT,OWNRKY,SKUKEY
			,AWMSNO,AREAKY,DESC01,DESC02,EANCOD,GTINCD,GRSWGT,NETWGT,WGTUNT,LENGTH,WIDTHW,HEIGHT,CUBICM,CAPACT
			,SMANDT,SEBELN,SEBELP,SZMBLNO,SZMIPNO,STRAID,SVBELN,SPOSNR,STKNUM
			,STPNUM,SWERKS,SLGORT,SDATBG,STDLNR,SSORNU,SSORIT,SMBLNR,SZEILE,SMJAHR,SXBLNR,SAPSTS
			,ADJRSN,RELRSN,RELDAT,RELUSR
			,CREDAT,CRETIM,CREUSR
			,LMODAT,LMOTIM,LMOUSR
			,REFSTK
		) VALUES (
			 #{SADJKY},#{SADJIT}
			,#{ALOTA01},#{ALOTA02},#{ALOTA03},#{ALOTA04},#{ALOTA05},#{ALOTA06},#{ALOTA07},#{ALOTA08},#{ALOTA09},#{ALOTA10}
			,#{ALOTA11},#{ALOTA12},#{ALOTA13},#{ALOTA14},#{ALOTA15},#{ALOTA16},#{ALOTA17},#{ALOTA18},#{ALOTA19},#{ALOTA20}
			,#{AASKU01},#{AASKU02},#{AASKU03},#{AASKU04},#{AASKU05},#{SKUG01},#{SKUG02},#{SKUG03},#{SKUG04},#{SKUG05}
			,#{ARSNADJ},#{STOKKY},#{LOTNUM},#{ALOCAKY},#{ATRNUID},#{SECTID},#{PACKID}
			,#{QTADJU},#{QTADJU},#{TRUNTY},#{ASKUKEY},#{UOMKEY},#{QTPUOM},#{DUOMKY},#{QTDUOM}
			,#{REFDKY},#{REFDIT},#{REFCAT},#{OWNRKY},#{ASKUKEY}
			,#{AWMSNO},#{AAREAKY},#{DESC01},#{DESC02},#{EANCOD},#{GTINCD},#{GRSWGT},#{NETWGT},#{WGTUNT},#{LENGTH},#{WIDTHW},#{HEIGHT},#{CUBICM},#{CAPACT}
			,#{SMANDT},#{SEBELN},#{SEBELP},#{SZMBLNO},#{SZMIPNO},#{STRAID},#{SVBELN},#{SPOSNR},#{STKNUM}
			,#{STPNUM},#{SWERKS},#{SLGORT},#{SDATBG},#{STDLNR},#{SSORNU},#{SSORIT},#{SMBLNR},#{SZEILE},#{SMJAHR},#{SXBLNR},#{SAPSTS}
			,NVL(#{AADJRSN}, ' '),#{RELRSN},TO_CHAR(SYSDATE, 'YYYYMMDD'),NVL(#{RELUSR}, ' ')
			,TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}
			,TO_CHAR(SYSDATE, 'YYYYMMDD'),TO_CHAR(SYSDATE, 'HH24MISS'),#{SES_USER_ID}
			,NVL(#{REFSTK},' ')
		)
	</insert>
	
	<select id="ADJDH_LIST" parameterType="Map" resultType="DataMap">
		SELECT SADJKY
			 , ADJUTY
			 , DOCDAT
			 , DOCTXT
			 , INDBZL
			 , INDARC
			 , UPDCHK
			 , ADJUCA, (SELECT SHORTX FROM DOCTM WHERE DOCUTY = H.ADJUCA) AS ADJUCANM
			 , DOCCAT, (SELECT SHORTX FROM DOCCM WHERE DOCCAT = H.DOCCAT) AS DOCCATNM
			 , WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = H.WAREKY) AS WAREKYNM
			 , CREDAT, CRETIM, CREUSR, (SELECT NMLAST FROM USRMA WHERE USERID = CREUSR AND ROWNUM = 1) AS CUSRNM
			 , LMODAT, LMOTIM, LMOUSR, (SELECT NMLAST FROM USRMA WHERE USERID = LMOUSR AND ROWNUM = 1) AS LUSRNM
		  FROM ADJDH H
		 WHERE SADJKY = #{SADJKY}
	</select>
	
	<select id="ADJDI_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.SADJKY
			 , A.SADJIT
			 , A.RSNADJ
			 , A.STOKKY
			 , A.LOTNUM
			 , A.LOCAKY
			 , A.TRNUID
			 , A.SECTID
			 , A.PACKID
			 , A.QTADJU
			 , A.QTBLKD
			 , A.QTYUOM
			 , A.TRUNTY
			 , A.MEASKY
			 , A.UOMKEY
			 , A.QTPUOM
			 , A.DUOMKY
			 , A.QTDUOM
			 , A.SUBSIT
			 , A.SUBSFL
			 , A.REFDKY
			 , A.REFDIT
			 , A.REFCAT
			 , A.OWNRKY
			 , A.SKUKEY
			 , A.LOTA01, A.LOTA02, A.LOTA03, A.LOTA04, A.LOTA05
			 , A.LOTA06, A.LOTA07, A.LOTA08, A.LOTA09, A.LOTA10
			 , A.LOTA11, A.LOTA12, A.LOTA13, A.LOTA14, A.LOTA15
			 , A.LOTA16, A.LOTA17, A.LOTA18, A.LOTA19, A.LOTA20
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'DP' AND PTNRKY = A.LOTA02) AS LOTA02NM
			 , A.AWMSNO
			 , A.AREAKY
			 , A.DESC01
			 , A.DESC02
			 , A.EANCOD
			 , A.GTINCD
			 , A.ASKU01, A.ASKU02, A.ASKU03, A.ASKU04, A.ASKU05
			 , A.SKUG01, A.SKUG02, A.SKUG03, A.SKUG04, A.SKUG05
			 , A.GRSWGT
			 , A.NETWGT
			 , A.WGTUNT
			 , A.LENGTH
			 , A.WIDTHW
			 , A.HEIGHT
			 , A.CUBICM
			 , A.CAPACT
			 , A.WORKID
			 , A.WORKNM
			 , A.HHTTID
			 , A.SMANDT
			 , A.SEBELN
			 , A.SEBELP
			 , A.SZMBLNO
			 , A.SZMIPNO
			 , A.STRAID
			 , A.SVBELN
			 , A.SPOSNR
			 , A.STKNUM
			 , A.STPNUM
			 , A.SWERKS
			 , A.SLGORT
			 , A.SDATBG
			 , A.STDLNR
			 , A.SSORNU
			 , A.SSORIT
			 , A.SMBLNR
			 , A.SZEILE
			 , A.SMJAHR
			 , A.SXBLNR
			 , A.SAPSTS
			 , A.SBKTXT
			 , A.ADJRSN
			 , A.RELRSN
			 , A.RELDAT
			 , A.RELUSR
			 , A.SADJKY AS ASADJKY
			 , A.SADJIT AS ASADJIT
			 , A.RSNADJ AS ARSNADJ
			 , A.STOKKY AS ASTOKKY
			 , A.LOTNUM AS ALOTNUM
			 , A.LOCAKY AS ALOCAKY
			 , A.TRNUID AS ATRNUID
			 , A.SECTID AS ASECTID
			 , A.PACKID AS APACKID
			 , A.QTADJU AS AQTADJU
			 , A.QTBLKD AS AQTBLKD
			 , A.QTYUOM AS AQTYUOM
			 , A.TRUNTY AS ATRUNTY
			 , A.MEASKY AS AMEASKY
			 , A.UOMKEY AS AUOMKEY
			 , A.QTPUOM AS AQTPUOM
			 , A.DUOMKY AS ADUOMKY
			 , A.QTDUOM AS AQTDUOM
			 , A.SUBSIT AS ASUBSIT
			 , A.SUBSFL AS ASUBSFL
			 , A.REFDKY AS AREFDKY
			 , A.REFDIT AS AREFDIT
			 , A.REFCAT AS AREFCAT
			 , A.OWNRKY AS AOWNRKY
			 , A.SKUKEY AS ASKUKEY
			 , A.LOTA01 AS ALOTA01, A.LOTA02 AS ALOTA02, A.LOTA03 AS ALOTA03, A.LOTA04 AS ALOTA04, A.LOTA05 AS ALOTA05
			 , A.LOTA06 AS ALOTA06, A.LOTA07 AS ALOTA07, A.LOTA08 AS ALOTA08, A.LOTA09 AS ALOTA09, A.LOTA10 AS ALOTA10
			 , A.LOTA11 AS ALOTA11, A.LOTA12 AS ALOTA12, A.LOTA13 AS ALOTA13, A.LOTA14 AS ALOTA14, A.LOTA15 AS ALOTA15
			 , A.LOTA16 AS ALOTA16, A.LOTA17 AS ALOTA17, A.LOTA18 AS ALOTA18, A.LOTA19 AS ALOTA19, A.LOTA20 AS ALOTA20
			 , A.AWMSNO AS AAWMSNO
			 , A.AREAKY AS AAREAKY
			 , A.DESC01 AS ADESC01
			 , A.DESC02 AS ADESC02
			 , A.ASKU01 AS AASKU01, A.ASKU02 AS AASKU02, A.ASKU03 AS AASKU03, A.ASKU04 AS AASKU04, A.ASKU05 AS AASKU05
			 , A.EANCOD AS AEANCOD
			 , A.GTINCD AS AGTINCD
			 , A.SKUG01 AS ASKUG01, A.SKUG02 AS ASKUG02, A.SKUG03 AS ASKUG03, A.SKUG04 AS ASKUG04, A.SKUG05 AS ASKUG05
			 , A.GRSWGT AS AGRSWGT
			 , A.NETWGT AS ANETWGT
			 , A.WGTUNT AS AWGTUNT
			 , A.LENGTH AS ALENGTH
			 , A.WIDTHW AS AWIDTHW
			 , A.HEIGHT AS AHEIGHT
			 , A.CUBICM AS ACUBICM
			 , A.CAPACT AS ACAPACT
			 , A.WORKID AS AWORKID
			 , A.WORKNM AS AWORKNM
			 , A.HHTTID AS AHHTTID
			 , A.SMANDT AS ASMANDT
			 , A.SEBELN AS ASEBELN
			 , A.SEBELP AS ASEBELP
			 , A.SZMBLNO AS ASZMBLNO
			 , A.SZMIPNO AS ASZMIPNO
			 , A.STRAID AS ASTRAID
			 , A.SVBELN AS ASVBELN
			 , A.SPOSNR AS ASPOSNR
			 , A.STKNUM AS ASTKNUM
			 , A.STPNUM AS ASTPNUM
			 , A.SWERKS AS ASWERKS
			 , A.SLGORT AS ASLGORT
			 , A.SDATBG AS ASDATBG
			 , A.STDLNR AS ASTDLNR
			 , A.SSORNU AS ASSORNU
			 , A.SSORIT AS ASSORIT
			 , A.SMBLNR AS ASMBLNR
			 , A.SZEILE AS ASZEILE
			 , A.SMJAHR AS ASMJAHR
			 , A.SXBLNR AS ASXBLNR
			 , A.SAPSTS AS ASAPSTS
			 , A.SBKTXT AS ASBKTXT
			 , A.ADJRSN AS AADJRSN
			 , A.RELRSN AS ARELRSN
			 , A.RELDAT AS ARELDAT
			 , A.RELUSR AS ARELUSR
			 , A.CREDAT, A.CRETIM, A.CREUSR
			 , A.LMODAT, A.LMOTIM, A.LMOUSR
			 , A.INDBZL
			 , A.INDARC
			 , A.UPDCHK
			 , M.SKUL01
			 , (SELECT STLNM FROM STLMA WHERE STLKY  = A.LOTA01 AND PLNTKY = A.LOTA02) AS LOTA01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', M.SKUL01) AS SKUL01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', A.LOTA06) AS LOTA06NM
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(#{WAREKY}, A.SKUKEY, 0, A.UOMKEY, 'KG') FROM DUAL)), 0) AS TOTWG /* 총중량        */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(#{WAREKY}, A.SKUKEY, 0, A.UOMKEY, 'BAG') FROM DUAL)), 0) AS BAGQT /* EA/BAG      */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(#{WAREKY}, A.SKUKEY, 0, A.UOMKEY, 'BOX') FROM DUAL)), 0) AS BOXQT /* BAG/BOX     */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(#{WAREKY}, A.SKUKEY, 0, A.UOMKEY, 'PAL') FROM DUAL)), 0) AS PLTQT /* BOX/Pallet  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(#{WAREKY}, A.SKUKEY, 0, A.UOMKEY, 'SOK') FROM DUAL)), 0) AS SOKQT /* 속(개/BALE)  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(#{WAREKY}, A.SKUKEY, 0, A.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , '0' AS QTSBLK
			 , ' ' AS BATMNG
			 , ' ' AS ABATMNG
			 , QTADJU AS QTSIWH
			 , 0   AS USEQTY
			 /* S.SJ18 */
			 , (SELECT STLNM  FROM STLMA WHERE STLKY  = A.LOTA01 AND PLNTKY = A.LOTA02) AS LOTA01NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = A.LOTA09 AND PTNRTY = 'CT')     AS LOTA09NM
			 , REPLACE(A.LOTA07, SUBSTR(A.LOTA07, -6)) AS SALENO
			 , NVL(SUBSTR(A.LOTA07, -6), '0')          AS SKUNUM
			 , (SELECT STLNM  FROM STLMA WHERE STLKY  = A.LOTA01 AND PLNTKY = A.LOTA02) AS ALOTA01NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = A.LOTA09 AND PTNRTY = 'CT')     AS ALOTA09NM
			 , REPLACE(A.LOTA07, SUBSTR(A.LOTA07, -6)) AS ASALENO
			 , NVL(SUBSTR(A.LOTA07, -6), '0')          AS ASKUNUM
			 /* E.SJ18 */
		 FROM ADJDI A
			, SKUMA M
		 WHERE 1=1
			AND A.OWNRKY = M.OWNRKY
			AND A.SKUKEY = M.SKUKEY
			AND A.SADJKY = #{SADJKY}
		<if test="SADJIT != null and SADJIT != ''">
			AND A.SADJIT = #{SADJIT}
		 </if>
	</select>
	
	<select id="SJ09_HEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT AH.SADJKY
			 , AH.DOCDAT
			 , AH.DOCTXT
			 , AH.DOCCAT AS DOCCAT, SZF_GET_DOCCAT_TEXT(#{LANGKY}, AH.DOCCAT) AS DOCCATNM
			 , AH.ADJUTY AS DOCUTY, SZF_GET_DOCUTY_TEXT(#{LANGKY}, AH.ADJUTY) AS DOCUTYNM
			 , AH.WAREKY AS WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = AH.WAREKY),' ') AS WARENM
			 , AH.CREDAT, AH.CRETIM, AH.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = AH.CREUSR),' ') AS CUSRNM
			 , AH.LMODAT, AH.LMOTIM, AH.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = AH.LMOUSR),' ') AS LUSRNM
			 , AH.REFCKY, AH.ADJFLG, AH.CANCEL
		  FROM ADJDH AH
		  INNER JOIN ADJDI AI ON AI.SADJKY = AH.SADJKY
		  INNER JOIN SKUMA SM ON SM.OWNRKY = AI.OWNRKY AND SM.SKUKEY = AI.SKUKEY
		  INNER JOIN LOCMA LM ON LM.WAREKY = AH.WAREKY AND LM.LOCAKY = AI.LOCAKY
		 WHERE 1 = 1
		   AND AH.WAREKY = #{WAREKY}
		   AND AI.OWNRKY = #{OWNRKY}
		   AND AH.ADJUTY IN (SELECT DOCUTY FROM DOCPG WHERE PROGID = #{PROGID})
		   <if test="ADJUTY != null and ADJUTY != ''">AND AH.ADJUTY = #{ADJUTY}</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		   <if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(AI.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		 GROUP BY AH.SADJKY
				, AH.WAREKY
				, AH.DOCDAT
				, AH.DOCCAT
				, AH.ADJUTY
				, AI.OWNRKY
				, AH.CREDAT
				, AH.CRETIM
				, AH.CREUSR
				, AH.LMODAT
				, AH.LMOTIM
				, AH.LMOUSR
				, AH.DOCTXT
				, AH.REFCKY
				, AH.ADJFLG
				, AH.CANCEL
		 ORDER BY AH.SADJKY DESC
	</select>
	
	<select id="CANCEL_ADJUST_LIST" parameterType="Map" resultType="DataMap">
		SELECT AI.SADJKY, AI.SADJIT
			 , AI.RSNADJ
			 , AI.STOKKY
			 , AI.LOTNUM
			 , AI.LOCAKY
			 , AI.TRNUID
			 , AI.SECTID
			 , AI.PACKID
			 , AI.QTADJU * -1 AS QTADJU
			 , AI.QTADJU * -1 AS AQTADJU
			 , AI.QTBLKD
			 , AI.QTYUOM * -1 AS QTYUOM
			 , AI.TRUNTY
			 , AI.MEASKY
			 , AI.UOMKEY
			 , AI.QTPUOM
			 , AI.DUOMKY
			 , AI.QTDUOM
			 , AI.SUBSIT
			 , AI.SUBSFL
			 , AI.REFDKY
			 , AI.REFDIT
			 , AI.REFCAT
			 , AI.OWNRKY
			 , AI.SKUKEY
			 , AI.LOTA01, AI.LOTA02, AI.LOTA03, AI.LOTA04, AI.LOTA05
			 , AI.LOTA06, AI.LOTA07, AI.LOTA08, AI.LOTA09, AI.LOTA10
			 , AI.LOTA11, AI.LOTA12, AI.LOTA13, AI.LOTA14, AI.LOTA15
			 , AI.LOTA16, AI.LOTA17, AI.LOTA18, AI.LOTA19, AI.LOTA20
			 , AI.AWMSNO, AI.AREAKY, AI.DESC01, AI.DESC02
			 , AI.ASKU01, AI.ASKU02, AI.ASKU03, AI.ASKU04, AI.ASKU05
			 , AI.EANCOD, AI.GTINCD
			 , AI.SKUG01, AI.SKUG02, AI.SKUG03, AI.SKUG04, AI.SKUG05
			 , AI.GRSWGT, AI.NETWGT, AI.WGTUNT, AI.LENGTH, AI.WIDTHW
			 , AI.HEIGHT, AI.CUBICM, AI.CAPACT, AI.WORKID, AI.WORKNM
			 , AI.HHTTID, AI.SMANDT, AI.SEBELN, AI.SEBELP, AI.SZMBLNO, AI.SZMIPNO
			 , AI.STRAID, AI.SVBELN, AI.SPOSNR, AI.STKNUM, AI.STPNUM
			 , AI.SWERKS, AI.SLGORT, AI.SDATBG, AI.STDLNR, AI.SSORNU
			 , AI.SSORIT, AI.SMBLNR, AI.SZEILE, AI.SMJAHR, AI.SXBLNR
			 , AI.SAPSTS, AI.SBKTXT, AI.ADJRSN
			 , AI.RELRSN, AI.RELDAT, AI.RELUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
			 , AI.INDBZL, AI.INDARC, AI.UPDCHK
			 , AI.REFSTK
			 , ST.QTSIWH
			 , ' ' AS ADJRSN
			 , ' ' AS RELRSN
			 , ' ' AS RSNADJ
			 , ' ' AS ARSNADJ
			 , AI.SKUKEY AS ASKUKEY
			 , AI.SKUKEY AS ASKUKEY
			 , AI.TRNUID AS ATRNUID
			 , AI.LOTNUM AS ALOTNUM
			 , AI.LOCAKY AS ALOCAKY
			 , AI.AREAKY AS AAREAKY
		FROM ADJDI AI
		LEFT JOIN STKKY ST ON AI.STOKKY = ST.STOKKY AND ST.QTSALO = 0 AND ST.QTSPMO = 0 AND ST.QTSPMI = 0 AND ST.QTSBLK = 0
		WHERE AI.SADJKY = #{SADJKY}
		ORDER BY AI.SADJKY DESC, AI.SADJIT DESC, AI.CREDAT DESC, AI.CRETIM DESC
	</select>
	
	<select id="CANCEL_ADJUST_WMSONLY_LIST" parameterType="Map" resultType="DataMap">
		SELECT AI.SADJKY, AI.SADJIT
			 , AI.RSNADJ
			 , AI.STOKKY
			 , AI.LOTNUM
			 , AI.LOCAKY
			 , AI.TRNUID
			 , AI.SECTID
			 , AI.PACKID
			 , AI.QTADJU * -1 AS QTADJU
			 , AI.QTADJU * -1 AS AQTADJU
			 , AI.QTBLKD
			 , AI.QTYUOM * -1 AS QTYUOM
			 , AI.TRUNTY
			 , AI.MEASKY
			 , AI.UOMKEY
			 , AI.QTPUOM
			 , AI.DUOMKY
			 , AI.QTDUOM
			 , AI.SUBSIT
			 , AI.SUBSFL
			 , AI.REFDKY
			 , AI.REFDIT
			 , AI.REFCAT
			 , AI.OWNRKY
			 , AI.SKUKEY
			 , AI.LOTA01, AI.LOTA02, AI.LOTA03, AI.LOTA04, AI.LOTA05
			 , AI.LOTA06, AI.LOTA07, AI.LOTA08, AI.LOTA09, AI.LOTA10
			 , AI.LOTA11, AI.LOTA12, AI.LOTA13, AI.LOTA14, AI.LOTA15
			 , AI.LOTA16, AI.LOTA17, AI.LOTA18, AI.LOTA19, AI.LOTA20
			 , AI.AWMSNO, AI.AREAKY, AI.DESC01, AI.DESC02
			 , AI.ASKU01, AI.ASKU02, AI.ASKU03, AI.ASKU04, AI.ASKU05
			 , AI.EANCOD, AI.GTINCD
			 , AI.SKUG01, AI.SKUG02, AI.SKUG03, AI.SKUG04, AI.SKUG05
			 , AI.GRSWGT, AI.NETWGT, AI.WGTUNT, AI.LENGTH, AI.WIDTHW
			 , AI.HEIGHT, AI.CUBICM, AI.CAPACT, AI.WORKID, AI.WORKNM
			 , AI.HHTTID, AI.SMANDT, AI.SEBELN, AI.SEBELP, AI.SZMBLNO, AI.SZMIPNO
			 , AI.STRAID, AI.SVBELN, AI.SPOSNR, AI.STKNUM, AI.STPNUM
			 , AI.SWERKS, AI.SLGORT, AI.SDATBG, AI.STDLNR, AI.SSORNU
			 , AI.SSORIT, AI.SMBLNR, AI.SZEILE, AI.SMJAHR, AI.SXBLNR
			 , AI.SAPSTS, AI.SBKTXT, AI.ADJRSN
			 , AI.RELRSN, AI.RELDAT, AI.RELUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
			 , AI.INDBZL, AI.INDARC, AI.UPDCHK
			 , AI.REFSTK
			 , ST.QTSIWH
			 , ' ' AS ADJRSN
			 , ' ' AS RELRSN
			 , ' ' AS RSNADJ
			 , ' ' AS ARSNADJ
			 , AI.SKUKEY AS ASKUKEY
			 , AI.SKUKEY AS ASKUKEY
			 , AI.TRNUID AS ATRNUID
			 , AI.LOTNUM AS ALOTNUM
			 , AI.LOCAKY AS ALOCAKY
			 , AI.AREAKY AS AAREAKY
		FROM ADJDI AI
		LEFT JOIN STKKY ST ON AI.STOKKY = ST.STOKKY AND ST.QTSALO = 0 AND ST.QTSPMO = 0 AND ST.QTSPMI = 0 AND ST.QTSBLK = 0
		WHERE AI.SADJKY = #{SADJKY}
		  AND AI.SADJIT IN (SELECT X.SADJIT
		                      FROM ADJDI X
		                      LEFT JOIN IFWMS223 X1 ON X1.SADJKY = X.SADJKY AND X1.SADJIT = X.SADJIT AND X1.PRCFLG = 'E'
		                      LEFT JOIN IFWMS223 X2 ON X2.SADJKY = X.SADJKY AND LPAD(X2.SADJIT - 10,6,'0') = X.SADJIT AND X2.PRCFLG = 'E'
		                     WHERE X.SADJKY = #{SADJKY}
		                       AND (NVL(X1.SADJIT,' ') != ' ' OR NVL(X2.SADJIT,' ') != ' ')
		                    )
		ORDER BY AI.SADJKY DESC, AI.SADJIT DESC, AI.CREDAT DESC, AI.CRETIM DESC
	</select>
	
	<update id="ADJDH_CANCEL_UPDATE" parameterType="Map">
		UPDATE ADJDH
		   SET CANCEL = 'V'
		 WHERE SADJKY = #{SADJKY}
	</update>
	
	<select id="SJ09_ITEM_LIST" parameterType="Map" resultType="DataMap">
		SELECT AH.SADJKY, AI.SADJIT
			 , AH.WAREKY
			 , LM.AREAKY
			 , LM.ZONEKY
			 , AI.LOCAKY
			 , AI.TRNUID
			 , AI.OWNRKY
			 , AI.SKUKEY, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , AI.DESC01 AS DESC01
			 , AI.DESC02 AS DESC02
			 , SM.EANCOD
			 , AI.QTADJU
			 , SM.DUOMKY AS UOMKEY
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'KG') FROM DUAL)), 0) AS TOTWG /* 총중량        */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'BAG') FROM DUAL)), 0) AS BAGQT /* EA/BAG       */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'BOX') FROM DUAL)), 0) AS BOXQT /* BAG/BOX      */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'PAL') FROM DUAL)), 0) AS PLTQT /* BOX/Pallet   */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'SOK') FROM DUAL)), 0) AS SOKQT /* 속(개/BALE)  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , CASE WHEN AI.QTADJU = 0 THEN 0 
			 		ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'BOX'))),'0')  
		 		END AS BOXBAG
			 , AI.LOTA01, AI.LOTA02, AI.LOTA03, AI.LOTA04, AI.LOTA05
			 , AI.LOTA06, AI.LOTA07, AI.LOTA08, AI.LOTA09, AI.LOTA10
			 , AI.LOTA11, AI.LOTA12, AI.LOTA13, AI.LOTA14, AI.LOTA15
			 , AI.LOTA16, AI.LOTA17, AI.LOTA18, AI.LOTA19, AI.LOTA20
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', AI.LOTA06)             AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'CT' AND PTNRKY = AI.LOTA09) AS LOTA09NM
			 , AI.RSNADJ AS RSNCOD
			 , CASE WHEN TRIM(AI.RSNADJ) IS NULL THEN ' '
			        ELSE '[' || AI.RSNADJ || ']' || SZF_GET_RSNCOD_TEXT(#{LANGKY}, AI.OWNRKY, AH.DOCCAT, AH.ADJUTY, AI.RSNADJ)
			   END AS RSNCODNM
			 , AI.ADJRSN AS RSNTXT
			 , AI.CREDAT, AI.CRETIM, AI.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = AI.CREUSR),' ') AS CUSRNM
			 , AI.LMODAT, AI.LMOTIM, AI.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = AI.LMOUSR),' ') AS LUSRNM
		  FROM ADJDH AH
		  INNER JOIN ADJDI AI ON AI.SADJKY = AH.SADJKY
		  INNER JOIN SKUMA SM ON SM.OWNRKY = AI.OWNRKY AND SM.SKUKEY = AI.SKUKEY
		  INNER JOIN LOCMA LM ON LM.WAREKY = AH.WAREKY AND LM.LOCAKY = AI.LOCAKY
		 WHERE 1 = 1
		   AND AH.WAREKY = #{WAREKY}
		   AND AI.OWNRKY = #{OWNRKY}
		   AND AH.ADJUTY IN (SELECT DOCUTY FROM DOCPG WHERE PROGID = #{PROGID})
		   AND AH.SADJKY = #{SADJKY}
		   <if test="ADJUTY != null and ADJUTY != ''">AND AH.ADJUTY = #{ADJUTY}</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		   <if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(AI.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		 ORDER BY AH.SADJKY DESC, AI.SADJIT
	</select>
	
	<select id="SJ10_LIST" parameterType="Map" resultType="DataMap">
		SELECT AH.SADJKY, AI.SADJIT
			 , AH.DOCDAT
			 , AH.DOCTXT
			 , AH.DOCCAT AS DOCCAT, SZF_GET_DOCCAT_TEXT(#{LANGKY}, AH.DOCCAT) AS DOCCATNM
			 , AH.ADJUTY AS DOCUTY, SZF_GET_DOCUTY_TEXT(#{LANGKY}, AH.ADJUTY) AS DOCUTYNM
			 , AH.WAREKY AS WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = AH.WAREKY),' ') AS WARENM
			 , LM.AREAKY
			 , LM.ZONEKY
			 , AI.LOCAKY
			 , AI.TRNUID
			 , AI.OWNRKY
			 , AI.SKUKEY
			 , AI.SKUKEY, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , SZF_GET_SKU_DESC01_TEXT(#{LANGKY}, AI.OWNRKY, AI.SKUKEY) AS DESC01
			 , SZF_GET_SKU_DESC02_TEXT(#{LANGKY}, AI.OWNRKY, AI.SKUKEY) AS DESC02
			 , SM.EANCOD
			 , AI.QTADJU
			 , SM.DUOMKY AS UOMKEY
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'KG') FROM DUAL)), 0) AS TOTWG /* 총중량        */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'BAG') FROM DUAL)), 0) AS BAGQT /* EA/BAG       */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'BOX') FROM DUAL)), 0) AS BOXQT /* BAG/BOX      */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'PAL') FROM DUAL)), 0) AS PLTQT /* BOX/Pallet   */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'SOK') FROM DUAL)), 0) AS SOKQT /* 속(개/BALE)  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */	 
			 , CASE WHEN AI.QTADJU = 0 THEN 0 
			 		ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(AH.WAREKY, SM.SKUKEY, AI.QTADJU, SM.DUOMKY, 'BOX'))),'0') 	
		 		END AS BOXBAG
			 , AI.LOTA01, AI.LOTA02, AI.LOTA03, AI.LOTA04, AI.LOTA05
			 , AI.LOTA06, AI.LOTA07, AI.LOTA08, AI.LOTA09, AI.LOTA10
			 , AI.LOTA11, AI.LOTA12, AI.LOTA13, AI.LOTA14, AI.LOTA15
			 , AI.LOTA16, AI.LOTA17, AI.LOTA18, AI.LOTA19, AI.LOTA20
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', AI.LOTA06)             AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'CT' AND PTNRKY = AI.LOTA09) AS LOTA09NM
			 , AI.RSNADJ AS RSNCOD
			 , CASE WHEN TRIM(AI.RSNADJ) IS NULL THEN ' '
			        ELSE '[' || AI.RSNADJ || ']' || SZF_GET_RSNCOD_TEXT(#{LANGKY}, AI.OWNRKY, AH.DOCCAT, AH.ADJUTY, AI.RSNADJ)
			   END AS RSNCODNM
			 , AI.ADJRSN AS RSNTXT
			 , AI.CREDAT, AI.CRETIM, AI.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = AI.CREUSR),' ') AS CUSRNM
			 , AI.LMODAT, AI.LMOTIM, AI.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = AI.LMOUSR),' ') AS LUSRNM
		  FROM ADJDH AH
		  INNER JOIN ADJDI AI ON AI.SADJKY = AH.SADJKY
		  INNER JOIN SKUMA SM ON SM.OWNRKY = AI.OWNRKY AND SM.SKUKEY = AI.SKUKEY
		  INNER JOIN LOCMA LM ON LM.WAREKY = AH.WAREKY AND LM.LOCAKY = AI.LOCAKY
		 WHERE 1 = 1
		   AND AH.WAREKY = #{WAREKY}
		   AND AI.OWNRKY = #{OWNRKY}
		   AND AH.ADJUTY IN (SELECT DOCUTY FROM DOCPG WHERE PROGID = #{PROGID})
		   <if test="ADJUTY != null and ADJUTY != ''">AND AH.ADJUTY = #{ADJUTY}</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		   <if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(AI.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		 ORDER BY AH.SADJKY DESC, AI.SADJIT DESC
	</select>
	
	<sql id="PDSJ01_BASE">
		SELECT TB.LOTA14
			 , TB.AREAKY
			 , TB.ZONEKY
			 , TB.LOCAKY
			 , TB.LOTA02
			 , TB.LOTA06, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TB.LOTA06) AS LOTA06NM
			 , TB.QTSIWH
			 , TB.USEQTY
			 , TB.UOMKEY
			 , TB.UOMKEY AS AUOMKEY
			 , 'BOX' 	 AS BOXUOMKEY
			 , TB.SKUKEY
			 , SM.EANCOD AS AEANCOD
			 , TB.DESC01
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'KG' ) FROM DUAL)), 0) AS TOTWG /* 총중량        */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BAG') FROM DUAL)), 0) AS BAGQT /* EA/BAG      */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BOX') FROM DUAL)), 0) AS BOXQT /* BAG/BOX     */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY, 'BOX') FROM DUAL)), 0) AS BOXUQT/* BAG/BOX (가용) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'PAL') FROM DUAL)), 0) AS PLTQT /* BOX/Pallet  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'SOK') FROM DUAL)), 0) AS SOKQT /* 속(개/BALE)  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , TB.LOTA15
			 , TB.SKUG05 
			 , 0 AS AQTADJU
		FROM (
			SELECT ST.LOTA14
				 , ST.AREAKY
				 , ST.ZONEKY
				 , ST.LOCAKY
				 , ST.LOTA02
				 , ST.LOTA06
				 , ST.WAREKY
				 , ST.OWNRKY
				 , ST.SKUKEY
				 , ST.UOMKEY
				 , ST.DESC01
				 , SUM(ST.QTSIWH) AS QTSIWH
				 , SUM(
					ST.QTSIWH - ST.QTSBLK - GREATEST(ST.QTSALO, ST.QTSPMO)
							  - (CASE WHEN ST.LOTA06 IN ('00') OR ST.QTSPMO > 0 THEN 0 ELSE ST.QTSIWH END)
				   ) AS USEQTY
				 , ST.LOTA15
				 , ST.SKUG05 
			 FROM STKKY ST
			WHERE 1 = 1
			  AND ST.QTSIWH > 0
			  AND ST.QTSIWH - (ST.QTSALO + ST.QTSBLK) > 0
			  AND ST.QTSIWH - (ST.QTSPMO + ST.QTSBLK) > 0
			  AND ST.AREAKY NOT IN ('SYS', 'SHP','CRT','RTS')
			  <if test="WAREKY != null and WAREKY != ''">AND ST.WAREKY = #{WAREKY}</if>
			  <if test="BARCOD != null and BARCOD != ''">AND ST.LOTA14 = #{BARCOD}</if>
			  <if test="LOCAKY != null and LOCAKY != ''">AND ST.LOCAKY = #{LOCAKY}</if>
			  <if test="LOTA06 != null and LOTA06 != ''">AND ST.LOTA06 = #{LOTA06}</if>
			  <if test="LOTA02 != null and LOTA02 != ''">AND ST.LOTA02 = #{LOTA02}</if>
			GROUP BY ST.LOTA14
				   , ST.AREAKY
				   , ST.ZONEKY
				   , ST.LOCAKY
				   , ST.LOTA02
				   , ST.LOTA06
				   , ST.WAREKY
				   , ST.OWNRKY
				   , ST.SKUKEY
				   , ST.UOMKEY
				   , ST.DESC01
				   , ST.LOTA15
				   , ST.SKUG05 
		) TB
		INNER JOIN SKUMA SM ON SM.OWNRKY = TB.OWNRKY AND SM.SKUKEY = TB.SKUKEY
		WHERE 1=1
		<if test='SES_DEVICE_TYPE == "M"'>
			AND TB.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE})
		</if>
		ORDER BY TB.LOTA14, TB.LOTA02, TB.LOCAKY, TB.LOTA06
	</sql>
	
	<select id="PDSJ01LOC_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.AREAKY, TB.ZONEKY, TB.LOCAKY, TB.LOTA02 AS PLNTKY, COUNT(1) AS CNT
		  FROM (
			<include refid="PDSJ01_BASE"/>
		  ) TB
		WHERE 1=1
		GROUP BY TB.AREAKY, TB.ZONEKY, TB.LOCAKY, TB.LOTA02
		ORDER BY TB.AREAKY, TB.ZONEKY, TB.LOCAKY
	</select>

	<select id="PDSJ01_LIST" parameterType="Map" resultType="DataMap">
		<include refid="PDSJ01_BASE"/>
	</select>
	
	<select id="QTYUOM_MAP" parameterType="DataMap" resultType="DataMap">
		SELECT TO_NUMBER(#{QTYRCV}) AS QTYRCV, M1.UOMKEY AS UOMKEY
			 , M2.UOMKEY AS PALUOM
			 , M3.UOMKEY AS BOXUOM
			 , M4.UOMKEY AS BAGUOM
			 , M5.UOMKEY AS  EAUOM
			 , CASE WHEN M1.UOMKEY = 'PAL' THEN ROUND(TO_NUMBER(#{QTYRCV})                                    , 3)
			        WHEN M1.UOMKEY = 'BOX' THEN ROUND(TO_NUMBER(#{QTYRCV}) / M2.QTPUOM                        , 3)
			        WHEN M1.UOMKEY = 'BAG' THEN ROUND(TO_NUMBER(#{QTYRCV}) / M2.QTPUOM / M3.QTPUOM            , 3)
			        WHEN M1.UOMKEY = 'EA'  THEN ROUND(TO_NUMBER(#{QTYRCV}) / M2.QTPUOM / M1.QTAUOM            , 3)
			   END AS QTYPAL
			 , CASE WHEN M1.UOMKEY = 'PAL' THEN ROUND(TO_NUMBER(#{QTYRCV}) * M2.QTPUOM                        , 3)
			        WHEN M1.UOMKEY = 'BOX' THEN ROUND(TO_NUMBER(#{QTYRCV})                                    , 3)
			        WHEN M1.UOMKEY = 'BAG' THEN ROUND(TO_NUMBER(#{QTYRCV}) / M3.QTPUOM                        , 3)
			        WHEN M1.UOMKEY = 'EA'  THEN ROUND(TO_NUMBER(#{QTYRCV}) / M1.QTAUOM                        , 3)
			   END AS QTYBOX
			 , CASE WHEN M1.UOMKEY = 'PAL' THEN ROUND(TO_NUMBER(#{QTYRCV}) * M4.QTAUOM * M2.QTPUOM            , 3)
			        WHEN M1.UOMKEY = 'BOX' THEN ROUND(TO_NUMBER(#{QTYRCV}) * M4.QTPUOM * M3.QTPUOM            , 3)
			        WHEN M1.UOMKEY = 'BAG' THEN ROUND(TO_NUMBER(#{QTYRCV})                                    , 3)
			        WHEN M1.UOMKEY = 'EA'  THEN ROUND(TO_NUMBER(#{QTYRCV}) * M4.QTAUOM / M1.QTAUOM            , 3)
			   END AS QTYBAG
			 , CASE WHEN M1.UOMKEY = 'PAL' THEN ROUND(TO_NUMBER(#{QTYRCV}) * M5.QTAUOM * M4.QTAUOM * M2.QTPUOM, 3)
			        WHEN M1.UOMKEY = 'BOX' THEN ROUND(TO_NUMBER(#{QTYRCV}) * M5.QTAUOM * M4.QTAUOM            , 3)
			        WHEN M1.UOMKEY = 'BAG' THEN ROUND(TO_NUMBER(#{QTYRCV}) * M5.QTAUOM                        , 3)
			        WHEN M1.UOMKEY = 'EA'  THEN ROUND(TO_NUMBER(#{QTYRCV})                                    , 3)
			   END AS QTYEA
		FROM      MEASI M1
		LEFT JOIN MEASI M2 ON M2.WAREKY = M1.WAREKY AND M2.MEASKY = M1.MEASKY AND M2.UOMKEY = 'PAL'
		LEFT JOIN MEASI M3 ON M3.WAREKY = M1.WAREKY AND M3.MEASKY = M1.MEASKY AND M3.UOMKEY = 'BOX'
		LEFT JOIN MEASI M4 ON M4.WAREKY = M1.WAREKY AND M4.MEASKY = M1.MEASKY AND M4.UOMKEY = 'BAG'
		LEFT JOIN MEASI M5 ON M5.WAREKY = M1.WAREKY AND M5.MEASKY = M1.MEASKY AND M5.UOMKEY = 'EA'
		WHERE M1.MEASKY = #{SKUKEY}
		  AND M1.WAREKY = #{WAREKY}
		  AND M1.UOMKEY = #{UOMKEY}
	</select>
	
	<select id="PDSJ01_ADJ_TARGET_LIST" parameterType="Map" resultType="DataMap">
		SELECT #{SADJKY}                                                                AS SADJKY
			 , LPAD(TO_NUMBER(ROW_NUMBER() OVER(ORDER BY ST.STOKKY) * 20 - 10), 6, '0') AS SADJIT
			 , NVL(#{ARSNADJ}, ' ') AS RSNADJ
			 , NVL(#{AADJRSN}, ' ') AS AADJRSN
			 , ST.STOKKY AS STOKKY
			 , ST.LOTNUM AS LOTNUM
			 , ST.QTSIWH AS QTADJU
			 , 0         AS QTBLKD
			 , ST.QTSIWH AS QTYUOM
			 , ST.DESC01
			 , ST.DESC02
			 , ST.LOTA01, ST.LOTA02, ST.LOTA03, ST.LOTA04, ST.LOTA05
			 , ST.LOTA06, ST.LOTA07, ST.LOTA08, ST.LOTA09, ST.LOTA10
			 , ST.LOTA11, ST.LOTA12, ST.LOTA13, ST.LOTA14, ST.LOTA15
			 , ST.LOTA16, ST.LOTA17, ST.LOTA18, ST.LOTA19, ST.LOTA20
			 , ST.LOTA01  AS ALOTA01, ST.LOTA02 AS ALOTA02, ST.LOTA03 AS ALOTA03, ST.LOTA04 AS ALOTA04, ST.LOTA05 AS ALOTA05
			 , #{ALOTA06} AS ALOTA06, ST.LOTA07 AS ALOTA07, ST.LOTA08 AS ALOTA08, ST.LOTA09 AS ALOTA09, ST.LOTA10 AS ALOTA10
			 , ST.LOTA11  AS ALOTA11, ST.LOTA12 AS ALOTA12, ST.LOTA13 AS ALOTA13, ST.LOTA14 AS ALOTA14, ST.LOTA15 AS ALOTA15
			 , ST.LOTA16  AS ALOTA16, ST.LOTA17 AS ALOTA17, ST.LOTA18 AS ALOTA18, ST.LOTA19 AS ALOTA19, ST.LOTA20 AS ALOTA20
			 , ST.LOCAKY, ST.TRNUID, ST.SECTID, ST.PACKID, ST.TRUNTY
			 , ST.MEASKY           , ST.QTPUOM, SM.DUOMKY, SM.QTDUOM
			 , ST.REFDKY, ST.REFDIT, ST.REFCAT, SM.OWNRKY, SM.SKUKEY
			 , ST.AWMSNO, ST.AREAKY, SM.EANCOD, SM.GTINCD
			 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
			 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
			 , SM.GRSWGT, SM.NETWGT, SM.WGTUNT, SM.LENGTH, SM.WIDTHW
			 , SM.HEIGHT, SM.CUBICM, SM.CAPACT, ST.SMANDT, ST.SEBELN, ST.SEBELP
			 , ST.STRAID, ST.SVBELN, ST.SPOSNR, ST.STKNUM, ST.STPNUM, ST.SWERKS
			 , ST.SLGORT, ST.SDATBG, ST.STDLNR, ST.SSORNU, ST.SSORIT, ST.SMBLNR
			 , ST.SZEILE, ST.SMJAHR, ST.SXBLNR, ST.SAPSTS, ST.SBKTXT
			 , SM.INDBZL, SM.INDARC, SM.UPDCHK, ST.SZMBLNO, ST.SZMIPNO
			 , ' ' AS RELRSN, TO_CHAR(SYSDATE, 'YYYYMMDD') AS RELDAT, ' ' AS RELUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
			 , ST.STOKKY AS REFSTK
			 , ST.WAREKY
			 , SM.SKUKEY AS ASKUKEY
			 , SM.DUOMKY AS UOMKEY
		FROM STKKY ST
		INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY AND SM.SKUKEY = ST.SKUKEY
		WHERE ST.QTSIWH > 0
		  AND ST.WAREKY = #{WAREKY}
		  AND ST.LOTA02 = #{PLNTKY}
		  AND ST.LOTA14 = #{LOTA14}
		  AND ST.SKUKEY = #{SKUKEY}
		  AND ST.LOCAKY = #{LOCAKY}
		  AND ST.LOTA06 = #{LOTA06}
		ORDER BY 1 ASC
	</select>
	
	<insert id="ADJDI_MULTI_STOKKY_INSERT" parameterType="Map">
		INSERT INTO ADJDI (
			  SADJKY
			, SADJIT
			, RSNADJ
			, ADJRSN
			, STOKKY
			, LOTNUM
			, QTADJU
			, QTBLKD
			, QTYUOM
			, DESC01
			, DESC02
			        , LOTA02, LOTA03, LOTA04, LOTA05
			        , LOTA07, LOTA08, LOTA09
			, LOTA11, LOTA12, LOTA13, LOTA14, LOTA15
			, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
			
			, LOTA01
			, LOTA06
			, LOTA10
			, LOCAKY
			
			, TRNUID, SECTID, PACKID, TRUNTY
			, MEASKY, UOMKEY, QTPUOM, DUOMKY, QTDUOM
			, REFDKY, REFDIT, REFCAT, OWNRKY, SKUKEY
			, AWMSNO, AREAKY, EANCOD, GTINCD
			, ASKU01, ASKU02, ASKU03, ASKU04, ASKU05
			, SKUG01, SKUG02, SKUG03, SKUG04, SKUG05
			, GRSWGT, NETWGT, WGTUNT, LENGTH, WIDTHW
			, HEIGHT, CUBICM, CAPACT, SMANDT, SEBELN, SEBELP
			, STRAID, SVBELN, SPOSNR, STKNUM, STPNUM, SWERKS
			, SLGORT, SDATBG, STDLNR, SSORNU, SSORIT, SMBLNR
			, SZEILE, SMJAHR, SXBLNR, SAPSTS, SBKTXT
			, INDBZL, INDARC, UPDCHK, SZMBLNO, SZMIPNO
			, RELRSN, RELDAT, RELUSR
			, CREDAT, CRETIM, CREUSR, LMODAT, LMOTIM, LMOUSR
			, REFSTK
		)
		<foreach collection="list" item="item" separator=" UNION ALL " open="" close="" index="i">
		SELECT #{item.SADJKY}                                                      AS SADJKY
			 , LPAD(TO_NUMBER(#{item.SADJIT}) - DECODE(LV, 1, 10, 0), 6, '0')      AS SADJIT
			 , NVL(#{item.ARSNADJ}, ' ')                                           AS RSNADJ
			 , NVL(#{item.AADJRSN}, ' ')                                           AS AADJRSN
			 , DECODE(LV, 1, ST.STOKKY, ' ')                                       AS STOKKY
			 , DECODE(LV, 1, ST.LOTNUM, ' ')                                       AS LOTNUM
			 , TO_NUMBER(#{item.AQTADJU}) * DECODE(LV, 1, -1, 1)                   AS QTADJU
			 , 0                                                                   AS QTBLKD
			 , TO_NUMBER(#{item.AQTADJU}) * DECODE(LV, 1, -1, 1)                   AS QTYUOM
			 , ST.DESC01                                                           AS DESC01
			 , ST.DESC02                                                           AS DESC02
			            , ST.LOTA02, ST.LOTA03, ST.LOTA04, ST.LOTA05
			            , ST.LOTA07, ST.LOTA08, ST.LOTA09
			 , ST.LOTA11, ST.LOTA12, ST.LOTA13, ST.LOTA14, ST.LOTA15
			 , ST.LOTA16, ST.LOTA17, ST.LOTA18, ST.LOTA19, ST.LOTA20
			 
			 , DECODE(LV, 1, ST.LOTA01, #{item.ALOTA01}) AS LOTA01
			 , DECODE(LV, 1, ST.LOTA06, #{item.ALOTA06}) AS LOTA06
			 , DECODE(LV, 1, ST.LOTA10, #{item.ALOTA10}) AS LOTA10
			 , DECODE(LV, 1, ST.LOCAKY, #{item.LOCAKY} ) AS LOCAKY
			 
			 , ST.TRNUID, ST.SECTID, ST.PACKID, ST.TRUNTY
			 , ST.MEASKY, SM.DUOMKY, ST.QTPUOM, SM.DUOMKY, SM.QTDUOM
			 , ST.REFDKY, ST.REFDIT, ST.REFCAT, SM.OWNRKY, SM.SKUKEY
			 , ST.AWMSNO, ST.AREAKY, SM.EANCOD, SM.GTINCD
			 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
			 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
			 , SM.GRSWGT, SM.NETWGT, SM.WGTUNT, SM.LENGTH, SM.WIDTHW
			 , SM.HEIGHT, SM.CUBICM, SM.CAPACT, ST.SMANDT, ST.SEBELN, ST.SEBELP
			 , ST.STRAID, ST.SVBELN, ST.SPOSNR, ST.STKNUM, ST.STPNUM, ST.SWERKS
			 , ST.SLGORT, ST.SDATBG, ST.STDLNR, ST.SSORNU, ST.SSORIT, ST.SMBLNR
			 , ST.SZEILE, ST.SMJAHR, ST.SXBLNR, NVL(#{item.SAPSTS}, ' '), ST.SBKTXT
			 , SM.INDBZL, SM.INDARC, SM.UPDCHK, ST.SZMBLNO, ST.SZMIPNO
			 , ' ' AS RELRSN, TO_CHAR(SYSDATE, 'YYYYMMDD') AS RELDAT, ' ' AS RELUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, #{item.SES_USER_ID} AS CREUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM, #{item.SES_USER_ID} AS LMOUSR
			 , ST.STOKKY AS REFSTK
		  FROM       STKKY ST
		  INNER JOIN SKUMA SM ON (SM.OWNRKY = ST.OWNRKY AND SM.SKUKEY = ST.SKUKEY)
		  INNER JOIN (SELECT LEVEL AS LV FROM DUAL CONNECT BY 2 >= LEVEL) ON 1 = 1
		 WHERE 1=1
		   AND ST.QTSIWH > 0
		   AND ST.WAREKY = #{item.WAREKY}
		   AND ST.STOKKY = #{item.STOKKY}
		</foreach>
	</insert>
	
	<!-- [MV01] 재고이동 -->
	<select id="MV01HEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT ' ' AS TASKKY
			 , F_SET_DATE(SYSDATE) AS DOCDAT
			 , WH.WAREKY AS WAREKY, WH.NAME01 AS WARENM
			 , DT.DOCUTY AS TASOTY, DT.SHORTX AS TASOTYNM
			 , DT.DOCUTY AS DOCUTY, DT.SHORTX AS DOCUTYNM
			 , DC.DOCCAT AS DOCCAT, DC.SHORTX AS DOCCATNM
			 , ST.CMCDVL AS STATDO, ST.CDESC1 AS STATDONM
			 , WT.WAREKY AS WARETG, WT.NAME01 AS WARETGNM
			 , 0 AS QTTAOR
			 , 0 AS QTCOMP
			 , ' ' AS DRELIN
			 , ' ' AS TSPKEY
			 , ' ' AS DOORKY
			 , ' ' AS KEEPTS
			 , ' ' AS DOCTXT
			 , TO_CHAR(SYSDATE, 'YYYY-MM-DD') AS CREDAT, TO_CHAR(SYSDATE, 'HH:MI:SS'  ) AS CRETIM, ' ' AS CREUSR, ' ' AS CUSRNM
			 , TO_CHAR(SYSDATE, 'YYYY-MM-DD') AS LMODAT, TO_CHAR(SYSDATE, 'HH:MI:SS'  ) AS LMOTIM, ' ' AS LMOUSR, ' ' AS LUSRNM
		  FROM (SELECT 1 FROM DUAL) D
		  LEFT OUTER JOIN WAHMA WH ON WH.WAREKY = #{SES_WAREKY}
		  LEFT OUTER JOIN WAHMA WT ON WT.WAREKY = #{SES_WAREKY}
		  LEFT OUTER JOIN DOCCM DC ON DC.DOCCAT = '300'
		  LEFT OUTER JOIN DOCTM DT ON DT.DOCUTY = #{TASOTY}
		  LEFT OUTER JOIN CMCDV ST ON ST.CMCDKY = 'STATDO' AND ST.CMCDVL = 'NEW'
	</select>
	
	<sql id="MV01BODY">
		SELECT ' ' AS TASKKY
			 , ' ' AS TASKIT
			 , ' ' AS RSNCOD
			 , 0   AS QTCOMP
			 , ' ' AS DOORKY
			 , ' ' AS PASTKY
			 , ' ' AS ALSTKY
			 , ' ' AS SBKTXT
			 , ' ' AS TASRSN
			 , ' ' AS WORKID
			 , ' ' AS WORKNM
			 , ' ' AS HHTTID
			 , ' ' AS LOCAAC
			 , ' ' AS SECTAC
			 , ' ' AS PAIDAC
			 , ' ' AS TRNUAC
			 , ' ' AS ATRUTY
			 , ' ' AS AMEAKY
			 , ' ' AS AUOMKY
			 , 0   AS QTAPUM
			 , ' ' AS ADUOKY
			 , S.QTDUOM AS QTADUM
			 , ' ' AS REFDKY
			 , ' ' AS REFDIT
			 , ' ' AS REFCAT
			 , ' ' AS REFDAT
			 , ' ' AS AWMSTS
			 , ' ' AS DROPID
			 , 0   AS QTADJU
			 , ' ' AS TKFLKY
			 , ' ' AS STEPNO
			 , ' ' AS LSTTFL
			 , ' ' AS STRUTY
			 , ' ' AS LOCATG
			 , ' ' AS LOCAFR
			 , ' ' AS TRNUTG
			 , ' ' AS TTRUTY
			 , 'V' AS CONFIRM
			 , 'MV' AS TASKTY
			 , 'NEW' AS STATIT
			 , '00000000' AS ACTCDT
			 , '000000' AS ACTCTI
			 , S.STOKKY AS STOKKY
			 , S.QTSIWH AS AVAILABLEQTY
			 , S.QTSIWH
			 , S.QTSALO
			 , S.QTSPMO
			 , S.QTSPMI
			 , S.QTSBLK
			 , S.OWNRKY
			 , S.SKUKEY
			 , S.LOTNUM
			 , S.QTYUOM
			 , S.LOCAKY AS LOCASR
			 , S.LOCAKY
			 , S.SECTID AS SECTSR
			 , S.PACKID AS PAIDSR
			 , S.TRNUID AS TRNUSR
			 , S.MEASKY AS SMEAKY
			 , S.UOMKEY AS SUOMKY
			 , S.QTPUOM AS QTSPUM
			 , S.DUOMKY AS SDUOKY
			 , S.QTDUOM AS QTSDUM
			 , S.SECTID AS SECTTG
			 , S.PACKID AS PAIDTG
			 , S.AREAKY AS AREATG
			 , S.MEASKY AS TMEAKY
			 , S.UOMKEY AS TUOMKY
			 , S.QTPUOM AS QTTPUM
			 , S.DUOMKY AS TDUOKY
			 , S.QTDUOM AS QTTDUM
			 , S.EANCOD
			 , S.GTINCD
			 , S.GRSWGT
			 , S.NETWGT
			 , S.WGTUNT
			 , S.LENGTH
			 , S.WIDTHW
			 , S.HEIGHT
			 , S.CUBICM
			 , S.CAPACT
			 , S.AREAKY
			 , S.AWMSNO
			 , S.SMANDT
			 , S.SEBELN
			 , S.SEBELP
			 , S.SZMBLNO
			 , S.SZMIPNO
			 , S.STRAID
			 , S.SVBELN
			 , S.SPOSNR
			 , S.STKNUM
			 , S.STPNUM
			 , S.SWERKS
			 , S.SLGORT
			 , S.SDATBG
			 , S.STDLNR
			 , S.SSORNU
			 , S.SSORIT
			 , S.SMBLNR
			 , S.SZEILE
			 , S.SMJAHR
			 , S.SXBLNR
			 , S.SAPSTS
			 , S.UOMKEY
			 , S.ZONEKY
			 , S.WAREKY AS WAREKY, (SELECT DISTINCT NAME01 FROM WAHMA WHERE WAREKY = S.WAREKY) AS WAREKYNM
			 , S.PURCKY, S.PURCIT
			 , S.ASNDKY, S.ASNDIT
			 , S.RECVKY, S.RECVIT
			 , S.SHPOKY, S.SHPOIT
			 , S.GRPOKY, S.GRPOIT
			 , S.SADJKY, S.SADJIT
			 , S.SDIFKY, S.SDIFIT
			 , S.PHYIKY, S.PHYIIT
			 , S.DESC01, S.DESC02
			 , S.LOTA01, S.LOTA02, S.LOTA03, S.LOTA04, S.LOTA05
			 , S.LOTA06, S.LOTA07, S.LOTA08, S.LOTA09, S.LOTA10
			 , S.LOTA11, S.LOTA12, S.LOTA13, S.LOTA14, S.LOTA15
			 , S.LOTA16, S.LOTA17, S.LOTA18, S.LOTA19, S.LOTA20
			 , S.ASKU01, S.ASKU02, S.ASKU03, S.ASKU04, S.ASKU05
			 , S.SKUG01, S.SKUG02, S.SKUG03, S.SKUG04, S.SKUG05
			 , S.LOTA01 AS PTLT01, S.LOTA02 AS PTLT02, S.LOTA03 AS PTLT03, S.LOTA04 AS PTLT04, S.LOTA05 AS PTLT05
			 , S.LOTA06 AS PTLT06, S.LOTA07 AS PTLT07, S.LOTA08 AS PTLT08, S.LOTA09 AS PTLT09, S.LOTA10 AS PTLT10
			 , S.LOTA11 AS PTLT11, S.LOTA12 AS PTLT12, S.LOTA13 AS PTLT13, S.LOTA14 AS PTLT14, S.LOTA15 AS PTLT15
			 , S.LOTA16 AS PTLT16, S.LOTA17 AS PTLT17, S.LOTA18 AS PTLT18, S.LOTA19 AS PTLT19, S.LOTA20 AS PTLT20
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'DP' AND PTNRKY = S.LOTA02) AS LOTA02NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'CT' AND PTNRKY = S.LOTA09) AS LOTA09NM
			 , S.QTSIWH AS QTTAOR
			 , (S.QTSIWH - S.QTSBLK
			 	- GREATEST(S.QTSALO, S.QTSPMO)
			 	- (CASE WHEN S.LOTA06 IN ('00') OR S.QTSPMO > 0 THEN 0
			 			ELSE S.QTSIWH END)
			 ) AS USEQTY
			 , (S.QTSIWH - S.QTSBLK
			 	- GREATEST(S.QTSALO, S.QTSPMO)
			 	- NVL((CASE WHEN S.LOTA06 IN ('00') OR S.QTSPMO > 0 THEN 0
			 			END),0)
			 ) AS USEQTY2
			 , M.SKUL01
		  FROM STKKY S
		  INNER JOIN SKUMA M ON S.OWNRKY = M.OWNRKY AND S.SKUKEY = M.SKUKEY
		 WHERE 1=1
		   AND S.WAREKY = #{WAREKY}
		   AND S.OWNRKY = #{OWNRKY}
		   AND S.LOCAKY != 'SHPLOC'
		   AND S.AREAKY NOT IN ('SYS','SHP')
		   AND S.QTSIWH > 0
		   AND S.QTSALO = 0
		   AND S.QTSPMO = 0
		   AND S.QTSPMI = 0
		   AND S.QTSBLK = 0
		<if test="DEPART != null and DEPART != ''">AND S.LOTA02 = #{DEPART}</if>
		<if test="RECVKY != null and RECVKY != ''">AND S.RECVKY = #{RECVKY}</if>
		<if test="SKUG01 != null and SKUG01 != ''">AND S.SKUG01 = #{SKUG01}</if>
		<if test="SKUL01 != null and SKUL01 != ''">AND M.SKUL01 = #{SKUL01}</if>
		<if test="DESC01 != null and DESC01 != ''">AND UPPER(S.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>

		<if test="BARCOD != null and BARCOD != ''">AND S.LOTA14 = #{BARCOD}</if>
		<if test="AREAKY != null and AREAKY != ''">AND S.AREAKY = #{AREAKY}</if>
		<if test="ZONEKY != null and ZONEKY != ''">AND S.ZONEKY = #{ZONEKY}</if>
		<if test="LOCAKY != null and LOCAKY != ''">AND S.LOCAKY = #{LOCAKY}</if>
		<if test="LOTA06 != null and LOTA06 != ''">AND S.LOTA06 = #{LOTA06}</if>
		<if test='SES_DEVICE_TYPE == "M"'>
			AND S.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE})
		</if>
		
		<if test="LOTA02 != null and LOTA02 != ''">
			AND EXISTS (
					SELECT 'X'
					FROM ZONMA ZM
					  INNER JOIN STLMA SLM
					          ON SLM.PLNTKY = ZM.PLNTKY
					         AND SLM.WAREKY = ZM.WAREKY
					         AND SLM.STLKY  = ZM.STLKY
					         AND SLM.PLNTKY = #{LOTA02}
					WHERE ZM.WAREKY = S.WAREKY
					  AND ZM.ZONEKY = S.ZONEKY
			)
		</if>
		
		<if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
	</sql>

	<select id="MV01BODY_LIST" parameterType="Map" resultType="DataMap">
		/* MV01_BODY 재고이동 */
		SELECT TB.*
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TB.LOTA06) AS LOTA06NM
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , CASE WHEN TB.QTSIWH = 0 THEN 0 
					ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BOX'))),'0')
				END AS BOXBAG
			 , WAREKYNM AS WARENM
			 , CASE WHEN QTSIWH = 0 OR SDUOKY != 'BAG' THEN 0 
			        ELSE QTSIWH / NVL((TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BOX'))),'0') END AS STKBOXQT 
			 , CASE WHEN USEQTY = 0 OR SDUOKY != 'BAG' THEN 0 
			        ELSE USEQTY / NVL((TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY, 'BOX'))),'0') END AS USEBOXQT 	
			 , CASE WHEN USEQTY2 = 0 OR SDUOKY != 'BAG' THEN 0 
			        ELSE USEQTY2 / NVL((TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY2, TB.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY2, TB.UOMKEY, 'BOX'))),'0') END AS USEBOXQT2 	
		FROM (
			<include refid="MV01BODY"/>
		) TB
	</select>
	
	<!-- InventoryService.validateLocation  -->
	<select id="LOCAKYval2_MAP" parameterType="Map" resultType="DataMap">
		SELECT LM.LOCAKY
			 , LM.STATUS
			 , LM.SHORTX
			 , ZM.ZONEKY
			 , ZM.PLNTKY
			 , SLM.STLKY
		FROM       LOCMA LM
		INNER JOIN ZONMA ZM ON ZM.WAREKY = LM.WAREKY
						   AND ZM.ZONEKY = LM.ZONEKY
		LEFT  JOIN STLMA SLM ON SLM.PLNTKY = ZM.PLNTKY
							AND SLM.WAREKY = ZM.WAREKY
							AND SLM.STLKY  = ZM.STLKY
		WHERE LM.WAREKY = #{WAREKY}
		  AND LM.STATUS = '00'
		  AND REPLACE(LM.LOCAKY, '-', '') = REPLACE(UPPER(#{ALOCAKY}), '-', '')
	</select>
	
	<select id="LOTA07_VALIDATE_MAP" parameterType="Map" resultType="DataMap">
		SELECT DISTINCT 'FAIL' AS RESULT
		  FROM STKKY
		 WHERE QTSIWH > 0
		   AND '1100'        = #{WAREKY}
		   AND SKUKEY        = #{SKUKEY}
		   AND TRIM(LOTA07) != #{LOTA07}
		   AND LOCAKY IN (#{LOCATG}, #{LOCAAC}, #{ALOCAKY})
	</select>
	
	<select id="MV01_VALIDATION" parameterType="Map" resultType="DataMap">
		SELECT
			   CASE
				 WHEN L.LOCAKY IS NULL THEN 'VALID_M0204†' || P.LOCATG
				 ELSE 'OK'
			   END AS MSG
		FROM   (
				${VALIDATION_SQL}
				) P
		LEFT OUTER JOIN LOCMA L ON L.WAREKY = P.WAREKY AND L.LOCAKY = P.LOCATG
		WHERE  1=1
		OR	 L.LOCAKY IS NULL
	</select>

	<!-- [MV01] 재고이동 후 저장위치 변경 -->
	<select id="AFTER_MOVE_STOCK_LIST" parameterType="Map" resultType="DataMap">
		SELECT TI.TASKKY
			 , TI.TASKIT
			 , TI.LOTA02 AS  LOTA02, TI.LOTA01 AS  LOTA01
			 , ZM.PLNTKY AS ALOTA02, ZM.STLKY  AS ALOTA01
		FROM       TASDH TH
		INNER JOIN TASDI TI ON TH.TASKKY = TI.TASKKY
		INNER JOIN TASDR TR ON TR.TASKKY = TI.TASKKY AND TR.TASKIT = TI.TASKIT
		INNER JOIN LOCMA LM ON LM.LOCAKY = TI.LOCAAC AND LM.WAREKY = TH.WAREKY
		INNER JOIN ZONMA ZM ON ZM.WAREKY = LM.WAREKY AND ZM.AREAKY = LM.AREAKY AND ZM.ZONEKY = LM.ZONEKY
		WHERE TI.TASKKY = #{TASKKY}
		  AND TI.SAPSTS = #{SAPSTS}
		  AND TI.STATIT != 'NEW'
		  AND TRIM(ZM.STLKY ) IS NOT NULL
		  AND TRIM(ZM.PLNTKY) IS NOT NULL
		  AND (TI.LOTA01 != ZM.STLKY OR TI.LOTA02 != ZM.PLNTKY) /* 플랜트나 저장위치가 변경될 데이터 조회 */
		ORDER BY TI.TASKKY, TI.TASKIT
	</select>

	<!-- 로케이션 추천 -->
	<parameterMap id="GuideLocProcMap" type="java.util.Map">
		<parameter property="LOTNUM"   javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="LOCAKY"   javaType="java.lang.String" jdbcType="VARCHAR" mode="IN"/>
		<parameter property="O_LOCAKY" javaType="java.lang.String" jdbcType="VARCHAR" mode="OUT"/>
	</parameterMap>
	<update id="GUIDE_LOCATION_PROC_CALL_UPDATE" parameterMap="GuideLocProcMap" statementType="CALLABLE">
		 { call P_AIRWMS_GUIDE_LOCATION(?,?,?) }
	</update>

	<select id="MV01REHEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY
			 , TH.DOCDAT
			 , TH.DOCTXT
			 , TH.WAREKY AS WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY),' ') AS WARENM
			 , TH.DOCCAT AS DOCCAT, SZF_GET_DOCCAT_TEXT(#{LANGKY}, '300')                        AS DOCCATNM
			 , TH.TASOTY AS DOCUTY, SZF_GET_DOCUTY_TEXT(#{LANGKY}, TH.TASOTY)                    AS DOCUTYNM
			 , TH.STATDO AS STATDO, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', TH.STATDO)    AS STATDONM
		  FROM TASDH TH
		  INNER JOIN TASDI TI ON TH.TASKKY = TI.TASKKY
		 WHERE TH.TASKKY = #{TASKKY}
		 GROUP BY TH.TASKKY
			 , TH.WAREKY
			 , TH.DOCDAT
			 , TH.DOCCAT
			 , TH.TASOTY
			 , TH.STATDO
			 , TH.DOCTXT
	</select>

	<select id="MV01RESUB_LIST" parameterType="Map" resultType="DataMap">
		SELECT TR.STOKKY
			 , TH.WAREKY
			 , TI.AREAKY
			 , LM.ZONEKY
			 , TI.LOCASR
			 , TI.TRNUSR
			 , TI.LOCATG
			 , TI.TRNUTG
			 , TI.LOCAAC
			 , TI.TRNUAC
			 , TI.OWNRKY
			 , TI.SKUKEY
			 , TI.DESC01
			 , TI.DESC02
			 , TI.EANCOD
			 , TI.QTYUOM AS QTSIWH
			 , TI.QTYUOM - TI.QTTAOR AS USEQTY
			 , TI.QTTAOR
			 , TI.AUOMKY AS UOMKEY
			 , TI.LOTA01, TI.LOTA02, TI.LOTA03, TI.LOTA04, TI.LOTA05
			 , TI.LOTA06, TI.LOTA07, TI.LOTA08, TI.LOTA09, TI.LOTA10
			 , TI.LOTA11, TI.LOTA12, TI.LOTA13, TI.LOTA14, TI.LOTA15
			 , TI.LOTA16, TI.LOTA17, TI.LOTA18, TI.LOTA19, TI.LOTA20
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01)             AS SKUL01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', ST.LOTA06)             AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'CT' AND PTNRKY = ST.LOTA09) AS LOTA09NM
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TH.QTTAOR, TI.SUOMKY, 'KG') FROM DUAL)), 0) AS TOTWG /* 총중량        */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TH.QTTAOR, TI.SUOMKY, 'BAG') FROM DUAL)), 0) AS BAGQT /* EA/BAG      */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TH.QTTAOR, TI.SUOMKY, 'BOX') FROM DUAL)), 0) AS BOXQT /* BAG/BOX	    */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TH.QTTAOR, TI.SUOMKY, 'PAL') FROM DUAL)), 0) AS PLTQT /* BOX/Pallet  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TH.QTTAOR, TI.SUOMKY, 'SOK') FROM DUAL)), 0) AS SOKQT /* 속(개/BALE)  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, TI.SKUKEY, TH.QTTAOR, TI.SUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
		  FROM TASDH TH
		  INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		  INNER JOIN TASDR TR ON TR.TASKKY = TI.TASKKY AND TR.TASKIT = TI.TASKIT
		  INNER JOIN STKKY ST ON ST.STOKKY = TR.STOKKY
		  INNER JOIN SKUMA SM ON SM.SKUKEY = ST.SKUKEY AND SM.OWNRKY = ST.OWNRKY
		  INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		 WHERE TH.TASKKY 
	 		<if test="TASKKY != null and TASKKY != ''">= #{TASKKY}</if>
	 		<if test="TASKKYList != null and TASKKYList != ''">IN (${TASKKYList})</if>
	</select>

	<!-- MV02 재고이동 완료 -->
	<select id="MV02HEAD_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY
			 , TH.DOCDAT
			 , TH.DOCTXT
			 , TH.WAREKY AS WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY),' ')             AS WARENM
			 , TH.DOCCAT AS DOCCAT, SZF_GET_DOCCAT_TEXT(#{LANGKY}, TH.DOCCAT)                                AS DOCCATNM
			 , TH.TASOTY AS DOCUTY, SZF_GET_DOCUTY_TEXT(#{LANGKY}, TH.TASOTY)                                AS DOCUTYNM
			 , TH.STATDO AS STATDO, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', TH.STATDO)                AS STATDONM
			 , TH.PTNRTY AS PTNRTY, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'PTNRTY', TH.PTNRTY)                AS PTNRTYNM
			 , TH.PTNRKY AS PTNRKY, SZF_GET_PTN_NAME01_TEXT(#{LANGKY}, TI.OWNRKY, TH.PTNRKY, TH.PTNRTY)      AS PTNRNM
			 , TH.CREDAT, TH.CRETIM, TH.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = TH.CREUSR),' ') AS CUSRNM
			 , TH.LMODAT, TH.LMOTIM, TH.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = TH.LMOUSR),' ') AS LUSRNM
		  FROM TASDH TH
		  INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		  INNER JOIN SKUMA SM ON SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY
		 WHERE TH.WAREKY = #{WAREKY}
		   AND TI.OWNRKY = #{OWNRKY}
		   AND TH.TASOTY IN (SELECT DOCUTY FROM DOCPG WHERE PROGID = #{PROGID})
		   AND TI.STATIT = 'NEW'
		<if test="TASKKY != null and TASKKY != ''">AND TH.TASKKY = #{TASKKY}</if>
		<if test="WAREKY != null and WAREKY != ''">AND TH.WAREKY = #{WAREKY}</if>
		<if test="DOCDAT != null and DOCDAT != ''">AND TH.DOCDAT = #{DOCDAT}</if>
		<if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		<if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		<if test="LOCASR != null and LOCASR != ''">AND TI.LOCASR = #{LOCASR}</if>
		<if test="LOCATG != null and LOCATG != ''">AND TI.LOCATG = #{LOCATG}</if>
		<if test="DESC01 != null and DESC01 != ''">AND UPPER(TI.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		<if test='SES_DEVICE_TYPE == "M"'>
			AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE})
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		 GROUP BY TH.TASKKY
				, TH.DOCDAT
				, TH.DOCCAT
				, TH.DOCTXT
				, TH.WAREKY
				, TH.TASOTY
				, TH.STATDO
				, TI.OWNRKY
				, TH.PTNRKY
				, TH.PTNRTY
				, TH.CREDAT
				, TH.CRETIM
				, TH.CREUSR
				, TH.LMODAT
				, TH.LMOTIM
				, TH.LMOUSR
	</select>

	<sql id="MV02BODY">
		SELECT TH.TASKKY
			 , TI.TASKIT
			 , 'MV' AS TASKTY
			 , TI.STATIT
			 , TR.STOKKY
			 , TH.WAREKY
			 , TI.AREAKY
			 , LM.ZONEKY
			 , TI.LOCASR
			 , TI.TRNUSR
			 , TI.LOCATG
			 , TI.TRNUTG
			 , TI.LOCAAC
			 , TI.TRNUAC
			 , TI.OWNRKY
			 , TI.SKUKEY
			 , TI.DESC01 AS DESC01
			 , SM.DESC02 AS DESC02
			 , SM.DESC03 AS DESC03
			 , SM.DESC04 AS DESC04
			 , TI.QTTAOR
			 , CASE WHEN 'PDMV02DOC' = #{commandKey} THEN TI.QTCOMP
			        ELSE TI.QTTAOR
			   END AS QTCOMP
			 , TI.AUOMKY AS UOMKEY
			 , TI.LOTA01, TI.LOTA02, TI.LOTA03, TI.LOTA04, TI.LOTA05
			 , TI.LOTA06, TI.LOTA07, TI.LOTA08, TI.LOTA09, TI.LOTA10
			 , TI.LOTA11, TI.LOTA12, TI.LOTA13, TI.LOTA14, TI.LOTA15
			 , TI.LOTA16, TI.LOTA17, TI.LOTA18, TI.LOTA19, TI.LOTA20
			 , ST.LOTNUM AS LOTNUM
			 , ST.UOMKEY AS TUOMKY
			 , ' ' AS TTRUTY
			 , ' ' AS PAIDTG
			 , ' ' AS SECTTG
			 , ST.EANCOD AS EANCOD
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01)             AS SKUL01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TI.LOTA06)             AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'CT' AND PTNRKY = TI.LOTA09) AS LOTA09NM
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, ST.SKUKEY, ST.QTSIWH, ST.UOMKEY, 'KG') FROM DUAL)), 0) AS TOTWG /* 총중량        */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, ST.SKUKEY, ST.QTSIWH, ST.UOMKEY, 'BAG') FROM DUAL)), 0) AS BAGQT /* EA/BAG      */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, ST.SKUKEY, ST.QTSIWH, ST.UOMKEY, 'BOX') FROM DUAL)), 0) AS BOXQT /* BAG/BOX     */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, ST.SKUKEY, ST.QTSIWH, ST.UOMKEY, 'PAL') FROM DUAL)), 0) AS PLTQT /* BOX/Pallet  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, ST.SKUKEY, ST.QTSIWH, ST.UOMKEY, 'SOK') FROM DUAL)), 0) AS SOKQT /* 속(개/BALE)  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, ST.SKUKEY, ST.QTSIWH, ST.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */ 
			 , NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY),' ') AS WARENM
			 , ST.REFDKY, ST.REFDIT, ST.REFCAT, ST.REFDAT
			 , ST.PURCKY, ST.PURCIT
			 , ST.ASNDKY, ST.ASNDIT
			 , ST.RECVKY, ST.RECVIT
			 , ST.SHPOKY, ST.SHPOIT
			 , ST.SADJKY, ST.SADJIT
			 , ST.SDIFKY, ST.SDIFIT
			 , ST.PHYIKY, ST.PHYIIT
			 , ST.WGTUNT
			 , ST.LENGTH
			 , ST.WIDTHW
			 , ST.HEIGHT
			 , ST.CUBICM
			 , ST.CAPACT
			 , ST.AWMSNO
			 , ST.SMANDT
			 , ST.SEBELN
			 , ST.SEBELP
			 , ST.MEASKY AS SMEAKY
			 , ST.UOMKEY AS SUOMKY
			 , ST.QTPUOM AS QTSPUM
			 , ST.DUOMKY AS SDUOKY
			 , ST.QTDUOM AS QTSDUM
			 , ST.QTDUOM AS QTTDUM
			 , ST.QTDUOM AS QTADUM
			 , ST.MEASKY AS TMEAKY
			 , ST.QTPUOM AS QTTPUM
			 , ST.DUOMKY AS TDUOKY
			 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
			 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
			 , ST.LOTA01 AS PTLT01, ST.LOTA02 AS PTLT02, ST.LOTA03 AS PTLT03, ST.LOTA04 AS PTLT04, ST.LOTA05 AS PTLT05
			 , ST.LOTA06 AS PTLT06, ST.LOTA07 AS PTLT07, ST.LOTA08 AS PTLT08, ST.LOTA09 AS PTLT09, ST.LOTA10 AS PTLT10
			 , ST.LOTA11 AS PTLT11, ST.LOTA12 AS PTLT12, ST.LOTA13 AS PTLT13, ST.LOTA14 AS PTLT14, ST.LOTA15 AS PTLT15
			 , ST.LOTA16 AS PTLT16, ST.LOTA17 AS PTLT17, ST.LOTA18 AS PTLT18, ST.LOTA19 AS PTLT19, ST.LOTA20 AS PTLT20
		  FROM TASDH TH
		  INNER JOIN TASDI TI ON TI.TASKKY = TH.TASKKY
		  INNER JOIN TASDR TR ON TR.TASKKY = TI.TASKKY AND TR.TASKIT = TI.TASKIT
		  INNER JOIN STKKY ST ON ST.STOKKY = TR.STOKKY
		  INNER JOIN SKUMA SM ON ST.OWNRKY = SM.OWNRKY AND ST.SKUKEY = SM.SKUKEY
		  INNER JOIN LOCMA LM ON LM.WAREKY = TH.WAREKY AND LM.LOCAKY = TI.LOCASR
		WHERE TH.TASKKY = #{TASKKY}
		<if test="WAREKY != null and WAREKY != ''">AND TH.WAREKY = #{WAREKY}</if>
		<if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		<if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		<if test="LOCASR != null and LOCASR != ''">AND TI.LOCASR = #{LOCASR}</if>
		<if test="LOCATG != null and LOCATG != ''">AND TI.LOCATG = #{LOCATG}</if>
		<if test="DESC01 != null and DESC01 != ''">AND UPPER(TI.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		<if test='SES_DEVICE_TYPE == "M"'>
			AND TI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE})
		</if>
		<if test="RANGE_SQL != null and RANGE_SQL != ''">
			${RANGE_SQL}
		</if>
	</sql>

	<select id="MV02BODY_LIST" parameterType="Map" resultType="DataMap">
		SELECT *
		  FROM (
		<include refid="MV02BODY"/>
		) TB
		WHERE TB.STATIT = 'NEW'
	</select>

	<select id="PDMV01LOC_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.AREAKY, TB.ZONEKY, TB.LOCAKY, COUNT(1) AS CNT
		  FROM (
			<include refid="MV01BODY"/>
		  ) TB
		GROUP BY TB.AREAKY, TB.ZONEKY, TB.LOCAKY
		ORDER BY TB.AREAKY, TB.ZONEKY, TB.LOCAKY
	</select>
	
	<select id="PDMV01LOCMA_LIST" parameterType="Map" resultType="DataMap">
		SELECT LM.AREAKY
			 , LM.ZONEKY
			 , LM.LOCAKY
			 , ZM.PLNTKY
			 , ZM.STLKY
		  FROM LOCMA LM
		  LEFT JOIN ZONMA ZM ON LM.WAREKY = ZM.WAREKY AND LM.ZONEKY = ZM.ZONEKY
		  LEFT JOIN STLMA SM ON SM.PLNTKY = ZM.PLNTKY AND SM.WAREKY = ZM.WAREKY AND SM.STLKY = ZM.STLKY
		WHERE 1 = 1
		  AND LM.WAREKY = #{WAREKY}
		  AND LM.STATUS = '00'
		  AND ZM.ZONEKY NOT IN ('SYS', 'SHP')
		  AND (ZM.PLNTKY IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE}) OR ZM.PLNTKY = ' ')
		<if test="LOTA02 != null and LOTA02 != ''">
			<choose>
				<when test='LOTA02 == "P200" or LOTA02 == "P300"'>AND ZM.PLNTKY IN ('P200', 'P300', ' ')</when>
				<otherwise>                                       AND ZM.PLNTKY IN (#{LOTA02}, ' ')</otherwise>
			</choose>
		</if>
		<if test="SKUG05 != null and SKUG05 != ''">
			<choose>
				<when test='SKUG05 == "00"'>AND (ZM.STLKY = ' ' OR ZM.STLKY &lt;  '2000')</when>
				<otherwise>                 AND (ZM.STLKY = ' ' OR ZM.STLKY &gt;= '2000')</otherwise>
			</choose>
		</if>
		GROUP BY LM.AREAKY, LM.ZONEKY, LM.LOCAKY, ZM.PLNTKY, ZM.STLKY
		ORDER BY DECODE(TRIM(ZM.PLNTKY), NULL, 1, 2) DESC
			   , LM.AREAKY
			   , LM.ZONEKY
			   , LM.LOCAKY
	</select>

	<select id="VALIDATE_BARCOD_PDMV01_LIST" parameterType="Map" resultType="DataMap">
		SELECT *
		FROM STKKY
		WHERE 1=1
		  AND WAREKY = #{WAREKY}
		  AND LOTA14 = #{BARCOD}
	</select>
	
	<select id="PDMV01_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.*
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TB.LOTA06) AS LOTA06NM
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , WAREKYNM AS WARENM
			 , CASE WHEN TB.QTSIWH = 0 OR TB.UOMKEY != 'BAG' THEN 0 
					ELSE TB.QTSIWH/ NVL((TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY,TB.SKUKEY,TB.QTSIWH, TB.UOMKEY, 'BOX'))),'0') END AS QTSIWHBOX --재고수량BOX
			 , CASE WHEN TB.USEQTY = 0 OR TB.UOMKEY != 'BAG' THEN 0 
					ELSE TB.USEQTY/ NVL((TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY,TB.SKUKEY,TB.USEQTY, TB.UOMKEY, 'BOX'))),'0') END AS USEQTYBOX --가용수량BOX
			 , CASE WHEN TB.USEQTY2 = 0 OR TB.UOMKEY != 'BAG' THEN 0 
					ELSE TB.USEQTY2/ NVL((TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY2, TB.UOMKEY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY,TB.SKUKEY,TB.USEQTY2, TB.UOMKEY, 'BOX'))),'0') END AS USEQTYBOX2 --가용수량BOX
		FROM (
			<include refid="MV01BODY"/>
		) TB
		ORDER BY TB.LOTA14, TB.SKUKEY, TB.LOTA06
	</select>

	<select id="PDMV02DOC_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.LOCASR
			 , TB.LOCATG
			 , SUM(DECODE(TB.STATIT, 'NEW', TB.QTTAOR, TB.QTCOMP)) AS QTTAOR
			 , SUM(DECODE(TB.STATIT, 'NEW', 0        , TB.QTCOMP)) AS QTCOMP
		  FROM (
			<include refid="MV02BODY"/>
		  ) TB
		GROUP BY TB.LOCASR, TB.LOCATG
		ORDER BY 1, 2
	</select>

	<select id="PDMV02_LIST" parameterType="Map" resultType="DataMap">
		SELECT *
		  FROM (
		<include refid="MV02BODY"/>
		) TB
		WHERE TB.STATIT = 'NEW'
	</select>
	
	<select id="TASDH_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY
			 , TH.DOCDAT
			 , TH.DOCTXT
			 , TH.STATDO, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', TH.STATDO)    AS STATDONM
			 , TH.DOCCAT AS DOCCAT, SZF_GET_DOCCAT_TEXT(#{LANGKY}, TH.DOCCAT)          AS DOCCATNM
			 , TH.TASOTY AS DOCUTY, SZF_GET_DOCUTY_TEXT(#{LANGKY}, TH.TASOTY)          AS DOCUTYNM
			 , TH.WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY),' ') AS WARENM
		  FROM TASDH TH
		 INNER JOIN TASDI TI ON (TH.TASKKY = TI.TASKKY)
		 INNER JOIN SKUMA SM ON (SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY)
		 WHERE 1=1
		   AND TH.WAREKY = #{WAREKY}
		   AND TI.OWNRKY = #{OWNRKY}
		   AND TH.TASOTY IN (SELECT DOCUTY FROM DOCPG WHERE PROGID = #{PROGID})
		   <if test="TASOTY != null and TASOTY != ''">AND TH.TASOTY = #{TASOTY}</if>
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(TI.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		   <if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		 GROUP BY TH.TASKKY
				, TH.DOCDAT
				, TH.DOCTXT
				, TH.STATDO
				, TH.DOCCAT
				, TH.TASOTY
				, TH.WAREKY
		 ORDER BY TH.TASKKY DESC
	</select>
	
	<select id="TASDI_LIST" parameterType="Map" resultType="DataMap">
		SELECT TI.TASKIT
			 , TI.AREAKY, (SELECT ZONEKY FROM LOCMA WHERE WAREKY = TH.WAREKY AND LOCAKY = TI.LOCASR) AS ZONEKY
			 , TI.LOCASR
			 , TI.LOCATG
			 , TI.LOCAAC
			 , SM.SKUL01, SZF_GET_CMCDV_CDESC1_TEXT('KR', 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , TI.SKUKEY
			 , TI.DESC01
			 , SM.DUOMKY AS UOMKEY
			 , TI.QTTAOR
			 , TI.QTCOMP
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'KG') FROM DUAL)), 0) AS TOTWG /* 총중량        */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'BAG') FROM DUAL)), 0) AS BAGQT /* EA/BAG       */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'BOX') FROM DUAL)), 0) AS BOXQT /* BAG/BOX      */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'PAL') FROM DUAL)), 0) AS PLTQT /* BOX/Pallet   */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'SOK') FROM DUAL)), 0) AS SOKQT /* 속(개/BALE)  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */ 
			 , CASE WHEN TI.QTTAOR = 0 THEN 0 
					ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'BOX'))),'0') 
				END AS BOXBAG
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TI.LOTA06) AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'CT' AND PTNRKY = TI.LOTA09) AS LOTA09NM
			 , TI.LOTA01, TI.LOTA02, TI.LOTA03, TI.LOTA04, TI.LOTA05
			 , TI.LOTA06, TI.LOTA07, TI.LOTA08, TI.LOTA09, TI.LOTA10
			 , TI.LOTA11, TI.LOTA12, TI.LOTA13, TI.LOTA14, TI.LOTA15
			 , TI.LOTA16, TI.LOTA17, TI.LOTA18, TI.LOTA19, TI.LOTA20
			 , TI.CREDAT, TI.CRETIM, TI.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = TI.CREUSR),' ') AS CUSRNM
			 , TI.LMODAT, TI.LMOTIM, TI.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = TI.LMOUSR),' ') AS LUSRNM
		  FROM TASDH TH
		 INNER JOIN TASDI TI ON (TH.TASKKY = TI.TASKKY)
		 INNER JOIN SKUMA SM ON (SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY)
		 WHERE 1=1
		   AND TH.TASKKY = #{TASKKY}
		   AND TH.TASOTY IN (SELECT DOCUTY FROM DOCPG WHERE PROGID = #{PROGID})
		   <if test="TASOTY != null and TASOTY != ''">AND TH.TASOTY = #{TASOTY}</if>
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(TI.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		   <if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		 ORDER BY TI.TASKKY DESC, TI.TASKIT
	</select>
	
	<select id="MV10_LIST" parameterType="Map" resultType="DataMap">
		SELECT TH.TASKKY
			 , TH.DOCDAT
			 , TH.DOCTXT
			 , TH.STATDO, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'STATDO', TH.STATDO)    AS STATDONM
			 , TH.DOCCAT AS DOCCAT, SZF_GET_DOCCAT_TEXT(#{LANGKY}, TH.DOCCAT)          AS DOCCATNM
			 , TH.TASOTY AS DOCUTY, SZF_GET_DOCUTY_TEXT(#{LANGKY}, TH.TASOTY)          AS DOCUTYNM
			 , TH.WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = TH.WAREKY),' ') AS WARENM
			 , TI.TASKIT
			 , TI.AREAKY, (SELECT ZONEKY FROM LOCMA WHERE WAREKY = TH.WAREKY AND LOCAKY = TI.LOCASR) AS ZONEKY
			 , TI.LOCASR
			 , TI.LOCATG
			 , TI.LOCAAC
			 , SM.SKUL01, SZF_GET_CMCDV_CDESC1_TEXT('KR', 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , TI.SKUKEY
			 , TI.DESC01
			 , SM.DUOMKY AS UOMKEY
			 , TI.QTTAOR
			 , TI.QTCOMP
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'KG') FROM DUAL)), 0) AS TOTWG /* 총중량        */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'BAG') FROM DUAL)), 0) AS BAGQT /* EA/BAG       */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'BOX') FROM DUAL)), 0) AS BOXQT /* BAG/BOX      */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'PAL') FROM DUAL)), 0) AS PLTQT /* BOX/Pallet   */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'SOK') FROM DUAL)), 0) AS SOKQT /* 속(개/BALE)  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , CASE WHEN TI.QTTAOR = 0 THEN 0 
					ELSE NVL((TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'BAG')) / TRIM(SZF_GET_CONVERT_QTY(TH.WAREKY, SM.SKUKEY, TI.QTTAOR, SM.DUOMKY, 'BOX'))),'0')
				END AS BOXBAG
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TI.LOTA06) AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRTY = 'CT' AND PTNRKY = TI.LOTA09) AS LOTA09NM
			 , TI.LOTA01, TI.LOTA02, TI.LOTA03, TI.LOTA04, TI.LOTA05
			 , TI.LOTA06, TI.LOTA07, TI.LOTA08, TI.LOTA09, TI.LOTA10
			 , TI.LOTA11, TI.LOTA12, TI.LOTA13, TI.LOTA14, TI.LOTA15
			 , TI.LOTA16, TI.LOTA17, TI.LOTA18, TI.LOTA19, TI.LOTA20
			 , TI.CREDAT, TI.CRETIM, TI.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = TI.CREUSR),' ') AS CUSRNM
			 , TI.LMODAT, TI.LMOTIM, TI.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = TI.LMOUSR),' ') AS LUSRNM
		  FROM TASDH TH
		 INNER JOIN TASDI TI ON (TH.TASKKY = TI.TASKKY)
		 INNER JOIN SKUMA SM ON (SM.OWNRKY = TI.OWNRKY AND SM.SKUKEY = TI.SKUKEY)
		 WHERE 1=1
		   AND TH.TASOTY IN (SELECT DOCUTY FROM DOCPG WHERE PROGID = #{PROGID})
		   <if test="TASOTY != null and TASOTY != ''">AND TH.TASOTY = #{TASOTY}</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		   <if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		 ORDER BY TI.TASKKY DESC, TI.TASKIT
	</select>

	<select id="IP01_LIST" parameterType="Map" resultType="DataMap">
		SELECT ' ' AS PHYIKY
			 , ' ' AS INDDCL
			 , ' ' AS DOCTXT
			 , ' ' AS BLIND
			 , F_SET_DATE(SYSDATE) AS DOCDAT
			 , '500'     AS DOCCAT, NVL((SELECT SHORTX FROM DOCCM WHERE DOCCAT = '500'    ), ' ') AS DOCCATNM
			 , #{PHSCTY} AS DOCUTY, NVL((SELECT SHORTX FROM DOCTM WHERE DOCUTY = #{PHSCTY}), ' ') AS DOCUTYNM
			 , #{WAREKY} AS WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}), ' ') AS WARENM
			 , #{PHSCTY} AS PHSCTY
			 , #{PHYCOP} AS PHYCOP
		FROM DUAL
	</select>
	
	<select id="IP01Sub_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.*
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
										  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
		  FROM (
			SELECT ' ' AS PHYIKY
				 , ' ' AS PHYIIT
				 , 0 AS QTYPDA
				 , ST.WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = ST.WAREKY),' ') AS WARENM
				 , ST.AREAKY
				 , ST.ZONEKY
				 , ST.LOCAKY
				 , ST.SKUKEY
				 , SM.SKUL01, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
				 , SM.SKUG05
				 , ST.TRNUID
				 , ST.OWNRKY
				 , SM.EANCOD
				 , ST.LOTA01, ST.LOTA02, ST.LOTA03, ST.LOTA04, ST.LOTA05
				 , ST.LOTA06, ST.LOTA07, ST.LOTA08, ST.LOTA09, ST.LOTA10
				 , ST.LOTA11, ST.LOTA12, ST.LOTA13, ST.LOTA14, ST.LOTA15
				 , ST.LOTA16, ST.LOTA17, ST.LOTA18, ST.LOTA19, ST.LOTA20
				 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', ST.LOTA06)             AS LOTA06NM
				 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = ST.LOTA09 AND PTNRTY = 'CT') AS LOTA09NM
				 , SM.DUOMKY AS UOMKEY
				 , ST.DESC01 AS DESC01
				 , SM.DESC02 AS DESC02
				 , SM.DESC03 AS DESC03
				 , SM.DESC04 AS DESC04
				 , SUM(ST.QTSIWH) AS QTSIWH
				 , SUM(CASE WHEN ST.AREAKY = 'SHP' THEN 0
							ELSE ST.QTSIWH - ST.QTSBLK
										   - GREATEST(ST.QTSALO, ST.QTSPMO)
										   - (CASE WHEN ST.LOTA06 IN ('00') OR ST.QTSPMO > 0 THEN 0 ELSE ST.QTSIWH END)
						END) AS QTABLE
				 , SUM(ST.QTSALO) AS QTSALO
				 , SUM(ST.QTSPMO) AS QTSPMO
				 , SUM(ST.QTSPMI) AS QTSPMI
				 /* 2022.05.26 GROUPPING 기준 변경 (LOTA06 추가) */
--				 , SUM(NVL(DECODE(ST.LOTA06, '05', ST.QTSIWH), 0)) AS QTSIQT /* 품질 : Inspection QuanTity */
--				 , SUM(NVL(DECODE(ST.LOTA06, '10', ST.QTSIWH), 0)) AS QTSHQT /* 보류 : Hold       QuanTity */
--				 , SUM(NVL(DECODE(ST.LOTA06, '30', ST.QTSIWH), 0)) AS QTSCNU /* 불용 : Can Not Use         */
--				 , SUM(NVL(DECODE(ST.LOTA06, '50', ST.QTSIWH), 0)) AS QTSWQT /* 폐기 : Wasted     QuanTity */
				 , ' ' AS RSNCOD
				 , ' ' AS RSNTXT
			  FROM STKKY ST
			  INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY AND SM.SKUKEY = ST.SKUKEY
			  INNER JOIN SKUWC SW ON SW.WAREKY = ST.WAREKY AND SW.OWNRKY = ST.OWNRKY AND SW.SKUKEY = ST.SKUKEY
			  INNER JOIN AREMA AM ON AM.WAREKY = ST.WAREKY AND AM.AREAKY = ST.AREAKY AND AM.AREATY IN ('RECV','STOR','TASK')
			 WHERE 1 = 1
			   AND ST.WAREKY = #{WAREKY}
			   AND ST.OWNRKY = #{OWNRKY}
			   AND ST.QTSIWH > 0
			<if test='PHYCOP == "2"'>
				AND EXISTS (SELECT 1
				      FROM WHTRH
				     WHERE WAREKY = ST.WAREKY
				       AND SKUKEY = ST.SKUKEY
				       AND CREDAT BETWEEN #{PHOPDTFR} AND #{PHOPDTTO}
				    )
			</if>
			<if test='PHYCOP == "3"'>
				AND EXISTS (SELECT 1
				      FROM WHTRH
				     WHERE WAREKY = ST.WAREKY
				       AND LOCAKY = ST.LOCAKY
				       AND CREDAT BETWEEN #{PHOPDTFR} AND #{PHOPDTTO}
				    )
			</if>
			<if test="DESC01 != null and DESC01 != ''">AND UPPER(ST.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
			<if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
			<if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
			<!-- <if test="LOTA02 != null and LOTA02 != ''">AND ST.LOTA02 = #{LOTA02}</if> -->
			<if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
			 GROUP BY ST.WAREKY
					, ST.AREAKY
					, ST.ZONEKY
					, ST.LOCAKY
					, ST.TRNUID
					, ST.OWNRKY
					, ST.SKUKEY
					, SM.SKUL01
					, SM.SKUG05
					, SM.EANCOD
					, SM.DUOMKY
					, ST.DESC01
					, SM.DESC02
					, SM.DESC03
					, SM.DESC04
					, ST.LOTA01, ST.LOTA02, ST.LOTA03, ST.LOTA04, ST.LOTA05
					, ST.LOTA06, ST.LOTA07, ST.LOTA08, ST.LOTA09, ST.LOTA10
					, ST.LOTA11, ST.LOTA12, ST.LOTA13, ST.LOTA14, ST.LOTA15
					, ST.LOTA16, ST.LOTA17, ST.LOTA18, ST.LOTA19, ST.LOTA20
			 ORDER BY ST.LOCAKY, ST.SKUKEY, ST.LOTA14, ST.LOTA06
		) TB
	</select>
	
	<insert id="PHYDH_INSERT" parameterType="Map">
		INSERT INTO PHYDH (
			  PHYIKY, WAREKY, INDDCL
			, PHSCTY, DOCDAT, DOCCAT
			, TRNDAT, TRNTIM, TRNUSR
			, USRID1, UNAME1, DEPTID1, DNAME1
			, USRID2, UNAME2, DEPTID2, DNAME2
			, USRID3, UNAME3, DEPTID3, DNAME3
			, USRID4, UNAME4, DEPTID4, DNAME4
			, DOCTXT
			, CREDAT, CRETIM, CREUSR
			, LMODAT, LMOTIM, LMOUSR
			, INDBZL, INDARC, UPDCHK
		) VALUES (
			  #{PHYIKY}, #{WAREKY}, NVL(#{INDDCL}, ' ')
			, #{PHSCTY}, #{DOCDAT}, #{DOCCAT}
			, NVL(#{TRNDAT}, ' '), NVL(#{TRNTIM}, ' '), NVL(#{TRNUSR}, ' ')
			, ' ', ' ', ' '     , ' '
			, ' ', ' ', ' '     , ' '
			, ' ', ' ', ' '     , ' '
			, ' ', ' ', #{BLIND}, ' '
			, #{DOCTXT}
			, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			, TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			, ' ', ' ', 0
		)
	</insert>
	
	<insert id="PHYDI_INSERT" parameterType="Map">
		INSERT INTO PHYDI (
			   PHYIKY, PHYIIT, AREAKY, LOCAKY, TRNUID
			 , QTADJU, QTSPHY, QTYPDA, QTSIWH, QTSALO
			 , QTSPMO, QTSPMI, QTBLKD
			 , QTSIQT, QTSHQT, QTSCNU, QTSWQT
			 , UOMKEY
			 , OWNRKY, SKUKEY, DESC01, DESC02
			 , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05
			 , LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
			 , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15
			 , LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
			 , ASKU01, ASKU02, ASKU03, ASKU04, ASKU05
			 , EANCOD, GTINCD
			 , SKUG01, SKUG02, SKUG03, SKUG04, SKUG05
			 , GRSWGT, NETWGT, WGTUNT, LENGTH, WIDTHW
			 , HEIGHT, CUBICM, CAPACT, RSNADJ, ADJRSN
			 , CREDAT, CRETIM, CREUSR
			 , LMODAT, LMOTIM, LMOUSR
			 , INDBZL, INDARC, UPDCHK
		)
		SELECT #{PHYIKY}           AS PHYIKY
			 , #{PHYIIT}           AS PHYIIT
			 , #{AREAKY}           AS AREAKY
			 , #{LOCAKY}           AS LOCAKY
			 , #{TRNUID}           AS TRNUID
			 , 0                   AS QTADJU
			 , #{QTSIWH}           AS QTSPHY
			 , 0                   AS QTYPDA
			 , #{QTSIWH}           AS QTSIWH
			 , #{QTSALO}           AS QTSALO
			 , #{QTSPMO}           AS QTSPMO
			 , #{QTSPMI}           AS QTSPMI
			 , 0                   AS QTBLKD
			 , NVL(#{QTSIQT}, 0)   AS QTSIQT
			 , NVL(#{QTSHQT}, 0)   AS QTSHQT
			 , NVL(#{QTSCNU}, 0)   AS QTSCNU
			 , NVL(#{QTSWQT}, 0)   AS QTSWQT
			 , SM.DUOMKY           AS UOMKEY
			 , SM.OWNRKY           AS OWNRKY
			 , SM.SKUKEY           AS SKUKEY
			 , #{DESC01}           AS DESC01
			 , SM.DESC02           AS DESC02
			 , NVL(#{LOTA01}, ' ') AS LOTA01
			 , NVL(#{LOTA02}, ' ') AS LOTA02
			 , NVL(#{LOTA03}, ' ') AS LOTA03
			 , NVL(#{LOTA04}, ' ') AS LOTA04
			 , NVL(#{LOTA05}, ' ') AS LOTA05
			 , NVL(#{LOTA06}, ' ') AS LOTA06
			 , NVL(#{LOTA07}, ' ') AS LOTA07
			 , NVL(#{LOTA08}, ' ') AS LOTA08
			 , NVL(#{LOTA09}, ' ') AS LOTA09
			 , NVL(#{LOTA10}, ' ') AS LOTA10
			 , NVL(#{LOTA11}, ' ') AS LOTA11
			 , NVL(#{LOTA12}, ' ') AS LOTA12
			 , NVL(#{LOTA13}, ' ') AS LOTA13
			 , NVL(#{LOTA14}, ' ') AS LOTA14
			 , NVL(#{LOTA15}, ' ') AS LOTA15
			 , NVL(#{LOTA16}, 0  ) AS LOTA16
			 , NVL(#{LOTA17}, ' ') AS LOTA17
			 , NVL(#{LOTA18}, 0  ) AS LOTA18
			 , NVL(#{LOTA19}, 0  ) AS LOTA19
			 , NVL(#{LOTA20}, 0  ) AS LOTA20
			 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
			 , SM.EANCOD, SM.GTINCD
			 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
			 , SM.GRSWGT, SM.NETWGT, SM.WGTUNT, SM.LENGTH, SM.WIDTHW
			 , SM.HEIGHT, SM.CUBICM, SM.CAPACT, ' ' AS RSNADJ, ' ' AS ADJRSN
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			 , ' ', ' ', 0
		  FROM SKUMA SM
		  INNER JOIN SKUWC SW ON SW.WAREKY = #{WAREKY} AND SW.OWNRKY = SM.OWNRKY AND SW.SKUKEY = SM.SKUKEY
		 WHERE SM.OWNRKY = #{OWNRKY}
		   AND SM.SKUKEY = #{SKUKEY}
	</insert>
	
	<insert id="PHYDI_MULTI_INSERT" parameterType="Map">
		INSERT INTO PHYDI (
			   PHYIKY, PHYIIT, AREAKY, LOCAKY, TRNUID
			 , QTADJU, QTSPHY, QTYPDA, QTSIWH, QTSALO
			 , QTSPMO, QTSPMI, QTBLKD
			 , QTSIQT, QTSHQT, QTSCNU, QTSWQT
			 , UOMKEY
			 , OWNRKY, SKUKEY, DESC01, DESC02
			 , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05
			 , LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
			 , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15
			 , LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
			 , ASKU01, ASKU02, ASKU03, ASKU04, ASKU05
			 , EANCOD, GTINCD
			 , SKUG01, SKUG02, SKUG03, SKUG04, SKUG05
			 , GRSWGT, NETWGT, WGTUNT, LENGTH, WIDTHW
			 , HEIGHT, CUBICM, CAPACT, RSNADJ, ADJRSN
			 , CREDAT, CRETIM, CREUSR
			 , LMODAT, LMOTIM, LMOUSR
			 , INDBZL, INDARC, UPDCHK
		)
		<foreach collection="list" item="item" separator=" UNION ALL " open="" close="" index="i">
			SELECT #{item.PHYIKY}           AS PHYIKY
				 , #{item.PHYIIT}           AS PHYIIT
				 , #{item.AREAKY}           AS AREAKY
				 , #{item.LOCAKY}           AS LOCAKY
				 , #{item.TRNUID}           AS TRNUID
				 , 0                        AS QTADJU
				 , 0                        AS QTSPHY
				 , 0                        AS QTYPDA
				 , #{item.QTSIWH}           AS QTSIWH
				 , #{item.QTSALO}           AS QTSALO
				 , #{item.QTSPMO}           AS QTSPMO
				 , #{item.QTSPMI}           AS QTSPMI
				 , 0                        AS QTBLKD
				 , NVL(#{item.QTSIQT}, 0  ) AS QTSIQT
				 , NVL(#{item.QTSHQT}, 0  ) AS QTSHQT
				 , NVL(#{item.QTSCNU}, 0  ) AS QTSCNU
				 , NVL(#{item.QTSWQT}, 0  ) AS QTSWQT
				 , SM.DUOMKY                AS UOMKEY
				 , SM.OWNRKY                AS OWNRKY
				 , SM.SKUKEY                AS SKUKEY
				 , NVL(#{item.DESC01}, ' ') AS DESC01, SM.DESC02
				 , NVL(#{item.LOTA01}, ' ') AS LOTA01
				 , NVL(#{item.LOTA02}, ' ') AS LOTA02
				 , NVL(#{item.LOTA03}, ' ') AS LOTA03
				 , NVL(#{item.LOTA04}, ' ') AS LOTA04
				 , NVL(#{item.LOTA05}, ' ') AS LOTA05
				 , NVL(#{item.LOTA06}, ' ') AS LOTA06
				 , NVL(#{item.LOTA07}, ' ') AS LOTA07
				 , NVL(#{item.LOTA08}, ' ') AS LOTA08
				 , NVL(#{item.LOTA09}, ' ') AS LOTA09
				 , NVL(#{item.LOTA10}, ' ') AS LOTA10
				 , NVL(#{item.LOTA11}, ' ') AS LOTA11
				 , NVL(#{item.LOTA12}, ' ') AS LOTA12
				 , NVL(#{item.LOTA13}, ' ') AS LOTA13
				 , NVL(#{item.LOTA14}, ' ') AS LOTA14
				 , NVL(#{item.LOTA15}, ' ') AS LOTA15
				 , NVL(#{item.LOTA16}, 0  ) AS LOTA16
				 , NVL(#{item.LOTA17}, ' ') AS LOTA17
				 , NVL(#{item.LOTA18}, 0  ) AS LOTA18
				 , NVL(#{item.LOTA19}, 0  ) AS LOTA19
				 , NVL(#{item.LOTA20}, 0  ) AS LOTA20
				 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
				 , SM.EANCOD, SM.GTINCD
				 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
				 , SM.GRSWGT, SM.NETWGT, SM.WGTUNT, SM.LENGTH, SM.WIDTHW
				 , SM.HEIGHT, SM.CUBICM, SM.CAPACT, ' ' AS RSNADJ, ' ' AS ADJRSN
				 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{item.SES_USER_ID}
				 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{item.SES_USER_ID}
				 , ' ', ' ', 0
			  FROM SKUMA SM
			  INNER JOIN SKUWC SW ON SW.WAREKY = #{item.WAREKY}
								 AND SW.OWNRKY = SM.OWNRKY
								 AND SW.SKUKEY = SM.SKUKEY
			 WHERE SM.OWNRKY = #{item.OWNRKY}
			   AND SM.SKUKEY = #{item.SKUKEY}
		</foreach>
	</insert>
	
	<select id="IP01Re_LIST" parameterType="Map" resultType="DataMap">
		SELECT PH.PHYIKY
			 , PH.DOCDAT
			 , PH.INDDCL
			 , PH.DOCTXT
			 , PH.DEPTID4 AS BLIND
			 , PH.WAREKY AS WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = PH.WAREKY),' ') AS WARENM
			 , PH.DOCCAT AS DOCCAT, SZF_GET_DOCCAT_TEXT(#{LANGKY}, PH.DOCCAT) AS DOCCATNM
			 , PH.PHSCTY AS DOCUTY, SZF_GET_DOCUTY_TEXT(#{LANGKY}, PH.PHSCTY) AS DOCUTYNM
			 , PH.CREDAT, PH.CRETIM, PH.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PH.CREUSR),' ') AS CUSRNM
			 , PH.LMODAT, PH.LMOTIM, PH.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PH.LMOUSR),' ') AS LUSRNM
		  FROM PHYDH PH
		 WHERE PH.PHYIKY = #{PHYIKY}
	</select>
	
	<select id="IP01ReSub_LIST" parameterType="Map" resultType="DataMap">
		SELECT TB.*
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'KG' ) FROM DUAL)), 0) AS TOTWG /* 총중량        */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BAG') FROM DUAL)), 0) AS BAGQT /* EA/BAG      */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'BOX') FROM DUAL)), 0) AS BOXQT /* BAG/BOX     */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'PAL') FROM DUAL)), 0) AS PLTQT /* BOX/Pallet  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'SOK') FROM DUAL)), 0) AS SOKQT /* 속(개/BALE)  */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , 0 AS QTYPDA
		  FROM (
			SELECT PH.PHYIKY
				 , PI.PHYIIT
				 , PH.WAREKY, NVL((SELECT NAME01 FROM WAHMA WHERE WAREKY = PH.WAREKY),' ') AS WARENM
				 , PI.AREAKY
				 , LM.ZONEKY
				 , PI.LOCAKY
				 , PI.TRNUID
				 , PI.OWNRKY
				 , PI.SKUKEY
				 , SM.EANCOD
				 , PI.QTSIWH
				 , CASE WHEN PI.AREAKY = 'SHP' THEN 0
							ELSE PI.QTSIWH - PI.QTBLKD
										   - GREATEST(PI.QTSALO, PI.QTSPMO)
										   - (CASE WHEN PI.LOTA06 IN ('00') OR PI.QTSPMO > 0 THEN 0 ELSE PI.QTSIWH END)
					END AS QTABLE
--				 , PI.QTSIQT /* 품질 : Inspection QuanTity */
--				 , PI.QTSHQT /* 보류 : Hold       QuanTity */
--				 , PI.QTSCNU /* 불용 : Can Not Use         */
--				 , PI.QTSWQT /* 폐기 : Wasted     QuanTity */
				 , PI.QTSALO
				 , PI.QTSPMO
				 , PI.QTSPMI
				 , SM.DUOMKY AS UOMKEY
				 , PI.LOTA01, PI.LOTA02, PI.LOTA03, PI.LOTA04, PI.LOTA05
				 , PI.LOTA06, PI.LOTA07, PI.LOTA08, PI.LOTA09, PI.LOTA10
				 , PI.LOTA11, PI.LOTA12, PI.LOTA13, PI.LOTA14, PI.LOTA15
				 , PI.LOTA16, PI.LOTA17, PI.LOTA18, PI.LOTA19, PI.LOTA20
				 , PI.RSNADJ AS RSNCOD
				 , PI.ADJRSN AS RSNTXT
				 , PI.CREDAT, PI.CRETIM, PI.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PI.CREUSR),' ') AS CUSRNM
				 , PI.LMODAT, PI.LMOTIM, PI.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PI.LMOUSR),' ') AS LUSRNM
				 , SM.SKUL05
				 , PI.DESC01 AS DESC01
				 , SM.DESC02 AS DESC02
				 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', PI.LOTA06)             AS LOTA06NM
				 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = PI.LOTA09 AND PTNRTY = 'CT') AS LOTA09NM
				 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01)             AS SKUL01NM
				 , NVL((SELECT ABCANV FROM SKUWC SW WHERE SW.WAREKY = PH.WAREKY AND SW.OWNRKY = PI.OWNRKY AND SW.SKUKEY = PI.SKUKEY), ' ') AS ABCANV
			  FROM PHYDH PH
			  INNER JOIN PHYDI PI ON PI.PHYIKY = PH.PHYIKY
			  INNER JOIN SKUMA SM ON SM.OWNRKY = PI.OWNRKY AND SM.SKUKEY = PI.SKUKEY
			  INNER JOIN LOCMA LM ON LM.WAREKY = PH.WAREKY AND LM.LOCAKY = PI.LOCAKY
			  INNER JOIN AREMA AM ON AM.WAREKY = PH.WAREKY AND AM.AREAKY = PI.AREAKY AND AM.AREATY IN ('RECV','STOR','TASK')
			 WHERE PH.PHYIKY = #{PHYIKY}
		  ) TB
		  ORDER BY TB.PHYIKY DESC, TB.PHYIIT
	</select>
	
	<select id="PHYDH_LIST" parameterType="Map" resultType="DataMap">
		SELECT PH.PHYIKY
			 , PH.DOCDAT
			 , PH.INDDCL
			 , PH.DOCTXT
			 , PH.DEPTID4 AS BLIND
			 , PH.PHSCTY AS DOCUTY, SZF_GET_DOCUTY_TEXT('KR', PH.PHSCTY) AS DOCUTYNM
			 , PH.DOCCAT AS DOCCAT, SZF_GET_DOCCAT_TEXT('KR', PH.DOCCAT) AS DOCCATNM
			 , PH.WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = PH.WAREKY) AS WARENM
			 , PH.CREDAT, PH.CRETIM, PH.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PH.CREUSR),' ') AS CUSRNM
			 , PH.LMODAT, PH.LMOTIM, PH.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PH.LMOUSR),' ') AS LUSRNM
			 , SUM(QTSIWH) - SUM(QTSPHY) AS ISDIFF
		  FROM PHYDH PH
		 INNER JOIN PHYDI PI ON PH.PHYIKY = PI.PHYIKY
		 WHERE 1=1
		 <if test="PHYIKY != null and PHYIKY != ''">AND PH.PHYIKY = #{PHYIKY}</if>
		 <if test="WAREKY != null and WAREKY != ''">AND PH.WAREKY = #{WAREKY}</if>
		 <if test="PHDTFR != null and PHDTFR != ''">AND PH.DOCDAT >= #{PHDTFR}</if>
		 <if test="PHDTTO != null and PHDTTO != ''">AND #{PHDTTO} >= PH.DOCDAT</if>
		 <if test="INDDCL != null and INDDCL != ''">AND PH.INDDCL = #{INDDCL}</if>
		 <if test="SKUL01 != null and SKUL01 != ''">AND EXISTS(SELECT 1 FROM SKUMA WHERE SKUKEY = PI.SKUKEY AND SKUL01 = #{SKUL01})</if>
		 <if test="SKUG01 != null and SKUG01 != ''">AND EXISTS(SELECT 1 FROM SKUMA WHERE SKUKEY = PI.SKUKEY AND SKUG01 = #{SKUG01})</if>
		 <if test="DESC01 != null and DESC01 != ''">AND UPPER(PI.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		 <choose>
			<when test='INDDCL == "Y"'>AND PH.INDDCL = 'V'</when>
			<when test='INDDCL == "N"'>AND PH.INDDCL = ' '</when>
		 </choose>
		 <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		 GROUP BY PH.PHYIKY
				, PH.PHSCTY
				, PH.DOCDAT
				, PH.INDDCL
				, PH.DOCTXT
				, PH.DEPTID4
				, PH.DOCCAT
				, PH.WAREKY
				, PH.CREDAT, PH.CRETIM, PH.CREUSR
				, PH.LMODAT, PH.LMOTIM, PH.LMOUSR
		 ORDER BY 1 DESC
	</select>
	
	<select id="PHYDI_LIST" parameterType="Map" resultType="DataMap">
		SELECT PI.PHYIKY, PI.PHYIIT
			 , PI.AREAKY, (SELECT ZONEKY FROM LOCMA WHERE WAREKY = PH.WAREKY AND LOCAKY = PI.LOCAKY) AS ZONEKY
			 , PI.LOCAKY
			 , PI.SKUKEY, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , PI.DESC01
			 , PI.UOMKEY
			 , PI.QTYPDA
			 , PI.QTSPHY
			 , DECODE(REFCAT, 'V', PI.QTSPHY - PI.QTSIWH, 0) AS QTADJU
			 , PI.QTSIWH
			 , PI.QTSIWH * TRUNC(NVL(DECODE(MV.PEINH, 0, 0, MV.STPRS / MV.PEINH), 0)) AS STKAMT
			 , CASE WHEN PI.AREAKY = 'SHP' THEN 0
					ELSE PI.QTSIWH - PI.QTBLKD
								   - GREATEST(PI.QTSALO, PI.QTSPMO)
								   - (CASE WHEN PI.LOTA06 IN ('00') OR PI.QTSPMO > 0 THEN 0 ELSE PI.QTSIWH END)
				END AS QTABLE
--			 , PI.QTSIQT /* 품질 : Inspection QuanTity */
--			 , PI.QTSHQT /* 보류 : Hold       QuanTity */
--			 , PI.QTSCNU /* 불용 : Can Not Use         */
--			 , PI.QTSWQT /* 폐기 : Wasted     QuanTity */
			 , PI.QTSALO
			 , PI.QTSPMO
			 , PI.QTSPMI
			 , PI.LOTA01, PI.LOTA02, PI.LOTA03, PI.LOTA04, PI.LOTA05
			 , PI.LOTA06, PI.LOTA07, PI.LOTA08, PI.LOTA09, PI.LOTA10
			 , PI.LOTA11, PI.LOTA12, PI.LOTA13, PI.LOTA14, PI.LOTA15
			 , PI.LOTA16, PI.LOTA17, PI.LOTA18, PI.LOTA19, PI.LOTA20
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', PI.LOTA06)             AS LOTA06NM
			 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = PI.LOTA09 AND PTNRTY = 'CT') AS LOTA09NM
			 , PI.RSNADJ AS ADJDES
			 , PI.ADJRSN
			 , PH.DEPTID4 /* 'V' : 블라인드 */
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(SM.DUOMKY, 'KG' , PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'BAG', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'BOX', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(SM.DUOMKY, 'PAL', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(SM.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'SOK', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , PI.CREDAT, PI.CRETIM, PI.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PI.CREUSR),' ') AS CUSRNM
			 , PI.LMODAT, PI.LMOTIM, PI.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PI.LMOUSR),' ') AS LUSRNM
			 , PI.CHKDAT, PI.CHKTIM, PI.CHKUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PI.CHKUSR),' ') AS CHKRNM
		  FROM PHYDH PH
		 INNER JOIN PHYDI PI ON PH.PHYIKY = PI.PHYIKY
		 INNER JOIN SKUMA SM ON PI.OWNRKY= SM.OWNRKY AND  PI.SKUKEY = SM.SKUKEY
		 
		 LEFT JOIN MATVAL MV ON MV.MATNR = PI.SKUKEY AND MV.BWKEY = PI.LOTA02 AND MV.MEINS = PI.UOMKEY
		 
		 WHERE 1=1
		   AND PI.PHYIKY = #{PHYIKY}
		   <if test="PHYIKY != null and PHYIKY != ''">AND PH.PHYIKY = #{PHYIKY}</if>
		   <if test="WAREKY != null and WAREKY != ''">AND PH.WAREKY = #{WAREKY}</if>
		   <if test="PHDTFR != null and PHDTFR != ''">AND PH.DOCDAT >= #{PHDTFR}</if>
		   <if test="PHDTTO != null and PHDTTO != ''">AND #{PHDTTO} >= PH.DOCDAT</if>
		   <if test="INDDCL != null and INDDCL != ''">AND PH.INDDCL = #{INDDCL}</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND SM.SKUL01 = #{SKUL01}</if>
		   <if test="SKUG01 != null and SKUG01 != ''">AND SM.SKUG01 = #{SKUG01}</if>
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(PI.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
		   <choose>
		       <when test='INDDCL == "Y"'>AND PH.INDDCL = 'V'</when>
		       <when test='INDDCL == "N"'>AND PH.INDDCL = ' '</when>
		   </choose>
		   <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
		 ORDER BY 1, 2
	</select>
	
	<!-- 재고실사 > 중간저장 -->
	<update id="PHYDI_UPDATE" parameterType="Map">
		UPDATE PHYDI SET
			  REFCAT = 'V'
			, QTSPHY = #{QTSPHY}
			, LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			, LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			, LMOUSR = #{SES_USER_ID}
		WHERE PHYIKY = #{PHYIKY}
		  AND PHYIIT = #{PHYIIT}
	</update>
	
	<!-- 재고실사 > 조사완료 -->
	<update id="PHYDH_CONFIRM_UPDATE" parameterType="Map">
		UPDATE PHYDH SET
			INDDCL = 'V',
			LMOUSR = #{SES_USER_ID},
			LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
			LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
		WHERE PHYIKY = #{PHYIKY}
	</update>
	
	<!-- 재고실사 > 엑셀업로드 -->
	<insert id="PHYDI_EXCEL_INSERT" parameterType="Map">
		INSERT INTO PHYDI (
			   PHYIKY
			 , PHYIIT
			 , AREAKY
			 , LOCAKY
			 , QTSPHY
			 , QTADJU
			 , REFCAT
			 , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05
			 , LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
			 , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15
			 , LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
			 , OWNRKY, SKUKEY, UOMKEY, DESC01, DESC02
			 , EANCOD, GTINCD
			 , ASKU01, ASKU02, ASKU03, ASKU04, ASKU05
			 , SKUG01, SKUG02, SKUG03, SKUG04, SKUG05
			 , GRSWGT, NETWGT, WGTUNT, LENGTH, WIDTHW
			 , HEIGHT, CUBICM, CAPACT
			 , CREDAT, CRETIM, CREUSR
			 , LMODAT, LMOTIM, LMOUSR
		)
		SELECT #{PHYIKY}                                                                   AS PHYIKY
			 , (SELECT LPAD(MAX(PHYIIT) + 10, 6, '0') FROM PHYDI WHERE PHYIKY = #{PHYIKY}) AS PHYIIT
			 , #{AREAKY}                                                                   AS AREAKY
			 , #{LOCAKY}                                                                   AS LOCAKY
			 , NVL(#{QTSPHY}, 0)                                                           AS QTSPHY
			 , NVL(#{QTSPHY}, 0) * -1                                                      AS QTADJU
			 , 'V'                                                                         AS REFCAT
			 , NVL(#{LOTA01}, ' '), NVL(#{LOTA02}, ' '), NVL(#{LOTA03}, ' '), NVL(#{LOTA04}, ' '), NVL(#{LOTA05}, ' ')
			 , NVL(#{LOTA06}, ' '), NVL(#{LOTA07}, ' '), NVL(#{LOTA08}, ' '), NVL(#{LOTA09}, ' '), NVL(#{LOTA10}, ' ')
			 , NVL(#{LOTA11}, ' '), NVL(#{LOTA12}, ' '), NVL(#{LOTA13}, ' '), NVL(#{LOTA14}, ' '), NVL(#{LOTA15}, ' ')
			 , NVL(#{LOTA16}, 0  ), NVL(#{LOTA17}, ' '), NVL(#{LOTA18}, 0  ), NVL(#{LOTA19}, 0  ), NVL(#{LOTA20}, 0  )
			 , SM.OWNRKY, SM.SKUKEY, SM.DUOMKY, SM.DESC01, SM.DESC02
			 , SM.EANCOD, SM.GTINCD
			 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
			 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
			 , SM.GRSWGT, SM.NETWGT, SM.WGTUNT, SM.LENGTH, SM.WIDTHW
			 , SM.HEIGHT, SM.CUBICM, SM.CAPACT
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
		  FROM       SKUMA SM
		  INNER JOIN SKUWC SW ON SW.OWNRKY = SM.OWNRKY AND SW.SKUKEY = SM.SKUKEY
		 WHERE SM.SKUKEY = #{SKUKEY}
		   AND SM.OWNRKY = #{OWNRKY}
		   AND SW.WAREKY = #{WAREKY}
	</insert>
	
	<!-- 재고실사 > 엑셀업로드 -->
	<update id="PHYDI_EXCEL_UPDATE" parameterType="Map">
		UPDATE PHYDI SET
			   QTSPHY = NVL(TO_NUMBER(#{QTSPHY}), 0)
			 , QTADJU = NVL(TO_NUMBER(#{QTSPHY}), 0) - QTSIWH
			 , REFCAT = 'V'
			 , QTYPDA = CASE WHEN NVL(TO_NUMBER(#{QTSPHY}), 0) > 0
			                 THEN NVL(TO_NUMBER(#{QTSPHY}), 0)
			                 ELSE 0 END
			 , LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			 , LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			 , LMOUSR = #{SES_USER_ID} 
		 WHERE PHYIKY = #{PHYIKY}
		   AND PHYIIT = #{PHYIIT}
	</update>
	
	<!-- PDA재고실사 > 재고실사번호 리스트 -->
	<select id="PDPC01_DOC_LIST" parameterType="Map" resultType="DataMap">
		SELECT 
			PH.PHYIKY, 
			PH.INDDCL, 
			PH.DOCDAT,
			PH.DOCTXT  
		FROM 
			PHYDH PH
		WHERE 1=1
		  AND PH.DOCDAT >= #{DOCDAT}
		ORDER BY PH.PHYIKY DESC 
	</select>
	
	<!-- PDA재고실사 > 재고실사 리스트 -->
	<select id="PDPC01_LIST" parameterType="Map" resultType="DataMap">
		SELECT PI.LOTA14
			 , PI.LOCAKY
			 , PI.SKUKEY, PI.DESC01
			 , SM.SKUL01, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , PI.AREAKY
			 , (SELECT ZONEKY FROM LOCMA WHERE WAREKY = PH.WAREKY AND LOCAKY = PI.LOCAKY) AS ZONEKY
			 , PH.DEPTID4                /* 'V' : 블라인드 */
			 , SUM(DECODE(PH.DEPTID4, 'V', 0, PI.QTSIWH)) AS QTSIWH
			 , SUM(PI.QTYPDA) AS QTYPDA
			 , SUM(PI.QTSPHY) AS QTSPHY
			 , SM.DUOMKY      AS UOMKEY
			 , NVL(TRIM(SZF_GET_CONVERT_QTY(PH.WAREKY, PI.SKUKEY, SUM(DECODE(PH.DEPTID4, 'V', 0, PI.QTSIWH)), SM.DUOMKY, 'BOX')),'0') AS BOX
		  FROM PHYDH PH
		  INNER JOIN PHYDI PI ON PI.PHYIKY = PH.PHYIKY
		  INNER JOIN SKUMA SM ON SM.OWNRKY = PI.OWNRKY AND SM.SKUKEY = PI.SKUKEY
		  WHERE 1=1
		<if test="PHYIKY != null and PHYIKY != ''">AND PH.PHYIKY = #{PHYIKY}</if>
		<if test="WAREKY != null and WAREKY != ''">AND PH.WAREKY = #{WAREKY}</if>
		<if test='searchType == "N"'>AND  PH.INDDCL != 'V' AND PI.REFCAT != 'V'                             /* 미조사  */</if>
		<if test='searchType == "F"'>AND  PH.INDDCL != 'V' AND PI.REFCAT = 'V'                             /* 조사완료  */</if>
		<if test='searchType == "G"'>AND (PH.INDDCL  = 'V' OR  PI.REFCAT  = 'V') AND PI.QTYPDA != PI.QTSIWH /* 실사차이 */</if>
		<if test='SES_DEVICE_TYPE == "M"'>
			AND PI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE})
		</if>
		<if test="LOTA01 != null and LOTA01 != ''">AND PI.LOTA01 = #{LOTA01}</if>
		<if test="LOTA02 != null and LOTA02 != ''">AND PI.LOTA02 = #{LOTA02}</if>
		 GROUP BY PI.LOTA14, PI.LOCAKY, PI.SKUKEY
		 	 , PH.WAREKY, PH.DEPTID4, PI.AREAKY
		 	 , SM.DUOMKY, PI.DESC01 , SM.SKUL01
		 ORDER BY PI.LOTA14, PI.LOCAKY, PI.SKUKEY
	</select>
	
	<!-- PDA재고실사 > 재고실사 상세리스트 -->
	<select id="PDPC01_DTL_LIST" parameterType="Map" resultType="DataMap">
		SELECT PH.DEPTID4 /* 'V' : 블라인드 */
			 , PI.PHYIKY
			 , PI.PHYIIT
			 , PI.AREAKY
			 , PI.LOCAKY
			 , PI.SKUKEY
			 , PI.DESC01
			 , PI.QTYPDA
			 , PI.QTSPHY
			 , PI.QTSPHY - PI.QTSIWH AS QTADJU
			 , PI.QTSIWH
			 , PI.QTSALO
			 , PI.QTSPMO
			 , PI.QTSPMI
			 , CASE WHEN PI.AREAKY = 'SHP' THEN 0
					ELSE PI.QTSIWH - PI.QTBLKD
								   - GREATEST(PI.QTSALO, PI.QTSPMO)
								   - (CASE WHEN PI.LOTA06 IN ('00') OR PI.QTSPMO > 0 THEN 0 ELSE PI.QTSIWH END)
				END AS QTABLE
			 , PI.QTSIQT /* 품질 : Inspection QuanTity */
			 , PI.QTSHQT /* 보류 : Hold       QuanTity */
			 , PI.QTSCNU /* 불용 : Can Not Use         */
			 , PI.QTSWQT /* 폐기 : Wasted     QuanTity */
			 , PI.LOTA01, PI.LOTA02, PI.LOTA03, PI.LOTA04, PI.LOTA05
			 , PI.LOTA06, PI.LOTA07, PI.LOTA08, PI.LOTA09, PI.LOTA10
			 , PI.LOTA11, PI.LOTA12, PI.LOTA13, PI.LOTA14, PI.LOTA15
			 , PI.LOTA16, PI.LOTA17, PI.LOTA18, PI.LOTA19, PI.LOTA20
			/*
			 , PI.RSNADJ AS ADJDES
			 , PI.ADJRSN AS ADJRSN
			*/
			 , SM.DUOMKY AS UOMKEY
			 , PH.WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = PH.WAREKY) AS WARENM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', PI.LOTA06) AS LOTA06NM
			 , (SELECT ZONEKY FROM LOCMA WHERE WAREKY = PH.WAREKY AND LOCAKY = PI.LOCAKY) AS ZONEKY
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(SM.DUOMKY, 'KG' , PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'BAG', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'BOX', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(SM.DUOMKY, 'PAL', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(SM.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'SOK', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , PI.CREDAT, PI.CRETIM, PI.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PI.CREUSR),' ') AS CUSRNM
			 , PI.LMODAT, PI.LMOTIM, PI.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PI.LMOUSR),' ') AS LUSRNM
		  FROM PHYDH PH
		  INNER JOIN PHYDI PI ON PI.PHYIKY = PH.PHYIKY
		  INNER JOIN SKUMA SM ON SM.OWNRKY = PI.OWNRKY AND SM.SKUKEY = PI.SKUKEY
		  WHERE 1=1
		  <if test="PHYIKY != null and PHYIKY != ''">AND PH.PHYIKY = #{PHYIKY}</if>
		  <if test="SKUKEY != null and SKUKEY != ''">AND PI.SKUKEY = #{SKUKEY}</if>
		  <if test="LOTA14 != null and LOTA14 != ''">AND PI.LOTA14 = #{LOTA14}</if>
		  <if test="LOCAKY != null and LOCAKY != ''">AND PI.LOCAKY = #{LOCAKY}</if>
		  <if test='searchType == "N"'>AND  PH.INDDCL != 'V' AND PI.REFCAT != 'V'                             /* 미조사  */</if>
		  <if test='searchType == "G"'>AND (PH.INDDCL  = 'V' OR  PI.REFCAT  = 'V') AND PI.QTYPDA != PI.QTSIWH /* 실사차이 */</if>
		 ORDER BY LOTA14
	</select>
	
	<!-- PDA재고실사 > 저장 -->
	<update id="PDA_PHYDI_UPDATE" parameterType="Map">
		UPDATE PHYDI SET
			  REFCAT = 'V'
			, QTSPHY = #{QTYPDA}
			, QTYPDA = #{QTYPDA}
			, LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			, LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			, LMOUSR = #{SES_USER_ID}
			, CHKDAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
			, CHKTIM = TO_CHAR(SYSDATE, 'HH24MISS')
			, CHKUSR = #{SES_USER_ID}
		 <if test="LOCAKY != null and LOCAKY != ''">
		 	, LOCAKY = #{LOCAKY}
	 	</if>
		WHERE PHYIKY = #{PHYIKY}
		  AND PHYIIT = #{PHYIIT}
	</update>
	
	<!-- 재고실사 > 등록 -->
	<select id="PDPC01_NEW_LIST" parameterType="Map" resultType="DataMap">
		SELECT ST.LOTA14
			 , ST.LOCAKY, ST.ZONEKY, ST.AREAKY
			 , SUM(ST.QTSIWH) AS QTYPDA
			 , SUM(ST.QTSIWH) AS QTSIWH
			 , SUM(ST.QTSALO) AS QTSALO
			 , SUM(ST.QTSPMO) AS QTSPMO
			 , SUM(ST.QTSPMI) AS QTSPMI
			 , SUM(ST.QTSBLK) AS QTBLKD
			 , SUM(ST.QTYUOM) AS QTYUOM
			 , SM.DUOMKY      AS UOMKEY
			 , SM.SKUKEY
			 , ST.DESC01
			 , ST.LOTA01, ST.LOTA02
			 , ST.WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = ST.WAREKY)       AS WARENM
			 , SM.SKUL01, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
		  FROM STKKY ST
		 INNER JOIN SKUMA SM ON SM.OWNRKY = ST.OWNRKY AND SM.SKUKEY = ST.SKUKEY
		 WHERE QTSIWH > 0
		   AND ST.LOTA14 = #{BARCOD}
		 GROUP BY ST.LOTA14
				, ST.LOCAKY, ST.ZONEKY, ST.AREAKY
				, ST.LOTA01, ST.LOTA02, ST.WAREKY
				, SM.SKUKEY, ST.DESC01, SM.DUOMKY, SM.SKUL01
		 ORDER BY ST.LOTA14, ST.LOCAKY, SM.SKUKEY
	</select>
	
	<!-- PDA재고실사 테스트 > 재고실사 리스트 -->
	<select id="PDPC02_LIST" parameterType="Map" resultType="DataMap">
		SELECT PI.LOTA14
			 , PI.LOCAKY
			 , PI.SKUKEY, PI.DESC01
			 , SM.SKUL01, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , PI.AREAKY
			 , (SELECT ZONEKY FROM LOCMA WHERE WAREKY = PH.WAREKY AND LOCAKY = PI.LOCAKY) AS ZONEKY
			 , PH.DEPTID4                /* 'V' : 블라인드 */
			 , MAX(PI.LMODAT) MAX_LMODAT
			 , MAX(PI.LMOTIM) MAX_LMOTIM
			 , SUM(DECODE(PH.DEPTID4, 'V', 0, PI.QTSIWH)) AS QTSIWH
			 , SUM(PI.QTYPDA) AS QTYPDA
			 , SUM(PI.QTSPHY) AS QTSPHY
			 --, NVL(SM.DUOMKY, 'BAG')	AS UOMKEY
			 , CASE 
		          WHEN PI.UOMKEY = 'BOX' THEN PI.UOMKEY
		          ELSE NVL(SM.DUOMKY, 'BAG') 
		       END AS UOMKEY
			 , CASE 
		          WHEN PI.UOMKEY = 'BOX' THEN TRIM(SUM(PI.QTYPDA))
		          ELSE NVL(TRIM(SZF_GET_CONVERT_QTY(PH.WAREKY, PI.SKUKEY, SUM(DECODE(PH.DEPTID4, 'V', 0, PI.QTYPDA)), SM.DUOMKY, 'BOX')), '0')
		       END AS BOX
			 --, NVL(TRIM(SZF_GET_CONVERT_QTY(PH.WAREKY, PI.SKUKEY, SUM(DECODE(PH.DEPTID4, 'V', 0, PI.QTYPDA)), SM.DUOMKY, 'BOX')),'0') AS BOX
		  FROM PHYDH PH
		  INNER JOIN PHYDI PI ON PI.PHYIKY = PH.PHYIKY
		  LEFT JOIN SKUMA SM ON SM.OWNRKY = PI.OWNRKY AND SM.SKUKEY = PI.SKUKEY 
		  WHERE 1=1
		<if test="PHYIKY != null and PHYIKY != ''">AND PH.PHYIKY = #{PHYIKY}</if>
		<if test="WAREKY != null and WAREKY != ''">AND PH.WAREKY = #{WAREKY}</if>
		<if test='searchType == "N"'>AND  PH.INDDCL != 'V' AND PI.REFCAT != 'V'                   /* 미조사  */</if>
		<if test='searchType == "F"'>AND  PH.INDDCL != 'V' AND PI.REFCAT = 'V'                              /* 조사완료  */</if>
		<if test='searchType == "G"'>AND (PH.INDDCL  = 'V' OR  PI.REFCAT  = 'V') AND PI.QTYPDA != PI.QTSIWH /* 실사차이 */</if>
		<if test='SES_DEVICE_TYPE == "M"'>
			AND PI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE})
		</if>
		<if test="LOTA01 != null and LOTA01 != ''">AND PI.LOTA01 = #{LOTA01}</if>
		<if test="LOTA02 != null and LOTA02 != ''">AND PI.LOTA02 = #{LOTA02}</if>
		<if test="BARCOD != null and BARCOD != ''">AND PI.LOTA14 = #{BARCOD}</if>
		 GROUP BY PI.LOTA14, PI.LOCAKY, PI.SKUKEY
		 	 , PH.WAREKY, PH.DEPTID4, PI.AREAKY
		 	 , SM.DUOMKY, PI.DESC01 , SM.SKUL01, PI.UOMKEY
		 ORDER BY MAX_LMODAT DESC, MAX_LMOTIM DESC 
	</select>
	
	<!-- PDA재고실사 테스트 > 재고실사 리스트 카운트-->
	<select id="PDPC02_COUNT" parameterType="Map" resultType="Integer">
		SELECT COUNT(T1.LOTA14) AS COUNT
		FROM (
			SELECT PI.LOTA14
			 , PI.LOCAKY
			 , PI.SKUKEY, PI.DESC01
			 , SM.SKUL01, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , PI.AREAKY
			 , (SELECT ZONEKY FROM LOCMA WHERE WAREKY = PH.WAREKY AND LOCAKY = PI.LOCAKY) AS ZONEKY
			 , PH.DEPTID4                /* 'V' : 블라인드 */
			 , SUM(DECODE(PH.DEPTID4, 'V', 0, PI.QTSIWH)) AS QTSIWH
			 , SUM(PI.QTYPDA) AS QTYPDA
			 , SUM(PI.QTSPHY) AS QTSPHY
			 , NVL(SM.DUOMKY, 'BAG')	AS UOMKEY
		  FROM PHYDH PH
		  INNER JOIN PHYDI PI ON PI.PHYIKY = PH.PHYIKY
		  LEFT JOIN SKUMA SM ON SM.OWNRKY = PI.OWNRKY AND SM.SKUKEY = PI.SKUKEY 
		  WHERE 1=1
			<if test="PHYIKY != null and PHYIKY != ''">AND PH.PHYIKY = #{PHYIKY}</if>
			<if test="WAREKY != null and WAREKY != ''">AND PH.WAREKY = #{WAREKY}</if>
			<if test='searchType == "N"'>AND  PH.INDDCL != 'V' AND PI.REFCAT != 'V'                   /* 미조사  */</if>
			<if test='searchType == "F"'>AND  PH.INDDCL != 'V' AND PI.REFCAT = 'V'                              /* 조사완료  */</if>
			<if test='searchType == "G"'>AND (PH.INDDCL  = 'V' OR  PI.REFCAT  = 'V') AND PI.QTYPDA != PI.QTSIWH /* 실사차이 */</if>
			<if test='SES_DEVICE_TYPE == "M"'>
				AND PI.LOTA02 IN (SELECT PLNTKY FROM MTPLNT WHERE WAREKY = #{WAREKY} AND MTYPE LIKE '%' || #{SES_MTYPE})
			</if>
			<if test="LOTA01 != null and LOTA01 != ''">AND PI.LOTA01 = #{LOTA01}</if>
			<if test="LOTA02 != null and LOTA02 != ''">AND PI.LOTA02 = #{LOTA02}</if>
		  GROUP BY PI.LOTA14, PI.LOCAKY, PI.SKUKEY, PH.WAREKY, PH.DEPTID4, PI.AREAKY, SM.DUOMKY, PI.DESC01 , SM.SKUL01
		  ) T1 
	</select>
	
	<!-- PDA재고실사 테스트 > 재고실사 상세리스트 -->
	<select id="PDPC02_DTL_LIST" parameterType="Map" resultType="DataMap">
		SELECT PH.DEPTID4 /* 'V' : 블라인드 */
			 , PI.PHYIKY
			 , PI.PHYIIT
			 , PI.AREAKY
			 , PI.LOCAKY
			 , PI.SKUKEY
			 , PI.DESC01
			 , PI.QTYPDA
			 , PI.QTSPHY
			 , PI.QTSPHY - PI.QTSIWH AS QTADJU
			 , PI.QTSIWH
			 , PI.QTSALO
			 , PI.QTSPMO
			 , PI.QTSPMI
			 , CASE WHEN PI.AREAKY = 'SHP' THEN 0
					ELSE PI.QTSIWH - PI.QTBLKD
								   - GREATEST(PI.QTSALO, PI.QTSPMO)
								   - (CASE WHEN PI.LOTA06 IN ('00') OR PI.QTSPMO > 0 THEN 0 ELSE PI.QTSIWH END)
				END AS QTABLE
			 , PI.QTSIQT /* 품질 : Inspection QuanTity */
			 , PI.QTSHQT /* 보류 : Hold       QuanTity */
			 , PI.QTSCNU /* 불용 : Can Not Use         */
			 , PI.QTSWQT /* 폐기 : Wasted     QuanTity */
			 , PI.LOTA01, PI.LOTA02, PI.LOTA03, PI.LOTA04, PI.LOTA05
			 , PI.LOTA06, PI.LOTA07, PI.LOTA08, PI.LOTA09, PI.LOTA10
			 , PI.LOTA11, PI.LOTA12, PI.LOTA13, PI.LOTA14, PI.LOTA15
			 , PI.LOTA16, PI.LOTA17, PI.LOTA18, PI.LOTA19, PI.LOTA20
			 , NVL(SM.DUOMKY, 'BAG') AS UOMKEY
			 , DECODE(NVL(SM.DUOMKY, 'BAG'), 'BAG', 'BOX', SM.DUOMKY) UOMKEY2
			 , PH.WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = PH.WAREKY) AS WARENM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SM.SKUL01) AS SKUL01NM
			 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', PI.LOTA06) AS LOTA06NM
			 , (SELECT ZONEKY FROM LOCMA WHERE WAREKY = PH.WAREKY AND LOCAKY = PI.LOCAKY) AS ZONEKY
			 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
			 , NVL(DECODE(SM.DUOMKY, 'KG' , PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'KG'
											)
			   ), 0) AS TOTWG /* 총중량 */
			 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'BAG', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'BAG'
											)
			   ), 0), 0) AS BAGQT /* EA/BAG */
			 , NVL(DECODE(SM.SKUG05, '20', /* HL인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'BOX', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'BOX'
											)
			   ), 0), 0) AS BOXQT /* BAG/BOX */
			 , NVL(DECODE(SM.DUOMKY, 'PAL', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'PAL'
											)
			   ), 0) AS PLTQT /* BOX/Pallet */
			 , NVL(DECODE(SM.SKUG05, '10', /* PS인 경우만 노출 */
				   DECODE(SM.DUOMKY, 'SOK', PI.QTSIWH
										  , (SELECT DECODE(SM.DUOMKY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = PH.WAREKY AND MEASKY = PI.SKUKEY AND INDDFU = 'V')
																	, TO_NUMBER(ROUND(PI.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																	, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY)) / (MI.QTPUOM / MI.QTAUOM), 3))
														 )
											   FROM MEASI MI
											  WHERE MI.WAREKY = PH.WAREKY AND MI.MEASKY = PI.SKUKEY AND MI.UOMKEY = 'SOK'
											)
			   ), 0), 0) AS SOKQT /* 속(개/BALE) */
			 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(PH.WAREKY, PI.SKUKEY, PI.QTSIWH, SM.DUOMKY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
			 , PI.CREDAT, PI.CRETIM, PI.CREUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PI.CREUSR),' ') AS CUSRNM
			 , PI.LMODAT, PI.LMOTIM, PI.LMOUSR, NVL((SELECT NMLAST FROM USRMA WHERE USERID = PI.LMOUSR),' ') AS LUSRNM
			 , CASE 
				WHEN MIPBOX.QTPUOM = 0 THEN 0 
				ELSE NVL((MIPPAL.QTPUOM / MIPBOX.QTPUOM),'0') 
			  END AS BOXPAL
			 ,(SELECT COUNT(ST.STOKKY) FROM STKKY ST WHERE ST.LOTA14 = PI.LOTA14 AND ST.QTSIWH > 0 AND ST.LOTA06 = '00') AS STOKKYCOUNT
		  FROM PHYDH PH
		  INNER JOIN PHYDI PI ON PI.PHYIKY = PH.PHYIKY
		  LEFT JOIN SKUMA SM ON SM.OWNRKY = PI.OWNRKY AND SM.SKUKEY = PI.SKUKEY 
		  LEFT JOIN MEASI MIPBOX ON (PI.SKUKEY = MIPBOX.MEASKY AND MIPBOX.UOMKEY = 'BOX' AND MIPBOX.WAREKY = #{WAREKY}  ) 
		  LEFT JOIN MEASI MIPPAL ON (PI.SKUKEY = MIPPAL.MEASKY AND MIPPAL.UOMKEY = 'PAL' AND MIPPAL.WAREKY = #{WAREKY}  ) 
		  WHERE 1=1
		  <if test="PHYIKY != null and PHYIKY != ''">AND PH.PHYIKY = #{PHYIKY}</if>
		  <if test="SKUKEY != null and SKUKEY != ''">AND PI.SKUKEY = #{SKUKEY}</if>
		  <if test="LOTA14 != null and LOTA14 != ''">AND PI.LOTA14 = #{LOTA14}</if>
		  <if test="LOCAKY != null and LOCAKY != ''">AND PI.LOCAKY = #{LOCAKY}</if>
		  <if test='searchType == "N"'>AND  PH.INDDCL != 'V' AND PI.REFCAT != 'V'                             /* 미조사  */</if>
		  <if test='searchType == "G"'>AND (PH.INDDCL  = 'V' OR  PI.REFCAT  = 'V') AND PI.QTYPDA != PI.QTSIWH /* 실사차이 */</if>
		 ORDER BY LOTA14
	</select>
	
	<!-- 재고실사 테스트 > 등록 -->
	<select id="PDPC02_NEW_LIST" parameterType="Map" resultType="DataMap">
		SELECT A.LOTA14
			, A.LOCAKY, ' ' AS ZONEKY, A.AREAKY
			, A.WAREKY
			, (SELECT NAME01 FROM WAHMA WHERE WAREKY = A.WAREKY) AS WARENM
			, 0 AS QTYPDA
			, 0 AS QTSIWH
			, 0 AS QTSALO
			, 0 AS QTSPMO
			, 0 AS QTSPMI
			, 0 AS QTBLKD
			, A.QTYUOM
			, A.UOMKEY
			, A.SKUKEY
			, A.DESC01
			, A.LOTA01, A.LOTA02
			, ' ' AS WAREKY, ' ' AS WARENM
			, ' ' AS SKUL01, ' ' AS SKUL01NM 
			, MIPBOX.QTPUOM AS BOXRATIO 
			, CASE 
				WHEN MIPBOX.QTPUOM = 0 THEN 0 
				ELSE NVL((MIPPAL.QTPUOM / MIPBOX.QTPUOM),'0') 
			  END AS BOXPAL 
		FROM (
			SELECT RH.WAREKY, RI.*  
			FROM RECDI RI 
			INNER JOIN RECDH RH ON (RI.RECVKY = RH.RECVKY AND RH.WAREKY = #{WAREKY})
			WHERE LOTA14 = #{BARCOD} ORDER BY RI.RECVKY DESC
		) A 
		INNER JOIN MEASI MIPBOX ON (A.SKUKEY = MIPBOX.MEASKY AND MIPBOX.UOMKEY = 'BOX' AND MIPBOX.WAREKY = #{WAREKY}  ) 
		INNER JOIN MEASI MIPPAL ON (A.SKUKEY = MIPPAL.MEASKY AND MIPPAL.UOMKEY = 'PAL' AND MIPPAL.WAREKY = #{WAREKY}  ) 
		WHERE ROWNUM = 1 
	</select>
	
	<!-- PDSKU_POP -->
	<select id="SKUMA_LIST" parameterType="Map" resultType="DataMap">
		SELECT SKUKEY
			 , DESC01, DUOMKY AS UOMKEY
			 , #{WAREKY} AS WAREKY, (SELECT NAME01 FROM WAHMA WHERE WAREKY = #{WAREKY}) AS WARENM
			 , SKUL01, SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', SKUL01)           AS SKUL01NM
		  FROM SKUMA
		 WHERE 1=1
		   AND OWNRKY = #{OWNRKY}
		   <if test="SKUKEY != null and SKUKEY != ''">AND SKUKEY = #{SKUKEY}</if>
		   <if test="SKUL01 != null and SKUL01 != ''">AND SKUL01 = #{SKUL01}</if>
		   <if test="DESC01 != null and DESC01 != ''">AND UPPER(DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
	</select>
	
	<insert id="PDA_PHYDI_NEW_INSERT" parameterType="Map">
		INSERT INTO PHYDI (
			   PHYIKY, PHYIIT, AREAKY, LOCAKY, TRNUID
			 , QTADJU, QTSPHY, QTYPDA, QTSIWH, QTSALO
			 , QTSPMO, QTSPMI, QTBLKD, UOMKEY
			 , OWNRKY, SKUKEY
			 , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05
			 , LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
			 , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15
			 , LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
			 , DESC01, DESC02
			 , ASKU01, ASKU02, ASKU03, ASKU04, ASKU05
			 , EANCOD, GTINCD
			 , SKUG01, SKUG02, SKUG03, SKUG04, SKUG05
			 , GRSWGT, NETWGT, WGTUNT, LENGTH, WIDTHW
			 , HEIGHT, CUBICM, CAPACT, RSNADJ, ADJRSN
			 , CREDAT, CRETIM, CREUSR
			 , LMODAT, LMOTIM, LMOUSR
			 , INDBZL, INDARC, UPDCHK
		)
		SELECT #{PHYIKY}           AS PHYIKY
			 , (SELECT LPAD(MAX(PHYIIT) + 10, 6, '0') FROM PHYDI WHERE PHYIKY = #{PHYIKY}) AS PHYIIT
			 , (SELECT DISTINCT AREAKY                FROM LOCMA WHERE LOCAKY = #{LOCAKY}) AS AREAKY
			 , #{LOCAKY}           AS LOCAKY
			 , NVL(#{TRNUID}, ' ') AS TRNUID
			 , 0                   AS QTADJU
			 , 0                   AS QTSPHY
			 , #{QTYPDA}           AS QTYPDA
			 , NVL(#{QTSIWH}, 0  ) AS QTSIWH
			 , NVL(#{QTSALO}, 0  ) AS QTSALO
			 , NVL(#{QTSPMO}, 0  ) AS QTSPMO
			 , NVL(#{QTSPMI}, 0  ) AS QTSPMI
			 , 0                   AS QTBLKD
			 , SM.DUOMKY           AS UOMKEY
			 , SM.OWNRKY           AS OWNRKY
			 , SM.SKUKEY           AS SKUKEY
			 , NVL(#{LOTA01}, ' ') AS LOTA01
			 , NVL(#{LOTA02}, ' ') AS LOTA02
			 , NVL(#{LOTA03}, ' ') AS LOTA03
			 , NVL(#{LOTA04}, ' ') AS LOTA04
			 , NVL(#{LOTA05}, ' ') AS LOTA05
			 , NVL(#{LOTA06}, ' ') AS LOTA06
			 , NVL(#{LOTA07}, ' ') AS LOTA07
			 , NVL(#{LOTA08}, ' ') AS LOTA08
			 , NVL(#{LOTA09}, ' ') AS LOTA09
			 , NVL(#{LOTA10}, ' ') AS LOTA10
			 , NVL(#{LOTA11}, ' ') AS LOTA11
			 , NVL(#{LOTA12}, ' ') AS LOTA12
			 , NVL(#{LOTA13}, ' ') AS LOTA13
			 , NVL(#{LOTA14}, ' ') AS LOTA14
			 , NVL(#{LOTA15}, ' ') AS LOTA15
			 , NVL(#{LOTA16}, 0  ) AS LOTA16
			 , NVL(#{LOTA17}, ' ') AS LOTA17
			 , NVL(#{LOTA18}, 0  ) AS LOTA18
			 , NVL(#{LOTA19}, 0  ) AS LOTA19
			 , NVL(#{LOTA20}, 0  ) AS LOTA20
			 , SM.DESC01, SM.DESC02
			 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
			 , SM.EANCOD, SM.GTINCD
			 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
			 , SM.GRSWGT, SM.NETWGT, SM.WGTUNT, SM.LENGTH, SM.WIDTHW
			 , SM.HEIGHT, SM.CUBICM, SM.CAPACT, ' ' AS RSNADJ, ' ' AS ADJRSN
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			 , ' ', ' ', 0
		  FROM SKUMA SM
		  INNER JOIN SKUWC SW ON SW.WAREKY = #{WAREKY} AND SW.OWNRKY = SM.OWNRKY AND SW.SKUKEY = SM.SKUKEY
		 WHERE SM.OWNRKY = #{OWNRKY}
		   AND SM.SKUKEY = #{SKUKEY}
	</insert>
	
	<insert id="PDA_PHYDI_NEW2_INSERT" parameterType="Map">
		INSERT INTO PHYDI (
			   PHYIKY, PHYIIT, AREAKY, LOCAKY, TRNUID
			 , QTADJU, QTSPHY, QTYPDA, QTSIWH, QTSALO
			 , QTSPMO, QTSPMI, QTBLKD, UOMKEY
			 , OWNRKY, SKUKEY
			 , LOTA01, LOTA02, LOTA03, LOTA04, LOTA05
			 , LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
			 , LOTA11, LOTA12, LOTA13, LOTA14, LOTA15
			 , LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
			 , DESC01, DESC02
			 , ASKU01, ASKU02, ASKU03, ASKU04, ASKU05
			 , EANCOD, GTINCD
			 , SKUG01, SKUG02, SKUG03, SKUG04, SKUG05
			 , GRSWGT, NETWGT, WGTUNT, LENGTH, WIDTHW
			 , HEIGHT, CUBICM, CAPACT, RSNADJ, ADJRSN
			 , CREDAT, CRETIM, CREUSR, CHKUSR
			 , LMODAT, LMOTIM, LMOUSR
			 , INDBZL, INDARC, UPDCHK
			 , REFCAT
		)
		SELECT #{PHYIKY}           AS PHYIKY
			 , (SELECT LPAD(MAX(PHYIIT) + 10, 6, '0') FROM PHYDI WHERE PHYIKY = #{PHYIKY}) AS PHYIIT
			 , (SELECT DISTINCT AREAKY                FROM LOCMA WHERE LOCAKY = #{LOCAKY} AND WAREKY = #{WAREKY}) AS AREAKY
			 , #{LOCAKY}           AS LOCAKY
			 , NVL(#{TRNUID}, ' ') AS TRNUID
			 , 0                   AS QTADJU
			 , 0                   AS QTSPHY
			 , #{QTYPDA}           AS QTYPDA
			 , NVL(#{QTSIWH}, 0  ) AS QTSIWH
			 , NVL(#{QTSALO}, 0  ) AS QTSALO
			 , NVL(#{QTSPMO}, 0  ) AS QTSPMO
			 , NVL(#{QTSPMI}, 0  ) AS QTSPMI
			 , 0                   AS QTBLKD
			 , NVL(#{UOMKEY}, ' ') AS UOMKEY
			 , NVL(#{OWNRKY}, ' ') AS OWNRKY
			 , NVL(#{SKUKEY}, ' ') AS SKUKEY
			 , NVL(#{LOTA01}, ' ') AS LOTA01
			 , NVL(#{LOTA02}, ' ') AS LOTA02
			 , NVL(#{LOTA03}, ' ') AS LOTA03
			 , NVL(#{LOTA04}, ' ') AS LOTA04
			 , NVL(#{LOTA05}, ' ') AS LOTA05
			 , NVL(#{LOTA06}, ' ') AS LOTA06
			 , NVL(#{LOTA07}, ' ') AS LOTA07
			 , NVL(#{LOTA08}, ' ') AS LOTA08
			 , NVL(#{LOTA09}, ' ') AS LOTA09
			 , NVL(#{LOTA10}, ' ') AS LOTA10
			 , NVL(#{LOTA11}, ' ') AS LOTA11
			 , NVL(#{LOTA12}, ' ') AS LOTA12
			 , NVL(#{LOTA13}, ' ') AS LOTA13
			 , NVL(#{LOTA14}, ' ') AS LOTA14
			 , NVL(#{LOTA15}, ' ') AS LOTA15
			 , NVL(#{LOTA16}, 0  ) AS LOTA16
			 , NVL(#{LOTA17}, ' ') AS LOTA17
			 , NVL(#{LOTA18}, 0  ) AS LOTA18
			 , NVL(#{LOTA19}, 0  ) AS LOTA19
			 , NVL(#{LOTA20}, 0  ) AS LOTA20
			 , NVL(#{DESC01}, 0  ) AS DESC01
			 , ' ' AS DESC02
			 , ' ' AS ASKU01
			 , ' ' AS ASKU02
			 , ' ' AS ASKU03
			 , ' ' AS ASKU04
			 , ' ' AS ASKU05
			 , ' ' AS EANCOD
			 , ' ' AS GTINCD
			 , ' ' AS SKUG01
			 , ' ' AS SKUG02
			 , ' ' AS SKUG03
			 , ' ' AS SKUG04
			 , ' ' AS SKUG05
			 , 0   AS GRSWGT
			 , 0   AS NETWGT
			 , ' ' AS WGTUNT
			 , 0   AS LENGTH
			 , 0   AS WIDTHW
			 , 0   AS HEIGHT
			 , 0   AS CUBICM
			 , 0   AS CAPACT
			 , ' ' AS RSNADJ
			 , ' ' AS ADJRSN
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}, #{SES_USER_ID}
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			 , ' '
			 , ' '
			 , 0
			 , 'V' AS REFCAT -- 조사완료
		  FROM DUAL 
	</insert>
	
	<select id="IP10_BACK_LIST" parameterType="Map" resultType="DataMap">
		SELECT MANDT
			 , X1, X2, X3, X4, X5, X6, X7, X8, X9, X10, X11, X12, X13, X14, X15, X16, X17, X18, X19, X20
		FROM IFWMS999
	</select>
	
	<select id="IP10_LIST" parameterType="Map" resultType="DataMap">
		SELECT SUM(DECODE(MANDT, '100', 0, SEQNO)) AS WMSAMT
			 , SUM(DECODE(MANDT, '100', SEQNO, 0)) AS SAPAMT
			 , SUM(SEQNO * DECODE(MANDT, '100', -1, 1)) AS DIFAMT
			 , X1, X2, X3, X4, X5, X6, X7, X8, X9, X10, X11, X12, X13, X14, X15, X16, X17, X18, X19, X20
		FROM IFWMS999
		GROUP BY X1, X2, X3, X4, X5, X6, X7, X8, X9, X10, X11, X12, X13, X14, X15, X16, X17, X18, X19, X20
	</select>
	
	<select id="ADJDI_TASKKY_LIST" parameterType="Map" resultType="DataMap">
		SELECT #{SADJKY} AS SADJKY
			 , #{SADJIT} AS SADJIT
			 , NVL(#{ARSNADJ}, ' ') AS RSNADJ
			 , ST.STOKKY AS STOKKY
			 , ST.LOTNUM AS LOTNUM
			 , TR.QTSTKC AS QTADJU
			 , 0         AS QTBLKD
			 , TR.QTSTKC AS QTYUOM
			 , ST.DESC01
			 , ST.DESC02
			 , ST.LOTA01, ST.LOTA02, ST.LOTA03, ST.LOTA04, ST.LOTA05
			 , ST.LOTA06, ST.LOTA07, ST.LOTA08, ST.LOTA09, ST.LOTA10
			 , ST.LOTA11, ST.LOTA12, ST.LOTA13, ST.LOTA14, ST.LOTA15
			 , ST.LOTA16, ST.LOTA17, ST.LOTA18, ST.LOTA19, ST.LOTA20
			 , CASE WHEN     #{DOCUTY}  = '402'                            /* 재고상태변경 시                     */
			             AND ST.LOTA02 != 'P400'                           /* 플랜트가 P400 제외                  */
			             AND ST.WAREKY IN ('1100', '1500')                 /* 거점이 1100, 1500에 해당            */
			             AND #{ALOTA06} IN ('10', '30', '50')              /* TO재고상태가 보류, 불용, 폐기에 해당 */
			                 THEN DECODE(SM.SKUG05, '00', '1900', '3900')  /* 원자재: 1900, 그 외 3900           */
			 		ELSE          NVL(#{ALOTA01}, ST.LOTA01)
			 	END                       AS ALOTA01
			 , NVL(#{ALOTA02}, ST.LOTA02) AS ALOTA02
			 , NVL(#{ALOTA03}, ST.LOTA03) AS ALOTA03
			 , NVL(#{ALOTA04}, ST.LOTA04) AS ALOTA04
			 , NVL(#{ALOTA05}, ST.LOTA05) AS ALOTA05
			 , NVL(#{ALOTA06}, ST.LOTA06) AS ALOTA06
			 , NVL(#{ALOTA07}, ST.LOTA07) AS ALOTA07
			 , NVL(#{ALOTA08}, ST.LOTA08) AS ALOTA08
			 , NVL(#{ALOTA09}, ST.LOTA09) AS ALOTA09
			 , CASE WHEN     #{DOCUTY}  = '402'        /* 재고상태변경 시            */
			             AND #{ALOTA06} = '10'         /* TO재고상태가 보류라면       */
			                 THEN NVL(#{AADJRSN}, ' ') /* LOTA10에 보류사유 SETTING */
			 		ELSE          NVL(#{ALOTA10}, ST.LOTA10)
			 	END                       AS ALOTA10
			 , NVL(#{ALOTA11}, ST.LOTA11) AS ALOTA11
			 , NVL(#{ALOTA12}, ST.LOTA12) AS ALOTA12
			 , NVL(#{ALOTA13}, ST.LOTA13) AS ALOTA13
			 , NVL(#{ALOTA14}, ST.LOTA14) AS ALOTA14
			 , NVL(#{ALOTA15}, ST.LOTA15) AS ALOTA15
			 , NVL(#{ALOTA16}, ST.LOTA16) AS ALOTA16
			 , NVL(#{ALOTA17}, ST.LOTA17) AS ALOTA17
			 , NVL(#{ALOTA18}, ST.LOTA18) AS ALOTA18
			 , NVL(#{ALOTA19}, ST.LOTA19) AS ALOTA19
			 , NVL(#{ALOTA20}, ST.LOTA20) AS ALOTA20
			 , NVL(#{ALOCAKY}, ST.LOCAKY) AS LOCAKY
			 , NVL(#{AADJRSN}, ' ')       AS AADJRSN
			 , ST.TRNUID, ST.SECTID, ST.PACKID, ST.TRUNTY
			 , ST.MEASKY, SM.DUOMKY, ST.QTPUOM, SM.DUOMKY, SM.QTDUOM
			 , ST.REFDKY, ST.REFDIT, ST.REFCAT, SM.OWNRKY, SM.SKUKEY
			 , ST.AWMSNO, ST.AREAKY, SM.EANCOD, SM.GTINCD
			 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
			 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
			 , SM.GRSWGT, SM.NETWGT, SM.WGTUNT, SM.LENGTH, SM.WIDTHW
			 , SM.HEIGHT, SM.CUBICM, SM.CAPACT, ST.SMANDT, ST.SEBELN, ST.SEBELP
			 , ST.STRAID, ST.SVBELN, ST.SPOSNR, ST.STKNUM, ST.STPNUM, ST.SWERKS
			 , ST.SLGORT, ST.SDATBG, ST.STDLNR, ST.SSORNU, ST.SSORIT, ST.SMBLNR
			 , ST.SZEILE, ST.SMJAHR, ST.SXBLNR, ST.SAPSTS, ST.SBKTXT
			 , SM.INDBZL, SM.INDARC, SM.UPDCHK, ST.SZMBLNO, ST.SZMIPNO
			 , ' ' AS RELRSN, TO_CHAR(SYSDATE, 'YYYYMMDD') AS RELDAT, ' 'AS RELUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
			 , ST.STOKKY
			 , TH.WAREKY
			 , ST.UOMKEY
		  FROM       TASDH TH
		  LEFT  JOIN TASDI TI ON (TI.TASKKY = TH.TASKKY)
		  INNER JOIN TASDR TR ON (TR.TASKKY = TI.TASKKY AND TR.TASKIT = TI.TASKIT)
		  INNER JOIN STKKY ST ON (ST.WAREKY = TH.WAREKY AND ST.STOKKY = TR.STOKKY)
		  INNER JOIN SKUMA SM ON (SM.OWNRKY = ST.OWNRKY AND SM.SKUKEY = ST.SKUKEY)
		 WHERE 1=1
		   AND ST.QTSIWH > 0
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASKKY = #{TASKKY}
		   AND TI.TASKIT = #{TASKIT}
	</select>
	
	<insert id="ADJDI_TASKKY_INSERT" parameterType="Map">
		INSERT INTO ADJDI (
			  SADJKY
			, SADJIT
			, RSNADJ
			, STOKKY
			, LOTNUM
			, QTADJU
			, QTBLKD
			, QTYUOM
			, DESC01
			, DESC02
			, LOTA01, LOTA02, LOTA03, LOTA04, LOTA05, LOTA06, LOTA07, LOTA08, LOTA09, LOTA10
			, LOTA11, LOTA12, LOTA13, LOTA14, LOTA15, LOTA16, LOTA17, LOTA18, LOTA19, LOTA20
			, LOCAKY
			, ADJRSN
			, TRNUID, SECTID, PACKID, TRUNTY
			, MEASKY, UOMKEY, QTPUOM, DUOMKY, QTDUOM
			, REFDKY, REFDIT, REFCAT, OWNRKY, SKUKEY
			, AWMSNO, AREAKY, EANCOD, GTINCD
			, ASKU01, ASKU02, ASKU03, ASKU04, ASKU05
			, SKUG01, SKUG02, SKUG03, SKUG04, SKUG05
			, GRSWGT, NETWGT, WGTUNT, LENGTH, WIDTHW
			, HEIGHT, CUBICM, CAPACT, SMANDT, SEBELN, SEBELP
			, STRAID, SVBELN, SPOSNR, STKNUM, STPNUM, SWERKS
			, SLGORT, SDATBG, STDLNR, SSORNU, SSORIT, SMBLNR
			, SZEILE, SMJAHR, SXBLNR, SAPSTS, SBKTXT
			, INDBZL, INDARC, UPDCHK, SZMBLNO, SZMIPNO
			, RELRSN, RELDAT, RELUSR
			, CREDAT, CRETIM, CREUSR, LMODAT, LMOTIM, LMOUSR
			, REFSTK
		)
		SELECT #{SADJKY}                                                                      AS SADJKY
			 , LPAD(#{SADJIT} - 10 + ROW_NUMBER() OVER(ORDER BY ST.STOKKY) * 10, 6, '0')      AS SADJIT
			 , NVL(#{ARSNADJ}, ' ')                                                           AS RSNADJ
			 , DECODE(LV, 2, ST.STOKKY, ' ')                                                  AS STOKKY
			 , DECODE(LV, 2, ST.LOTNUM, ' ')                                                  AS LOTNUM
			 , TR.QTSTKC * DECODE(LV, 2, -1, 1)                                               AS QTADJU
			 , 0                                                                              AS QTBLKD
			 , TR.QTSTKC * DECODE(LV, 2, -1, 1)                                               AS QTYUOM
			 , DECODE(LV, 2, ST.DESC01, NVL(#{ADESC01}, ST.DESC01))                           AS DESC01
			 , DECODE(LV, 2, ST.DESC02, NVL(#{ADESC02}, ST.DESC02))                           AS DESC02
			 , CASE WHEN LV = 2 THEN ST.LOTA01
					ELSE CASE WHEN     #{DOCUTY}  = '402'                      /* 재고상태변경 시                */
								   AND ST.LOTA02 != 'P400'                     /* 플랜트가 P400이 아니면서        */
								   AND #{ALOTA06} IN ('10', '30', '50')        /* TO재고상태가 보류, 불용, 폐기라면 */
								  THEN DECODE(SM.SKUG05, '00', '1900', '3900') /* 원자재: 1900, 그 외 3900      */
							  ELSE     NVL(#{ALOTA01}, ST.LOTA01)
						  END
				END                                                                           AS LOTA01
			 , CASE WHEN LV = 2 THEN ST.LOTA02 ELSE NVL(          #{ALOTA02} , ST.LOTA02) END AS LOTA02
			 , CASE WHEN LV = 2 THEN ST.LOTA03 ELSE NVL(          #{ALOTA03} , ST.LOTA03) END AS LOTA03
			 , CASE WHEN LV = 2 THEN ST.LOTA04 ELSE NVL(          #{ALOTA04} , ST.LOTA04) END AS LOTA04
			 , CASE WHEN LV = 2 THEN ST.LOTA05 ELSE NVL(          #{ALOTA05} , ST.LOTA05) END AS LOTA05
			 , CASE WHEN LV = 2 THEN ST.LOTA06 ELSE NVL(          #{ALOTA06} , ST.LOTA06) END AS LOTA06
			 , CASE WHEN LV = 2 THEN ST.LOTA07 ELSE NVL(          #{ALOTA07} , ST.LOTA07) END AS LOTA07
			 , CASE WHEN LV = 2 THEN ST.LOTA08 ELSE NVL(          #{ALOTA08} , ST.LOTA08) END AS LOTA08
			 , CASE WHEN LV = 2 THEN ST.LOTA09 ELSE NVL(          #{ALOTA09} , ST.LOTA09) END AS LOTA09
			 , CASE WHEN LV = 2 THEN ST.LOTA10
					ELSE CASE WHEN     #{DOCUTY}  = '402'   /* 재고상태변경 시            */
								   AND #{ALOTA06} = '10'    /* TO재고상태가 보류라면       */
								  THEN NVL(#{AADJRSN}, ' ') /* LOTA10에 보류사유 SETTING */
							  ELSE     NVL(#{ALOTA10}, ST.LOTA10)
						 END
			 	END                                                                           AS LOTA10
			 , CASE WHEN LV = 2 THEN ST.LOTA11 ELSE NVL(          #{ALOTA11} , ST.LOTA11) END AS LOTA11
			 , CASE WHEN LV = 2 THEN ST.LOTA12 ELSE NVL(          #{ALOTA12} , ST.LOTA12) END AS LOTA12
			 , CASE WHEN LV = 2 THEN ST.LOTA13 ELSE NVL(          #{ALOTA13} , ST.LOTA13) END AS LOTA13
			 , CASE WHEN LV = 2 THEN ST.LOTA14 ELSE NVL(          #{ALOTA14} , ST.LOTA14) END AS LOTA14
			 , CASE WHEN LV = 2 THEN ST.LOTA15 ELSE NVL(          #{ALOTA15} , ST.LOTA15) END AS LOTA15
			 , CASE WHEN LV = 2 THEN ST.LOTA16 ELSE NVL(TO_NUMBER(#{ALOTA16}), ST.LOTA16) END AS LOTA16
			 , CASE WHEN LV = 2 THEN ST.LOTA17 ELSE NVL(          #{ALOTA17} , ST.LOTA17) END AS LOTA17
			 , CASE WHEN LV = 2 THEN ST.LOTA18 ELSE NVL(TO_NUMBER(#{ALOTA18}), ST.LOTA18) END AS LOTA18
			 , CASE WHEN LV = 2 THEN ST.LOTA19 ELSE NVL(TO_NUMBER(#{ALOTA19}), ST.LOTA19) END AS LOTA19
			 , CASE WHEN LV = 2 THEN ST.LOTA20 ELSE NVL(TO_NUMBER(#{ALOTA20}), ST.LOTA20) END AS LOTA20
			 , CASE WHEN LV = 2 THEN ST.LOCAKY ELSE NVL(     TRIM(#{ALOCAKY}), ST.LOCAKY) END AS LOCAKY
			 , NVL(#{AADJRSN}, ' ') AS AADJRSN
			 , ST.TRNUID, ST.SECTID, ST.PACKID, ST.TRUNTY
			 , ST.MEASKY, SM.DUOMKY, ST.QTPUOM, SM.DUOMKY, SM.QTDUOM
			 , ST.REFDKY, ST.REFDIT, ST.REFCAT, SM.OWNRKY, SM.SKUKEY
			 , ST.AWMSNO, ST.AREAKY, SM.EANCOD, SM.GTINCD
			 , SM.ASKU01, SM.ASKU02, SM.ASKU03, SM.ASKU04, SM.ASKU05
			 , SM.SKUG01, SM.SKUG02, SM.SKUG03, SM.SKUG04, SM.SKUG05
			 , SM.GRSWGT, SM.NETWGT, SM.WGTUNT, SM.LENGTH, SM.WIDTHW
			 , SM.HEIGHT, SM.CUBICM, SM.CAPACT, ST.SMANDT, ST.SEBELN, ST.SEBELP
			 , ST.STRAID, ST.SVBELN, ST.SPOSNR, ST.STKNUM, ST.STPNUM, ST.SWERKS
			 , ST.SLGORT, ST.SDATBG, ST.STDLNR, ST.SSORNU, ST.SSORIT, ST.SMBLNR
			 , ST.SZEILE, ST.SMJAHR, ST.SXBLNR, NVL(#{SAPSTS}, ' '), ST.SBKTXT
			 , SM.INDBZL, SM.INDARC, SM.UPDCHK, ST.SZMBLNO, ST.SZMIPNO
			 , ' ' AS RELRSN, TO_CHAR(SYSDATE, 'YYYYMMDD') AS RELDAT, ' 'AS RELUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS CREDAT, TO_CHAR(SYSDATE, 'HH24MISS') AS CRETIM, #{SES_USER_ID} AS CREUSR
			 , TO_CHAR(SYSDATE, 'YYYYMMDD') AS LMODAT, TO_CHAR(SYSDATE, 'HH24MISS') AS LMOTIM, #{SES_USER_ID} AS LMOUSR
			 , ST.STOKKY
		  FROM       TASDH TH
		  LEFT  JOIN TASDI TI ON (TI.TASKKY = TH.TASKKY)
		  INNER JOIN TASDR TR ON (TR.TASKKY = TI.TASKKY AND TR.TASKIT = TI.TASKIT)
		  INNER JOIN STKKY ST ON (ST.WAREKY = TH.WAREKY AND ST.STOKKY = TR.STOKKY)
		  INNER JOIN SKUMA SM ON (SM.OWNRKY = ST.OWNRKY AND SM.SKUKEY = ST.SKUKEY)
		  INNER JOIN (SELECT LEVEL AS LV FROM DUAL CONNECT BY 2 >= LEVEL) ON 1 = 1
		 WHERE 1=1
		   AND ST.QTSIWH > 0
		   AND TH.WAREKY = #{WAREKY}
		   AND TH.TASKKY = #{TASKKY}
		   AND TI.TASKIT = #{TASKIT}
	</insert>
	
	<select id="SKUPLT_VALIDATE_MAP" parameterType="Map" resultType="DataMap">
		SELECT '1' AS RESULT
		  FROM SKUPLT
		 WHERE WAREKY = #{WAREKY}
		   AND OWNRKY = #{OWNRKY}
		   AND PLNTKY = #{ALOTA02}
		   AND SKUKEY = #{SKUKEY}
	</select>
	
	<select id="STKKY_VALIDATE_MAP" parameterType="Map" resultType="DataMap">
		SELECT TB.*
			 , CASE WHEN 0 >= TB.QTSIWH THEN '다른 사용자에 의해 재고가 변경되었습니다.'
				END AS ERRMSG
		  FROM (
			SELECT ST.*
				 , CASE WHEN ST.AREAKY = 'SHP' THEN 0
					ELSE ST.QTSIWH - ST.QTSBLK
								  - GREATEST(ST.QTSALO, ST.QTSPMO)
								  - (CASE WHEN ST.LOTA06 IN ('00') OR ST.QTSPMO > 0 THEN 0
										  ELSE ST.QTSIWH
									 END)
				   END AS USEQTY
			  FROM STKKY ST
			 WHERE STOKKY = #{STOKKY}
		  ) TB
	</select>
	
	<select id="TASK_VALIDATE_MAP" parameterType="Map" resultType="DataMap">
		SELECT CASE WHEN STATIT = 'FPC' THEN '다른 사용자에 의해 작업이 완료되었습니다.'
				END AS ERRMSG
			 , TI.*
		  FROM TASDI TI
		 WHERE TASKKY = #{TASKKY}
		   AND TASKIT = #{TASKIT}
	</select>
	
	<select id="SKUMA_MAP" parameterType="Map" resultType="DataMap">
		SELECT DUOMKY AS ADUOMKY
			 , DUOMKY AS AUOMKEY
			 , DESC01 AS ADESC01
			 , DESC02 AS ADESC02
		  FROM SKUMA
		 WHERE SKUKEY = #{ASKUKEY}
	</select>
	
	<insert id="IFSAPLOG_INSERT" parameterType="Map">
		INSERT INTO IFSAPLOG (
			SEQNO,UI,ZDOCNO,ERRTXT,WAREKY,
			CREDAT,CRETIM,CREUSR,
			LMODAT,LMOTIM,LMOUSR
		)
		SELECT IFSAPLOGSEQ.nextval
			 , NVL(#{PROGID}, ' ') AS UI
			 , NVL(#{ZDOCNO}, ' ') AS ZDOCNO
			 , NVL(#{ERRTXT}, ' ') AS ERRTXT
			 , NVL(#{WAREKY}, ' ') AS WAREKY
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
			 , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS'), #{SES_USER_ID}
		  FROM DUAL
	</insert>
	
	<select id="REFCAT_CHECK_MAP" parameterType="Map" resultType="DataMap">
		SELECT COUNT(*) AS CNT
		  FROM PHYDI PI
	INNER JOIN PHYDH PH ON PI.PHYIKY = PH.PHYIKY
		 WHERE PI.PHYIKY = #{PHYIKY}
           AND PI.REFCAT = 'V'
           AND ROWNUM = '1'
	</select>
	
	<select id="STLMA_SKUG05_LIST" parameterType="Map" resultType="DataMap">
		SELECT PLNTKY, STLKY
		FROM STLMA
		WHERE 1=1 
		  AND WMSMAK = 'V'
		  AND WAREKY = #{WAREKY}
		<choose>
			<when test='PLNTKY == "P200" or PLNTKY == "P300"'>AND PLNTKY IN ('P200', 'P300')</when>
			<otherwise>                                       AND PLNTKY = #{PLNTKY}</otherwise>
		</choose>
		<choose>
			<when test='SKUG05 == "00"'>AND STLKY &lt;  '2000'</when>
			<otherwise>                 AND STLKY &gt;= '2000'</otherwise>
		</choose>
		ORDER BY STLKY
	</select>
	
	<select id="SD07_LIST" parameterType="Map" resultType="DataMap">
	SELECT   K.SKUKEY
	   , K.DESC01
	   , K.LOTA15
	   , K.WAREKY
	   , K.WARENM
	   , K.LOTA02
	   , K.LOTA01
	   , nvl(K.LOTA07,' ') AS LOTA07 --주문번호
	   , K.LOTA06NM
	   , K.LOTA06
	   , K.KDAUFPOS
	   , K.KDAUF
	   , K.KDPOS
	   , K.SOBKZ
	   , SUM(K.QTSIWH) AS QTSIWH
	   , K.UOMKEY		
	   , K.MATNR
	   , K.CHARG
	   , K.WERKS
	   , K.LGORT
	   , CASE WHEN LOTA06NM ='가용' THEN K.STQTY ELSE 0 END AS STQTY --가용
	   , CASE WHEN LOTA06NM ='보류' THEN K.SPEME ELSE 0 END AS SPEME --보류
	   , CASE WHEN LOTA06NM ='품질' THEN K.INSME ELSE 0 END AS INSME --품질
	   , K.MEINS
	   , TO_CHAR(SYSDATE, 'YYYYMMDD') AS DOCDAT
	   , CASE WHEN LOTA06NM ='가용'  THEN SUM(QTSIWH) - STQTY
		      WHEN LOTA06NM ='품질'  THEN SUM(QTSIWH) - INSME
		      WHEN LOTA06NM ='보류' THEN SUM(QTSIWH) - SPEME
		      ELSE 0 END AS QTYGAP
	   , SUM(K.QTSIWH) - (CASE WHEN LOTA06NM ='가용' THEN K.STQTY ELSE 0 END +CASE WHEN LOTA06NM ='품질' THEN K.INSME ELSE 0 END +CASE WHEN LOTA06NM ='보류' THEN K.SPEME ELSE 0 END) AS QTYGAPT 
 FROM (
		 SELECT CASE WHEN NVL(ST.SKUKEY,' ') != ' ' THEN ST.SKUKEY ELSE SK.SKUKEY  END AS SKUKEY
		      , CASE WHEN NVL(ST.DESC01,' ') != ' ' THEN SM.DESC01 ELSE SK.DESC01  END AS DESC01 
		      , CASE WHEN NVL(ST.LOTA15,' ') != ' ' THEN ST.LOTA15 ELSE IF.CHARG   END AS LOTA15
		      , CASE WHEN NVL(ST.WAREKY,' ') != ' ' THEN ST.WAREKY ELSE SL.WAREKY  END AS WAREKY
		      , CASE WHEN NVL(WH.NAME01,' ') !=' ' THEN WH.NAME01 ELSE WH2.NAME01 END AS WARENM
		      , CASE WHEN NVL(ST.LOTA02,' ') != ' ' THEN ST.LOTA02 ELSE SL.PLNTKY  END AS LOTA02
		      , CASE WHEN NVL(ST.LOTA01,' ') != ' ' THEN ST.LOTA01 ELSE SL.STLKY   END AS LOTA01
		      , CASE WHEN NVL(ST.LOTA07,' ') != ' ' THEN ST.LOTA07 ELSE IF.KDAUF||DECODE(IF.KDPOS, 000000, '', IF.KDPOS) END  AS LOTA07
              , CASE WHEN IF.KDAUF=' ' THEN ' ' ELSE IF.KDAUF||IF.KDPOS END AS KDAUFPOS
              , CASE WHEN IF.KDAUF=' ' THEN ' ' ELSE IF.KDAUF END AS KDAUF
              , CASE WHEN IF.KDAUF=' ' THEN ' ' ELSE IF.KDPOS END AS KDPOS
              , CASE WHEN IF.KDAUF=' ' THEN ' ' ELSE IF.SOBKZ END AS SOBKZ
              , CASE WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.STQTY,0) != 0 THEN '00' 
                     WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.SPEME,0) != 0 THEN '10' 
                     WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.INSME,0) != 0 THEN '05' 
	                 WHEN ST.LOTA06 = '00' THEN '00'
		             WHEN ST.LOTA06 = '05' THEN '05'
		             WHEN ST.LOTA06 IN ('10','30','50' )THEN '10' -- 보류, 불용, 폐기 합쳐서 보이도록
		             ELSE ST.LOTA06
		              END AS LOTA06   
		      , CASE WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.STQTY,0) != 0 THEN '가용' 
                     WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.SPEME,0)  != 0 THEN '보류' 
                     WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.INSME,0)  != 0 THEN '품질' 
	                 WHEN ST.LOTA06 = '00' THEN '가용'
		             WHEN ST.LOTA06 = '05' THEN '품질'
		             WHEN ST.LOTA06 IN ('10','30','50' )THEN '보류' -- 보류, 불용, 폐기 합쳐서 보이도록
		              END AS LOTA06NM     
		      , IF.MATNR  AS MATNR 
		      , IF.CHARG  AS CHARG
		      , IF.WERKS  AS WERKS
		      , IF.LGORT  AS LGORT
		      , TO_CHAR(SYSDATE, 'YYYYMMDD') AS DOCDAT
		      , MAX(CASE WHEN NVL(ST.UOMKEY,' ')!= ' ' THEN ST.UOMKEY ELSE IF.MEINS END) AS UOMKEY
		      , NVL(MAX(IF.STQTY),0)  AS STQTY --가용재고
		      , NVL(MAX(IF.SPEME),0)  AS SPEME --보류재고
		      , NVL(MAX(IF.INSME),0)  AS INSME --품질 검사 시 재고
		      , MAX(IF.MEINS)  AS MEINS --기본단위
		      , NVL(CASE WHEN ST.LOTA06='00'  THEN SUM(ST.QTSIWH) 
		                 WHEN ST.LOTA06 IN ('10','30','50' )  THEN SUM(ST.QTSIWH) 
		                 WHEN  ST.LOTA06='05' THEN SUM(ST.QTSIWH)  END,0)  AS QTSIWH   
           FROM STKKY ST 
		   FULL OUTER JOIN IFWMS900 IF ON IF.MATNR = ST.SKUKEY 
									  AND IF.CHARG = LOTA15 
									  AND IF.WERKS = ST.LOTA02 --플랜트
									  AND IF.LGORT = ST.LOTA01 
									  AND IF.KDAUF||DECODE(IF.KDPOS, 000000, '', IF.KDPOS) = ST.LOTA07
		   LEFT OUTER JOIN WAHMA WH ON WH.WAREKY = ST.WAREKY		
		   LEFT OUTER JOIN SKUMA SK ON SK.SKUKEY = IF.MATNR
		   LEFT OUTER JOIN SKUMA SM ON SK.SKUKEY = SM.SKUKEY
		   LEFT OUTER JOIN STLMA SL ON SL.PLNTKY = IF.WERKS  AND SL.STLKY = IF.LGORT
		   LEFT OUTER JOIN WAHMA WH2 ON WH2.WAREKY = SL.WAREKY
	      WHERE 1=1
			
			AND (ST.QTSIWH > 0  OR ST.QTSALO != 0 OR ST.QTSPMO!=0 OR ST.QTSPMI!=0 OR ST.QTSBLK !=0 OR STQTY != 0  OR SPEME != 0 OR INSME !=0)
			
		  GROUP BY	CASE WHEN NVL(ST.SKUKEY,' ') != ' ' THEN ST.SKUKEY ELSE SK.SKUKEY  END 
				  , CASE WHEN NVL(ST.DESC01,' ') != ' ' THEN SM.DESC01 ELSE SK.DESC01  END
				  , CASE WHEN NVL(ST.LOTA15,' ') != ' ' THEN ST.LOTA15 ELSE IF.CHARG   END 
				  , CASE WHEN NVL(ST.WAREKY,' ') != ' ' THEN ST.WAREKY ELSE SL.WAREKY  END
				  , CASE WHEN NVL(WH.NAME01,' ') != ' ' THEN WH.NAME01 ELSE WH2.NAME01 END 
				  , CASE WHEN NVL(ST.LOTA02,' ') != ' ' THEN ST.LOTA02 ELSE SL.PLNTKY  END
				  , CASE WHEN NVL(ST.LOTA01,' ') != ' ' THEN ST.LOTA01 ELSE SL.STLKY   END
				  , CASE WHEN NVL(ST.LOTA07,' ') != ' ' THEN ST.LOTA07 ELSE IF.KDAUF||DECODE(IF.KDPOS, 000000, '', IF.KDPOS) END 
				  , IF.KDAUF
				  , IF.KDPOS
				  , IF.KDPOS
				  , IF.SOBKZ
				  , ST.LOTA06
				  , IF.MATNR 
				  , IF.CHARG
				  , IF.WERKS
				  , IF.LGORT
				  , TO_CHAR(SYSDATE, 'YYYYMMDD')
		          , CASE WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.STQTY,0) != 0 THEN '00' 
						 WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.SPEME,0) != 0 THEN '10' 
						 WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.INSME,0) != 0 THEN '05' 
						 WHEN ST.LOTA06 = '00' THEN '00'
						 WHEN ST.LOTA06 = '05' THEN '05'
						 WHEN ST.LOTA06 IN ('10','30','50' )THEN '10' -- 보류, 불용, 폐기 합쳐서 보이도록
						 ELSE ST.LOTA06
						 END    
		          ,CASE WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.STQTY,0) != 0 THEN '가용' 
						WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.SPEME,0)  != 0 THEN '보류' 
						WHEN NVL(ST.LOTA06,' ') =' ' AND NVL(IF.INSME,0)  != 0 THEN '품질' 
						WHEN ST.LOTA06 = '00' THEN '가용'
						WHEN ST.LOTA06 = '05' THEN '품질'
						WHEN ST.LOTA06 IN ('10','30','50' )THEN '보류' -- 보류, 불용, 폐기 합쳐서 보이도록
						END     
		     ) K
		     WHERE 1=1
		     AND K.WAREKY =  #{WAREKY}
		     <if test="LOTA02 != null and LOTA02 != ''">AND K.LOTA02 = #{LOTA02}</if>
			 <if test="DESC01 != null and DESC01 != ''">AND UPPER(K.DESC01) LIKE '%' || UPPER(#{DESC01}) || '%'</if>
             <if test="RANGE_SQL  != null and RANGE_SQL  != ''">${RANGE_SQL}</if>
		     GROUP BY K.SKUKEY
					, K.DESC01 
					, K.LOTA15
					, K.WAREKY
					, K.WARENM
					, K.LOTA02
					, K.LOTA01
					, K.LOTA07
					, K.KDAUF
					, K.KDAUF
					, K.KDPOS
					, K.KDAUF
					, K.KDPOS
					, K.SOBKZ
					, K.LOTA06NM
					, K.LOTA06
					, K.MATNR 
					, K.CHARG
					, K.WERKS
					, K.LGORT
					, K.UOMKEY
					, K.STQTY
					, K.SPEME
					, K. INSME
					, K.MEINS
					, KDAUFPOS
		     ORDER BY LOTA15
		     
	

	</select>
	<select id="SD08_LIST" parameterType="Map" resultType="DataMap">
		WITH ITEMSUM AS ( --입고
						  SELECT RH.WAREKY 
						  	   , RI.SKUKEY 
						  	   , RI.LOTA01 
						  	   , RI.LOTA02
						  	   , RI.LOTA12
						  	   , '' AS UOMKEY
					           , SUM(RI.QTYUOM) AS INQTY 
					           , 0 AS OUTQTY  
					           , 0 AS STKQTY
					           , 0 AS USEQTY 
					           , 0 AS JOINQTY
					           , 0 AS JJQTY 
					           , RI.LOCAKY AS LOCAKY
					           , RH.OWNRKY AS OWNRKY
					        FROM RECDI RI 
					       INNER JOIN RECDH RH ON RH.RECVKY = RI.RECVKY AND RH.RCPTTY != '199'
					       WHERE 1 = 1  
					         AND RH.WAREKY = #{WAREKY}
					         AND RH.OWNRKY = #{OWNRKY}
					         AND RI.STATIT = 'FRV'    
					         <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
					         AND DOCDAT <![CDATA[>=]]> TO_CHAR(to_date(#{DOCDAT},'YYYYMMDD')+ 1,'YYYYMMDD') 
					         AND DOCDAT <![CDATA[<=]]> TO_CHAR(SYSDATE, 'YYYYMMDD')
					       GROUP BY RI.SKUKEY, RI.LOTA01, RI.LOTA02, RI.LOTA12, RH.WAREKY, RI.LOCAKY, RH.OWNRKY
						   
						   UNION ALL 
						   --조정입고
						  SELECT RH.WAREKY 
						  	   , RI.SKUKEY
						  	   , RI.LOTA01 
						  	   , RI.LOTA02
						  	   , RI.LOTA12
						  	   , '' AS UOMKEY
						       , 0 AS INQTY 
						       , 0 AS OUTQTY  
						       , 0 AS STKQTY
						       , 0 AS USEQTY 
						       , SUM(RI.QTYUOM) AS JOINQTY
						       , 0 AS JJQTY 
						       , RI.LOCAKY AS LOCAKY
						       , RH.OWNRKY AS OWNRKY
						    FROM RECDI RI 
						   INNER JOIN RECDH RH ON RH.RECVKY = RI.RECVKY    AND RH.RCPTTY = '199'
						   WHERE 1 = 1  
							 AND RH.WAREKY = #{WAREKY}
						     AND RH.OWNRKY = #{OWNRKY}
							 AND RI.STATIT = 'FRV'       
						     <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
							 AND DOCDAT <![CDATA[>=]]> TO_CHAR(to_date(#{DOCDAT},'YYYYMMDD')+ 1,'YYYYMMDD')
							 AND DOCDAT <![CDATA[<=]]> TO_CHAR(SYSDATE, 'YYYYMMDD')
						   GROUP BY RI.SKUKEY, RI.LOTA01, RI.LOTA02, RI.LOTA12, RH.WAREKY, RI.LOCAKY, RH.OWNRKY       
								      
						   UNION ALL 
						   --재고(현재고)
						  SELECT RI.WAREKY
						  	   , RI.SKUKEY 
						  	   , RI.LOTA01 
						  	   , RI.LOTA02 
						  	   , RI.LOTA12
						  	   , MAX(RI.UOMKEY) AS UOMKEY
						       , 0  AS INQTY 
						       , 0  AS OUTQTY 
						       , SUM(RI.QTSIWH)   AS STKQTY 
						       , SUM((RI.QTSIWH - RI.QTSBLK - GREATEST(RI.QTSALO, RI.QTSPMO) - (CASE WHEN RI.LOTA06 IN ('00') OR RI.QTSPMO > 0 THEN 0 ELSE RI.QTSIWH END))) USEQTY 
						       , 0 AS JOINQTY
						       , 0 AS JJQTY
						       , RI.LOCAKY AS LOCAKY
						       , RI.OWNRKY AS OWNRKY
						    FROM STKKY  RI
						   WHERE 1 = 1  
							 AND RI.WAREKY = #{WAREKY}
							 AND RI.OWNRKY = #{OWNRKY}
							 <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
						   GROUP BY RI.SKUKEY, RI.LOTA01, RI.LOTA02, RI.LOTA12, RI.WAREKY, RI.LOCAKY, RI.OWNRKY
							
						   UNION ALL 
						   --출고
						  SELECT SH.WAREKY  
						       , RI.SKUKEY 
						       , RI.LOTA01 
						       , RI.LOTA02  
						       , RI.LOTA12
						       , '' AS UOMKEY
							   , 0  
							   , SUM(RI.QTSHPO) 
							   , 0 
							   , 0   
							   , 0 AS JOINQTY
							   , 0 AS JJQTY
							   , ST.LOCAKY AS LOCAKY
							   , SH.OWNRKY AS OWNRKY
						    FROM SHPDI RI
						   INNER JOIN SHPDH SH  ON SH.SHPOKY = RI.SHPOKY         
						   INNER JOIN STKKY ST ON RI.SHPOKY = ST.SHPOKY AND RI.SHPOIT = ST.SHPOIT
						   WHERE 1 = 1
						     AND SH.WAREKY = #{WAREKY}
						     AND SH.OWNRKY = #{OWNRKY}
						     AND SH.SHPMTY IN (SELECT DOCUTY FROM DOCTM WHERE DOCCAT = '200')
						     AND SH.STATDO IN ('PSH', 'FSH')
						     AND RI.STATIT IN ('FSH') 
						     AND SH.SHPMTY IN ('201','205','206', '208','221','231','399')  
						     <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
							 AND DOCDAT <![CDATA[>=]]> TO_CHAR(to_date(#{DOCDAT},'YYYYMMDD')+ 1,'YYYYMMDD')
							 AND DOCDAT <![CDATA[<=]]> TO_CHAR(SYSDATE, 'YYYYMMDD')
						   GROUP BY SH.WAREKY, RI.SKUKEY, RI.LOTA01, RI.LOTA02, RI.LOTA12, ST.LOCAKY, SH.OWNRKY
							--조정출고   
						   UNION ALL   
						  SELECT TH.WAREKY 
						  	   , RI.SKUKEY 
						  	   , RI.LOTA01 
						  	   , RI.LOTA02 
						  	   , RI.LOTA12
						  	   , '' AS UOMKEY
						       , 0 
						       , 0 /*OUTQTY*/
						       , 0 
						       , 0 
						       , 0 AS JOINQTY
						       , SUM(RI.QTCOMP) AS JJQTY
						       , ST.LOCAKY AS LOCAKY
						       , ST.OWNRKY AS OWNRKY
							FROM TASDI RI 
						   INNER JOIN TASDH TH ON TH.TASKKY = RI.TASKKY  AND TH.TASOTY IN ('399' ,'353','354','355','356','361')
						   INNER JOIN STKKY ST ON RI.TASKKY = ST.TASKKY  AND RI.TASKIT  = ST.TASKIT 
						   WHERE 1 = 1 
						     AND TH.WAREKY = #{WAREKY}
						     AND RI.STATIT NOT IN  ('FCN' ,'SCN')   
						     AND RI.LOTA02 IN  ( 'P100' ,'P200' ,'P300' ,'P400' )   
							 <if test="RANGE_SQL != null and RANGE_SQL != ''">${RANGE_SQL}</if>
							 AND DOCDAT <![CDATA[>=]]> TO_CHAR(to_date(#{DOCDAT},'YYYYMMDD')+ 1,'YYYYMMDD')
							 AND DOCDAT <![CDATA[<=]]> TO_CHAR(SYSDATE, 'YYYYMMDD')			
						   GROUP BY TH.WAREKY, RI.SKUKEY, RI.LOTA01, RI.LOTA02, RI.LOTA12, ST.LOCAKY, ST.OWNRKY 
		     			)
		   
 			 , TOTAL AS (  
		   				  SELECT A.WAREKY 
		   				       , A.SKUKEY 
		   				       , A.LOCAKY 
		   				       , A.OWNRKY
							   , SUM(STKQTY)
							   , SUM(INQTY)
							   , SUM(JOINQTY)
							   , SUM(JJQTY)
							   , SUM(OUTQTY) 
							   , SUM(STKQTY) - SUM(INQTY) - SUM(JOINQTY) + SUM(JJQTY) + SUM(OUTQTY) AS QTSIWH 
						    FROM ITEMSUM A
					       WHERE 1 = 1
					     	 AND A.WAREKY = #{WAREKY}
						     AND A.OWNRKY = #{OWNRKY}
						   GROUP BY A.WAREKY ,A.SKUKEY , A.LOCAKY ,A.OWNRKY
						  HAVING SUM(STKQTY) - SUM(INQTY) - SUM(JOINQTY) + SUM(JJQTY) + SUM(OUTQTY) !=0
		                )

   			 , TOTAL2 AS (  	
				          SELECT A.WAREKY 
				         	   , C.SHORTX 
				         	   , A.LOCAKY 
				         	   , A.OWNRKY
					    	   , SUM(A.QTSIWH) AS QTSIWH
				   	    	   , MAX(CASE WHEN C.AREAKY ='250' THEN '톤' ELSE '팔렛트' END ) AS UOMKEY
							   , MAX(C.MAXCPC) AS MAXCPC  --보관 CAPA
				    		   , MAX(A.SKUKEY) AS SKUKEY 
							   , MAX(D.SKUL01) AS SKUL01
				            FROM TOTAL A 
				           INNER JOIN LOCMA B ON A.LOCAKY = B.LOCAKY AND A.WAREKY = B.WAREKY
						   INNER JOIN AREMA C ON B.AREAKY = C.AREAKY AND B.WAREKY = C.WAREKY
						   INNER JOIN SKUMA D ON A.SKUKEY = D.SKUKEY  
						    LEFT OUTER JOIN MEASI TB ON A.WAREKY = TB.WAREKY 
								  				    AND A.SKUKEY = TB.MEASKY AND TB.UOMKEY ='PAL'
						 	LEFT OUTER JOIN MEASI TB1 ON A.WAREKY = TB1.WAREKY 
								  		            AND A.SKUKEY = TB1.MEASKY AND TB1.UOMKEY ='KG'
						   WHERE 1 = 1
					         AND A.WAREKY = #{WAREKY}
					    	 AND A.OWNRKY = #{OWNRKY}
					      	 AND C.AREATY = 'STOR'
						  	 AND NVL(D.SKUL01,'') != ' ' 
					       GROUP BY A.WAREKY, C.SHORTX, A.LOCAKY, A.OWNRKY
		                 ) 
					
		    , ROWDATA AS (
		         		  SELECT A.WAREKY AS WAREKY
					           , C.SHORTX AS SHORTX
						       , A.QTSIWH AS QTSIWH
					   	       , CASE WHEN C.AREAKY ='250' THEN '톤' ELSE '팔렛트' END  AS UOMKEY
							   , C.MAXCPC AS MAXCPC  --보관 CAPA
					    	   , A.SKUKEY AS SKUKEY 
							   , D.SKUL01 AS SKUL01
						       , CASE WHEN TB.UOMKEY ='PAL' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM) 
						         END AS TOT 
							   , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'RT' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
									  WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'RT' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM) 
							     END AS RT 
							   , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'FT' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'FT' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM) 
						         END AS FT  
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'KT' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'KT' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM) 
						         END AS KT   
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'WT' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'WT' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM)
						         END AS WT   
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'AF' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'AF' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM)
						         END AS AFH  
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'SN' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'SN' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM)
						         END AS SN   
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'BD' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'BD' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM)
						         END AS BD    
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'AD' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'AD' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM)
						         END AS AD  
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'WD' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'WD' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM) 
						         END AS WD  
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'ET' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'ET' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM) 
						         END AS ET   	
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'OF' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						              WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'OF' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM)
						         END AS FO   
						       , CASE WHEN TB.UOMKEY ='PAL' AND D.SKUL01 = 'BW' THEN A.QTSIWH/ (TB.QTPUOM / TB.QTAUOM)
						             WHEN TB1.UOMKEY ='KG' AND D.SKUL01 = 'BW' THEN A.QTSIWH/ (TB1.QTPUOM / TB1.QTAUOM) 
						         END AS BW   
					        FROM TOTAL A 
					       INNER JOIN LOCMA B ON A.LOCAKY = B.LOCAKY  AND A.WAREKY = B.WAREKY
						   INNER JOIN AREMA C ON B.AREAKY = C.AREAKY  AND B.WAREKY = C.WAREKY
						   INNER JOIN SKUMA D ON A.SKUKEY = D.SKUKEY  
							LEFT OUTER JOIN MEASI TB ON A.WAREKY = TB.WAREKY 
									  				AND A.SKUKEY = TB.MEASKY AND TB.UOMKEY ='PAL'
							LEFT OUTER JOIN MEASI TB1 ON A.WAREKY = TB1.WAREKY 
									  		         AND A.SKUKEY = TB1.MEASKY AND TB1.UOMKEY ='KG'
						   WHERE 1 = 1
							 AND A.WAREKY = #{WAREKY}
						     AND A.OWNRKY = #{OWNRKY}
						     AND C.AREATY = 'STOR'
							 AND NVL(D.SKUL01,'') != ' ' 
						)
						
		    , SUMDATA AS (
		                  SELECT SHORTX 
		                  	   , UOMKEY
		                  	   , MAXCPC 
					           , NVL(SUM(TOT),0) AS TOT 
					           , NVL(SUM(RT),0) AS RT
					           , NVL(SUM(FT),0) AS FT
					           , NVL(SUM(KT),0) AS KT
					           , NVL(SUM(WT),0) AS WT
					           , NVL(SUM(AFH),0) AS AFH
					           , NVL(SUM(SN),0) AS SN
					           , NVL(SUM(BD),0) AS BD
					           , NVL(SUM(AD),0) AS AD
					           , NVL(SUM(WD),0) AS WD
					           , NVL(SUM(ET),0) AS ET   
					           , NVL(SUM(FO),0) AS FO
					           , NVL(SUM(BW),0) AS BW 
							FROM ROWDATA 
						   GROUP BY SHORTX, UOMKEY, MAXCPC 
				          )
				          
			, FNSH AS (   
						  SELECT SHORTX 
						  	   , UOMKEY
						  	   , MAXCPC  
				         	   , CASE WHEN MAXCPC !=0 THEN ROUND((ROUND(TOT,3) * 100/MAXCPC),0) ELSE 0 END AS RATE 
							   , ROUND(TOT,3) AS TOT 
							   , ROUND(RT,3) AS RT
							   , ROUND(FT,3) AS FT
							   , ROUND(KT,3) AS KT
							   , ROUND(WT,3) AS WT
							   , ROUND(AFH,3) AS AFH
							   , ROUND(SN,3) AS SN
							   , ROUND(BD,3) AS BD
							   , ROUND(AD,3) AS AD
							   , ROUND(WD,3) AS WD
							   , ROUND(ET,3) AS ET   
							   , ROUND(FO,3) AS FO
							   , ROUND(BW,3) AS BW 
					 	    FROM SUMDATA
				      ) 

			 , SOR AS (   
			 			  SELECT '청주공장' AS SHORTX
				 		       , '1' AS SORT
							   , UOMKEY AS UOMKEY
							   , NVL(SUM(MAXCPC),0) AS MAXCPC
							   , 0               AS RATE 
							   , NVL(SUM(TOT),0) AS TOT 
							   , NVL(SUM(RT),0) AS RT
							   , NVL(SUM(FT),0) AS FT
							   , NVL(SUM(KT),0) AS KT
							   , NVL(SUM(WT),0) AS WT
							   , NVL(SUM(AFH),0) AS AFH
							   , NVL(SUM(SN),0) AS SN
							   , NVL(SUM(BD),0) AS BD
							   , NVL(SUM(AD),0) AS AD
							   , NVL(SUM(WD),0) AS WD
							   , NVL(SUM(ET),0) AS ET 
							   , NVL(SUM(FO),0) AS FO
							   , NVL(SUM(BW),0) AS BW
				   	 	    FROM FNSH A
				   	       GROUP BY UOMKEY
				   	  )
				   	 
		   	  SELECT SHORTX AS SHORTX
		 		   , SORT AS SORT
				   , UOMKEY AS UOMKEY
				   , MAXCPC AS MAXCPC
				   , ROUND((TOT*100) / MAXCPC, 0) AS RATE 
				   , TOT AS TOT 
				   , RT AS RT
				   , FT AS FT
				   , KT AS KT
				   , WT AS WT
				   , AFH AS AFH
				   , SN AS SN
				   , BD AS BD
				   , AD AS AD
				   , WD AS WD
				   , ET AS ET 
				   , FO AS FO
				   , BW AS BW 
		   	 	FROM SOR A
		       UNION 
			  SELECT SHORTX AS SHORTX
				   , '2' AS SORT
				   , UOMKEY  AS UOMKEY
				   , MAXCPC AS MAXCPC
				   , RATE AS RATE 
				   , TOT AS TOT 
				   , RT AS RT
				   , FT AS FT
				   , KT AS KT
				   , WT AS WT
				   , AFH AS AFH
				   , SN AS SN
				   , BD AS BD
				   , AD AS AD
				   , WD AS WD
				   , ET AS ET 
				   , FO AS FO
				   , BW AS BW 
				FROM FNSH 
		       ORDER BY SORT, UOMKEY DESC			
    </select>
	
	
	
	<select id="SD10_LIST" parameterType="Map" resultType="DataMap" fetchSize="1000">
		<!-- 품목 환산단위 조회방법 변경필요 (성능 느림)
		WITH BOXUOM AS (
			<include refid="WITH_BOXUOM"/>
		)
		 -->
		
		SELECT 
			TB.* 
			, NVL(DECODE(TB.SKUG05, '10', ZP.PALCNT                      , 0), 0) AS RBALE /* PS인 경우만 노출 */
		 	, NVL(DECODE(TB.SKUG05, '10', ROUND(TB.QTSIWH / ZP.PALCNT, 3), 0), 0) AS BALE  /* PS인 경우만 노출 */
		 	, CASE WHEN TB.WAREKY = '4000' THEN 0 ELSE TB.QTSIWH * NVL(DECODE(MV.PEINH, 0, 0, MV.STPRS / MV.PEINH), 0) END AS STKAMT
		FROM (
			SELECT TB.*
				 /* 2022.05.18 성능개선 - FUNCTION 내용 풀어서 아래 작성. */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS TOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS BAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS BOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS PLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.QTSIWH
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.QTSIWH                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS SOKQT /* 속(개/BALE) */
				 , NVL(DECODE(TB.UOMKEY, 'KG' , TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'KG'
												)
				   ), 0) AS USETOTWG /* 총중량 */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BAG', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BAG'
												)
				   ), 0), 0) AS USEBAGQT /* EA/BAG */
				 , NVL(DECODE(TB.SKUG05, '20', /* HL인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'BOX', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'BOX'
												)
				   ), 0), 0) AS USEBOXQT /* BAG/BOX */
				 , NVL(DECODE(TB.UOMKEY, 'PAL', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'PAL'
												)
				   ), 0) AS USEPLTQT /* BOX/Pallet */
				 , NVL(DECODE(TB.SKUG05, '10', /* PS인 경우만 노출 */
					   DECODE(TB.UOMKEY, 'SOK', TB.USEQTY
											  , (SELECT DECODE(TB.UOMKEY, (SELECT UOMKEY FROM MEASI WHERE WAREKY = TB.WAREKY AND MEASKY = TB.SKUKEY AND INDDFU = 'V')
																		, TO_NUMBER(ROUND(TB.USEQTY                                                             / (MI.QTPUOM / MI.QTAUOM), 3))
																		, TO_NUMBER(ROUND(TRIM(SZF_GET_DEFAULT_QTY(TB.WAREKY, TB.SKUKEY, TB.USEQTY, TB.UOMKEY)) / (MI.QTPUOM / MI.QTAUOM), 3))
															 )
												   FROM MEASI MI
												  WHERE MI.WAREKY = TB.WAREKY AND MI.MEASKY = TB.SKUKEY AND MI.UOMKEY = 'SOK'
												)
				   ), 0), 0) AS USESOKQT /* 속(개/BALE) */
				 , NVL(TRIM((SELECT SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'EA' ) FROM DUAL)), 0) AS EAQTY /* 매(sheet/속) */
				 , CEIL(NVL(TRIM(SZF_GET_CONVERT_QTY(TB.WAREKY, TB.SKUKEY, TB.QTSIWH, TB.UOMKEY, 'PAL')), 1)) AS QTDPRT
				 , TRUNC(SYSDATE) - TRUNC(TO_DATE(LOTA11, 'YYYYMMDD')) AS SINCE_LOTA11
				 , CASE WHEN LOTA06 ='10' THEN LOTA10 ELSE ' ' END AS SINCE_LOTA10 
			  FROM (
				SELECT TB.ZONEKY
					 , TB.AREAKY, NVL((SELECT SHORTX FROM AREMA WHERE WAREKY = TB.WAREKY AND AREAKY = TB.AREAKY),' ') AS AREANM
					 , TB.LOCAKY
					 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'SKUL01', TB.SKUL01) AS SKUL01NM
					 , TB.SKUKEY
					 , TB.DESC01
					 , TB.UOMKEY
					 , SUM(TB.QTSIWH) AS QTSIWH
					 , SUM(TB.USEQTY) AS USEQTY
	--				 , SUM(TB.QTSCNU) AS QTSCNU
	--				 , SUM(TB.QTSIQT) AS QTSIQT
	--				 , SUM(TB.QTSWQT) AS QTSWQT
	--				 , SUM(TB.QTSHQT) AS QTSHQT
					 , SUM(TB.QTSALO) AS QTSALO
					 , MAX(TB.QTSOALO) AS QTSOALO
					 , SUM(TB.QTSPMO) AS QTSPMO
					 , SUM(TB.QTSPMI) AS QTSPMI
					 , SUM(TB.QTSBLK) AS QTSBLK
					 , TB.LOTA01, TB.LOTA02, TB.LOTA03, TB.LOTA04, TB.LOTA05
					 , TB.LOTA06, TB.LOTA07, TB.LOTA08, TB.LOTA09, TB.LOTA10
					 , TB.LOTA11, TB.LOTA12, TB.LOTA13, TB.LOTA14, TB.LOTA15
					 , TB.LOTA16, TB.LOTA17, TB.LOTA18, TB.LOTA19, TB.LOTA20
					 , LT.LOTA21, LT.LOTA22, LT.LOTA23, LT.LOTA24
					 , LT.LOTA41, LT.LOTA42, LT.LOTA43, LT.LOTA44, LT.LOTA45
					 , LT.LOTA46, LT.LOTA47, LT.LOTA48, LT.LOTA49
					 , SZF_GET_CMCDV_CDESC1_TEXT(#{LANGKY}, 'LOTA06', TB.LOTA06) AS LOTA06NM
					 , TB.WAREKY
					 , (SELECT NAME01 FROM WAHMA WHERE WAREKY = TB.WAREKY) AS WARENM
					 , (SELECT NAME01 FROM BZPTN WHERE PTNRKY = TB.LOTA09 AND PTNRTY = 'CT') AS LOTA09NM
					 , TB.SKUG05
					 , TB.RCPRSN
					 , K.REMARK
					 , SUM(NVL(TRIM(DECODE(MI.UOMKEY, 'BAG', MI.QTPUOM * (SELECT QTAUOM FROM MEASI WHERE UOMKEY = 'EA'  AND WAREKY = MI.WAREKY AND MEASKY = MI.MEASKY))), 0)) AS BOXEA  /* BAG.QTPUOM / EA .QTAUOM */
					 , SUM(NVL(TRIM(DECODE(MI.UOMKEY, 'BOX', MI.QTPUOM                                                                                                )), 0)) AS BOXBAG /* BOX.QTPUOM              */
					 , SUM(NVL(TRIM(DECODE(MI.UOMKEY, 'PAL', MI.QTPUOM / (SELECT QTPUOM FROM MEASI WHERE UOMKEY = 'BOX' AND WAREKY = MI.WAREKY AND MEASKY = MI.MEASKY))), 0)) AS BOXPAL /* PAL.QTPUOM * BOX.QTPUOM */
				  FROM (
					<include refid="SD01_BASE"/>
					) TB
				  INNER JOIN LOTAT LT ON TB.LOTNUM = LT.LOTNUM 
				  LEFT JOIN MEASI MI ON TB.WAREKY = MI.WAREKY AND TB.SKUKEY = MI.MEASKY AND MI.UOMKEY = TB.UOMKEY
				  LEFT OUTER JOIN STKREMARK K ON TB.STOKKY = K.STOKKY  AND TB.WAREKY = K.WAREKY
				GROUP BY TB.ZONEKY
					   , TB.AREAKY
					   , TB.LOCAKY
					   , TB.SKUL01
					   , TB.SKUKEY
					   , TB.DESC01
					   , TB.UOMKEY
					   , TB.WAREKY
					   , TB.LOTA01, TB.LOTA02, TB.LOTA03, TB.LOTA04, TB.LOTA05
					   , TB.LOTA06, TB.LOTA07, TB.LOTA08, TB.LOTA09, TB.LOTA10
					   , TB.LOTA11, TB.LOTA12, TB.LOTA13, TB.LOTA14, TB.LOTA15
					   , TB.LOTA16, TB.LOTA17, TB.LOTA18, TB.LOTA19, TB.LOTA20
					   , LT.LOTA21, LT.LOTA22, LT.LOTA23, LT.LOTA24
					   , LT.LOTA41, LT.LOTA42, LT.LOTA43, LT.LOTA44, LT.LOTA45
					   , LT.LOTA46, LT.LOTA47, LT.LOTA48, LT.LOTA49
					   , TB.SKUG05, TB.RCPRSN, K.REMARK
			  ) TB
			
		) TB
	  		LEFT JOIN MATVAL MV ON MV.MATNR  = TB.SKUKEY AND MV.BWKEY  = TB.LOTA02 AND MV.MEINS = TB.UOMKEY
		  	LEFT JOIN ZPPTM  ZP ON ZP.MANDT = '100' AND TB.LOTA02 = ZP.LOTA02 AND TB.LOTA03 = ZP.LOTA03 AND TB.LOTA09 = ZP.LOTA09 AND TB.LOTA16 = ZP.LOTA16 AND TB.LOTA17 = ZP.LOTA17
		ORDER BY TB.ZONEKY
				   , TB.AREAKY
				   , TB.LOCAKY
				   , SKUL01NM
				   , TB.SKUKEY
				   , TB.DESC01
				   , TB.UOMKEY
				   , QTSIWH DESC
		  
	</select>
	
	<update id="SD09_UPDATE" parameterType="Map">
	 MERGE INTO STKREMARK  A
	 USING  ( SELECT * FROM STKKY C
	 	       WHERE C.WAREKY =  #{WAREKY}
	   			 AND C.STOKKY = #{STOKKY}
	   			 AND C.LOCAKY =  #{LOCAKY}
	 		)  B ON (A.WAREKY =B.WAREKY AND A.STOKKY =B.STOKKY AND A.LOTA14 = B.LOTA14 AND A.LOTA15 =B.LOTA15 )
	 WHEN MATCHED THEN
	 UPDATE SET A.REMARK = #{REMARK}
	           ,A.LMODAT = TO_CHAR(SYSDATE, 'YYYYMMDD')
	           ,A.LMOTIM = TO_CHAR(SYSDATE, 'HH24MISS')
	           ,A.LMOUSR =  #{SES_USER_ID}
	      
	 WHEN NOT MATCHED THEN 
     INSERT (SEQNO,  WAREKY, STOKKY, LOTA14,LOTA15, REMARK ,CREDAT, CRETIM, CREUSR) 
     VALUES (SEQ_STKREMARK.NEXTVAL,  #{WAREKY}, #{STOKKY}, #{LOTA14},#{LOTA15},#{REMARK} , TO_CHAR(SYSDATE, 'YYYYMMDD'), TO_CHAR(SYSDATE, 'HH24MISS') ,#{SES_USER_ID} )
     
<!-- 	MERGE INTO STKREMARK AS SR
   USING (SELECT * FROM STKKY) AS STK
    ON SR.WAREKY = STK.WAREKY
   AND SR.OWNRKY = STK.OWNRKY 
   AND SR.LOTA14 = STK.LOTA14 
   AND SR.LOTA15 = STK.LOTA15
   AND STK.LOCAKY = #{LOCAKY}
   WHEN MATCHED THEN
      UPDATE SET SR.REMARK = #{REMARK}
   WHEN NOT MATCHED THEN 
      INSERT (SEQNO, OWNRKY, WAREKY, STOKKY, REMARK) 
      VALUES (SEQ_STKREMARK.NEXTVAL, #{OWNRKY}, #{WAREKY}, #{STOKKY}, #{REMARK})
      ; -->
      </update>
	
	<!-- 231215 재고 품목변경 시 제품군 조회 -->
	<select id="SKUMA_SKUG_MAP" parameterType="Map" resultType="DataMap">
		SELECT DUOMKY AS ADUOMKY
			 , DUOMKY AS AUOMKEY
			 , DESC01 AS ADESC01	<!-- 품명 -->
			 , DESC02 AS ADESC02
			 , SKUG05 AS SKUG05		<!-- 제품군 -->
			 , SKUG01 AS SKUG01		<!-- 품목유형 -->
			 , SKUL01 AS SKUL01		<!-- 품목구분 -->
		  FROM SKUMA
		 WHERE SKUKEY = #{ASKUKEY}
	</select>
	
	<!-- 240118 재고변경 IFWMS223 프로시저 분리 -->
	<insert id="IFWMS223_IF_INSERT" parameterType="hashmap" statementType="CALLABLE">
