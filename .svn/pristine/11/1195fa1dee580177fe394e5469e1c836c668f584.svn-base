	function searchList(){

		if(validate.check("searchArea")){
	        var param = inputList.setRangeParam("searchArea");
	        searchType = 1;
	        param.put("PROGID", menuky);
	        
	        gridList.resetGrid("gridList");
	        gridList.gridList({
	            id : "gridList",
	            url : "/wms/outbound/json/headRangeSqlDL042.data", //RANGE_SQL 생성
	            param : param
	        });
	        
	        gridList.setReadOnly("gridList", false);
	        gridList.setReadOnly("gridList", true, ["PRTCHK", "DYNAMIC"]);
	    }
	}
	
	function gridExcelDownloadEventBefore(gridId){
	    if(gridId == "gridList"){
	        var param = inputList.setRangeParam("searchArea");
	        param.put("PROGID", menuky);
	        return param;
	    }else if(gridId == "gridListSub"){
	        var rowNum = gridList.getSearchRowNum("gridList");
	        if(rowNum == -1){
	            return false;
	        }else{
	            var param = getItemSearchParam(rowNum);
	            return param;
	        }
	    }
	}
	
	function getRangeDataParam(param){
		// 조회 -> 마스터 선적번호 체크 -> 출하요청일자 변경 후 -> 할당 누르면...?
		var inputListParam = inputList.setRangeParam("searchArea");

		if(inputListParam.containsKey("SI.LOTA02")){
			param.put("LOTA02", "("+inputListParam.get("SI.LOTA02")+")");
			inputListParam.remove("SI.LOTA02");
		}
		param.putAll(inputListParam);
	    if(inputListParam.map.RANGE_DATA_PARAM){    // datail 조회 시 searchArea 조회조건 출하요청일자 범위 필요
            rageDataMap = inputListParam.map.RANGE_DATA_PARAM;
            if(rageDataMap){
                if(rageDataMap.containsKey("SH.RQSHPD_Range")){
                    param.put("RQSHPD_FR", rageDataMap.get("SH.RQSHPD_Range").substr(2,8));		//출하요청일자 FROM
                    param.put("RQSHPD_TO", rageDataMap.get("SH.RQSHPD_Range").substr(11,8));	//출하요청일자 TO
                }else if(rageDataMap.containsKey("SH.RQSHPD_Single")){
                	param.put("RQSHPD", rageDataMap.get("SH.RQSHPD_Single").substr(2,8));		//출하요청일자
                }
            }
	    }
	    param.remove("RANGE_DATA_PARAM");
	}
	
	function searchHelpEventOpenBefore(searchCode, gridType, $inputObj){
	    var param = new DataMap();
	    if(searchCode == "SHCMCDV"){
	        param.put("CMCDKY", "STATDO");
	        return param;
	    }else if(searchCode == "SHSTLMAP"){
	    	
	    	var PLNTKY = $('select[name="SI.LOTA02"]').val();
			
			if(!PLNTKY) {
				var label = commonLabel.getLabel("STD_LOTA02", 1);
				commonUtil.msgBox("VALID_required",[label]); // {0} 은(는) 필수 입력항목입니다.
				return false;
			}
			param.put("PLNTKY", PLNTKY);
	    	
	    	return param;
	    }else if(searchCode == "SHBZPTN"){
			param.put("PTNRTY", "CT");
			param.put("OWNRKY", "<%=ownrky%>");			
			return param;
		}
	    
	}
	/* 버튼 기능 분기처리 */
	function commonBtnClick(btnName){
		
	    if(btnName == "Search"){					//조회
	        searchList();
	    }else if(btnName == "printPlShpping"){		//할당피킹지시서
	    	printPlShpping();
		}else if(btnName == "printShpping"){		//출고지시서
	    	printAlShpping();
	    }else if(btnName == "SaveCarNo"){
			SaveCarNo();
		}
	}
	
	function SaveCarNo() {

    	//var headList = gridList.getSelectData("gridList");
    	//차량번호 숫자만 입력되게 처리하기
    	
    	var headList = gridList.getModifyData("gridList", "A");
        var param = new DataMap();
        param.put("headList", headList);

        if(headList.length == 0){
            commonUtil.msgBox("VALID_M1573"); // 변경된 데이터가 없습니다.
            return;
        }        

        if(!commonUtil.msgConfirm(configData.MSG_MASTER_SAVE_CONFIRM)){
        	return;
        }

		// SAP I/F, SHPDH 업데이트
		var json = netUtil.sendData({
			url : "/wms/outbound/json/saveCarNo.data",
			param : param
		});

		if(json && json.data && json.data.RESULT == "S"){
			searchList();
        }else {
        	console.dir(json)
        }
	}

	//할당피킹지시서 출력
	function printPlShpping(){
		var list = gridList.getSelectData("gridList");
		
		if (list.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		} 
		
		var param = new DataMap();
			param.put("list",list);
			param.put("columnList", "WAREKY,SHPOKY");
			param.put("PRTTYP","PK_LIST");
			param.put("OWNRKY", "<%=ownrky%>");
		
		var STATDO_LIST = "'PAL','FAL'";	// 부분할당: PAL, 할당완료: FAL 
		param.put("STATDO_LIST", STATDO_LIST);	// 미작업 제외
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		
		var url = "피킹지시서(할당)_선적단위.ezg?ver=0.18";
		var wareky  = "<%=wareky%>";
		var ownrky  = "<%=ownrky%>";
		var where = "AND SH.WAREKY='"+wareky+"' AND SH.OWNRKY='"+ownrky+"' AND SH.STATDO IN ("+STATDO_LIST+") AND (";
		for(var i=0; i<list.length; i++){
			var row = list[i];

			var key = row.get("STKNUM");
			var STATDONM = row.get("STATDONM");
			var prtchk = row.get("PRTCHK");

			if(STATDONM == '부분할당' || STATDONM == '할당완료'){
				flag = true;
			}else{
				commonUtil.msgBox("할당된 정보만 출력가능합니다.");   //할당된 정보만 출력가능합니다.
				return;
			}

			where += "SI.STKNUM='"+key+"'";
			if(i==list.length-1) break;
			where += " OR ";	
		}
		where += ")"; 
		
		var json2 = netUtil.sendData({
			url: "/wms/outbound/json/prtUpdateDL042.data",
			param : param
		});
		
		var map = new DataMap();
		map.put("WAREKY", "<%=wareky%>");
		
		WriteEZgenElement(url, where, "", '<%=langky%>', map, 1300, 950);
	}
	
	//미할당출고지시서 출력
	function printAlShpping(){
		var list = gridList.getSelectData("gridList");
		
		if (list.length == 0){
			commonUtil.msgBox("VALID_M0006");
			return;
		}
		
		if(!commonUtil.msgConfirm("SYSTEM_PRINTYN")){
			return;
		} 
		
		var param = new DataMap();
		param.put("list",list);
		param.put("columnList", "WAREKY,SHPOKY");
		param.put("PRTTYP","PK_LIST");
		param.put("OWNRKY", "<%=ownrky%>");
	
		var json = netUtil.sendData({
			url : "/wms/admin/json/commonPrint.data",
			param : param
		});
		
		var prtseq = null;
		if(json && json.data){
			prtseq = json.data;
		}else{
			alert("출력불가");
			return;
		}
		
		var url = "출고지시서(미할당)_선적단위.ezg?ver=0.66";
		var wareky  = "<%=wareky%>";
		var ownrky  = "<%=ownrky%>";
		var stknumList = "";
		var where = "AND SH.WAREKY='"+wareky+"' AND SH.OWNRKY='"+ownrky+"' AND SI.STATIT != 'FCO' AND(";
		for(var i=0; i<list.length; i++){
			var row = list[i];
			var key = row.get("STKNUM");
			var prtchk = row.get("PRTCHK");

			if(key.indexOf("*") > -1) {
				where += "SI.SHPOKY='"+key.replace("*", "")+"'";
			
			}else {
				where += "SI.STKNUM='"+key+"'";
			}

			stknumList += key+",";
			
			if(i==list.length-1) break;
			where += " OR ";	
		}
		where += ")"; 

		var json2 = netUtil.sendData({
			url: "/wms/outbound/json/prtUpdateDL042.data",
			param : param
		});
		
		
		if (stknumList.length > 0) {
			stknumList = stknumList.slice(0, -1);
		}
		
		var map = new DataMap();
		map.put("WAREKY", "<%=wareky%>");
		map.put("i_stknumList", stknumList);
		
		WriteEZgenElement(url, where, "", '<%=langky%>', map, 1300, 950);
	}

	function comboEventDataBindeBefore(comboAtt){
		if(comboAtt == "WmsOrder,RCPTTYCOMBO"){
            var param = new DataMap();
            param.put("PROGID", configData.MENU_ID);
            return param;
        }else if(comboAtt == "Wms,PLNTKYCOMBO"){
	        var param = new DataMap();
	        param.put("WAREKYS", "'<%= wareky%>'");
	        param.put("OWNRKY", "<%=ownrky%>");
	        param.put("LANGKY", "<%=langky%>");
	        
	        return param;
	    }else if(comboAtt == "WmsTask,COMMON_ALSTH"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,DEPTID"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,VTXTK"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}else if(comboAtt == "Wms,KVGR"){
			var param = new DataMap();
			param.put("WAREKY", "<%=wareky%>");
			return param;
		}
	}
	
	//search 전체 체크박스 클릭
	function searchCheckBoxAll(obj) {
		
		if($(obj).prop("checked") == true){
			$(obj).parent('dd').children('input').prop("checked", true);
		}else{
			$(obj).parent('dd').children('input').prop("checked", false);
		}
	}

	var goFlag = "Y"; 
	function gridListEventRowCheck(gridId, rowNum, checkType){
		if(gridId == "gridList" && checkType == true && goFlag == "Y"){
			var stknum = gridList.getColData(gridId, rowNum, "STKNUM");
			
			goFlag = "N";
			
			var head = gridList.getGridData(gridId);
			for (var i = 0; i < head.length; i++) {
				if (stknum == gridList.getColData(gridId, i, "STKNUM") && stknum != " "){
					gridList.setRowCheck(gridId, i, true);
				}
			}
			goFlag = "Y";
		}
	}
	
	
</script>
</head>
<body>
<%@ include file="/common/include/webdek/layout.jsp" %>
<!-- content -->
<div class="content_wrap">
