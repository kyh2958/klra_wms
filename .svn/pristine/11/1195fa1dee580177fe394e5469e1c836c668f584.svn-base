	function gridListEventItemGridSearch(gridId, rowNum){//), itemGridList){
	    if(gridId == "gridList"){
	        var param = getItemSearchParam(rowNum);
	        
	        gridList.gridList({
	            id : "gridListSub",
	            url : "/wms/outbound/json/detailDL042.data",        // RANGE_SQL 생성
	            param : param
	        });
	        dblIdx = rowNum;
	        subIdx = rowNum;
	    }
	}
	
	function getItemSearchParam(rowNum){
		var param = inputList.setRangeParam("searchArea");
		var rowData = gridList.getRowData("gridList",rowNum);
		
		if(param.map.RANGE_DATA_PARAM){    // datail 조회 시 searchArea 조회조건 선적번호(범위) 삭제 = (detail은 master 선적번호 기준으로 조회)
			rageDataMap = param.map.RANGE_DATA_PARAM;
			if(rageDataMap){
				if(rageDataMap.containsKey("SI.STKNUM_Single")){
					rageDataMap.remove("SI.STKNUM_Single");
				}
				if(rageDataMap.containsKey("CT.NAME01_Single")){
				}
			}
		}
		param.put("STKNUM", rowData.get("STKNUM"));	// Head row 선적번호
		return param;
	}
	
	function mkWhereSql(str, field){	//문자열 LIKE 검색으로 변경 예정
		//debugger;
		var result = "";
		if(str!=undefined && str!=""){
			var arr = str.split("↑");
			
			for(var i=0; i<arr.length; i++){
				var rStr = arr[i];
				var rArr = rStr.split("↓")
				
				if(rArr.length==3){
					var oper = rArr[0];
					var searVal = rArr[1];
					var logi = rArr[2];
					
					if(result!=""){
						
						if(logi=="OR"){
							result = result + " " + "OR";
						}else if(logi=="AND"){
							result = result + " " + "AND";
						}
					}
					result = result + " " + field; 
					
					if(oper=="E"){
						result = result + " " + "=";
					}else if(oper=="N"){
						result = result + " " + "!=";
					}else if(oper=="LT"){
						result = result + " " + "<";
					}else if(oper=="GT"){
						result = result + " " + ">";
					}else if(oper=="LE"){
						result = result + " " + "<=";
					}else if(oper=="GE"){
						result = result + " " + ">=";
					}
					
					result = result + " '" + searVal + "' ";
				}
			}
		}
		if(result!=""){
			result = "AND ( " + result + " ) ";
		}
		return result;
	}
	
	function gridListEventDataBindEnd(gridId, dataLength){
