					<input type="button" CB="Search SEARCH BTN_DISPLAY" />
			        <input type="button" CB="SaveCarNo SAVE BTN_SAVE"/><!-- 차량번호 저장 -->
			        <input type="button" CB="printPlShpping PRINT BTN_PRINT27" />
			        <input type="button" CB="printShpping PRINT BTN_PRINT24" />
				</div>
			</div>
			
			<div class="search_inner">
				<div class="search_wrap ">
					<input type="hidden" class="input" name="OWNRKY" value="<%=ownrky %>" />
					<dl>
						<dt CL="STD_WAREKY">거점</dt>
						<dd>
							<input type="text" class="input" name="WAREKY" name="WAREKY"  value="<%=wareky%>" readonly="readonly" validate="required" />
						</dd>
					</dl>
					<dl>
						<dt CL="STD_LOTA02">플랜트</dt>
						<dd>
							<select type="text" class="input" Combo="Wms,PLNTKYCOMBO" name="SI.LOTA02" id="PLNTKY" ComboType="MS" style="width: 160px;" validate="required">
							</select>
						</dd>
					</dl>
					
					<dl>
						<dt CL="STD_LOTA01">저장위치</dt>
						<dd>
							<input type="text" class="input" name="SI.LOTA01" UIInput="R,SHSTLMAP" />
						</dd>
					</dl>
										
					<dl>
                        <dt CL="STD_RQSHPD">출하요청일자</dt>
                        <dd>
                            <input type="text" class="input" name="SH.RQSHPD" UIFormat="C -7 7" UIInput="R"/> 
                        </dd>
                    </dl>
                    
                    <dl>
						<dt CL="STD_STATDO">문서상태</dt>
						<dd style="width: 800px;">
							<input type="checkbox" class="input" id="STAT00" name="STAT00" value="V" onclick="searchCheckBoxAll(this)"/>
							<label CL="STD_ALL" for="STAT00">전체</label>
							<input type="checkbox" class="input" id="STAT01" name="STAT01" value="V" checked="checked"/>
							<label CL="STD_EMPTYTRAN" for="STAT01">미작업</label>
							<input type="checkbox" class="input" id="STAT02" name="STAT02" value="V" checked="checked"/>
							<label CL="STD_PALLOC" for="STAT02">부분할당</label>
							<input type="checkbox" class="input" id="STAT03" name="STAT03" value="V"/>
							<label CL="STD_ALLOCA" for="STAT03">할당완료</label>
							<input type="checkbox" class="input" id="STAT04" name="STAT04" value="V"/>
							<label CL="STD_PPICKYN" for="STAT04">부분피킹</label>
							<input type="checkbox" class="input" id="STAT05" name="STAT05" value="V"/>
							<label CL="STD_PICKED" for="STAT05">피킹완료</label>
							<input type="checkbox" class="input" id="STAT06" name="STAT06" value="V"/>
							<label CL="STD_PCK" for="STAT06">부분상차</label>
							<input type="checkbox" class="input" id="STAT07" name="STAT07" value="V"/>
							<label CL="STD_FCKCOM" for="STAT07">상차완료</label>
							<input type="checkbox" class="input" id="STAT08" name="STAT08" value="V"/>
							<label CL="STD_PSHPCOM" for="STAT08">부분출고</label>
							<input type="checkbox" class="input" id="STAT09" name="STAT09" value="V"/>
							<label CL="STD_SHPCOM" for="STAT09">출고완료</label>							 
						</dd>
					</dl>
					
					 <dl>
                        <dt CL="STD_STKNUM">선적번호</dt>
                        <dd>
                            <input type="text" class="input" name="SI.STKNUM" UIInput="SR"/>
                        </dd>
                    </dl>
                    
                    
                    <dl>
                        <dt CL="STD_SSHTYP">출고유형</dt>
                        <dd style="width: 160px;">
                            <select type="text" class="input" Combo="WmsOrder,RCPTTYCOMBO" name="SH.SHPMTY" id="RCPTTY" ComboType="MS" validate="required">
                            </select>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_SHPOKY">출고문서번호</dt>
                        <dd>
                            <input type="text" class="input" name="SH.SHPOKY" UIInput="SR"/>
                        </dd>
                    </dl>
                    
                    <dl>
                        <dt CL="STD_SVBELN">출고오더번호</dt>
