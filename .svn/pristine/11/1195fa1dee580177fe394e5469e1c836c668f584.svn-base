	    			//gridList.setRowReadOnly(gridId, i, true, ["CARNO"]);
    			}
    		}
	        
	        headFocusNum = 0;
	        
	        if(searchType == 1){
	            getItemSearchParam(0);
	            gridList.checkAll('gridList',true);
	        }else if(searchType == 2){
	        }
	    }
	}
	
	// 20240115 마스터 상태값과 아이템상태 불일치 (이전상태 아이템존재) 색깔 변경
