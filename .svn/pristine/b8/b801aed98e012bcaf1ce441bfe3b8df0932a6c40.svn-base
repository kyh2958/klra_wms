<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!doctype html>
<head>
<style type="text/css">
button {float: right; }
input:read-only { 
	background-color: #e2e2e2;
}
select:DISABLED {
	background-color: #e2e2e2;
}
</style>
<meta charset="utf-8">
<meta name="viewport" content="user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, width=device-width, target-densitydpi=medium-dpi" />
<meta name="format-detection" content="telephone=no" />
<title>Mobile WMS</title>
<%@ include file="/mobile/include/head.jsp" %>
<script type="text/javascript" src="/wms/js/wms.js"></script>
<script>
	$(document).ready(function(){
		gridList.setGrid({
			id : "gridList",
			editable : false,
			module : "WmsInventory",
			command : "PDMV01",
			gridMobileType : true
		});
		
		$('#BARCOD').focus();
	});
	
	function initTargetLocation() {
		$('#LOC_TEMP').val(""); // To 지번 초기화
		$('#RECLOC').val(""); // 추천로케이션
	}
	
	function onReadBarcode() {
		initTargetLocation();
		searchData();
	}
	
	function searchData() {
		if (!validate.check("searchArea")){
			return;
		}
		
		var chkRowCnt = gridList.getGridData('gridList').length;

		if(chkRowCnt > 0) {
			commonUtil.msgBox("VALID_M0009", "1건 이상 처리 할 수 없습니다.");
			return;
		}else {

			var param = inputList.setRangeParam("searchArea");
			param.put("WAREKY", "<%=wareky%>");
			param.put("OWNRKY", "<%=ownrky%>");
			
			var json = netUtil.sendData({
				module : "WmsInventory",
				command : "VALIDATE_BARCOD_PDMV01",
				param : param
			});
			
			var checkMsg = "";
			if (json && json.data && json.data.length > 0) {
				var data = json.data.filter(x => x.QTSIWH > 0);
				var msg = "";
				if (data.length > 0) {
					if (data.filter(x => {return x.LOCAKY != 'SYSLOC'}).length == 0) { // 수량이 존재하는 재고가 SYSLOC만 존재하는 경우
						msg = '사용 불가능한 재고입니다.';
					} else if (data.filter(x => x.QTSPMO == 0).length == 0) {
						msg = '이미 할당이 완료된 바코드입니다.';
					} else if (data.filter(x => x.LOCAKY != 'SHPLOC').length == 0) { // 수량이 존재하는 재고가 SHPLOC만 존재하는 경우
						msg = '출고중인 재고입니다.';
					}
				} else {
					if (json.data.filter(x => x.LOCAKY != 'SHPLOC').length == 0) {  // 수량이 존재하지 않는 재고가 SHPLOC만 존재하는 경우
						msg = '출고 완료된 재고입니다.';
					}
				}
				
				if (msg) {
					commonUtil.msgBox(msg, null, null, function() {
						$('#BARCOD').focus();
					});
					return false;
				}
			}
			
			var json = netUtil.sendData({
				module : "WmsInventory",
				command : "PDMV01",
				param : param
			});

			var existList = gridList.getGridData('gridList');
			json.data = json.data.filter(
				x => !existList.find(y => x.STOKKY == y.get('STOKKY'))
			)
			
			if (!json || !json.data || json.data.length == 0) {
				var exist = existList.find(
					x => x.get('LOTA14') == param.get('BARCOD')
				)
				
				var msg = exist ? '스캔이 완료된 바코드입니다.' : 'VALID_M0005';
				commonUtil.msgBox(msg, null, null, function() { // 조회된 데이터가 없습니다.
					$('#BARCOD').focus();
				});
				return;
			} else if (json.data.length == 1) {
				json.data[0]['QTTAORBOX2'] = ' '
				StkLotaPopCallback(json);
				
			} else {
				param.put("json", json);
				mobile.linkPopOpen('/mobile/PDSTK_LOTA_POP.page?isMV=V', param);
			}
		}
		
	}
	
	function StkLotaPopCallback(jsonObj) {

		for (var i in jsonObj.data) {
			jsonObj.data[i]['DESC01'] = jsonObj.data[i]['DESC01'].replace(/깨끗한나라|보솜이|프레미뇽|디어스킨|메디프렌즈/g, "");
		}
		
		gridList.appendJson('gridList', jsonObj); // append grid

		// 추천로케이션이 없는 경우 세팅
		var RECLOC = $('#RECLOC').val();
		if (!RECLOC) {
			for (var i in jsonObj.data) {
				var rowData = gridList.getRowData("gridList", i);

				// PS 추천로케이션 제한 
				if (rowData.map.LOTA02.length && rowData.map.LOTA02 != 'P100') {
					
					$("#RECLOC_TR").css('visibility','visible');
					
					RECLOC = recommendLocation(rowData);
					if (RECLOC && RECLOC.trim()) {
						$('#RECLOC').val(RECLOC);
						break;
					}
				}	
			}
		}
		
		focusOnGridLast();
		$('#BARCOD').focus();
	}
	
	// 마지막 row focus
	function focusOnGridLast () {
		var rowNumList = gridList.getRowNumList('gridList');
		var maxRowNum = Math.max(...rowNumList);
		gridList.setColFocus('gridList', maxRowNum, 'LOTA14');
		
		// 조호된 바코드의 작업수량(QTTAOR_TEMP), 단위(UOMKEY_TEMP) 적용 
		var QTTAOR = gridList.getColData('gridList', maxRowNum, 'QTTAOR');
		var UOMKEY = gridList.getColData('gridList', maxRowNum, 'UOMKEY');
		
		$("#QTTAOR_TEMP").val(QTTAOR)
		$("#UOMKEY_TEMP").val(UOMKEY)
	}
	
	// 로케이션 추천
	function recommendLocation(rowData){
		var list = new Array();
		list.push(rowData);
		
		var param = new DataMap();
		param.put("list", list);
		
		var json = netUtil.sendData({
			url : "/wms/inventory/json/RecommendLocation.data",
			param : param
		});
		
		if (json && json.data) {
			var dataList = json.data.list;
			dataList.forEach(data => {
				recLocObj = new DataMap();
				recLocObj.put('LOTNUM', data.LOTNUM);
				recLocObj.put('RECLOC', data.O_LOCAKY);
				recLoc = data.O_LOCAKY;
			});
		}
		return recLoc;
	}
	
	// To 지번 찾기
	function searchLocMstList () {
		var rowNumList = gridList.getRowNumList('gridList');
		if (rowNumList.length == 0) {
			return;
		}
		
		var param = new DataMap();
		var rowNum  = gridList.getFocusRowNum("gridList");
		var rowData = gridList.getRowData('gridList', rowNum);
		param.put('WAREKY', '<%=wareky%>');
		param.put("OWNRKY", "<%=ownrky%>");
		param.put("LOTA02", rowData.get("LOTA02"));
		param.put("SKUG05", rowData.get("SKUG05"));
		
		param.put("AREAKY", rowData.get("AREAKY"));
		param.put("ZONEKY", rowData.get("ZONEKY"));
		
		var json = netUtil.sendData({
			module : "WmsInventory",
			command: "PDMV01LOCMA",
			param  : param
		});
		
		var data = json.data;
		
		// 1건 조회 시
		if (data && data.length == 1) {
			LocPopCallback(data);
		// 다건 조회 시
		} else if (data && data.length > 1) {
			param.put("json", json);
			mobile.linkPopOpen('/mobile/PDLOC_POP.page?showPlntky=true&showStlky=true', param);
		// 미조회 시
		} else {
			commonUtil.msgBox("VALID_M0005", null, null, function() { // 조회된 데이터가 없습니다.
				$('#LOC_TEMP').focus();
			});
			return;
		}
	}
	
	function LocPopCallback(data) {
		// LOC_TEMP 태그에 값 셋팅
		$('#LOC_TEMP').val(data.get('LOCAKY'));
		$('#LOC_TEMP').focus();
		onReadTargetLocation(data.get('LOCAKY'));
	}
	
	function onReadTargetLocation(targetLoc) {
		if (!targetLoc || gridList.getGridDataCount('gridList') < 1) {
			return;
		}
		var param = new DataMap();
		param.put("WAREKY", "<%=wareky%>");
		param.put("ALOCAKY", targetLoc);
		
		var json = netUtil.sendData({
			module : "WmsInventory",
			command : "LOCAKYval2",
			sendType : "map",
			param : param
		});
		
		var rowNumList = gridList.getRowNumList('gridList');
		
		if (!json.data) {
			commonUtil.msgBox("TASK_M0011", targetLoc, null, function() { //* 이동대상 로케이션 {0} 이 유효하지 않습니다.
				$('#LOC_TEMP').focus();
				$('#LOC_TEMP').select();
			});
			
			for (var i in rowNumList) {
				gridList.setColValue('gridList', rowNumList[i], 'LOCATG', '');
			}
			return false;
		} else {
			var lota01 = json.data.STLKY;
			
			var LOCAKY = json.data.LOCAKY;
			
			$('#LOC_TEMP').val(LOCAKY);
			for (var i in rowNumList) {
				var alota01 = gridList.getColData('gridList', rowNumList[i], 'LOTA01');
				if((alota01==3000&&lota01==3500) ||(alota01==3500&&lota01==3000)){
					commonUtil.msgBox("TASK_M0011", lota01);	//* 이동대상 로케이션 {0} 이 유효하지 않습니다.
					gridList.setColValue('gridList', rowNumList[i], 'LOCATG', '');	
				}else{
					gridList.setColValue('gridList', rowNumList[i], 'LOCATG', LOCAKY);
					
				}
			}
		}
	}
	
	// 그리드 값 변경 이벤트
	function gridListEventColValueChange(gridId, rowNum, colName, colValue) {
		if (gridId == "gridList") {
			if(colName == "QTTAOR") {
				var rowData = gridList.getRowData(gridId, rowNum);
				var QTSIWH = Number(gridList.getColData(gridId, rowNum, "QTSIWH")); // 재고수량
				var QTTAOR = Number(gridList.getColData(gridId, rowNum, "QTTAOR")); // 작업수량
				
				if (QTTAOR <= 0) {
					commonUtil.msgBox("TASK_M0021", '0'); // 작업수량은 {0}보다 커야 됩니다.
					//gridList.setColValue("gridList", rowNum, "QTTAOR", QTSIWH);
					gridList.setColFocus(gridId, rowNum, colName);
					return;
				}
				
				if (QTSIWH < QTTAOR) {
					commonUtil.msgBox("TASK_M0023", [rowData.get('DESC01'), QTTAOR, QTSIWH]); //* 상품[{0}]는 작업수량[{1}] 이 가용재고 수량[{2}]을 초과하였습니다.
					//gridList.setColValue("gridList", rowNum, "QTTAOR", QTSIWH);
					gridList.setColFocus(gridId, rowNum, colName);
					return;
				}
				
				if (gridList.getColData('gridList', rowNum, 'UOMKEY') == 'BAG'){
					var bagbox = gridList.getColData('gridList', rowNum, 'BAGQT') / gridList.getColData('gridList', rowNum, 'BOXQT');
					gridList.setColValue('gridList', rowNum, 'QTTAORBOX2', colValue/bagbox);
				}
			}
			
			// 가용수량 체크
			if(colName == "QTTAORBOX2") {
				var rowData = gridList.getRowData(gridId, rowNum);
				var QTSIWH = Number(gridList.getColData(gridId, rowNum, "QTSIWH")); // 재고수량
				var bagbox = gridList.getColData('gridList', rowNum, 'BAGQT') / gridList.getColData('gridList', rowNum, 'BOXQT');
				var QTTAOR = colValue * bagbox;

				if (QTTAOR <= 0) {
					commonUtil.msgBox("TASK_M0021", '0'); // 작업수량은 {0}보다 커야 됩니다.
					//gridList.setColValue("gridList", rowNum, "QTTAORBOX2", QTSIWH/bagbox);
					gridList.setColFocus(gridId, rowNum, colName);
					return;
				}
				
				if (QTSIWH < QTTAOR) {
					commonUtil.msgBox("TASK_M0023", [rowData.get('DESC01'), QTTAOR, QTSIWH]); //* 상품[{0}]는 작업수량[{1}] 이 가용재고 수량[{2}]을 초과하였습니다.
					//gridList.setColValue("gridList", rowNum, "QTTAORBOX2", QTSIWH/bagbox);
					gridList.setColFocus(gridId, rowNum, colName);
					return;
				}

				gridList.setColValue('gridList', rowNum, 'QTTAOR', QTTAOR);
			}
		}
	}
	
	function checkLOCATG (gridId, rowNum, colName, colValue) {
		colValue = colValue.toUpperCase();
		gridList.setColValue(gridId, rowNum, colName, colValue);
		
		var param = new DataMap();
		param.put("WAREKY", "<%=wareky%>");
		param.put("ALOCAKY", colValue);
		
		var json = netUtil.sendData({
			module : "WmsInventory",
			command : "LOCAKYval2",
			sendType : "map",
			param : param
		});
		
		if (!json.data) {
			commonUtil.msgBox("TASK_M0011", colValue);	//* 이동대상 로케이션 {0} 이 유효하지 않습니다.
			gridList.setColValue(gridId, rowNum, colName, "");
			gridList.setColFocus(gridId, rowNum, colName);
			return false;
		}
		
		gridList.setColValue(gridId, rowNum, colName, json.data.LOCAKY);
		
		//2023.02.14 3000>3500 / 3500 > 3000 제한
		var lota01 = json.data.STLKY;
		var alota01 = gridList.getColData('gridList',rowNum, 'LOTA01');
		if((alota01==3000&&lota01==3500) ||(alota01==3500&&lota01==3000)){
			commonUtil.msgBox("TASK_M0011", lota01);	//* 이동대상 로케이션 {0} 이 유효하지 않습니다.
			gridList.setColValue('gridList', rowNum, 'LOCATG', '');	
			return false;
		}
		
		var LOCASR = gridList.getColData(gridId, rowNum, "LOCASR");
		var STATUS = json.data["STATUS"];
		
		if (STATUS != '00') {
			commonUtil.msgBox("TASK_M0011", colValue);	//* 이동대상 로케이션 {0} 이 유효하지 않습니다.
			gridList.setColValue(gridId, rowNum, colName, "");
			gridList.setColFocus(gridId, rowNum, colName);
			return false;
		}
		
		var LOTA02 = gridList.getColData(gridId, rowNum, "LOTA02")
		var PLNTKY = json.data["PLNTKY"];
		
		// 2022.09.22 P200 => P300이거나 P300 => P200인 경우 혼적 가능하도록 변경
		var similarPlnt = (LOTA02 == 'P200' && PLNTKY == 'P300') ||
						  (LOTA02 == 'P300' && PLNTKY == 'P200');
		
		if (PLNTKY.trim() &&
			PLNTKY != LOTA02 &&
			similarPlnt == false
		) {
			commonUtil.msgBox("TASK_M0701"); // 동일한 플랜트 내 지번만 변경 가능합니다.
			gridList.setColValue(gridId, rowNum, colName, "");
			gridList.setColFocus(gridId, rowNum, colName);
			return false;
		}

		return true;
	}
	
	function validateList () {
		// 1. required validate
		var gridDataList = gridList.getGridData('gridList');
		
		var validate = false;
		for (var i in gridDataList) {
			validate = false;
			var rowData = gridDataList[i];
			
			var rowNum = rowData.get('GRowNum');
			var QTSIWH = Number(rowData.get("QTSIWH"));
			var QTTAOR = Number(rowData.get("QTTAOR"));
			
			var LOCASR = rowData.get("LOCASR");
			var LOCATG = rowData.get("LOCATG");
			var RECLOC = $('#RECLOC').val();
			
			if(!LOCATG.trim()) {
				LOCATG = RECLOC;
				rowData.put("LOCATG", RECLOC);
				gridList.setColValue("gridList", rowNum, "LOCATG", RECLOC);
			}

			// 작업수량 == 0
			if (QTTAOR == 0) {
				gridList.setColFocus("gridList", rowNum, 'QTTAOR');
				commonUtil.msgBox("TASK_M0021", "0");
				return false;
			}
			
			// 재고수량 < 작업수량
			if (QTSIWH < QTTAOR){
				gridList.setColFocus("gridList", rowNum, 'QTTAOR');
				commonUtil.msgBox("TASK_M0023", [rowData.get('DESC01'), QTTAOR, QTSIWH]); //* 상품[{0}]는 작업수량[{1}] 이 가용재고 수량[{2}]을 초과하였습니다.
				return false;
			}
			
			validate = true;
		}
		return validate;
	}
	
	//분할처리
	function saveDataPartiton(){
		
		if(gridList.validationCheck("gridList", "select")){
			
			var chkRowCnt = gridList.getGridData('gridList').length;

			if(chkRowCnt == 1 ){
				var list = gridList.getGridData('gridList');
				var qttaor = gridList.getColData('gridList', 0, "QTTAOR");
				var qtsiwh = gridList.getColData('gridList', 0, "QTSIWH");
				
				if (qttaor >= qtsiwh) {

				 	commonUtil.msgBox("VALID_M0923");
					gridList.setColValue(gridId, rowNum, colName, "");
					gridList.setColFocus(gridId, rowNum, colName); 
					return false;
				} else {
					var param = new DataMap();
					param.put("LANGKY", "<%=langky%>");
					param.put("list", list);

					var json = netUtil.sendData({
						url : "/wms/inventory/json/barcodePartition.data",
						param : param
					});

					var resMsg = json.data.MSG;

					if (resMsg != 'OK') {
						alert(resMsg);
						return;
					} else {
						// {0}작업이 완료되어 [{1}] 바코드가 생성되었습니다.
						commonUtil.msgBox("OUT_M0310", ["분할", json.data.LIST[0]["P_lota14"]], null, function(){
							gridList.resetGrid('gridList'); // 그리드 초기화
						});
					}
				}

			} else {
				commonUtil.msgBox("OUT_M0208");	// 하나의 행만 선택해주세요.
				return;
			}
		}
	}
	
	function gridListEventRowClick(gridId, rowNum, colName){
		$("#QTTAOR_TEMP").val(gridList.getColData(gridId, rowNum, 'USEQTY'))
	}
	
	function setQTTAOR(value) {

		value = value.replace(/[^-\.0-9]/g,'')
		
		var rowNum = gridList.getSelectIndex('gridList');

		gridList.setColValue('gridList', rowNum, 'QTTAOR', value);
		
		if (gridList.getColData('gridList', rowNum, 'UOMKEY') == 'BAG') {
			var bagbox = gridList.getColData('gridList', rowNum, 'BAGQT') / gridList.getColData('gridList', rowNum, 'BOXQT');
			$("#QTTAORBOX2_TEMP").val(value/bagbox)
			gridList.setColValue('gridList', rowNum, 'QTTAORBOX2', value/bagbox);
		}
	}
	
	
	
	function setQTTAORBOX(value) {

		value = value.replace(/[^-\.0-9]/g,'')
		var rowNum = gridList.getSelectIndex('gridList');

		if (gridList.getColData('gridList', rowNum, 'UOMKEY') != 'BAG') {
			alert("단위가 박스가 아닙니다")
			return
		}

		var bagbox = gridList.getColData('gridList', rowNum, 'BAGQT') / gridList.getColData('gridList', rowNum, 'BOXQT');
		
		gridList.setColValue('gridList', rowNum, 'QTTAORBOX2', value);

		$("#QTTAOR_TEMP").val(value*bagbox).trigger("change")

	}
	
	function fn_onfocus(objId){
		$("#"+objId).select();
	}
</script>
</head>
