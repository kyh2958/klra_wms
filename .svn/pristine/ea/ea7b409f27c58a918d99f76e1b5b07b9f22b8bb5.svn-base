		DataMap rstMap = new DataMap();
		
		String sqlMapNamespace = "WmsSystem";
		
		String O_SUCCESSCNT = "";
		String O_FAILCNT = "";
		String O_ERRORCODE = "";
		String O_ERRORMESG = "";
		
		try {
			
			row.put("OWNRKY", map.get("OWNRKY"));
			row.put("INTSEQ", map.get("INTSEQ"));
			row.put("USERID", map.get(CommonConfig.SES_USER_ID_KEY));
			row.setModuleCommand(sqlMapNamespace, "PALLETIZING_IS03_PROC_CALL");
			commonDao.update(row);
			
			O_ERRORCODE = row.getString("O_ERRORCODE");
			O_ERRORMESG = row.getString("O_ERRORMESG");
			
			if(!"1".equals(O_ERRORCODE)) {
				rstMap.put("ERRCODE", "F");
